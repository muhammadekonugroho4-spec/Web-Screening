<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlMenuStockbitAcademy"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivMenuViewStockbitAcademyIcon"
        android:paddingTop="@dimen/item_gap_l"
        android:paddingBottom="@dimen/item_gap_l"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="?attr/themeIconTintColor"
        android:layout_centerVertical="true"
        android:paddingStart="@dimen/item_gap_s"
        android:paddingEnd="@dimen/item_gap_l"
        app:srcCompat="@drawable/ic_stockbit_academy"/>
    <TextView
        android:id="@+id/tvMenuViewStockbitAcademyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_bar_stockbit_academy"
        android:layout_centerVertical="true"
        android:layout_toStartOf="@+id/tvMenuViewStockbitAcademyNew"
        android:layout_toEndOf="@+id/ivMenuViewStockbitAcademyIcon"
        style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tvMenuViewStockbitAcademyNew"
        android:background="@drawable/border_green_rounded"
        android:paddingLeft="@dimen/item_gap_s"
        android:paddingTop="@dimen/item_gap_xxs"
        android:paddingRight="@dimen/item_gap_s"
        android:paddingBottom="@dimen/item_gap_xxs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_bar_new_title"
        android:layout_centerVertical="true"
        android:textAlignment="gravity"
        android:layout_alignParentEnd="true"
        style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
</RelativeLayout>
