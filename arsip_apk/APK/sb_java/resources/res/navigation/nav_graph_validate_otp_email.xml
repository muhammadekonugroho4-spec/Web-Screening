<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_validate_otp_email"
    app:startDestination="@+id/verifyOTPEmailFragment">
    <include app:graph="@navigation/nav_graph_crisp"/>
    <fragment
        android:name="com.stockbit.userauth.ui.email.VerifyOTPEmailFragment"
        android:id="@+id/verifyOTPEmailFragment">
        <argument
            android:name="changeToken"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="newEmail"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="type"
            app:argType="com.stockbit.domain.model.type.VerifyEmailType"
            app:nullable="false"/>
        <argument
            android:name="source"
            app:argType="com.stockbit.domain.model.type.VerifyEmailSource"
            app:nullable="false"/>
        <action
            android:id="@+id/action_verifyOTPEmailFragment_to_crispActivity"
            app:destination="@+id/nav_graph_crisp"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="EXTRA_LAUNCH_LIVE_SUPPORT"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true"/>
            <argument
                android:name="EXTRA_LAUNCH_LIVE_SUPPORT_MESSAGE"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true"/>
        </action>
        <action
            android:id="@+id/action_verifyOTPEmailFragment_popUp"
            app:popUpTo="@+id/verifyOTPEmailFragment"
            app:popUpToInclusive="true"/>
    </fragment>
</navigation>
