<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_change_password"
    app:startDestination="@+id/changePasswordConfirmationFragment">
    <fragment
        android:label="ChangePasswordConfirmation"
        android:name="com.stockbit.personalamend.ui.changepassword.confirmcurrent.ChangePasswordConfirmationFragment"
        android:id="@+id/changePasswordConfirmationFragment">
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="changeRequestType"
            app:argType="com.stockbit.usecase.personalamend.model.ChangeTokenReqTypeUIState"
            app:nullable="false"/>
        <action
            android:id="@+id/action_changePasswordConfirmation_to_createNewPassword"
            app:destination="@+id/createNewPasswordFragment">
            <argument
                android:name="token"
                app:argType="string"
                app:nullable="false"/>
        </action>
        <action
            android:id="@+id/action_changePasswordConfirmation_to_forgotPassword"
            app:destination="@+id/nav_graph_forgot_password">
            <argument
                android:name="email"
                app:argType="string"
                app:nullable="false"/>
            <argument
                android:name="phone"
                app:argType="string"
                app:nullable="false"/>
        </action>
    </fragment>
    <fragment
        android:label="CreateNewPassword"
        android:name="com.stockbit.personalamend.ui.changepassword.newinput.ChangePasswordNewInputFragment"
        android:id="@+id/createNewPasswordFragment">
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
        <action
            android:id="@+id/action_createNewPassword_to_confirmNewPassword"
            app:destination="@+id/confirmNewPasswordFragment">
            <argument
                android:name="token"
                app:argType="string"
                app:nullable="false"/>
        </action>
    </fragment>
    <fragment
        android:label="ConfirmNewPassword"
        android:name="com.stockbit.personalamend.ui.changepassword.confirminput.ChangePasswordConfirmInputFragment"
        android:id="@+id/confirmNewPasswordFragment">
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
        <action
            android:id="@+id/action_confirmNewPasswordFragment_to_changePasswordOTPFragment"
            app:destination="@+id/changePasswordOTPFragment">
            <argument
                android:name="showLostPhoneButton"
                android:defaultValue="false"
                app:argType="boolean"/>
            <argument
                android:name="token"
                app:argType="string"
                app:nullable="false"/>
            <argument
                android:name="username"
                app:argType="string"
                app:nullable="false"/>
            <argument
                android:name="email"
                app:argType="string"
                app:nullable="false"/>
            <argument
                android:name="phone"
                app:argType="string"
                app:nullable="false"/>
        </action>
    </fragment>
    <fragment
        android:label="ChangePasswordOTPFragment"
        android:name="com.stockbit.personalamend.ui.changepassword.otp.ChangePasswordOTPInputFragment"
        android:id="@+id/changePasswordOTPFragment">
        <argument
            android:name="showLostPhoneButton"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="availableChannel"
            app:argType="com.stockbit.personalamend.model.OTPChannelValueNavParam[]"/>
        <argument
            android:name="defaultChannel"
            app:argType="com.stockbit.features.model.OTPChannelValue"/>
    </fragment>
    <fragment
        android:label="ChangePasswordFaceMatching"
        android:name="com.stockbit.personalamend.ui.changepassword.facematching.ChangePasswordFaceMatchingFragment"
        android:id="@+id/changePasswordFaceMatchingFragment">
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
    </fragment>
</navigation>
