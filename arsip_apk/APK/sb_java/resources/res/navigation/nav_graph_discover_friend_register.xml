<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/graph_friend_discover_register"
    app:startDestination="@+id/fragmentRegisterDiscoverFriend">
    <fragment
        android:name="com.stockbit.onboarding.ui.discoverfriend.DiscoverFriendRegisterFragment"
        android:id="@+id/fragmentRegisterDiscoverFriend">
        <argument
            android:name="tradingRegisterComplete"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="isReferralDialogAlreadyDisplayed"
            android:defaultValue="false"
            app:argType="boolean"/>
        <action
            android:id="@+id/openConnectToContactDialog"
            app:destination="@+id/connectToContact"/>
        <action
            android:id="@+id/openMainTabActivity"
            app:destination="@+id/mainTabActivity"/>
        <action
            android:id="@+id/openFragmentStock"
            app:destination="@+id/fragment_choose_stock_first_time"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.stockbit.onboarding.ui.watchlist.DiscoverWatchlistItemFragment"
        android:id="@+id/fragment_choose_stock_first_time">
        <argument
            android:name="tradingRegisterComplete"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="isReferralDialogAlreadyDisplayed"
            android:defaultValue="false"
            app:argType="boolean"/>
        <action
            android:id="@+id/openMainTabActivity"
            app:destination="@+id/mainTabActivity"/>
    </fragment>
    <activity
        android:name="com.stockbit.core.ui.MainActivity"
        android:id="@+id/mainTabActivity"/>
</navigation>
