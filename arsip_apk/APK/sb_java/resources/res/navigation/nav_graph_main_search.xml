<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_main_search"
    app:startDestination="@+id/exploreFragment">
    <fragment
        android:name="com.stockbit.search.ui.explore.ExploreFragment"
        android:id="@+id/exploreFragment">
        <action
            android:id="@+id/action_exploreFragment_to_discoverSearchFragment"
            app:destination="@+id/discoverSearchFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_exploreMarketFragment_to_catalogFragment"
            app:destination="@+id/catalogFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_exploreMarketFragment_to_catalogHSCFragment"
            app:destination="@+id/catalogHSCFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_exploreMarketFragment_to_searchNego"
            app:destination="@+id/searchNegoCompany"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <argument
            android:name="searchTab"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="isDeeplinkForeignDomestic"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="rankingType"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:name="com.stockbit.search.ui.discover.search.DiscoverSearchFragment"
        android:id="@+id/discoverSearchFragment">
        <action
            android:id="@+id/action_discoverSearchFragment_to_catalogFragment"
            app:destination="@+id/catalogFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_discoverSearchFragment_to_catalogHSCFragment"
            app:destination="@+id/catalogHSCFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_discoverSearchFragment_to_discoverSearchRecentFragment"
            app:destination="@+id/discoverSearchRecentFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.stockbit.search.ui.catalog.CatalogFragment"
        android:id="@+id/catalogFragment">
        <argument
            android:name="catalogName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="catalogSymbol"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="catalogType"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="catalogId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="catalogParent"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="isCatalogIndex"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="isCatalogSector"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="isCatalogSubSector"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="discoverMarketIndexArray"
            android:defaultValue="@null"
            app:argType="com.stockbit.model.entity.discover.DiscoverMarketIndexItemResponseData[]"
            app:nullable="true"/>
        <argument
            android:name="isFromDeeplink"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="marketIndexItems"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.discover.DiscoverMarketIndexItem[]"
            app:nullable="true"/>
        <argument
            android:name="targetSectorId"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="targetSubSectorId"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="subSectorTitle"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="searchSymbol"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="sourcePage"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="sectorCode"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="subSectorCode"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true"/>
        <action
            android:id="@+id/action_catalogFragment_to_catalogSortFragmentDialog"
            app:destination="@+id/catalogSortFragmentDialog"/>
        <action
            android:id="@+id/action_catalogFragment_to_catalogFragment"
            app:destination="@+id/catalogFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="DiscoverSearchRecentFragment"
        android:name="com.stockbit.search.ui.discover.search.DiscoverSearchRecentFragment"
        android:id="@+id/discoverSearchRecentFragment"/>
    <dialog
        android:label="CatalogSortFragmentDialog"
        android:name="com.stockbit.search.ui.catalog.sort.CatalogSortFragmentDialog"
        android:id="@+id/catalogSortFragmentDialog">
        <argument
            android:name="filterList"
            android:defaultValue="0"
            app:argType="integer"/>
    </dialog>
    <fragment
        android:label="SearchCompanyFragment"
        android:name="com.stockbit.search.ui.searchcompany.SearchCompanyFragment"
        android:id="@+id/searchCompany">
        <argument
            android:name="lastTabCompanyPage"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="lastFilterTimeType"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="isPickerMode"
            android:defaultValue="false"
            app:argType="boolean"/>
    </fragment>
    <fragment
        android:label="searchNegoFragment"
        android:name="com.stockbit.search.ui.searchpasarnegocompany.SearchNegoCompanyFragment"
        android:id="@+id/searchNegoCompany"/>
    <fragment
        android:label="CatalogHSCFragment"
        android:name="com.stockbit.search.ui.cataloghsc.CatalogHSCFragment"
        android:id="@+id/catalogHSCFragment">
        <argument
            android:name="isFromDeeplink"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="sourcePage"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="catalogId"
            app:argType="string"/>
    </fragment>
</navigation>
