<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_trading_community"
    app:startDestination="@+id/loadingTradingCommunityFragment">
    <fragment
        android:name="com.stockbit.tradingcommunity.ui.loading.LoadingTradingCommunityFragment"
        android:id="@+id/loadingTradingCommunityFragment">
        <argument
            android:name="communityCode"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="entryPoint"
            android:defaultValue="SETTINGS"
            app:argType="string"/>
        <action
            android:id="@+id/action_loadingTradingCommunityFragment_to_inputCommunityCodeFragment"
            app:destination="@+id/inputCommunityCodeFragment"
            app:popUpTo="@+id/loadingTradingCommunityFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_loadingTradingCommunityFragment_to_tradingCommunityOutcomeFragment"
            app:destination="@+id/tradingCommunityOutcomeFragment"
            app:popUpTo="@+id/loadingTradingCommunityFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_loadingTradingCommunityFragment_to_currentCommunityFragment"
            app:destination="@+id/currentCommunityFragment"
            app:popUpTo="@+id/loadingTradingCommunityFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:name="com.stockbit.tradingcommunity.ui.current.CurrentCommunityFragment"
        android:id="@+id/currentCommunityFragment">
        <argument
            android:name="communityName"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="totalBuy"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="totalSell"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="leaveDate"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="ableToLeave"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="leaderUserName"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="leaderFullName"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="userName"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="userPhoneNumber"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="bibitLinkageState"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="isLeaderHasPILicense"
            app:argType="boolean"/>
        <argument
            android:name="entryPoint"
            android:defaultValue="SETTINGS"
            app:argType="string"/>
        <action
            android:id="@+id/action_currentCommunityFragment_to_inputCommunityCodeFragment"
            app:destination="@+id/inputCommunityCodeFragment"
            app:popUpTo="@+id/currentCommunityFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_currentCommunityFragment_to_tradingCommunityExistingMemberTnCFragment"
            app:destination="@+id/tradingCommunityExistingMemberTnCFragment"/>
    </fragment>
    <fragment
        android:name="com.stockbit.tradingcommunity.ui.input.InputCommunityCodeFragment"
        android:id="@+id/inputCommunityCodeFragment">
        <argument
            android:name="isUserLeaveCommunity"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="communityCode"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="entryPoint"
            android:defaultValue="SETTINGS"
            app:argType="string"/>
        <action
            android:id="@+id/action_inputCommunityCodeFragment_to_successTradingCommunityFragment"
            app:destination="@+id/successTradingCommunityFragment"
            app:popUpTo="@+id/inputCommunityCodeFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_inputCommunityCodeFragment_to_tradingCommunityBibitActivationFragment"
            app:destination="@+id/tradingCommunityBibitActivationFragment"/>
        <action
            android:id="@+id/action_inputCommunityCodeFragment_to_tradingCommunityOutcomeFragment"
            app:destination="@+id/tradingCommunityOutcomeFragment"
            app:popUpTo="@+id/inputCommunityCodeFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:name="com.stockbit.tradingcommunity.ui.tnc.TradingCommunityExistingMemberTnCFragment"
        android:id="@+id/tradingCommunityExistingMemberTnCFragment">
        <argument
            android:name="url"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="communityName"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="tradingCommunityCode"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="leaderUserName"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="userName"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="userPhoneNumber"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="roomId"
            android:defaultValue="0"
            app:argType="integer"/>
        <argument
            android:name="entryPoint"
            android:defaultValue="SETTINGS"
            app:argType="string"/>
        <action
            android:id="@+id/action_tradingCommunityExistingMemberTnCFragment_to_tradingCommunityBibitActivationFragment"
            app:destination="@+id/tradingCommunityBibitActivationFragment"/>
        <action
            android:id="@+id/action_tradingCommunityExistingMemberTnCFragment_to_tradingCommunityOutcomeFragment"
            app:destination="@+id/tradingCommunityOutcomeFragment"/>
    </fragment>
    <fragment
        android:name="com.stockbit.tradingcommunity.ui.leader.TradingCommunityLeaderDashboardFragment"
        android:id="@+id/tradingCommunityLeaderDashboardFragment">
        <argument
            android:name="username"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <action
            android:id="@+id/action_tradingCommunityLeaderDashboardFragment_to_tradingCommunityLeaderDashboardFilterFragment"
            app:destination="@+id/tradingCommunityLeaderDashboardFilterFragment"/>
    </fragment>
    <dialog
        android:name="com.stockbit.tradingcommunity.ui.leader.dialog.TradingCommunityLeaderDashboardFilterDialogFragment"
        android:id="@+id/tradingCommunityLeaderDashboardFilterFragment">
        <argument
            android:name="tradingCommunityFilter"
            app:argType="com.stockbit.domain.model.type.tradingcommunity.TradingCommunityFilterParam"
            app:nullable="true"/>
    </dialog>
    <fragment
        android:name="com.stockbit.tradingcommunity.ui.success.SuccessTradingCommunityFragment"
        android:id="@+id/successTradingCommunityFragment">
        <argument
            android:name="tradingCommunityCode"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="tradingCommunityName"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="leaderUserName"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="userName"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="userPhoneNumber"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="roomId"
            android:defaultValue="0"
            app:argType="integer"/>
        <argument
            android:name="isExistingMember"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="isLeaderHasPILicense"
            app:argType="boolean"/>
        <argument
            android:name="entryPoint"
            android:defaultValue="SETTINGS"
            app:argType="string"/>
        <action
            android:id="@+id/action_successTradingCommunityFragment_to_loadingTradingCommunityFragment"
            app:destination="@+id/loadingTradingCommunityFragment"
            app:popUpTo="@+id/nav_graph_trading_community"
            app:popUpToInclusive="false"/>
    </fragment>
    <fragment
        android:label="TradingCommunityBibitActivationFragment"
        android:name="com.stockbit.tradingcommunity.ui.bibitactivation.TradingCommunityBibitActivationFragment"
        android:id="@+id/tradingCommunityBibitActivationFragment">
        <action
            android:id="@+id/action_tradingCommunityBibitActivationFragment_to_successTradingCommunityFragment"
            app:destination="@+id/successTradingCommunityFragment"/>
        <action
            android:id="@+id/action_tradingCommunityBibitActivationFragment_to_tradingCommunityOutcomeFragment"
            app:destination="@+id/tradingCommunityOutcomeFragment"
            app:popUpTo="@+id/tradingCommunityBibitActivationFragment"
            app:popUpToInclusive="true"/>
        <argument
            android:name="url"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="communityName"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="tradingCommunityCode"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="leaderUserName"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="userName"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="userPhoneNumber"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="roomId"
            android:defaultValue="0"
            app:argType="integer"/>
        <argument
            android:name="isExistingMember"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="entryPoint"
            android:defaultValue="SETTINGS"
            app:argType="string"/>
    </fragment>
    <fragment
        android:label="TradingCommunityOutcomeFragment"
        android:name="com.stockbit.tradingcommunity.ui.outcome.TradingCommunityOutcomeFragment"
        android:id="@+id/tradingCommunityOutcomeFragment">
        <argument
            android:name="outcomeType"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="communityName"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="errorMessage"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="isExistingMember"
            android:defaultValue="false"
            app:argType="boolean"/>
    </fragment>
</navigation>
