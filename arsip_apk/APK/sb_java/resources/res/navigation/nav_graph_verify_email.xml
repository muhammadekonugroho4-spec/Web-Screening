<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_verify_email"
    app:startDestination="@+id/verifyEmailFragment">
    <include app:graph="@navigation/nav_graph_crisp"/>
    <fragment
        android:name="com.stockbit.userauth.ui.verifyemail.VerifyEmailFragment"
        android:id="@+id/verifyEmailFragment">
        <argument
            android:name="EXTRA_EMAIL_VERIFICATION"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.EmailVerificationArg"
            app:nullable="true"/>
        <action
            android:id="@+id/action_verifyEmailFragment_to_crispActivity"
            app:destination="@+id/nav_graph_crisp"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="EXTRA_LAUNCH_LIVE_SUPPORT"
                android:defaultValue="&apos;&apos;"
                app:argType="string"/>
            <argument
                android:name="EXTRA_LAUNCH_LIVE_SUPPORT_MESSAGE"
                android:defaultValue="&apos;&apos;"
                app:argType="string"/>
        </action>
        <action
            android:id="@+id/action_verifyEmailFragment_to_emailConfirmation"
            app:destination="@+id/emailConfirmation"
            app:popUpTo="@+id/verifyEmailFragment"
            app:popUpToInclusive="true">
            <argument
                android:name="type"
                app:argType="com.stockbit.domain.model.type.trading.TradingPinType"
                app:nullable="false"/>
            <argument
                android:name="isFromForgot"
                android:defaultValue="false"
                app:argType="boolean"/>
        </action>
    </fragment>
</navigation>
