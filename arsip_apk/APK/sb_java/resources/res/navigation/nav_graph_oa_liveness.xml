<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_oa_liveness"
    app:startDestination="@+id/oaLivenessPreparationFragment">
    <include app:graph="@navigation/nav_graph_crisp"/>
    <fragment
        android:name="com.stockbit.liveness.ui.oa.OALivenessPreparationFragment"
        android:id="@+id/oaLivenessPreparationFragment">
        <argument
            android:name="isLastForm"
            android:defaultValue="false"
            app:argType="boolean"
            app:nullable="false"/>
        <argument
            android:name="isLivenessRejected"
            android:defaultValue="false"
            app:argType="boolean"
            app:nullable="false"/>
        <argument
            android:name="oaStatusCode"
            android:defaultValue="0"
            app:argType="integer"
            app:nullable="false"/>
        <action
            android:id="@+id/oaLivenessPreparationFragment_to_navGraphCrisp"
            app:destination="@+id/nav_graph_crisp"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="EXTRA_LAUNCH_LIVE_SUPPORT"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true"/>
            <argument
                android:name="EXTRA_LAUNCH_LIVE_SUPPORT_MESSAGE"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true"/>
        </action>
        <action
            android:id="@+id/oaLivenessPreparationFragment_to_livenessMainFragment"
            app:destination="@+id/livenessMainFragment"/>
    </fragment>
    <fragment
        android:name="ai.advance.liveness.sdk.fragment.LivenessMainFragment"
        android:id="@+id/livenessMainFragment"/>
</navigation>
