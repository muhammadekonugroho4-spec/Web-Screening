<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_share_trade"
    app:startDestination="@+id/shareTradeSettingFragment">
    <fragment
        android:name="com.stockbit.sharetrade.ui.setting.ShareTradeSettingFragment"
        android:id="@+id/shareTradeSettingFragment">
        <action
            android:id="@+id/action_shareTradeSettingFragment_to_confirmationAutoShareDiscardDialog"
            app:destination="@+id/confirmationAutoShareDiscardDialog"/>
        <action
            android:id="@+id/action_shareTradeSettingFragment_to_confirmationAutoShareOffDialog"
            app:destination="@+id/confirmationAutoShareOffDialog"/>
        <action
            android:id="@+id/action_shareTradeSettingFragment_to_shareAmountConfirmationDialog"
            app:destination="@+id/shareAmountConfirmationDialog">
            <argument
                android:name="nav_param"
                app:argType="com.stockbit.sharetrade.ui.shareamount.ShareAmountConfirmationNavParam"
                app:nullable="false"/>
        </action>
        <action
            android:id="@+id/action_shareTradeSettingFragment_to_reviewShareAmountDialog"
            app:destination="@+id/reviewShareAmountDialog">
            <argument
                android:name="nav_param"
                app:argType="com.stockbit.sharetrade.ui.review.ReviewShareAmountNavParam"
                app:nullable="false"/>
        </action>
    </fragment>
    <dialog
        android:name="com.stockbit.sharetrade.ui.setting.dialog.ConfirmationAutoShareDiscardDialog"
        android:id="@+id/confirmationAutoShareDiscardDialog"/>
    <dialog
        android:name="com.stockbit.sharetrade.ui.setting.dialog.ConfirmationAutoShareOffDialog"
        android:id="@+id/confirmationAutoShareOffDialog"/>
    <fragment
        android:name="com.stockbit.sharetrade.ui.order.ShareTradeOrderFragment"
        android:id="@+id/shareTradeOrderFragment">
        <argument
            android:name="data"
            app:argType="com.stockbit.domain.model.entity.sharetrade.AutoShareArgs"
            app:nullable="false"/>
        <action
            android:id="@+id/action_shareTradeOrderFragment_to_shareAmountConfirmationDialog"
            app:destination="@+id/shareAmountConfirmationDialog">
            <argument
                android:name="nav_param"
                app:argType="com.stockbit.sharetrade.ui.shareamount.ShareAmountConfirmationNavParam"
                app:nullable="false"/>
        </action>
        <action
            android:id="@+id/action_shareTradeOrderFragment_to_reviewShareAmountDialog"
            app:destination="@+id/reviewShareAmountDialog">
            <argument
                android:name="nav_param"
                app:argType="com.stockbit.sharetrade.ui.review.ReviewShareAmountNavParam"
                app:nullable="false"/>
        </action>
    </fragment>
    <dialog
        android:name="com.stockbit.sharetrade.ui.shareamount.ShareAmountConfirmationDialog"
        android:id="@+id/shareAmountConfirmationDialog">
        <argument
            android:name="nav_param"
            app:argType="com.stockbit.sharetrade.ui.shareamount.ShareAmountConfirmationNavParam"
            app:nullable="false"/>
    </dialog>
    <dialog
        android:name="com.stockbit.sharetrade.ui.review.ReviewShareAmountDialog"
        android:id="@+id/reviewShareAmountDialog">
        <argument
            android:name="nav_param"
            app:argType="com.stockbit.sharetrade.ui.review.ReviewShareAmountNavParam"
            app:nullable="false"/>
    </dialog>
</navigation>
