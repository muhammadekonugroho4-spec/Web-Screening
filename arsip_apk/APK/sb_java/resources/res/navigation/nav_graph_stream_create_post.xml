<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_stream_create_post"
    app:startDestination="@+id/streamCreatePostFragment">
    <fragment
        android:label="CreatePostFragment"
        android:name="com.stockbit.stream.ui.streamcreatepost.StreamCreatePostFragment"
        android:id="@+id/streamCreatePostFragment">
        <argument
            android:name="composeStringData"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="parcelStream"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.stream.Stream"
            app:nullable="true"/>
        <argument
            android:name="streamAttachedSymbol"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="streamAttachedUser"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="postid"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="streamItemPosition"
            android:defaultValue="0"
            app:argType="integer"
            app:nullable="false"/>
        <argument
            android:name="streamIsWantRepost"
            android:defaultValue="false"
            app:argType="boolean"
            app:nullable="false"/>
        <argument
            android:name="streamType"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="imagePath"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="imagePathFromShareIntent"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="parcelLiveStreamId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="parcelLiveStreamTitle"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="parcelLiveStreamCode"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="liveStreamIsWantRepost"
            android:defaultValue="false"
            app:argType="boolean"
            app:nullable="false"/>
        <argument
            android:name="pageContext"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <action
            android:id="@+id/action_streamCreatePostFragment_to_giphSelectFragment"
            app:destination="@+id/giphSelectFragment"/>
        <action
            android:id="@+id/action_streamCreatePostFragment_to_companySelectDialogFragment"
            app:destination="@+id/companySelectDialogFragment"/>
        <action
            android:id="@+id/action_streamCreatePostFragment_to_targetPricePeriodSelectDialogFragment"
            app:destination="@+id/targetPricePeriodSelectDialogFragment"/>
    </fragment>
    <dialog
        android:name="com.stockbit.stream.ui.companyselect.CompanySelectDialogFragment"
        android:id="@+id/companySelectDialogFragment"/>
    <dialog
        android:name="com.stockbit.stream.ui.targetprice.TargetPricePeriodSelectDialogFragment"
        android:id="@+id/targetPricePeriodSelectDialogFragment"/>
    <dialog
        android:name="com.stockbit.common.page.gifsselect.GiphSelectFragment"
        android:id="@+id/giphSelectFragment"/>
</navigation>
