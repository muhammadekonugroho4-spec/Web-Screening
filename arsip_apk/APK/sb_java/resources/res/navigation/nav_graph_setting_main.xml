<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_setting_main"
    app:startDestination="@+id/settingMainFragment">
    <fragment
        android:name="com.stockbit.setting.ui.main.SettingMainFragment"
        android:id="@+id/settingMainFragment">
        <action
            android:id="@+id/action_settingMainFragment_to_settingAccountFragment"
            app:destination="@+id/settingAccountFragment"/>
        <action
            android:id="@+id/action_settingMainFragment_to_createPasswordDialogFragment"
            app:destination="@+id/createPasswordDialogFragment"/>
        <action
            android:id="@+id/action_settingMainFragment_to_settingSecurityFragment"
            app:destination="@+id/settingSecurityFragment"/>
        <action
            android:id="@+id/action_settingMainFragment_to_editNotificationFragment"
            app:destination="@+id/editNotificationFragment"/>
        <action
            android:id="@+id/action_settingMainFragment_to_settingPrivacyFragment"
            app:destination="@+id/settingPrivacyFragment"/>
        <action
            android:id="@+id/action_settingMainFragment_to_settingBiometricFragment"
            app:destination="@+id/settingBiometricFragment"/>
        <action
            android:id="@+id/action_settingMainFragment_to_settingLinkedAccountFragment"
            app:destination="@+id/settingLinkedAccountFragment"/>
        <action
            android:id="@+id/action_settingMainFragment_to_onboardingTransferStockFragment"
            app:destination="@+id/onboardingTransferStockFragment"/>
        <action
            android:id="@+id/action_settingMainFragment_to_settingLanguageFragment"
            app:destination="@+id/settingLanguageFragment"/>
        <action
            android:id="@+id/action_settingMainFragment_to_settingPasswordConfirmationFragment"
            app:destination="@+id/settingPasswordConfirmationFragment"/>
        <action
            android:id="@+id/action_settingMainFragment_to_settingPrivacyTermsOfUseFragment"
            app:destination="@+id/settingPrivacyTermsOfUseFragment"/>
        <action
            android:id="@+id/action_settingMainFragment_to_settingPrivacyPolicyFragment"
            app:destination="@+id/settingPrivacyPolicyFragment"/>
        <action
            android:id="@+id/action_settingMainFragment_to_settingDiagnosticFragment"
            app:destination="@+id/settingDiagnosticFragment"/>
        <action
            android:id="@+id/action_settingMainFragment_to_settingKTUR"
            app:destination="@+id/settingKTURFragment"/>
    </fragment>
    <fragment
        android:label="SettingAccountFragment"
        android:name="com.stockbit.setting.ui.account.SettingAccountFragment"
        android:id="@+id/settingAccountFragment">
        <action
            android:id="@+id/action_settingAccountFragment_to_settingProfileFragment"
            app:destination="@+id/settingProfileFragment"/>
        <action
            android:id="@+id/action_settingAccountFragment_to_deleteAccountFragment"
            app:destination="@+id/deleteAccountFragment"/>
        <action
            android:id="@+id/action_settingAccountFragment_to_settingFreezeAccountFragment"
            app:destination="@+id/settingFreezeAccountFragment"/>
    </fragment>
    <fragment
        android:label="SettingProfileFragment"
        android:name="com.stockbit.setting.ui.profile.SettingProfileFragment"
        android:id="@+id/settingProfileFragment">
        <action
            android:id="@+id/action_settingProfileFragment_to_deleteAccountFragment"
            app:destination="@+id/deleteAccountFragment"/>
    </fragment>
    <fragment
        android:label="DeleteAccountFragment"
        android:name="com.stockbit.setting.ui.profile.delete.DeleteAccountFragment"
        android:id="@+id/deleteAccountFragment">
        <argument
            android:name="webiewUrl"
            app:argType="string"
            app:nullable="false"/>
    </fragment>
    <dialog
        android:label="CreatePasswordDialogFragment"
        android:name="com.stockbit.setting.ui.password.CreatePasswordDialogFragment"
        android:id="@+id/createPasswordDialogFragment">
        <action
            android:id="@+id/action_createPasswordDialogFragment_to_setPasswordFragment"
            app:destination="@+id/setPasswordFragment"/>
    </dialog>
    <fragment
        android:label="SetPasswordFragment"
        android:name="com.stockbit.setting.ui.password.SetPasswordFragment"
        android:id="@+id/setPasswordFragment">
        <action
            android:id="@+id/action_setPasswordFragment_to_settingMainFragment"
            app:destination="@+id/settingMainFragment"
            app:popUpTo="@+id/settingMainFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:label="SettingSecurityFragment"
        android:name="com.stockbit.setting.ui.security.SettingSecurityFragment"
        android:id="@+id/settingSecurityFragment">
        <action
            android:id="@+id/action_settingSecurityFragment_to_settingPasswordConfirmationFragment"
            app:destination="@+id/settingPasswordConfirmationFragment"/>
        <action
            android:id="@+id/action_settingSecurityFragment_to_settingSecurityLoginActivityFragment"
            app:destination="@+id/settingSecurityLoginActivityFragment"/>
    </fragment>
    <fragment
        android:label="SettingPasswordConfirmationFragment"
        android:name="com.stockbit.setting.ui.password.confirmation.SettingPasswordConfirmationFragment"
        android:id="@+id/settingPasswordConfirmationFragment">
        <argument
            android:name="validatePasswordType"
            app:argType="com.stockbit.domain.model.type.PasswordConfirmationType"
            app:nullable="false"/>
    </fragment>
    <fragment
        android:label="SettingSecurityLoginActivityFragment"
        android:name="com.stockbit.setting.ui.security.activity.SettingSecurityLoginActivityFragment"
        android:id="@+id/settingSecurityLoginActivityFragment">
        <action
            android:id="@+id/action_settingSecurityLoginActivityFragment_to_settingSecurityLoginActivityLogoutAllDeviceDialogFragment"
            app:destination="@+id/settingSecurityLoginActivityLogoutAllDeviceDialogFragment"/>
    </fragment>
    <dialog
        android:label="SettingSecurityLoginActivityLogoutAllDeviceDialogFragment"
        android:name="com.stockbit.setting.ui.security.activity.dialog.SettingSecurityLoginActivityLogoutAllDeviceDialogFragment"
        android:id="@+id/settingSecurityLoginActivityLogoutAllDeviceDialogFragment"/>
    <fragment
        android:label="EditNotificationFragment"
        android:name="com.stockbit.setting.ui.notification.EditNotificationFragment"
        android:id="@+id/editNotificationFragment"/>
    <fragment
        android:label="SettingPrivacyFragment"
        android:name="com.stockbit.setting.ui.privacy.SettingPrivacyFragment"
        android:id="@+id/settingPrivacyFragment">
        <action
            android:id="@+id/action_settingPrivacyFragment_to_settingPrivacyPolicyFragment"
            app:destination="@+id/settingPrivacyPolicyFragment"/>
        <action
            android:id="@+id/action_settingPrivacyFragment_to_settingPrivacyTermsOfUseFragment"
            app:destination="@+id/settingPrivacyTermsOfUseFragment"/>
        <action
            android:id="@+id/action_settingPrivacyFragment_to_blockedUserFragment"
            app:destination="@+id/blockedUserFragment"/>
        <action
            android:id="@+id/action_settingPrivacyFragment_to_privacyMainFragment"
            app:destination="@+id/privacyMainFragment"/>
        <action
            android:id="@+id/action_settingPrivacyFragment_to_groupsSettingFragment"
            app:destination="@+id/chatPrivacySettingsFragment"/>
    </fragment>
    <fragment
        android:label="SettingPrivacyPolicyFragment"
        android:name="com.stockbit.setting.ui.privacy.policy.SettingPrivacyPolicyFragment"
        android:id="@+id/settingPrivacyPolicyFragment"/>
    <fragment
        android:label="SettingPrivacyTermsOfUseFragment"
        android:name="com.stockbit.setting.ui.privacy.terms.SettingPrivacyTermsOfUseFragment"
        android:id="@+id/settingPrivacyTermsOfUseFragment"/>
    <fragment
        android:label="BlockedUserFragment"
        android:name="com.stockbit.setting.ui.blockeduser.BlockedUserFragment"
        android:id="@+id/blockedUserFragment"/>
    <fragment
        android:label="PrivacyMainFragment"
        android:name="com.stockbit.setting.ui.privacy.PrivacyMainFragment"
        android:id="@+id/privacyMainFragment">
        <action
            android:id="@+id/action_privacyMainFragment_to_removeAccessDialog"
            app:destination="@+id/removeAccessDialog"/>
        <action
            android:id="@+id/action_privacyMainFragment_to_disconnectContactDialog"
            app:destination="@+id/disconnectContactDialog"/>
    </fragment>
    <fragment
        android:label="ChatPrivacySettingsFragment"
        android:name="com.stockbit.setting.ui.privacy.chat.ChatPrivacySettingsFragment"
        android:id="@+id/chatPrivacySettingsFragment"/>
    <dialog
        android:label="RemoveAccessDialog"
        android:name="com.stockbit.setting.ui.privacy.RemoveAccessDialog"
        android:id="@+id/removeAccessDialog"/>
    <dialog
        android:label="DisconnectContactDialog"
        android:name="com.stockbit.setting.ui.privacy.DisconnectContactDialog"
        android:id="@+id/disconnectContactDialog"/>
    <fragment
        android:label="SettingBiometricFragment"
        android:name="com.stockbit.setting.ui.biometric.SettingBiometricFragment"
        android:id="@+id/settingBiometricFragment">
        <argument
            android:name="needToRevokeSecuritiesBiometric"
            android:defaultValue="false"
            app:argType="boolean"/>
    </fragment>
    <fragment
        android:label="SettingLinkedAccountFragment"
        android:name="com.stockbit.setting.ui.linkedaccount.SettingLinkedAccountFragment"
        android:id="@+id/settingLinkedAccountFragment">
        <action
            android:id="@+id/action_settingLinkedAccountFragment_to_settingLinkedAccountLinkFragment"
            app:destination="@+id/settingLinkedAccountLinkFragment"/>
        <action
            android:id="@+id/action_settingLinkedAccountFragment_to_settingLinkedAccountUnlinkFragment"
            app:destination="@+id/settingLinkedAccountUnlinkFragment"/>
    </fragment>
    <fragment
        android:label="SettingLinkedAccountUnlinkFragment"
        android:name="com.stockbit.setting.ui.linkedaccount.unlink.SettingLinkedAccountUnlinkFragment"
        android:id="@+id/settingLinkedAccountUnlinkFragment">
        <argument
            android:name="EXTRA_LINKED_ACCOUNT_TYPE"
            app:argType="string"
            app:nullable="true"/>
        <action
            android:id="@+id/action_settingLinkedAccountUnlinkFragment_to_settingLinkedAccountUnlinkSuccessDialogFragment"
            app:destination="@+id/settingLinkedAccountUnlinkSuccessDialogFragment"/>
        <action
            android:id="@+id/action_settingLinkedAccountUnlinkFragment_to_unlinkAccountPasswordConfirmationFragment"
            app:destination="@+id/unlinkAccountPasswordConfirmationFragment">
            <argument
                android:name="socialMediaAccountType"
                app:argType="com.stockbit.setting.contract.SocialMediaAccountType"/>
        </action>
    </fragment>
    <fragment
        android:label="unlinkAccountPasswordConfirmationFragment"
        android:name="com.stockbit.setting.ui.linkedaccount.passwordconfirmation.UnlinkAccountPasswordConfirmationFragment"
        android:id="@+id/unlinkAccountPasswordConfirmationFragment">
        <argument
            android:name="socialMediaAccountType"
            app:argType="com.stockbit.setting.contract.SocialMediaAccountType"/>
    </fragment>
    <dialog
        android:label="SettingLinkedAccountUnlinkSuccessDialogFragment"
        android:name="com.stockbit.setting.ui.linkedaccount.dialog.SettingLinkedAccountUnlinkSuccessDialogFragment"
        android:id="@+id/settingLinkedAccountUnlinkSuccessDialogFragment">
        <argument
            android:name="title"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="message"
            app:argType="string"
            app:nullable="true"/>
    </dialog>
    <fragment
        android:label="SettingLinkedAccountLinkFragment"
        android:name="com.stockbit.setting.ui.linkedaccount.link.SettingLinkedAccountLinkFragment"
        android:id="@+id/settingLinkedAccountLinkFragment">
        <argument
            android:name="EXTRALINKEDACCOUNTTYPE"
            app:argType="string"/>
        <action
            android:id="@+id/action_settingLinkedAccountLinkFragment_to_settingLinkedAccountUnlinkSuccessDialogFragment"
            app:destination="@+id/settingLinkedAccountUnlinkSuccessDialogFragment"/>
    </fragment>
    <fragment
        android:label="OnboardingTransferStockFragment"
        android:name="com.stockbit.setting.ui.transferstock.OnboardingTransferStockFragment"
        android:id="@+id/onboardingTransferStockFragment">
        <argument
            android:name="interceptBack"
            android:defaultValue="false"
            app:argType="boolean"/>
    </fragment>
    <fragment
        android:label="SettingLanguageFragment"
        android:name="com.stockbit.setting.ui.language.SettingLanguageFragment"
        android:id="@+id/settingLanguageFragment"/>
    <fragment
        android:label="EditPasswordFragment"
        android:name="com.stockbit.setting.ui.password.EditPasswordFragment"
        android:id="@+id/editPasswordFragment"/>
    <fragment
        android:label="SettingDiagnosticFragment"
        android:name="com.stockbit.setting.ui.diagnostic.SettingDiagnosticFragment"
        android:id="@+id/settingDiagnosticFragment"/>
    <fragment
        android:label="KTURFragment"
        android:name="com.stockbit.setting.ui.ktur.KTURComposeFragment"
        android:id="@+id/settingKTURFragment"/>
    <fragment
        android:label="FreezeAccountFragment"
        android:name="com.stockbit.setting.ui.profile.freeze.FreezeAccountFragment"
        android:id="@+id/settingFreezeAccountFragment">
        <action
            android:id="@+id/action_settingFreezeAccountFragment_to_freezeAccountSuccessFragment"
            app:destination="@+id/freezeAccountSuccessFragment"/>
    </fragment>
    <fragment
        android:label="FreezeAccountSuccessFragment"
        android:name="com.stockbit.setting.ui.profile.freeze.FreezeAccountSuccessFragment"
        android:id="@+id/freezeAccountSuccessFragment"/>
</navigation>
