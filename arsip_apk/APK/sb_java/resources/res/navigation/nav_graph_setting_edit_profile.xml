<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_setting_edit_profile"
    app:startDestination="@+id/settingProfileFragment">
    <fragment
        android:name="com.stockbit.setting.ui.profile.SettingProfileFragment"
        android:id="@+id/settingProfileFragment">
        <action
            android:id="@+id/action_settingProfileFragment_to_onboardingVerifiedBadgeFragment"
            app:destination="@+id/nav_graph_request_verified_badge"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_settingProfileFragment_to_deleteAccountFragment"
            app:destination="@+id/deleteAccountFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.stockbit.setting.ui.profile.delete.DeleteAccountFragment"
        android:id="@+id/deleteAccountFragment">
        <argument
            android:name="webiewUrl"
            app:argType="string"
            app:nullable="false"/>
    </fragment>
</navigation>
