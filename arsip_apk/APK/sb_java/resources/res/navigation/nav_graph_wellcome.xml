<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_wellcome"
    app:startDestination="@+id/fragmentWelcomeMain">
    <include app:graph="@navigation/nav_graph_register_oa"/>
    <include app:graph="@navigation/nav_graph_register_country_select"/>
    <include app:graph="@navigation/nav_graph_user_auth_sms_otp"/>
    <include app:graph="@navigation/nav_graph_validate_otp_email"/>
    <include app:graph="@navigation/nav_graph_fingerprint_trade"/>
    <include app:graph="@navigation/nav_graph_forgot_password"/>
    <include app:graph="@navigation/nav_graph_forgot_phone"/>
    <include app:graph="@navigation/nav_graph_verification"/>
    <include app:graph="@navigation/nav_graph_login_trusted_device"/>
    <include app:graph="@navigation/nav_graph_forgot_pin"/>
    <include app:graph="@navigation/nav_graph_freeze_account"/>
    <include app:graph="@navigation/nav_graph_multi_platform_face_match"/>
    <fragment
        android:label="welcome_home"
        android:name="com.stockbit.onboarding.ui.main.WelcomeMainFragment"
        android:id="@+id/fragmentWelcomeMain">
        <action
            android:id="@+id/openLoginPage"
            app:destination="@+id/fragmentLogin"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/openLoginPageWithInfo"
            app:destination="@+id/fragmentLogin"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="loginSuccessInfoMsg"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true"/>
        </action>
        <action
            android:id="@+id/openRegisterPage"
            app:destination="@+id/fragmentRegister"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/openForgotPasswordPage"
            app:destination="@+id/nav_graph_forgot_password"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/openWelcomeProhibitedDialog"
            app:destination="@+id/fragmentWelcomeProhibitedDialog">
            <argument
                android:name="titleMessage"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true"/>
            <argument
                android:name="subtitleMessage"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true"/>
        </action>
        <action
            android:id="@+id/openFaceMatchPage"
            app:destination="@+id/nav_graph_multi_platform_face_match"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="sessionToken"
                app:argType="string"/>
        </action>
    </fragment>
    <fragment
        android:label="login"
        android:name="com.stockbit.onboarding.ui.login.LoginFragment"
        android:id="@+id/fragmentLogin">
        <argument
            android:name="loginInfoMsg"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="loginSuccessInfoMsg"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="userRegisteredEmail"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <action
            android:id="@+id/action_loginFragment_to_nav_graph_verification"
            app:destination="@+id/nav_graph_verification">
            <argument
                android:name="destinationId"
                app:argType="integer"/>
            <argument
                android:name="destinationArguments"
                app:argType="android.os.Bundle"
                app:nullable="true"/>
        </action>
        <action
            android:id="@+id/openRegisterPage"
            app:destination="@+id/fragmentRegister"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/openForgotPasswordPage"
            app:destination="@+id/nav_graph_forgot_password"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/openFingerprintMainPage"
            app:destination="@+id/nav_graph_fingertprint_trade"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="isRegister"
                android:defaultValue="false"
                app:argType="boolean"/>
        </action>
        <action
            android:id="@+id/openValidatePhoneNumberPage"
            app:destination="@+id/fragmentValidatePhoneNumber"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/openFreezeAccountSuccessRestore"
            app:destination="@+id/freezeAccountSuccessRestoreFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/openTroubleLoginPage"
            app:destination="@+id/troubleLoginFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="troubleLogin"
        android:name="com.stockbit.onboarding.ui.troublelogin.TroubleLoginFragment"
        android:id="@+id/troubleLoginFragment"/>
    <dialog
        android:name="com.stockbit.onboarding.ui.main.WelcomeProhibitedDialog"
        android:id="@+id/fragmentWelcomeProhibitedDialog">
        <argument
            android:name="titleMessage"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="subtitleMessage"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
    </dialog>
    <fragment
        android:label="registerMain"
        android:name="com.stockbit.onboarding.ui.register.RegisterMainFragment"
        android:id="@+id/fragmentRegister">
        <action
            android:id="@+id/openLoginPage"
            app:destination="@+id/fragmentLogin"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/openValidateEmailPage"
            app:destination="@+id/fragmentValidateEmail"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/openRegisterSocialMediaPage"
            app:destination="@+id/fragmentValidateSocialMediaUsername"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/openRegisterPassword"
            app:destination="@+id/registerPasswordInputFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/openVerifyEmail"
            app:destination="@+id/nav_graph_validate_otp_email"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="changeToken"
                app:argType="string"
                app:nullable="true"/>
            <argument
                android:name="newEmail"
                app:argType="string"
                app:nullable="false"/>
            <argument
                android:name="type"
                app:argType="com.stockbit.domain.model.type.VerifyEmailType"
                app:nullable="false"/>
            <argument
                android:name="source"
                app:argType="com.stockbit.domain.model.type.VerifyEmailSource"
                app:nullable="false"/>
        </action>
        <action
            android:id="@+id/openValidateUsernamePage"
            app:destination="@+id/fragmentValidateUsername"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="registerValidateUsernameSocialMedia"
        android:name="com.stockbit.onboarding.ui.register.RegisterUsernameSocialMediaFragment"
        android:id="@+id/fragmentValidateSocialMediaUsername">
        <action
            android:id="@+id/openValidatePasswordPage"
            app:destination="@+id/registerPasswordInputFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/openValidateEmailPage"
            app:destination="@+id/fragmentValidateEmail"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/openLoginPage"
            app:destination="@+id/fragmentLogin"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="registerValidateEmail"
        android:name="com.stockbit.onboarding.ui.register.RegisterEmailFragment"
        android:id="@+id/fragmentValidateEmail">
        <action
            android:id="@+id/openValidateUsernamePage"
            app:destination="@+id/fragmentValidateUsername"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/openValidateFullnamePage"
            app:destination="@+id/fragmentValidateFullname"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/openValidatePasswordPage"
            app:destination="@+id/registerPasswordInputFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/openVerifyEmail"
            app:destination="@+id/nav_graph_validate_otp_email"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="changeToken"
                app:argType="string"
                app:nullable="true"/>
            <argument
                android:name="newEmail"
                app:argType="string"
                app:nullable="false"/>
            <argument
                android:name="type"
                app:argType="com.stockbit.domain.model.type.VerifyEmailType"
                app:nullable="false"/>
            <argument
                android:name="source"
                app:argType="com.stockbit.domain.model.type.VerifyEmailSource"
                app:nullable="false"/>
        </action>
        <action
            android:id="@+id/openLoginPage"
            app:destination="@+id/fragmentLogin"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:launchSingleTop="true"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/fragmentRegister"
            app:popUpToInclusive="true">
            <argument
                android:name="loginInfoMsg"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true"/>
            <argument
                android:name="userRegisteredEmail"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true"/>
        </action>
    </fragment>
    <fragment
        android:label="registerValidateFullname"
        android:name="com.stockbit.onboarding.ui.register.RegisterFullNameFragment"
        android:id="@+id/fragmentValidateFullname">
        <action
            android:id="@+id/openValidateUsernamePage"
            app:destination="@+id/fragmentValidateUsername"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="registerValidateUsername"
        android:name="com.stockbit.onboarding.ui.register.RegisterUsernameFragment"
        android:id="@+id/fragmentValidateUsername">
        <action
            android:id="@+id/openValidatePasswordPage"
            app:destination="@+id/registerPasswordInputFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="registerValidatePassword"
        android:name="com.stockbit.onboarding.ui.register.RegisterPasswordFragment"
        android:id="@+id/fragmentValidatePassword">
        <action
            android:id="@+id/openValidatePhoneNumberPage"
            app:destination="@+id/fragmentValidatePhoneNumber"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="RegisterPasswordInputFragment"
        android:name="com.stockbit.onboarding.ui.register.password.RegisterPasswordInputFragment"
        android:id="@+id/registerPasswordInputFragment">
        <action
            android:id="@+id/openRegisterPasswordConfirmFragment"
            app:destination="@+id/registerPasswordInputConfirmFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="RegisterPasswordInputConfirm"
        android:name="com.stockbit.onboarding.ui.register.password.RegisterPasswordInputConfirmFragment"
        android:id="@+id/registerPasswordInputConfirmFragment">
        <action
            android:id="@+id/openValidatePhoneNumberPage"
            app:destination="@+id/fragmentValidatePhoneNumber"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="registerValidatePhoneNumber"
        android:name="com.stockbit.onboarding.ui.register.RegisterPhoneNumberFragment"
        android:id="@+id/fragmentValidatePhoneNumber">
        <action
            android:id="@+id/openTradingOpeningAccount"
            app:destination="@+id/nav_graph_register_oa"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/openLoginPage"
            app:destination="@+id/fragmentLogin"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:launchSingleTop="true"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/fragmentRegister"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/openValidateCountryPage"
            app:destination="@+id/nav_graph_register_country_select"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:launchSingleTop="true"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/nav_graph_wellcome"
            app:popUpToInclusive="true"/>
        <argument
            android:name="registerParams"
            app:argType="com.stockbit.domain.model.valueobject.Register"
            app:nullable="true"/>
        <action
            android:id="@+id/openValidateSmsVerificationPage"
            app:destination="@+id/nav_graph_user_auth_sms_otp"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="smsOtpType"
                app:argType="com.stockbit.domain.model.type.otp.SmsOTPType"
                app:nullable="false"/>
        </action>
        <action
            android:id="@+id/openWhatsAppAuthPage"
            app:destination="@+id/fragmentRegisterWhatsAppAuth"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="registerWhatsAppAuth"
        android:name="com.stockbit.onboarding.ui.register.whatsapp.RegisterWhatsAppAuthFragment"
        android:id="@+id/fragmentRegisterWhatsAppAuth">
        <action
            android:id="@+id/openLoginPage"
            app:destination="@+id/fragmentLogin"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:launchSingleTop="true"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/fragmentRegister"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/openTradingOpeningAccount"
            app:destination="@+id/nav_graph_register_oa"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/openValidateSmsVerificationPage"
            app:destination="@+id/nav_graph_user_auth_sms_otp"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="smsOtpType"
                app:argType="com.stockbit.domain.model.type.otp.SmsOTPType"
                app:nullable="false"/>
        </action>
    </fragment>
    <action
        android:id="@+id/openMainTabActivity"
        app:destination="@+id/mainTabActivity"/>
    <activity
        android:name="com.stockbit.core.ui.MainActivity"
        android:id="@+id/mainTabActivity">
        <argument
            android:name="isVerified"
            android:defaultValue="false"
            app:argType="boolean"/>
    </activity>
    <dialog
        android:name="com.stockbit.common.page.connectcontactdialog.ConnectContactDialogFragment"
        android:id="@+id/connectToContact"/>
    <fragment
        android:label="FreezeAccountSuccessRestoreFragment"
        android:name="com.stockbit.feature.freezeaccount.contract.ui.FreezeAccountSuccessRestoreFragment"
        android:id="@+id/freezeAccountSuccessRestoreFragment"/>
</navigation>
