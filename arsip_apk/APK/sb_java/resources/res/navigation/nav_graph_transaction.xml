<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_transaction"
    app:startDestination="@+id/buyStockComposeFragment">
    <fragment
        android:name="com.stockbit.feature.transaction.ui.specialmonitoring.SpecialMonitoringFragment"
        android:id="@+id/fragmentSpecialMonitoring"/>
    <fragment
        android:name="com.stockbit.feature.transaction.ui.nego.orderstock.OrderNegoStockFragment"
        android:id="@+id/orderNegoStockFragment">
        <argument
            android:name="symbol"
            android:defaultValue=""
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="name"
            android:defaultValue=""
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="companyType"
            android:defaultValue=""
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="orderNegoScreenType"
            app:argType="com.stockbit.feature.transaction.contract.model.type.OrderNegoScreenType"/>
        <action
            android:id="@+id/action_orderNegoStockFragment_to_orderNegoTnCFragment"
            app:destination="@+id/orderNegoTnCFragment">
            <argument
                android:name="url"
                android:defaultValue=""
                app:argType="string"
                app:nullable="false"/>
        </action>
    </fragment>
    <fragment
        android:name="com.stockbit.feature.transaction.ui.nego.orderstock.tnc.OrderNegoTnCFragment"
        android:id="@+id/orderNegoTnCFragment">
        <argument
            android:name="url"
            android:defaultValue=""
            app:argType="string"
            app:nullable="false"/>
    </fragment>
    <fragment
        android:name="com.stockbit.feature.transaction.ui.buystockcompose.BuyStockComposeFragment"
        android:id="@+id/buyStockComposeFragment">
        <argument
            android:name="symbol"
            android:defaultValue=""
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="name"
            android:defaultValue=""
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="buySource"
            android:defaultValue=""
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="companyType"
            android:defaultValue=""
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="currentOrderType"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <action
            android:id="@+id/action_buyStockComposeFragment_to_fastTradeFragment"
            app:destination="@+id/fastTradeFragment"
            app:popUpTo="@+id/buyStockComposeFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_buyStockComposeFragment_to_buyStockComposeFragment"
            app:destination="@+id/buyStockComposeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/buyStockComposeFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_buyStockComposeFragment_to_tradingLimitTermConditionFragment"
            app:destination="@+id/securitiesTermConditionFragment"/>
        <action
            android:id="@+id/action_buyStockComposeFragment_to_specialMonitoringFragment"
            app:destination="@+id/fragmentSpecialMonitoring"/>
        <action
            android:id="@+id/action_buyStockComposeFragment_to_previewExchangeFeeBottomSheet"
            app:destination="@+id/previewExchangeFeeBottomSheet"/>
    </fragment>
    <fragment
        android:name="com.stockbit.feature.transaction.ui.sellstockcompose.SellStockComposeFragment"
        android:id="@+id/sellComposeFragment">
        <argument
            android:name="companySymbol"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="companyType"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="averagePrice"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="averagePriceFee"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="sellPath"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="isShariaStock"
            app:argType="boolean"/>
        <argument
            android:name="autoOrderType"
            app:argType="com.stockbit.domain.model.type.securities.AutoOrderType"
            app:nullable="true"/>
        <argument
            android:name="autoOrderData"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.securities.AutoSellData"
            app:nullable="true"/>
        <action
            android:id="@+id/action_sellComposeFragment_to_fastTradeFragment"
            app:destination="@+id/fastTradeFragment"/>
        <action
            android:id="@+id/action_sellComposeFragment_to_specialMonitoringFragment"
            app:destination="@+id/fragmentSpecialMonitoring"/>
        <action
            android:id="@+id/action_sellComposeFragment_to_securitiesTermConditionFragment"
            app:destination="@+id/securitiesTermConditionFragment"/>
        <action
            android:id="@+id/action_sellComposeFragment_to_sellComposeFragment"
            app:destination="@+id/sellComposeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/sellComposeFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:name="com.stockbit.feature.transaction.ui.exercise.ExerciseFragment"
        android:id="@+id/exerciseFragment">
        <argument
            android:name="symbol"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="exerciseType"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="infoExercise"
            app:argType="string"
            app:nullable="false"/>
        <action
            android:id="@+id/action_exerciseFragment_to_tradingActionConfirmationDialogFragment"
            app:destination="@+id/tradingActionConfirmationDialogFragment">
            <argument
                android:name="parcelTradingConfirmation"
                android:defaultValue="@null"
                app:argType="com.stockbit.domain.model.entity.securities.TradingConfirmationDialogModel"
                app:nullable="true"/>
        </action>
    </fragment>
    <fragment
        android:name="com.stockbit.feature.transaction.ui.amend.buy.AmendBuyFragment"
        android:id="@+id/amendBuyFragment">
        <argument
            android:name="EXTRA_SYMBOL"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_LAST_PRICE"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_ORDER_ID"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_LOT"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_RESULT_SUM_LOT"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_TOTAL_AMOUNT"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_PARCEL_ORDERLIST_DETAIL"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.securities.DetailOrderEntity"
            app:nullable="true"/>
        <argument
            android:name="stopLossBracketOrder"
            android:defaultValue="@null"
            app:argType="com.stockbit.usecase.securities.model.order.BracketOrderUIState"
            app:nullable="true"/>
        <argument
            android:name="takeProfitBracketOrder"
            android:defaultValue="@null"
            app:argType="com.stockbit.usecase.securities.model.order.BracketOrderUIState"
            app:nullable="true"/>
        <action
            android:id="@+id/action_amendBuyFragment_to_tradingActionConfirmationDialogFragment"
            app:destination="@+id/tradingActionConfirmationDialogFragment">
            <argument
                android:name="parcelTradingConfirmation"
                android:defaultValue="@null"
                app:argType="com.stockbit.domain.model.entity.securities.TradingConfirmationDialogModel"
                app:nullable="true"/>
        </action>
        <action
            android:id="@+id/action_amendBuyFragment_to_specialMonitoringFragment"
            app:destination="@+id/fragmentSpecialMonitoring"/>
        <action
            android:id="@+id/action_amendBuyFragment_to_dayTradeUnavailableBottomSheet"
            app:destination="@+id/dayTradeUnavailableBottomSheet"/>
    </fragment>
    <fragment
        android:label="AmendBuyStockComposeFragment"
        android:name="com.stockbit.feature.transaction.ui.amend.buy.compose.AmendBuyStockComposeFragment"
        android:id="@+id/amendBuyStockComposeFragment">
        <argument
            android:name="amendBuy"
            app:argType="com.stockbit.feature.transaction.contract.AmendBuyExtra"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_PARCEL_TRADE_TYPE"
            android:defaultValue="UNSPECIFIED"
            app:argType="com.stockbit.usecase.securities.model.order.PortfolioType"
            app:nullable="false"/>
        <action
            android:id="@+id/action_amendBuyStockComposeFragment_to_specialMonitoringFragment"
            app:destination="@+id/fragmentSpecialMonitoring"/>
        <action
            android:id="@+id/action_amendBuyStockComposeFragment_to_dayTradeUnavailableBottomSheet"
            app:destination="@+id/dayTradeUnavailableBottomSheet"/>
    </fragment>
    <fragment
        android:name="com.stockbit.feature.transaction.ui.amend.sell.compose.AmendSellStockComposeFragment"
        android:id="@+id/amendSellStockComposeFragment">
        <argument
            android:name="amendSell"
            app:argType="com.stockbit.feature.transaction.contract.AmendSellExtra"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_PARCEL_TRADE_TYPE"
            android:defaultValue="UNSPECIFIED"
            app:argType="com.stockbit.usecase.securities.model.order.PortfolioType"
            app:nullable="false"/>
        <action
            android:id="@+id/action_amendSellStockComposeFragment_to_specialMonitoringFragment"
            app:destination="@+id/fragmentSpecialMonitoring"/>
        <action
            android:id="@+id/action_amendSellStockComposeFragment_to_dayTradeUnavailableBottomSheet"
            app:destination="@+id/dayTradeUnavailableBottomSheet"/>
    </fragment>
    <fragment
        android:name="com.stockbit.feature.transaction.ui.securitiestnc.SecuritiesTermConditionFragment"
        android:id="@+id/securitiesTermConditionFragment">
        <argument
            android:name="termsConditionFeatureType"
            app:argType="com.stockbit.feature.transaction.contract.TermsAndConditionFeatureType[]"
            app:nullable="false"/>
    </fragment>
    <fragment
        android:name="com.stockbit.feature.transaction.ui.fasttrade.FastTradeComposeFragment"
        android:id="@+id/fastTradeFragment">
        <argument
            android:name="isShariaStock"
            app:argType="boolean"/>
        <argument
            android:name="companyInfo"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.CompanyV2"
            app:nullable="true"/>
        <argument
            android:name="isSplitOrderActive"
            android:defaultValue="false"
            app:argType="boolean"
            app:nullable="false"/>
        <argument
            android:name="sourcePage"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="orderbookViewUIState"
            android:defaultValue="@null"
            app:argType="com.stockbit.component.orderbook.model.OrderbookViewUIState"
            app:nullable="true"/>
        <argument
            android:name="bestBidAskUIState"
            android:defaultValue="@null"
            app:argType="com.stockbit.component.orderbook.model.OrderbookBestBidAskUIState"
            app:nullable="true"/>
        <argument
            android:name="symbol"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="buyPath"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_PRICE_AVERAGE"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_PRICE_AVERAGE_FEE"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_SELL_PATH"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="autoOrderData"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.securities.AutoSellData"
            app:nullable="true"/>
        <action
            android:id="@+id/action_fastTradeFragment_to_tradingLimitTermConditionFragment"
            app:destination="@+id/securitiesTermConditionFragment"/>
        <action
            android:id="@+id/action_fastTradeFragment_to_buyStockComposeFragment"
            app:destination="@+id/buyStockComposeFragment"
            app:popUpTo="@+id/fastTradeFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_fastTradeFragment_to_sellStockComposeFragment"
            app:destination="@+id/sellComposeFragment"
            app:popUpTo="@+id/fastTradeFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_fastTradeFragment_to_securitiesTermConditionFragment"
            app:destination="@+id/securitiesTermConditionFragment"/>
        <action
            android:id="@+id/action_fastTradeFragment_to_fastTradeFragment"
            app:destination="@+id/fastTradeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/fastTradeFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <dialog
        android:name="com.stockbit.feature.transaction.ui.dialog.confirmation.TradingActionConfirmationDialogFragment"
        android:id="@+id/tradingActionConfirmationDialogFragment">
        <argument
            android:name="parcelTradingConfirmation"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.securities.TradingConfirmationDialogModel"
            app:nullable="true"/>
        <action
            android:id="@+id/action_tradingActionConfirmationDialogFragment_to_dayTradeUnavailableBottomSheet"
            app:destination="@+id/dayTradeUnavailableBottomSheet"/>
        <action
            android:id="@+id/action_tradingActionConfirmationDialogFragment_to_previewExchangeFeeBottomSheet"
            app:destination="@+id/previewExchangeFeeBottomSheet"/>
    </dialog>
    <dialog
        android:name="com.stockbit.feature.transaction.ui.dialog.daytrade.DayTradeUnavailableBottomSheet"
        android:id="@+id/dayTradeUnavailableBottomSheet">
        <argument
            android:name="startTime"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="endTime"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="dayTradeUnavailableType"
            app:argType="com.stockbit.feature.transaction.ui.dialog.daytrade.DayTradeUnavailableType"/>
    </dialog>
    <dialog
        android:label="PreviewExchangeFeeBottomSheet"
        android:name="com.stockbit.feature.transaction.ui.dialog.confirmation.PreviewExchangeFeeBottomSheet"
        android:id="@+id/previewExchangeFeeBottomSheet">
        <argument
            android:name="isDayTrade"
            app:argType="boolean"/>
        <argument
            android:name="companyType"
            app:argType="string"/>
        <argument
            android:name="confirmationPage"
            app:argType="com.stockbit.domain.model.entity.securities.TransactionConfirmationType"/>
    </dialog>
    <dialog
        android:label="AmendSellTradingConfirmationBottomSheet"
        android:name="com.stockbit.feature.transaction.ui.dialog.confirmation.amendsell.AmendSellTradingConfirmationBottomSheet"
        android:id="@+id/amendSellTradingConfirmationBottomSheet">
        <argument
            android:name="confirmationModel"
            app:argType="com.stockbit.domain.model.entity.securities.TransactionConfirmationUIState"/>
        <action
            android:id="@+id/action_tradingAmendSellConfirmationDialog_to_dayTradeUnavailableBottomSheet"
            app:destination="@+id/dayTradeUnavailableBottomSheet"/>
        <action
            android:id="@+id/action_tradingAmendSellConfirmationDialog_to_previewExchangeFeeBottomSheet"
            app:destination="@+id/previewExchangeFeeBottomSheet"/>
    </dialog>
    <dialog
        android:label="CancelTradingConfirmationBottomSheet"
        android:name="com.stockbit.feature.transaction.ui.dialog.confirmation.cancel.CancelTradingConfirmationBottomSheet"
        android:id="@+id/cancelTradingConfirmationBottomSheet">
        <argument
            android:name="confirmationModel"
            app:argType="com.stockbit.domain.model.entity.securities.TransactionConfirmationUIState"/>
    </dialog>
    <fragment
        android:label="SecuritiesTermsConditionWithAPIFragment"
        android:name="com.stockbit.feature.transaction.ui.termscondition.SecuritiesTermsConditionWithAPIFragment"
        android:id="@+id/securitiesTermsConditionWithAPIFragment">
        <argument
            android:name="termsConditionFeatureType"
            app:argType="com.stockbit.feature.transaction.contract.TermsAndConditionFeatureType[]"
            app:nullable="false"/>
        <argument
            android:name="extraParam"
            android:defaultValue="@null"
            app:argType="com.stockbit.feature.transaction.contract.model.NavigationUIParam"
            app:nullable="true"/>
    </fragment>
</navigation>
