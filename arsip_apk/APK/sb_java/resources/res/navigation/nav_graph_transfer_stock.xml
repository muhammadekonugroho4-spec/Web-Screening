<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_transfer_stock"
    app:startDestination="@+id/transferStockMainFragment">
    <fragment
        android:name="com.stockbit.transferstock.ui.inputdata.checkemail.CheckEmailFragment"
        android:id="@+id/fragmentCheckEmail"/>
    <fragment
        android:name="com.stockbit.transferstock.ui.transaction.MainTransactionFragment"
        android:id="@+id/transferStockMainFragment">
        <action
            android:id="@+id/action_transferStockMainFragment_to_brokerageFragment"
            app:destination="@+id/brokerageFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_transferStockMainFragment_to_transactionDetailFragment"
            app:destination="@+id/transactionDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_transferStockMainFragment_to_inputDataFragment"
            app:destination="@+id/inputDataFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <argument
            android:name="showHistoryTab"
            android:defaultValue="false"
            app:argType="boolean"/>
    </fragment>
    <fragment
        android:name="com.stockbit.transferstock.ui.brokers.BrokerFragment"
        android:id="@+id/brokerageFragment">
        <action
            android:id="@+id/action_brokerageFragment_to_inputDataFragment"
            app:destination="@+id/inputDataFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_brokerageFragment_to_anotherBrokerageFragment"
            app:destination="@+id/anotherBrokerageFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <argument
            android:name="fromOnboard"
            android:defaultValue="true"
            app:argType="boolean"/>
    </fragment>
    <fragment
        android:name="com.stockbit.transferstock.ui.brokers.AnotherBrokerFragment"
        android:id="@+id/anotherBrokerageFragment">
        <action
            android:id="@+id/action_anotherBrokerageFragment_to_inputDataFragment"
            app:destination="@+id/inputDataFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <argument
            android:name="fromOnboard"
            android:defaultValue="true"
            app:argType="boolean"/>
    </fragment>
    <fragment
        android:name="com.stockbit.transferstock.ui.inputdata.MainInputDataFragment"
        android:id="@+id/inputDataFragment">
        <action
            android:id="@+id/action_inputDataFragment_to_setSymbolDialog"
            app:destination="@+id/setSymbolDialog"/>
        <action
            android:id="@+id/action_inputDataFragment_to_optionSymbolDialog"
            app:destination="@+id/optionSymbolDialog"/>
        <action
            android:id="@+id/action_inputDataFragment_to_confirmationDataDialog"
            app:destination="@+id/confirmationDataDialog"/>
        <action
            android:id="@+id/action_inputDataFragment_to_transferStockMainFragment_popUpTo_inputDataFragment"
            app:destination="@+id/transferStockMainFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/inputDataFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_inputDataFragment_to_transferStockMainFragment_popUpTo_brokerageFragment"
            app:destination="@+id/transferStockMainFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/brokerageFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_inputDataFragment_to_transferStockMainFragment_popUpTo_transferStockMainFragment"
            app:destination="@+id/transferStockMainFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/transferStockMainFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_inputDataFragment_to_webviewActivity"
            app:destination="@+id/webviewActivity"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <argument
            android:name="security"
            app:argType="com.stockbit.domain.model.valueobject.Securities"/>
        <argument
            android:name="fromOnboard"
            android:defaultValue="true"
            app:argType="boolean"/>
        <argument
            android:name="isFromDeeplink"
            android:defaultValue="false"
            app:argType="boolean"/>
    </fragment>
    <activity
        android:name="com.stockbit.transferstock.ui.inputdata.webview.WebViewActivity"
        android:id="@+id/webviewActivity">
        <argument
            android:name="url"
            app:argType="string"/>
        <argument
            android:name="title"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
    </activity>
    <fragment
        android:name="com.stockbit.transferstock.ui.transaction.detail.TransactionDetailFragment"
        android:id="@+id/transactionDetailFragment">
        <argument
            android:name="security"
            app:argType="com.stockbit.domain.model.valueobject.Securities"/>
        <action
            android:id="@+id/action_transactionDetailFragment_to_cancelRequestDialog"
            app:destination="@+id/cancelRequestDialog"/>
        <action
            android:id="@+id/action_transactionDetailFragment_to_brokerageFragment"
            app:destination="@+id/brokerageFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_transactionDetailFragment_to_inputDataFragment"
            app:destination="@+id/inputDataFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <dialog
        android:name="com.stockbit.transferstock.ui.inputdata.setsymbol.dialog.SetSymbolDialog"
        android:id="@+id/setSymbolDialog">
        <argument
            android:name="stock"
            app:argType="com.stockbit.domain.model.valueobject.FieldValueArray"
            app:nullable="true"/>
        <argument
            android:name="position"
            android:defaultValue="0"
            app:argType="integer"/>
    </dialog>
    <dialog
        android:name="com.stockbit.transferstock.ui.inputdata.setsymbol.dialog.OptionSymbolDialog"
        android:id="@+id/optionSymbolDialog">
        <argument
            android:name="stock"
            app:argType="com.stockbit.domain.model.valueobject.FieldValueArray"
            app:nullable="false"/>
        <argument
            android:name="position"
            android:defaultValue="0"
            app:argType="integer"/>
    </dialog>
    <dialog
        android:name="com.stockbit.transferstock.ui.inputdata.setsymbol.dialog.ConfirmationDataDialog"
        android:id="@+id/confirmationDataDialog">
        <argument
            android:name="mapping"
            app:argType="com.stockbit.domain.model.valueobject.openingaccount.Mapping"
            app:nullable="true"/>
        <action
            android:id="@+id/action_confirmationDataDialog_to_informationDialog"
            app:destination="@+id/informationDialog"/>
    </dialog>
    <dialog
        android:name="com.stockbit.transferstock.ui.inputdata.setsymbol.dialog.InformationDialog"
        android:id="@+id/informationDialog"/>
    <dialog
        android:name="com.stockbit.transferstock.ui.transaction.detail.CancelRequestDialog"
        android:id="@+id/cancelRequestDialog"/>
</navigation>
