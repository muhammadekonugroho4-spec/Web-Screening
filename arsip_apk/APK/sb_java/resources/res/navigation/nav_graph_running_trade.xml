<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_running_trade"
    app:startDestination="@+id/runningTradeFragment">
    <fragment
        android:name="com.stockbit.runningtrade.ui.RunningTradeFragment"
        android:id="@+id/runningTradeFragment">
        <action
            android:id="@+id/action_runningTradeFragment_to_runningTradeAccessDialogFragment"
            app:destination="@+id/runningTradeAccessDialogFragment"/>
        <action
            android:id="@+id/action_runningTradeFragment_to_advanceFilterFragment"
            app:destination="@+id/advanceFilterFragment">
            <argument
                android:name="EXTRA_FILTER"
                app:argType="com.stockbit.runningtrade.params.FilterRunningTradeParam"
                app:nullable="false"/>
            <argument
                android:name="EXTRA_IS_OPEN_MARKET"
                android:defaultValue="false"
                app:argType="boolean"
                app:nullable="false"/>
        </action>
        <argument
            android:name="isFromDeeplink"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="EXTRA_SYMBOL"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_SYMBOL_LOGO"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="filterDate"
            android:defaultValue=""
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="filterMaxDate"
            android:defaultValue=""
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="isOpenMergeView"
            android:defaultValue="false"
            app:argType="boolean"/>
    </fragment>
    <fragment
        android:name="com.stockbit.runningtrade.ui.filter.AdvanceFilterFragment"
        android:id="@+id/advanceFilterFragment">
        <argument
            android:name="EXTRA_FILTER"
            app:argType="com.stockbit.runningtrade.params.FilterRunningTradeParam"
            app:nullable="false"/>
        <argument
            android:name="EXTRA_IS_OPEN_MARKET"
            android:defaultValue="false"
            app:argType="boolean"
            app:nullable="false"/>
    </fragment>
    <fragment
        android:name="com.stockbit.runningtrade.ui.chartfilter.ChartStockFilterFragment"
        android:id="@+id/chartStockFilterFragment">
        <argument
            android:name="initialSearch"
            app:argType="string"/>
    </fragment>
    <dialog
        android:name="com.stockbit.runningtrade.ui.dialog.RunningTradeAccessDialog"
        android:id="@+id/runningTradeAccessDialogFragment"/>
    <fragment
        android:name="com.stockbit.runningtrade.ui.brokerflow.BrokerFlowFragment"
        android:id="@+id/brokerFlowFragment">
        <argument
            android:name="symbol"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="symbolLogo"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="companyName"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="companyType"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="period"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="periodFrom"
            android:defaultValue="@null"
            app:argType="java.util.Calendar"
            app:nullable="true"/>
        <argument
            android:name="periodTo"
            android:defaultValue="@null"
            app:argType="java.util.Calendar"
            app:nullable="true"/>
        <argument
            android:name="chartType"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="investorType"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="marketType"
            android:defaultValue=""
            app:argType="string"/>
        <action
            android:id="@+id/action_runningTradeFragment_to_chartStockFilterFragment"
            app:destination="@+id/chartStockFilterFragment"/>
        <action
            android:id="@+id/action_runningTradeFragment_to_brokerFlowInfoDialogFragment"
            app:destination="@+id/brokerFlowInfoDialogFragment"/>
    </fragment>
    <dialog
        android:name="com.stockbit.runningtrade.ui.brokerflow.BrokerFlowInfoDialogFragment"
        android:id="@+id/brokerFlowInfoDialogFragment"/>
</navigation>
