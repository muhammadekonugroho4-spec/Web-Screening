<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_change_email"
    app:startDestination="@+id/changeEmailOTPInputFragment">
    <fragment
        android:name="com.stockbit.personalamend.ui.changeemail.change.ChangeEmailFragment"
        android:id="@+id/changeEmailFragment">
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
    </fragment>
    <fragment
        android:name="com.stockbit.personalamend.ui.changeemail.confirmcurrent.ChangeEmailPasswordConfirmationFragment"
        android:id="@+id/changeEmailPasswordConfirmationFragment">
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="changeRequestType"
            app:argType="com.stockbit.usecase.personalamend.model.ChangeTokenReqTypeUIState"
            app:nullable="false"/>
        <action
            android:id="@+id/action_changeEmailPasswordConfirmationFragment_to_forgotPassword"
            app:destination="@+id/nav_graph_forgot_password">
            <argument
                android:name="email"
                app:argType="string"
                app:nullable="false"/>
            <argument
                android:name="phone"
                app:argType="string"
                app:nullable="false"/>
        </action>
    </fragment>
    <fragment
        android:label="ChangeEmailOTPInputFragment"
        android:name="com.stockbit.personalamend.ui.changeemail.otp.confirmcurrent.ChangeEmailOTPInputFragment"
        android:id="@+id/changeEmailOTPInputFragment">
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="availableChannel"
            android:defaultValue="@null"
            app:argType="com.stockbit.personalamend.model.OTPChannelValueNavParam[]"
            app:nullable="true"/>
        <argument
            android:name="defaultChannel"
            android:defaultValue="@null"
            app:argType="com.stockbit.features.model.OTPChannelValue"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:label="ChangeEmailFaceMatchingFragment"
        android:name="com.stockbit.personalamend.ui.changeemail.facematching.ChangeEmailFaceMatchingFragment"
        android:id="@+id/changeEmailFaceMatchingFragment">
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
    </fragment>
    <fragment
        android:label="ChangeEmailNewInputOTPFragment"
        android:name="com.stockbit.personalamend.ui.changeemail.otp.newinput.ChangeEmailNewInputOTPFragment"
        android:id="@+id/changeEmailNewInputOTPFragment">
        <argument
            android:name="newEmail"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="availableChannel"
            app:argType="com.stockbit.personalamend.model.OTPChannelValueNavParam[]"/>
        <argument
            android:name="defaultChannel"
            app:argType="com.stockbit.features.model.OTPChannelValue"/>
    </fragment>
    <fragment
        android:label="ChangeEmailVerifyIdentityFragment"
        android:name="com.stockbit.personalamend.ui.changeemail.identity.ChangeEmailVerifyIdentityFragment"
        android:id="@+id/changeEmailVerifyIdentityFragment">
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
    </fragment>
</navigation>
