<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_portfolio_stock"
    app:startDestination="@+id/portfolioStocksDetailFragment">
    <fragment
        android:name="com.stockbit.feature.portfolio.ui.customsort.CustomSortPortfolioFragment"
        android:id="@+id/customSortPortfolioFragment">
        <argument
            android:name="isHideOddLot"
            android:defaultValue="false"
            app:argType="boolean"
            app:nullable="false"/>
        <argument
            android:name="isCompleteView"
            android:defaultValue="false"
            app:argType="boolean"
            app:nullable="false"/>
        <argument
            android:name="currentSort"
            app:argType="integer"/>
    </fragment>
    <fragment
        android:name="com.stockbit.feature.portfolio.ui.webview.PortfolioWebViewFragment"
        android:id="@+id/portfolioWebViewFragment">
        <argument
            android:name="title"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="url"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:name="com.stockbit.feature.portfolio.presentation.detail.PortfolioStocksDetailFragment"
        android:id="@+id/portfolioStocksDetailFragment">
        <argument
            android:name="extraSymbol"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="extraTradeType"
            android:defaultValue="UNSPECIFIED"
            app:argType="com.stockbit.usecase.securities.model.order.PortfolioType"
            app:nullable="false"/>
        <argument
            android:name="isOpenedFromBuySell"
            android:defaultValue="false"
            app:argType="boolean"
            app:nullable="false"/>
        <action
            android:id="@+id/action_portfolioStocksDetailFragment_to_portfolioOrderlistHistoryFragment"
            app:destination="@+id/portfolioOrderlistHistoryFragment"/>
    </fragment>
    <fragment
        android:name="com.stockbit.feature.portfolio.presentation.warrant.PortfolioWarrantDetailFragment"
        android:id="@+id/portfolioWarrantDetailFragment">
        <argument
            android:name="extraSymbol"
            app:argType="string"
            app:nullable="false"/>
        <action
            android:id="@+id/action_portfolioStocksWarrantDetailFragment_to_portfolioOrderlistHistoryFragment"
            app:destination="@+id/portfolioOrderlistHistoryFragment"/>
    </fragment>
    <fragment
        android:name="com.stockbit.feature.portfolio.presentation.orderlisthistory.PortfolioOrderlistHistoryFragment"
        android:id="@+id/portfolioOrderlistHistoryFragment">
        <argument
            android:name="symbol"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="tradeType"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="isFromOrderList"
            app:argType="boolean"
            app:nullable="false"/>
        <argument
            android:name="useCompleteView"
            android:defaultValue="false"
            app:argType="boolean"
            app:nullable="false"/>
    </fragment>
</navigation>
