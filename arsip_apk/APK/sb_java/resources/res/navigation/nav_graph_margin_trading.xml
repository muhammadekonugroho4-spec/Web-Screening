<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_margin_trading"
    app:startDestination="@+id/marginTradingLandingPageComposeFragment">
    <fragment
        android:label="MarginTradingLandingPageFragment"
        android:name="com.stockbit.feature.margintrading.ui.landingpage.MarginTradingLandingPageComposeFragment"
        android:id="@+id/marginTradingLandingPageComposeFragment">
        <argument
            android:name="marginTradingInformation"
            app:argType="com.stockbit.usecase.margintrading.model.MarginTradingActivationUIState"
            app:nullable="true"/>
        <action
            android:id="@+id/action_marginTradingLandingPageComposeFragment_to_addCollateralComposeFragment"
            app:destination="@+id/addCollateralComposeFragment"/>
    </fragment>
    <fragment
        android:label="AddCollateralComposeFragment"
        android:name="com.stockbit.feature.margintrading.collateral.AddCollateralComposeFragment"
        android:id="@+id/addCollateralComposeFragment">
        <argument
            android:name="marginTradingInformation"
            app:argType="com.stockbit.usecase.margintrading.model.MarginTradingActivationUIState"
            app:nullable="true"/>
        <argument
            android:name="isAddAdditionalCollateral"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="additionalInfo"
            app:argType="com.stockbit.feature.margintrading.model.AdditionalCollateralArgs"
            app:nullable="true"/>
        <action
            android:id="@+id/action_addCollateralComposeFragment_to_addCashCollateralFragment"
            app:destination="@+id/addCashCollateralFragment"/>
        <action
            android:id="@+id/action_addCollateralComposeFragment_to_addAssetCollateralFragment"
            app:destination="@+id/addAssetCollateralFragment"/>
        <action
            android:id="@+id/action_addCollateralComposeFragment_to_marginTradingAgreementFragment"
            app:destination="@+id/marginTradingAgreementFragment"/>
    </fragment>
    <fragment
        android:name="com.stockbit.feature.margintrading.ui.cash.AddCashCollateralFragment"
        android:id="@+id/addCashCollateralFragment">
        <argument
            android:name="cashCollateral"
            app:argType="com.stockbit.usecase.margintrading.model.AddCashCollateralUIState"
            app:nullable="true"/>
        <argument
            android:name="isAddAdditionalCollateral"
            android:defaultValue="false"
            app:argType="boolean"/>
    </fragment>
    <fragment
        android:name="com.stockbit.feature.margintrading.ui.asset.AddAssetCollateralFragment"
        android:id="@+id/addAssetCollateralFragment">
        <argument
            android:name="assetCollateral"
            app:argType="com.stockbit.usecase.margintrading.model.AddAssetCollateralUIState"
            app:nullable="true"/>
        <argument
            android:name="isAddAdditionalCollateral"
            android:defaultValue="false"
            app:argType="boolean"/>
    </fragment>
    <fragment
        android:label="marginTradingAgreementFragment"
        android:name="com.stockbit.feature.margintrading.ui.termcondition.MarginTradingAgreementFragment"
        android:id="@+id/marginTradingAgreementFragment">
        <action
            android:id="@+id/action_marginTradingAgreementFragment_to_marginTradingESignFragment"
            app:destination="@+id/marginTradingESignFragment"/>
    </fragment>
    <fragment
        android:label="MarginTradingESignFragment"
        android:name="com.stockbit.feature.margintrading.ui.esign.MarginTradingESignFragment"
        android:id="@+id/marginTradingESignFragment"/>
    <fragment
        android:label="MarginRatioFragment"
        android:name="com.stockbit.feature.margintrading.ui.marginratio.MarginRatioFragment"
        android:id="@+id/marginRatioFragment"/>
</navigation>
