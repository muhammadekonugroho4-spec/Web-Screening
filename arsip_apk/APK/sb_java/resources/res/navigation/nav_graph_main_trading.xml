<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_main_trading"
    app:startDestination="@+id/tradingMainFragment">
    <fragment
        android:label="MainTrading"
        android:name="com.stockbit.trading.ui.main.TradingMainFragment"
        android:id="@+id/tradingMainFragment">
        <argument
            android:name="EXTRA_TRADING_FRAGMENT_ROUTE_REQUEST"
            android:defaultValue="0"
            app:argType="integer"/>
        <argument
            android:name="EXTRA_TARGET_HISTORY_REQUEST"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_REFRESH_HISTORY_PAGE"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="EXTRA_TARGET_ORDER_REQUEST"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_SHARE_TRADE_SUCCESS_MESSAGE"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_CASH_SWEEP_SUCCESS_MESSAGE"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_MARGIN_TRADING_SUCCESS_MESSAGE"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_TRADING_SWITCH_PORTFOLIO_REQUEST"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_TRADING_FRAGMENT_ORDER_TYPE"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.type.securities.StockbitOrderlistType"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_HISTORY_STOCK_CODE"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_HISTORY_PERIOD_PARAM"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_HISTORY_PERIOD_START_DATE"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_HISTORY_PERIOD_END_DATE"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_AUTO_OPEN_FIRST_ITEM"
            android:defaultValue="false"
            app:argType="boolean"/>
    </fragment>
</navigation>
