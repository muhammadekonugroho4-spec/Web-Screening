<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_verification"
    app:startDestination="@+id/startBlankFragment">
    <include app:graph="@navigation/nav_graph_forgot_pin"/>
    <fragment
        android:label="StartBlankFragment"
        android:name="com.stockbit.feature.verification.ui.starter.StartBlankFragment"
        android:id="@+id/startBlankFragment">
        <argument
            android:name="destinationId"
            app:argType="integer"/>
        <argument
            android:name="destinationArguments"
            app:argType="android.os.Bundle"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:label="PasswordVerificationFragment"
        android:name="com.stockbit.feature.verification.ui.password.PasswordVerificationFragment"
        android:id="@+id/passwordVerificationFragment"/>
    <fragment
        android:label="PinVerificationFragment"
        android:name="com.stockbit.feature.verification.ui.pin.PinVerificationFragment"
        android:id="@+id/pinVerificationFragment">
        <action
            android:id="@+id/action_faceMatchingVerificationFragment_to_nav_graph_forgot_pin"
            app:destination="@+id/nav_graph_forgot_pin">
            <argument
                android:name="destinationId"
                app:argType="integer"/>
            <argument
                android:name="destinationArguments"
                app:argType="android.os.Bundle"
                app:nullable="true"/>
        </action>
    </fragment>
    <fragment
        android:label="OTPVerificationFragment"
        android:name="com.stockbit.feature.verification.ui.otp.OTPVerificationFragment"
        android:id="@+id/otpVerificationFragment">
        <argument
            android:name="showLostPhoneButton"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="verificationToken"
            app:argType="string"/>
        <argument
            android:name="defaultChannel"
            app:argType="com.stockbit.feature.verification.model.VerificationOTPChannelParam"/>
        <argument
            android:name="availableChannels"
            app:argType="com.stockbit.feature.verification.model.VerificationOTPChannelParam[]"/>
    </fragment>
    <fragment
        android:label="FaceMatchingVerificationFragment"
        android:name="com.stockbit.feature.verification.ui.facematching.FaceMatchingVerificationFragment"
        android:id="@+id/faceMatchingVerificationFragment"/>
    <fragment
        android:label="IdentityVerificationFragment"
        android:name="com.stockbit.feature.verification.ui.identity.IdentityVerificationFragment"
        android:id="@+id/identityVerificationFragment"/>
    <fragment
        android:label="DukcapilVerificationFragment"
        android:name="com.stockbit.feature.verification.ui.dukcapil.DukcapilVerificationFragment"
        android:id="@+id/dukcapilVerificationFragment">
        <argument
            android:name="entryMode"
            android:defaultValue="FROM_CHALLENGE"
            app:argType="com.stockbit.verification.contract.VerificationEntryMode"/>
        <argument
            android:name="verificationToken"
            android:defaultValue=""
            app:argType="string"/>
    </fragment>
</navigation>
