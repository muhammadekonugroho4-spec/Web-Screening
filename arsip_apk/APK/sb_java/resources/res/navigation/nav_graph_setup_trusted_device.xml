<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_setup_trusted_device"
    app:startDestination="@+id/setupOnboardingFragment">
    <fragment
        android:label="SetupOnboardingFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.setup.onboarding.SetupOnboardingFragment"
        android:id="@+id/setupOnboardingFragment"/>
    <fragment
        android:label="SetupPasswordFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.setup.password.SetupPasswordFragment"
        android:id="@+id/setupPasswordFragment"/>
    <fragment
        android:label="SetupPinFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.setup.pin.SetupPinFragment"
        android:id="@+id/setupPinFragment"/>
    <fragment
        android:label="SetupOTPFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.setup.otp.SetupOTPFragment"
        android:id="@+id/setupOTPFragment">
        <argument
            android:name="email"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="phone"
            app:argType="string"
            app:nullable="false"/>
    </fragment>
    <fragment
        android:label="SetupSuccessFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.setup.success.SetupSuccessFragment"
        android:id="@+id/setupSuccessFragment"/>
    <fragment
        android:label="SetupAlreadyUsedFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.setup.error.alreadyused.SetupAlreadyUsedFragment"
        android:id="@+id/setupAlreadyUsedFragment"/>
    <fragment
        android:label="SetupErrorNoSecuritiesAccountFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.setup.error.nosecuritiesaccount.SetupErrorNoSecuritiesAccountFragment"
        android:id="@+id/setupErrorNoSecuritiesAccountFragment"/>
    <fragment
        android:label="SetupErrorPendingKycFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.setup.error.pendingkyc.SetupErrorPendingKycFragment"
        android:id="@+id/setupErrorPendingKycFragment"/>
    <fragment
        android:label="SetupOTPSenderFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.setup.otp.SetupOTPSenderFragment"
        android:id="@+id/setupOTPSenderFragment"/>
    <fragment
        android:label="SetupCompletionFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.setup.success.SetupCompletionFragment"
        android:id="@+id/setupCompletionFragment"/>
    <fragment
        android:label="SetupErrorTokenFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.setup.error.uploadtoken.SetupErrorTokenFragment"
        android:id="@+id/setupErrorTokenFragment">
        <argument
            android:name="timeleft"
            app:argType="long"/>
    </fragment>
    <fragment
        android:label="SetupErrorTokenMaxRetryFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.setup.error.uploadtoken.SetupErrorTokenMaxRetryFragment"
        android:id="@+id/setupErrorTokenMaxRetryFragment"/>
    <fragment
        android:label="SetupFaceMatchingFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.setup.facematching.SetupFaceMatchingFragment"
        android:id="@+id/setupFaceMatchingFragment"/>
</navigation>
