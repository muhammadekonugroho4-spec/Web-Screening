<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_academy"
    app:startDestination="@+id/academyFragment">
    <fragment
        android:name="com.stockbit.academy.ui.academy.AcademyFragment"
        android:id="@+id/academyFragment">
        <argument
            android:name="EXTRA_CURRENT_TAB_ID"
            android:defaultValue="0"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="EXTRA_STOCKBIT_ACADEMY_URL"
            android:defaultValue=""
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="academyEntrySource"
            android:defaultValue=""
            app:argType="string"
            app:nullable="false"/>
    </fragment>
</navigation>
