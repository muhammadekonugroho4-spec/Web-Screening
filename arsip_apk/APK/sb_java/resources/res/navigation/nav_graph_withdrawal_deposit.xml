<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_withdrawal_deposit"
    app:startDestination="@+id/settingDepositFragment">
    <include app:graph="@navigation/nav_graph_securities_forgot_pin"/>
    <fragment
        android:name="com.stockbit.withdrawaldeposit.ui.deposit.history.DepositHistoryFragment"
        android:id="@+id/depositHistoryFragment"/>
    <fragment
        android:name="com.stockbit.withdrawaldeposit.ui.withdrawal.WithdrawalFragment"
        android:id="@+id/withdrawalFragment">
        <action
            android:id="@+id/action_withdrawalFragment_to_settingWithdrawConfirmationDialog"
            app:destination="@+id/settingWithdrawConfirmationDialog"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="showWarningOperational"
                android:defaultValue="false"
                app:argType="boolean"
                app:nullable="false"/>
        </action>
        <action
            android:id="@+id/action_withdrawalFragment_to_settingWithdrawConfirmationSuccessDialog"
            app:destination="@+id/settingWithdrawConfirmationSuccessDialog"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="extraWithdrawalMessage"
                app:argType="string"
                app:nullable="true"/>
        </action>
        <action
            android:id="@+id/action_withdrawalFragment_to_settingWithdrawConfirmationFailedDialog"
            app:destination="@+id/settingWithdrawConfirmationFailedDialog"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="extraWithdrawalMessage"
                app:argType="string"
                app:nullable="true"/>
        </action>
        <action
            android:id="@+id/action_withdrawalFragment_to_settingHistoryFragment"
            app:destination="@+id/settingHistoryFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="openWithdrawalHistory"
                android:defaultValue="false"
                app:argType="boolean"/>
        </action>
        <action
            android:id="@+id/action_withdrawalFragment_to_balanceWithdrawInformationDialog"
            app:destination="@+id/balanceWithdrawInformationDialog"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_withdrawalFragment_to_withdrawalForeignFragment"
            app:destination="@+id/withdrawalForeignFragment"/>
    </fragment>
    <fragment
        android:name="com.stockbit.withdrawaldeposit.ui.withdrawalforeign.WithdrawalForeignFragment"
        android:id="@+id/withdrawalForeignFragment">
        <action
            android:id="@+id/action_withdrawalForeignFragment_to_withdrawalForeignCurrencyFragment"
            app:destination="@+id/withdrawalForeignCurrencyFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_withdrawalForeignFragment_to_withdrawalForeignSuccessDialog"
            app:destination="@+id/withdrawalForeignSuccessDialog"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="extraWithdrawalMessage"
                app:argType="string"
                app:nullable="true"/>
        </action>
        <action
            android:id="@+id/action_withdrawalForeignFragment_to_withdrawalForeignFailedDialog"
            app:destination="@+id/withdrawalForeignFailedDialog"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="extraWithdrawalMessage"
                app:argType="string"
                app:nullable="true"/>
        </action>
        <action
            android:id="@+id/action_withdrawalForeignFragment_to_settingHistoryFragment"
            app:destination="@+id/settingHistoryFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="openWithdrawalHistory"
                android:defaultValue="false"
                app:argType="boolean"/>
        </action>
        <action
            android:id="@+id/action_withdrawalForeignFragment_to_balanceWithdrawInformationDialog"
            app:destination="@+id/balanceWithdrawInformationDialog"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.stockbit.withdrawaldeposit.ui.withdrawalforeign.WithdrawalForeignCurrencyFragment"
        android:id="@+id/withdrawalForeignCurrencyFragment">
        <action
            android:id="@+id/action_withdrawalForeignCurrencyFragment_to_withdrawalConfirmationForeignFragment"
            app:destination="@+id/withdrawalConfirmationForeignFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_withdrawalForeignCurrencyFragment_to_withdrawalForeignSwiftCodeDialogFragment"
            app:destination="@+id/withdrawalForeignSwiftCodeDialogFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.stockbit.withdrawaldeposit.ui.withdrawalforeign.WithdrawalConfirmationForeignFragment"
        android:id="@+id/withdrawalConfirmationForeignFragment">
        <action
            android:id="@+id/action_withdrawalConfirmationForeignFragment_to_withdrawalForeignSignatureFragment"
            app:destination="@+id/withdrawalForeignSignatureFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.stockbit.withdrawaldeposit.ui.withdrawalforeign.WithdrawalForeignSignatureFragment"
        android:id="@+id/withdrawalForeignSignatureFragment">
        <action
            android:id="@+id/onOpenWithdrawPinFragment"
            app:destination="@+id/withdrawalPinFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.stockbit.withdrawaldeposit.ui.withdrawalforeign.pin.WithdrawalPinFragment"
        android:id="@+id/withdrawalPinFragment">
        <action
            android:id="@+id/action_withdrawalPinFragment_to_withdrawalForeignFragment"
            app:destination="@+id/withdrawalForeignFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_withdrawalPinFragment_to_securitiesForgotPin"
            app:destination="@+id/nav_graph_securities_forgot_pin"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="validateKtpConfirmationType"
                app:argType="com.stockbit.domain.model.type.KtpConfirmationType"
                app:nullable="false"/>
        </action>
    </fragment>
    <fragment
        android:name="com.stockbit.withdrawaldeposit.ui.deposit.SettingDepositFragment"
        android:id="@+id/settingDepositFragment">
        <action
            android:id="@+id/action_settingDepositFragment_to_settingDepositDetailFragment"
            app:destination="@+id/settingDepositDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="depositProvider"
                app:argType="com.stockbit.domain.model.entity.deposit.Provider"
                app:nullable="false"/>
            <argument
                android:name="rdnDetail"
                app:argType="com.stockbit.domain.model.entity.deposit.RdnDetail"
                app:nullable="true"/>
            <argument
                android:name="paymentTypeName"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true"/>
        </action>
        <action
            android:id="@+id/action_settingDepositFragment_to_settingHistoryFragment"
            app:destination="@+id/settingHistoryFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="openWithdrawalHistory"
                android:defaultValue="false"
                app:argType="boolean"/>
        </action>
        <action
            android:id="@+id/action_settingDepositFragment_to_rdnDepositDescriptionDialog"
            app:destination="@+id/rdnDepositDescriptionDialog"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_settingDepositFragment_to_swiftCodeDepositDialog"
            app:destination="@+id/swiftCodeDepositDialog"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.stockbit.withdrawaldeposit.ui.deposit.detail.SettingDepositDetailFragment"
        android:id="@+id/settingDepositDetailFragment">
        <argument
            android:name="depositProvider"
            app:argType="com.stockbit.domain.model.entity.deposit.Provider"
            app:nullable="false"/>
        <argument
            android:name="rdnDetail"
            app:argType="com.stockbit.domain.model.entity.deposit.RdnDetail"
            app:nullable="true"/>
        <argument
            android:name="paymentTypeName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:name="com.stockbit.withdrawaldeposit.ui.history.SettingHistoryFragment"
        android:id="@+id/settingHistoryFragment">
        <argument
            android:name="openWithdrawalHistory"
            android:defaultValue="false"
            app:argType="boolean"/>
        <action
            android:id="@+id/action_settingHistoryFragment_to_settingDepositFragment"
            app:destination="@+id/settingDepositFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/settingHistoryFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_settingHistoryFragment_to_withdrawalDetailFragment"
            app:destination="@+id/withdrawalDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="withdrawalData"
                app:argType="android.os.Parcelable"
                app:nullable="false"/>
        </action>
        <action
            android:id="@+id/action_settingHistoryFragment_to_depositDetailFragment"
            app:destination="@+id/depositDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="depositData"
                app:argType="android.os.Parcelable"
                app:nullable="false"/>
        </action>
    </fragment>
    <fragment
        android:name="com.stockbit.withdrawaldeposit.ui.withdrawal.historydetail.WithdrawalDetailFragment"
        android:id="@+id/withdrawalDetailFragment">
        <argument
            android:name="withdrawalData"
            app:argType="android.os.Parcelable"/>
    </fragment>
    <fragment
        android:name="com.stockbit.withdrawaldeposit.ui.deposit.historydetail.DepositDetailFragment"
        android:id="@+id/depositDetailFragment">
        <argument
            android:name="depositData"
            app:argType="android.os.Parcelable"/>
    </fragment>
    <dialog
        android:name="com.stockbit.withdrawaldeposit.ui.history.PeriodeDialogFragment"
        android:id="@+id/periodeDialog">
        <argument
            android:name="keyHistoryPeriod"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="keyHistoryPeriodNavResult"
            android:defaultValue="HISTORY_PERIOD"
            app:argType="string"/>
    </dialog>
    <dialog
        android:name="com.stockbit.withdrawaldeposit.ui.deposit.dialog.SwiftCodeDepositDialogFragment"
        android:id="@+id/swiftCodeDepositDialog"/>
    <dialog
        android:name="com.stockbit.withdrawaldeposit.ui.deposit.dialog.RDNDepositDescriptionBottomSheet"
        android:id="@+id/rdnDepositDescriptionDialog"/>
    <dialog
        android:name="com.stockbit.withdrawaldeposit.ui.withdrawalforeign.dialog.WithdrawalSuccessDialogFragment"
        android:id="@+id/withdrawalForeignSuccessDialog">
        <argument
            android:name="extraWithdrawalMessage"
            app:argType="string"
            app:nullable="true"/>
        <action
            android:id="@+id/action_withdrawalForeignSuccessDialog_to_settingHistoryFragment"
            app:destination="@+id/settingHistoryFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="openWithdrawalHistory"
                android:defaultValue="false"
                app:argType="boolean"/>
        </action>
    </dialog>
    <dialog
        android:name="com.stockbit.withdrawaldeposit.ui.withdrawalforeign.dialog.WithdrawalFailedDialogFragment"
        android:id="@+id/withdrawalForeignFailedDialog">
        <argument
            android:name="extraWithdrawalMessage"
            app:argType="string"
            app:nullable="true"/>
    </dialog>
    <dialog
        android:name="com.stockbit.withdrawaldeposit.ui.withdrawal.dialog.SettingWithdrawConfirmationDialogFragment"
        android:id="@+id/settingWithdrawConfirmationDialog">
        <argument
            android:name="showWarningOperational"
            android:defaultValue="false"
            app:argType="boolean"
            app:nullable="false"/>
        <argument
            android:name="hasMultipleAccount"
            android:defaultValue="false"
            app:argType="boolean"
            app:nullable="false"/>
    </dialog>
    <dialog
        android:name="com.stockbit.withdrawaldeposit.ui.withdrawal.dialog.SettingWithdrawConfirmationSuccessDialogFragment"
        android:id="@+id/settingWithdrawConfirmationSuccessDialog">
        <argument
            android:name="extraWithdrawalMessage"
            app:argType="string"
            app:nullable="true"/>
        <action
            android:id="@+id/action_settingWithdrawConfirmationSuccessDialog_to_settingHistoryFragment"
            app:destination="@+id/settingHistoryFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="openWithdrawalHistory"
                android:defaultValue="false"
                app:argType="boolean"/>
        </action>
    </dialog>
    <dialog
        android:name="com.stockbit.withdrawaldeposit.ui.withdrawal.dialog.SettingWithdrawConfirmationFailedDialogFragment"
        android:id="@+id/settingWithdrawConfirmationFailedDialog">
        <argument
            android:name="extraWithdrawalMessage"
            app:argType="string"
            app:nullable="true"/>
    </dialog>
    <dialog
        android:name="com.stockbit.withdrawaldeposit.ui.withdrawal.dialog.BalanceWithdrawInformationDialogFragment"
        android:id="@+id/balanceWithdrawInformationDialog"/>
    <dialog
        android:name="com.stockbit.withdrawaldeposit.ui.withdrawalforeign.dialog.WithdrawalForeignSwiftCodeDialogFragment"
        android:id="@+id/withdrawalForeignSwiftCodeDialogFragment"/>
    <action
        android:id="@+id/action_to_periodeDialog"
        app:destination="@+id/periodeDialog"/>
</navigation>
