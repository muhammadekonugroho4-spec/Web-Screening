<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_screener"
    app:startDestination="@+id/screenerMainFragment">
    <fragment
        android:name="com.stockbit.screener.ui.main.ScreenerMainFragment"
        android:id="@+id/screenerMainFragment">
        <action
            android:id="@+id/action_screenerMainFragment_to_accessDialogFragment"
            app:destination="@+id/screenerMainAccessDialog"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_screenerMainFragment_to_screenerSavedFragment"
            app:destination="@+id/screenerSavedFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_screenerMainFragment_to_screenerFavoriteFragment"
            app:destination="@+id/screenerFavoriteFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_screenerMainFragment_to_screenerPresetNewFragment"
            app:destination="@+id/screenerPresetNewFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_screenerMainFragment_to_screenerPaywallDialogFragment"
            app:destination="@+id/screenerPaywallDialogFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_screenerMainFragment_to_screenerScreenFragment"
            app:destination="@+id/screenerScreenFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_screenerMainFragment_to_screenerCreateNewFragment"
            app:destination="@+id/screenerCreateNewFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <argument
            android:name="isFromDeeplink"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="presetId"
            android:defaultValue="0L"
            app:argType="long"/>
        <argument
            android:name="presetDetail"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="requestKey"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:label="ScreenerPresetNewFragment"
        android:name="com.stockbit.screener.ui.preset.ScreenerPresetDetailFragment"
        android:id="@+id/screenerPresetNewFragment">
        <argument
            android:name="presetName"
            app:argType="string"/>
        <argument
            android:name="presetImageUrl"
            app:argType="string"/>
        <argument
            android:name="presetParentId"
            app:argType="string"/>
        <argument
            android:name="isFromDeeplink"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="deeplinkDetailPresetId"
            app:argType="long"/>
        <action
            android:id="@+id/action_screenerPresetNewFragment_to_screenerScreenFragment"
            app:destination="@+id/screenerScreenFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="ScreenerSavedFragment"
        android:name="com.stockbit.screener.ui.saved.ScreenerSavedFragment"
        android:id="@+id/screenerSavedFragment">
        <action
            android:id="@+id/action_screenerSavedFragment_to_screenerScreenFragment"
            app:destination="@+id/screenerScreenFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="ScreenerFavoriteFragment"
        android:name="com.stockbit.screener.ui.favorites.ScreenerFavoritesFragment"
        android:id="@+id/screenerFavoriteFragment">
        <action
            android:id="@+id/action_screenerFavoriteFragment_to_screenerScreenMainFragment"
            app:destination="@+id/screenerScreenFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <dialog
        android:name="com.stockbit.screener.ui.main.ScreenerMainAccessDialog"
        android:id="@+id/screenerMainAccessDialog"/>
    <dialog
        android:name="com.stockbit.screener.ui.main.ScreenerPaywallDialogFragment"
        android:id="@+id/screenerPaywallDialogFragment">
        <argument
            android:name="subscriptionDesc"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="subscriptionValue"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="product_id"
            app:argType="integer"/>
        <argument
            android:name="is_new_user"
            android:defaultValue="false"
            app:argType="boolean"/>
    </dialog>
    <fragment
        android:label="ScreenerUniverseFragment"
        android:name="com.stockbit.screener.ui.universe.ScreenerUniverseFragment"
        android:id="@+id/screenerUniverseFragment">
        <argument
            android:name="requestKey"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="universeScopeId"
            android:defaultValue=""
            app:argType="string"/>
    </fragment>
    <fragment
        android:label="ScreenerScreenFragment"
        android:name="com.stockbit.screener.ui.screen.ScreenerScreenFragment"
        android:id="@+id/screenerScreenFragment">
        <argument
            android:name="screenerScreen"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.screener.ScreenerScreen"
            app:nullable="true"/>
        <argument
            android:name="screenerCalcs"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.screener.ScreenerCalcs[]"
            app:nullable="true"/>
        <argument
            android:name="screenerRules"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.screener.ScreenerRule[]"
            app:nullable="true"/>
        <argument
            android:name="screenerColumns"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.screener.ScreenerColumn[]"
            app:nullable="true"/>
        <argument
            android:name="screenerName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="isFromSavedData"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="screenerPresetData"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.screener.ScreenerPreset"
            app:nullable="true"/>
        <argument
            android:name="ARG_SCREENER_ID"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="ARG_SCREENER_NAME"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="ARG_SCREENER_TYPE"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="ARG_SCREENER_FAVORITE"
            android:defaultValue="0"
            app:argType="integer"/>
        <argument
            android:name="EXTRA_SCREENER_SAVED_POSITION"
            android:defaultValue="0"
            app:argType="integer"/>
        <argument
            android:name="ARG_FROM_SCREENER_FAVORITE"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="EXTRA_SCREENER_FAV_DATA"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.screener.ScreenerFavorite"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_SCREENER_PRESET_DATA_NEW"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.screener.ScreenerPreset"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_SCREENER_CREATE_NEW_DATA"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.screener.ScreenerScreen"
            app:nullable="true"/>
        <argument
            android:name="requestKey"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <action
            android:id="@+id/action_screenerScreenFragment_to_screenerCreateNewFragment"
            app:destination="@+id/screenerCreateNewFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_screenerScreenFragment_to_screenerFinancialMetricFragment"
            app:destination="@+id/screenerFinancialMetricHomeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.stockbit.screener.ui.createnew.ScreenerCreateNewFragment"
        android:id="@+id/screenerCreateNewFragment">
        <action
            android:id="@+id/action_screenerCreateNewFragment_to_screenerUniverseFragment"
            app:destination="@+id/screenerUniverseFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_screenerCreateNewFragment_to_screenerScreenFragment"
            app:destination="@+id/screenerScreenFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_screenerCreateNewFragment_to_addRulesFragmentAdd"
            app:destination="@+id/addRulesFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="position"
                android:defaultValue="-1"
                app:argType="integer"/>
            <argument
                android:name="rulesType"
                android:defaultValue="BASIC_RATIO"
                app:argType="com.stockbit.model.type.ScreenerRulesType"/>
            <argument
                android:name="screenerRules"
                android:defaultValue="@null"
                app:argType="com.stockbit.screener.args.ScreenerRuleArgs"
                app:nullable="true"/>
        </action>
        <argument
            android:name="requestKey"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="screenerRules"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.screener.ScreenerRule[]"
            app:nullable="true"/>
        <argument
            android:name="screenerScreen"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.screener.ScreenerScreen"
            app:nullable="true"/>
        <argument
            android:name="screenerName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="screenerId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:label="ScreenerAddRulesFragment"
        android:name="com.stockbit.screener.ui.addrules.ScreenerAddRulesFragment"
        android:id="@+id/addRulesFragment">
        <argument
            android:name="position"
            android:defaultValue="-1"
            app:argType="integer"/>
        <argument
            android:name="rulesType"
            android:defaultValue="BASIC_RATIO"
            app:argType="com.stockbit.model.type.ScreenerRulesType"/>
        <argument
            android:name="screenerRules"
            android:defaultValue="@null"
            app:argType="com.stockbit.screener.args.ScreenerRuleArgs"
            app:nullable="true"/>
        <action
            android:id="@+id/action_addRulesFragment_to_screenerFinancialMetricFragment"
            app:destination="@+id/screenerFinancialMetricHomeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:label="preset_home"
        android:name="com.stockbit.screener.ui.financialmetric.ScreenerFinancialMetricFragment"
        android:id="@+id/screenerFinancialMetricHomeFragment">
        <argument
            android:name="originDestinationId"
            android:defaultValue="0"
            app:argType="integer"/>
        <argument
            android:name="isBasicRatio"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="requestKey"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="screenerFinancialMetricItemParcel"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.screener.ScreenerFinancialMetric"
            app:nullable="true"/>
        <argument
            android:name="screenerFinancialMetricChildLevel"
            android:defaultValue="0"
            app:argType="integer"/>
    </fragment>
    <fragment
        android:label="preset_child_lv_1"
        android:name="com.stockbit.screener.ui.financialmetric.ScreenerFinancialMetricFragment"
        android:id="@+id/screenerFinancialMetricChildFragment">
        <action
            android:id="@+id/action_screenerFinancialMetricChildFragment_to_screenerFinancialMetricThirdChildFragment"
            app:destination="@+id/screenerFinancialMetricThirdChildFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <argument
            android:name="originDestinationId"
            android:defaultValue="0"
            app:argType="integer"/>
        <argument
            android:name="isBasicRatio"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="requestKey"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="screenerFinancialMetricItemParcel"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.screener.ScreenerFinancialMetric"
            app:nullable="true"/>
        <argument
            android:name="screenerFinancialMetricChildLevel"
            android:defaultValue="0"
            app:argType="integer"/>
    </fragment>
    <fragment
        android:label="preset_child_lv_2"
        android:name="com.stockbit.screener.ui.financialmetric.ScreenerFinancialMetricFragment"
        android:id="@+id/screenerFinancialMetricThirdChildFragment">
        <argument
            android:name="originDestinationId"
            android:defaultValue="0"
            app:argType="integer"/>
        <argument
            android:name="isBasicRatio"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="requestKey"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="screenerFinancialMetricItemParcel"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.screener.ScreenerFinancialMetric"
            app:nullable="true"/>
        <argument
            android:name="screenerFinancialMetricChildLevel"
            android:defaultValue="0"
            app:argType="integer"/>
    </fragment>
    <action
        android:id="@+id/openSecondLevel"
        app:destination="@+id/screenerFinancialMetricChildFragment"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right"/>
    <action
        android:id="@+id/openThirdLevel"
        app:destination="@+id/screenerFinancialMetricThirdChildFragment"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right"/>
</navigation>
