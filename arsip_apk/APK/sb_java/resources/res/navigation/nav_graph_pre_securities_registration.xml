<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_pre_securities_registration"
    app:startDestination="@+id/registrationPreparationPhoneFragment">
    <fragment
        android:label="RegistrationPreparationCreatePasswordFragment"
        android:name="com.stockbit.trading.ui.openingaccount.preparation.password.create.RegistrationPreparationCreatePasswordFragment"
        android:id="@+id/registrationPreparationCreatePasswordFragment">
        <action
            android:id="@+id/action_registrationPreparationCreatePasswordFragment_to_registrationPreparationConfirmPasswordFragment"
            app:destination="@+id/registrationPreparationConfirmPasswordFragment">
            <argument
                android:name="newPassword"
                app:argType="string"
                app:nullable="false"/>
        </action>
    </fragment>
    <fragment
        android:label="RegistrationPreparationConfirmPasswordFragment"
        android:name="com.stockbit.trading.ui.openingaccount.preparation.password.confirm.RegistrationPreparationConfirmPasswordFragment"
        android:id="@+id/registrationPreparationConfirmPasswordFragment">
        <argument
            android:name="newPassword"
            app:argType="string"
            app:nullable="false"/>
        <action
            android:id="@+id/action_registrationPreparationConfirmPasswordFragment_to_registrationPreparationPhoneFragment"
            app:destination="@+id/registrationPreparationPhoneFragment"/>
    </fragment>
    <fragment
        android:label="RegistrationPreparationPhoneFragment"
        android:name="com.stockbit.trading.ui.openingaccount.preparation.phone.RegistrationPreparationPhoneFragment"
        android:id="@+id/registrationPreparationPhoneFragment">
        <action
            android:id="@+id/action_registrationPreparationPhoneFragment_to_registrationPreparationEmailFragment"
            app:destination="@+id/registrationPreparationEmailFragment"/>
    </fragment>
    <fragment
        android:label="RegistrationPreparationEmailFragment"
        android:name="com.stockbit.trading.ui.openingaccount.preparation.email.RegistrationPreparationEmailFragment"
        android:id="@+id/registrationPreparationEmailFragment"/>
</navigation>
