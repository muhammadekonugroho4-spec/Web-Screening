<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_forgot_password_non_login"
    app:startDestination="@+id/forgotPasswordInputEmailFragment">
    <fragment
        android:label="forgotPasswordInputEmail"
        android:name="com.stockbit.onboarding.ui.forgotpassword.inputemail.ForgotPasswordInputEmailFragment"
        android:id="@+id/forgotPasswordInputEmailFragment">
        <action
            android:id="@+id/action_forgotPasswordInputEmailFragment_toForgotPasswordOTPFragment"
            app:destination="@+id/forgotPasswordOTPFragment">
            <argument
                android:name="email"
                app:argType="string"
                app:nullable="false"/>
        </action>
    </fragment>
    <fragment
        android:label="forgotPasswordOTP"
        android:name="com.stockbit.onboarding.ui.forgotpassword.otp.ForgotPasswordOTPFragment"
        android:id="@+id/forgotPasswordOTPFragment">
        <argument
            android:name="email"
            app:argType="string"
            app:nullable="false"/>
        <action
            android:id="@+id/action_forgotPasswordOTPFragment_to_forgotPasswordNewInputFragment"
            app:destination="@+id/forgotPasswordNewInputFragment">
            <argument
                android:name="token"
                app:argType="string"
                app:nullable="false"/>
        </action>
    </fragment>
    <fragment
        android:label="forgotPasswordNewInput"
        android:name="com.stockbit.onboarding.ui.forgotpassword.newpassword.ForgotPasswordNewInputFragment"
        android:id="@+id/forgotPasswordNewInputFragment">
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
        <action
            android:id="@+id/action_forgotPasswordNewInputFragment_to_forgotPasswordConfirmInputFragment"
            app:destination="@+id/forgotPasswordConfirmInputFragment">
            <argument
                android:name="token"
                app:argType="string"
                app:nullable="false"/>
        </action>
    </fragment>
    <fragment
        android:label="forgotPasswordConfirmInput"
        android:name="com.stockbit.onboarding.ui.forgotpassword.confirmpassword.ForgotPasswordConfirmInputFragment"
        android:id="@+id/forgotPasswordConfirmInputFragment">
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
    </fragment>
</navigation>
