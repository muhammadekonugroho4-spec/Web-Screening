<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_e_ipo"
    app:startDestination="@+id/eIpoCompanyFragment">
    <fragment
        android:name="com.stockbit.eipo.ui.company.EIpoCompanyFragment"
        android:id="@+id/eIpoCompanyFragment">
        <argument
            android:name="emitenCode"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="performUnBoxing"
            android:defaultValue="false"
            app:argType="boolean"/>
        <action
            android:id="@+id/action_eIpoCompanyFragment_to_eIpoDetailComposeFragment"
            app:destination="@+id/eIpoDetailComposeFragment"/>
        <action
            android:id="@+id/action_eIpoCompanyFragment_to_eIpoDetailCompanyFragment"
            app:destination="@+id/eIpoDetailCompanyFragment"/>
        <action
            android:id="@+id/action_eIpoCompanyFragment_to_eIpoDetailDialogFragment"
            app:destination="@+id/eIpoDetailDialogFragment"/>
        <action
            android:id="@+id/action_eIpoCompanyFragment_to_eIpoUnboxingFragment"
            app:destination="@+id/eIpoUnboxingFragment"/>
        <action
            android:id="@+id/action_eIpoCompanyFragment_to_underwriterDetailComposeFragment"
            app:destination="@+id/underwriterDetailComposeFragment"/>
    </fragment>
    <fragment
        android:name="com.stockbit.eipo.ui.deeplink.EIpoDeeplinkRouterFragment"
        android:id="@+id/eIpoDeeplinkRouterFragment">
        <argument
            android:name="companyCode"
            app:argType="string"/>
        <argument
            android:name="eipoType"
            app:argType="string"/>
        <argument
            android:name="performUnboxing"
            android:defaultValue="false"
            app:argType="boolean"/>
        <action
            android:id="@+id/action_eIpoDeeplinkRouterFragment_to_eIpoDetailComposeFragment"
            app:destination="@+id/eIpoDetailComposeFragment"
            app:popUpTo="@+id/eIpoDeeplinkRouterFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_eIpoDeeplinkRouterFragment_to_eIpoDetailCompanyFragment"
            app:destination="@+id/eIpoDetailCompanyFragment"
            app:popUpTo="@+id/eIpoDeeplinkRouterFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:name="com.stockbit.eipo.ui.company.EIpoDetailCompanyFragment"
        android:id="@+id/eIpoDetailCompanyFragment">
        <action
            android:id="@+id/action_eIpoDetailCompanyFragment_to_eIpoUnboxingFragment"
            app:destination="@+id/eIpoUnboxingFragment"/>
        <argument
            android:name="urlEIpoCompany"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="emitenCode"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="performUnBoxing"
            android:defaultValue="false"
            app:argType="boolean"
            app:nullable="false"/>
    </fragment>
    <fragment
        android:name="com.stockbit.eipo.ui.compose.detail.EIpoDetailComposeFragment"
        android:id="@+id/eIpoDetailComposeFragment">
        <argument
            android:name="companyCode"
            app:argType="string"/>
        <argument
            android:name="eipoType"
            app:argType="string"/>
        <argument
            android:name="performUnboxing"
            android:defaultValue="false"
            app:argType="boolean"/>
        <action
            android:id="@+id/action_eIpoDetailComposeFragment_to_underwriterDetailComposeFragment"
            app:destination="@+id/underwriterDetailComposeFragment"/>
    </fragment>
    <dialog
        android:name="com.stockbit.eipo.ui.detail.EipoDetailDialogFragment"
        android:id="@+id/eIpoDetailDialogFragment">
        <argument
            android:name="companyCode"
            app:argType="string"
            app:nullable="false"/>
        <action
            android:id="@+id/action_eIpoDetailDialogFragment_to_eIpoDetailCompanyFragment"
            app:destination="@+id/eIpoDetailCompanyFragment"/>
        <action
            android:id="@+id/action_eIpoDetailDialogFragment_to_eIpoUnboxingFragment"
            app:destination="@+id/eIpoUnboxingFragment"/>
    </dialog>
    <fragment
        android:name="com.stockbit.eipo.ui.unboxing.EipoUnboxingFragment"
        android:id="@+id/eIpoUnboxingFragment">
        <argument
            android:name="urlUnboxingEIpo"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:name="com.stockbit.eipo.ui.compose.underwriter.UnderwriterDetailComposeFragment"
        android:id="@+id/underwriterDetailComposeFragment">
        <argument
            android:name="underwriters"
            android:defaultValue="@null"
            app:argType="com.stockbit.eipo.ui.compose.underwriter.model.UnderwriterChipItemUiState[]"
            app:nullable="true"/>
        <argument
            android:name="selectedUnderwriterCode"
            app:argType="string"/>
        <argument
            android:name="underwriter"
            android:defaultValue="@null"
            app:argType="com.stockbit.eipo.ui.company.UnderwriterListItemLayoutUIState"
            app:nullable="true"/>
        <action
            android:id="@+id/action_underwriterDetailComposeFragment_to_underwriterIpoInfoComposeFragment"
            app:destination="@+id/underwriterIpoInfoComposeFragment"/>
    </fragment>
    <fragment
        android:name="com.stockbit.eipo.ui.compose.info.UnderwriterIpoInfoComposeFragment"
        android:id="@+id/underwriterIpoInfoComposeFragment"/>
</navigation>
