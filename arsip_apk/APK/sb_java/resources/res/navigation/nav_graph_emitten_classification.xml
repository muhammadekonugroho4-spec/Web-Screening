<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_emitten_classification"
    app:startDestination="@+id/emittenClassificationFragment">
    <fragment
        android:label="EmittenClassificationFragment"
        android:name="com.stockbit.emittenclassification.ui.EmittenClassificationFragment"
        android:id="@+id/emittenClassificationFragment">
        <argument
            android:name="id"
            app:argType="integer"/>
        <argument
            android:name="title"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="catalogSymbol"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="sourcePage"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true"/>
    </fragment>
</navigation>
