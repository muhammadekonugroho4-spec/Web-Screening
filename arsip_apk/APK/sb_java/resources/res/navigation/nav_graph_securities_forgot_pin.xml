<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_securities_forgot_pin"
    app:startDestination="@+id/securitiesKtpConfirmationFragment">
    <include app:graph="@navigation/nav_graph_verify_email"/>
    <include app:graph="@navigation/nav_graph_user_auth_sms_otp"/>
    <fragment
        android:name="com.stockbit.trading.ui.verification.ktp.SecuritiesKtpConfirmationFragment"
        android:id="@+id/securitiesKtpConfirmationFragment">
        <argument
            android:name="validateKtpConfirmationType"
            app:argType="com.stockbit.domain.model.type.KtpConfirmationType"
            app:nullable="false"/>
        <argument
            android:name="changeToken"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="extraFrom"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <action
            android:id="@+id/openValidateOtp"
            app:destination="@+id/nav_graph_user_auth_sms_otp"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="smsOtpType"
                app:argType="com.stockbit.domain.model.type.otp.SmsOTPType"
                app:nullable="false"/>
        </action>
        <action
            android:id="@+id/openSendEmailAddAccount"
            app:destination="@+id/nav_graph_verify_email"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="EXTRA_EMAIL_VERIFICATION"
                android:defaultValue="@null"
                app:argType="com.stockbit.domain.model.entity.EmailVerificationArg"
                app:nullable="true"/>
        </action>
    </fragment>
    <fragment
        android:name="com.stockbit.trading.ui.verification.otp.SecuritiesOtpConfirmationFragment"
        android:id="@+id/securitiesOtpConfirmationFragment">
        <argument
            android:name="EXTRA_RESET_IDENTITY_NUMBER"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_RESET_PIN_TOKEN"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_RESET_PIN_PHONE"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="extraFrom"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <action
            android:id="@+id/openValidateEmail"
            app:destination="@+id/nav_graph_verify_email"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@+id/nav_graph_verify_email"
            app:popUpToInclusive="true">
            <argument
                android:name="EXTRA_EMAIL_VERIFICATION"
                android:defaultValue="@null"
                app:argType="com.stockbit.domain.model.entity.EmailVerificationArg"
                app:nullable="true"/>
        </action>
    </fragment>
</navigation>
