<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_forgot_phone"
    app:startDestination="@+id/inputLostPhoneNumberFragment">
    <fragment
        android:name="com.stockbit.personalamend.ui.forgotphone.inputphone.verifycurrent.InputLostPhoneNumberFragment"
        android:id="@+id/inputLostPhoneNumberFragment">
        <argument
            android:name="token"
            app:argType="string"/>
        <argument
            android:name="maskedCurrentPhoneNumber"
            app:argType="string"/>
        <action
            android:id="@+id/action_to_cancelForgotPhoneConfirmationDialog"
            app:destination="@+id/cancelForgotPhoneConfirmationDialog"/>
    </fragment>
    <fragment
        android:name="com.stockbit.personalamend.ui.forgotphone.confirmpin.ForgotPhoneConfirmPinFragment"
        android:id="@+id/forgotPhoneConfirmPinFragment">
        <argument
            android:name="token"
            app:argType="string"/>
        <action
            android:id="@+id/action_to_cancelForgotPhoneConfirmationDialog"
            app:destination="@+id/cancelForgotPhoneConfirmationDialog"/>
    </fragment>
    <fragment
        android:name="com.stockbit.personalamend.ui.forgotphone.facematching.ForgotPhoneValidateFaceMatchingFragment"
        android:id="@+id/forgotPhoneValidateFaceMatchingFragment">
        <argument
            android:name="refId"
            app:argType="string"/>
        <action
            android:id="@+id/action_to_cancelForgotPhoneConfirmationDialog"
            app:destination="@+id/cancelForgotPhoneConfirmationDialog"/>
    </fragment>
    <fragment
        android:name="com.stockbit.personalamend.ui.forgotphone.inputphone.submitnew.InputNewPhoneNumberFragment"
        android:id="@+id/inputNewPhoneNumberFragment">
        <argument
            android:name="token"
            app:argType="string"/>
        <action
            android:id="@+id/action_to_cancelForgotPhoneConfirmationDialog"
            app:destination="@+id/cancelForgotPhoneConfirmationDialog"/>
    </fragment>
    <fragment
        android:name="com.stockbit.personalamend.ui.forgotphone.success.SuccessSubmitForgotPhoneFragment"
        android:id="@+id/successSubmitForgotPhoneFragment"/>
    <fragment
        android:name="com.stockbit.personalamend.ui.forgotphone.otp.ForgotPhoneNewPhoneOtpFragment"
        android:id="@+id/forgotPhoneNewPhoneOtpFragment">
        <argument
            android:name="showLostPhoneButton"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="token"
            app:argType="string"/>
        <argument
            android:name="availableChannel"
            app:argType="com.stockbit.personalamend.model.OTPChannelValueNavParam[]"/>
        <argument
            android:name="defaultChannel"
            app:argType="com.stockbit.features.model.OTPChannelValue"/>
        <action
            android:id="@+id/action_to_cancelForgotPhoneConfirmationDialog"
            app:destination="@+id/cancelForgotPhoneConfirmationDialog"/>
    </fragment>
    <dialog
        android:name="com.stockbit.personalamend.ui.changedata.cancelconfirmation.CancelChangeDataConfirmationDialog"
        android:id="@+id/cancelForgotPhoneConfirmationDialog"/>
</navigation>
