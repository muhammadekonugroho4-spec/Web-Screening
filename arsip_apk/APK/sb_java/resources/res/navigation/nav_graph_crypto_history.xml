<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_crypto_history"
    app:startDestination="@+id/cryptoHistoryDetailFragment">
    <fragment
        android:label="CryptoHistoryDetailFragment"
        android:name="com.stockbit.feature.cryptohistory.ui.detail.CryptoHistoryDetailFragment"
        android:id="@+id/cryptoHistoryDetailFragment">
        <argument
            android:name="txnType"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="transactionId"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="coinSymbol"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="coinName"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="coinLogo"
            android:defaultValue=""
            app:argType="string"/>
    </fragment>
    <fragment
        android:label="CryptoHistoryRealizedDetailFragment"
        android:name="com.stockbit.feature.cryptohistory.ui.realizeddetail.CryptoHistoryRealizedDetailFragment"
        android:id="@+id/cryptoHistoryRealizedDetailFragment">
        <argument
            android:name="orderId"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="baseAsset"
            android:defaultValue=""
            app:argType="string"/>
    </fragment>
</navigation>
