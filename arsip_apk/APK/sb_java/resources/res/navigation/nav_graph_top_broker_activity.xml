<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_top_broker_activity"
    app:startDestination="@+id/fragment_top_broker_activity">
    <fragment
        android:name="com.stockbit.brokeractivity.ui.topbroker.TopBrokerFragment"
        android:id="@+id/fragment_top_broker_activity">
        <action
            android:id="@+id/action_fragment_top_broker_activity_to_brokerActivityListComposeFragment"
            app:destination="@+id/brokerActivityListComposeFragment">
            <argument
                android:name="brokerCode"
                android:defaultValue=""
                app:argType="string"/>
        </action>
        <argument
            android:name="isFromDeeplink"
            android:defaultValue="false"
            app:argType="boolean"/>
    </fragment>
    <fragment
        android:label="BrokerActivityChartComposeFragment"
        android:name="com.stockbit.brokeractivity.ui.compose.ui.chart.BrokerActivityChartComposeFragment"
        android:id="@+id/brokerActivityChartComposeFragment">
        <argument
            android:name="brokerCode"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="startDate"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="endDate"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="marketType"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="investorType"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="isDateChangedFromDatePicker"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="periodType"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:label="BrokerActivityChartComposeFragment"
        android:name="com.stockbit.brokeractivity.ui.compose.ui.list.BrokerActivityListComposeFragment"
        android:id="@+id/brokerActivityListComposeFragment">
        <argument
            android:name="brokerCode"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="brokerTitle"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="brokerType"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="isFromDeeplink"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="startDate"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="endDate"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="marketType"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="investorType"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="isDateChangedFromDatePicker"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="periodType"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:name="com.stockbit.brokeractivity.ui.compose.ui.selectstock.SelectStockComposeFragment"
        android:id="@+id/selectStockComposeFragment">
        <argument
            android:name="selectedStocks"
            android:defaultValue="@null"
            app:argType="string[]"
            app:nullable="true"/>
    </fragment>
</navigation>
