<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_alert"
    app:startDestination="@+id/mainListFragment">
    <fragment
        android:name="com.stockbit.alert.ui.mainlist.MainListFragment"
        android:id="@+id/mainListFragment">
        <argument
            android:name="requestKey"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="isFromDeeplink"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="companyName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="stock"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <action
            android:id="@+id/action_mainListFragment_to_alertDetailComposeFragment"
            app:destination="@+id/alertDetailComposeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_mainListFragment_to_alertDetailFragment"
            app:destination="@+id/alertDetailFragment">
            <argument
                android:name="alertDetailMode"
                android:defaultValue="DETAIL"
                app:argType="com.stockbit.alert.contract.model.AlertDetailModeNavParam"/>
            <argument
                android:name="alertId"
                android:defaultValue=""
                app:argType="string"/>
            <argument
                android:name="stock"
                android:defaultValue="&apos;&apos;"
                app:argType="string"/>
            <argument
                android:name="isFromActiveAlert"
                android:defaultValue="false"
                app:argType="boolean"/>
        </action>
        <action
            android:id="@+id/action_mainListFragment_to_companySearchFragment"
            app:destination="@+id/companySearchFragment"/>
        <action
            android:id="@+id/action_mainListFragment_to_mainListFragment"
            app:destination="@+id/mainListFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.stockbit.alert.ui.companysearch.CompanySearchFragment"
        android:id="@+id/companySearchFragment">
        <action
            android:id="@+id/action_companySearchFragment_to_alertDetailFragment"
            app:destination="@+id/alertDetailFragment">
            <argument
                android:name="stock"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true"/>
            <argument
                android:name="alertId"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true"/>
            <argument
                android:name="alertDetailMode"
                android:defaultValue="SET"
                app:argType="com.stockbit.alert.contract.model.AlertDetailModeNavParam"/>
            <argument
                android:name="isFromActiveAlert"
                android:defaultValue="false"
                app:argType="boolean"/>
        </action>
        <action
            android:id="@+id/action_companySearchFragment_to_alertDetailComposeFragment"
            app:destination="@+id/alertDetailComposeFragment"/>
    </fragment>
    <fragment
        android:name="com.stockbit.alert.ui.alerttype.AlertTypeFragment"
        android:id="@+id/alertTypeFragment">
        <argument
            android:name="initData"
            app:argType="com.stockbit.alert.ui.detail.bottomsheet.AlertTypeInitializationData"/>
        <argument
            android:name="selectedOption"
            app:argType="com.stockbit.domain.model.alert.AlertConditionItemType"/>
    </fragment>
    <fragment
        android:name="com.stockbit.alert.ui.detail.AlertDetailComposeFragment"
        android:id="@+id/alertDetailComposeFragment">
        <argument
            android:name="alert_id"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="mode"
            android:defaultValue="Create"
            app:argType="com.stockbit.alert.contract.model.AlertV2DetailModeNavParam"/>
        <argument
            android:name="company_symbol"
            app:argType="string"/>
        <argument
            android:name="company_name"
            app:argType="string"/>
        <argument
            android:name="company_icon_url"
            app:argType="string"/>
        <argument
            android:name="is_from_alert_page"
            android:defaultValue="true"
            app:argType="boolean"/>
        <action
            android:id="@+id/action_alertDetailFragment_to_alertTypeFragment"
            app:destination="@+id/alertTypeFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:name="com.stockbit.alert.ui.detail.AlertDetailFragment"
        android:id="@+id/alertDetailFragment">
        <argument
            android:name="requestKey"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="alertDetailMode"
            app:argType="com.stockbit.alert.contract.model.AlertDetailModeNavParam"/>
        <argument
            android:name="alertId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="stock"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="isFromActiveAlert"
            android:defaultValue="false"
            app:argType="boolean"/>
        <action
            android:id="@+id/openMainListBack"
            app:destination="@+id/mainListFragment"
            app:launchSingleTop="true"
            app:popUpTo="@+id/nav_graph_alert"
            app:popUpToInclusive="false"/>
        <action
            android:id="@+id/action_alertDetailFragment_to_mainListFragment"
            app:destination="@+id/mainListFragment">
            <argument
                android:name="stock"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true"/>
        </action>
        <action
            android:id="@+id/action_alertDetailFragment_to_paywallPriceAlertDialogFragment"
            app:destination="@+id/paywallPriceAlertDialogFragment"/>
    </fragment>
    <dialog
        android:name="com.stockbit.alert.ui.paywall.PaywallPriceAlertDialogFragment"
        android:id="@+id/paywallPriceAlertDialogFragment">
        <argument
            android:name="subscriptionDesc"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="subscriptionValue"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="product_id"
            app:argType="integer"/>
        <argument
            android:name="company_id"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="is_new_user"
            android:defaultValue="false"
            app:argType="boolean"/>
    </dialog>
</navigation>
