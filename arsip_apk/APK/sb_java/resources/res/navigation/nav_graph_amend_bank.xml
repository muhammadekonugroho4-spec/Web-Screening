<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_amend_bank"
    app:startDestination="@+id/amendBankListFragment">
    <fragment
        android:name="com.stockbit.amendbank.ui.bankaccount.AmendBankListFragment"
        android:id="@+id/amendBankListFragment">
        <action
            android:id="@+id/action_amendBankListFragment_to_amendBankDialog"
            app:destination="@+id/amendBankDialog"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_amendBankListFragment_to_amendBankBasicDialog"
            app:destination="@+id/amendBankBasicDialog"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <argument
            android:name="currentEmail"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="changeToken"
            app:argType="string"/>
        <action
            android:id="@+id/action_amendBankListFragment_to_livenessLimitedDialog"
            app:destination="@+id/livenessLimitedDialog"/>
    </fragment>
    <fragment
        android:name="com.stockbit.amendbank.ui.facematching.AmendBankFaceMatchingSuccessFragment"
        android:id="@+id/amendBankFaceMatchingSuccessFragment"/>
    <dialog
        android:name="com.stockbit.amendbank.ui.dialog.AmendBankDialogFragment"
        android:id="@+id/amendBankDialog">
        <argument
            android:name="maxAccount"
            android:defaultValue="3"
            app:argType="integer"/>
        <argument
            android:name="isReachMaxNumber"
            android:defaultValue="true"
            app:argType="boolean"/>
    </dialog>
    <dialog
        android:name="com.stockbit.amendbank.ui.dialog.AmendBankBasicDialogFragment"
        android:id="@+id/amendBankBasicDialog">
        <argument
            android:name="bankState"
            app:argType="com.stockbit.domain.model.type.amendbank.BankState"/>
        <argument
            android:name="maxAccount"
            android:defaultValue="3"
            app:argType="integer"/>
    </dialog>
    <dialog
        android:name="com.stockbit.liveness.livenessprep.LivenessLimitDialog"
        android:id="@+id/livenessLimitedDialog"/>
</navigation>
