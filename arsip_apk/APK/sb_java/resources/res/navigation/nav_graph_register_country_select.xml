<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_register_country_select"
    app:startDestination="@+id/fragmentValidateCountry">
    <include app:graph="@navigation/nav_graph_fingerprint_trade"/>
    <include app:graph="@navigation/nav_graph_register_oa"/>
    <include app:graph="@navigation/nav_graph_discover_friend_register"/>
    <fragment
        android:label="registerValidateCountry"
        android:name="com.stockbit.onboarding.ui.register.RegisterCountryFragment"
        android:id="@+id/fragmentValidateCountry">
        <action
            android:id="@+id/openTradingOpeningAccount"
            app:destination="@+id/nav_graph_register_oa"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/openFingerprintMainPage"
            app:destination="@+id/nav_graph_fingertprint_trade"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="isRegister"
                android:defaultValue="false"
                app:argType="boolean"/>
        </action>
        <action
            android:id="@+id/openDiscoverFriend"
            app:destination="@+id/graph_friend_discover_register"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right">
            <argument
                android:name="tradingRegisterComplete"
                android:defaultValue="false"
                app:argType="boolean"/>
        </action>
    </fragment>
</navigation>
