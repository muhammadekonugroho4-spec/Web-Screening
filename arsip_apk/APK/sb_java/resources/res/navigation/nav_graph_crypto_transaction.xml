<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_crypto_transaction"
    app:startDestination="@+id/cryptoBuyFragment">
    <fragment
        android:label="CryptoBuyFragment"
        android:name="com.stockbit.feature.cryptotransaction.ui.buy.CryptoBuyFragment"
        android:id="@+id/cryptoBuyFragment">
        <argument
            android:name="coinSymbol"
            app:argType="string"/>
    </fragment>
    <fragment
        android:label="CryptoSellFragment"
        android:name="com.stockbit.feature.cryptotransaction.ui.sell.CryptoSellFragment"
        android:id="@+id/cryptoSellFragment">
        <argument
            android:name="coinSymbol"
            app:argType="string"/>
    </fragment>
    <fragment
        android:label="CryptoAmendBuyFragment"
        android:name="com.stockbit.feature.cryptotransaction.ui.amend.buy.CryptoAmendBuyFragment"
        android:id="@+id/cryptoAmendBuyFragment">
        <argument
            android:name="orderId"
            app:argType="string"/>
        <argument
            android:name="coinSymbol"
            app:argType="string"/>
    </fragment>
    <fragment
        android:label="CryptoAmendSellFragment"
        android:name="com.stockbit.feature.cryptotransaction.ui.amend.sell.CryptoAmendSellFragment"
        android:id="@+id/cryptoAmendSellFragment">
        <argument
            android:name="orderId"
            app:argType="string"/>
        <argument
            android:name="coinSymbol"
            app:argType="string"/>
    </fragment>
    <fragment
        android:label="CryptoAmendBuyConfirmationFragment"
        android:name="com.stockbit.feature.cryptotransaction.ui.amend.buy.confirmation.CryptoAmendBuyConfirmationFragment"
        android:id="@+id/cryptoAmendBuyConfirmationFragment"/>
    <fragment
        android:label="CryptoAmendSellConfirmationFragment"
        android:name="com.stockbit.feature.cryptotransaction.ui.amend.sell.confirmation.CryptoAmendSellConfirmationFragment"
        android:id="@+id/cryptoAmendSellConfirmationFragment"/>
</navigation>
