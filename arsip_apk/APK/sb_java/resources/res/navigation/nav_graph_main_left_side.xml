<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_main_left_side"
    app:startDestination="@+id/nav_graph_main_watchlist">
    <include app:graph="@navigation/nav_graph_main_watchlist"/>
    <include app:graph="@navigation/nav_graph_main_search"/>
    <include app:graph="@navigation/nav_graph_main_stream"/>
    <include app:graph="@navigation/nav_graph_main_chat"/>
    <include app:graph="@navigation/nav_graph_main_trading"/>
    <include app:graph="@navigation/nav_graph_setting_main"/>
    <include app:graph="@navigation/nav_graph_notification"/>
    <include app:graph="@navigation/nav_graph_e_ipo"/>
    <include app:graph="@navigation/nav_graph_e_ipo_onboarding"/>
    <include app:graph="@navigation/nav_graph_stream_create_post"/>
    <include app:graph="@navigation/nav_graph_stream_liker"/>
    <include app:graph="@navigation/nav_graph_securities_pin_login"/>
    <include app:graph="@navigation/nav_graph_screener"/>
    <include app:graph="@navigation/nav_graph_user_auth_sms_otp"/>
    <include app:graph="@navigation/nav_graph_validate_otp_email"/>
    <include app:graph="@navigation/nav_graph_verify_email"/>
    <include app:graph="@navigation/nav_graph_modular_container"/>
    <action
        android:id="@+id/action_open_another_module"
        app:destination="@+id/nav_graph_modular_container">
        <argument
            android:name="graph_id"
            app:argType="integer"/>
        <argument
            android:name="destination_id"
            android:defaultValue="-1"
            app:argType="integer"/>
        <argument
            android:name="start_destination_args"
            android:defaultValue="@null"
            app:argType="android.os.Bundle"
            app:nullable="true"/>
    </action>
</navigation>
