<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_trading_virtual"
    app:startDestination="@+id/tradingLandingVirtualFragment">
    <fragment
        android:name="com.stockbit.virtual.ui.detailportfolio.VirtualDetailPortfolioFragment"
        android:id="@+id/virtualDetailPortfolioFragment">
        <argument
            android:name="EXTRA_PARCEL_PORTFOLIO_DETAIL"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.virtual.TradingPortfolioResult"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:name="com.stockbit.virtual.ui.detailorderlist.VirtualDetailOrderlistFragment"
        android:id="@+id/virtualDetailOrderlistFragment">
        <argument
            android:name="EXTRA_PARCEL_ORDERLIST_DETAIL"
            android:defaultValue="@null"
            app:argType="com.stockbit.domain.model.entity.virtual.TradingOrderList"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_PARCEL_ORDERLIST_PAGE_STATUS"
            app:argType="string"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:name="com.stockbit.virtual.ui.buy.VirtualBuyFragment"
        android:id="@+id/virtualBuyFragment">
        <argument
            android:name="EXTRA_SYMBOL"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_BUY_PATH"
            app:argType="string"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:name="com.stockbit.virtual.ui.sell.VirtualSellFragment"
        android:id="@+id/virtualSellFragment">
        <argument
            android:name="EXTRA_SYMBOL"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_PRICE"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_SELL_PATH"
            app:argType="string"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:name="com.stockbit.virtual.ui.amend.buy.VirtualAmendBuyFragment"
        android:id="@+id/virtualAmendBuyFragment">
        <argument
            android:name="EXTRA_SYMBOL"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_LAST_PRICE"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_ORDER_ID"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_LOT"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_RESULT_LOT"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_TOTAL_AMOUNT"
            app:argType="string"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:name="com.stockbit.virtual.ui.amend.sell.VirtualAmendSellFragment"
        android:id="@+id/virtualAmendSellFragment">
        <argument
            android:name="EXTRA_SYMBOL"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_LAST_PRICE"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_ORDER_ID"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_LOT"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="EXTRA_RESULT_SUM_LOT"
            app:argType="string"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:name="com.stockbit.virtual.ui.landing.TradingLandingVirtualFragment"
        android:id="@+id/tradingLandingVirtualFragment"/>
</navigation>
