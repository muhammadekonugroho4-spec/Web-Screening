<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_social_subscription"
    app:startDestination="@+id/openAccessFragment">
    <include app:graph="@navigation/nav_graph_securities_registration"/>
    <fragment
        android:name="com.stockbit.socialsubscription.ui.openaccess.OpenAccessFragment"
        android:id="@+id/openAccessFragment">
        <argument
            android:name="is_new_user"
            android:defaultValue="false"
            app:argType="boolean"/>
        <action
            android:id="@+id/action_openAccessFragment_to_openSubscriptionShopFragment"
            app:destination="@+id/openSubscriptionShopFragment"/>
        <action
            android:id="@+id/action_openAccessFragment_to_stockbitProShopFragment"
            app:destination="@+id/stockbitProShopFragment">
            <argument
                android:name="is_new_user"
                android:defaultValue="false"
                app:argType="boolean"/>
            <argument
                android:name="is_google_payment_available"
                android:defaultValue="true"
                app:argType="boolean"/>
        </action>
        <action
            android:id="@+id/action_openAccessFragment_to_openSubscriptionHistory"
            app:destination="@+id/subscriptionHistoryFragment"/>
        <action
            android:id="@+id/action_openAccessFragment_to_stockbitProOnProgressFragment"
            app:destination="@+id/stockbitProOnProgressFragment"/>
    </fragment>
    <fragment
        android:name="com.stockbit.socialsubscription.ui.opensubscriptionexternal.OpenSubscriptionShopFragment"
        android:id="@+id/openSubscriptionShopFragment"/>
    <fragment
        android:name="com.stockbit.socialsubscription.ui.stockbitpro.StockbitProShopFragment"
        android:id="@+id/stockbitProShopFragment">
        <argument
            android:name="is_new_user"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="product_enum"
            android:defaultValue=""
            app:argType="string"/>
        <argument
            android:name="is_from_stockbit_pro_profile"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="is_google_payment_available"
            android:defaultValue="true"
            app:argType="boolean"/>
        <action
            android:id="@+id/action_stockbitProShopFragment_to_subscriptionHistoryFragment"
            app:destination="@+id/subscriptionHistoryFragment"/>
        <action
            android:id="@+id/action_stockbitProShopFragment_to_subscriptionHistoryFragment_inclusive"
            app:destination="@+id/subscriptionHistoryFragment"
            app:popUpTo="@+id/stockbitProShopFragment"
            app:popUpToInclusive="true"/>
    </fragment>
    <fragment
        android:name="com.stockbit.socialsubscription.ui.onprogress.StockbitProOnProgressFragment"
        android:id="@+id/stockbitProOnProgressFragment"/>
    <fragment
        android:name="com.stockbit.socialsubscription.ui.history.SubscriptionHistoryFragment"
        android:id="@+id/subscriptionHistoryFragment">
        <action
            android:id="@+id/action_subscriptionHistoryFragment_to_subscriptionHistoryDetailFragment"
            app:destination="@+id/subscriptionHistoryDetailFragment">
            <argument
                android:name="EXTRA_PARCEL_HISTORY_SUBSCRIPTION_DETAIL"
                android:defaultValue="@null"
                app:argType="com.stockbit.usecase.social.subscription.model.SocialSubscriptionHistoryOrderItemUIState"
                app:nullable="true"/>
        </action>
    </fragment>
    <fragment
        android:name="com.stockbit.socialsubscription.ui.historydetail.SubscriptionHistoryDetailFragment"
        android:id="@+id/subscriptionHistoryDetailFragment">
        <argument
            android:name="EXTRA_PARCEL_HISTORY_SUBSCRIPTION_DETAIL"
            android:defaultValue="@null"
            app:argType="com.stockbit.usecase.social.subscription.model.SocialSubscriptionHistoryOrderItemUIState"
            app:nullable="true"/>
    </fragment>
</navigation>
