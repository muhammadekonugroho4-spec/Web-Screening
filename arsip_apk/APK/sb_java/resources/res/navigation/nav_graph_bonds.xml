<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_bonds"
    app:startDestination="@+id/bondDetailComposeFragment">
    <fragment
        android:label="BondsBuyComposeFragment"
        android:name="com.stockbit.feature.bonds.ui.buy.BondBuyComposeFragment"
        android:id="@+id/bondsBuyComposeFragment">
        <argument
            android:name="productId"
            app:argType="string"/>
        <argument
            android:name="sourcePage"
            app:argType="string"/>
        <argument
            android:name="yield"
            app:argType="string"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:label="BondDetailComposeFragment"
        android:name="com.stockbit.feature.bonds.ui.detail.BondDetailComposeFragment"
        android:id="@+id/bondDetailComposeFragment">
        <argument
            android:name="productId"
            app:argType="string"/>
        <argument
            android:name="shouldBuy"
            android:defaultValue="false"
            app:argType="boolean"/>
        <action
            android:id="@+id/action_bondDetailComposeFragment_to_bondsSellComposeFragment"
            app:destination="@+id/bondsSellComposeFragment">
            <argument
                android:name="productId"
                app:argType="string"/>
            <argument
                android:name="productName"
                app:argType="string"/>
            <argument
                android:name="acquisitionOrderId"
                app:argType="string"/>
            <argument
                android:name="sourcePage"
                app:argType="string"/>
        </action>
    </fragment>
    <fragment
        android:label="BondOrderDetailComposeFragment"
        android:name="com.stockbit.feature.bonds.orderdetail.BondOrderDetailComposeFragment"
        android:id="@+id/bondOrderDetailComposeFragment">
        <argument
            android:name="orderId"
            app:argType="string"/>
    </fragment>
    <fragment
        android:label="BondDiscoveryFragment"
        android:name="com.stockbit.feature.bonds.ui.discovery.BondDiscoveryFragment"
        android:id="@+id/bondDiscoveryFragment">
        <action
            android:id="@+id/action_bondDiscoveryFragment_to_bondDetailComposeFragment"
            app:destination="@+id/bondDetailComposeFragment"/>
    </fragment>
    <fragment
        android:label="BondCatalogComposeFragment"
        android:name="com.stockbit.feature.bonds.ui.catalog.BondCatalogComposeFragment"
        android:id="@+id/bondCatalogComposeFragment">
        <argument
            android:name="sectorId"
            app:argType="string"/>
        <action
            android:id="@+id/action_bondCatalogComposeFragment_to_bondDetailComposeFragment"
            app:destination="@+id/bondDetailComposeFragment"/>
    </fragment>
    <fragment
        android:label="BondHistoryDetailComposeFragment"
        android:name="com.stockbit.feature.bonds.ui.history.BondHistoryDetailComposeFragment"
        android:id="@+id/bondHistoryDetailComposeFragment">
        <argument
            android:name="param"
            app:argType="com.stockbit.feature.bonds.contract.model.BondHistoryDetailParam"
            app:nullable="true"/>
        <argument
            android:name="realizedParam"
            app:argType="com.stockbit.feature.bonds.contract.model.BondHistoryDetailRealizedParam"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:label="BondsSellComposeFragment"
        android:name="com.stockbit.feature.bonds.ui.sell.BondsSellComposeFragment"
        android:id="@+id/bondsSellComposeFragment">
        <argument
            android:name="productId"
            app:argType="string"/>
        <argument
            android:name="productName"
            app:argType="string"/>
        <argument
            android:name="acquisitionOrderId"
            app:argType="string"/>
        <argument
            android:name="sourcePage"
            app:argType="string"/>
        <argument
            android:name="yield"
            app:argType="string"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:label="BondsPortfolioDetailComposeFragment"
        android:name="com.stockbit.feature.bonds.ui.portfolio.BondsPortfolioDetailComposeFragment"
        android:id="@+id/bondsPortfolioDetailComposeFragment">
        <argument
            android:name="symbol"
            app:argType="string"/>
        <argument
            android:name="yield"
            app:argType="string"
            app:nullable="true"/>
        <action
            android:id="@+id/action_bondsPortfolioDetailComposeFragment_to_bondsSellComposeFragment"
            app:destination="@+id/bondsSellComposeFragment"/>
        <action
            android:id="@+id/action_bondsPortfolioDetailComposeFragment_to_bondsBuyComposeFragment"
            app:destination="@+id/bondsBuyComposeFragment"/>
        <action
            android:id="@+id/action_bondsPortfolioDetailComposeFragment_to_bondDetailComposeFragment"
            app:destination="@+id/bondDetailComposeFragment"/>
    </fragment>
</navigation>
