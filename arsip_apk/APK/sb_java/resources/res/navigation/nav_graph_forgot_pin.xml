<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_forgot_pin"
    app:startDestination="@+id/startBlankFragment">
    <fragment
        android:label="StartBlankFragment"
        android:name="com.stockbit.personalamend.ui.forgotpin.starter.StartBlankFragment"
        android:id="@+id/startBlankFragment">
        <argument
            android:name="destinationId"
            app:argType="integer"/>
        <argument
            android:name="destinationArguments"
            app:argType="android.os.Bundle"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:label="ForgotPinIdentityFragment"
        android:name="com.stockbit.personalamend.ui.forgotpin.identity.ForgotPinIdentityFragment"
        android:id="@+id/forgotPinIdentityFragment">
        <argument
            android:name="loginState"
            app:argType="com.stockbit.usecase.forgotpin.resource.ForgotPinLoginState"/>
        <argument
            android:name="token"
            app:argType="string"/>
    </fragment>
    <fragment
        android:name="com.stockbit.personalamend.ui.forgotpin.otp.ForgotPinOtpFragment"
        android:id="@+id/forgotPinOtpFragment">
        <argument
            android:name="showLostPhoneButton"
            android:defaultValue="false"
            app:argType="boolean"/>
        <argument
            android:name="loginState"
            app:argType="com.stockbit.usecase.forgotpin.resource.ForgotPinLoginState"/>
        <argument
            android:name="token"
            app:argType="string"/>
        <argument
            android:name="availableChannel"
            app:argType="com.stockbit.personalamend.model.OTPChannelValueNavParam[]"/>
        <argument
            android:name="defaultChannel"
            app:argType="com.stockbit.features.model.OTPChannelValue"/>
    </fragment>
    <fragment
        android:label="ForgotPinFaceMatchingFragment"
        android:name="com.stockbit.personalamend.ui.forgotpin.facematching.ForgotPinFaceMatchingFragment"
        android:id="@+id/forgotPinFaceMatchingFragment">
        <argument
            android:name="loginState"
            app:argType="com.stockbit.usecase.forgotpin.resource.ForgotPinLoginState"/>
        <argument
            android:name="token"
            app:argType="string"/>
    </fragment>
    <fragment
        android:name="com.stockbit.personalamend.ui.forgotpin.pin.change.ForgotPinCreateNewFragment"
        android:id="@+id/forgotPinCreateNewFragment">
        <argument
            android:name="loginState"
            app:argType="com.stockbit.usecase.forgotpin.resource.ForgotPinLoginState"/>
        <argument
            android:name="token"
            app:argType="string"/>
    </fragment>
    <fragment
        android:name="com.stockbit.personalamend.ui.forgotpin.pin.confirm.ForgotPinConfirmFragment"
        android:id="@+id/forgotPinConfirmFragment">
        <argument
            android:name="loginState"
            app:argType="com.stockbit.usecase.forgotpin.resource.ForgotPinLoginState"/>
        <argument
            android:name="token"
            app:argType="string"/>
    </fragment>
</navigation>
