<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_change_trusted_device"
    app:startDestination="@+id/changeConfirmationFragment">
    <fragment
        android:label="ChangeConfirmationFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.change.confirmation.ChangeConfirmationFragment"
        android:id="@+id/changeConfirmationFragment">
        <action
            android:id="@+id/action_changeConfirmationFragment_to_changeErrorNoSecuritiesFragment"
            app:destination="@+id/changeErrorNoSecuritiesFragment"/>
        <action
            android:id="@+id/action_changeConfirmationFragment_to_changeErrorRegisteredFragment"
            app:destination="@+id/changeErrorRegisteredFragment"/>
    </fragment>
    <fragment
        android:label="ChangeWaitingApprovalFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.change.waitingapproval.ChangeWaitingApprovalFragment"
        android:id="@+id/changeWaitingApprovalFragment">
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
        <action
            android:id="@+id/action_changeWaitingApprovalFragment_to_changeVerifyIdentityFragment"
            app:destination="@+id/changeVerifyIdentityFragment">
            <argument
                android:name="token"
                app:argType="string"
                app:nullable="false"/>
        </action>
    </fragment>
    <fragment
        android:label="ChangeVerifyPasswordFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.change.verifypassword.ChangeVerifyPasswordFragment"
        android:id="@+id/changeVerifyPasswordFragment">
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
    </fragment>
    <fragment
        android:label="ChangeVerifyPINFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.change.verifypin.ChangeVerifyPINFragment"
        android:id="@+id/changeVerifyPINFragment">
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
    </fragment>
    <fragment
        android:label="ChangeVerifyOTPFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.change.verifyotp.ChangeVerifyOTPFragment"
        android:id="@+id/changeVerifyOTPFragment">
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="email"
            app:argType="string"
            app:nullable="false"/>
        <argument
            android:name="phone"
            app:argType="string"
            app:nullable="true"/>
    </fragment>
    <fragment
        android:label="ChangeErrorNoSecuritiesFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.change.errornosecurities.ChangeErrorNoSecuritiesFragment"
        android:id="@+id/changeErrorNoSecuritiesFragment"/>
    <fragment
        android:label="ChangeErrorRegisteredFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.change.erroralreadyregistered.ChangeErrorRegisteredFragment"
        android:id="@+id/changeErrorRegisteredFragment"/>
    <fragment
        android:label="ChangeCompletionFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.change.completion.ChangeCompletionFragment"
        android:id="@+id/changeCompletionFragment">
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
        <action
            android:id="@+id/action_changeCompletionFragment_to_changeSuccessFragment"
            app:destination="@+id/changeSuccessFragment"/>
    </fragment>
    <fragment
        android:label="ChangeSuccessFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.change.success.ChangeSuccessFragment"
        android:id="@+id/changeSuccessFragment"/>
    <fragment
        android:label="ChangeVerifyIdentityFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.change.verifyidentity.ChangeVerifyIdentityFragment"
        android:id="@+id/changeVerifyIdentityFragment">
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
    </fragment>
    <fragment
        android:label="ChangeVerifyFaceFragment"
        android:name="com.stockbit.feature.trusteddevice.ui.change.verifyface.ChangeVerifyFaceFragment"
        android:id="@+id/changeVerifyFaceFragment">
        <argument
            android:name="token"
            app:argType="string"
            app:nullable="false"/>
    </fragment>
</navigation>
