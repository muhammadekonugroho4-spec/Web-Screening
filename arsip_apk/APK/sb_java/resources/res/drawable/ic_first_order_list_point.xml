<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <inset
            android:insetRight="-10dp"
            android:insetTop="-10dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/themeColorSurfaceDefault"/>
                <stroke
                    android:width="1dp"
                    android:color="?attr/themeColorModalsBorder"/>
                <corners android:radius="@dimen/item_gap_4"/>
            </shape>
        </inset>
    </item>
    <item android:gravity="left">
        <rotate android:fromDegrees="180">
            <shape android:shape="rectangle">
                <solid android:color="?attr/themeColorModalsBorder"/>
                <size android:width="1dp"/>
            </shape>
        </rotate>
    </item>
</layer-list>
