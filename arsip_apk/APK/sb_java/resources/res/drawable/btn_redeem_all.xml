<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/background_green_active"/>
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="@color/green_text"/>
            <corners android:radius="@dimen/shape_radius_124"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_gray_drop_shadow_color_4"/>
            <corners android:radius="@dimen/shape_radius_124"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent"/>
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="@color/green_text"/>
            <corners android:radius="@dimen/shape_radius_124"/>
        </shape>
    </item>
</selector>
