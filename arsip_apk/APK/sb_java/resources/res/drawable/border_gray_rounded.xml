<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gray_text"/>
            <stroke
                android:width="1dp"
                android:color="@color/gray_text"/>
            <corners android:radius="@dimen/shape_radius_m"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gray_text"/>
            <stroke
                android:width="1dp"
                android:color="@color/gray_text"/>
            <corners android:radius="@dimen/shape_radius_m"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/themeSeparatorGapColor"/>
            <stroke
                android:width="1dp"
                android:color="?attr/themeContentTextColorSecondary"/>
            <corners android:radius="@dimen/shape_radius_m"/>
        </shape>
    </item>
</selector>
