<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:gravity="center"
        android:id="@android:id/background">
        <shape
            android:tint="?attr/themeColorGreenMedium"
            android:shape="rectangle">
            <corners android:radius="@dimen/radius_4"/>
            <solid android:color="?attr/themeColorGreenMedium"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape
                android:tint="?attr/themeColorGreenDefault"
                android:shape="rectangle">
                <corners android:radius="@dimen/radius_4"/>
                <solid android:color="?attr/themeColorGreenDefault"/>
            </shape>
        </scale>
    </item>
</layer-list>
