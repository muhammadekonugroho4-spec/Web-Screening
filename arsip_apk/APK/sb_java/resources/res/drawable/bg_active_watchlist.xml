<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="?attr/themeColorModalsBackground"/>
        </shape>
    </item>
    <item
        android:left="20dp"
        android:right="20dp">
        <shape>
            <stroke
                android:width="1dp"
                android:color="?attr/themeColorBorderGreen"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
</layer-list>
