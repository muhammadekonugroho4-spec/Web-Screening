<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/downgray_light">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="?attr/titleTextColorDowngray"/>
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="@color/highgray_light"/>
            <corners android:radius="@dimen/shape_radius_m"/>
        </shape>
    </item>
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent"/>
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="?attr/themeColorBorder"/>
            <corners android:radius="@dimen/shape_radius_m"/>
        </shape>
    </item>
</ripple>
