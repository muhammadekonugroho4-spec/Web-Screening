<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size
                android:height="20dp"
                android:width="20dp"/>
            <padding
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp"/>
            <solid android:color="#f1f2f4"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <size
                android:height="10dp"
                android:width="10dp"/>
            <padding
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp"/>
            <stroke
                android:width="3dp"
                android:color="#ffc41c"/>
        </shape>
    </item>
</layer-list>
