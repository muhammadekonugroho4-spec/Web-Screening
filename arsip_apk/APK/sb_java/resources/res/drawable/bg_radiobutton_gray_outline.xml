<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_window_focused="false"
        android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/background_green_active"/>
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="@color/green_text"/>
            <corners android:radius="@dimen/shape_radius_m"/>
        </shape>
    </item>
    <item
        android:state_window_focused="false"
        android:state_checked="false">
        <shape android:shape="rectangle">
            <solid android:color="?attr/themeContentBackground"/>
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="?attr/themeSeparatorGapColor"/>
            <corners android:radius="@dimen/shape_radius_m"/>
        </shape>
    </item>
    <item
        android:state_checked="true"
        android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/background_green_active"/>
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="@color/green_text"/>
            <corners android:radius="@dimen/shape_radius_m"/>
        </shape>
    </item>
    <item
        android:state_checked="false"
        android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/background_green_active"/>
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="@color/green_text"/>
            <corners android:radius="@dimen/shape_radius_m"/>
        </shape>
    </item>
    <item
        android:state_focused="true"
        android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/background_green_active"/>
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="@color/green_text"/>
            <corners android:radius="@dimen/shape_radius_m"/>
        </shape>
    </item>
    <item
        android:state_focused="true"
        android:state_checked="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/background_green_active"/>
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="@color/green_text"/>
            <corners android:radius="@dimen/shape_radius_m"/>
        </shape>
    </item>
    <item android:state_checked="false">
        <shape android:shape="rectangle">
            <solid android:color="?attr/themeSeparatorGapColor"/>
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="?attr/themeLineSeparatorColor"/>
            <corners android:radius="@dimen/shape_radius_m"/>
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/background_green_active"/>
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="@color/green_text"/>
            <corners android:radius="@dimen/shape_radius_m"/>
        </shape>
    </item>
</selector>
