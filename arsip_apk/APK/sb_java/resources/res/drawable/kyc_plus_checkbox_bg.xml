<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_pressed="true"
        android:id="@+id/pressed"
        android:drawable="@drawable/kyc_plus_checkbox_pressed_state"/>
    <item
        android:state_checked="true"
        android:id="@+id/checked"
        android:drawable="@drawable/kyc_plus_checkbox_active"/>
    <item
        android:id="@+id/unchecked"
        android:drawable="@drawable/kyc_plus_checkbox_inactive"/>
    <transition
        android:drawable="@drawable/kyc_plus_checkbox_avd_check"
        android:toId="@+id/checked"
        android:fromId="@+id/pressed"/>
</animated-selector>
