<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="true"
        android:state_checked="true"
        android:drawable="@drawable/uikit_ic_radio_tick_light_checked"/>
    <item
        android:state_enabled="false"
        android:state_checked="true"
        android:drawable="@drawable/uikit_ic_radio_tick_light_checked_disabled"/>
    <item
        android:state_enabled="true"
        android:state_checked="false"
        android:drawable="@drawable/uikit_ic_radio_tick_light_unchecked"/>
    <item
        android:state_enabled="false"
        android:state_checked="false"
        android:drawable="@drawable/uikit_ic_radio_tick_light_unchecked_disabled"/>
    <item android:drawable="@drawable/uikit_ic_radio_tick_light_unchecked"/>
</selector>
