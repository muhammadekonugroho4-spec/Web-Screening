<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="true"
        android:state_checked="true"
        android:drawable="@drawable/uikit_ic_checkbox_box_enabled_checked_light"/>
    <item
        android:state_enabled="true"
        android:state_checked="false"
        android:drawable="@drawable/uikit_ic_checkbox_box_enabled_unchecked_light"/>
    <item
        android:state_enabled="false"
        android:state_checked="true"
        android:drawable="@drawable/uikit_ic_checkbox_box_disabled_checked_light"/>
    <item
        android:state_enabled="false"
        android:state_checked="false"
        android:drawable="@drawable/uikit_ic_checkbox_box_disabled_unchecked_light"/>
    <item android:drawable="@drawable/uikit_ic_checkbox_box_enabled_unchecked_light"/>
</selector>
