<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:height="@dimen/uikit_input_pin_indicator_size"
        android:width="@dimen/uikit_input_pin_indicator_size">
        <shape android:shape="oval">
            <solid android:color="?attr/colorPinIndicatorFilledActiveOuter"/>
        </shape>
    </item>
    <item
        android:gravity="center"
        android:height="@dimen/uikit_input_pin_indicator_filled_inner_size"
        android:width="@dimen/uikit_input_pin_indicator_filled_inner_size">
        <shape android:shape="oval">
            <solid android:color="?attr/themeColorFeatureGreen"/>
        </shape>
    </item>
</layer-list>
