<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_enabled="false"
        android:state_selected="false">
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="?attr/themeSeparatorGapColor"/>
            <corners android:radius="@dimen/clickable_size_24"/>
            <solid android:color="@color/transparent"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="@color/background_green_active"/>
            <corners android:radius="@dimen/clickable_size_24"/>
            <solid android:color="@color/background_green_active"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="@color/background_green_active"/>
            <corners android:radius="@dimen/clickable_size_24"/>
            <solid android:color="@color/background_green_active"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="?attr/themeAccent"/>
            <corners android:radius="@dimen/clickable_size_24"/>
            <solid android:color="?attr/themeContentBackground"/>
        </shape>
    </item>
</selector>
