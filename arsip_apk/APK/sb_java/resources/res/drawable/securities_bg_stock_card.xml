<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/themeColorSurfaceVariant"/>
            <stroke
                android:width="1dp"
                android:color="?attr/themeColorBorder"/>
            <corners android:radius="@dimen/radius_4"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/themeColorSurfaceVariant"/>
            <stroke
                android:width="1dp"
                android:color="?attr/themeColorBorder"/>
            <corners android:radius="@dimen/radius_4"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/themeColorSurfaceDefault"/>
            <stroke
                android:width="1dp"
                android:color="?attr/themeColorBorder"/>
            <corners android:radius="@dimen/radius_4"/>
        </shape>
    </item>
</selector>
