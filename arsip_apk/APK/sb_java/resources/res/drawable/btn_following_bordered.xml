<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/themeButtonBorderFollowing"/>
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="@color/green_text"/>
            <corners android:radius="@dimen/shape_radius_m"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="?attr/themeChatBalloonColor"/>
            <corners android:radius="@dimen/shape_radius_m"/>
        </shape>
    </item>
</selector>
