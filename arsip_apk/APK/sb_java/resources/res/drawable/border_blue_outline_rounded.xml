<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/background_blue_2_pressed">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/shape_radius_m"/>
            <solid android:color="@color/background_blue_2_pressed"/>
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="@color/background_blue_medium"/>
        </shape>
    </item>
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/shape_radius_m"/>
            <stroke
                android:width="@dimen/item_gap_xxxs"
                android:color="@color/background_blue_medium"/>
        </shape>
    </item>
</ripple>
