<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_red_warning_background_light"/>
            <stroke
                android:width="1dp"
                android:color="?attr/themeBorderRed"/>
            <corners android:radius="@dimen/shape_radius_m"/>
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/themeBorderRed"/>
            <stroke
                android:width="1dp"
                android:color="?attr/themeBorderRed"/>
            <corners android:radius="@dimen/shape_radius_m"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_red_warning_background_light"/>
            <stroke
                android:width="1dp"
                android:color="?attr/themeBorderRed"/>
            <corners android:radius="@dimen/shape_radius_m"/>
        </shape>
    </item>
</selector>
