<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/radio_selector">
    <item
        android:state_pressed="true"
        android:id="@+id/pressed"
        android:drawable="@drawable/kyc_plus_radiobutton_pressed_state"/>
    <item
        android:state_checked="true"
        android:id="@+id/selected"
        android:drawable="@drawable/kyc_plus_radiobutton_active"/>
    <item
        android:id="@+id/unselected"
        android:drawable="@drawable/kyc_plus_radiobutton_inactive"/>
    <transition
        android:drawable="@drawable/kyc_plus_radiobutton_avd_bg"
        android:toId="@+id/selected"
        android:fromId="@+id/pressed"/>
</animated-selector>
