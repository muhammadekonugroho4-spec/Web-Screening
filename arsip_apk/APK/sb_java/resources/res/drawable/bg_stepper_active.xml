<?xml version="1.0" encoding="utf-8"?>
<layer-list>
    <item>
        <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
            <solid android:color="@android:color/transparent"/>
            <padding
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp"/>
            <size
                android:height="20dp"
                android:width="20dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/themeColorSemanticActive"/>
            <size
                android:height="20dp"
                android:width="20dp"/>
        </shape>
    </item>
</layer-list>
