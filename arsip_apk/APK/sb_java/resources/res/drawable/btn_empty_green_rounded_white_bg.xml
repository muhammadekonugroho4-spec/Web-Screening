<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/background_green_active"/>
            <stroke
                android:width="1dp"
                android:color="?attr/themeContentTextColorOnPrimary"/>
            <corners android:radius="@dimen/shape_radius_124"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/themeContentBackground"/>
            <stroke
                android:width="1dp"
                android:color="@color/green_text"/>
            <corners android:radius="@dimen/shape_radius_124"/>
        </shape>
    </item>
</selector>
