<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_checked="true"
        android:color="?attr/themeTextColorOnAnimatedPrice">
        <shape android:shape="rectangle">
            <solid android:color="?attr/themeAccent"/>
            <stroke
                android:width="1dp"
                android:color="?attr/themeAccent"/>
            <corners
                android:topRightRadius="10dp"
                android:bottomRightRadius="10dp"/>
        </shape>
    </item>
    <item android:color="?attr/themeAccent">
        <inset android:insetLeft="-2dp">
            <shape android:shape="rectangle">
                <solid android:color="?attr/themeContentBackground"/>
                <stroke
                    android:width="1dp"
                    android:color="?attr/themeAccent"/>
                <corners
                    android:topRightRadius="10dp"
                    android:bottomRightRadius="10dp"/>
            </shape>
        </inset>
    </item>
</selector>
