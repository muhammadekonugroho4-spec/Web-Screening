<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme"
    android:gravity="bottom"
    android:tag="layout/fragment_change_bank_dialog_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/vgStockbitSettingUbahRekeningDialogHeader"
        android:background="@drawable/bg_top_rounded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/ivStockbitSettingUbahRekeningDialog"
            android:background="@drawable/bg_rounded_gray"
            android:layout_width="@dimen/width_s"
            android:layout_height="@dimen/item_gap_s"
            android:layout_centerInParent="true"
            android:layout_marginStart="@dimen/item_gap_l"
            android:layout_marginEnd="@dimen/item_gap_l"
            android:backgroundTint="?attr/themeColorModalsBorder"
            android:layout_marginVertical="@dimen/spacing_12"/>
    </RelativeLayout>
    <ScrollView
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/vgStockbitSettingUbahRekeningDialogHeader">
        <LinearLayout
            android:orientation="vertical"
            android:background="?attr/themeDialogBackgroundColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ViewFlipper
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:measureAllChildren="false">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/item_gap_20"
                    android:paddingEnd="@dimen/item_gap_20">
                    <TextView
                        android:id="@+id/title_bank"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/title_tnc_add_bank"
                        android:textAlignment="gravity"
                        android:layout_marginVertical="@dimen/spacing_8"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TopBar.Title"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12">
                        <ImageView
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/iv_stockbit_setting_ubah_rekening_icon_first"
                            android:layout_width="@dimen/spacing_48"
                            android:layout_height="@dimen/spacing_48"
                            android:src="?attr/themeIconAmendBankWorkingDays"/>
                        <TextView
                            android:gravity="start|center_vertical"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/tv_stockbit_setting_ubah_rekening_first"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="gravity"
                            android:layout_marginStart="@dimen/height_16"
                            style="@style/TypeStyles.BodyRegular"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16">
                        <ImageView
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/iv_stockbit_setting_ubah_rekening_icon_second"
                            android:layout_width="@dimen/spacing_48"
                            android:layout_height="@dimen/spacing_48"
                            android:src="?attr/themeIconAmendBankImmutable"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/iv_stockbit_setting_ubah_rekening_icon_first"/>
                        <TextView
                            android:gravity="start|center_vertical"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/tv_stockbit_setting_ubah_rekening_second"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="gravity"
                            android:layout_marginStart="@dimen/height_16"
                            style="@style/TypeStyles.BodyRegular"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16">
                        <ImageView
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/iv_stockbit_setting_ubah_rekening_icon_third"
                            android:layout_width="@dimen/spacing_48"
                            android:layout_height="@dimen/spacing_48"
                            android:src="?attr/themeIconAmendBankActiveBank"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/iv_stockbit_setting_ubah_rekening_icon_second"/>
                        <TextView
                            android:gravity="start|center_vertical"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/tv_stockbit_setting_ubah_rekening_third"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="gravity"
                            android:layout_marginStart="@dimen/height_16"
                            style="@style/TypeStyles.BodyRegular"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16">
                        <ImageView
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/iv_stockbit_setting_ubah_rekening_icon_fourth"
                            android:layout_width="@dimen/spacing_48"
                            android:layout_height="@dimen/spacing_48"
                            android:src="?attr/themeIconAmendBankVerifiedBankHolder"/>
                        <TextView
                            android:gravity="start|center_vertical"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/tv_stockbit_setting_ubah_rekening_fourth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="gravity"
                            android:layout_marginStart="@dimen/height_16"
                            style="@style/TypeStyles.BodyRegular"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16">
                        <ImageView
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/iv_stockbit_setting_ubah_rekening_icon_fifth"
                            android:layout_width="@dimen/spacing_48"
                            android:layout_height="@dimen/spacing_48"
                            android:src="?attr/themeIconAmendBankMaximumBank"/>
                        <TextView
                            android:gravity="start|center_vertical"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/tv_stockbit_setting_ubah_rekening_fifth"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="gravity"
                            android:layout_marginStart="@dimen/height_16"
                            style="@style/TypeStyles.BodyRegular"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16">
                        <ImageView
                            android:layout_gravity="center_horizontal"
                            android:id="@+id/iv_stockbit_setting_ubah_rekening_icon_last"
                            android:layout_width="@dimen/spacing_48"
                            android:layout_height="@dimen/spacing_48"
                            android:src="?attr/themeIconAmendBankAutoRecipient"/>
                        <TextView
                            android:gravity="start|center_vertical"
                            android:layout_gravity="center_vertical"
                            android:id="@+id/tv_stockbit_setting_ubah_rekening_last"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAlignment="gravity"
                            android:layout_marginStart="@dimen/height_16"
                            style="@style/TypeStyles.BodyRegular"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:background="?attr/themeDialogBackgroundColor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:paddingVertical="@dimen/item_gap_20"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/iv_stockbit_setting_ubah_rekening_icon_last">
                        <com.stockbit.uikit.button.SecondaryNeutralButton
                            android:id="@+id/btn_cancel_setting_ubah_rekening"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:text="@string/button_cancel"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/spacing_6"
                            app:secondaryNeutralButtonColor="green"/>
                        <com.stockbit.uikit.button.PrimaryButton
                            android:id="@+id/btn_ammend_setting_ubah_rekening"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:text="@string/button_next"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/spacing_6"/>
                    </LinearLayout>
                </LinearLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/text_size_18"
                        android:id="@+id/tv_title_switch_bank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_8"
                        android:layout_marginBottom="@dimen/item_gap_16"
                        android:text="@string/title_change_bank_disbursement"
                        app:layout_constraintBottom_toTopOf="@+id/tv_desc_switch_bank"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/SbTextView.BodyDefault.Bold"/>
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:gravity="center"
                        android:id="@+id/tv_desc_switch_bank"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/item_gap_24"
                        android:text="@string/text_change_bank_disbursement"
                        android:layout_marginStart="@dimen/item_gap_21"
                        android:layout_marginEnd="@dimen/item_gap_21"
                        app:layout_constraintBottom_toTopOf="@+id/ll_switch_bank"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        style="@style/SbTextView.BodyDefault"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_switch_bank"
                        android:background="?attr/themeDialogBackgroundColor"
                        android:padding="@dimen/item_gap_20"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent">
                        <Button
                            android:textSize="@dimen/text_size_16"
                            android:id="@+id/btn_cancel_switch_bank"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/height_44"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:text="@string/button_cancel"
                            android:layout_weight="1"
                            android:textAllCaps="false"
                            android:layout_marginEnd="@dimen/item_gap_s"
                            style="@style/SbTextView.BodyDefault.Green.Bold"/>
                        <Button
                            android:textSize="@dimen/text_size_16"
                            android:textColor="@color/white"
                            android:id="@+id/btn_switch_default_bank"
                            android:background="@drawable/border_green_rounded"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/height_44"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:text="@string/button_next"
                            android:layout_weight="1"
                            android:textAllCaps="false"
                            android:layout_marginStart="@dimen/item_gap_s"
                            style="@style/SbTextView.BodyDefault.Green.Bold"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </ViewFlipper>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
