<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_item_trending"
    android:tag="layout/row_discover_trending_0"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/symbolCompany"
        android:layout_width="@dimen/spacing_48"
        android:layout_height="@dimen/spacing_48"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/spacing_20"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/parentRowDiscoverSuggestedUserInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/item_gap_m"
        android:layout_marginEnd="@dimen/spacing_16"
        android:layout_toStartOf="@+id/vf_follow_unfollow"
        android:layout_toEndOf="@+id/symbolCompany">
        <TextView
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_fullname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:drawablePadding="@dimen/spacing_6"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tv_follower_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2"
            android:maxLines="1"
            style="@style/TypeStyles.BodyXSmall.Secondary"/>
    </LinearLayout>
    <ViewFlipper
        android:id="@+id/vf_follow_unfollow"
        android:layout_width="@dimen/width_80"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/spacing_20"
        android:layout_alignParentEnd="true">
        <com.stockbit.uikit.button.SecondaryNeutralButton
            android:id="@+id/btnRowDiscoverSuggestedFollowed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/following"
            app:secondaryNeutralButtonColor="neutral"
            app:secondaryNeutralButtonSize="smallSize"/>
        <com.stockbit.uikit.button.PrimaryButton
            android:id="@+id/btnRowDiscoverSuggestedFollow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_follow"
            app:primaryButtonSize="smallSize"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress_follow_status"
            android:focusable="false"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:indeterminate="true"
            android:indeterminateTint="@color/green_text"/>
    </ViewFlipper>
    <View
        android:id="@+id/border"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_below="@+id/parentRowDiscoverSuggestedUserInfo"
        android:layout_marginHorizontal="@dimen/spacing_20"/>
</RelativeLayout>
