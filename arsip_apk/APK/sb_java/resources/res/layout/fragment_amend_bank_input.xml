<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_amend_bank_input_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/settingActivityToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:layout_scrollFlags="enterAlways|scroll">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_add_bank_acc"
            style="@style/SbTextView.BodyDefault.Bold"/>
    </androidx.appcompat.widget.Toolbar>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_0"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@+id/lbNextLiveness"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="@dimen/spacing_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputLayout
                    android:textColorHint="?attr/themeContentTextColorSecondary"
                    android:id="@+id/tilAccountNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_20"
                    android:layout_marginBottom="@dimen/item_gap_28"
                    android:hint="@string/title_add_acc_number"
                    android:layout_marginStart="@dimen/item_gap_20"
                    android:layout_marginEnd="@dimen/item_gap_20"
                    app:expandedHintEnabled="false"
                    app:hintTextColor="@color/green_text">
                    <com.google.android.material.textfield.TextInputEditText
                        android:theme="@style/SbPrimaryEditText"
                        android:textSize="@dimen/text_size_14"
                        android:textColor="?attr/themeContentTextColor"
                        android:id="@+id/etAccountNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/placeholder_add_acc_number"
                        android:maxLines="1"
                        android:inputType="number"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:textColorHint="?attr/themeContentTextColorSecondary"
                    android:id="@+id/tilBankName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/item_gap_28"
                    android:hint="@string/title_add_bank_name"
                    android:layout_marginStart="@dimen/item_gap_20"
                    android:layout_marginEnd="@dimen/item_gap_20"
                    app:boxStrokeColor="@color/gray_text"
                    app:endIconDrawable="@drawable/ic_dropdown"
                    app:endIconMode="custom"
                    app:endIconTint="@color/green_text"
                    app:expandedHintEnabled="false"
                    app:helperTextEnabled="true"
                    app:hintTextColor="@color/green_text">
                    <com.google.android.material.textfield.TextInputEditText
                        android:theme="@style/SbPrimaryEditText"
                        android:textSize="@dimen/text_size_14"
                        android:textColor="?attr/themeContentTextColor"
                        android:id="@+id/etABankName"
                        android:tag="binding_1"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:clickable="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/placeholder_add_bank_name"
                        android:cursorVisible="false"
                        android:maxLines="1"
                        android:inputType="text"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:textColorHint="?attr/themeContentTextColorSecondary"
                    android:id="@+id/tilOwnerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/title_add_acc_owner"
                    android:layout_marginStart="@dimen/item_gap_20"
                    android:layout_marginEnd="@dimen/item_gap_20"
                    app:boxStrokeColor="@color/gray_text"
                    app:expandedHintEnabled="false"
                    app:helperTextEnabled="true"
                    app:hintTextColor="@color/green_text">
                    <com.google.android.material.textfield.TextInputEditText
                        android:theme="@style/SbPrimaryEditText"
                        android:textSize="@dimen/text_size_14"
                        android:textColor="?attr/themeContentTextColor"
                        android:id="@+id/etAOwnerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/placeholder_add_acc_owner"
                        android:maxLines="1"
                        android:inputType="text"/>
                </com.google.android.material.textfield.TextInputLayout>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="@color/highgray_light"
                    android:id="@+id/tvHelperOwnerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_8"
                    android:text="@string/text_add_bank_instruction_foreign"
                    android:layout_marginStart="@dimen/item_gap_24"
                    android:layout_marginEnd="@dimen/item_gap_20"/>
            </LinearLayout>
        </ScrollView>
        <com.stockbit.common.uikit.StockbitLoadingButton
            android:id="@+id/lbNextLiveness"
            android:tag="binding_2"
            android:background="@drawable/bg_selector_btn_green"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_48"
            android:layout_alignParentBottom="true"
            app:buttonText="@string/button_next"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
