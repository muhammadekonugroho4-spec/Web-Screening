<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/comp_stream_header_company_notes_empty_state_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_note_empty_state"
        android:importantForAccessibility="no"
        app:tint="?attr/themeColorBorderGreen"/>
    <Button
        android:textColor="@color/light_type_textwhite"
        android:id="@+id/btn_add_note"
        android:background="@drawable/bg_button_add_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:text="@string/stream_company_note_empty_state_button"
        android:paddingHorizontal="@dimen/spacing_36"
        android:paddingVertical="@dimen/spacing_14"
        app:primaryButtonSize="mediumSize"
        style="@style/TypeStyles.HeadingRegular"/>
</LinearLayout>
