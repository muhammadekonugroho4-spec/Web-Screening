<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_text_field_line_layout"
    android:tag="layout/comp_input_text_field_line_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_text_field_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingXSmall"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_text_field_input_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_text_field_label"
        app:layout_goneMarginTop="@dimen/spacing_0">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/tiet_text_field_input"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_16"
            app:layout_constraintEnd_toStartOf="@+id/bar_text_field"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Sb.Widget.TextInputEditText"/>
        <androidx.constraintlayout.widget.Barrier
            android:orientation="vertical"
            android:id="@+id/bar_text_field"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="start"
            app:constraint_referenced_ids="tv_text_field_counter, iv_text_field_replaceable_icon"/>
        <TextView
            android:textColor="?attr/themeColorTextTetriary"
            android:id="@+id/tv_text_field_counter"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_text_field_delete_all_icon"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toEndOf="@+id/tiet_text_field_input"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.BodyRegular"/>
        <ImageView
            android:id="@+id/iv_text_field_delete_all_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/uikit_ic_stockbit_search_bar_close_fill"
            android:layout_marginEnd="@dimen/spacing_12"
            app:layout_constraintBottom_toBottomOf="@+id/tiet_text_field_input"
            app:layout_constraintEnd_toStartOf="@+id/iv_text_field_replaceable_icon"
            app:layout_constraintStart_toEndOf="@+id/tv_text_field_counter"
            app:layout_constraintTop_toTopOf="@+id/tiet_text_field_input"
            app:layout_goneMarginEnd="@dimen/spacing_0"/>
        <ImageView
            android:id="@+id/iv_text_field_replaceable_icon"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tiet_text_field_input"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/v_text_field_bottom_line"
        android:background="?attr/themeColorBorder"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/spacing_8"
        app:layout_constraintEnd_toEndOf="@+id/cl_text_field_input_layout"
        app:layout_constraintStart_toStartOf="@+id/cl_text_field_input_layout"
        app:layout_constraintTop_toBottomOf="@+id/cl_text_field_input_layout"/>
    <ImageView
        android:id="@+id/iv_text_field_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_input_error"
        app:layout_constraintBottom_toBottomOf="@+id/tv_text_field_helper"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_text_field_helper"
        app:layout_goneMarginTop="@dimen/spacing_16"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:id="@+id/tv_text_field_helper"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="@dimen/spacing_8"
        app:layout_constraintEnd_toStartOf="@+id/tv_text_field_button"
        app:layout_constraintStart_toEndOf="@+id/iv_text_field_error"
        app:layout_constraintTop_toBottomOf="@+id/cl_text_field_input_layout"
        app:layout_goneMarginEnd="@dimen/spacing_0"
        app:layout_goneMarginStart="@dimen/spacing_0"
        style="@style/TypeStyles.BodyXSmall"/>
    <TextView
        android:textColor="?attr/themeColorTextGreen"
        android:id="@+id/tv_text_field_button"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_text_field_bottom_line"
        style="@style/TypeStyles.HeadingSmall"/>
    <TextView
        android:id="@+id/tv_text_field_caption"
        android:background="@drawable/bg_input_text_field_caption"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:paddingHorizontal="@dimen/spacing_12"
        android:paddingVertical="@dimen/spacing_8"
        app:layout_constraintTop_toBottomOf="@+id/tv_text_field_helper"
        app:layout_goneMarginTop="@dimen/spacing_16"
        style="@style/TypeStyles.BodyXSmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
