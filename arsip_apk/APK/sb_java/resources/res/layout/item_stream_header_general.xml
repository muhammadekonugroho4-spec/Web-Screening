<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_stream_header_general_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/stream_general_livestream"
            layout="@layout/comp_banner_livestream"/>
        <include
            android:id="@+id/stream_multiple_banner"
            android:visibility="gone"
            layout="@layout/comp_stream_multiple_banner"/>
        <View
            android:id="@+id/v_banner_separator"
            android:background="?attr/themeColorDividerThick"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_4"
            android:layout_marginTop="@dimen/height_20"/>
        <include
            android:id="@+id/stream_general_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:layout_marginBottom="@dimen/spacing_8"
            layout="@layout/comp_stream_search"/>
        <include
            android:id="@+id/stream_general_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/spacing_10"
            layout="@layout/comp_stream_filter_chip"/>
        <include
            android:layout_gravity="center"
            android:id="@+id/stream_header_reload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_50"
            android:layout_marginBottom="@dimen/spacing_8"
            layout="@layout/comp_stream_reload"/>
    </LinearLayout>
</ScrollView>
