<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_parent_balance_info"
    android:tag="layout/comp_portfolio_detail_balance_info_0"
    android:background="@drawable/border_gray_rounded_white_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/spacing_6">
    <TextView
        android:id="@+id/tv_title_balance_lot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_title_balance_lot"
        android:layout_alignParentStart="true"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_10"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_balance_lot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/n_dash"
        android:textAlignment="gravity"
        android:layout_toEndOf="@+id/tv_title_balance_lot"
        android:layout_alignParentEnd="true"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_10"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_title_available_lot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_title_available_lot"
        android:layout_below="@+id/tv_title_balance_lot"
        android:layout_alignParentStart="true"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_10"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_available_lot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/n_dash"
        android:layout_below="@+id/tv_title_balance_lot"
        android:textAlignment="gravity"
        android:layout_toEndOf="@+id/tv_title_available_lot"
        android:layout_alignParentEnd="true"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_10"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_title_average_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_title_average_price"
        android:layout_below="@+id/tv_title_available_lot"
        android:layout_alignParentStart="true"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_10"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_average_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/n_dash"
        android:layout_below="@+id/tv_title_available_lot"
        android:textAlignment="gravity"
        android:layout_toEndOf="@+id/tv_title_average_price"
        android:layout_alignParentEnd="true"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_10"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_title_current_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_title_current_price"
        android:layout_below="@+id/tv_title_average_price"
        android:layout_alignParentStart="true"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_10"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_current_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/n_dash"
        android:layout_below="@+id/tv_title_average_price"
        android:textAlignment="gravity"
        android:layout_toEndOf="@+id/tv_title_current_price"
        android:layout_alignParentEnd="true"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_10"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_title_invested"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_title_invested"
        android:layout_below="@+id/tv_title_current_price"
        android:layout_alignParentStart="true"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_10"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_invested"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/n_dash"
        android:layout_below="@+id/tv_title_current_price"
        android:textAlignment="gravity"
        android:layout_toEndOf="@+id/tv_title_invested"
        android:layout_alignParentEnd="true"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_10"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_title_market_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_title_market_value"
        android:layout_below="@+id/tv_title_invested"
        android:layout_alignParentStart="true"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_10"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_market_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/n_dash"
        android:layout_below="@+id/tv_title_invested"
        android:textAlignment="gravity"
        android:layout_toEndOf="@+id/tv_title_market_value"
        android:layout_alignParentEnd="true"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_10"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_title_potential_pl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_title_potential_pl"
        android:layout_below="@+id/tv_title_market_value"
        android:layout_alignParentStart="true"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_10"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_potential_pl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/n_dash"
        android:layout_below="@+id/tv_title_market_value"
        android:textAlignment="gravity"
        android:layout_toEndOf="@+id/tv_title_potential_pl"
        android:layout_alignParentEnd="true"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_10"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_title_percentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_title_percentage"
        android:layout_below="@+id/tv_title_potential_pl"
        android:layout_alignParentStart="true"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_10"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:textColor="@color/green_text"
        android:gravity="end"
        android:id="@+id/tv_percentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/n_dash"
        android:layout_below="@+id/tv_title_potential_pl"
        android:textAlignment="gravity"
        android:layout_toEndOf="@+id/tv_title_percentage"
        android:layout_alignParentEnd="true"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_10"
        style="@style/TypeStyles.BodyRegular"/>
</RelativeLayout>
