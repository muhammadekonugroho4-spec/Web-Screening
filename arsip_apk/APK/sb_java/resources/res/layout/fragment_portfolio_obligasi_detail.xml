<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_portfolio_obligasi_detail_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="?attr/themeColorSurfaceDefault"
        android:paddingLeft="@dimen/spacing_0"
        android:paddingRight="@dimen/spacing_0"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:contentInsetLeft="@dimen/spacing_0"
        app:contentInsetStart="@dimen/spacing_0"
        app:contentInsetStartWithNavigation="@dimen/spacing_0"
        app:elevation="@dimen/spacing_0">
        <RelativeLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/parent_toolbar_content_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minHeight="?attr/actionBarSize">
            <TextView
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/tv_toolbar_title_name"
                android:paddingLeft="@dimen/spacing_16"
                android:paddingRight="@dimen/spacing_16"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/title_portfolio_detail"
                android:singleLine="true"
                android:layout_centerHorizontal="true"
                android:textAlignment="gravity"
                style="@style/SbTextView.PageTitle"/>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <ViewFlipper
        android:id="@+id/vf_fragment_trading_portfolio_detail"
        android:tag="binding_1"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <RelativeLayout
                android:id="@+id/rv_parent_button_bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true">
                <View
                    android:id="@+id/view_divider"
                    android:background="?attr/themeColorDividerThin"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_1"
                    android:layout_alignParentTop="true"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:tag="binding_2"
                    android:background="@drawable/btn_exercise_selector"
                    android:padding="@dimen/spacing_12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_20"
                    android:layout_marginVertical="@dimen/spacing_20">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/spacing_16"
                        android:layout_alignParentStart="true"
                        app:srcCompat="@drawable/ic_live_support"/>
                    <TextView
                        android:textColor="@color/green_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/spacing_8"
                        android:text="@string/text_call_support"
                        android:layout_centerVertical="true"
                        style="@style/TypeStyles.Bold"/>
                </LinearLayout>
            </RelativeLayout>
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:layout_above="@+id/rv_parent_button_bottom">
                <RelativeLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/spacing_20"
                    android:layout_marginBottom="@dimen/item_gap_23"
                    android:layout_marginStart="@dimen/spacing_16"
                    android:layout_marginEnd="@dimen/spacing_16">
                    <RelativeLayout
                        android:id="@+id/parent_portfolio_detail_company_info"
                        android:background="@drawable/border_gray_rounded_white_bg"
                        android:paddingTop="@dimen/spacing_12"
                        android:paddingBottom="@dimen/spacing_12"
                        android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_16"
                        android:foreground="?attr/selectableItemBackground"
                        android:minHeight="@dimen/clickable_size_48">
                        <ImageView
                            android:id="@+id/iv_company_logo"
                            android:layout_width="@dimen/width_40"
                            android:layout_height="@dimen/height_40"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/spacing_16"
                            android:layout_alignParentStart="true"/>
                        <RelativeLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_toStartOf="@+id/iv_portfolio_detail_icon"
                            android:layout_toEndOf="@+id/iv_company_logo"
                            android:layout_marginHorizontal="@dimen/item_gap_10">
                            <TextView
                                android:textColor="?attr/themeColorTextPrimary"
                                android:id="@+id/tv_portfolio_detail_symbol"
                                android:tag="binding_3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/TypeStyles.HeadingRegular"/>
                            <TextView
                                android:ellipsize="end"
                                android:id="@+id/tv_portfolio_detail_desc"
                                android:tag="binding_4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_2"
                                android:maxLines="1"
                                android:layout_below="@+id/tv_portfolio_detail_symbol"
                                style="@style/TypeStyles.BodyXSmall.Secondary"/>
                            <RelativeLayout
                                android:id="@+id/rl_trading_portfolio_stockbit_detail_desc_indexes"
                                android:tag="binding_5"
                                android:background="@drawable/bg_rounded_green_white_bg"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/clickable_size_18"
                                android:layout_above="@+id/tv_portfolio_detail_desc"
                                android:layout_marginStart="@dimen/spacing_6"
                                android:layout_toEndOf="@+id/tv_portfolio_detail_symbol">
                                <TextView
                                    android:textSize="@dimen/text_size_12"
                                    android:textColor="@color/green_text"
                                    android:paddingLeft="@dimen/spacing_6"
                                    android:paddingRight="@dimen/spacing_6"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/buy_title_syariah_title"
                                    android:layout_centerInParent="true"
                                    style="@style/TypeStyles.HeadingSmall.Green"/>
                            </RelativeLayout>
                        </RelativeLayout>
                        <ImageView
                            android:id="@+id/iv_portfolio_detail_icon"
                            android:padding="@dimen/item_gap_xs"
                            android:visibility="gone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleType="centerInside"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:rotation="180"
                            android:layout_marginEnd="@dimen/spacing_16"
                            android:layout_alignParentEnd="true"
                            app:srcCompat="@drawable/back_toolbar"
                            app:tint="?attr/themeIconTintColor"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/rl_detail_portfolio_main"
                        android:background="@drawable/border_gray_rounded_white_bg"
                        android:paddingTop="@dimen/spacing_6"
                        android:paddingBottom="@dimen/spacing_6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/parent_portfolio_detail_company_info">
                        <TextView
                            android:id="@+id/tv_title_invested"
                            android:paddingLeft="@dimen/spacing_16"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/spacing_16"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_portfolio_invested"
                            android:layout_alignParentLeft="true"
                            android:paddingStart="@dimen/spacing_16"
                            android:paddingEnd="@dimen/spacing_16"
                            android:layout_alignParentStart="true"
                            style="@style/TypeStyles.BodyRegular"/>
                        <TextView
                            android:gravity="end"
                            android:tag="binding_6"
                            android:paddingLeft="@dimen/spacing_16"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/spacing_16"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toRightOf="@+id/tv_title_invested"
                            android:layout_alignParentRight="true"
                            android:textAlignment="gravity"
                            android:paddingStart="@dimen/spacing_16"
                            android:paddingEnd="@dimen/spacing_16"
                            android:layout_toEndOf="@+id/tv_title_invested"
                            android:layout_alignParentEnd="true"
                            style="@style/TypeStyles.BodyRegular"/>
                        <TextView
                            android:id="@+id/tv_title_exercise_price"
                            android:paddingLeft="@dimen/spacing_16"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/spacing_16"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_title_exercise_price_exercise"
                            android:layout_below="@+id/tv_title_invested"
                            android:layout_alignParentLeft="true"
                            android:paddingStart="@dimen/spacing_16"
                            android:paddingEnd="@dimen/spacing_16"
                            android:layout_alignParentStart="true"
                            style="@style/TypeStyles.BodyRegular"/>
                        <TextView
                            android:gravity="end"
                            android:tag="binding_7"
                            android:paddingLeft="@dimen/spacing_16"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/spacing_16"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toRightOf="@+id/tv_title_exercise_price"
                            android:layout_below="@+id/tv_title_invested"
                            android:layout_alignParentRight="true"
                            android:textAlignment="gravity"
                            android:paddingStart="@dimen/spacing_16"
                            android:paddingEnd="@dimen/spacing_16"
                            android:layout_toEndOf="@+id/tv_title_exercise_price"
                            android:layout_alignParentEnd="true"
                            style="@style/TypeStyles.BodyRegular"/>
                        <TextView
                            android:id="@+id/tv_title_shares"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/title_exercise_shares"
                            android:layout_below="@+id/tv_title_exercise_price"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:paddingHorizontal="@dimen/spacing_16"
                            android:paddingVertical="@dimen/item_gap_m"
                            style="@style/TypeStyles.BodyRegular"/>
                        <TextView
                            android:gravity="end"
                            android:tag="binding_8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toRightOf="@+id/tv_title_shares"
                            android:layout_below="@+id/tv_title_exercise_price"
                            android:layout_alignParentRight="true"
                            android:textAlignment="gravity"
                            android:layout_toEndOf="@+id/tv_title_shares"
                            android:layout_alignParentEnd="true"
                            android:paddingHorizontal="@dimen/spacing_16"
                            android:paddingVertical="@dimen/item_gap_m"
                            style="@style/TypeStyles.BodyRegular"/>
                        <TextView
                            android:id="@+id/tv_title_bond_maturity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/title_bond_maturity"
                            android:layout_below="@+id/tv_title_shares"
                            android:layout_alignParentLeft="true"
                            android:layout_alignParentStart="true"
                            android:paddingHorizontal="@dimen/spacing_16"
                            android:paddingVertical="@dimen/item_gap_m"
                            style="@style/TypeStyles.BodyRegular"/>
                        <TextView
                            android:gravity="end"
                            android:tag="binding_9"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toRightOf="@+id/tv_title_bond_maturity"
                            android:layout_below="@+id/tv_title_shares"
                            android:layout_alignParentRight="true"
                            android:textAlignment="gravity"
                            android:layout_toEndOf="@+id/tv_title_bond_maturity"
                            android:layout_alignParentEnd="true"
                            android:paddingHorizontal="@dimen/spacing_16"
                            android:paddingVertical="@dimen/item_gap_m"
                            style="@style/TypeStyles.BodyRegular"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/rl_maturity_date"
                        android:background="@drawable/border_gray_rounded_white_bg"
                        android:paddingTop="@dimen/spacing_6"
                        android:paddingBottom="@dimen/spacing_6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_m"
                        android:layout_below="@+id/rl_detail_portfolio_main">
                        <TextView
                            android:id="@+id/tv_title_rate"
                            android:paddingLeft="@dimen/spacing_16"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/spacing_16"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/title_coupon_rate"
                            android:layout_alignParentLeft="true"
                            android:paddingStart="@dimen/spacing_16"
                            android:paddingEnd="@dimen/spacing_16"
                            android:layout_alignParentStart="true"
                            style="@style/TypeStyles.BodyRegular"/>
                        <TextView
                            android:gravity="end"
                            android:id="@+id/tv_maturity_date"
                            android:tag="binding_10"
                            android:paddingLeft="@dimen/spacing_16"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/spacing_16"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentRight="true"
                            android:textAlignment="gravity"
                            android:paddingStart="@dimen/spacing_16"
                            android:paddingEnd="@dimen/spacing_16"
                            android:layout_alignParentEnd="true"
                            style="@style/TypeStyles.BodyRegular"/>
                        <TextView
                            android:id="@+id/tv_title_payment_date"
                            android:paddingLeft="@dimen/spacing_16"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/spacing_16"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/title_coupon_payment_date"
                            android:layout_below="@+id/tv_title_rate"
                            android:layout_alignParentLeft="true"
                            android:paddingStart="@dimen/spacing_16"
                            android:paddingEnd="@dimen/spacing_16"
                            android:layout_alignParentStart="true"
                            style="@style/TypeStyles.BodyRegular"/>
                        <TextView
                            android:gravity="end"
                            android:tag="binding_11"
                            android:paddingLeft="@dimen/spacing_16"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/spacing_16"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toRightOf="@+id/tv_title_payment_date"
                            android:layout_below="@+id/tv_title_rate"
                            android:layout_alignParentRight="true"
                            android:textAlignment="gravity"
                            android:paddingStart="@dimen/spacing_16"
                            android:paddingEnd="@dimen/spacing_16"
                            android:layout_toEndOf="@+id/tv_title_payment_date"
                            android:layout_alignParentEnd="true"
                            style="@style/TypeStyles.BodyRegular"/>
                        <TextView
                            android:id="@+id/tv_title_coupon_distribution"
                            android:paddingLeft="@dimen/spacing_16"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/spacing_16"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/title_coupon_distribution"
                            android:layout_below="@+id/tv_title_payment_date"
                            android:layout_alignParentLeft="true"
                            android:paddingStart="@dimen/spacing_16"
                            android:paddingEnd="@dimen/spacing_16"
                            android:layout_alignParentStart="true"
                            style="@style/TypeStyles.BodyRegular"/>
                        <TextView
                            android:gravity="end"
                            android:tag="binding_12"
                            android:paddingLeft="@dimen/spacing_16"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/spacing_16"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_toRightOf="@+id/tv_title_payment_date"
                            android:layout_below="@+id/tv_title_payment_date"
                            android:layout_alignParentRight="true"
                            android:textAlignment="gravity"
                            android:paddingStart="@dimen/spacing_16"
                            android:paddingEnd="@dimen/spacing_16"
                            android:layout_toEndOf="@+id/tv_title_payment_date"
                            android:layout_alignParentEnd="true"
                            style="@style/TypeStyles.BodyRegular"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/rv_portfolio_allocation"
                        android:tag="binding_13"
                        android:background="@drawable/border_gray_rounded_white_bg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:minHeight="@dimen/clickable_size_48"
                        android:layout_below="@+id/rl_maturity_date"
                        android:paddingVertical="@dimen/spacing_16">
                        <TextView
                            android:textColor="?attr/themeColorTextPrimary"
                            android:id="@+id/tv_portfolio_allocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/spacing_16"
                            android:text="@string/lbl_title_portfolio_allocation"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/spacing_16"
                            style="@style/TypeStyles.BodyRegular"/>
                        <TextView
                            android:textColor="?attr/themeColorTextPrimary"
                            android:id="@+id/tv_percentage_allocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/spacing_16"
                            android:layout_alignParentEnd="true"
                            style="@style/TypeStyles.HeadingRegular"/>
                        <ProgressBar
                            android:id="@+id/pb_percentage_allocation"
                            android:layout_width="@dimen/icon_placeholder_18"
                            android:layout_height="@dimen/icon_placeholder_18"
                            android:max="100"
                            android:progress="50"
                            android:indeterminateOnly="false"
                            android:progressDrawable="@drawable/circular_progress_bar"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/spacing_8"
                            android:layout_toStartOf="@+id/tv_percentage_allocation"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/info_exercise"
                        android:background="@drawable/bg_purple"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:layout_below="@+id/rv_portfolio_allocation">
                        <TableLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/item_gap_12">
                            <TableRow>
                                <ImageView
                                    android:layout_gravity="center"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/spacing_8"
                                    app:srcCompat="@drawable/ic_info_purple"/>
                                <TextView
                                    android:tag="binding_14"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginStart="@dimen/item_gap_8"
                                    style="@style/TypeStyles.BodyRegular"/>
                            </TableRow>
                        </TableLayout>
                    </RelativeLayout>
                </RelativeLayout>
            </androidx.core.widget.NestedScrollView>
        </RelativeLayout>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:tag="binding_15"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include layout="@layout/skeleton_item_portfolio_detail_obligasi"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <include
            android:layout_gravity="center"
            android:id="@+id/parent_error_trading_portfolio_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/comp_icon_error_view"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsv_fragment_trading_portfolio_detail"
            android:tag="binding_16"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <include layout="@layout/comp_empty_data_trading_obligasi"/>
        </androidx.core.widget.NestedScrollView>
    </ViewFlipper>
</androidx.appcompat.widget.LinearLayoutCompat>
