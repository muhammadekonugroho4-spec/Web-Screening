<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/clickable_size_32"
    android:layout_height="@dimen/clickable_size_32">
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/ibMenuViewCreateStreamPostIcon"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="@dimen/width_24"
        android:layout_height="@dimen/height_24"
        android:tint="?attr/themeIconTintColor"
        android:contentDescription="@string/btn_write_a_post"
        app:srcCompat="@drawable/ic_android_compose"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/ivMenuViewCreateStreamPostBadge"
        android:visibility="gone"
        android:layout_width="@dimen/item_gap_m"
        android:layout_height="@dimen/item_gap_m"
        android:layout_marginTop="@dimen/item_gap_m"
        android:layout_marginRight="@dimen/item_gap_m"
        android:src="@drawable/action_item_badge"
        android:scaleType="fitXY"/>
</FrameLayout>
