<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_margin_trading_e_sign_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.stockbit.uikit.topbar.TopbarStockbitTitle
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:topBarTitleTitle="@string/title_e_sign"
            app:topBarType="CenterTitle"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/clickable_size_56"
            android:layout_weight="1">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/cl_intro"
                    android:background="@drawable/bg_e_sign_information_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_16"
                    android:layout_marginHorizontal="@dimen/item_gap_20"
                    android:paddingHorizontal="@dimen/item_gap_16"
                    android:paddingVertical="@dimen/item_gap_12"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:id="@+id/aciv_icon"
                        android:layout_width="@dimen/width_16"
                        android:layout_height="@dimen/height_16"
                        android:tint="?attr/themeColorFeaturePeriwinkle"
                        app:srcCompat="@drawable/ic_info"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/actv_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_e_sign_information"
                        android:layout_marginStart="@dimen/item_gap_8"
                        style="@style/TypeStyles.BodyXSmall"/>
                </LinearLayout>
                <com.github.gcacace.signaturepad.views.SignaturePad
                    android:id="@+id/signature_pad"
                    android:background="?attr/themeSignaturePadButtonEnable"
                    android:saveEnabled="false"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_marginTop="@dimen/item_gap_16"
                    android:layout_marginHorizontal="@dimen/item_gap_20"
                    app:layout_constraintTop_toBottomOf="@+id/cl_intro"
                    app:penColor="?attr/themeColorTextGreen"
                    app:penMaxWidth="3dp"
                    app:penMinWidth="1dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_clear_sign"
                    android:tag="binding_1"
                    android:background="@drawable/bg_border_gray_rounded_outline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_16"
                    android:foreground="@null"
                    android:paddingHorizontal="@dimen/item_gap_20"
                    android:paddingVertical="@dimen/item_gap_12"
                    app:layout_constraintEnd_toEndOf="@+id/signature_pad"
                    app:layout_constraintStart_toStartOf="@+id/signature_pad"
                    app:layout_constraintTop_toBottomOf="@+id/signature_pad">
                    <ImageView
                        android:id="@+id/iv_retry_e_sign"
                        android:layout_width="@dimen/width_16"
                        android:layout_height="@dimen/height_16"
                        app:srcCompat="@drawable/ic_recycle"/>
                    <TextView
                        android:textColor="?attr/themeColorExtendedGreenMedium"
                        android:id="@+id/tv_retry_e_sign"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_e_sign_try_again"
                        android:layout_marginStart="@dimen/item_gap_4"
                        style="@style/TypeStyles.HeadingSmall"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>
        <com.stockbit.uikit.buttons.PrimaryButton
            android:id="@+id/btn_next"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_48"
            android:text="@string/lbl_e_sign_button_submit"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/ll_loading"
        android:tag="binding_3"
        android:background="@android:color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.5">
        <com.stockbit.uikit.control.ControlProgressLoading
            android:layout_width="@dimen/clickable_size_48"
            android:layout_height="@dimen/clickable_size_48"
            app:progressLoadingSize="large"/>
    </LinearLayout>
</FrameLayout>
