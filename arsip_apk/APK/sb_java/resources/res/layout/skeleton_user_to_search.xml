<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/item_gap_20"
    android:layout_marginVertical="@dimen/item_gap_8">
    <View
        android:id="@+id/view_avatar"
        android:background="@drawable/ic_circle_grey"
        android:layout_width="@dimen/avatar_size_default"
        android:layout_height="@dimen/avatar_size_default"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="0dp"
        android:layout_height="@dimen/spacing_16"
        android:layout_marginStart="@dimen/spacing_12"
        android:layout_marginEnd="@dimen/spacing_20"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintBottom_toBottomOf="@+id/view_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/view_avatar"
        app:layout_constraintTop_toTopOf="@+id/view_avatar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
