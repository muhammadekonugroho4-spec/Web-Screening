<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/clickable_size_48">
    <androidx.appcompat.widget.AppCompatImageButton
        android:layout_gravity="start|center_vertical"
        android:id="@+id/ib_more_menu_portfolio"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="@dimen/clickable_size_18"
        android:layout_height="@dimen/clickable_size_48"
        android:contentDescription="@string/button_menu_more"
        android:layout_marginStart="@dimen/spacing_6"
        app:srcCompat="@drawable/ic_more_horizontal"
        app:tint="?attr/themeIconTintColor"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lav_more_portfolio"
        android:visibility="gone"
        android:layout_width="@dimen/clickable_size_14"
        android:layout_height="@dimen/clickable_size_14"
        android:layout_marginTop="@dimen/spacing_6"
        app:lottie_autoPlay="true"
        app:lottie_fileName="lottie_anim_portfolio_more.json"
        app:lottie_loop="true"/>
</FrameLayout>
