<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_base_otp_verification_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_20">
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_content_description"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_marginBottom="@dimen/spacing_20"
        android:text="@string/description_choose_verification_method"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyRegular"/>
    <RelativeLayout
        android:id="@+id/rl_otp_email"
        android:tag="binding_2"
        android:padding="@dimen/spacing_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_12">
        <ImageView
            android:id="@+id/img_icon_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_otp_option_email"
            android:layout_centerVertical="true"
            android:contentDescription="@string/otp_option_title_email"
            android:layout_alignParentStart="true"/>
        <TextView
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_title_email"
            android:tag="binding_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/otp_option_title_email"
            android:maxLines="1"
            android:layout_alignParentTop="true"
            android:lineSpacingExtra="2sp"
            android:translationY="-0.97sp"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_marginEnd="@dimen/spacing_2"
            android:layout_toStartOf="@+id/img_radio_check_email"
            android:layout_toEndOf="@+id/img_icon_email"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_item_subtitle_email"
            android:tag="binding_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2"
            android:maxLines="1"
            android:layout_below="@+id/tv_title_email"
            android:lineSpacingExtra="1sp"
            android:translationY="-0.69sp"
            android:layout_alignStart="@+id/tv_title_email"
            android:layout_alignEnd="@+id/tv_title_email"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/TypeStyles.BodyXSmall"/>
        <ImageView
            android:id="@+id/img_radio_check_email"
            android:tag="binding_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:contentDescription="@string/otp_option_title_email"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_otp_whatsapp"
        android:tag="binding_6"
        android:padding="@dimen/spacing_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_12">
        <ImageView
            android:id="@+id/img_icon_whatsapp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_otp_option_whatsapp"
            android:layout_centerVertical="true"
            android:contentDescription="@string/otp_option_title_whatsapp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_title_whatsapp"
            android:tag="binding_7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/otp_option_title_whatsapp"
            android:maxLines="1"
            android:layout_alignParentTop="true"
            android:lineSpacingExtra="2sp"
            android:translationY="-0.97sp"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_marginEnd="@dimen/spacing_2"
            android:layout_toStartOf="@+id/img_radio_check_whatsapp"
            android:layout_toEndOf="@+id/img_icon_whatsapp"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_item_subtitle_whatsapp"
            android:tag="binding_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2"
            android:maxLines="1"
            android:layout_below="@+id/tv_title_whatsapp"
            android:lineSpacingExtra="1sp"
            android:translationY="-0.69sp"
            android:layout_alignStart="@+id/tv_title_whatsapp"
            android:layout_alignEnd="@+id/tv_title_whatsapp"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/TypeStyles.BodyXSmall"/>
        <ImageView
            android:id="@+id/img_radio_check_whatsapp"
            android:tag="binding_9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:contentDescription="@string/otp_option_title_whatsapp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_otp_sms"
        android:tag="binding_10"
        android:padding="@dimen/spacing_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/img_icon_sms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_otp_option_sms"
            android:layout_centerVertical="true"
            android:contentDescription="@string/otp_option_title_sms"
            android:layout_alignParentStart="true"/>
        <TextView
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_title_sms"
            android:tag="binding_11"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/otp_option_title_sms"
            android:maxLines="1"
            android:layout_alignParentTop="true"
            android:lineSpacingExtra="2sp"
            android:translationY="-0.97sp"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_marginEnd="@dimen/spacing_2"
            android:layout_toStartOf="@+id/img_radio_check_sms"
            android:layout_toEndOf="@+id/img_icon_sms"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_item_subtitle_sms"
            android:tag="binding_12"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2"
            android:maxLines="1"
            android:layout_below="@+id/tv_title_sms"
            android:lineSpacingExtra="1sp"
            android:translationY="-0.69sp"
            android:layout_alignStart="@+id/tv_title_sms"
            android:layout_alignEnd="@+id/tv_title_sms"
            app:layout_constraintBottom_toBottomOf="parent"
            style="@style/TypeStyles.BodyXSmall"/>
        <ImageView
            android:id="@+id/img_radio_check_sms"
            android:tag="binding_13"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:contentDescription="@string/otp_option_title_sms"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:layout_width="0dp"
        android:layout_height="@dimen/spacing_32"/>
</LinearLayout>
