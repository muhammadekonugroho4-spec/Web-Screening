<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_dividend_stock_header_column_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        android:paddingEnd="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/text_size_11"
            android:gravity="end"
            android:id="@+id/tv_column_ratio"
            android:layout_width="@dimen/company_dividend_value_width"
            android:layout_height="wrap_content"
            android:text="@string/text_corp_action_item_ratio"
            android:layout_weight="1"
            style="@style/TypeStyles.HeadingSmall"/>
        <TextView
            android:textSize="@dimen/text_size_11"
            android:ellipsize="end"
            android:gravity="end"
            android:layout_width="@dimen/company_dividend_last_price_width"
            android:layout_height="wrap_content"
            android:text="@string/text_corp_action_item_factor"
            android:layout_weight="1"
            style="@style/TypeStyles.HeadingSmall"/>
        <TextView
            android:textSize="@dimen/text_size_11"
            android:gravity="end"
            android:layout_width="@dimen/company_date_width"
            android:layout_height="wrap_content"
            android:text="@string/text_corp_action_item_cum_date"
            android:layout_weight="1"
            style="@style/TypeStyles.HeadingSmall"/>
        <TextView
            android:textSize="@dimen/text_size_11"
            android:gravity="end"
            android:layout_width="@dimen/company_date_width"
            android:layout_height="wrap_content"
            android:text="@string/lbl_corp_ex_date"
            android:layout_weight="1"
            style="@style/TypeStyles.HeadingSmall"/>
        <TextView
            android:textSize="@dimen/text_size_11"
            android:gravity="end"
            android:layout_width="@dimen/company_date_recording_width"
            android:layout_height="wrap_content"
            android:text="@string/lbl_corp_rec_date"
            android:layout_weight="1"
            style="@style/TypeStyles.HeadingSmall"/>
        <TextView
            android:textSize="@dimen/text_size_11"
            android:gravity="end"
            android:layout_width="@dimen/company_date_payment_width"
            android:layout_height="wrap_content"
            android:text="@string/lbl_corp_pay_date"
            android:layout_weight="1"
            style="@style/TypeStyles.HeadingSmall"/>
    </LinearLayout>
    <View
        android:background="?attr/themeColorDividerThin"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/item_gap_12"
        app:layout_constraintEnd_toEndOf="@+id/ll_content"
        app:layout_constraintStart_toStartOf="@+id/ll_content"
        app:layout_constraintTop_toBottomOf="@+id/ll_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
