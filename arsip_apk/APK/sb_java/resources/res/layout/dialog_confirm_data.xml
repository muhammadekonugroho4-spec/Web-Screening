<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_confirm_data_0"
    android:background="@drawable/bg_top_rounded_20_theme_nav_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/item_gap_20">
    <View
        android:id="@+id/view5"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ln_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_18"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/confirm_data"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/item_gap_36"
            style="@style/SbTextView.ListTitle.Highempasis.Bold"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/iv_close"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/item_gap_12"
            android:layout_height="@dimen/item_gap_12"
            android:layout_weight="0"
            android:layout_marginEnd="@dimen/item_gap_24"
            app:srcCompat="0x7f080644"/>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        app:layout_constraintBottom_toTopOf="@+id/rl_submit_symbol"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ln_title"
        app:layout_constraintVertical_bias="1">
        <RelativeLayout
            android:id="@+id/relativeLayout2"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ln_title">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llc_parent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20"/>
            <include
                android:id="@+id/symbol_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/llc_parent"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20"
                layout="@layout/layout_symbol_list"/>
            <View
                android:id="@+id/view"
                android:background="?attr/themeColorDividerThick"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_8"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_below="@+id/symbol_list"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ln_payment_title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_below="@+id/view"
                android:layout_marginStart="@dimen/item_gap_20">
                <TextView
                    android:id="@+id/tv_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/price_for_tranfer_stock"
                    style="@style/SbTextView.BodyDefault.Highempasis.Bold"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ic_info"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:scaleType="centerInside"
                    android:layout_weight="0.3"
                    android:paddingStart="@dimen/item_gap_s"
                    app:srcCompat="@drawable/ic_info_fee"
                    app:tint="?attr/titleTextColorMidgray"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ln_total_symbol"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/item_gap_16"
                android:layout_below="@+id/ln_payment_title"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20">
                <TextView
                    android:id="@+id/tv_symbol_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total_symbol"
                    android:layout_weight="1"
                    style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
                <TextView
                    android:gravity="end"
                    android:tag="binding_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/SbTextView.BodyDefault.Highempasis.Bold"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ln_total_price"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/item_gap_16"
                android:layout_below="@+id/ln_total_symbol"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20">
                <TextView
                    android:ellipsize="end"
                    android:tag="binding_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="2"
                    style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
                <TextView
                    android:gravity="end"
                    android:tag="binding_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1"
                    style="@style/SbTextView.BodyDefault.Highempasis.Bold"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ln_total_receive"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/item_gap_16"
                android:layout_below="@+id/ln_total_price"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/price_for_receive_stock"
                    android:layout_weight="1"
                    style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
                <TextView
                    android:textColor="@color/green_text"
                    android:gravity="end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/price_for_receive_stock_value"
                    android:layout_weight="1"
                    style="@style/SbTextView.BodyDefault.Highempasis.Bold"/>
            </LinearLayout>
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_info_rdn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/item_gap_16"
                android:layout_below="@+id/ln_total_receive"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20"
                android:elevation="0dp"
                app:cardBackgroundColor="?attr/themeBgSetSymbolTfStock"
                app:cardCornerRadius="@dimen/item_gap_4"
                app:cardElevation="0dp">
                <TextView
                    android:tag="binding_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_8"
                    android:layout_marginBottom="@dimen/item_gap_8"
                    android:layout_marginStart="@dimen/item_gap_12"
                    android:layout_marginEnd="@dimen/item_gap_12"
                    style="@style/SbTextView.Caption.Highempasis"/>
            </androidx.cardview.widget.CardView>
            <View
                android:id="@+id/view2"
                android:background="?attr/themeColorDividerThick"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_8"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_below="@+id/cv_info_rdn"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="top"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_marginBottom="@dimen/item_gap_22"
                android:layout_below="@+id/view2"
                android:layout_marginHorizontal="@dimen/item_gap_20">
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/checkBox"
                    android:tag="binding_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:button="@drawable/bg_checkbox_square"
                    android:layout_weight="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_checkbox_info"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/confirm_check_info"
                    android:layout_marginStart="@dimen/item_gap_18"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/checkBox"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_bias="1"
                    style="@style/SbTextView.Caption.Highempasis"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.stockbit.component.tooltip.SbContainerTooltip
                android:id="@+id/tooltip_prices"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="@dimen/height_500"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/item_gap_xxs"
                android:layout_marginEnd="@dimen/item_gap_xxs"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
    <com.stockbit.common.uikit.StockbitLoadingButton
        android:id="@+id/rl_submit_symbol"
        android:tag="binding_7"
        android:background="@drawable/bg_selector_btn_green"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        app:buttonText="@string/button_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
