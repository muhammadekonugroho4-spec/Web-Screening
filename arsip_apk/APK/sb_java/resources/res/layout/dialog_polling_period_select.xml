<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/dialog_polling_period_select_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_select_duration"
        android:layout_marginVertical="@dimen/spacing_8"
        style="@style/TypeStyles.HeadingLarge"/>
    <RadioGroup
        android:id="@+id/rg_duration_select"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_marginBottom="@dimen/icon_placeholder_32"
        android:layout_marginHorizontal="@dimen/spacing_20">
        <include
            android:id="@+id/item_polling_one_day"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_36"
            android:layout_marginBottom="@dimen/spacing_8"
            layout="@layout/item_period_select"/>
        <include
            android:id="@+id/item_polling_one_week"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_36"
            android:layout_marginBottom="@dimen/spacing_8"
            layout="@layout/item_period_select"/>
        <include
            android:id="@+id/item_polling_forever"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_36"
            android:layout_marginBottom="@dimen/spacing_8"
            layout="@layout/item_period_select"/>
        <include
            android:id="@+id/item_polling_specific"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_36"
            layout="@layout/item_period_select"/>
    </RadioGroup>
</LinearLayout>
