<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/llScreenerScreenCellContainer"
    android:tag="layout/layout_screener_screen_cell_0"
    android:layout_width="@dimen/screener_column_max_width"
    android:layout_height="@dimen/height_65">
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:layout_gravity="end|center_vertical"
        android:id="@+id/tvCellData"
        android:paddingLeft="@dimen/item_gap_m"
        android:paddingRight="@dimen/item_gap_l"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:maxLines="1"
        app:autoSizeMaxTextSize="@dimen/text_body"
        app:autoSizeMinTextSize="@dimen/text_badge"
        app:autoSizeTextType="uniform"
        style="@style/SbTextView.Caption"/>
</LinearLayout>
