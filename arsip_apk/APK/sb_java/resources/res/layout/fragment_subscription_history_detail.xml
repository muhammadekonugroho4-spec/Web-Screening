<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_subscription_history_detail_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stockbit.uikit.topbar.TopbarStockbitTitle
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:topBarTitleTitle="@string/title_stockbit_pro"
        app:topBarType="CenterTitle"/>
    <FrameLayout
        android:id="@+id/fl_payment_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:paddingHorizontal="@dimen/item_gap_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/bg_border_gray_rounded_outline"
            android:padding="@dimen/item_gap_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title_order_id_detail_subscription_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_id"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.BodyRegular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="end"
                android:id="@+id/tv_order_id_detail_subscription_history"
                android:tag="binding_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_title_order_id_detail_subscription_history"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.BodyRegular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title_payment_method_detail_subscription_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_15"
                android:text="@string/text_payment_method"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_order_id_detail_subscription_history"
                style="@style/TypeStyles.BodyRegular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="end"
                android:id="@+id/tv_payment_method_detail_subscription_history"
                android:tag="binding_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_15"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_title_payment_method_detail_subscription_history"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_order_id_detail_subscription_history"
                style="@style/TypeStyles.BodyRegular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title_date_detail_subscription_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_15"
                android:text="@string/text_payment_date"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_payment_method_detail_subscription_history"
                style="@style/TypeStyles.BodyRegular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="end"
                android:id="@+id/tv_date_detail_subscription_history"
                android:tag="binding_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_15"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_title_date_detail_subscription_history"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_payment_method_detail_subscription_history"
                style="@style/TypeStyles.BodyRegular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:background="?attr/themeColorTextWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_title_payment_detail"
            android:layout_marginStart="@dimen/item_gap_18"
            android:paddingHorizontal="@dimen/item_gap_5"
            style="@style/TypeStyles.HeadingRegular"/>
    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:paddingHorizontal="@dimen/item_gap_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_payment_detail">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/bg_border_gray_rounded_outline"
            android:padding="@dimen/item_gap_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_type_subscription_history"
                android:tag="binding_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.BodyRegular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="end"
                android:id="@+id/tv_amount_subscription_history"
                android:tag="binding_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_type_subscription_history"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.BodyRegular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title_admin_fee_detail_subscription_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_15"
                android:text="@string/text_admin_fee"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_type_subscription_history"
                style="@style/TypeStyles.BodyRegular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="end"
                android:id="@+id/tv_admin_fee_detail_subscription_history"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_15"
                android:text="@string/text_free"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_title_admin_fee_detail_subscription_history"
                app:layout_constraintTop_toBottomOf="@+id/tv_type_subscription_history"
                style="@style/TypeStyles.BodyRegular"/>
            <View
                android:id="@+id/view_detail_subscription_history"
                android:background="?attr/themeColorDividerThin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_xxxs"
                android:layout_marginTop="@dimen/item_gap_14"
                app:layout_constraintTop_toBottomOf="@+id/tv_admin_fee_detail_subscription_history"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title_total_detail_subscription_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_14"
                android:text="@string/text_total"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_detail_subscription_history"
                style="@style/TypeStyles.HeadingRegular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="end"
                android:id="@+id/tv_total_detail_subscription_history"
                android:tag="binding_6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_15"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_title_total_detail_subscription_history"
                app:layout_constraintTop_toBottomOf="@+id/view_detail_subscription_history"
                style="@style/TypeStyles.HeadingRegular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:background="?attr/themeColorTextWhite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_title_payment_summary"
            android:layout_marginStart="@dimen/item_gap_18"
            android:paddingHorizontal="@dimen/item_gap_5"
            style="@style/TypeStyles.HeadingRegular"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
