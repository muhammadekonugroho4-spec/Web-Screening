<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/row_setting_kamus_investasi_0"
    android:background="@drawable/border_gray_rounded_white_bg"
    android:paddingTop="@dimen/item_gap_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/item_gap_m"
    android:layout_marginBottom="@dimen/item_gap_20"
    android:paddingStart="@dimen/item_gap_20"
    android:paddingEnd="@dimen/item_gap_20">
    <TextView
        android:textSize="@dimen/text_size_16"
        android:id="@+id/tvKamusInvestasiName"
        android:paddingBottom="@dimen/item_gap_l"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/n_dash"
        style="@style/SbTextView.BodyDefault.Bold"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_s"
        android:text="@string/setting_kamus_investasi_definition"
        style="@style/SbTextView.BodyDefault.Bold.Semi"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:id="@+id/tvKamusInvestasiDefinition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/n_dash"
        style="@style/SbTextView.BodyDefault"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_m"
        android:layout_marginBottom="@dimen/item_gap_s"
        android:text="@string/setting_kamus_investasi_formula"
        style="@style/SbTextView.BodyDefault.Bold.Semi"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:id="@+id/tvKamusInvestasiFormula"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/n_dash"
        style="@style/SbTextView.BodyDefault"/>
</LinearLayout>
