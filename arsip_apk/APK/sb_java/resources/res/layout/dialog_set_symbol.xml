<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_set_symbol_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_top_rounded_20_theme_nav_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_top_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/item_gap_22">
                <TextView
                    android:textSize="@dimen/text_size_18"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/set_symbol_title"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/item_gap_36"
                    style="@style/SbTextView.ListTitle.Highempasis.Bold"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_close"
                    android:tag="binding_1"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/item_gap_12"
                    android:layout_height="@dimen/item_gap_12"
                    android:layout_weight="0"
                    android:layout_marginEnd="@dimen/item_gap_24"
                    app:srcCompat="0x7f080644"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/item_gap_34">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="?attr/titleTextColorHighgray"
                    android:id="@+id/tv_label_input_stock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stock_code"
                    android:layout_marginStart="21dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/SbTextView.Caption.Highgray.Medium"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:theme="@style/EditTextHintWhite"
                    android:id="@+id/til_stock"
                    android:focusable="false"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="@dimen/item_gap_18"
                    app:hintTextColor="?attr/titleTextColorMidgray"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.stockbit.transferstock.utils.ClearFocusEditTextView
                        android:textAppearance="@style/SbTextView.BodyDefault"
                        android:scrollbarStyle="outsideOverlay"
                        android:textColor="?attr/titleTextColorHighempasis"
                        android:textColorHint="?attr/titleTextColorMidgray"
                        android:id="@+id/act_stock"
                        android:paddingBottom="@dimen/item_gap_16"
                        android:focusable="false"
                        android:scrollbars="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lines="1"
                        android:inputType="textNoSuggestions"
                        android:textCursorDrawable="@drawable/cursor_green"/>
                </com.google.android.material.textfield.TextInputLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_total_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_weight="0.3"
            android:layout_marginStart="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_top_layout">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_total_share"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_shares"
                style="@style/SbTextView.ListTitle.Highempasis.Normal"/>
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/aib_info_total_share"
                android:tag="binding_2"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/item_gap_xxs"
                app:srcCompat="@drawable/ic_info_extra_padding_black_24dp"
                app:tint="?attr/titleTextColorMidgray"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatEditText
            android:textColor="?attr/titleTextColorHighempasis"
            android:textColorHint="?attr/titleTextColorMidgray"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_lot"
            android:tag="binding_3"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/n_dash"
            android:inputType="number"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="@dimen/item_gap_4"
            app:layout_constraintBottom_toBottomOf="@+id/ll_total_share"
            app:layout_constraintEnd_toStartOf="@+id/ib_plus_share"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/ib_minus_share"
            app:layout_constraintTop_toTopOf="@+id/ll_total_share"
            style="@style/SbTextView.ListTitle.Highempasis.Bold"/>
        <ImageButton
            android:layout_gravity="center"
            android:id="@+id/ib_minus_share"
            android:tag="binding_4"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_lot"
            app:layout_constraintStart_toStartOf="@+id/guideline4"
            app:layout_constraintTop_toTopOf="@+id/tv_lot"
            app:srcCompat="@drawable/ic_minus_circle_outline"/>
        <ImageButton
            android:layout_gravity="end|center_vertical"
            android:id="@+id/ib_plus_share"
            android:tag="binding_5"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_lot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_lot"
            app:srcCompat="@drawable/ic_plus_circle_outline"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textColorHint="?attr/titleTextColorMidgray"
            android:gravity="center"
            android:id="@+id/tv_price"
            android:tag="binding_6"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_40"
            android:hint="@string/n_dash"
            android:inputType="numberDecimal"
            android:layout_marginStart="@dimen/item_gap_4"
            android:layout_marginEnd="@dimen/item_gap_4"
            app:layout_constraintBottom_toBottomOf="@+id/ll_purchase_price"
            app:layout_constraintEnd_toStartOf="@+id/img_plus_price"
            app:layout_constraintStart_toEndOf="@+id/img_minus_price"
            app:layout_constraintTop_toBottomOf="@+id/tv_lot"
            app:layout_constraintVertical_bias="0"
            style="@style/SbTextView.ListTitle.Highempasis.Bold"/>
        <ImageButton
            android:layout_gravity="center"
            android:id="@+id/img_minus_price"
            android:tag="binding_7"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_price"
            app:layout_constraintStart_toStartOf="@+id/guideline4"
            app:layout_constraintTop_toTopOf="@+id/tv_price"
            app:layout_constraintVertical_bias="0.444"
            app:srcCompat="@drawable/ic_minus_circle_outline"/>
        <ImageButton
            android:layout_gravity="end|center_vertical"
            android:id="@+id/img_plus_price"
            android:tag="binding_8"
            android:background="@null"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_price"
            app:layout_constraintEnd_toEndOf="@+id/ib_plus_share"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@+id/ib_plus_share"
            app:layout_constraintTop_toTopOf="@+id/tv_price"
            app:srcCompat="@drawable/ic_plus_circle_outline"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_purchase_price"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:layout_marginBottom="50dp"
            android:layout_weight="0.3"
            app:layout_constraintBottom_toTopOf="@+id/rl_submit_symbol"
            app:layout_constraintStart_toStartOf="@+id/ll_total_share"
            app:layout_constraintTop_toBottomOf="@+id/ll_total_share"
            app:layout_constraintVertical_bias="0.01">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_price_purchase"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/purchase_price"
                style="@style/SbTextView.ListTitle.Highempasis.Normal"/>
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/aib_info_price_purchase"
                android:tag="binding_9"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/item_gap_xxs"
                app:srcCompat="@drawable/ic_info_extra_padding_black_24dp"
                app:tint="?attr/titleTextColorMidgray"/>
        </LinearLayout>
        <com.stockbit.common.uikit.StockbitLoadingButton
            android:id="@+id/rl_submit_symbol"
            android:tag="binding_10"
            android:background="@drawable/bg_selector_btn_green"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_48"
            app:buttonText="@string/save"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"/>
        <com.stockbit.component.tooltip.SbContainerTooltip
            android:id="@+id/tooltip_prices"
            android:background="@color/transparent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/item_gap_xxs"
            android:layout_marginEnd="@dimen/item_gap_xxs"
            android:layout_marginHorizontal="@dimen/item_gap_10"
            app:layout_constraintBottom_toTopOf="@+id/rl_submit_symbol"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.45"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
