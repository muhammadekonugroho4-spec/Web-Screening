<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/dialog_broker_flow_info_0"
    android:background="@drawable/bg_top_rounded"
    android:paddingBottom="@dimen/spacing_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/item_gap_20">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/spacing_12"
        app:srcCompat="?attr/rectangle_dialog"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_56"
        android:text="@string/broker_flow_title"
        style="@style/TypeStyles.HeadingLarge"/>
    <TextView
        android:id="@+id/tv_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_marginBottom="@dimen/item_gap_32"
        android:text="@string/broker_flow_info"
        style="@style/TypeStyles.BodyRegular"/>
</LinearLayout>
