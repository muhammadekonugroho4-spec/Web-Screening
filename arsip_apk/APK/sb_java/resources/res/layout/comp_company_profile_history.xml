<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_parent_company_history"
    android:tag="layout/comp_company_profile_history_0"
    android:paddingBottom="@dimen/item_gap_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_company_profile_history_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        android:text="@string/company_profile_company_history"
        android:layout_marginStart="@dimen/item_gap_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:id="@+id/tv_listing_date_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:text="@string/company_profile_listing_date"
        android:layout_marginEnd="@dimen/item_gap_12"
        app:layout_constraintEnd_toStartOf="@+id/tv_listing_date_value"
        app:layout_constraintStart_toStartOf="@+id/tv_company_profile_history_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_company_profile_history_title"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_listing_date_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/item_gap_16"
        app:layout_constraintBottom_toBottomOf="@+id/tv_listing_date_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_listing_date_title"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_ipo_price_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:text="@string/company_profile_ipo_price"
        android:layout_marginEnd="@dimen/item_gap_12"
        app:layout_constraintEnd_toStartOf="@+id/tv_ipo_price_value"
        app:layout_constraintStart_toStartOf="@+id/tv_listing_date_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_listing_date_title"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_ipo_price_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/item_gap_16"
        app:layout_constraintBottom_toBottomOf="@+id/tv_ipo_price_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_ipo_price_title"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_ipo_shares_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:text="@string/company_profile_ipo_shares"
        android:layout_marginEnd="@dimen/item_gap_12"
        app:layout_constraintEnd_toStartOf="@+id/tv_ipo_shares_value"
        app:layout_constraintStart_toStartOf="@+id/tv_ipo_price_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_ipo_price_title"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_ipo_shares_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/item_gap_16"
        app:layout_constraintBottom_toBottomOf="@+id/tv_ipo_shares_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_ipo_shares_title"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_ipo_amount_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:text="@string/company_profile_ipo_amount"
        android:layout_marginEnd="@dimen/item_gap_12"
        app:layout_constraintEnd_toStartOf="@+id/tv_ipo_amount_value"
        app:layout_constraintStart_toStartOf="@+id/tv_ipo_shares_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_ipo_shares_title"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_ipo_amount_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/item_gap_16"
        app:layout_constraintBottom_toBottomOf="@+id/tv_ipo_amount_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_ipo_amount_title"
        style="@style/TypeStyles.BodyRegular"/>
    <androidx.constraintlayout.widget.Group
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_under_writer_title, tv_under_writer_value"/>
    <TextView
        android:id="@+id/tv_under_writer_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:text="@string/company_profile_underwriters"
        android:layout_marginEnd="@dimen/item_gap_12"
        app:layout_constraintEnd_toStartOf="@+id/tv_under_writer_value"
        app:layout_constraintStart_toStartOf="@+id/tv_ipo_amount_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_ipo_amount_title"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_under_writer_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/item_gap_16"
        app:layout_constraintBottom_toBottomOf="@+id/tv_under_writer_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_under_writer_title"
        style="@style/TypeStyles.BodyRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
