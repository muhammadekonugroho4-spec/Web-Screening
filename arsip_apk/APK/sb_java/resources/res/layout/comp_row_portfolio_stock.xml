<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_trading_portfolio_row_item"
    android:tag="layout/comp_row_portfolio_stock_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:paddingTop="@dimen/spacing_12"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="@dimen/clickable_size_76">
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/tv_trading_portfolio_row_symbol"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="18dp"
        android:paddingEnd="@dimen/spacing_2"
        android:layout_marginStart="@dimen/spacing_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingSmall"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_trading_portfolio_row_notation_company"
        android:visibility="gone"
        android:layout_width="@dimen/width_12"
        android:layout_height="@dimen/height_12"
        android:scaleType="fitXY"
        android:layout_marginStart="2dp"
        android:layout_toEndOf="@+id/tv_trading_portfolio_row_symbol"
        app:layout_constraintBottom_toBottomOf="@+id/tv_trading_portfolio_row_symbol"
        app:layout_constraintStart_toEndOf="@+id/tv_trading_portfolio_row_symbol"
        app:layout_constraintTop_toTopOf="@+id/tv_trading_portfolio_row_symbol"
        app:layout_constraintVertical_bias="0.5"
        app:srcCompat="@drawable/ic_notasi_khusus"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rv_horizontal_notation"
        android:visibility="gone"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/width_12"
        android:minHeight="@dimen/height_16"
        android:layout_alignParentTop="true"
        android:layout_marginStart="2dp"
        android:layout_toEndOf="@+id/iv_trading_portfolio_row_notation_company"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="@+id/tv_trading_portfolio_row_symbol"
        app:layout_constraintStart_toEndOf="@+id/iv_trading_portfolio_row_notation_company"
        app:layout_constraintTop_toTopOf="@+id/tv_trading_portfolio_row_symbol"
        app:spanCount="1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_trading_portfolio_row_corporate_action"
        android:visibility="gone"
        android:layout_width="@dimen/width_12"
        android:layout_height="@dimen/width_12"
        android:minHeight="@dimen/height_16"
        android:layout_alignParentTop="true"
        android:contentDescription="@string/SHARED_7"
        android:layout_marginStart="2dp"
        android:layout_toEndOf="@+id/rv_horizontal_notation"
        app:layout_constraintBottom_toBottomOf="@+id/tv_trading_portfolio_row_symbol"
        app:layout_constraintStart_toEndOf="@+id/rv_horizontal_notation"
        app:layout_constraintTop_toTopOf="@+id/tv_trading_portfolio_row_symbol"
        app:srcCompat="@drawable/ic_corporate_action"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_trading_portfolio_row_non_sharia"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:contentDescription="@string/SHARED_6"
        android:layout_marginStart="2dp"
        android:layout_toEndOf="@+id/iv_trading_portfolio_row_corporate_action"
        app:layout_constraintBottom_toBottomOf="@+id/tv_trading_portfolio_row_symbol"
        app:layout_constraintStart_toEndOf="@+id/iv_trading_portfolio_row_corporate_action"
        app:layout_constraintTop_toTopOf="@+id/tv_trading_portfolio_row_symbol"
        app:layout_goneMarginStart="2dp"
        app:srcCompat="?attr/themeIconNonSharia"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_company_delisted"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:contentDescription="@string/SHARED_7"
        android:layout_marginStart="@dimen/spacing_2"
        app:layout_constraintBottom_toBottomOf="@+id/tv_trading_portfolio_row_symbol"
        app:layout_constraintStart_toEndOf="@+id/iv_trading_portfolio_row_non_sharia"
        app:layout_constraintTop_toTopOf="@+id/tv_trading_portfolio_row_symbol"
        app:srcCompat="@drawable/ic_portfolio_company_delisted_info"/>
    <RelativeLayout
        android:id="@+id/rl_trading_portfolio_row_balance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="33dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_20"
        app:layout_constraintEnd_toStartOf="@+id/rl_trading_portfolio_row_inves"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_trading_portfolio_row_symbol">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center_vertical"
            android:id="@+id/tv_trading_portfolio_row_invested"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="18dp"
            android:layout_alignParentLeft="true"
            style="@style/TypeStyles.BodySmall"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="15dp"
            android:text="@string/lbl_portfolio_invested"
            android:layout_below="@+id/tv_trading_portfolio_row_invested"
            android:layout_alignParentLeft="true"
            style="@style/TypeStyles.BodyXXSmall"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_trading_portfolio_row_inves"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="33dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="@+id/rl_trading_portfolio_row_balance"
        app:layout_constraintEnd_toStartOf="@+id/rl_trading_portfolio_row_profit"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/rl_trading_portfolio_row_balance"
        app:layout_constraintTop_toTopOf="@+id/rl_trading_portfolio_row_balance">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/tv_trading_portfolio_row_pnl"
            android:tag="binding_3"
            android:paddingTop="@dimen/spacing_2"
            android:paddingBottom="@dimen/spacing_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="18dp"
            android:layout_centerHorizontal="true"
            style="@style/TypeStyles.BodySmall"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="top|center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="15dp"
            android:text="@string/lbl_title_pl"
            android:layout_below="@+id/tv_trading_portfolio_row_pnl"
            android:layout_centerHorizontal="true"
            style="@style/TypeStyles.BodyXXSmall"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_trading_portfolio_row_profit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="33dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="@+id/rl_trading_portfolio_row_balance"
        app:layout_constraintEnd_toStartOf="@+id/iv_trading_portfolio_row_chevron_right"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/rl_trading_portfolio_row_inves"
        app:layout_constraintTop_toTopOf="@+id/rl_trading_portfolio_row_balance">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="end"
            android:id="@+id/tv_trading_portfolio_row_gain"
            android:tag="binding_4"
            android:paddingTop="@dimen/spacing_2"
            android:paddingBottom="@dimen/spacing_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="18dp"
            android:layout_alignLeft="@+id/tv_trading_portfolio_row_gain_title"
            android:layout_alignRight="@+id/tv_trading_portfolio_row_gain_title"
            style="@style/TypeStyles.BodySmall"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="end|top"
            android:id="@+id/tv_trading_portfolio_row_gain_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="15dp"
            android:layout_below="@+id/tv_trading_portfolio_row_gain"
            style="@style/TypeStyles.BodyXXSmall"/>
    </RelativeLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_trading_portfolio_row_chevron_right"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/icon_placeholder_16"
        android:scaleType="centerInside"
        android:layout_marginStart="@dimen/spacing_20"
        android:layout_marginEnd="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="@+id/rl_trading_portfolio_row_balance"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/rl_trading_portfolio_row_profit"
        app:layout_constraintTop_toTopOf="@+id/rl_trading_portfolio_row_balance"
        app:srcCompat="@drawable/ic_chevron_right_grey"
        app:tint="?attr/themeIconTintColorLow"/>
</androidx.constraintlayout.widget.ConstraintLayout>
