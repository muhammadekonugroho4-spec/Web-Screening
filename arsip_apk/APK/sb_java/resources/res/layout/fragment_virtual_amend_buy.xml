<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_virtual_amend_buy_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarTradingBuy"
        android:paddingLeft="@dimen/item_gap_null"
        android:paddingRight="@dimen/item_gap_null"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:contentInsetLeft="@dimen/item_gap_null"
        app:contentInsetStart="@dimen/item_gap_null"
        app:contentInsetStartWithNavigation="@dimen/item_gap_null"
        app:elevation="@dimen/item_gap_null">
        <RelativeLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minHeight="?attr/actionBarSize">
            <TextView
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/tvToolbarTitleTradingBuy"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/trading_buy_title"
                android:singleLine="true"
                android:layout_centerHorizontal="true"
                android:textAlignment="gravity"
                style="@style/SbTextView.PageTitle"/>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <View
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"/>
    <ViewFlipper
        android:id="@+id/vfFragmentTradingBuy"
        android:tag="binding_1"
        android:background="?attr/themeContentBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/sflTradingBuyLoading"
            android:paddingTop="@dimen/item_gap_m"
            android:paddingBottom="@dimen/item_gap_l"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include layout="@layout/skeleton_virtual_item_buy"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/nsvLayoutView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:layout_above="@+id/llButtonLayout"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.stockbit.common.uikit.StockbitCompanyPrice
                        android:id="@+id/llCompanyInfoLayout"
                        android:tag="binding_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <RelativeLayout
                        android:id="@+id/parentTradingNotEnough"
                        android:background="@drawable/border_gray"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/item_gap_l"
                        android:layout_marginRight="@dimen/item_gap_l"
                        android:layout_marginBottom="@dimen/item_gap_s"
                        android:layout_below="@+id/llCompanyInfoLayout">
                        <ImageView
                            android:id="@+id/ivNotEnoughIcon"
                            android:paddingTop="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            app:srcCompat="@drawable/ic_info"/>
                        <TextView
                            android:gravity="center"
                            android:id="@+id/tvTradingNotEnough"
                            android:padding="@dimen/item_gap_s"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/balance_not_enough"
                            android:layout_below="@+id/ivNotEnoughIcon"
                            android:textAlignment="gravity"
                            style="@style/SbTextView.BodyDefault"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/rlTradeBuyLayout"
                        android:background="@drawable/border_gray"
                        android:paddingTop="@dimen/item_gap_s"
                        android:paddingBottom="@dimen/item_gap_s"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/parentTradingNotEnough"
                        android:layout_marginStart="@dimen/item_gap_l"
                        android:layout_marginEnd="@dimen/item_gap_l">
                        <TextView
                            android:gravity="right"
                            android:id="@+id/tvTotalBalance"
                            android:paddingLeft="@dimen/item_gap_s"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:hint="@string/n_dash"
                            android:maxLines="1"
                            android:layout_toRightOf="@+id/rlTradingBalance"
                            android:layout_alignParentRight="true"
                            android:textAlignment="gravity"
                            android:layout_marginEnd="@dimen/item_gap_l"
                            style="@style/SbTextView.ListTitle"/>
                        <RelativeLayout
                            android:orientation="horizontal"
                            android:id="@+id/rlTradingBalance"
                            android:background="?attr/selectableItemBackground"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/item_gap_l"
                            android:layout_marginRight="@dimen/item_gap_l"
                            android:layout_marginStart="@dimen/item_gap_l"
                            android:layout_marginEnd="@dimen/item_gap_l">
                            <TextView
                                android:gravity="start|center_vertical"
                                android:id="@+id/tvTitleTradingBalance"
                                android:paddingTop="@dimen/item_gap_m"
                                android:paddingBottom="@dimen/item_gap_m"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/buy_title_trading_balance"
                                android:layout_centerVertical="true"
                                android:textAlignment="gravity"
                                style="@style/SbTextView.ListSubtitle"/>
                        </RelativeLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/rlAmountLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/item_gap_l"
                            android:layout_marginRight="@dimen/item_gap_l"
                            android:layout_below="@+id/rlTradingBalance">
                            <TextView
                                android:id="@+id/tvTitleAmount"
                                android:paddingTop="@dimen/item_gap_m"
                                android:paddingBottom="@dimen/item_gap_m"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/buy_title_amount"
                                android:layout_weight="1"
                                style="@style/SbTextView.ListSubtitle"/>
                            <EditText
                                android:gravity="end|center_vertical"
                                android:id="@+id/etTotalAmount"
                                android:background="@null"
                                android:focusable="false"
                                android:clickable="false"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:hint="@string/n_dash"
                                android:cursorVisible="false"
                                android:digits="0123456789.,"
                                android:layout_weight="0.5"
                                android:inputType="numberDecimal"
                                android:imeOptions="actionNone"
                                android:textAlignment="gravity"
                                style="@style/SbTextView.ListSubtitle"/>
                        </LinearLayout>
                        <RelativeLayout
                            android:id="@+id/rlPriceLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/item_gap_l"
                            android:layout_below="@+id/rlAmountLayout">
                            <TextView
                                android:id="@+id/tvTitlePrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/buy_title_limit_price"
                                android:layout_centerVertical="true"
                                style="@style/SbTextView.ListSubtitle"/>
                            <RelativeLayout
                                android:orientation="horizontal"
                                android:background="?attr/themeContentBackground"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/height_28"
                                android:layout_centerInParent="true"
                                android:layout_toEndOf="@+id/tvTitlePrice">
                                <Button
                                    android:textSize="@dimen/text_size_18"
                                    android:textStyle="normal"
                                    android:id="@+id/btnMinPrice"
                                    android:background="@drawable/border_gray_rounded_white_bg"
                                    android:padding="0dp"
                                    android:layout_width="@dimen/width_28"
                                    android:layout_height="@dimen/height_28"
                                    android:text="@string/n_dash"
                                    android:layout_toStartOf="@+id/etTotalPrice"
                                    style="@style/SbTextView.ListTitle"/>
                                <EditText
                                    android:gravity="center"
                                    android:id="@+id/etTotalPrice"
                                    android:background="@null"
                                    android:layout_width="@dimen/width_113"
                                    android:layout_height="match_parent"
                                    android:minWidth="@dimen/buy_min_width_btn"
                                    android:hint="@string/n_dash"
                                    android:maxLines="1"
                                    android:selectAllOnFocus="true"
                                    android:digits="0123456789"
                                    android:inputType="numberDecimal"
                                    android:imeOptions="actionNext"
                                    android:layout_toStartOf="@+id/btnPlusPrice"
                                    style="@style/SbTextView.ListSubtitle"/>
                                <Button
                                    android:textSize="@dimen/text_size_18"
                                    android:textStyle="normal"
                                    android:id="@+id/btnPlusPrice"
                                    android:background="@drawable/border_gray_rounded_white_bg"
                                    android:padding="0dp"
                                    android:layout_width="@dimen/width_28"
                                    android:layout_height="@dimen/height_28"
                                    android:text="@string/n_plus"
                                    android:layout_alignParentEnd="true"
                                    style="@style/SbTextView.ListTitle"/>
                            </RelativeLayout>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/rlLotLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/item_gap_l"
                            android:layout_below="@+id/rlPriceLayout"
                            android:layout_marginHorizontal="@dimen/item_gap_l">
                            <TextView
                                android:id="@+id/tvTitleLot"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/buy_title_lot"
                                android:layout_centerVertical="true"
                                style="@style/SbTextView.ListSubtitle"/>
                            <RelativeLayout
                                android:orientation="horizontal"
                                android:id="@+id/rlOrderLot"
                                android:background="?attr/themeContentBackground"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/height_28"
                                android:layout_centerInParent="true"
                                android:layout_toEndOf="@+id/tvTitleLot">
                                <Button
                                    android:textSize="@dimen/text_size_18"
                                    android:textStyle="normal"
                                    android:id="@+id/btnMinLot"
                                    android:background="@drawable/border_gray_rounded_white_bg"
                                    android:padding="0dp"
                                    android:layout_width="@dimen/width_28"
                                    android:layout_height="@dimen/height_28"
                                    android:text="@string/n_dash"
                                    android:layout_toStartOf="@+id/etTotalLot"
                                    style="@style/SbTextView.ListTitle"/>
                                <EditText
                                    android:gravity="center"
                                    android:id="@+id/etTotalLot"
                                    android:background="@null"
                                    android:layout_width="@dimen/width_113"
                                    android:layout_height="match_parent"
                                    android:minWidth="@dimen/buy_min_width_btn"
                                    android:hint="@string/n_dash"
                                    android:maxLines="1"
                                    android:selectAllOnFocus="true"
                                    android:digits="0123456789"
                                    android:inputType="numberDecimal"
                                    android:imeOptions="actionDone"
                                    android:layout_toStartOf="@+id/btnPlusLot"
                                    style="@style/SbTextView.ListSubtitle"/>
                                <Button
                                    android:textSize="@dimen/text_size_18"
                                    android:textStyle="normal"
                                    android:id="@+id/btnPlusLot"
                                    android:background="@drawable/border_gray_rounded_white_bg"
                                    android:padding="0dp"
                                    android:layout_width="@dimen/width_28"
                                    android:layout_height="@dimen/height_28"
                                    android:text="@string/n_plus"
                                    android:layout_alignParentEnd="true"
                                    style="@style/SbTextView.ListTitle"/>
                            </RelativeLayout>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/rlExpiryLayout"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/item_gap_l"
                            android:layout_marginRight="@dimen/item_gap_l"
                            android:layout_below="@+id/rlLotLayout"
                            android:layout_marginStart="@dimen/item_gap_l"
                            android:layout_marginEnd="@dimen/item_gap_l">
                            <TextView
                                android:id="@+id/tvTitleExpiry"
                                android:paddingTop="@dimen/item_gap_m"
                                android:paddingBottom="@dimen/item_gap_m"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/buy_title_expiry"
                                style="@style/SbTextView.ListSubtitle"/>
                            <TextView
                                android:gravity="end"
                                android:id="@+id/tvExpiry"
                                android:paddingTop="@dimen/item_gap_m"
                                android:paddingBottom="@dimen/item_gap_m"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/n_dash"
                                android:textAlignment="gravity"
                                android:layout_marginStart="@dimen/item_gap_l"
                                android:layout_toEndOf="@+id/tvTitleExpiry"
                                android:layout_alignParentEnd="true"
                                style="@style/SbTextView.BodyDefault"/>
                        </RelativeLayout>
                    </RelativeLayout>
                    <com.stockbit.common.uikit.StockbitCompanyOrderbook
                        android:id="@+id/llCompanyOrderBookInfoLayout"
                        android:tag="binding_4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/rlTradeBuyLayout"/>
                </RelativeLayout>
            </androidx.core.widget.NestedScrollView>
            <LinearLayout
                android:id="@+id/llButtonLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true">
                <Button
                    android:textColor="@color/white"
                    android:id="@+id/btnSwitchToReal"
                    android:background="@color/background_blue_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="@string/maintab_switch_to_real"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/item_gap_xxxs"
                    style="@style/SbTextView.ListTitle"/>
                <Button
                    android:textColor="@color/white"
                    android:id="@+id/btnOrder"
                    android:background="@color/buy_btn_order"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="@string/orderlist_detail_title_ammend"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/item_gap_xxxs"
                    style="@style/SbTextView.ListTitle"/>
            </LinearLayout>
        </RelativeLayout>
        <include
            android:layout_gravity="center"
            android:id="@+id/parentErrorTradingBuy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/comp_icon_error_view"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsvFragmentTradingBuy"
            android:tag="binding_5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <include layout="@layout/comp_empty_data_virtual_buy"/>
        </androidx.core.widget.NestedScrollView>
    </ViewFlipper>
</androidx.appcompat.widget.LinearLayoutCompat>
