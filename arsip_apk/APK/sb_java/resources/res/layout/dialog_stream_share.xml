<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_parent_stream_share"
    android:tag="layout/dialog_stream_share_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <ScrollView
        android:id="@+id/sv_share_stream_preview"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_1">
        <include
            android:id="@+id/layout_share_stream"
            android:visibility="gone"
            layout="@layout/comp_stream_shared_item"/>
    </ScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_share_post_header"
        android:background="@drawable/bg_top_rounded"
        android:paddingBottom="@dimen/spacing_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/v_share_post"
            android:background="@drawable/bg_rounded_gray_gray_bg"
            android:layout_width="@dimen/width_64"
            android:layout_height="@dimen/item_gap_3"
            android:layout_marginTop="@dimen/spacing_6"
            android:layout_centerHorizontal="true"
            android:alpha="0.5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tv_share_post_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:text="@string/title_share_post"
            app:layout_constraintEnd_toEndOf="@+id/v_share_post"
            app:layout_constraintStart_toStartOf="@+id/v_share_post"
            app:layout_constraintTop_toBottomOf="@+id/v_share_post"
            style="@style/TypeStyles.HeadingRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_send_to_stream_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_share_post_send_to"
            android:layout_marginStart="@dimen/spacing_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingRegular"/> app:layout_constraintTop_toTopOf=&quot;parent&quot; /&gt; 
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_share_friends_stream_share"
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_send_to_stream_share">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/rv_share_post_people"
            android:tag="binding_2"
            android:paddingBottom="@dimen/spacing_20"
            android:clipToPadding="false"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/spacing_12"
            android:paddingStart="@dimen/spacing_4"
            android:paddingEnd="@dimen/spacing_20"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:tag="binding_3"
            android:paddingBottom="@dimen/spacing_20"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:paddingStart="@dimen/spacing_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:tag="binding_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <include layout="@layout/skeleton_user_to_share"/>
                <include layout="@layout/skeleton_user_to_share"/>
                <include layout="@layout/skeleton_user_to_share"/>
                <include layout="@layout/skeleton_user_to_share"/>
                <include layout="@layout/skeleton_user_to_share"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <View
            android:id="@+id/v_sep_share_post_main_button"
            android:tag="binding_5"
            android:background="?attr/themeContentButtonBorder"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="@dimen/height_1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rv_share_post_people"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_share_other"
        android:tag="binding_6"
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_share_friends_stream_share">
        <TextView
            android:id="@+id/tv_share_to_stream_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:text="@string/text_share_to"
            android:layout_marginStart="@dimen/spacing_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingRegular"/>
        <HorizontalScrollView
            android:id="@+id/hsv_share_to"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:paddingStart="@dimen/spacing_20"
            android:paddingEnd="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_share_to_stream_share">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_container_share_to"
                    android:tag="binding_7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:contentDescription="share_view_stream_share">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_share_via_stream_share"
                        android:background="@drawable/bg_circle_border"
                        android:layout_width="@dimen/width_50"
                        android:layout_height="@dimen/height_50"
                        android:foreground="?attr/selectableItemBackground"
                        android:scaleType="centerInside"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_share_light_stroke_black_24dp"
                        app:tint="@color/green_text"/>
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_5"
                        android:text="@string/icon_share_via_title"
                        app:layout_constraintEnd_toEndOf="@+id/iv_share_via_stream_share"
                        app:layout_constraintStart_toStartOf="@+id/iv_share_via_stream_share"
                        app:layout_constraintTop_toBottomOf="@+id/iv_share_via_stream_share"
                        style="@style/TypeStyles.BodyXSmall"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_container_ig_story"
                    android:tag="binding_8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginStart="@dimen/spacing_20">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_share_ig_story_stream_share"
                        android:background="@drawable/bg_circle_border"
                        android:layout_width="@dimen/width_50"
                        android:layout_height="@dimen/height_50"
                        android:foreground="?attr/selectableItemBackground"
                        android:scaleType="centerInside"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_ig_story"/>
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_5"
                        android:text="@string/title_ig_story"
                        app:layout_constraintEnd_toEndOf="@+id/iv_share_ig_story_stream_share"
                        app:layout_constraintStart_toStartOf="@+id/iv_share_ig_story_stream_share"
                        app:layout_constraintTop_toBottomOf="@+id/iv_share_ig_story_stream_share"
                        style="@style/TypeStyles.BodyXSmall"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_container_whatsapp"
                    android:tag="binding_9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginStart="@dimen/spacing_20">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_share_whatsapp_stream_share"
                        android:background="@drawable/bg_circle_border"
                        android:layout_width="@dimen/width_50"
                        android:layout_height="@dimen/height_50"
                        android:foreground="?attr/selectableItemBackground"
                        android:scaleType="centerInside"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_whatsapp"/>
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_5"
                        android:text="@string/icon_share_whatsapp_title"
                        app:layout_constraintEnd_toEndOf="@+id/iv_share_whatsapp_stream_share"
                        app:layout_constraintStart_toStartOf="@+id/iv_share_whatsapp_stream_share"
                        app:layout_constraintTop_toBottomOf="@+id/iv_share_whatsapp_stream_share"
                        style="@style/TypeStyles.BodyXSmall"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_container_telegram"
                    android:tag="binding_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginStart="@dimen/spacing_20">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_share_telegram_stream_share"
                        android:background="@drawable/bg_circle_border"
                        android:layout_width="@dimen/width_50"
                        android:layout_height="@dimen/height_50"
                        android:foreground="?attr/selectableItemBackground"
                        android:scaleType="centerInside"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_telegram"/>
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_5"
                        android:text="@string/icon_share_telegram_title"
                        app:layout_constraintEnd_toEndOf="@+id/iv_share_telegram_stream_share"
                        app:layout_constraintStart_toStartOf="@+id/iv_share_telegram_stream_share"
                        app:layout_constraintTop_toBottomOf="@+id/iv_share_telegram_stream_share"
                        style="@style/TypeStyles.BodyXSmall"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_container_twitter"
                    android:tag="binding_11"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginStart="@dimen/spacing_20">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_share_twitter_stream_share"
                        android:background="@drawable/bg_circle_border"
                        android:layout_width="@dimen/width_50"
                        android:layout_height="@dimen/height_50"
                        android:foreground="?attr/selectableItemBackground"
                        android:scaleType="centerInside"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_twitter"/>
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_5"
                        android:text="@string/icon_share_twitter_title"
                        app:layout_constraintEnd_toEndOf="@+id/iv_share_twitter_stream_share"
                        app:layout_constraintStart_toStartOf="@+id/iv_share_twitter_stream_share"
                        app:layout_constraintTop_toBottomOf="@+id/iv_share_twitter_stream_share"
                        style="@style/TypeStyles.BodyXSmall"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_container_message"
                    android:tag="binding_12"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginHorizontal="@dimen/spacing_20">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_share_messages_stream_share"
                        android:background="@drawable/bg_circle_border"
                        android:layout_width="@dimen/width_50"
                        android:layout_height="@dimen/height_50"
                        android:foreground="?attr/selectableItemBackground"
                        android:scaleType="centerInside"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_messages"/>
                    <TextView
                        android:textSize="@dimen/text_size_10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_5"
                        android:text="@string/icon_share_messages_title"
                        app:layout_constraintEnd_toEndOf="@+id/iv_share_messages_stream_share"
                        app:layout_constraintStart_toStartOf="@+id/iv_share_messages_stream_share"
                        app:layout_constraintTop_toBottomOf="@+id/iv_share_messages_stream_share"
                        style="@style/TypeStyles.BodyXSmall"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </HorizontalScrollView>
        <View
            android:id="@+id/v_separator_share_to"
            android:background="?attr/themeContentButtonBorder"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="@dimen/height_1"
            android:layout_marginTop="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hsv_share_to"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_copy_link"
            android:tag="binding_13"
            android:background="@drawable/bg_share_button_box"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginStart="@dimen/spacing_20"
            android:layout_marginEnd="@dimen/spacing_16"
            android:layout_marginVertical="@dimen/spacing_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cl_repost"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_separator_share_to">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_copy_stream_share"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/spacing_8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_copy_stream_share"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_link"/>
                <TextView
                    android:id="@+id/tv_copy_stream_share"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/button_copy_link"
                    android:layout_marginStart="@dimen/spacing_8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_copy_stream_share"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TypeStyles.HeadingRegular"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_repost"
            android:tag="binding_14"
            android:background="@drawable/bg_share_button_box"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_marginEnd="@dimen/spacing_20"
            android:layout_marginVertical="@dimen/spacing_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cl_copy_link"
            app:layout_constraintTop_toBottomOf="@+id/v_separator_share_to">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_repost_stream_share"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/spacing_8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_repost_stream_share"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_repost"/>
                <TextView
                    android:id="@+id/tv_repost_stream_share"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/button_repost"
                    android:layout_marginStart="@dimen/spacing_8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_repost_stream_share"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TypeStyles.HeadingRegular"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_compose"
        android:tag="binding_15"
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:id="@+id/v_sep_share_post_footer"
            android:background="?attr/themeContentButtonBorder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_1"
            android:layout_marginBottom="@dimen/spacing_16"
            app:layout_constraintBottom_toTopOf="@+id/et_share_post_write_comment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <EditText
            android:gravity="center_vertical"
            android:id="@+id/et_share_post_write_comment"
            android:tag="binding_16"
            android:background="@drawable/bg_rounded_edit_text"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_16"
            android:minHeight="@dimen/avatar_size_default"
            android:hint="@string/hint_share_stream_post_message"
            android:maxLines="7"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionDone"
            android:layout_marginStart="@dimen/spacing_20"
            android:layout_marginEnd="@dimen/spacing_16"
            android:backgroundTint="@null"
            android:paddingHorizontal="@dimen/spacing_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_send_stream_share"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/SbEditTextStyle.Medium"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_send_stream_share"
            android:tag="binding_17"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintBottom_toBottomOf="@+id/et_share_post_write_comment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/et_share_post_write_comment"
            app:srcCompat="@drawable/ic_send_plane"/>
        <ProgressBar
            android:id="@+id/pb_send_loading"
            android:visibility="gone"
            android:layout_width="@dimen/spacing_24"
            android:layout_height="@dimen/spacing_24"
            android:layout_marginEnd="@dimen/spacing_24"
            app:layout_constraintBottom_toBottomOf="@+id/et_share_post_write_comment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/et_share_post_write_comment"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
