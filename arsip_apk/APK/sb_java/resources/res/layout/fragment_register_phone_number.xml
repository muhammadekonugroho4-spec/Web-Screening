<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_register_phone_number_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="800dp">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:layout_weight="4">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">
                <ImageView
                    android:id="@+id/iv_phone_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_36"
                    android:layout_marginHorizontal="@dimen/spacing_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="?attr/imgRegisterPhoneNumber"/>
                <TextView
                    android:textSize="@dimen/text_size_18"
                    android:textColor="?attr/themeContentTextColor"
                    android:id="@+id/tv_register_phone_number_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_20"
                    android:layout_marginBottom="@dimen/spacing_8"
                    android:text="@string/title_verification_phone_number"
                    android:layout_marginHorizontal="@dimen/spacing_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_phone_icon"
                    style="@style/TypeStyles.HeadlineRegular"/>
                <com.stockbit.uikit.input.InputPhoneLine
                    android:id="@+id/input_phone_line"
                    android:tag="binding_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:layout_marginHorizontal="@dimen/spacing_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_register_phone_number_title"
                    app:phoneHint="@string/placeholder_verification_phone_number"/>
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/cb_user"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/spacing_16"
                    android:checked="false"
                    android:text="@string/not_human_question"
                    android:paddingStart="0dp"
                    android:buttonTint="?attr/themeIconTintColor"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/input_phone_line"
                    app:layout_constraintVertical_bias="0"
                    style="@style/SbTextView.BodyDefault"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
        <com.stockbit.uikit.buttons.StickyButton
            android:id="@+id/sb_register_phone_number"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_btn_continue"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
