<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/comp_forced_sell_banner_0"
    android:background="@drawable/bg_forced_sell_banner"
    android:padding="@dimen/spacing_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center"
        android:id="@+id/tv_message_forced_sell_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/orderlist_detail_title_forced_sell"
        android:drawablePadding="@dimen/spacing_4"
        app:drawableStartCompat="@drawable/ic_caution_triangle"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:gravity="start|center_vertical"
        android:id="@+id/tv_message_forced_sell"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        style="@style/TypeStyles.BodySmall"/>
</LinearLayout>
