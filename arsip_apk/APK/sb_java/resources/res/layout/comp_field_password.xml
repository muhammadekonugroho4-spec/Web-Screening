<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_field_password_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center_horizontal"
        android:id="@+id/actv_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingXSmall"/>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-3dp"
        app:errorEnabled="true"
        app:errorTextAppearance="@style/SbTextView.InputError"
        app:hintEnabled="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actv_label"
        app:passwordToggleEnabled="true"
        style="@style/Sb.Widget.InputText">
        <com.google.android.material.textfield.TextInputEditText
            android:textColor="?attr/themeContentTextColor"
            android:id="@+id/tiet_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/setting_change_password_app_enter_new_pass"
            android:inputType="textPassword"
            style="@style/SbEditTextStyle"/>
    </com.google.android.material.textfield.TextInputLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
