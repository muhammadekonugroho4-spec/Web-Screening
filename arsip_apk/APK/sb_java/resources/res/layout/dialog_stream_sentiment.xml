<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_stream_sentiment_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/parentBaseBottomSheetDialogHeader"
        android:background="@drawable/bg_top_rounded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/item_gap_l">
        <View
            android:id="@+id/viewSharePost"
            android:background="@drawable/bg_rounded_gray_gray_bg"
            android:layout_width="@dimen/clickable_size_64"
            android:layout_height="@dimen/item_gap_xs"
            android:layout_marginTop="@dimen/item_gap_s"
            android:layout_centerHorizontal="true"
            android:alpha="0.5"/>
        <TextView
            android:id="@+id/tvSharePostTitle"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_share_post"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            style="@style/SbTextView.TitleSmall"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/parentBaseBottomSheetDialogHeader"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
        <TextView
            android:layout_gravity="center"
            android:id="@+id/tvSentimentDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/item_gap_l"
            android:text="@string/sentiment_dialog_title"
            style="@style/SbTextView.PageTitle"/>
        <TextView
            android:id="@+id/tvSentimentDialogDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sentiment_dialog_desc"
            android:textAlignment="center"
            android:layout_marginStart="@dimen/item_gap_l"
            android:layout_marginEnd="@dimen/item_gap_l"
            style="@style/SbTextView.BodyDefault"/>
        <View
            android:id="@+id/viewSentimentSeparator"
            android:background="?attr/titleTextColorMidgray"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_margin="@dimen/item_gap_l"/>
        <TextView
            android:textColor="?attr/titleTextColorMidgray"
            android:id="@+id/tvSentimentDialogTerm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/item_gap_l"
            android:text="@string/sentiment_dialog_terms"
            android:textAlignment="center"
            android:layout_marginStart="@dimen/item_gap_l"
            android:layout_marginEnd="@dimen/item_gap_l"
            style="@style/SbTextView.BodyDefault"/>
    </LinearLayout>
</RelativeLayout>
