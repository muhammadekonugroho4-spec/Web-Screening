<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/skeleton_unboxing_banner_section_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/item_gap_20"
    android:paddingVertical="@dimen/item_gap_20">
    <View
        android:id="@+id/v_header"
        android:tag="binding_1"
        android:background="@drawable/bg_skeleton_gray"
        android:visibility="gone"
        android:layout_width="@dimen/clickable_size_48"
        android:layout_height="@dimen/clickable_size_12"
        android:layout_marginBottom="@dimen/item_gap_24"
        app:layout_constraintBottom_toTopOf="@+id/include"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <include
        android:id="@+id/include"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/v_footer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_header"
        layout="@layout/skeleton_unboxing_banner"/>
    <View
        android:id="@+id/v_footer"
        android:tag="binding_2"
        android:background="@drawable/bg_skeleton_gray"
        android:visibility="gone"
        android:layout_width="@dimen/clickable_size_48"
        android:layout_height="@dimen/clickable_size_12"
        android:layout_marginTop="@dimen/item_gap_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/include"/>
</androidx.constraintlayout.widget.ConstraintLayout>
