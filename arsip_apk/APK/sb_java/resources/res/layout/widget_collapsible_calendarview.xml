<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/layout_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/layout_btn_group_month"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/btn_prev_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/calendar_button_margin_bottom"
            android:layout_alignParentStart="true"
            app:srcCompat="0x7f080d22"/>
        <ImageView
            android:id="@+id/btn_next_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/calendar_button_margin_bottom"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            app:srcCompat="0x7f080daa"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/layout_btn_group_week"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/btn_prev_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/calendar_button_margin_bottom"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            app:srcCompat="0x7f080d22"/>
        <ImageView
            android:id="@+id/btn_next_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/calendar_button_margin_bottom"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"
            app:srcCompat="0x7f080daa"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/cl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/calendar_title_margin_top"
        android:layout_marginBottom="@dimen/calendar_title_margin_bottom">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/today_icon"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/calendar_today_icon_width"
            android:layout_height="@dimen/calendar_today_icon_height"
            android:foreground="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_calendar_low_green"
            android:layout_marginEnd="@dimen/today_icon_margin_end"/>
        <TextView
            android:textSize="@dimen/calendar_title_text_size"
            android:textColor="@color/green_text"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/txt_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SbTextView.ListTitle.Highempasis.Bold"/>
        <com.stockbit.component.calendar.view.ExpandIconView
            android:layout_gravity="center"
            android:id="@+id/expand_icon"
            android:visibility="gone"
            android:layout_width="@dimen/expand_icon_width"
            android:layout_height="@dimen/expand_icon_height"
            app:eiv_animationDuration="@integer/animation_duration"
            app:eiv_color="@color/expand_icon_color"
            app:eiv_colorIntermediate="@android:color/black"
            app:eiv_colorLess="@android:color/black"
            app:eiv_colorMore="@android:color/black"
            app:eiv_roundedCorners="true"
            app:eiv_switchColor="true"/>
    </LinearLayout>
    <TableLayout
        android:id="@+id/table_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.stockbit.component.calendar.view.LockScrollView
        android:id="@+id/scroll_view_body"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TableLayout
            android:id="@+id/table_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:isScrollContainer="true"/>
    </com.stockbit.component.calendar.view.LockScrollView>
</LinearLayout>
