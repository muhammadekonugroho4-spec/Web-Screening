<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentLayout"
    android:background="@color/kyc_plus_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:background="@android:color/transparent"
        android:animationCache="false"
        android:layout_width="@dimen/kyc_sdk_0dp"
        android:layout_height="?attr/actionBarSize"
        android:animateLayoutChanges="true"
        android:elevation="@dimen/kyc_sdk_1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.iab.digitalidentity.ui.button.KycPlusButton
            android:layout_gravity="right"
            android:id="@+id/btnDebug"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/kyc_sdk_16dp"
            app:kyc_plus_btn_type="kyc_plus_primary_static_white_tiny"
            app:kyc_plus_text="Debug"/>
        <com.iab.digitalidentity.ui.text.KycPlusTextView
            android:layout_gravity="right"
            android:id="@+id/btnGuide"
            android:padding="@dimen/kyc_sdk_6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/kyc_sdk_4dp"
            android:layout_marginEnd="@dimen/kyc_sdk_16dp"
            app:kycPlusTypographyStyle="kyc_plus_title_tiny_demi_static_black"/>
    </androidx.appcompat.widget.Toolbar>
    <RelativeLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/selfieCameraContainer"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/selfieCameraLoc"
                android:layout_width="match_parent"
                android:layout_height="547dp">
                <RelativeLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/selfieCameraSize"
                    android:background="#000000"
                    android:layout_width="240dp"
                    android:layout_height="320dp">
                    <FrameLayout
                        android:id="@+id/selfieCameraPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </RelativeLayout>
            </RelativeLayout>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/selfieMaskLayout"
                android:layout_width="375dp"
                android:layout_height="667dp">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/auroraBackground"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/kyc_plus_aurora_background"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/auroraContour"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/kyc_plus_aurora_contour"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/auroraDottedContour"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/kyc_plus_aurora_dotted_contour"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:gravity="center"
                    android:id="@+id/auroraOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:srcCompat="@drawable/kyc_plus_aurora_overlay"/>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="top"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:gravity="bottom"
            android:orientation="vertical"
            android:id="@+id/tvTitleLocationBottom"
            android:layout_width="match_parent"
            android:layout_height="130dp">
            <RelativeLayout
                android:gravity="top|center_horizontal"
                android:orientation="vertical"
                android:id="@+id/tvTitleLocationTop"
                android:layout_width="match_parent"
                android:layout_height="90dp">
                <include
                    android:id="@+id/tvTitle"
                    layout="@layout/layout_fr_camera_feedback"/>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/fullScreenLoaderWhite"
        android:background="#ccffffff"
        android:visibility="gone"
        android:layout_width="@dimen/kyc_sdk_0dp"
        android:layout_height="@dimen/kyc_sdk_0dp"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/debugView"
        android:background="@color/kyc_plus_green"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
