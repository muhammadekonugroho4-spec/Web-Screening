<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:ellipsize="marquee"
        android:id="@+id/tv_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/three_grid_unit"
        android:layout_marginTop="@dimen/one_and_a_half_grid_unit"
        android:layout_marginBottom="@dimen/one_and_a_half_grid_unit"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/three_grid_unit"
        android:layout_alignParentStart="true"
        style="@style/SbTextView.BodyDefault"/>
    <View
        android:id="@+id/border"
        android:background="?attr/themeSeparatorGapColor"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxs"/>
</RelativeLayout>
