<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme"
    android:tag="layout/fragment_withdrawal_confirmation_foreign_0"
    android:background="@color/transparent"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/setting_activity_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:layout_scrollFlags="enterAlways|scroll">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_withdrawal"
            style="@style/TypeStyles.HeadingLarge"/>
    </androidx.appcompat.widget.Toolbar>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:layout_above="@+id/divider"
        android:layout_below="@+id/setting_activity_toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/item_gap_20">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_withdrawal_confirmation_foreign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/themeIconWithdrawConfirm"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_title_withdrawal_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/withdrawal_cash_success_title_amount"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_withdrawal_confirmation_foreign"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:textColor="?attr/themeColorTextGreen"
                android:gravity="center"
                android:id="@+id/tv_withdrawal_amount"
                android:tag="binding_1"
                android:paddingTop="@dimen/item_gap_8"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_withdrawal_amount"
                style="@style/TypeStyles.Nominal"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:id="@+id/tv_withdrawal_foreign_transfer_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_transfer_to_foreign"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_withdrawal_amount"
                style="@style/SbTextView.BodyDefault.Bold"/>
            <RelativeLayout
                android:id="@+id/rl_withdrawal_account_foreign"
                android:background="@drawable/bg_rounded_4_transparent_colormodal"
                android:padding="@dimen/item_gap_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_12"
                app:layout_constraintTop_toBottomOf="@+id/tv_withdrawal_foreign_transfer_title">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_rdn_bank"
                    android:tag="binding_2"
                    android:layout_width="@dimen/width_40"
                    android:layout_height="@dimen/height_40"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textColor="?attr/themeColorTextPrimary"
                    android:id="@+id/tv_rdn_bank_name"
                    android:tag="binding_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/item_gap_16"
                    android:layout_toEndOf="@+id/iv_rdn_bank"
                    style="@style/TypeStyles.BodyXSmall"/>
                <ImageView
                    android:id="@+id/tv_indicator_dot"
                    android:layout_width="@dimen/item_gap_10"
                    android:layout_height="@dimen/item_gap_10"
                    android:layout_alignTop="@+id/tv_rdn_bank_name"
                    android:layout_alignBottom="@+id/tv_rdn_bank_name"
                    android:layout_marginStart="@dimen/item_gap_4"
                    android:layout_toEndOf="@+id/tv_rdn_bank_name"
                    app:srcCompat="0x7f0803bc"
                    app:tint="?attr/themeColorTextPrimary"/>
                <TextView
                    android:textColor="?attr/themeColorTextPrimary"
                    android:id="@+id/tv_rdn_bank_country"
                    android:tag="binding_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/item_gap_4"
                    android:layout_toEndOf="@+id/tv_indicator_dot"
                    style="@style/TypeStyles.BodyXSmall"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:id="@+id/tv_rdn_number"
                    android:tag="binding_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_2"
                    android:layout_toRightOf="@+id/iv_rdn_bank"
                    android:layout_below="@+id/tv_rdn_bank_name"
                    android:layout_marginStart="@dimen/item_gap_16"
                    style="@style/TypeStyles.HeadingRegular"/>
                <TextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:id="@+id/tv_rdn_name"
                    android:tag="binding_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_2"
                    android:layout_below="@+id/tv_rdn_number"
                    android:layout_marginStart="@dimen/item_gap_16"
                    android:layout_marginEnd="@dimen/item_gap_16"
                    android:layout_toEndOf="@+id/iv_rdn_bank"
                    style="@style/TypeStyles.BodyXSmall"/>
            </RelativeLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/rl_withdrawal_currency"
                android:background="@drawable/bg_rounded_4_transparent_colorborder"
                android:padding="@dimen/item_gap_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                app:layout_constraintTop_toBottomOf="@+id/rl_withdrawal_account_foreign">
                <TextView
                    android:id="@+id/tv_title_destination_currency_confirmation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_title_option_currency_withdraw"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentStart="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TypeStyles.BodyRegular"/>
                <TextView
                    android:gravity="end"
                    android:id="@+id/tv_destination_currency_confirmation"
                    android:tag="binding_7"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/item_gap_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_title_destination_currency_confirmation"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TypeStyles.HeadingRegular"/>
                <TextView
                    android:id="@+id/tv_title_swift_code_confirmation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_16"
                    android:text="@string/deposit_swift_code_title"
                    android:layout_centerHorizontal="true"
                    android:layout_alignParentStart="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_destination_currency_confirmation"
                    style="@style/TypeStyles.BodyRegular"/>
                <TextView
                    android:gravity="end"
                    android:tag="binding_8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_16"
                    android:layout_marginStart="@dimen/item_gap_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_title_swift_code_confirmation"
                    app:layout_constraintTop_toBottomOf="@+id/tv_destination_currency_confirmation"
                    style="@style/TypeStyles.HeadingRegular"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rl_withdrawal_currency"/>
            <RelativeLayout
                android:background="?attr/themeTnc"
                android:paddingTop="@dimen/item_gap_12"
                android:paddingBottom="@dimen/item_gap_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_marginBottom="@dimen/spacing_24"
                android:paddingStart="@dimen/item_gap_16"
                android:paddingEnd="@dimen/item_gap_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/compose_view"
                app:layout_constraintVertical_bias="0">
                <ImageView
                    android:id="@+id/iv_withdrawal_dana_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_info_blue"
                    android:layout_centerVertical="true"
                    app:tint="?attr/themeColorPeriwinkleDefault"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_desc_confirmation_foreign_dialog"
                    android:layout_toRightOf="@+id/iv_withdrawal_dana_title"
                    android:layout_marginStart="@dimen/item_gap_16"
                    style="@style/TypeStyles.BodyXSmall"/>
            </RelativeLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <View
        android:id="@+id/divider"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginBottom="@dimen/clickable_size_12"
        android:layout_above="@+id/ll_tnc_check_box"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/ll_tnc_check_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_12"
        android:layout_above="@+id/btn_withdrawal_confirmation_submit"
        android:layout_marginHorizontal="@dimen/spacing_20">
        <com.stockbit.uikit.control.ControlCheckbox
            android:layout_gravity="center"
            android:id="@+id/cb_confirmation_withdrawal_foreign"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_confirmation_tnc_withdrawal_foreign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_tnc_withdrawal_foreign"
            android:layout_marginStart="@dimen/item_gap_11"
            style="@style/TypeStyles.BodyXSmall"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <Button
        android:textColor="@color/white"
        android:id="@+id/btn_withdrawal_confirmation_submit"
        android:background="@drawable/bg_selector_btn_green"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/button_next"
        android:layout_alignParentBottom="true"
        android:textAllCaps="false"
        style="@style/TypeStyles.HeadingRegular"/>
</RelativeLayout>
