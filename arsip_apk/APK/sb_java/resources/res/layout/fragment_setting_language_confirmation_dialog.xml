<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_setting_language_confirmation_dialog_0"
    android:background="@drawable/bg_top_rounded_20_modal"
    android:paddingBottom="@dimen/spacing_40"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_setting_divider"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_s"
        android:layout_height="@dimen/item_gap_s"
        android:layout_marginTop="@dimen/item_gap_l"
        android:layout_marginBottom="@dimen/spacing_20"
        android:layout_marginStart="@dimen/item_gap_l"
        android:layout_marginEnd="@dimen/item_gap_l"
        app:layout_constraintBottom_toTopOf="@+id/tv_setting_language_confirmation_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_setting_language_confirmation_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_36"
        android:text="@string/title_language_confirmation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_setting_divider"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="center"
        android:id="@+id/tv_setting_language_confirmation_desc"
        android:paddingBottom="@dimen/spacing_20"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_14"
        android:text="@string/text_language_confirmation"
        android:layout_marginHorizontal="@dimen/spacing_50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_setting_language_confirmation_title"
        style="@style/TypeStyles.BodyRegular"/>
    <com.stockbit.uikit.button.SecondaryNeutralButton
        android:id="@+id/snb_setting_language_confirmation_no"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="@string/button_no"
        android:layout_marginStart="@dimen/spacing_20"
        android:layout_marginEnd="@dimen/spacing_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/pb_setting_language_confirmation_yes"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_setting_language_confirmation_desc"
        app:secondaryNeutralButtonActive="true"
        app:secondaryNeutralButtonColor="green"
        app:secondaryNeutralButtonSize="defaultSize"/>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/pb_setting_language_confirmation_yes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/button_yes"
        android:layout_marginStart="@dimen/spacing_8"
        android:layout_marginEnd="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="@+id/snb_setting_language_confirmation_no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/snb_setting_language_confirmation_no"
        app:layout_constraintTop_toTopOf="@+id/snb_setting_language_confirmation_no"
        app:primaryButtonActive="true"
        app:primaryButtonColor="green"
        app:primaryButtonSize="defaultSize"/>
</androidx.constraintlayout.widget.ConstraintLayout>
