<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/row_list_discover_search_item_user_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tvSearchAllPeopleLayoutTitle"
        android:paddingTop="@dimen/item_gap_m"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        android:text="@string/user_title"
        android:textAlignment="gravity"
        android:paddingStart="@dimen/item_gap_l"
        android:paddingEnd="@dimen/item_gap_l"
        style="@style/TypeStyles.HeadlineRegular"/>
    <RelativeLayout
        android:id="@+id/parentRowDiscoverItemPeopleSearchUser"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivDiscoverItemPeopleSearchAvatarUser"
            android:layout_width="@dimen/icon_placeholder_24"
            android:layout_height="@dimen/icon_placeholder_24"
            android:layout_marginLeft="@dimen/item_gap_l"
            android:layout_centerVertical="true"
            android:contentDescription="@string/user_profile_photo"/>
        <LinearLayout
            android:orientation="vertical"
            android:paddingLeft="@dimen/item_gap_m"
            android:paddingRight="@dimen/item_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/ivDiscoverItemPeopleSearchAvatarUser">
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/rlDiscoverSearchItemPeopleLayout"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <TextView
                    android:gravity="start|center_vertical"
                    android:id="@+id/tvDiscoverSearchItemPeopleNameUser"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:maxLines="1"
                    android:layout_centerVertical="true"
                    android:textAlignment="gravity"
                    style="@style/TypeStyles.HeadingRegular"/>
                <ImageView
                    android:layout_gravity="start|center_vertical"
                    android:id="@+id/ivDiscoverItemPeopleSearchUserOfficialStateUser"
                    android:padding="@dimen/item_gap_xxxs"
                    android:visibility="gone"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="@dimen/item_gap_s"
                    android:scaleType="fitXY"
                    android:layout_toRightOf="@+id/tvDiscoverSearchItemPeopleNameUser"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/item_gap_s"
                    app:srcCompat="@drawable/ic_verified_green_white_24dp"/>
            </RelativeLayout>
            <TextView
                android:gravity="start|center_vertical"
                android:id="@+id/tvDiscoverSearchItemPeopleNameUsername"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_weight="1"
                android:textAlignment="gravity"
                style="@style/SbTextView.BodySecondary"/>
        </LinearLayout>
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</LinearLayout>
