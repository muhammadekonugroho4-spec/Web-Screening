<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme"
    android:gravity="bottom"
    android:orientation="vertical"
    android:tag="layout/fragment_liveness_limit_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/rvHeader"
        android:background="@drawable/bg_top_rounded"
        android:paddingBottom="@dimen/item_gap_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/v_handle"
            android:background="@drawable/bg_rounded_gray"
            android:layout_width="@dimen/width_s"
            android:layout_height="@dimen/item_gap_s"
            android:layout_margin="@dimen/item_gap_l"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/themeDialogBackgroundColor"
        android:paddingBottom="@dimen/item_gap_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/item_gap_20"
        android:paddingEnd="@dimen/item_gap_20">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="@dimen/avatar_size_xl"
            android:layout_height="@dimen/avatar_size_xl"
            android:layout_marginBottom="@dimen/item_gap_24"
            app:srcCompat="@drawable/ic_liveness_failed"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/item_gap_20"
            android:text="@string/liveness_reach_limit_title"
            style="@style/SbTextView.BodyDefault.Bold"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/item_gap_20"
            android:text="@string/liveness_reach_limit_subtitle"
            style="@style/SbTextView.BodyDefault"/>
        <Button
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btnOkOrBackHomepage"
            android:background="@drawable/border_green_rounded"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_44"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:text="@string/setting_ubah_rekening_bank_dialog_ok_limited"
            android:textAllCaps="false"
            style="@style/SbTextView.BodyDefault.Green.Bold"/>
    </LinearLayout>
</LinearLayout>
