<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.midtrans.sdk.uikit.widgets.DefaultTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notification_gojek_app"
        style="@style/GojekNotification"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/eight_dp"
            android:src="0x7f080958"/>
        <com.midtrans.sdk.uikit.widgets.BoldTextView
            android:textSize="@dimen/twenty_two_sp"
            android:padding="@dimen/eight_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/whoops"/>
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            android:gravity="center"
            android:padding="@dimen/eight_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_gojek_message"/>
    </LinearLayout>
    <com.midtrans.sdk.uikit.widgets.FancyButton
        android:id="@+id/button_download_gojek"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/sixteen_dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        app:fb_iconPaddingRight="@dimen/four_dp"
        app:fb_iconResource="0x7f0806f2"
        app:fb_text="@string/install_gojek_message"
        style="@style/ButtonSecondary"/>
</RelativeLayout>
