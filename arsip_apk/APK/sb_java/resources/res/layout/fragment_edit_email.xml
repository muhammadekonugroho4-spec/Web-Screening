<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentFragmentSettingMainDialog"
    android:tag="layout/fragment_edit_email_0"
    android:background="?attr/themeDialogBackgroundColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivSettingMainPassIcon"
        android:background="@color/transparent"
        android:layout_width="@dimen/avatar_size_l"
        android:layout_height="@dimen/avatar_size_m"
        android:layout_margin="@dimen/item_gap_l"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        app:srcCompat="@drawable/ic_register_email"/>
    <TextView
        android:textSize="@dimen/text_size_18"
        android:textColor="?attr/themeContentTextColor"
        android:id="@+id/tvSettingMainPassTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_l"
        android:layout_marginTop="@dimen/item_gap_l"
        android:layout_marginRight="@dimen/item_gap_l"
        android:layout_marginBottom="@dimen/item_gap_s"
        android:text="@string/setting_change_email_title"
        android:layout_below="@+id/ivSettingMainPassIcon"
        android:layout_centerHorizontal="true"
        style="@style/SbTextView.BodyDefault.Bold"/>
    <TextView
        android:textColor="?attr/themeContentTextColor"
        android:id="@+id/tvSettingMainPassSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_64"
        android:layout_marginTop="@dimen/item_gap_s"
        android:layout_marginRight="@dimen/item_gap_64"
        android:layout_marginBottom="@dimen/item_gap_s"
        android:text="@string/setting_change_email_subtitle"
        android:layout_below="@+id/tvSettingMainPassTitle"
        android:layout_centerHorizontal="true"
        android:textAlignment="center"
        style="@style/SbTextView.BodyDefault"/>
    <Button
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btnSettingMainPass"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/item_gap_l"
        android:text="@string/lbl_btn_done"
        android:layout_below="@+id/tvSettingMainPassSubtitle"
        android:textAllCaps="true"
        style="@style/SbBtn.PrimaryFullWidthFloating"/>
</RelativeLayout>
