<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rlMainLayout"
    android:tag="layout/fragment_catalog_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        style="@style/Sb.Widget.AppBar">
        <RelativeLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbarCatalog"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tvCatalogTitle"
                android:tag="binding_1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:lines="1"
                android:drawablePadding="@dimen/spacing_4"
                android:layout_above="@+id/viewCatalogHeaderSeparator"
                android:layout_centerHorizontal="true"
                android:textAlignment="gravity"
                android:layout_marginHorizontal="@dimen/height_52"
                app:autoSizeMaxTextSize="@dimen/catalog_title_size"
                app:autoSizeMinTextSize="@dimen/text_badge"
                app:autoSizeTextType="uniform"
                style="@style/TypeStyles.HeadingLarge"/>
            <View
                android:id="@+id/viewCatalogHeaderSeparator"
                android:visibility="gone"
                android:layout_width="@dimen/item_gap_xxxs"
                android:layout_height="@dimen/item_gap_xxxs"
                android:layout_centerInParent="true"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tvCatalogCountStocks"
                android:paddingLeft="@dimen/item_gap_s"
                android:paddingTop="@dimen/item_gap_xxxs"
                android:paddingRight="@dimen/item_gap_s"
                android:paddingBottom="@dimen/item_gap_xxxs"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/viewCatalogHeaderSeparator"
                android:layout_centerHorizontal="true"
                android:textAlignment="gravity"
                style="@style/TypeStyles.BodyXXSmall"/>
        </RelativeLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <ViewFlipper
        android:id="@+id/vfShareholderSetPrice"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/rlCatalogLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.stockbit.uikit.topbar.TopBarStockbitSearch
                android:gravity="center_vertical"
                android:id="@+id/tbss_filter_catalog"
                android:tag="binding_2"
                android:background="@color/transparent"
                android:paddingLeft="@dimen/item_gap_m"
                android:paddingRight="@dimen/item_gap_m"
                android:layout_width="match_parent"
                android:layout_height="@dimen/search_height_m"
                android:layout_marginVertical="@dimen/item_gap_10"
                app:topBarSearchPrefixIcon="@drawable/ic_android_search"
                app:topBarSearchQueryHint="@string/search_by_stock"
                app:topBarSearchQueryImeOptions="actionSearch"
                app:topBarSearchSuffixIcon="@drawable/ic_catalog_filter"
                app:topBarSearchVariant="container_outline"/>
            <TextView
                android:textColor="?attr/themeColorTextPrimary"
                android:gravity="center_vertical"
                android:id="@+id/tv_catalog_label"
                android:tag="binding_3"
                android:background="@drawable/border_gray_rounded_4dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/item_gap_m"
                android:layout_below="@+id/tbss_filter_catalog"
                android:layout_marginHorizontal="@dimen/item_gap_20"
                android:layout_marginVertical="@dimen/item_gap_10"
                android:paddingHorizontal="@dimen/item_gap_m"
                android:paddingVertical="@dimen/item_gap_9"
                app:drawableStartCompat="@drawable/ic_info"
                style="@style/TypeStyles.BodySmall"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/plProgress"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:indeterminate="false"
                android:layout_below="@+id/tv_catalog_label"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                style="?android:attr/progressBarStyle"/>
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefreshLayout"
                android:tag="binding_4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/plProgress">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCatalog"
                    android:paddingBottom="@dimen/item_gap_l"
                    android:scrollbars="vertical"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            <TextView
                android:id="@+id/tv_catalog_empty"
                android:tag="binding_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="-10dp"
                android:layout_centerInParent="true"
                app:drawableTopCompat="?attr/themeIconEmptyTable"
                style="@style/TypeStyles.BodyRegular.Tertiary"/>
        </RelativeLayout>
        <RelativeLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/tvCatalogError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_failed_load_data"
                android:layout_centerHorizontal="true"
                style="@style/SbTextView.BodyDefault"/>
            <Button
                android:id="@+id/btnCatalogReload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_s"
                android:text="@string/button_reload"
                android:layout_below="@+id/tvCatalogError"
                android:layout_centerHorizontal="true"
                style="@style/SbBtnBorderless.Small"/>
        </RelativeLayout>
    </ViewFlipper>
</LinearLayout>
