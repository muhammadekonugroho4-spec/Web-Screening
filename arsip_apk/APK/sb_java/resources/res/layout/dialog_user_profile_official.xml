<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_user_profile_official_0"
    android:background="@drawable/bg_top_rounded_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/rectangle_dialog"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_verified_badge_rouned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.35"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView"
        app:layout_constraintWidth_percent="0.5"
        app:srcCompat="@drawable/ic_verified_badge_rounded"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_verified_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_24"
        android:text="@string/verified_account"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_verified_badge_rouned"
        style="@style/SbTextView.PageTitle.HighEmphasis"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_size_13"
        android:gravity="center"
        android:id="@+id/tv_msg_verified_account"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_8"
        android:text="@string/msg_verified_account"
        android:layout_marginStart="@dimen/item_gap_32"
        android:layout_marginEnd="@dimen/item_gap_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_verified_title"
        style="@style/SbTextView.Caption.Mediumempasis"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/appCompatButton"
        android:tag="binding_1"
        android:background="@drawable/border_green_rounded"
        android:paddingTop="@dimen/item_gap_12"
        android:paddingBottom="@dimen/item_gap_12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_24"
        android:layout_marginBottom="@dimen/item_gap_24"
        android:text="@string/btn_positive_ok"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/item_gap_32"
        android:layout_marginEnd="@dimen/item_gap_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_msg_verified_account"
        style="@style/SbTextView.Button.Regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
