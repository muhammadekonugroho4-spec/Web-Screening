<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_chat_group_room_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/genericToolbar"
        android:tag="binding_1"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingEnd="@dimen/item_gap_8"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ViewFlipper
            android:id="@+id/vf_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_group_avatar"
                    android:tag="binding_3"
                    android:layout_width="@dimen/avatar_size_36"
                    android:layout_height="@dimen/avatar_size_36"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/tv_group_name"
                    android:tag="binding_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="@dimen/item_gap_12"
                    app:layout_constraintBottom_toTopOf="@+id/tv_group_members"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_group_avatar"
                    app:layout_constraintTop_toTopOf="@+id/iv_group_avatar"
                    style="@style/TypeStyles.HeadingLarge"/>
                <TextView
                    android:id="@+id/tv_group_members"
                    android:tag="binding_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_group_avatar"
                    app:layout_constraintStart_toStartOf="@+id/tv_group_name"
                    app:layout_constraintTop_toBottomOf="@+id/tv_group_name"
                    style="@style/TypeStyles.BodyXSmall.Secondary"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:layout_gravity="center_vertical"
                android:tag="binding_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TypeStyles.HeadingLarge"/>
        </ViewFlipper>
    </androidx.appcompat.widget.Toolbar>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:tag="binding_7"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/genericToolbar">
        <include
            android:id="@+id/banner_share_trade_group_chat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/comp_banner_share_trade_group_chat"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_chat"
            android:tag="binding_8"
            android:paddingTop="4dp"
            android:paddingBottom="@dimen/item_gap_8"
            android:visibility="visible"
            android:clipToPadding="false"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@+id/barrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/banner_share_trade_group_chat"/>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/sflChatRoom"
            android:tag="binding_9"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/barrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:tag="binding_10"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include layout="@layout/skeleton_chat_room_list"/>
                <include layout="@layout/skeleton_chat_room_list"/>
                <include layout="@layout/skeleton_chat_room_list"/>
                <include layout="@layout/skeleton_chat_room_list"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <ViewStub
            android:id="@+id/lyt_tap_mantion"
            android:tag="binding_11"
            android:layout="@layout/item_tap_mantion"
            android:inflatedId="@+id/inflate_lyt_tap_mantion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_8"
            android:layout_marginEnd="@dimen/item_gap_16"
            app:layout_constraintBottom_toTopOf="@+id/rlScrollToBottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_goneMarginBottom="@dimen/spacing_20"/>
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/rlScrollToBottom"
            android:tag="binding_12"
            android:background="@drawable/bg_circle_theme_component"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginBottom="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/item_gap_16"
            app:layout_constraintBottom_toTopOf="@+id/barrier"
            app:layout_constraintEnd_toEndOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="0x7f080612"
                app:tint="?attr/titleTextColorHighempasis"/>
        </RelativeLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_image_to_upload"
            android:tag="binding_13"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/separator_list"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:id="@+id/actv_label_upload"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/toolbar_height"
                android:text="@string/chat_upload_images"
                android:layout_centerHorizontal="true"
                android:textAlignment="gravity"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/SbTextView.PageTitle"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="right"
                android:id="@+id/delete_image"
                android:tag="binding_14"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:focusable="false"
                android:layout_width="@dimen/clickable_size_32"
                android:layout_height="@dimen/clickable_size_32"
                android:scaleType="centerInside"
                android:tint="?attr/themeContentTextColor"
                android:layout_marginEnd="@dimen/height_16"
                app:layout_constraintBottom_toBottomOf="@+id/actv_label_upload"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/actv_label_upload"
                app:srcCompat="0x7f08063f"/>
            <com.github.piasy.biv.view.BigImageView
                android:id="@+id/imagePreview"
                android:tag="binding_15"
                android:background="?attr/themeChatImagePreviewBackground"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:failureImage="@drawable/ic_chat_error_img"
                app:failureImageInitScaleType="center"
                app:initScaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/actv_label_upload"
                app:optimizeDisplay="false"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/rv_suggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@+id/separator_list"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/separator_list"
            android:background="?attr/themeSeparatorGapColor"
            android:layout_width="0dp"
            android:layout_height="1dp"
            app:layout_constraintBottom_toTopOf="@+id/cl_reply"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/cl_reply"
            android:tag="binding_16"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/vf_compose"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_reply"
                android:layout_width="@dimen/item_gap_16"
                android:layout_height="@dimen/item_gap_16"
                android:layout_marginTop="@dimen/item_gap_4"
                android:src="@drawable/ic_reply_17"
                android:layout_marginStart="@dimen/item_gap_12"
                android:layout_marginEnd="@dimen/item_gap_16"
                app:tint="?attr/themeIconTintColor"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <com.stockbit.common.uikit.BitRoundedLayout
                    android:id="@+id/brl_image_container"
                    android:layout_width="@dimen/avatar_size_42"
                    android:layout_height="@dimen/avatar_size_42"
                    android:layout_marginTop="@dimen/item_gap_12"
                    android:layout_marginBottom="@dimen/item_gap_4"
                    android:layout_marginEnd="@dimen/item_gap_8"
                    app:cornerRadius="@dimen/item_gap_4"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_reply_username"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:roundedColor="?attr/themeComponent">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:tag="binding_17"
                        android:background="@drawable/bg_chat_reply_image"
                        android:layout_width="@dimen/item_gap_20"
                        android:layout_height="@dimen/item_gap_20"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </com.stockbit.common.uikit.BitRoundedLayout>
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/tv_reply_username"
                    android:tag="binding_18"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_12"
                    android:maxLines="1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/brl_image_container"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/SbTextView.BodyDefault.Highempasis.Bold"/>
                <TextView
                    android:ellipsize="end"
                    android:id="@+id/tv_reply_message"
                    android:tag="binding_19"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginVertical="@dimen/item_gap_4"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/tv_reply_username"
                    app:layout_constraintTop_toBottomOf="@+id/tv_reply_username"
                    style="@style/SbTextView.ListTitle.Highgray.Normal"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ImageView
                android:layout_gravity="center"
                android:tag="binding_20"
                android:layout_width="@dimen/item_gap_24"
                android:layout_height="@dimen/item_gap_24"
                android:layout_marginTop="@dimen/item_gap_4"
                android:src="0x7f08063f"
                android:layout_marginStart="@dimen/item_gap_8"
                android:layout_marginEnd="@dimen/item_gap_12"
                app:tint="?attr/themeIconTintColor"/>
        </LinearLayout>
        <ViewFlipper
            android:id="@+id/vf_compose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/item_gap_12"
            app:layout_constraintBottom_toTopOf="@+id/attachmentView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_chat_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:id="@+id/aciv_attach"
                    android:tag="binding_21"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/item_gap_8"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/item_gap_4"
                    app:layout_constraintBottom_toBottomOf="@+id/chat_compose"
                    app:layout_constraintEnd_toStartOf="@+id/chat_compose"
                    app:layout_constraintStart_toStartOf="parent">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="@dimen/height_24"
                        android:layout_height="@dimen/height_24"
                        app:srcCompat="@drawable/ic_add_rounded_24dp"/>
                </LinearLayout>
                <com.stockbit.chat.component.ChatCompose
                    android:id="@+id/chat_compose"
                    android:tag="binding_22"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/send_button"
                    app:layout_constraintHorizontal_weight="2"
                    app:layout_constraintStart_toEndOf="@+id/aciv_attach"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_goneMarginEnd="@dimen/item_gap_14"
                    app:layout_goneMarginStart="@dimen/item_gap_12"/>
                <LinearLayout
                    android:id="@+id/send_button"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/item_gap_8"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/item_gap_2"
                    android:layout_marginEnd="@dimen/item_gap_6"
                    app:layout_constraintBottom_toBottomOf="@+id/chat_compose"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/chat_compose">
                    <ImageView
                        android:layout_gravity="center"
                        android:layout_width="@dimen/height_24"
                        android:layout_height="@dimen/height_24"
                        app:srcCompat="@drawable/ic_send_plane"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_reply"
                    android:tag="binding_23"
                    android:background="?attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/chat_reply"
                    android:drawablePadding="@dimen/item_gap_8"
                    android:paddingHorizontal="@dimen/item_gap_12"
                    app:drawableStartCompat="@drawable/ic_reply_17"
                    app:drawableTint="?attr/themeColorTextPrimary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_copy"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TypeStyles.HeadingRegular"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_copy"
                    android:tag="binding_24"
                    android:background="?attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/chat_copy"
                    android:drawablePadding="@dimen/item_gap_8"
                    android:paddingHorizontal="@dimen/item_gap_12"
                    app:drawableStartCompat="@drawable/ic_copy_outline"
                    app:drawableTint="?attr/themeColorTextPrimary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_forward"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tv_reply"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TypeStyles.HeadingRegular"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_forward"
                    android:tag="binding_25"
                    android:background="?attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/chat_forward"
                    android:drawablePadding="@dimen/item_gap_8"
                    android:paddingHorizontal="@dimen/item_gap_12"
                    app:drawableStartCompat="@drawable/ic_forward"
                    app:drawableTint="?attr/themeColorTextPrimary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/tv_copy"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TypeStyles.HeadingRegular"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ViewFlipper>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/attachmentView"
            android:tag="binding_26"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vp_attachment"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/layout_chat_attachment"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <include
                android:id="@+id/layout_chat_attachment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                layout="@layout/comp_chat_attachment"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier"
            android:layout_width="match_parent"
            android:layout_height="10dp"
            app:barrierDirection="top"
            app:constraint_referenced_ids="requestCardView,separator_list,cl_reply"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/requestCardView"
            android:tag="binding_27"
            android:background="?attr/themeContentBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            app:layout_constraintBottom_toTopOf="@+id/separator_list"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <LinearLayout
                android:orientation="vertical"
                android:background="?attr/themeContentBackground"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <View
                    android:background="?attr/themeSeparatorGapColor"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <TextView
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_20"
                    android:text="@string/chat_group_room_request_title"
                    android:layout_marginHorizontal="@dimen/item_gap_16"
                    style="@style/TypeStyles.HeadingLarge"/>
                <TextView
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_8"
                    android:text="@string/chat_group_room_request_subtitle"
                    android:layout_marginHorizontal="@dimen/item_gap_16"
                    style="@style/TypeStyles.BodyXSmall.Secondary"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/item_gap_16">
                    <com.stockbit.uikit.buttons.SecondaryButton
                        android:tag="binding_28"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_32"
                        android:layout_marginBottom="@dimen/item_gap_16"
                        android:text="@string/chat_group_room_request_btn_negative"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:layout_marginEnd="@dimen/item_gap_10"
                        app:defaultColor="Neutral"/>
                    <com.stockbit.uikit.buttons.SecondaryButton
                        android:tag="binding_29"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_32"
                        android:layout_marginBottom="@dimen/item_gap_16"
                        android:text="@string/chat_group_room_request_btn_positive"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:layout_marginStart="@dimen/item_gap_10"
                        app:defaultColor="Green"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_of_chat_input"
            android:tag="binding_30"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="separator_list, vf_compose"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
