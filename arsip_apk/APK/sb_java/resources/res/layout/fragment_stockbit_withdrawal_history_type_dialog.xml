<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_stockbit_withdrawal_history_type_dialog_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/vgSWithdrawalHistoryPeriodeHeader"
        android:background="@drawable/bg_top_rounded"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        android:paddingStart="@dimen/item_gap_24"
        android:paddingEnd="@dimen/item_gap_xxxs">
        <ImageView
            android:id="@+id/ivSelectDateCloseDialog"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/item_gap_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tint="?attr/themeIconTintColor"
            android:layout_alignParentRight="true"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            app:srcCompat="0x7f080641"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:gravity="center_vertical"
            android:id="@+id/tvSetTradingPeriodeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_title_history_type"
            android:layout_centerInParent="true"
            android:textAlignment="gravity"
            style="@style/SbTextView.ListTitle"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/vgSWithdrawalHistoryPeriodeHeader">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rlSetTradingPeriodeLayout"
                android:background="?attr/themeDialogBackgroundColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:orientation="vertical"
                    android:id="@+id/rl_all_layout"
                    android:padding="@dimen/item_gap_20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackgroundBorderless">
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/all_history_trading"
                        android:layout_centerVertical="true"
                        style="@style/SbTextView.ListTitle"/>
                    <ImageView
                        android:id="@+id/iv_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        app:srcCompat="@drawable/ic_check_circle_green_24dp"/>
                </RelativeLayout>
                <View
                    android:background="?attr/themeSeparatorGapColorSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_gap_xxxs"
                    android:layout_below="@+id/rl_all_layout"/>
                <RelativeLayout
                    android:orientation="vertical"
                    android:id="@+id/rlOneMonthLayout"
                    android:padding="@dimen/item_gap_20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:layout_below="@+id/rl_all_layout">
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/one_month_history_trading"
                        android:layout_centerVertical="true"
                        style="@style/SbTextView.ListTitle"/>
                    <ImageView
                        android:id="@+id/iv_one_month"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        app:srcCompat="@drawable/ic_check_circle_green_24dp"/>
                </RelativeLayout>
                <View
                    android:background="?attr/themeSeparatorGapColorSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_gap_xxxs"
                    android:layout_below="@+id/rlOneMonthLayout"/>
                <RelativeLayout
                    android:orientation="vertical"
                    android:id="@+id/rlThreeMonthsLayout"
                    android:padding="@dimen/item_gap_20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:layout_below="@+id/rlOneMonthLayout">
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/three_month_history_trading"
                        android:layout_centerVertical="true"
                        style="@style/SbTextView.ListTitle"/>
                    <ImageView
                        android:id="@+id/iv_three_month"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        app:srcCompat="@drawable/ic_check_circle_green_24dp"/>
                </RelativeLayout>
                <View
                    android:background="?attr/themeSeparatorGapColorSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_gap_xxxs"
                    android:layout_below="@+id/rlThreeMonthsLayout"/>
                <RelativeLayout
                    android:orientation="vertical"
                    android:id="@+id/rlOneYearLayout"
                    android:padding="@dimen/item_gap_20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:layout_below="@+id/rlThreeMonthsLayout">
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/one_year_history_trading"
                        android:layout_centerVertical="true"
                        style="@style/SbTextView.ListTitle"/>
                    <ImageView
                        android:id="@+id/iv_one_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        app:srcCompat="@drawable/ic_check_circle_green_24dp"/>
                </RelativeLayout>
                <View
                    android:background="?attr/themeSeparatorGapColorSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_gap_xxxs"
                    android:layout_below="@+id/rlOneYearLayout"/>
            </RelativeLayout>
            <View
                android:id="@+id/viewSep2"
                android:background="?attr/themeDialogBackgroundColor"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_l"
                android:layout_below="@+id/rlSetTradingPeriodeLayout"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
