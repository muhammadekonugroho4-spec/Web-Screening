<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_register_fullname_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="800dp">
        <androidx.core.widget.NestedScrollView
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:layout_weight="1">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/ivRegisterFullnameIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/item_gap_l"
                    android:layout_marginTop="@dimen/item_gap_36"
                    android:layout_marginRight="@dimen/item_gap_l"
                    app:srcCompat="?attr/imgRegisterFullname"/>
                <TextView
                    android:id="@+id/tvRegisterFullnameTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/item_gap_l"
                    android:layout_marginTop="@dimen/item_gap_20"
                    android:layout_marginRight="@dimen/item_gap_l"
                    android:layout_marginBottom="@dimen/item_gap_s"
                    android:text="@string/title_registration_fullname"
                    android:layout_below="@+id/ivRegisterFullnameIcon"
                    style="@style/TypeStyles.HeadlineRegular"/>
                <TextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:id="@+id/tvRegisterFullnameSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/item_gap_l"
                    android:layout_marginTop="@dimen/item_gap_10"
                    android:layout_marginRight="@dimen/item_gap_l"
                    android:layout_marginBottom="@dimen/item_gap_s"
                    android:text="@string/text_registration_fullname"
                    android:layout_below="@+id/tvRegisterFullnameTitle"
                    style="@style/TypeStyles.BodyRegular"/>
                <com.stockbit.uikit.input.InputTextFieldLine
                    android:id="@+id/itfl_register_fullname"
                    android:tag="binding_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/item_gap_l"
                    android:layout_marginTop="@dimen/item_gap_l"
                    android:layout_marginRight="@dimen/item_gap_l"
                    android:layout_marginBottom="@dimen/item_gap_46"
                    android:layout_below="@+id/tvRegisterFullnameSubtitle"
                    app:textFieldHint="@string/placeholder_registration_fullname"/>
            </RelativeLayout>
        </androidx.core.widget.NestedScrollView>
        <com.stockbit.uikit.buttons.StickyButton
            android:id="@+id/rlRegisterFullname"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_next"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
