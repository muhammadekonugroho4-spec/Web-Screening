<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/comp_trading_stockbit_preview_exercise_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/item_gap_30"
    android:layout_marginStart="@dimen/spacing_20"
    android:layout_marginEnd="@dimen/spacing_20">
    <RelativeLayout
        android:id="@+id/rl_exercise_main_layout"
        android:background="@drawable/border_gray_rounded_transparent_bg"
        android:paddingTop="@dimen/spacing_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_exercise_preview_stock_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_exercise_stock"
            android:paddingStart="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_company_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="@dimen/spacing_16"
            android:layout_alignParentEnd="true">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_company_logo"
                android:layout_width="@dimen/spacing_16"
                android:layout_height="@dimen/spacing_16"/>
            <TextView
                android:textStyle="bold"
                android:gravity="end|center_vertical"
                android:id="@+id/tv_exercise_preview_stock"
                android:tag="binding_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="gravity"
                android:layout_marginStart="@dimen/spacing_4"
                style="@style/TypeStyles.BodyRegular"/>
        </LinearLayout>
        <View
            android:id="@+id/view_separate"
            android:background="?attr/themeColorModalsDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_1"
            android:layout_marginTop="@dimen/item_gap_m"
            android:layout_below="@+id/ll_company_symbol"/>
        <TextView
            android:id="@+id/tv_exercise_preview_order_type_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            android:text="@string/order_type_title"
            android:layout_below="@+id/view_separate"
            android:paddingStart="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="end|center_vertical"
            android:id="@+id/tv_exercise_preview_order_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            android:text="@string/title_exercise"
            android:layout_toRightOf="@+id/tv_exercise_preview_order_type_title"
            android:layout_below="@+id/view_separate"
            android:textAlignment="gravity"
            android:paddingEnd="@dimen/spacing_16"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_alignParentEnd="true"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:id="@+id/tv_exercise_preview_expiry_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            android:text="@string/title_exercise_expiry"
            android:layout_below="@+id/tv_exercise_preview_order_type_title"
            android:paddingStart="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="end|center_vertical"
            android:id="@+id/tv_exercise_preview_expiry"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            android:layout_toRightOf="@+id/tv_exercise_preview_expiry_title"
            android:layout_below="@+id/tv_exercise_preview_order_type_title"
            android:textAlignment="gravity"
            android:paddingEnd="@dimen/spacing_16"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_alignParentEnd="true"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:id="@+id/tv_exercise_preview_exercise_price_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            android:text="@string/title_exercise_exercise_price"
            android:layout_below="@+id/tv_exercise_preview_expiry"
            android:paddingStart="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="end|center_vertical"
            android:id="@+id/tv_exercise_preview_exercise_price"
            android:tag="binding_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            android:layout_toRightOf="@+id/tv_exercise_preview_exercise_price_title"
            android:layout_below="@+id/tv_exercise_preview_expiry"
            android:textAlignment="gravity"
            android:paddingEnd="@dimen/spacing_16"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_alignParentEnd="true"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:id="@+id/tv_exercise_preview_shares_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            android:text="@string/title_exercise_shares"
            android:layout_below="@+id/tv_exercise_preview_exercise_price"
            android:paddingStart="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="end|center_vertical"
            android:id="@+id/tv_exercise_preview_shares"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            android:layout_toRightOf="@+id/tv_exercise_preview_shares_title"
            android:layout_below="@+id/tv_exercise_preview_exercise_price"
            android:textAlignment="gravity"
            android:paddingEnd="@dimen/spacing_16"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_alignParentEnd="true"
            style="@style/TypeStyles.BodyRegular"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_surface_emphasis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_below="@+id/tv_exercise_preview_shares"
            android:paddingVertical="@dimen/spacing_12">
            <TextView
                android:textStyle="bold"
                android:id="@+id/tv_exercise_preview_exercise_amount_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/title_exercise_exercise_amount"
                android:layout_weight="1"
                android:paddingStart="@dimen/spacing_16"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:gravity="right"
                android:id="@+id/tv_rupiah_total_investment_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_indonesian_currency"
                android:maxLines="1"
                android:textAlignment="gravity"
                style="@style/TypeStyles.HeadingRegular"/>
            <TextView
                android:textStyle="bold"
                android:gravity="end|center_vertical"
                android:id="@+id/tv_exercise_preview_exercise_amount"
                android:tag="binding_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAlignment="gravity"
                android:paddingEnd="@dimen/spacing_16"
                android:layout_marginStart="@dimen/spacing_4"
                style="@style/TypeStyles.BodyRegular"/>
        </LinearLayout>
    </RelativeLayout>
    <TextView
        android:textColor="?attr/titleTextColorHighgray"
        android:gravity="center"
        android:id="@+id/tv_exercise_desc"
        android:tag="binding_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_24"
        android:text="@string/title_exercise_price_desc"
        android:layout_below="@+id/rl_exercise_main_layout"
        android:layout_centerHorizontal="true"
        android:textAlignment="gravity"
        android:layout_marginStart="@dimen/spacing_16"
        style="@style/TypeStyles.BodyRegular"/>
</RelativeLayout>
