<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_dialog_trigger_condition_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/ic_less_equal"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_20"
            android:layout_marginTop="@dimen/item_gap_12"
            android:text="@string/ic_less_than_equal"
            app:layout_constraintEnd_toStartOf="@+id/iv_check_less_equal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SbTextView.ListTitle"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="?attr/themeColorTextSecondary"
            android:id="@+id/desc_less_equal"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_4"
            android:text="@string/less_than_equal_desc"
            android:layout_marginEnd="@dimen/item_gap_18"
            app:layout_constraintEnd_toStartOf="@+id/iv_check_less_equal"
            app:layout_constraintStart_toStartOf="@+id/ic_less_equal"
            app:layout_constraintTop_toBottomOf="@+id/ic_less_equal"
            style="@style/TypeStyles.BodyRegular"/>
        <com.stockbit.uikit.control.ControlRadioButton
            android:id="@+id/iv_check_less_equal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/item_gap_20"
            app:layout_constraintBottom_toBottomOf="@+id/desc_less_equal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ic_less_equal"
            app:radioType="tick"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/btn_less_equal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="ic_less_equal,desc_less_equal,iv_check_less_equal"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/separator"
            android:background="?attr/themeColorModalsDividerThin"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="@dimen/item_gap_1"
            android:layout_marginTop="@dimen/item_gap_12"
            app:layout_constraintEnd_toEndOf="@+id/iv_check_less_equal"
            app:layout_constraintStart_toStartOf="@+id/desc_less_equal"
            app:layout_constraintTop_toBottomOf="@+id/desc_less_equal"/>
        <TextView
            android:id="@+id/ic_greater_equal"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_20"
            android:layout_marginTop="@dimen/item_gap_12"
            android:text="@string/ic_greater_than_equal"
            app:layout_constraintEnd_toStartOf="@+id/iv_check_greater_equal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/separator"
            style="@style/SbTextView.ListTitle"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="?attr/themeColorTextSecondary"
            android:id="@+id/desc_greater_equal"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_4"
            android:layout_marginBottom="@dimen/item_gap_32"
            android:text="@string/greater_than_equal_desc"
            android:layout_marginEnd="@dimen/item_gap_18"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_check_greater_equal"
            app:layout_constraintStart_toStartOf="@+id/ic_greater_equal"
            app:layout_constraintTop_toBottomOf="@+id/ic_greater_equal"
            style="@style/TypeStyles.BodyRegular"/>
        <com.stockbit.uikit.control.ControlRadioButton
            android:id="@+id/iv_check_greater_equal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/item_gap_20"
            app:layout_constraintBottom_toBottomOf="@+id/desc_greater_equal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ic_greater_equal"
            app:radioType="tick"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/btn_greater_equal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="ic_greater_equal,desc_greater_equal,iv_check_greater_equal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
