<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/border_gray"
    android:paddingLeft="@dimen/item_gap_24"
    android:paddingTop="@dimen/item_gap_24"
    android:paddingRight="@dimen/item_gap_24"
    android:paddingBottom="@dimen/item_gap_24"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/item_gap_24"
    android:layout_marginRight="@dimen/item_gap_24"
    android:layout_centerInParent="true">
    <FrameLayout
        android:id="@+id/iconFAB"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/iconAnimated"
            android:layout_width="@dimen/avatar_size_m"
            android:layout_height="@dimen/avatar_size_m"
            android:scaleType="fitCenter"
            app:lottie_autoPlay="false"
            app:lottie_fileName="ic_fingerprint_gray_initital_state.json"
            app:lottie_loop="false"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/pbFingerprintLogin"
            android:visibility="gone"
            android:layout_width="@dimen/clickable_size_32"
            android:layout_height="@dimen/clickable_size_32"
            android:indeterminate="true"/>
    </FrameLayout>
    <TextView
        android:gravity="center"
        android:id="@+id/titleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_l"
        android:text="@string/title_trading_login"
        android:layout_below="@+id/iconFAB"
        android:textAlignment="gravity"
        style="@style/SbTextView.PageTitle"/>
    <TextView
        android:gravity="center"
        android:id="@+id/subtitleTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_l"
        android:text="@string/title_trading_auth"
        android:layout_below="@+id/titleTextView"
        android:textAlignment="gravity"
        style="@style/SbTextView.ListSubtitle"/>
</RelativeLayout>
