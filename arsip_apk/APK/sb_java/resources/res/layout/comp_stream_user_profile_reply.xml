<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:tag="layout/comp_stream_user_profile_reply_0"
    android:paddingTop="@dimen/item_gap_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/item_gap_12">
    <ImageView
        android:id="@+id/iv_reply_avatar"
        android:tag="binding_1"
        android:layout_width="@dimen/width_24"
        android:layout_height="@dimen/height_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv_reply_username"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_18"
        android:layout_marginStart="@dimen/item_gap_8"
        app:layout_constraintStart_toEndOf="@+id/iv_reply_avatar"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingSmall"/>
    <FrameLayout
        android:id="@+id/fl_reply_verified_badge"
        android:layout_width="@dimen/width_16"
        android:layout_height="@dimen/height_16"
        android:layout_marginStart="@dimen/item_gap_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_reply_username"
        app:layout_constraintStart_toEndOf="@+id/tv_reply_username"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_reply_verified_badge"
            android:tag="binding_3"
            android:layout_width="@dimen/width_12"
            android:layout_height="@dimen/height_12"
            android:scaleType="fitXY"
            android:contentDescription="@string/hint_verified_user_badge"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/text_size_10"
        android:textColor="?attr/themeColorTextTetriary"
        android:layout_gravity="center"
        android:id="@+id/tv_reply_top_badge"
        android:tag="binding_4"
        android:background="@drawable/border_badge_gray_rounded_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_badge_title_top"
        android:lines="1"
        android:layout_marginStart="@dimen/item_gap_4"
        android:paddingHorizontal="@dimen/spacing_4"
        android:paddingVertical="@dimen/spacing_2"
        app:layout_constraintBottom_toBottomOf="@+id/tv_reply_username"
        app:layout_constraintStart_toEndOf="@+id/fl_reply_verified_badge"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.Bold"/>
    <TextView
        android:textSize="@dimen/text_size_10"
        android:textColor="?attr/themeColorTextTetriary"
        android:layout_gravity="center"
        android:id="@+id/tv_reply_admin_badge"
        android:background="@drawable/border_badge_gray_rounded_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_badge_title_admin"
        android:lines="1"
        android:layout_marginStart="@dimen/item_gap_4"
        android:paddingHorizontal="@dimen/spacing_4"
        android:paddingVertical="@dimen/spacing_2"
        app:layout_constraintBottom_toBottomOf="@+id/tv_reply_username"
        app:layout_constraintStart_toEndOf="@+id/tv_reply_top_badge"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.Bold"/>
    <TextView
        android:textColor="?attr/themeColorTextTetriary"
        android:id="@+id/tv_date_time"
        android:tag="binding_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/item_gap_8"
        app:layout_constraintStart_toEndOf="@+id/iv_reply_avatar"
        app:layout_constraintTop_toBottomOf="@+id/tv_reply_username"
        style="@style/TypeStyles.BodyXXSmall"/>
    <ImageView
        android:id="@+id/iv_badge_violation_alert"
        android:visibility="gone"
        android:layout_width="59dp"
        android:layout_height="@dimen/height_20"
        android:src="?attr/themeIconStreamAlertFull"
        android:contentDescription="@string/stream_dialog_title_content_warning"
        android:layout_marginEnd="@dimen/item_gap_12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_date_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_reply_username"/>
</androidx.constraintlayout.widget.ConstraintLayout>
