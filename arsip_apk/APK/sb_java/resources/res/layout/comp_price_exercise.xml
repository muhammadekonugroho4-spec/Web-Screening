<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlExerciseRoundedSearching"
    android:tag="layout/comp_price_exercise_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/item_gap_l"
    android:layout_marginEnd="@dimen/item_gap_s">
    <RelativeLayout
        android:id="@+id/rl_shares"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_28"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_marginBottom="@dimen/spacing_8"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:id="@+id/tv_shares_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_title_shares_exercised_exercise"
            android:layout_centerVertical="true"
            style="@style/SbTextView.BodyDefault"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/width_28"
            android:layout_toRightOf="@+id/tv_shares_title"
            android:layout_alignParentEnd="true">
            <ImageView
                android:id="@+id/btn_min_share"
                android:background="@drawable/border_gray_rounded_white_bg"
                android:padding="@dimen/spacing_6"
                android:layout_width="@dimen/width_28"
                android:layout_height="@dimen/height_28"
                android:layout_toStartOf="@+id/et_rounded_search"
                app:srcCompat="?attr/iconMinEnable"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="@dimen/text_size_16"
                android:gravity="center"
                android:id="@+id/et_rounded_search"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="@dimen/width_100"
                android:hint="@string/zero"
                android:maxLines="1"
                android:selectAllOnFocus="true"
                android:digits="0123456789"
                android:inputType="numberDecimal"
                android:imeOptions="actionDone"
                android:layout_toStartOf="@+id/btn_plus_share"
                style="@style/SbTextView.BodyDefault"/>
            <ImageView
                android:id="@+id/btn_plus_share"
                android:background="@drawable/border_gray_rounded_white_bg"
                android:padding="@dimen/spacing_6"
                android:layout_width="@dimen/width_28"
                android:layout_height="@dimen/height_28"
                android:layout_alignParentEnd="true"
                app:srcCompat="?attr/iconPlusEnable"/>
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_price"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/buy_height_btn"
        android:layout_below="@+id/rl_shares"
        android:paddingEnd="@dimen/item_gap_m">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:id="@+id/tv_price_title"
            android:paddingTop="@dimen/item_gap_m"
            android:paddingBottom="@dimen/item_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_title_exercise_price_exercise"
            style="@style/SbTextView.BodyDefault"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:gravity="end"
            android:id="@+id/tv_price"
            android:paddingTop="@dimen/item_gap_m"
            android:paddingBottom="@dimen/item_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/n_dash"
            android:layout_centerInParent="true"
            android:textAlignment="gravity"
            android:layout_marginStart="@dimen/item_gap_s"
            android:layout_toEndOf="@+id/tv_price_title"
            android:layout_alignParentEnd="true"
            style="@style/SbTextView.BodyDefault"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_amount"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/buy_height_btn"
        android:layout_below="@+id/rl_price"
        android:paddingEnd="@dimen/item_gap_m">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:id="@+id/tv_amound_title"
            android:paddingTop="@dimen/item_gap_m"
            android:paddingBottom="@dimen/item_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_title_exercised_amount_exercise"
            style="@style/SbTextView.BodyDefault"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:gravity="end"
            android:id="@+id/tv_amount"
            android:paddingTop="@dimen/item_gap_m"
            android:paddingBottom="@dimen/item_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/zero"
            android:layout_centerInParent="true"
            android:textAlignment="gravity"
            android:layout_marginStart="@dimen/item_gap_s"
            android:layout_toEndOf="@+id/tv_amound_title"
            android:layout_alignParentEnd="true"
            style="@style/SbTextView.BodyDefault"/>
    </RelativeLayout>
</RelativeLayout>
