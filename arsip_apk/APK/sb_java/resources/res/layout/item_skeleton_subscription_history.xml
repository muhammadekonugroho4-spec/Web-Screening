<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="@dimen/item_gap_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/item_gap_20">
    <View
        android:id="@+id/v_status_item"
        android:background="@drawable/bg_circle_gray"
        android:layout_width="@dimen/item_gap_40"
        android:layout_height="@dimen/height_40"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SBShimmerItem"/>
    <View
        android:id="@+id/v_type_item_subscription_history"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_150"
        android:layout_height="@dimen/clickable_size_18"
        android:layout_marginStart="@dimen/item_gap_16"
        app:layout_constraintStart_toEndOf="@+id/v_status_item"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SBShimmerItem"/>
    <View
        android:id="@+id/v_date_item_subscription_history"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/clickable_size_79"
        android:layout_height="@dimen/clickable_size_18"
        android:layout_marginTop="@dimen/item_gap_2"
        android:layout_marginStart="@dimen/item_gap_16"
        app:layout_constraintStart_toEndOf="@+id/v_status_item"
        app:layout_constraintTop_toBottomOf="@+id/v_type_item_subscription_history"
        style="@style/SBShimmerItem"/>
    <View
        android:gravity="end"
        android:id="@+id/v_amount_item_subscription_history"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_82"
        android:layout_height="@dimen/clickable_size_18"
        android:layout_marginStart="@dimen/item_gap_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SBShimmerItem"/>
    <View
        android:id="@+id/v_payment_type_item_subscription_history"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/item_gap_51"
        android:layout_height="@dimen/clickable_size_18"
        android:layout_marginTop="@dimen/item_gap_2"
        android:layout_marginStart="@dimen/item_gap_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_amount_item_subscription_history"
        style="@style/SBShimmerItem"/>
    <View
        android:id="@+id/v_border"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_date_item_subscription_history"
        style="@style/SBShimmerItem"/>
</androidx.constraintlayout.widget.ConstraintLayout>
