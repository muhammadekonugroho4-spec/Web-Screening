<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_day_trade_separator_portfolio_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/fl_day_trade_close_info"
        android:background="?attr/themeColorPeriwinkleLow"
        android:visibility="gone"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyXSmall">
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_day_trade_close_info"
            android:background="?attr/themeColorPeriwinkleLow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/spacing_6"
            android:layout_marginVertical="@dimen/spacing_6"
            app:drawableStartCompat="@drawable/ic_portfolio_clock"
            style="@style/TypeStyles.BodyXSmall"/>
    </FrameLayout>
    <TextView
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_title_day_trade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:text="@string/title_portfolio_day_trade"
        android:layout_marginStart="@dimen/spacing_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_day_trade_close_info"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
    <com.stockbit.feature.portfolio.component.DebtRatioProgressView
        android:gravity="center_vertical"
        android:id="@+id/debt_day_trade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title_day_trade"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title_day_trade"/>
</androidx.constraintlayout.widget.ConstraintLayout>
