<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_referral_tab_0"
    android:background="?attr/themeContentBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewFlipper
        android:id="@+id/vfShareholderMainAlert"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/plProgress"
            android:layout_width="@dimen/clickable_size_32"
            android:layout_height="@dimen/clickable_size_32"
            android:indeterminate="true"
            android:indeterminateTint="?attr/themeIconTintColor"
            style="?android:attr/progressBarStyle"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:layout_gravity="center"
                android:id="@+id/recyclerViewReferralList"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_null"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toTopOf="@+id/containerNextBtn"
                app:layout_constraintTop_toTopOf="parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/containerNextBtn"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_126"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <View
                    android:id="@+id/gap"
                    android:background="?attr/separatorColor"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_gap_xxxs"
                    android:layout_marginBottom="@dimen/item_gap_18"/>
                <LinearLayout
                    android:layout_gravity="start"
                    android:orientation="horizontal"
                    android:id="@+id/linearLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/item_gap_15"
                    android:layout_marginStart="@dimen/item_gap_24">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:srcCompat="@drawable/ic_coupon"/>
                    <TextView
                        android:textSize="@dimen/text_size_13"
                        android:layout_gravity="center"
                        android:id="@+id/textViewCouponDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/item_gap_4"
                        style="@style/SbTextView.BodyDefault"/>
                </LinearLayout>
                <Button
                    android:id="@+id/buttonNext"
                    android:background="@drawable/btn_green_enabled"
                    android:layout_height="@dimen/height_44"
                    android:layout_marginBottom="@dimen/item_gap_20"
                    android:text="@string/kode_referral_button_next"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginStart="@dimen/height_24"
                    android:layout_marginEnd="@dimen/height_24"
                    app:layout_constraintBottom_toTopOf="@+id/buttonCancel"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    style="@style/SbBtn.PrimaryFullWidthFloating"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center"
            android:id="@+id/recyclerViewReferralHistoryList"
            android:tag="binding_2"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="?attr/themeContentBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/imageViewEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/height_72"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_empty_new_friends"/>
            <TextView
                android:textSize="@dimen/text_size_18"
                android:id="@+id/textViewTitleEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_30"
                android:text="@string/kode_referral_teman_baru_title"
                android:layout_marginStart="@dimen/item_gap_30"
                android:layout_marginEnd="@dimen/item_gap_30"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageViewEmpty"
                style="@style/SbTextView.ListTitle"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:gravity="center"
                android:id="@+id/textViewEmptyDesc"
                android:layout_width="@dimen/item_gap_null"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_12"
                android:text="@string/kode_referral_teman_baru_desc"
                android:layout_marginStart="@dimen/item_gap_30"
                android:layout_marginEnd="@dimen/item_gap_30"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewTitleEmpty"
                style="@style/SbTextView.BodyDefault"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ViewFlipper>
</RelativeLayout>
