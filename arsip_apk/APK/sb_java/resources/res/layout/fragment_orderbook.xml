<?xml version="1.0" encoding="utf-8"?>
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vfFragmentOrderbook"
    android:tag="layout/fragment_orderbook_0"
    android:background="?attr/themeContentBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/sflOrderBookLoading"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/skeleton_company_profile_item"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvLayoutMain"
        android:clipToPadding="false"
        android:descendantFocusability="blocksDescendants"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:descendantFocusability="blocksDescendants"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.stockbit.android.extension.utils.FlexibleViewPager
                android:id="@+id/vp_portofolio_info"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <com.tbuonomo.viewpagerdotsindicator.SpringDotsIndicator
                android:layout_gravity="center_horizontal"
                android:id="@+id/dots_indicator_rv_portofolio_info"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="4dp"
                android:layout_marginTop="@dimen/spacing_12"
                app:dotsColor="@color/green_text"
                app:dotsCornerRadius="@dimen/spacing_20"
                app:dotsSize="@dimen/spacing_4"
                app:dotsSpacing="@dimen/spacing_6"
                app:dotsStrokeColor="?attr/titleTextColorDowngray"/>
            <View
                android:id="@+id/v_divider_portfolio_info"
                android:background="?attr/themeColorDividerThin"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_1"
                android:layout_marginTop="@dimen/spacing_14"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_order_book"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ImageView
                android:id="@+id/iv_orderbook_blur"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_20"
                android:src="?attr/themeBackgroundBlurryTable"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"/>
            <ViewStub
                android:id="@+id/view_stub_running_trade"
                android:layout="@layout/comp_orderbook_running_trade"
                android:inflatedId="@+id/inflated_running_trade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_trade_book"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ViewStub
                android:id="@+id/view_stub_broker_flow"
                android:layout="@layout/comp_orderbook_broker_flow"
                android:inflatedId="@+id/inflated_trade_book"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ViewStub
                android:id="@+id/view_stub_bandar_detector"
                android:tag="binding_2"
                android:layout="@layout/comp_orderbook_bandar_detector"
                android:inflatedId="@+id/inflated_bandar_detector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_broker_distribution"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_broker_daily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_fda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <ViewStub
                android:id="@+id/view_stub_historical_data"
                android:layout="@layout/comp_compose_layout"
                android:inflatedId="@+id/inflated_historical_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <RelativeLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/tv_orderbook_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/msg_loading_alert_company_info_error"
            android:layout_centerHorizontal="true"
            style="@style/SbTextView.BodyDefault"/>
        <Button
            android:id="@+id/btn_orderbook_reload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_s"
            android:text="@string/btn_click_to_refresh"
            android:layout_below="@+id/tv_orderbook_error"
            android:layout_centerHorizontal="true"
            style="@style/SbBtnBorderless.Small"/>
    </RelativeLayout>
</ViewFlipper>
