<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:tag="layout/row_trading_stockbit_exchange_fee_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/item_gap_12">
    <TextView
        android:id="@+id/tvTradingExchangeFeeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tvTradingExchangeFee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/n_dash"
        android:layout_toRightOf="@+id/tvTradingExchangeFeeTitle"
        android:layout_centerVertical="true"
        android:textAlignment="gravity"
        style="@style/TypeStyles.BodyRegular"/>
</RelativeLayout>
