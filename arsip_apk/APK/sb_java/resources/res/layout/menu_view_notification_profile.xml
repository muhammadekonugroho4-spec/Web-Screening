<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/clickable_size_32"
    android:layout_height="@dimen/clickable_size_32">
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/ib_menu_view_notification_profile_off"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="@dimen/clickable_size_32"
        android:layout_height="@dimen/clickable_size_32"
        android:contentDescription="@string/lbl_notification"
        app:srcCompat="@drawable/ic_notif_30"
        app:tint="?attr/themeIconTintColor"/>
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/ib_menu_view_notification_profile_on"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="@dimen/clickable_size_32"
        android:layout_height="@dimen/clickable_size_32"
        android:contentDescription="@string/lbl_notification"
        app:srcCompat="@drawable/ic_notif_30_on"
        app:tint="?attr/themeIconTintColor"/>
</FrameLayout>
