<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_container"
    android:tag="layout/dialog_livestream_share_more_0"
    android:background="@drawable/bg_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_share_post_header"
        android:paddingBottom="@dimen/spacing_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/view_share_post"
            android:background="@drawable/bg_rounded_gray_gray_bg"
            android:layout_width="@dimen/clickable_size_64"
            android:layout_height="@dimen/item_gap_xs"
            android:layout_marginTop="@dimen/spacing_6"
            android:layout_centerHorizontal="true"
            android:alpha="0.5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tv_share_post_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:text="@string/lbl_share"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            app:layout_constraintEnd_toEndOf="@+id/view_share_post"
            app:layout_constraintStart_toStartOf="@+id/view_share_post"
            app:layout_constraintTop_toBottomOf="@+id/view_share_post"
            style="@style/TypeStyles.HeadingRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_send_to"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/livestream_share_send_to"
            android:layout_marginStart="@dimen/spacing_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:id="@+id/tv_user_count"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.stockbit.common.uikit.StockbitSearchBar
        android:id="@+id/ssb_friend_search"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/item_gap_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_share_other"
        app:stockbitSearchBarHint="@string/placeholder_search"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_user_to_share"
        android:tag="binding_3"
        android:paddingBottom="@dimen/item_gap_8"
        android:focusableInTouchMode="true"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_compose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:id="@+id/view_separator_share_post"
            android:background="?attr/themeContentButtonBorder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_marginBottom="@dimen/clickable_size_16"
            app:layout_constraintBottom_toTopOf="@+id/et_share_post_write_comment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <EditText
            android:gravity="center_vertical"
            android:id="@+id/et_share_post_write_comment"
            android:background="@drawable/bg_rounded_edit_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/avatar_size_default"
            android:hint="@string/hint_share_stream_post_message"
            android:maxLines="7"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionDone"
            android:paddingStart="@dimen/item_gap_15"
            android:paddingEnd="@dimen/item_gap_15"
            android:layout_marginStart="@dimen/spacing_20"
            android:layout_marginEnd="@dimen/clickable_size_16"
            android:backgroundTint="@null"
            android:layout_marginVertical="@dimen/spacing_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_send"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/SbEditTextStyle.Medium"/>
        <ImageView
            android:id="@+id/iv_send"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintBottom_toBottomOf="@+id/et_share_post_write_comment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/et_share_post_write_comment"
            app:srcCompat="@drawable/ic_send_plane"/>
        <ProgressBar
            android:id="@+id/pb_send_loading"
            android:visibility="gone"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:layout_marginEnd="@dimen/item_gap_24"
            app:layout_constraintBottom_toBottomOf="@+id/et_share_post_write_comment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/et_share_post_write_comment"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
