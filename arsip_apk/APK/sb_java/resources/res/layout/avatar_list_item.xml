<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/avatar_list_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/item_gap_10">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/progressAvatarListItem"
        android:layout_width="@dimen/height_77"
        android:layout_height="@dimen/height_77"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.AppCompat.ProgressBar">
        <View
            android:background="@drawable/bg_circle_gray"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivAvatarListItemImage"
        android:visibility="gone"
        android:layout_width="@dimen/height_77"
        android:layout_height="@dimen/height_77"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CircleShape"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivAvatarListItemImageBorder"
        android:visibility="invisible"
        android:layout_width="@dimen/height_85"
        android:layout_height="@dimen/height_85"
        app:layout_constraintBottom_toBottomOf="@+id/ivAvatarListItemImage"
        app:layout_constraintEnd_toEndOf="@+id/ivAvatarListItemImage"
        app:layout_constraintStart_toStartOf="@+id/ivAvatarListItemImage"
        app:layout_constraintTop_toTopOf="@+id/ivAvatarListItemImage"
        app:srcCompat="@drawable/bg_selector_outline_circle_green_border"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivCheck"
        android:visibility="gone"
        android:layout_width="@dimen/height_24"
        android:layout_height="@dimen/height_24"
        android:src="@drawable/ic_checked_circle"
        app:layout_constraintBottom_toBottomOf="@+id/ivAvatarListItemImageBorder"
        app:layout_constraintEnd_toEndOf="@+id/ivAvatarListItemImageBorder"
        app:layout_constraintHorizontal_bias="0.92"
        app:layout_constraintStart_toStartOf="@+id/ivAvatarListItemImageBorder"
        app:layout_constraintTop_toTopOf="@+id/ivAvatarListItemImageBorder"
        app:layout_constraintVertical_bias="0.92"/>
</androidx.constraintlayout.widget.ConstraintLayout>
