<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_parent"
    android:tag="layout/dialog_watchlist_more_0"
    android:background="@drawable/bg_top_rounded"
    android:paddingBottom="@dimen/item_gap_32"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/item_gap_20">
    <View
        android:layout_gravity="center"
        android:id="@+id/v_handle"
        android:background="@drawable/bg_bottomsheetdialog_handle"
        android:layout_width="@dimen/uikit_bottomsheet_handle_width"
        android:layout_height="@dimen/uikit_bottomsheet_handle_height"
        android:layout_marginVertical="@dimen/spacing_12"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/clickable_size_32"
            android:layout_height="@dimen/clickable_size_32"
            android:tint="?attr/themeIconTintColor"
            android:paddingEnd="@dimen/item_gap_10"
            app:srcCompat="@drawable/ic_complete_view"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/button_watchlist_complete_view"
            android:layout_weight="1"
            style="@style/TypeStyles.BodyRegular"/>
        <com.stockbit.uikit.control.ControlToggleSwitch
            android:layout_gravity="center_vertical"
            android:id="@+id/ctw_complete_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/item_gap_10"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:tag="binding_1"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/clickable_size_32"
            android:layout_height="@dimen/clickable_size_32"
            android:tint="?attr/themeIconTintColor"
            android:paddingEnd="@dimen/item_gap_10"
            app:srcCompat="@drawable/ic_watchlist_label"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/watchlist_more_label"
            android:layout_weight="1"
            style="@style/TypeStyles.BodyRegular"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_label_badges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_label_badge_1"
                android:visibility="gone"
                android:layout_width="@dimen/clickable_size_16"
                android:layout_height="@dimen/clickable_size_16"
                android:layout_marginStart="6.4dp"/>
            <ImageView
                android:id="@+id/iv_label_badge_2"
                android:visibility="gone"
                android:layout_width="@dimen/clickable_size_16"
                android:layout_height="@dimen/clickable_size_16"
                android:layout_marginStart="6.4dp"/>
            <ImageView
                android:id="@+id/iv_label_badge_3"
                android:visibility="gone"
                android:layout_width="@dimen/clickable_size_16"
                android:layout_height="@dimen/clickable_size_16"
                android:layout_marginStart="6.4dp"/>
            <ImageView
                android:id="@+id/iv_label_badge_4"
                android:visibility="gone"
                android:layout_width="@dimen/clickable_size_16"
                android:layout_height="@dimen/clickable_size_16"
                android:layout_marginStart="6.4dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_label_chevron"
            android:layout_width="5dp"
            android:layout_height="10dp"
            android:tint="?attr/themeIconTintColor"
            android:layout_marginStart="9.5dp"
            app:srcCompat="@drawable/ic_watchlist_show_label_next"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_arrange_favorite"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_watchlist_favorite"
            android:layout_width="@dimen/height_20"
            android:layout_height="@dimen/width_20"
            android:contentDescription="@string/btn_following"
            android:layout_marginEnd="@dimen/item_gap_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_star_favorite_inactive"/>
        <TextView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_arrange_my_favorite"
            style="@style/TypeStyles.BodyRegular"/>
    </LinearLayout>
    <View
        android:id="@+id/v_divider"
        android:background="?attr/themeColorModalsDividerThin"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/item_gap_32"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:tag="binding_3"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/clickable_size_32"
            android:layout_height="@dimen/clickable_size_32"
            android:tint="?attr/themeIconTintColor"
            android:paddingEnd="@dimen/item_gap_10"
            app:srcCompat="@drawable/ic_font_size"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/button_watchlist_font_size"
            android:layout_weight="1"
            style="@style/TypeStyles.BodyRegular"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/themeColorTextSecondary"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_font_size_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/item_gap_10"
            style="@style/TypeStyles.BodyRegular"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:tag="binding_4"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:paddingRight="10dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:tint="?attr/themeIconTintColor"
            app:srcCompat="@drawable/ic_android_compose_black_24dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/watchlist_more_edit_sort"
            android:layout_weight="1"
            style="@style/TypeStyles.BodyRegular"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/ll_delete_container"
        android:tag="binding_5"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:paddingRight="10dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:tint="@color/red_item"
            android:paddingStart="2dp"
            app:srcCompat="@drawable/ic_trash"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/red_item"
            android:layout_gravity="center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/button_watchlist_delete"
            android:layout_weight="1"
            style="@style/TypeStyles.BodyRegular"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
