<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/item_stream_research_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_item_research"
        android:paddingTop="@dimen/spacing_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_20">
        <ImageView
            android:id="@+id/iv_stream_pinned"
            android:tag="binding_1"
            android:visibility="gone"
            android:layout_width="@dimen/width_12"
            android:layout_height="@dimen/height_12"
            android:scaleType="centerInside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_stream_pinned"
            app:tint="?attr/themeColorIconDefault"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:id="@+id/tv_stream_pinned"
            android:tag="binding_2"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/lbl_pinned_post_by_stockbit"
            android:layout_marginStart="@dimen/spacing_4"
            app:layout_constraintBottom_toBottomOf="@+id/iv_stream_pinned"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_stream_pinned"
            app:layout_constraintTop_toTopOf="@+id/iv_stream_pinned"
            style="@style/TypeStyles.BodyXSmall"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tv_research_title"
            android:tag="binding_3"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:maxLines="3"
            android:layout_marginEnd="@dimen/spacing_16"
            app:layout_constraintEnd_toStartOf="@+id/cv_research_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_stream_pinned"
            app:layout_goneMarginTop="@dimen/spacing_0"
            style="@style/TypeStyles.HeadingLarge"/>
        <ImageView
            android:id="@+id/iv_research_icon"
            android:tag="binding_4"
            android:layout_width="@dimen/width_16"
            android:layout_height="@dimen/height_16"
            android:layout_marginTop="@dimen/item_gap_xs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_research_title"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:ellipsize="end"
            android:id="@+id/tv_research_type"
            android:tag="binding_5"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="@dimen/spacing_0"
            android:maxLines="1"
            android:layout_marginStart="@dimen/spacing_4"
            android:layout_marginEnd="@dimen/spacing_16"
            app:layout_constraintBottom_toBottomOf="@+id/iv_research_icon"
            app:layout_constraintEnd_toStartOf="@+id/cv_research_image"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/iv_research_icon"
            app:layout_constraintTop_toTopOf="@+id/iv_research_icon"
            style="@style/TypeStyles.BodyXSmall"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_research_image"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="@dimen/clickable_size_75"
            app:cardCornerRadius="@dimen/radius_4"
            app:cardElevation="@dimen/spacing_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="w,4:3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_research_title">
            <ImageView
                android:id="@+id/iv_research_image"
                android:tag="binding_6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.stockbit.uikit.divider.SBDivider
        android:id="@+id/v_border"
        android:tag="binding_7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:layout_marginHorizontal="@dimen/spacing_20"
        app:dividerVariant="thin_grey"/>
    <com.stockbit.uikit.divider.SBDivider
        android:id="@+id/v_border_stream"
        android:tag="binding_8"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        app:dividerVariant="thick_grey"/>
</LinearLayout>
