<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_setting_biometric_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:layout_scrollFlags="enterAlways|scroll">
        <TextView
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_setting_menu_biometric_login"
            style="@style/TypeStyles.HeadingLarge"/>
    </androidx.appcompat.widget.Toolbar>
    <ViewFlipper
        android:id="@+id/vf_display"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_biometric_setting"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-7dp"
                android:layout_marginBottom="-7dp"
                android:indeterminate="true"
                style="?android:attr/progressBarStyleHorizontal"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/themeContentTextColor"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center"
                    android:paddingTop="@dimen/item_gap_20"
                    android:paddingBottom="@dimen/item_gap_20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/item_gap_l"
                    android:text="@string/setting_biometric_login_stockbit"
                    android:layout_toLeftOf="@+id/sc_biometric_social"
                    android:textAlignment="gravity"
                    android:layout_marginStart="@dimen/item_gap_l"
                    android:layout_alignParentStart="true"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"
                    style="@style/TypeStyles.BodyLarge"/>
                <com.stockbit.uikit.control.ControlToggleSwitch
                    android:enabled="false"
                    android:id="@+id/sc_biometric_social"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/item_gap_m"
                    android:layout_marginEnd="@dimen/item_gap_m"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:switchType="Medium"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:tag="binding_2"
                android:background="?attr/themeColorDividerThin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_xxxs"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?attr/themeContentTextColor"
                    android:gravity="start|center_vertical"
                    android:layout_gravity="center"
                    android:paddingTop="@dimen/item_gap_20"
                    android:paddingBottom="@dimen/item_gap_20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/item_gap_l"
                    android:text="@string/setting_biometric_pin_stockbit_securities"
                    android:layout_toLeftOf="@+id/sc_biometric_securities"
                    android:textAlignment="gravity"
                    android:layout_marginStart="@dimen/item_gap_l"
                    android:layout_alignParentStart="true"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"
                    style="@style/TypeStyles.BodyLarge"/>
                <com.stockbit.uikit.control.ControlToggleSwitch
                    android:enabled="false"
                    android:id="@+id/sc_biometric_securities"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/item_gap_m"
                    android:layout_marginEnd="@dimen/item_gap_m"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:switchType="Medium"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </ViewFlipper>
</LinearLayout>
