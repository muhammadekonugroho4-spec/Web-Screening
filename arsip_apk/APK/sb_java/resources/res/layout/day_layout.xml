<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/day_text_size"
        android:textColor="?attr/titleTextColorHighgray"
        android:gravity="center"
        android:id="@+id/txt_day"
        android:background="@android:color/transparent"
        android:layout_width="@dimen/day_circle_width"
        android:layout_height="@dimen/day_circle_height"
        style="@style/SbTextView.ListTitle.Midgray.Normal"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="@dimen/day_image_layout_padding_top"
        android:paddingBottom="@dimen/day_image_layout_padding_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/img_event_tag"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="0x7f0803bc"/>
    </LinearLayout>
</LinearLayout>
