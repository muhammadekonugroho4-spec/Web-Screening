<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ViewFlipper
        android:id="@+id/vf_multiple_chart_switcher"
        android:layout_width="0dp"
        android:layout_height="205dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.stockbit.component.chart.view.candle.SingleScrollCandleChartView
            android:id="@+id/candle_chart_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <com.stockbit.component.chart.view.SingleScrollChartView
            android:id="@+id/line_chart_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/multiple_chart_empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_chart_empty"
                android:layout_width="@dimen/width_120"
                android:layout_height="@dimen/height_90"
                android:scaleType="centerInside"
                app:srcCompat="?attr/themeIconEmptyCompanyChart"/>
            <TextView
                android:id="@+id/tv_chart_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="@string/lbl_company_no_chart_data_available"
                style="@style/SbTextView.CaptionSecondary"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/multiple_chart_error_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_chart_error"
                android:layout_width="@dimen/width_120"
                android:layout_height="@dimen/height_90"
                android:scaleType="centerInside"
                app:srcCompat="?attr/themeIconEmptyCompanyChart"/>
            <TextView
                android:id="@+id/tv_chart_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="@string/title_error_unable_load_data"
                style="@style/SbTextView.CaptionSecondary"/>
            <TextView
                android:id="@+id/btn_try_again"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_try_again_en"
                android:drawablePadding="@dimen/spacing_4"
                android:paddingHorizontal="@dimen/spacing_20"
                android:paddingVertical="@dimen/spacing_6"
                app:drawableStartCompat="?attr/themeIconRefresh"
                style="@style/TypeStyles.HeadingSmall.Green"/>
        </LinearLayout>
    </ViewFlipper>
    <FrameLayout
        android:id="@+id/fl_trading_view"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="32dp"
        android:layout_height="28dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="@+id/vf_multiple_chart_switcher"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vf_multiple_chart_switcher">
        <ImageView
            android:layout_gravity="top|center_horizontal"
            android:id="@+id/iv_trading_view"
            android:layout_width="@dimen/spacing_20"
            android:layout_height="@dimen/spacing_20"
            android:layout_marginTop="2dp"
            android:src="?attr/themeIconCompanyChartbit"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
