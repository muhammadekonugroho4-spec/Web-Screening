<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_text_field_box_layout"
    android:tag="layout/comp_input_text_field_box_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gl_text_field_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="12dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_text_field_input_layout"
        android:background="@drawable/bg_box_default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/tiet_text_field_input"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:paddingVertical="8dp"
            app:layout_constraintEnd_toStartOf="@+id/bar_text_field"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Sb.Widget.TextInputEditText"/>
        <androidx.constraintlayout.widget.Barrier
            android:orientation="vertical"
            android:id="@+id/bar_text_field"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="start"
            app:constraint_referenced_ids="tv_text_field_counter, iv_text_field_replaceable_icon"/>
        <TextView
            android:textColor="?attr/themeColorTextTetriary"
            android:id="@+id/tv_text_field_counter"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_text_field_delete_all_icon"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintStart_toEndOf="@+id/tiet_text_field_input"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.BodyRegular"/>
        <ImageView
            android:id="@+id/iv_text_field_delete_all_icon"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/uikit_ic_stockbit_search_bar_close_fill"
            android:layout_marginEnd="@dimen/spacing_12"
            app:layout_constraintBottom_toBottomOf="@+id/tiet_text_field_input"
            app:layout_constraintEnd_toStartOf="@+id/iv_text_field_replaceable_icon"
            app:layout_constraintStart_toEndOf="@+id/tv_text_field_counter"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_text_field_replaceable_icon"
            android:padding="4dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/v_text_field_label_background"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_text_field_label"
        app:layout_constraintEnd_toEndOf="@+id/tv_text_field_label"
        app:layout_constraintStart_toStartOf="@+id/tv_text_field_label"
        app:layout_constraintTop_toTopOf="@+id/tv_text_field_label"/>
    <TextView
        android:id="@+id/tv_text_field_label"
        android:background="?attr/themeContentBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toTopOf="@+id/cl_text_field_input_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cl_text_field_input_layout"
        app:layout_constraintWidth_default="wrap"
        style="@style/TypeStyles.BodyXSmall"/>
    <ImageView
        android:id="@+id/iv_text_field_error"
        android:paddingTop="2dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_input_error"
        app:layout_constraintStart_toStartOf="@+id/gl_text_field_start"
        app:layout_constraintTop_toBottomOf="@+id/cl_text_field_input_layout"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:id="@+id/tv_text_field_helper"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_text_field_button"
        app:layout_constraintStart_toEndOf="@+id/iv_text_field_error"
        app:layout_constraintTop_toTopOf="@+id/iv_text_field_error"
        app:layout_goneMarginEnd="0dp"
        app:layout_goneMarginStart="0dp"
        app:layout_goneMarginTop="8dp"
        style="@style/TypeStyles.BodyXSmall"/>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="?attr/themeColorTextGreen"
        android:id="@+id/tv_text_field_button"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/sb_bitsans_font"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_text_field_input_layout"/>
    <TextView
        android:id="@+id/tv_text_field_caption"
        android:background="@drawable/bg_input_text_field_caption"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_text_field_helper"
        app:layout_goneMarginTop="8dp"
        style="@style/TypeStyles.BodyXSmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
