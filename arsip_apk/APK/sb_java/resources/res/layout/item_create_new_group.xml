<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_create_new_group_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_divider_top"
        android:background="?attr/themeDivider"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv_create_new_group"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/chat_create_new_group"
        android:drawablePadding="@dimen/item_gap_16"
        android:paddingHorizontal="@dimen/item_gap_20"
        android:paddingVertical="@dimen/item_gap_12"
        app:drawableStartCompat="@drawable/ic_create_new_group"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_divider_top"
        style="@style/TypeStyles.HeadingRegular"/>
    <View
        android:id="@+id/v_divider_bottom"
        android:background="?attr/themeDivider"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_create_new_group"/>
</androidx.constraintlayout.widget.ConstraintLayout>
