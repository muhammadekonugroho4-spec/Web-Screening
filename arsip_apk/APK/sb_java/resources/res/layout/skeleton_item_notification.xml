<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/relativeLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/viewNotifItemSkeletonAvatar"
        android:background="@drawable/ic_circle_grey"
        android:layout_width="@dimen/avatar_size_38"
        android:layout_height="@dimen/avatar_size_38"
        android:layout_marginTop="@dimen/item_gap_14"
        android:layout_marginBottom="@dimen/item_gap_14"
        android:layout_marginStart="@dimen/item_gap_20"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/viewNotifItemSkeletonText1"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_l"
        android:layout_marginStart="@dimen/item_gap_12"
        android:layout_marginEnd="@dimen/item_gap_20"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/viewNotifItemSkeletonAvatar"
        app:layout_constraintTop_toTopOf="@+id/viewNotifItemSkeletonAvatar"/>
    <View
        android:id="@+id/viewNotifItemSkeletonText3"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_l"
        android:layout_marginTop="@dimen/item_gap_4"
        android:layout_marginStart="@dimen/item_gap_12"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintBottom_toBottomOf="@+id/viewNotifItemSkeletonAvatar"
        app:layout_constraintEnd_toStartOf="@+id/guideline"
        app:layout_constraintStart_toEndOf="@+id/viewNotifItemSkeletonAvatar"
        app:layout_constraintTop_toBottomOf="@+id/viewNotifItemSkeletonText1"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.7"/>
</androidx.constraintlayout.widget.ConstraintLayout>
