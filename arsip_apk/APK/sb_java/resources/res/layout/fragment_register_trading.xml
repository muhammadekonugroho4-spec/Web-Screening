<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_register_trading_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:tag="binding_1"
        android:background="?attr/themeContentBackground"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:elevation="@dimen/item_gap_null">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/genericToolbar"
            android:paddingLeft="@dimen/item_gap_null"
            android:paddingRight="@dimen/item_gap_null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:contentInsetLeft="@dimen/item_gap_null"
            app:contentInsetStart="@dimen/item_gap_null"
            app:contentInsetStartWithNavigation="@dimen/item_gap_null"
            app:elevation="@dimen/item_gap_null">
            <RelativeLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/parentToolbarContentContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize">
                <TextView
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:id="@+id/tvToolbarTitleName"
                    android:paddingLeft="@dimen/item_gap_l"
                    android:paddingRight="@dimen/item_gap_l"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_open_trading_account"
                    android:singleLine="true"
                    android:layout_centerHorizontal="true"
                    android:textAlignment="gravity"
                    style="@style/SbTextView.PageTitle"/>
            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="1dp"
        android:layout_below="@+id/progressBar">
        <LinearLayout
            android:orientation="vertical"
            android:tag="binding_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include layout="@layout/skeleton_form_banner"/>
            <View
                android:background="@drawable/bg_rounded_gray"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_40"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_marginStart="@dimen/clickable_size_16"
                android:layout_marginEnd="@dimen/item_gap_20"
                android:backgroundTint="?attr/themeSeparatorGapColor"/>
            <View
                android:background="@drawable/bg_rounded_gray"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_40"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_marginStart="@dimen/clickable_size_16"
                android:layout_marginEnd="@dimen/item_gap_20"
                android:backgroundTint="?attr/themeSeparatorGapColor"/>
            <View
                android:background="@drawable/bg_rounded_gray"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_40"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_marginStart="@dimen/clickable_size_16"
                android:layout_marginEnd="@dimen/item_gap_20"
                android:backgroundTint="?attr/themeSeparatorGapColor"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <ProgressBar
        android:id="@+id/progressBar"
        android:tag="binding_4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_l"
        android:indeterminate="false"
        android:layout_below="@+id/appBar"
        android:progressTint="@color/green_text"
        android:progressBackgroundTint="@color/green_text"
        style="?android:attr/progressBarStyleHorizontal"/>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fcv_registration"
        android:tag="binding_5"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/progressBar"/>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fcv_photo_quality_check"
        android:background="?attr/themeContentBackground"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
