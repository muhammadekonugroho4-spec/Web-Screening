<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/item_stocks_watchlist_filter_empty_0"
    android:background="@drawable/bg_border_gray_rounded"
    android:paddingTop="@dimen/spacing_12"
    android:paddingBottom="@dimen/spacing_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_20"
    android:paddingHorizontal="@dimen/spacing_16">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_34"
        android:text="@string/my_watchlist_filter"
        style="@style/TypeStyles.HeadingRegular"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/iv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/ic_watchlist_empty"/>
    <TextView
        android:textSize="@dimen/text_size_13"
        android:layout_gravity="center"
        android:id="@+id/tv_search_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_marginBottom="@dimen/spacing_margin_watchlist_empty_bottom"
        android:text="@string/title_watchlist_empty"
        style="@style/TypeStyles.Secondary"/>
</LinearLayout>
