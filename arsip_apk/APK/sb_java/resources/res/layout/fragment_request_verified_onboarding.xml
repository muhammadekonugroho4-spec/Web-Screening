<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_request_verified_onboarding_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/genericToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_scrollFlags="enterAlways|scroll"
        app:titleTextAppearance="@style/SbTextView.PageTitle">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/request_verified_badge"
            app:autoSizeMaxTextSize="@dimen/text_title"
            app:autoSizeMinTextSize="@dimen/text_body"
            app:autoSizeTextType="none"
            style="@style/SbTextView.PageTitle"/>
    </androidx.appcompat.widget.Toolbar>
    <ScrollView
        android:id="@+id/sv_onboarding"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/constraintLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/genericToolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_onboarding"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="1:0.76"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/img_onboarding"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_size_22"
                android:id="@+id/tv_verified_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/title_verified_badge"
                android:layout_marginStart="@dimen/item_gap_30"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_onboarding"
                style="@style/SbTextView.BodyDefault.Highempasis.Bold"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_msg_verified_badge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_21"
                android:layout_marginBottom="8dp"
                android:text="@string/text_verified_badge_description"
                android:layout_marginEnd="@dimen/item_gap_30"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tv_verified_badge"
                app:layout_constraintTop_toBottomOf="@+id/tv_verified_badge"
                style="@style/SbTextView.ListTitle.Normal"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_20"
        android:paddingStart="@dimen/item_gap_28"
        android:paddingEnd="@dimen/item_gap_28"
        app:layout_constraintBottom_toTopOf="@+id/rlRegisterPassword"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_info_verified_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:elevation="0dp"
            app:cardBackgroundColor="?attr/bg_card_verified_badge"
            app:cardCornerRadius="@dimen/item_gap_4"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:paddingTop="@dimen/item_gap_12"
                android:paddingBottom="@dimen/item_gap_l"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/item_gap_12"
                android:paddingEnd="@dimen/item_gap_12">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/imageView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_bulb_green"/>
                <TextView
                    android:layout_gravity="center"
                    android:id="@+id/tv_info_verified_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_verified_badge_note"
                    android:layout_marginStart="@dimen/item_gap_12"
                    style="@style/SbTextView.Caption"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.stockbit.common.uikit.StockbitLoadingButton
        android:id="@+id/rlRegisterPassword"
        android:tag="binding_1"
        android:background="@drawable/bg_selector_btn_green"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        android:layout_alignParentBottom="true"
        app:buttonText="@string/button_next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_status"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ProgressBar
        android:id="@+id/pbRegisterTrading"
        android:tag="binding_3"
        android:layout_width="@dimen/clickable_size_32"
        android:layout_height="@dimen/clickable_size_32"
        android:indeterminate="true"
        android:layout_centerHorizontal="true"
        android:progressTint="@color/green_text"
        android:indeterminateTint="@color/green_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/genericToolbar"
        style="@style/Widget.AppCompat.ProgressBar"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_verified_badge_onboarding"
        android:tag="binding_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="sv_onboarding,constraintLayout,rlRegisterPassword"/>
</androidx.constraintlayout.widget.ConstraintLayout>
