<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_setting_profile_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/settingActivityToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:layout_scrollFlags="enterAlways|scroll">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_account_public_profile"
            style="@style/SbTextView.BodyDefault.Bold"/>
    </androidx.appcompat.widget.Toolbar>
    <View
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"/>
    <RelativeLayout
        android:id="@+id/rl_setting_edit_profile"
        android:tag="binding_1"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_50">
        <TextView
            android:textSize="@dimen/text_size_14"
            android:id="@+id/tv_setting_edit_profile"
            android:paddingLeft="@dimen/item_gap_s"
            android:paddingRight="@dimen/item_gap_m"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_public_edit"
            android:layout_toLeftOf="@+id/ivSettingEditProfile"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/item_gap_20"
            style="@style/SbTextView.BodyDefault"/>
        <ImageView
            android:id="@+id/ivSettingEditProfile"
            android:padding="@dimen/item_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_panah_set"/>
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_request_verified_badge"
        android:tag="binding_2"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_50">
        <TextView
            android:textSize="@dimen/text_size_14"
            android:id="@+id/tv_request_verified"
            android:paddingLeft="@dimen/item_gap_s"
            android:paddingRight="@dimen/item_gap_m"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_public_verify_badge"
            android:layout_toLeftOf="@+id/iv_request_verified"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/item_gap_20"
            style="@style/SbTextView.BodyDefault"/>
        <ImageView
            android:id="@+id/iv_request_verified"
            android:padding="@dimen/item_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_panah_set"/>
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_delete_account"
        android:tag="binding_3"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_50">
        <TextView
            android:textSize="@dimen/text_size_14"
            android:id="@+id/tv_delete_account"
            android:paddingLeft="@dimen/item_gap_s"
            android:paddingRight="@dimen/item_gap_m"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_public_delete_account"
            android:layout_toLeftOf="@+id/iv_delete_account"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/item_gap_20"
            style="@style/SbTextView.BodyDefault"/>
        <ImageView
            android:id="@+id/iv_delete_account"
            android:padding="@dimen/item_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_panah_set"/>
        <View
            android:background="?attr/themeSeparatorGapColor"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</LinearLayout>
