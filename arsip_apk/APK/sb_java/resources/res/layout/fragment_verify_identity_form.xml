<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_verify_identity_form_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stockbit.uikit.topbar.TopbarStockbitTitle
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:topBarTitleFourthIcon="?attr/themeIconLiveSupport"
        app:topBarTitleTitle="@string/personal_amend_title_two_step_verification"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="@dimen/spacing_36"
            android:paddingBottom="@dimen/spacing_20"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/spacing_20">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="?attr/themeIconTwoStepVerification"/>
            <TextView
                android:textSize="@dimen/text_size_18"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:text="@string/personal_amend_title_verify_your_identity"
                android:lineSpacingExtra="-2sp"
                android:translationY="-1.04sp"
                android:textAlignment="gravity"
                android:layout_marginEnd="@dimen/item_gap_20"
                android:lineHeight="24sp"
                style="@style/TypeStyles.HeadlineRegular"/>
            <TextView
                android:textSize="14sp"
                android:id="@+id/tv_subtitle"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_m"
                android:lineSpacingExtra="2sp"
                android:translationY="-0.97sp"
                android:lineHeight="19sp"
                style="@style/TypeStyles.BodyRegular"/>
            <com.stockbit.uikit.input.TextFieldBox
                android:textColor="?attr/themeContentTextColor"
                android:id="@+id/tfb_id_card"
                android:tag="binding_2"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_32"
                android:includeFontPadding="false"
                android:inputType="textCapCharacters"
                app:inputLabel="@string/personal_amend_label_e_ktp_passport_number"/>
            <com.stockbit.uikit.input.DropdownBox
                android:textColor="?attr/themeContentTextColor"
                android:id="@+id/tfb_date_of_birth"
                android:tag="binding_3"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:includeFontPadding="false"
                android:inputType="number"
                app:inputLabel="@string/personal_amend_label_date_of_birth"/>
            <com.stockbit.uikit.input.TextFieldBox
                android:textColor="?attr/themeContentTextColor"
                android:id="@+id/tfb_bank_account_number"
                android:tag="binding_4"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_32"
                android:includeFontPadding="false"
                android:inputType="number"
                app:inputLabel="@string/personal_amend_label_disbursement_bank_account_number"/>
            <com.stockbit.uikit.input.TextFieldBox
                android:textColor="?attr/themeContentTextColor"
                android:id="@+id/tfb_mother_name"
                android:tag="binding_5"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_32"
                android:includeFontPadding="false"
                app:inputLabel="@string/personal_amend_label_mothers_maiden_name"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.stockbit.uikit.button.PrimaryStickyButton
        android:id="@+id/btn_submit"
        android:tag="binding_6"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_44"
        android:text="@string/next"
        android:allowClickWhenDisabled="false"/>
</LinearLayout>
