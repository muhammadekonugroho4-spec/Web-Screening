<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_register_trading_pad_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/clickable_size_56">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/aciv_icon"
                    android:layout_width="@dimen/item_gap_58"
                    android:layout_height="@dimen/item_gap_58"
                    android:layout_marginTop="@dimen/item_gap_20"
                    android:layout_marginStart="@dimen/item_gap_20"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/actv_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/clickable_size_16"
                    android:layout_marginEnd="@dimen/clickable_size_16"
                    app:layout_constraintBottom_toTopOf="@+id/actv_desc"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/aciv_icon"
                    app:layout_constraintTop_toTopOf="@+id/aciv_icon"
                    app:layout_constraintVertical_chainStyle="packed"
                    style="@style/TypeStyles.HeadingLarge"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:id="@+id/actv_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="@dimen/clickable_size_16"
                    android:layout_marginEnd="@dimen/clickable_size_16"
                    app:layout_constraintBottom_toBottomOf="@+id/aciv_icon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/aciv_icon"
                    app:layout_constraintTop_toBottomOf="@+id/actv_title"
                    style="@style/TypeStyles.BodyXSmall"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_alert"
                android:padding="@dimen/item_gap_16"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20"
                app:layout_constraintTop_toBottomOf="@+id/cl_intro"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_marginBottom="@dimen/item_gap_20"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_alert"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <com.stockbit.uikit.buttons.PrimaryButton
        android:id="@+id/btn_next"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        android:text="@string/button_next"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
