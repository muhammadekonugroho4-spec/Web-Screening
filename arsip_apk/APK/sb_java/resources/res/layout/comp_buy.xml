<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/cl_comp_buy"
    android:tag="layout/comp_buy_0"
    android:background="?attr/themeContentBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/spacing_16"
    android:paddingEnd="@dimen/spacing_16">
    <RelativeLayout
        android:id="@+id/rl_buy_header"
        android:background="@drawable/border_red"
        android:paddingTop="@dimen/spacing_12"
        android:paddingBottom="@dimen/spacing_12"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/tv_title_deposit_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/buy_title_deposit_now"
            style="@style/TypeStyles.HeadingXSmall"/>
        <TextView
            android:id="@+id/tv_trading_not_enough"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/buy_balance_not_enough"
            android:layout_below="@+id/tv_title_deposit_now"
            style="@style/SbTextView.Helper.Error"/>
        <TextView
            android:id="@+id/tv_deposit"
            android:background="@drawable/bg_card_green_light"
            android:paddingTop="@dimen/spacing_6"
            android:paddingBottom="@dimen/spacing_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_deposit_title"
            android:layout_centerVertical="true"
            android:textAlignment="gravity"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_16"
            android:layout_alignParentEnd="true"
            style="@style/SbTextView.Label.Active"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rl_buy_content"
        android:background="@drawable/border_gray_rounded_4dp"
        android:paddingTop="@dimen/item_gap_xs"
        android:paddingBottom="@dimen/item_gap_xs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_buy_header">
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="tv_trading_balance_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="start|center_vertical"
            android:id="@+id/tv_trading_balance_title"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="@dimen/item_gap_m"
            android:paddingBottom="@dimen/item_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/buy_title_trading_balance"
            android:textAlignment="gravity"
            app:layout_constraintBottom_toTopOf="@+id/barrier_investment"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/barrier_balance"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="right"
            android:id="@+id/tv_total_balance_value"
            android:paddingLeft="@dimen/spacing_6"
            android:paddingTop="@dimen/spacing_16"
            android:paddingRight="@dimen/spacing_6"
            android:paddingBottom="@dimen/spacing_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_indonesian_currency"
            android:maxLines="1"
            android:layout_toLeftOf="@+id/tv_total_balance"
            android:textAlignment="gravity"
            app:layout_constraintBottom_toTopOf="@+id/barrier_investment"
            app:layout_constraintEnd_toStartOf="@+id/tv_total_balance"
            app:layout_constraintTop_toTopOf="@+id/barrier_balance"
            style="@style/TypeStyles.HeadingLarge"/>
        <TextView
            android:gravity="right"
            android:id="@+id/tv_total_balance"
            android:paddingTop="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/width_162"
            android:minWidth="@dimen/spacing_50"
            android:minHeight="@dimen/spacing_36"
            android:hint="@string/n_dash"
            android:textAlignment="gravity"
            app:layout_constraintBottom_toTopOf="@+id/barrier_investment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/barrier_balance"
            style="@style/TypeStyles.HeadingLarge"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_investment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="tv_title_amount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_total_balance"/>
        <TextView
            android:id="@+id/tv_title_amount"
            android:paddingTop="@dimen/item_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/orderlist_detail_title_investment_without_fee"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier_investment"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="?attr/themeColorTextSecondary"
            android:paddingBottom="@dimen/item_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/orderlist_detail_title_with_fee"
            android:layout_below="@+id/tv_title_amount"
            app:layout_constraintBottom_toTopOf="@+id/barrier_trigger_price"
            app:layout_constraintStart_toStartOf="@+id/tv_title_amount"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_amount"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="right"
            android:id="@+id/tv_rupiah_investment_title"
            android:paddingLeft="@dimen/spacing_6"
            android:paddingTop="@dimen/spacing_16"
            android:paddingRight="@dimen/spacing_6"
            android:paddingBottom="@dimen/spacing_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_indonesian_currency"
            android:maxLines="1"
            android:textAlignment="gravity"
            app:layout_constraintEnd_toStartOf="@+id/et_total_amount"
            app:layout_constraintTop_toBottomOf="@+id/barrier_investment"
            style="@style/TypeStyles.HeadingLarge"/>
        <EditText
            android:gravity="end|center_vertical"
            android:id="@+id/et_total_amount"
            android:background="@null"
            android:paddingTop="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_16"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/width_162"
            android:minWidth="@dimen/spacing_50"
            android:minHeight="@dimen/spacing_36"
            android:hint="@string/n_dash"
            android:cursorVisible="false"
            android:digits="0123456789.,"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:inputType="numberDecimal"
            android:imeOptions="actionNone"
            android:textAlignment="gravity"
            android:layout_alignParentEnd="true"
            android:importantForAutofill="no"
            app:layout_constraintBottom_toTopOf="@+id/barrier_trigger_price"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier_investment"
            style="@style/TypeStyles.HeadingLarge"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_trigger_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="rl_target_price"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_total_amount"/>
        <RelativeLayout
            android:id="@+id/rl_target_price"
            android:paddingTop="@dimen/item_gap_m"
            android:paddingBottom="@dimen/item_gap_m"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/barrier_price"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier_trigger_price">
            <TextView
                android:id="@+id/title_target_price"
                android:paddingTop="@dimen/item_gap_m"
                android:paddingBottom="@dimen/item_gap_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/smart_order_trigger_price"
                style="@style/TypeStyles.BodyRegular"/>
            <ImageView
                android:id="@+id/target_price_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/spacing_6"
                android:layout_toRightOf="@+id/title_target_price"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ic_info"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/btn_target_price"
                android:background="@drawable/border_gray_rounded_white_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/target_price_amount_group"
                android:layout_centerVertical="true"
                android:paddingHorizontal="@dimen/item_gap_4">
                <TextView
                    android:gravity="end"
                    android:id="@+id/tv_target_price"
                    android:paddingTop="@dimen/item_gap_m"
                    android:paddingBottom="@dimen/item_gap_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/less_than_equal"
                    android:textAlignment="gravity"
                    android:layout_marginStart="@dimen/spacing_6"
                    style="@style/TypeStyles.BodyRegular"/>
                <ImageView
                    android:gravity="end"
                    android:layout_gravity="center"
                    android:paddingTop="@dimen/spacing_2"
                    android:layout_width="@dimen/spacing_12"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/spacing_4"
                    app:srcCompat="@drawable/ic_chevron_down_secondary"
                    app:tint="@color/gray_text"
                    style="@style/TypeStyles.BodyRegular"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/target_price_amount_group"
                android:background="@drawable/border_gray_rounded_white_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/spacing_6"
                android:layout_alignParentEnd="true"
                android:layout_marginVertical="@dimen/spacing_0"
                android:paddingHorizontal="@dimen/spacing_4">
                <EditText
                    android:gravity="center"
                    android:id="@+id/target_price_amount"
                    android:background="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/width_100"
                    android:hint="@string/n_dash"
                    android:maxLines="1"
                    android:selectAllOnFocus="true"
                    android:maxLength="10"
                    android:digits="0123456789"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionNext"
                    android:paddingVertical="@dimen/item_gap_m"
                    style="@style/TypeStyles.BodyRegular"/>
            </LinearLayout>
        </RelativeLayout>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="tv_title_price"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_total_amount"/>
        <TextView
            android:id="@+id/tv_title_price"
            android:paddingTop="@dimen/item_gap_m"
            android:paddingBottom="@dimen/item_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/buy_title_limit_price"
            app:layout_constraintBottom_toTopOf="@+id/barrier_lot"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier_price"
            style="@style/TypeStyles.BodyRegular"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/btn_min_price"
            android:paddingTop="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/spacing_36"
            android:textAlignment="gravity"
            android:paddingHorizontal="@dimen/spacing_8"
            app:layout_constraintBottom_toTopOf="@+id/barrier_lot"
            app:layout_constraintEnd_toStartOf="@+id/et_total_price"
            app:layout_constraintTop_toBottomOf="@+id/barrier_price"
            app:srcCompat="?attr/iconMin"/>
        <EditText
            android:gravity="center"
            android:id="@+id/et_total_price"
            android:background="@null"
            android:paddingTop="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/width_162"
            android:minWidth="@dimen/width_100"
            android:minHeight="@dimen/spacing_36"
            android:hint="@string/n_dash"
            android:selectAllOnFocus="true"
            android:digits="0123456789"
            android:inputType="numberDecimal"
            android:imeOptions="actionNext"
            android:textAlignment="gravity"
            app:layout_constraintBottom_toTopOf="@+id/barrier_lot"
            app:layout_constraintEnd_toStartOf="@+id/btn_plus_price"
            app:layout_constraintTop_toBottomOf="@+id/barrier_price"
            style="@style/TypeStyles.BodyRegular"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/btn_plus_price"
            android:paddingLeft="@dimen/spacing_12"
            android:paddingTop="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/spacing_36"
            android:textAlignment="gravity"
            android:layout_alignParentEnd="true"
            app:layout_constraintBottom_toTopOf="@+id/barrier_lot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier_price"
            app:srcCompat="?attr/iconPlus"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_lot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="tv_title_lot"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_total_price"/>
        <TextView
            android:id="@+id/tv_title_lot"
            android:paddingTop="@dimen/item_gap_m"
            android:paddingBottom="@dimen/item_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/buy_title_lot"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier_lot"
            style="@style/TypeStyles.BodyRegular"/>
        <ImageView
            android:textStyle="normal"
            android:id="@+id/btn_min_lot"
            android:paddingTop="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/et_total_lot"
            app:layout_constraintTop_toBottomOf="@+id/barrier_lot"
            app:srcCompat="?attr/iconMin"/>
        <EditText
            android:gravity="center"
            android:id="@+id/et_total_lot"
            android:background="@null"
            android:paddingTop="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="@dimen/width_162"
            android:minWidth="@dimen/width_100"
            android:minHeight="@dimen/spacing_36"
            android:hint="@string/n_dash"
            android:selectAllOnFocus="true"
            android:digits="0123456789"
            android:inputType="numberDecimal"
            android:imeOptions="actionDone"
            android:textAlignment="gravity"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_plus_lot"
            app:layout_constraintTop_toBottomOf="@+id/barrier_lot"
            style="@style/TypeStyles.BodyRegular"/>
        <ImageView
            android:textStyle="normal"
            android:id="@+id/btn_plus_lot"
            android:paddingLeft="@dimen/spacing_12"
            android:paddingTop="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier_lot"
            app:srcCompat="?attr/iconPlus"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
