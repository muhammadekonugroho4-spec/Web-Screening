<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_tipping_claim_tip_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/vgTippingClaimDialogHeader"
        android:background="@drawable/bg_top_rounded"
        android:paddingTop="@dimen/item_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/viewFragmentTippingClaimDialogHandler"
            android:background="@drawable/bg_rounded_gray_gray_bg"
            android:layout_width="@dimen/clickable_size_64"
            android:layout_height="@dimen/item_gap_xs"
            android:layout_marginBottom="@dimen/item_gap_s"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvTippingClaimDialogLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/vgTippingClaimDialogHeader">
        <RelativeLayout
            android:id="@+id/rlTippingClaimDialogMainLayout"
            android:background="?attr/themeDialogBackgroundColor"
            android:paddingBottom="@dimen/item_gap_l"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ivTippingClaimDialogHeaderIcon"
                android:layout_width="@dimen/avatar_size_xl"
                android:layout_height="@dimen/avatar_size_xl"
                android:layout_marginTop="@dimen/item_gap_l"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                app:srcCompat="@drawable/ic_tipping_claim_success"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tvTippingClaimDialogTitle"
                android:padding="@dimen/item_gap_m"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/n_dash"
                android:layout_below="@+id/ivTippingClaimDialogHeaderIcon"
                android:textAlignment="gravity"
                style="@style/SbTextView.ListTitle"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tvTippingClaimDialogSubTitle"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/item_gap_l"
                android:layout_marginRight="@dimen/item_gap_l"
                android:layout_marginBottom="@dimen/item_gap_l"
                android:text="@string/n_dash"
                android:layout_below="@+id/tvTippingClaimDialogTitle"
                android:textAlignment="gravity"
                style="@style/SbTextView.BodyDefault"/>
            <RelativeLayout
                android:id="@+id/rlTippingClaimSuccessDialogContentLayout"
                android:background="@drawable/border_gray_rounded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/item_gap_l"
                android:layout_marginRight="@dimen/item_gap_l"
                android:layout_below="@+id/tvTippingClaimDialogSubTitle">
                <TextView
                    android:id="@+id/tvClaimTippingDialogContentTotalClaimTipsTitle"
                    android:paddingLeft="@dimen/item_gap_l"
                    android:paddingTop="@dimen/item_gap_m"
                    android:paddingRight="@dimen/item_gap_l"
                    android:paddingBottom="@dimen/item_gap_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_tipping_my_jar_dialog_claim_total_disbursement_title"
                    android:layout_alignParentLeft="true"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:gravity="end|center_vertical"
                    android:id="@+id/tvClaimTippingDialogContentTotalClaimTips"
                    android:paddingLeft="@dimen/item_gap_l"
                    android:paddingTop="@dimen/item_gap_m"
                    android:paddingRight="@dimen/item_gap_l"
                    android:paddingBottom="@dimen/item_gap_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/n_dash"
                    android:layout_toRightOf="@+id/tvClaimTippingDialogContentTotalClaimTipsTitle"
                    android:layout_alignParentRight="true"
                    android:textAlignment="gravity"
                    style="@style/SbTextView.BodyDefault.Bold"/>
                <TextView
                    android:textColor="@color/gray_text"
                    android:gravity="end|center_vertical"
                    android:id="@+id/tvClaimTippingDialogContentDate"
                    android:paddingLeft="@dimen/item_gap_l"
                    android:paddingTop="@dimen/item_gap_s"
                    android:paddingRight="@dimen/item_gap_l"
                    android:paddingBottom="@dimen/item_gap_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/n_dash"
                    android:layout_toRightOf="@+id/tvClaimTippingDialogContentTotalClaimTipsTitle"
                    android:layout_below="@+id/tvClaimTippingDialogContentTotalClaimTips"
                    android:layout_alignParentRight="true"
                    style="@style/SbTextView.BodyDefault"/>
            </RelativeLayout>
            <Button
                android:id="@+id/btnTippingClaimDialogDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/item_gap_l"
                android:text="@string/lbl_btn_done"
                android:layout_below="@+id/rlTippingClaimSuccessDialogContentLayout"
                style="@style/SbBtn.PrimaryFullWidthFloating"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
