<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme"
    android:orientation="vertical"
    android:tag="layout/fragment_screener_screen_title_desc_dialog_0"
    android:background="@drawable/bg_top_rounded_16"
    android:paddingBottom="@dimen/item_gap_48"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/item_gap_20"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <View
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_rounded_gray_gray_bg"
        android:layout_width="@dimen/clickable_size_38"
        android:layout_height="@dimen/item_gap_s"
        android:layout_marginTop="@dimen/item_gap_14"
        android:layout_marginBottom="@dimen/item_gap_20"/>
    <TextView
        android:textSize="@dimen/text_size_16"
        android:gravity="center_horizontal"
        android:id="@+id/tvChooseScreenerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/n_dash"
        android:fontFamily="@font/bitsans_bold"
        style="@style/SbTextView.BodyDefault.Highempasis.Bold"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:id="@+id/tvChooseScreenerDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_10"
        android:text="@string/n_dash"
        android:fontFamily="@font/bitsans_regular"
        style="@style/SbTextView.Caption.Highempasis"/>
</LinearLayout>
