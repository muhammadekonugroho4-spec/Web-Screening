<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_stream_gif_selector_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/parentBaseBottomSheetDialogHeader"
        android:background="@drawable/bg_top_rounded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/item_gap_l">
        <View
            android:id="@+id/viewSharePost"
            android:background="@drawable/bg_rounded_gray_gray_bg"
            android:layout_width="@dimen/clickable_size_64"
            android:layout_height="@dimen/item_gap_xs"
            android:layout_marginTop="@dimen/item_gap_s"
            android:layout_centerHorizontal="true"
            android:alpha="0.5"/>
        <TextView
            android:id="@+id/tvSharePostTitle"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_share_post"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            style="@style/SbTextView.TitleSmall"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/clickable_size_72"
        android:layout_below="@+id/parentBaseBottomSheetDialogHeader">
        <RelativeLayout
            android:id="@+id/parentGifSearch"
            android:background="?attr/themeDialogBackgroundColor"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_48">
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etGifSearchDummyInput"
                android:background="@color/transparent"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:focusedByDefault="true"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/etGifSearchSearch"
                android:tag="binding_1"
                android:background="@drawable/search_bg"
                android:paddingLeft="@dimen/item_gap_s"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="match_parent"
                android:layout_height="@dimen/clickable_size_32"
                android:layout_marginLeft="@dimen/item_gap_m"
                android:layout_marginRight="@dimen/item_gap_m"
                android:hint="Search gif"
                android:singleLine="true"
                android:selectAllOnFocus="true"
                android:layout_toLeftOf="@+id/ivGifSearchGiphyLogo"
                android:layout_centerVertical="true"
                android:inputType="textNoSuggestions"
                android:imeOptions="actionSearch"
                style="@style/SbEditTextStyle.Medium"/>
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/ibGifSearchClearQuery"
                android:background="@drawable/bg_circle_black"
                android:visibility="gone"
                android:layout_width="@dimen/item_gap_l"
                android:layout_height="@dimen/item_gap_l"
                android:layout_marginTop="@dimen/item_gap_s"
                android:layout_marginRight="@dimen/item_gap_l"
                android:src="0x7f08063f"
                android:scaleType="fitCenter"
                android:layout_toLeftOf="@+id/ivGifSearchGiphyLogo"
                android:layout_centerVertical="true"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivGifSearchGiphyLogo"
                android:padding="@dimen/item_gap_xs"
                android:layout_width="@dimen/clickable_size_48"
                android:layout_height="@dimen/clickable_size_32"
                android:layout_marginRight="@dimen/item_gap_m"
                android:src="@drawable/ic_giphy_logo"
                android:scaleType="fitCenter"
                android:tint="?attr/themeIconTintColor"
                android:layout_alignBottom="@+id/etGifSearchSearch"
                android:layout_alignParentRight="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/sepRegisterFieldOption"
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"/>
        <ProgressBar
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-7dp"
            android:layout_marginBottom="-7dp"
            android:indeterminate="true"
            style="?android:attr/progressBarStyleHorizontal"/>
        <RelativeLayout
            android:background="?attr/themeDialogBackgroundColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/clickable_size_72"
            android:layout_below="@+id/sepRegisterFieldOption">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGifSearch"
                android:tag="binding_3"
                android:paddingLeft="@dimen/item_gap_s"
                android:paddingTop="@dimen/item_gap_m"
                android:paddingRight="@dimen/item_gap_null"
                android:paddingBottom="@dimen/item_gap_m"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutManager="GridLayoutManager"
                app:spanCount="3"/>
            <com.facebook.shimmer.ShimmerFrameLayout
                android:tag="binding_4"
                android:paddingLeft="@dimen/item_gap_s"
                android:paddingTop="@dimen/item_gap_m"
                android:paddingRight="@dimen/item_gap_null"
                android:paddingBottom="@dimen/item_gap_m"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:tag="binding_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include layout="@layout/skeleton_giphy_row"/>
                    <include layout="@layout/skeleton_giphy_row"/>
                    <include layout="@layout/skeleton_giphy_row"/>
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
