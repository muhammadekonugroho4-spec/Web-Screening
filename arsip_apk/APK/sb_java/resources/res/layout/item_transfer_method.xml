<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_parent_transfer_method"
    android:tag="layout/item_transfer_method_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_parent_outline"
        android:background="@drawable/bg_box_active"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/item_gap_16"
        android:paddingEnd="@dimen/item_gap_20"
        android:paddingVertical="@dimen/item_gap_16">
        <TextView
            android:id="@+id/tv_transfer_method"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_icon_method"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_icon_method"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:textColor="?attr/themeColorTextGreen"
            android:gravity="center_vertical"
            android:id="@+id/tv_icon_method"
            android:background="@drawable/bg_rounded_light_dark_grey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/item_gap_4"
            android:paddingEnd="@dimen/item_gap_6"
            android:layout_marginStart="@dimen/item_gap_6"
            android:backgroundTint="?attr/themeColorGreenMedium"
            android:paddingHorizontal="@dimen/item_gap_6"
            android:paddingVertical="@dimen/item_gap_4"
            app:drawableStartCompat="@drawable/ic_instant_payment"
            app:drawableTint="?attr/themeColorTextGreen"
            app:layout_constraintStart_toEndOf="@+id/tv_transfer_method"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.BodyXXSmall"/>
        <TextView
            android:textColor="?attr/themeColorTextGreen"
            android:gravity="center_vertical"
            android:id="@+id/tv_daily_limit"
            android:background="@drawable/bg_rounded_light_dark_grey"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/item_gap_4"
            android:paddingEnd="@dimen/item_gap_6"
            android:layout_marginStart="@dimen/item_gap_6"
            android:backgroundTint="?attr/themeColorGreenMedium"
            android:paddingHorizontal="@dimen/item_gap_6"
            android:paddingVertical="@dimen/item_gap_4"
            app:drawableTint="?attr/themeColorTextGreen"
            app:layout_constraintStart_toEndOf="@+id/tv_icon_method"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.BodyXXSmall"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:id="@+id/tv_transfer_fee"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_icon_method"
            style="@style/TypeStyles.BodyXSmall"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:id="@+id/tv_transfer_operational"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_transfer_fee"
            style="@style/TypeStyles.BodyXSmall"/>
        <ImageView
            android:id="@+id/iv_action"
            android:layout_width="@dimen/clickable_size_18"
            android:layout_height="@dimen/clickable_size_18"
            android:src="?attr/themeIconRadioTickChecked"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/vw_spacer"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_20"/>
</LinearLayout>
