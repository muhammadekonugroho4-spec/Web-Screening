<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_share_group_0"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/item_gap_20"
    android:paddingVertical="@dimen/item_gap_14">
    <ImageView
        android:id="@+id/iv_icon_chat"
        android:tag="binding_1"
        android:layout_width="@dimen/height_16"
        android:layout_height="@dimen/width_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/highgray_light"/>
    <TextView
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/item_gap_12"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon_chat"
        app:layout_constraintLeft_toRightOf="@+id/iv_icon_chat"
        app:layout_constraintTop_toTopOf="@+id/iv_icon_chat"
        style="@style/TypeStyles.BodyRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
