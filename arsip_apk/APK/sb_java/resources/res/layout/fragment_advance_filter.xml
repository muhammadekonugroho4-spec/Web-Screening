                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_20"
                app:chipsActionMode="single_pick"
                app:chipsText="@string/text_big_value_5b"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/chip_minimum_value_1b"
                app:layout_constraintTop_toTopOf="@+id/chip_minimum_value_100m"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/tv_title_highlight_big_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:layout_marginStart="@dimen/spacing_20"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/chip_minimum_value_100m">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_highlight_big_lot_prefix"
                    style="@style/TypeStyles.HeadingRegular"/>
                <TextView
                    android:background="@drawable/bg_highlight_big_lot_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_highlight_big_value_tag"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="@dimen/spacing_4"
                    android:paddingVertical="@dimen/spacing_2"
                    style="@style/TypeStyles.HeadingRegular"/>
            </LinearLayout>
            <com.stockbit.uikit.input.ContainerBox
                android:id="@+id/tf_highlight_big_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:inputType="number"
                android:imeOptions="actionDone"
                android:layout_marginHorizontal="@dimen/spacing_20"
                app:inputHint="@string/hint_highlight_big_value"
                app:inputMaxLength="19"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_highlight_big_value"/>
            <com.stockbit.uikit.chips.SBChips
                android:id="@+id/chip_big_value_100m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:layout_marginStart="@dimen/spacing_20"
                app:chipsActionMode="single_pick"
                app:chipsText="@string/text_big_value_100m"
                app:layout_constraintEnd_toStartOf="@+id/chip_big_value_250m"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tf_highlight_big_value"/>
            <com.stockbit.uikit.chips.SBChips
                android:id="@+id/chip_big_value_250m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipsActionMode="single_pick"
                app:chipsText="@string/text_big_value_250m"
                app:layout_constraintEnd_toStartOf="@+id/chip_big_value_500m"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/chip_big_value_100m"
                app:layout_constraintTop_toTopOf="@+id/chip_big_value_100m"/>
            <com.stockbit.uikit.chips.SBChips
                android:id="@+id/chip_big_value_500m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipsActionMode="single_pick"
                app:chipsText="@string/text_big_value_500m"
                app:layout_constraintEnd_toStartOf="@+id/chip_big_value_1b"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/chip_big_value_250m"
                app:layout_constraintTop_toTopOf="@+id/chip_big_value_100m"/>
            <com.stockbit.uikit.chips.SBChips
                android:id="@+id/chip_big_value_1b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipsActionMode="single_pick"
                app:chipsText="@string/text_big_value_1b"
                app:layout_constraintEnd_toStartOf="@+id/chip_big_value_5b"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/chip_big_value_500m"
                app:layout_constraintTop_toTopOf="@+id/chip_big_value_100m"/>
            <com.stockbit.uikit.chips.SBChips
                android:id="@+id/chip_big_value_5b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_20"
                app:chipsActionMode="single_pick"
                app:chipsText="@string/text_big_value_5b"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/chip_big_value_1b"
                app:layout_constraintTop_toTopOf="@+id/chip_big_value_100m"/>
            <TextView
                android:id="@+id/tv_title_time_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:text="@string/title_time_range"
                android:layout_marginStart="@dimen/spacing_20"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/chip_big_value_100m"
                style="@style/TypeStyles.HeadingRegular"/>
            <com.stockbit.uikit.input.ContainerBox
                android:id="@+id/tf_time_range_from"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:inputType="numberDecimal"
                android:imeOptions="actionDone"
                android:layout_marginStart="@dimen/spacing_20"
                android:layout_marginEnd="@dimen/spacing_16"
                app:inputHint="@string/hint_filter_from"
                app:layout_constraintEnd_toStartOf="@+id/tf_time_range_to"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_time_range"/>
            <com.stockbit.uikit.input.ContainerBox
                android:id="@+id/tf_time_range_to"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:inputType="numberDecimal"
                android:imeOptions="actionDone"
                android:layout_marginEnd="@dimen/spacing_20"
                app:inputHint="@string/hint_filter_to"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tf_time_range_from"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_time_range"/>
            <TextView
                android:id="@+id/tv_error_time_range"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_6"
                android:text="@string/error_time_range_max_must_greater_than_min"
                android:layout_marginHorizontal="@dimen/spacing_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tf_time_range_to"
                style="@style/TypeStyles.BodyXSmall.Red"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_broker_field"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tv_title_broker, field_broker_buyer, field_broker_condition, field_broker_seller"/>
            <TextView
                android:id="@+id/tv_title_broker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:text="@string/title_broker"
                android:layout_marginStart="@dimen/spacing_20"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_error_time_range"
                style="@style/TypeStyles.HeadingRegular"/>
            <include
                android:id="@+id/field_broker_buyer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:layout_marginStart="@dimen/spacing_20"
                android:layout_marginEnd="@dimen/spacing_8"
                app:layout_constraintEnd_toStartOf="@+id/field_broker_condition"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_broker"
                layout="@layout/item_broker_field"/>
            <LinearLayout
                android:gravity="center"
                android:id="@+id/field_broker_condition"
                android:background="@drawable/bg_box_default"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/spacing_12"
                android:layout_marginEnd="@dimen/spacing_8"
                android:paddingHorizontal="@dimen/spacing_12"
                android:paddingVertical="@dimen/spacing_16"
                app:layout_constraintBottom_toBottomOf="@+id/field_broker_buyer"
                app:layout_constraintEnd_toStartOf="@+id/field_broker_seller"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/field_broker_buyer"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_broker">
                <TextView
                    android:textColor="?attr/themeColorTextPrimary"
                    android:ellipsize="end"
                    android:id="@+id/tv_condition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginEnd="@dimen/spacing_2"
                    style="@style/TypeStyles.BodyRegular"/>
                <ImageView
                    android:id="@+id/iv_dropdown"
                    android:layout_width="@dimen/icon_placeholder_16"
                    android:layout_height="@dimen/icon_placeholder_16"
                    android:src="@drawable/ic_dropdown"
                    android:importantForAccessibility="no"
                    app:tint="?attr/themeColorIconDefault"/>
            </LinearLayout>
            <include
                android:id="@+id/field_broker_seller"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:layout_marginEnd="@dimen/spacing_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/field_broker_condition"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_broker"
                layout="@layout/item_broker_field"/>
            <Space
                android:id="@+id/spacer_bottom"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintBottom_toTopOf="@+id/divider_filter"
                app:layout_constraintTop_toBottomOf="@+id/field_broker_buyer"/>
            <com.stockbit.uikit.divider.SBDivider
                android:id="@+id/divider_filter"
                android:layout_width="@dimen/spacing_0"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/spacing_20"
                app:dividerVariant="thin_grey"
                app:layout_constraintBottom_toTopOf="@+id/btn_apply_filter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/spacer_bottom"/>
            <com.stockbit.uikit.button.PrimaryButton
                android:id="@+id/btn_apply_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_20"
                android:text="@string/button_running_trade_apply"
                android:layout_marginHorizontal="@dimen/spacing_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</LinearLayout>
