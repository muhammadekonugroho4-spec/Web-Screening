<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_order_queue_time_filter_0"
    android:paddingBottom="@dimen/item_gap_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <NumberPicker
        android:theme="@style/OrderQueueNumberPickerTheme"
        android:id="@+id/nb_hour"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/clickable_size_16"
        app:layout_constraintEnd_toStartOf="@+id/nb_minute"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <NumberPicker
        android:theme="@style/OrderQueueNumberPickerTheme"
        android:id="@+id/nb_minute"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/nb_hour"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/divider_top"
        android:background="?attr/themeColorTimePickerDivider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginBottom="@dimen/clickable_size_48"
        app:layout_constraintBottom_toTopOf="@+id/divider_bottom"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <View
        android:id="@+id/divider_bottom"
        android:background="?attr/themeColorTimePickerDivider"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider_top"/>
</androidx.constraintlayout.widget.ConstraintLayout>
