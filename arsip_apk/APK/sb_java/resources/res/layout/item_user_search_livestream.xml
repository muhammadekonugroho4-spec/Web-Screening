<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_user_search_livestream_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/item_gap_8"
    android:layout_marginBottom="@dimen/item_gap_8"
    android:layout_marginStart="@dimen/item_gap_20"
    android:layout_marginEnd="@dimen/item_gap_20">
    <ImageView
        android:id="@+id/iv_item_image"
        android:tag="binding_1"
        android:layout_width="@dimen/clickable_size_40"
        android:layout_height="@dimen/clickable_size_40"
        android:scaleType="centerCrop"
        android:contentDescription="@string/livestream_avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_16"
        app:layout_constraintBottom_toBottomOf="@+id/iv_item_image"
        app:layout_constraintEnd_toStartOf="@+id/iv_check"
        app:layout_constraintStart_toEndOf="@+id/iv_item_image"
        app:layout_constraintTop_toTopOf="@+id/iv_item_image">
        <TextView
            android:id="@+id/tv_title"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16"
            style="@style/TypeStyles.HeadingXSmall"/>
        <ImageView
            android:id="@+id/iv_verified_badge"
            android:tag="binding_3"
            android:layout_width="@dimen/spacing_12"
            android:layout_height="@dimen/spacing_12"
            android:contentDescription="@string/verified_account"
            android:layout_marginStart="@dimen/radius_4"
            app:srcCompat="@drawable/ic_verified_green_white_24dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_check"
        android:tag="binding_4"
        android:layout_width="@dimen/item_gap_18"
        android:layout_height="@dimen/item_gap_18"
        android:contentDescription="@string/livestream_share_check"
        app:layout_constraintBottom_toBottomOf="@+id/iv_item_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_item_image"
        app:srcCompat="@drawable/ic_checked_circle_box"/>
</androidx.constraintlayout.widget.ConstraintLayout>
