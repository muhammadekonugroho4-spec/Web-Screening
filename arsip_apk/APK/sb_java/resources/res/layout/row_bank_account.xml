<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_bank_account_0"
    android:paddingTop="@dimen/spacing_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_setting_change_bank_account"
        android:layout_width="@dimen/spacing_40"
        android:layout_height="@dimen/spacing_40"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="@+id/tvSettingChangeBankAccountName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_setting_change_bank_name"
        app:shapeAppearanceOverlay="@style/UikitCircleImageView"/>
    <TextView
        android:id="@+id/tvSettingChangeBankAccountNumber"
        android:tag="binding_1"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:textAlignment="gravity"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="@dimen/spacing_8"
        app:layout_constraintBottom_toBottomOf="@+id/iv_setting_change_bank_account"
        app:layout_constraintEnd_toStartOf="@+id/vfChangeBankAccountTrigger"
        app:layout_constraintStart_toEndOf="@+id/iv_setting_change_bank_account"
        app:layout_constraintTop_toTopOf="@+id/iv_setting_change_bank_account"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:id="@+id/tv_setting_change_bank_name"
        android:tag="binding_2"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_2"
        android:maxLines="2"
        android:textAlignment="gravity"
        app:layout_constraintBottom_toTopOf="@+id/tvSettingChangeBankAccountNumber"
        app:layout_constraintEnd_toEndOf="@+id/tvSettingChangeBankAccountNumber"
        app:layout_constraintStart_toStartOf="@+id/tvSettingChangeBankAccountNumber"
        style="@style/TypeStyles.BodyXSmall"/>
    <ViewFlipper
        android:id="@+id/vfChangeBankAccountTrigger"
        android:tag="binding_3"
        android:visibility="gone"
        android:layout_width="@dimen/icon_placeholder_18"
        android:layout_height="@dimen/icon_placeholder_18"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:layout_constraintBottom_toBottomOf="@+id/tvSettingChangeBankAccountNumber"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvSettingChangeBankAccountNumber">
        <ImageView
            android:id="@+id/tvSettingChangeBankAccountPrimary"
            android:layout_width="@dimen/icon_placeholder_18"
            android:layout_height="@dimen/icon_placeholder_18"
            app:srcCompat="@drawable/ic_checked"/>
        <ImageView
            android:id="@+id/ivSwitchBankAccount"
            android:layout_width="@dimen/icon_placeholder_18"
            android:layout_height="@dimen/icon_placeholder_18"
            app:srcCompat="@drawable/ic_grey_inactive"/>
        <ProgressBar
            android:id="@+id/progressSwitchBankAccount"
            android:layout_width="@dimen/icon_placeholder_18"
            android:layout_height="@dimen/icon_placeholder_18"/>
    </ViewFlipper>
    <TextView
        android:id="@+id/tvSettingChangeBankAccountName"
        android:tag="binding_4"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2"
        android:maxLines="2"
        app:layout_constraintEnd_toEndOf="@+id/tvSettingChangeBankAccountNumber"
        app:layout_constraintStart_toStartOf="@+id/tvSettingChangeBankAccountNumber"
        app:layout_constraintTop_toBottomOf="@+id/tvSettingChangeBankAccountNumber"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
    <View
        android:id="@+id/view"
        android:tag="binding_5"
        android:background="?attr/themeColorDividerThin"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_20"
        android:layout_marginBottom="@dimen/item_gap_1"
        android:layout_marginStart="@dimen/item_gap_20"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvSettingChangeBankAccountName"/>
</androidx.constraintlayout.widget.ConstraintLayout>
