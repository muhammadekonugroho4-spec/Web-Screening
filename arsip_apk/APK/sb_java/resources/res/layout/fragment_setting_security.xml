<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_setting_security_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/themeContentBackground"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/settingActivityToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_collapseMode="pin"
            app:layout_scrollFlags="enterAlways|scroll">
            <TextView
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_security"
                style="@style/TypeStyles.HeadingLarge"/>
        </androidx.appcompat.widget.Toolbar>
        <RelativeLayout
            android:id="@+id/rlSettingUbahEmail"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_50">
            <TextView
                android:id="@+id/tvUbahEmailSett"
                android:paddingLeft="@dimen/item_gap_s"
                android:paddingRight="@dimen/item_gap_m"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button_security_change_email"
                android:layout_toLeftOf="@+id/ivSettingUbahEmailNextIcon"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/item_gap_20"
                style="@style/TypeStyles.BodyLarge"/>
            <ImageView
                android:id="@+id/ivSettingUbahEmailNextIcon"
                android:padding="@dimen/item_gap_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ic_panah_set"/>
            <View
                android:background="?attr/themeColorDividerThin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_xxxs"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rlSettingUbahNomorHp"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_50">
            <TextView
                android:id="@+id/tvUbahNomorHpSett"
                android:paddingLeft="@dimen/item_gap_s"
                android:paddingRight="@dimen/item_gap_m"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button_security_change_phone_number"
                android:layout_toLeftOf="@+id/ivSettingUbahNomorHpNextIcon"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/item_gap_20"
                style="@style/TypeStyles.BodyLarge"/>
            <ImageView
                android:id="@+id/ivSettingUbahNomorHpNextIcon"
                android:padding="@dimen/item_gap_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ic_panah_set"/>
            <View
                android:background="?attr/themeColorDividerThin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_xxxs"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rlSettingUbahStockbitPassword"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_50">
            <TextView
                android:id="@+id/tvUbahStockbitPasswordSett"
                android:paddingLeft="@dimen/item_gap_s"
                android:paddingRight="@dimen/item_gap_m"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button_security_change_stockbit_password"
                android:layout_toLeftOf="@+id/ivSettingUbahStockbitPasswordNextIcon"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/item_gap_20"
                style="@style/TypeStyles.BodyLarge"/>
            <ImageView
                android:id="@+id/ivSettingUbahStockbitPasswordNextIcon"
                android:padding="@dimen/item_gap_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ic_panah_set"/>
            <View
                android:background="?attr/themeColorDividerThin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_xxxs"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rlSettingUbahTradingPin"
            android:tag="binding_1"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_50">
            <TextView
                android:id="@+id/tvUbahTradingPinSett"
                android:paddingLeft="@dimen/item_gap_s"
                android:paddingRight="@dimen/item_gap_m"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button_security_change_trading_pin"
                android:layout_toLeftOf="@+id/ivSettingUbahTradingPinNextIcon"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/item_gap_20"
                style="@style/TypeStyles.BodyLarge"/>
            <ImageView
                android:id="@+id/ivSettingUbahTradingPinNextIcon"
                android:padding="@dimen/item_gap_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ic_panah_set"/>
            <View
                android:background="?attr/themeColorDividerThin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_xxxs"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rlSettingUbahAktivitasLogin"
            android:tag="binding_2"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_50">
            <TextView
                android:textSize="@dimen/text_size_14"
                android:id="@+id/tvUbahAktivitasLoginSett"
                android:paddingLeft="@dimen/item_gap_s"
                android:paddingRight="@dimen/item_gap_m"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button_security_login_activity_label"
                android:layout_toLeftOf="@+id/ivSettingUbahAktivitasLoginNextIcon"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/item_gap_20"
                style="@style/SbTextView.BodyDefault"/>
            <ImageView
                android:id="@+id/ivSettingUbahAktivitasLoginNextIcon"
                android:padding="@dimen/item_gap_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ic_panah_set"/>
            <View
                android:background="?attr/themeColorDividerThin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_xxxs"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/vaasLoadingOverlay"
        android:background="?attr/themeContentBackground"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
