<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_option_day_trade_information_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_trading_balance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_buying_power_title,comp_day_trade_buying_power_multiplier"
        app:layout_constraintEnd_toStartOf="@+id/tv_buying_power_value"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.stockbit.component.securities.utils.DashSeparator
        android:id="@+id/dash_equal_start"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="@dimen/height_1"
        android:layout_marginEnd="@dimen/item_gap_12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_equal"
        app:layout_constraintEnd_toStartOf="@+id/tv_equal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_equal"/>
    <TextView
        android:textColor="?attr/themeColorTextPeriwinkle"
        android:id="@+id/tv_equal"
        android:background="@drawable/bg_periwinkle_medium_rounded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="="
        android:textAlignment="gravity"
        android:paddingHorizontal="@dimen/spacing_6"
        android:paddingVertical="@dimen/spacing_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_leverage_title"
        style="@style/TypeStyles.BodyRegular"/>
    <com.stockbit.component.securities.utils.DashSeparator
        android:id="@+id/dash_equal_end"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="@dimen/height_1"
        android:layout_marginStart="@dimen/item_gap_12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_equal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_equal"
        app:layout_constraintTop_toTopOf="@+id/tv_equal"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_buying_power_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/group_trading_balance"
        app:layout_constraintTop_toTopOf="@+id/tv_buying_power_title"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:id="@+id/tv_buying_power_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:text="Buying Power"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_equal"
        style="@style/TypeStyles.HeadingRegular"/>
    <include
        android:id="@+id/comp_day_trade_buying_power_multiplier"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_buying_power_title"
        app:layout_constraintStart_toEndOf="@+id/tv_buying_power_title"
        app:layout_constraintTop_toTopOf="@+id/tv_buying_power_title"
        layout="@layout/comp_buy_day_trade_multiplier_periwinkle_medium"/>
    <TextView
        android:id="@+id/tv_trading_balance_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:text="Trading Balance"
        app:layout_constraintEnd_toStartOf="@+id/tv_trading_balance_value"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_trading_balance_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_trading_balance_title"
        app:layout_constraintTop_toTopOf="@+id/tv_trading_balance_title"
        style="@style/TypeStyles.BodyRegular"/>
    <com.stockbit.component.securities.utils.DashSeparator
        android:id="@+id/dash_plus_start"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="@dimen/height_1"
        android:layout_marginEnd="@dimen/item_gap_12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_plus"
        app:layout_constraintEnd_toStartOf="@+id/tv_plus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_plus"/>
    <TextView
        android:textColor="?attr/themeColorTextPeriwinkle"
        android:id="@+id/tv_plus"
        android:background="@drawable/bg_periwinkle_medium_rounded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+"
        android:textAlignment="gravity"
        android:paddingHorizontal="@dimen/spacing_6"
        android:paddingVertical="@dimen/spacing_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_trading_balance_title"
        style="@style/TypeStyles.BodyRegular"/>
    <com.stockbit.component.securities.utils.DashSeparator
        android:id="@+id/dash_plus_end"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="@dimen/height_1"
        android:layout_marginStart="@dimen/item_gap_12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_plus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_plus"
        app:layout_constraintTop_toTopOf="@+id/tv_plus"/>
    <TextView
        android:id="@+id/tv_leverage_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="Leverage"
        app:layout_constraintEnd_toStartOf="@+id/tv_leverage_value"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_plus"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_leverage_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_leverage_title"
        app:layout_constraintTop_toTopOf="@+id/tv_leverage_title"
        style="@style/TypeStyles.BodyRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
