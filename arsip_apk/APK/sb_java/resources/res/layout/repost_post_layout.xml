<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentRepostedPostRoot"
    android:tag="layout/repost_post_layout_0"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/item_gap_l"
    android:layout_marginTop="@dimen/item_gap_m"
    android:layout_marginRight="@dimen/item_gap_l"
    android:layout_marginBottom="@dimen/item_gap_m"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    app:cardBackgroundColor="@color/transparent"
    app:cardCornerRadius="@dimen/shape_radius_m"
    app:cardElevation="@dimen/item_gap_null"
    app:strokeColor="?attr/titleTextColorLowgray"
    app:strokeWidth="@dimen/item_gap_xxxs">
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="center"
        android:id="@+id/tv_deletion_content"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/item_gap_15"
        style="@style/TypeStyles.BodyRegular"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:tag="binding_2"
        android:paddingTop="@dimen/item_gap_xs"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/parentRepostedPostUserInfo"
            android:paddingTop="@dimen/item_gap_s"
            android:paddingBottom="@dimen/item_gap_s"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivRepostedPostUserProfile"
                android:tag="binding_3"
                android:layout_width="@dimen/avatar_size_xs"
                android:layout_height="@dimen/avatar_size_xs"
                android:layout_marginLeft="@dimen/item_gap_m"
                android:layout_marginRight="@dimen/item_gap_m"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/ivRepostedPostUserProfile"
                android:layout_centerVertical="true">
                <TextView
                    android:id="@+id/tvRepostedPostUsername"
                    android:tag="binding_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/SbTextView.BodyDefault"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center"
                    android:id="@+id/ivUserInfoVerifiedBadge"
                    android:tag="binding_5"
                    android:layout_width="@dimen/item_gap_m"
                    android:layout_height="@dimen/item_gap_m"
                    android:layout_marginLeft="@dimen/item_gap_s"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/hint_verified_user_badge"/>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tvRepostedPostCommentContent"
            android:tag="binding_6"
            android:paddingBottom="@dimen/item_gap_m"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_m"
            android:layout_marginTop="@dimen/item_gap_s"
            android:layout_marginRight="@dimen/item_gap_m"
            android:maxLines="7"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/parentRepostedPostUserInfo"
            app:layout_goneMarginBottom="@dimen/shape_radius_l"
            app:layout_goneMarginTop="@dimen/shape_radius_l"
            style="@style/SbTextView.StreamListContent"/>
        <ImageView
            android:id="@+id/iv_reposted_image"
            android:tag="binding_7"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerCrop"
            android:contentDescription="@string/hint_post_image"
            app:layout_constraintDimensionRatio="v,16:9"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvRepostedPostCommentContent"/>
        <include
            android:id="@+id/stream_share_trade_repost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_reposted_image"
            layout="@layout/comp_stream_share_trade"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
