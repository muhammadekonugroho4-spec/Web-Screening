<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_mutual_fund_top_holding"
    android:tag="layout/comp_mutual_fund_top_holding_0"
    android:background="@drawable/border_black_square"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/item_gap_l"
    android:layout_marginRight="@dimen/item_gap_l"
    android:layout_marginBottom="@dimen/item_gap_l">
    <TextView
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_l"
        android:layout_marginTop="@dimen/item_gap_l"
        android:text="@string/lbl_mutual_fund_portfolio_composition"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SbTextView.ListTitle"/>
    <TextView
        android:id="@+id/tv_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/item_gap_l"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_title"
        app:layout_constraintRight_toRightOf="parent"
        style="@style/SbTextView.CaptionSecondary"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/rv_top_holding"
        android:paddingTop="@dimen/item_gap_m"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_24"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_top_holding"/>
</androidx.constraintlayout.widget.ConstraintLayout>
