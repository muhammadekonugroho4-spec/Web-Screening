<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/item_gap_10">
    <View
        android:id="@+id/v_avatar1"
        android:background="@drawable/bg_circle_gray"
        android:layout_width="@dimen/spacing_40"
        android:layout_height="@dimen/spacing_40"
        android:layout_marginStart="@dimen/spacing_20"
        android:backgroundTint="?attr/themeShimmer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_username"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/item_gap_80"
        android:layout_height="@dimen/spacing_12"
        android:layout_marginStart="@dimen/item_gap_12"
        android:layout_marginEnd="@dimen/item_gap_32"
        android:backgroundTint="?attr/themeShimmer"
        app:layout_constraintBottom_toTopOf="@+id/v_fullname"
        app:layout_constraintStart_toEndOf="@+id/v_avatar1"
        app:layout_constraintTop_toTopOf="@+id/v_avatar1"/>
    <View
        android:id="@+id/v_fullname"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_160"
        android:layout_height="@dimen/spacing_12"
        android:layout_marginEnd="@dimen/item_gap_32"
        android:backgroundTint="?attr/themeShimmer"
        app:layout_constraintBottom_toBottomOf="@+id/v_avatar1"
        app:layout_constraintStart_toStartOf="@+id/v_username"
        app:layout_constraintTop_toBottomOf="@+id/v_username"/>
</androidx.constraintlayout.widget.ConstraintLayout>
