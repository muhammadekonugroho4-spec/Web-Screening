<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/comp_empty_charty_0"
    android:background="?attr/themeContentBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_70"
        android:layout_marginBottom="@dimen/item_gap_l"
        android:src="?attr/themeIconFinancialEmpty"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="center"
        android:id="@+id/tv_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/text_valuation_empty"
        android:layout_below="@+id/iv_empty"
        android:textAlignment="gravity"
        style="@style/TypeStyles.BodySmall"/>
</RelativeLayout>
