<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlSearchBarRoundedSearching"
    android:tag="layout/layout_search_bar_0"
    android:background="@drawable/bg_component_6"
    android:layout_width="match_parent"
    android:layout_height="@dimen/clickable_size_40"
    android:layout_marginTop="@dimen/item_gap_14"
    android:layout_marginStart="@dimen/item_gap_14"
    android:layout_marginEnd="@dimen/item_gap_20">
    <ImageView
        android:id="@+id/ivSearchBarRoundedSearchIcon"
        android:layout_width="@dimen/item_gap_14"
        android:layout_height="@dimen/item_gap_14"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/item_gap_m"
        app:srcCompat="@drawable/ic_android_search"
        app:tint="?attr/titleTextColorHighgray"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etSearchBarRoundedSearch"
        android:tag="binding_1"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_height_m"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:paddingStart="@dimen/item_gap_m"
        android:paddingEnd="@dimen/item_gap_l"
        android:layout_toEndOf="@+id/ivSearchBarRoundedSearchIcon"
        style="@style/SbEditTextStyle"/>
    <ImageButton
        android:id="@+id/ibSearchBarRoundedSearchClearQuery"
        android:background="@null"
        android:visibility="gone"
        android:layout_width="@dimen/clickable_size_16"
        android:layout_height="@dimen/clickable_size_16"
        android:scaleType="centerCrop"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/item_gap_l"
        android:layout_alignParentEnd="true"
        app:srcCompat="@drawable/ic_circle_close_high_gray"/>
</RelativeLayout>
