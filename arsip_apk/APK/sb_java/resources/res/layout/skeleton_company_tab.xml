<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/viewCompanyProfileTab1"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_80"
        android:layout_height="@dimen/item_gap_20"
        android:layout_marginStart="@dimen/spacing_16"
        android:backgroundTint="?attr/themeShimmer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/viewCompanyProfileTab2"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_80"
        android:layout_height="@dimen/item_gap_20"
        android:layout_marginStart="@dimen/item_gap_20"
        android:backgroundTint="?attr/themeShimmer"
        app:layout_constraintStart_toEndOf="@+id/viewCompanyProfileTab1"
        app:layout_constraintTop_toTopOf="@+id/viewCompanyProfileTab1"/>
    <View
        android:id="@+id/viewCompanyProfileTab3"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_80"
        android:layout_height="@dimen/item_gap_20"
        android:layout_marginStart="@dimen/item_gap_20"
        android:backgroundTint="?attr/themeShimmer"
        app:layout_constraintStart_toEndOf="@+id/viewCompanyProfileTab2"
        app:layout_constraintTop_toTopOf="@+id/viewCompanyProfileTab2"/>
    <View
        android:id="@+id/viewCompanyProfileTab4"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_80"
        android:layout_height="@dimen/item_gap_20"
        android:layout_marginStart="@dimen/item_gap_20"
        android:backgroundTint="?attr/themeShimmer"
        app:layout_constraintStart_toEndOf="@+id/viewCompanyProfileTab3"
        app:layout_constraintTop_toTopOf="@+id/viewCompanyProfileTab3"/>
</androidx.constraintlayout.widget.ConstraintLayout>
