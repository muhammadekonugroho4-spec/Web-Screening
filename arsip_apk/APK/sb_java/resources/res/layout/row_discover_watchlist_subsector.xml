<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_discover_watchlist_sub_sector_parent"
    android:tag="layout/row_discover_watchlist_subsector_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="@dimen/clickable_size_64">
    <RelativeLayout
        android:id="@+id/rl_discover_watchlist_sub_sector_container"
        android:tag="binding_1"
        android:focusable="true"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:foreground="?attr/selectableItemBackground"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_discover_watchlist_sub_sector_company_container"
            android:paddingLeft="@dimen/item_gap_l"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toLeftOf="@+id/vf_discover_watchlist_follow_action">
            <ImageView
                android:id="@+id/iv_company_logo"
                android:layout_width="@dimen/item_gap_32"
                android:layout_height="@dimen/item_gap_32"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_discover_sub_sector_symbol"
                android:tag="binding_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_marginStart="@dimen/item_gap_8"
                app:layout_constraintBottom_toTopOf="@+id/tv_discover_sub_sector_name"
                app:layout_constraintStart_toEndOf="@+id/iv_company_logo"
                app:layout_constraintTop_toTopOf="@+id/iv_company_logo"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/TypeStyles.HeadingRegular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_size_9"
                android:textColor="@color/google_red"
                android:id="@+id/tv_discover_sub_sector_status"
                android:tag="binding_3"
                android:background="@drawable/border_red"
                android:paddingLeft="@dimen/item_gap_s"
                android:paddingTop="@dimen/item_gap_xs"
                android:paddingRight="@dimen/item_gap_s"
                android:paddingBottom="@dimen/item_gap_xs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/item_gap_s"
                android:singleLine="true"
                app:layout_constraintBottom_toBottomOf="@+id/tv_discover_sub_sector_symbol"
                app:layout_constraintStart_toEndOf="@+id/tv_discover_sub_sector_symbol"
                app:layout_constraintTop_toTopOf="@+id/tv_discover_sub_sector_symbol"
                style="@style/SbTextView.CaptionSecondary.Bold"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:ellipsize="end"
                android:id="@+id/tv_discover_sub_sector_name"
                android:tag="binding_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_2"
                android:singleLine="true"
                android:layout_marginEnd="@dimen/item_gap_32"
                app:layout_constraintBottom_toBottomOf="@+id/iv_company_logo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tv_discover_sub_sector_symbol"
                app:layout_constraintTop_toBottomOf="@+id/tv_discover_sub_sector_symbol"
                style="@style/TypeStyles.BodyXSmall"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ViewFlipper
            android:id="@+id/vf_discover_watchlist_follow_action"
            android:tag="binding_5"
            android:padding="@dimen/clickable_size_16"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/img_item_unfollowed"
                android:padding="@dimen/spacing_2"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="@dimen/clickable_size_24"
                android:layout_height="@dimen/clickable_size_24"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_add_circle_outline"
                app:tint="?attr/themeIconTintColor"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_followed"
                android:focusable="false"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="@dimen/clickable_size_24"
                android:layout_height="@dimen/clickable_size_24"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_check_circle_green_18dp"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/progress_follow_status"
                android:focusable="false"
                android:visibility="gone"
                android:clickable="false"
                android:layout_width="@dimen/clickable_size_24"
                android:layout_height="@dimen/clickable_size_24"
                android:indeterminate="true"
                android:indeterminateTint="@color/green_text"/>
        </ViewFlipper>
    </RelativeLayout>
    <View
        android:id="@+id/v_border"
        android:background="?attr/themeColorDividerThin"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"/>
</LinearLayout>
