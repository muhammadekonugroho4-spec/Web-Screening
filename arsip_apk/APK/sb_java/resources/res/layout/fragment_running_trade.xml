<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_parent"
    android:tag="layout/fragment_running_trade_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_scrollFlags="enterAlways|scroll">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/item_gap_56">
                <TextView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/item_gap_6"
                    android:text="@string/running_trade_title"
                    android:maxLines="2"
                    app:autoSizeMaxTextSize="@dimen/text_title"
                    app:autoSizeMinTextSize="@dimen/text_body"
                    app:autoSizeTextType="none"
                    style="@style/TypeStyles.HeadingLarge"/>
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:layout_gravity="center"
                    android:id="@+id/sfl_loading_date"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/SBShimmerLayout">
                    <View
                        android:id="@+id/v_avatar"
                        android:background="@drawable/uikit_bg_fb_shimmer_normal"
                        android:layout_width="@dimen/width_84"
                        android:layout_height="@dimen/height_12"
                        style="@style/SBShimmerItem"/>
                </com.facebook.shimmer.ShimmerFrameLayout>
                <LinearLayout
                    android:layout_gravity="center"
                    android:id="@+id/ll_running_trade_date"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_gravity="center"
                        android:id="@+id/tv_running_trade_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TypeStyles.BodyXSmall.Green"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/iv_running_trade_date"
                        android:layout_width="@dimen/width_12"
                        android:layout_height="@dimen/height_12"
                        android:layout_marginStart="@dimen/item_gap_4"
                        app:srcCompat="@drawable/uikit_ic_stockbit_text_field_chevron_down"
                        app:tint="?attr/themeColorTextGreen"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/ll_action_play_pause"
            android:background="@drawable/bg_theme_gray_rounded_outline"
            android:visibility="gone"
            android:layout_width="@dimen/clickable_size_74"
            android:layout_height="@dimen/clickable_size_28"
            android:layout_marginStart="@dimen/spacing_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar">
            <ImageView
                android:id="@+id/iv_action_play_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_play_rt"/>
            <TextView
                android:textColor="?attr/themeColorIconDefault"
                android:id="@+id/tv_action_play_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/item_gap_34"
                android:text="@string/text_rt_play"
                android:maxLines="1"
                android:layout_marginStart="@dimen/spacing_2"
                style="@style/TypeStyles.HeadingXSmall"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_action_toggle_merge_view"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16"
            app:layout_constraintBottom_toBottomOf="@+id/ll_stock_filter_running_trade"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ll_stock_filter_running_trade">
            <TextView
                android:id="@+id/tv_merge_view_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Merge Order ID"
                android:layout_marginEnd="@dimen/spacing_8"
                style="@style/TypeStyles.BodyXSmall"/>
            <com.stockbit.uikit.control.ControlToggleSwitch
                android:id="@+id/toggle_merge_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:switchType="Medium"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:id="@+id/ll_stock_filter_running_trade"
            android:background="@drawable/bg_theme_gray_rounded_outline"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/item_gap_28"
            android:maxWidth="50dp"
            android:layout_marginEnd="@dimen/spacing_8"
            app:layout_constraintEnd_toStartOf="@+id/btn_advance_filter"
            app:layout_constraintTop_toBottomOf="@+id/toolbar">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_company_logo"
                android:visibility="gone"
                android:layout_width="@dimen/spacing_20"
                android:layout_height="@dimen/spacing_20"
                android:scaleType="centerInside"
                android:layout_marginStart="@dimen/spacing_4"
                android:layout_marginEnd="@dimen/spacing_4"/>
            <TextView
                android:ellipsize="end"
                android:layout_gravity="center"
                android:id="@+id/tv_filter_running_trade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="90dp"
                android:text="@string/all_stocks"
                android:maxLines="1"
                android:textAlignment="gravity"
                android:layout_marginStart="@dimen/spacing_16"
                style="@style/TypeStyles.BodySmall"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/iv_arrow_filter"
                android:paddingTop="@dimen/spacing_2"
                android:layout_width="@dimen/spacing_16"
                android:layout_height="@dimen/spacing_16"
                android:scaleType="center"
                android:rotation="90"
                android:layout_marginStart="@dimen/item_gap_4"
                android:layout_marginEnd="@dimen/item_gap_12"
                app:srcCompat="@drawable/ic_chevron_right_small"/>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_advance_filter"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_20"
            app:cardBackgroundColor="?attr/themeColorSurfaceDefault"
            app:cardCornerRadius="@dimen/spacing_16"
            app:cardElevation="@dimen/spacing_0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar"
            app:rippleColor="@color/transparent"
            app:strokeWidth="1dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/spacing_10"
                android:paddingVertical="@dimen/spacing_6">
                <ImageView
                    android:id="@+id/iv_filter"
                    android:tag="binding_2"
                    android:layout_width="@dimen/width_14"
                    android:layout_height="@dimen/height_14"
                    android:layout_marginEnd="@dimen/item_gap_4"
                    app:srcCompat="@drawable/ic_running_trade_filter_default"/>
                <TextView
                    android:id="@+id/tv_filter"
                    android:tag="binding_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_filter"
                    style="@style/TypeStyles.BodyXSmall"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <Space
            android:id="@+id/spacer_filter_badge"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_margin="@dimen/item_gap_5"
            app:layout_constraintBottom_toTopOf="@+id/btn_advance_filter"
            app:layout_constraintStart_toEndOf="@+id/btn_advance_filter"/>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_filter_badge"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/themeColorFeatureGreen"
            app:cardCornerRadius="@dimen/spacing_8"
            app:cardElevation="@dimen/spacing_0"
            app:layout_constraintEnd_toEndOf="@+id/spacer_filter_badge"
            app:layout_constraintTop_toTopOf="@+id/spacer_filter_badge"
            app:strokeColor="?attr/themeColorSurfaceDefault"
            app:strokeWidth="1dp">
            <TextView
                android:textSize="@dimen/text_size_10"
                android:textColor="@color/light_artboard_surface_white"
                android:gravity="center"
                android:id="@+id/tv_filter_badge"
                android:tag="binding_5"
                android:layout_width="@dimen/width_16"
                android:layout_height="@dimen/height_16"
                style="@style/TypeStyles.HeadingXSmall"/>
        </com.google.android.material.card.MaterialCardView>
        <com.stockbit.component.runningtrade.main.StockbitRunningTrade
            android:id="@+id/comp_running_trade"
            android:tag="binding_6"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_0"
            android:layout_marginTop="@dimen/item_gap_16"
            android:layout_marginBottom="@dimen/item_gap_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_stock_filter_running_trade"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_blurry_running_trade"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/item_gap_16"
            android:src="?attr/themeBackgroundBlurryRunningTrade"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_stock_filter_running_trade"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/dialog_paywall"
        android:visibility="gone"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        layout="@layout/dialog_bottom_sheet_info"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
