<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/dialog_watchlist_group_footer_0"
    android:background="?attr/themeColorModalsBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/divider"
        android:background="?attr/titleTextColorDowngray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_1"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/btn_add_to_watchlist"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_20"
        android:text="@string/title_add_watchlist_group"/>
</LinearLayout>
