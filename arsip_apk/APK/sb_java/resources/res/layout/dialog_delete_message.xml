<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_delete_message_0"
    android:background="@drawable/bg_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <View
        android:id="@+id/view_rounded"
        android:background="@drawable/bg_rounded_modal_indicator"
        android:layout_width="@dimen/clickable_size_38"
        android:layout_height="@dimen/item_gap_5"
        android:layout_marginTop="@dimen/item_gap_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_selected_message"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_22"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_rounded"
        style="@style/TypeStyles.HeadingLarge"/>
    <ProgressBar
        android:tag="binding_2"
        android:visibility="gone"
        android:layout_width="@dimen/width_24"
        android:layout_height="@dimen/height_24"
        android:indeterminate="true"
        android:elevation="@dimen/item_gap_10"
        app:indicatorColor="?attr/themeColorTextGreen"
        app:layout_constraintBottom_toBottomOf="@+id/btn_delete"
        app:layout_constraintEnd_toEndOf="@+id/btn_delete"
        app:layout_constraintStart_toStartOf="@+id/btn_delete"
        app:layout_constraintTop_toTopOf="@+id/btn_delete"
        app:trackCornerRadius="@dimen/item_gap_4"/>
    <Button
        android:textColor="@color/color_text_button"
        android:layout_gravity="center"
        android:id="@+id/btn_delete"
        android:tag="binding_3"
        android:background="@drawable/bg_semantic_error_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_30"
        android:textAllCaps="false"
        android:fontFamily="@font/bitsans_bold"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_selected_message"/>
    <com.stockbit.uikit.buttons.FloatingButton
        android:textStyle="bold"
        android:id="@+id/btn_cancel"
        android:tag="binding_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:layout_marginBottom="@dimen/item_gap_24"
        android:text="@string/btn_negative_cancel"
        android:textAllCaps="false"
        app:defaultColor="Neutral"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/btn_delete"
        app:layout_constraintStart_toStartOf="@+id/btn_delete"
        app:layout_constraintTop_toBottomOf="@+id/btn_delete"
        style="@style/SbBtnBorderless"/>
</androidx.constraintlayout.widget.ConstraintLayout>
