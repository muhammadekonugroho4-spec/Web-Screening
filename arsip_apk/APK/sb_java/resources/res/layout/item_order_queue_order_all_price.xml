<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/item_order_queue_order_all_price_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_border_top"
        android:background="?attr/themeColorDividerThick"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/order_queue_item_height">
        <TextView
            android:textColor="?attr/themeColorSpecialTextSecondary"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_order_id"
            android:tag="binding_1"
            android:layout_width="@dimen/order_queue_item_queue_width"
            android:layout_height="@dimen/order_queue_item_height"
            android:paddingStart="@dimen/spacing_20"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:textColor="?attr/themeColorSpecialTextSecondary"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_time"
            android:tag="binding_2"
            android:layout_width="@dimen/order_queue_item_time_width"
            android:layout_height="@dimen/order_queue_item_height"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:textColor="@color/green_text"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_action"
            android:tag="binding_3"
            android:layout_width="@dimen/order_queue_item_action_width"
            android:layout_height="@dimen/order_queue_item_height"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:textColor="@color/green_text"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_price"
            android:tag="binding_4"
            android:layout_width="@dimen/order_queue_item_price_width"
            android:layout_height="@dimen/order_queue_item_height"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:textColor="@color/green_text"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_status"
            android:tag="binding_5"
            android:layout_width="@dimen/order_queue_item_status_width"
            android:layout_height="@dimen/order_queue_item_height"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:textColor="@color/green_text"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_open"
            android:tag="binding_6"
            android:layout_width="@dimen/order_queue_item_open_width"
            android:layout_height="@dimen/order_queue_item_height"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:textColor="?attr/themeColorSpecialTextSecondary"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_lot"
            android:tag="binding_7"
            android:layout_width="@dimen/order_queue_item_lot_width"
            android:layout_height="@dimen/order_queue_item_height"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:textColor="?attr/themeColorSpecialTextSecondary"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_broker"
            android:tag="binding_8"
            android:layout_width="@dimen/order_queue_item_broker_width"
            android:layout_height="@dimen/order_queue_item_height"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:textColor="?attr/themeColorSpecialTextSecondary"
            android:gravity="center"
            android:id="@+id/tv_board"
            android:tag="binding_9"
            android:layout_width="@dimen/order_queue_item_board_width"
            android:layout_height="@dimen/order_queue_item_height"
            style="@style/TypeStyles.BodySmall"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:id="@+id/v_border_bottom"
        android:background="?attr/themeColorDividerThick"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"/>
</androidx.appcompat.widget.LinearLayoutCompat>
