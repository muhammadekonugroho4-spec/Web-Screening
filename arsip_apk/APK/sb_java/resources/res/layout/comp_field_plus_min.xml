<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_field_plus_min_0"
    android:background="@drawable/bg_rounded_4_transparent_colorborder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Button
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/green_text"
        android:id="@+id/btn_minus"
        android:background="@drawable/btn_empty_green_alpha_rounded"
        android:layout_width="@dimen/width_35"
        android:layout_height="@dimen/height_35"
        android:text="@string/title_screener_minus"
        android:layout_marginStart="@dimen/item_gap_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Button
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/green_text"
        android:id="@+id/btn_plus"
        android:background="@drawable/btn_empty_green_alpha_rounded"
        android:layout_width="@dimen/width_35"
        android:layout_height="@dimen/height_35"
        android:text="@string/title_screener_plus"
        android:layout_marginEnd="@dimen/item_gap_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.textfield.TextInputEditText
        android:textSize="@dimen/text_size_18"
        android:gravity="center"
        android:id="@+id/et_target_price_alert"
        android:background="@null"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:digits="0123456789."
        android:inputType="numberDecimal"
        android:imeOptions="actionDone"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/item_gap_15"
        android:paddingVertical="@dimen/item_gap_12"
        app:layout_constraintEnd_toStartOf="@+id/btn_plus"
        app:layout_constraintStart_toEndOf="@+id/btn_minus"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SbTextView.PageHeadline"/>
</androidx.constraintlayout.widget.ConstraintLayout>
