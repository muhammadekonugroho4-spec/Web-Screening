<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_research_entry_menu_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_20"
    android:paddingVertical="@dimen/spacing_16">
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/tv_research_academy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_academy"
        android:drawablePadding="@dimen/spacing_8"
        app:drawableTopCompat="?attr/themeIconResearchAcademy"
        app:layout_constraintEnd_toStartOf="@+id/tv_research_unboxing"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/tv_research_unboxing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_unboxing"
        android:drawablePadding="@dimen/spacing_8"
        app:drawableTopCompat="?attr/themeIconResearchUnboxing"
        app:layout_constraintEnd_toStartOf="@+id/tv_research_event"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tv_research_academy"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/tv_research_event"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_events"
        android:drawablePadding="@dimen/spacing_8"
        app:drawableTopCompat="?attr/themeIconResearchEvent"
        app:layout_constraintEnd_toStartOf="@+id/tv_research_snip"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tv_research_unboxing"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
    <TextView
        android:gravity="center_horizontal"
        android:id="@+id/tv_research_snip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/stream_snip"
        android:drawablePadding="@dimen/spacing_8"
        app:drawableTopCompat="?attr/themeIconResearchSnip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/tv_research_event"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
