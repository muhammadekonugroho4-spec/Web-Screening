<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:tag="layout/item_empty_trading_portfolio_list_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="80dp">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_32"
        android:src="?attr/themeIconEmptyPortfolio"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_title_empty"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_s"
        android:textAlignment="gravity"
        style="@style/TypeStyles.HeadingXSmall"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="center"
        android:id="@+id/tv_subtitle_empty"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="gravity"
        style="@style/TypeStyles.BodySmall"/>
    <com.stockbit.uikit.button.EllipseButton
        android:layout_gravity="center"
        android:id="@+id/btn_open_watchlist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32"
        android:text="@string/empty_button_portfolio"/>
</LinearLayout>
