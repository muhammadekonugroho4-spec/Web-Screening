<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_guide_group"
    android:tag="layout/row_deposit_guide_group_0"
    android:background="@drawable/bg_rounded_4_transparent_colorborder"
    android:paddingTop="@dimen/item_gap_16"
    android:paddingBottom="@dimen/item_gap_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/item_gap_10">
    <ImageView
        android:id="@+id/iv_guide_icon"
        android:layout_width="@dimen/width_40"
        android:layout_height="@dimen/height_40"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/item_gap_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_payment_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/item_gap_16"
        app:layout_constraintBottom_toBottomOf="@+id/iv_guide_icon"
        app:layout_constraintStart_toEndOf="@+id/iv_guide_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_guide_icon"
        style="@style/TypeStyles.HeadingRegular"/>
    <ImageView
        android:id="@+id/iv_dropdown_instruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:rotation="90"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:layout_constraintBottom_toBottomOf="@+id/iv_guide_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_guide_icon"
        app:srcCompat="@drawable/ic_chevron_right_small"/>
    <View
        android:id="@+id/view_separator"
        android:background="?attr/themeColorDividerThin"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_guide_icon"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_child_guide"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_10"
        android:layout_marginStart="@dimen/item_gap_10"
        android:layout_marginEnd="@dimen/item_gap_10"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_separator"/>
</androidx.constraintlayout.widget.ConstraintLayout>
