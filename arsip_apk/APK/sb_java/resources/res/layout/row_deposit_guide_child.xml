<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_deposit_guide_child_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/item_gap_20">
    <TextView
        android:textSize="@dimen/text_size_12"
        android:id="@+id/tv_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_4"
        android:layout_marginStart="@dimen/item_gap_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingXSmall"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:id="@+id/tv_guide"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/item_gap_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_number"
        app:layout_constraintTop_toTopOf="@+id/tv_number"
        style="@style/TypeStyles.BodyXSmall"/>
    <RelativeLayout
        android:id="@+id/rl_copy_rdn"
        android:background="@drawable/bg_rounded_4_transparent_colorborder"
        android:paddingTop="@dimen/item_gap_4"
        android:paddingBottom="@dimen/item_gap_4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_10"
        android:paddingStart="@dimen/item_gap_12"
        android:paddingEnd="@dimen/item_gap_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_guide"
        app:layout_constraintTop_toBottomOf="@+id/tv_guide">
        <TextView
            android:textSize="@dimen/text_size_12"
            android:id="@+id/tv_rdn_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            style="@style/TypeStyles.HeadingRegular"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_10"
            android:src="@drawable/ic_copy"
            android:layout_toRightOf="@+id/tv_rdn_number"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
