<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_check_email_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_icon_phone_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/clickable_size_48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/themIcPhoneAndEmail"/>
    <TextView
        android:textSize="@dimen/text_size_18"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="@string/check_email"
        app:layout_constraintEnd_toEndOf="@+id/iv_icon_phone_email"
        app:layout_constraintStart_toStartOf="@+id/iv_icon_phone_email"
        app:layout_constraintTop_toBottomOf="@+id/iv_icon_phone_email"
        style="@style/SbTextView.ListTitle.Highempasis.Bold"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="?attr/titleTextColorHighgray"
        android:gravity="center"
        android:id="@+id/tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:text="@string/check_email_subtitle"
        android:layout_marginStart="@dimen/item_gap_40"
        android:layout_marginEnd="@dimen/item_gap_40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/SbTextView.Caption.Highgray"/>
    <androidx.appcompat.widget.AppCompatButton
        android:tag="binding_1"
        android:background="@drawable/btn_follow_bordered"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_44"
        android:layout_marginTop="@dimen/item_gap_40"
        android:text="@string/check_email"
        android:paddingStart="@dimen/item_gap_32"
        android:paddingEnd="@dimen/item_gap_32"
        app:layout_constraintEnd_toEndOf="@+id/tv_title"
        app:layout_constraintStart_toStartOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_subtitle"
        style="@style/SbBtnBorderless.Default"/>
</androidx.constraintlayout.widget.ConstraintLayout>
