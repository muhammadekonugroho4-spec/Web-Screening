<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_subsidiary"
    android:tag="layout/comp_company_profile_subsidiary_0"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_separator_top"
        android:background="?attr/themeColorDividerThick"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_8"
        android:layout_marginTop="@dimen/item_gap_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginTop="@dimen/item_gap_16"/>
    <TextView
        android:id="@+id/tv_title_subsidiary_company"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_22"
        android:text="@string/title_company_profile_subsidiary_companies"
        android:layout_marginStart="@dimen/spacing_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_separator_top"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:id="@+id/tv_title_percentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/txt_percentage"
        android:layout_marginEnd="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title_subsidiary_company"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title_subsidiary_company"
        style="@style/TypeStyles.HeadingXSmall"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_subsidiary_companies"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_10"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="@+id/tv_title_percentage"
        app:layout_constraintStart_toStartOf="@+id/tv_title_subsidiary_company"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_subsidiary_company"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:id="@+id/tv_year_updated"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_subsidiary_companies"
        style="@style/TypeStyles.BodyXSmall"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:text="@string/text_company_profile_subsidiary_companies"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_year_updated"
        style="@style/TypeStyles.BodyXSmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
