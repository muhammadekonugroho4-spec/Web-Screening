<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_blocked_view_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_blocked"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/width_100"
        android:layout_centerInParent="false"
        android:layout_centerHorizontal="true"
        android:foregroundGravity="center"
        app:srcCompat="?attr/themeIconBlocked"/>
    <TextView
        android:gravity="center"
        android:id="@+id/textView2"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32"
        android:layout_below="@+id/iv_blocked"
        android:layout_centerInParent="true"
        android:foregroundGravity="center"
        android:layout_marginStart="@dimen/item_gap_18"
        android:layout_marginEnd="@dimen/item_gap_18"
        style="@style/SbTextView.PageTitle.HighEmphasis.Bold"/>
    <TextView
        android:textColor="?attr/themeSemiMediumEmphasis"
        android:gravity="center"
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        android:text="@string/msg_blocked_profile"
        android:layout_below="@+id/textView2"
        android:layout_centerInParent="true"
        android:foregroundGravity="center"
        android:layout_marginStart="@dimen/item_gap_18"
        android:layout_marginEnd="@dimen/item_gap_18"
        style="@style/SbTextView.BodyDefault"/>
</RelativeLayout>
