<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_calendar_main_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:tag="binding_1"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/genericToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_centerHorizontal="true"
            app:layout_scrollFlags="enterAlways|scroll"
            app:titleTextAppearance="@style/SbTextView.PageTitle">
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/text_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calendar"
                android:maxLines="2"
                app:autoSizeMaxTextSize="@dimen/text_title"
                app:autoSizeMinTextSize="@dimen/text_body"
                app:autoSizeTextType="none"
                style="@style/SbTextView.PageTitle"/>
        </androidx.appcompat.widget.Toolbar>
        <include
            android:id="@+id/lyt_paywall"
            android:visibility="gone"
            layout="@layout/comp_paywall_calendar"/>
        <HorizontalScrollView
            android:id="@+id/hsv_calendar_main"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_s"
            android:layout_marginBottom="@dimen/item_gap_s"
            android:fillViewport="true"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cg_calendar_main"
                android:background="?attr/themeColorSurfaceDefault"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingTop="@dimen/item_gap_m"
                android:paddingRight="@dimen/item_gap_l"
                android:paddingBottom="@dimen/item_gap_m"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/item_gap_s"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">
                <com.google.android.material.chip.Chip
                    android:textAppearance="@style/SdChipText"
                    android:gravity="center"
                    android:id="@+id/c_today"
                    android:padding="@dimen/item_gap_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:minWidth="@dimen/clickable_size_38"
                    android:text="@string/text_today"
                    android:textAlignment="gravity"
                    style="@style/SbChipGreenBackground"/>
                <com.google.android.material.chip.Chip
                    android:textAppearance="@style/SdChipText"
                    android:gravity="center"
                    android:id="@+id/c_economic"
                    android:padding="@dimen/item_gap_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:minWidth="@dimen/clickable_size_38"
                    android:text="@string/text_economic"
                    android:textAlignment="gravity"
                    style="@style/SbChipGreenBackground"/>
                <com.google.android.material.chip.Chip
                    android:textAppearance="@style/SdChipText"
                    android:gravity="center"
                    android:id="@+id/c_dividend"
                    android:padding="@dimen/item_gap_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/clickable_size_38"
                    android:text="@string/title_corp_action_cash_dividend"
                    android:textAlignment="gravity"
                    style="@style/SbChipGreenBackground"/>
                <com.google.android.material.chip.Chip
                    android:textAppearance="@style/SdChipText"
                    android:gravity="center"
                    android:id="@+id/c_stock_dividend"
                    android:padding="@dimen/item_gap_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/clickable_size_38"
                    android:text="@string/title_corp_action_stock_dividend"
                    android:textAlignment="gravity"
                    style="@style/SbChipGreenBackground"/>
                <com.google.android.material.chip.Chip
                    android:textAppearance="@style/SdChipText"
                    android:gravity="center"
                    android:id="@+id/c_stocksplit"
                    android:padding="@dimen/item_gap_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/clickable_size_38"
                    android:text="@string/title_corp_action_stock_split"
                    android:textAlignment="gravity"
                    style="@style/SbChipGreenBackground"/>
                <com.google.android.material.chip.Chip
                    android:textAppearance="@style/SdChipText"
                    android:gravity="center"
                    android:id="@+id/c_reverse_split"
                    android:padding="@dimen/item_gap_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/clickable_size_38"
                    android:text="@string/text_reverse_split"
                    android:textAlignment="gravity"
                    style="@style/SbChipGreenBackground"/>
                <com.google.android.material.chip.Chip
                    android:textAppearance="@style/SdChipText"
                    android:gravity="center"
                    android:id="@+id/c_right_issue"
                    android:padding="@dimen/item_gap_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/clickable_size_38"
                    android:text="@string/text_right_issue"
                    android:textAlignment="gravity"
                    style="@style/SbChipGreenBackground"/>
                <com.google.android.material.chip.Chip
                    android:textAppearance="@style/SdChipText"
                    android:gravity="center"
                    android:id="@+id/c_warrant"
                    android:padding="@dimen/item_gap_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/clickable_size_38"
                    android:text="@string/text_warrant"
                    android:textAlignment="gravity"
                    style="@style/SbChipGreenBackground"/>
                <com.google.android.material.chip.Chip
                    android:textAppearance="@style/SdChipText"
                    android:gravity="center"
                    android:id="@+id/c_bonus"
                    android:padding="@dimen/item_gap_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/clickable_size_38"
                    android:text="@string/title_corp_action_bonus_share"
                    android:textAlignment="gravity"
                    style="@style/SbChipGreenBackground"/>
                <com.google.android.material.chip.Chip
                    android:textAppearance="@style/SdChipText"
                    android:gravity="center"
                    android:id="@+id/c_tender_offer"
                    android:padding="@dimen/item_gap_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/clickable_size_38"
                    android:text="@string/text_tender_offer"
                    android:textAlignment="gravity"
                    style="@style/SbChipGreenBackground"/>
                <com.google.android.material.chip.Chip
                    android:textAppearance="@style/SdChipText"
                    android:gravity="center"
                    android:id="@+id/c_rups"
                    android:padding="@dimen/item_gap_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/clickable_size_38"
                    android:text="@string/text_rups"
                    android:textAlignment="gravity"
                    style="@style/SbChipGreenBackground"/>
                <com.google.android.material.chip.Chip
                    android:textAppearance="@style/SdChipText"
                    android:gravity="center"
                    android:id="@+id/c_public_expose"
                    android:padding="@dimen/item_gap_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/clickable_size_38"
                    android:text="@string/text_public_expose"
                    android:textAlignment="gravity"
                    style="@style/SbChipGreenBackground"/>
                <com.google.android.material.chip.Chip
                    android:textAppearance="@style/SdChipText"
                    android:gravity="center"
                    android:id="@+id/c_ipo"
                    android:padding="@dimen/item_gap_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/clickable_size_38"
                    android:text="@string/text_ipo"
                    android:textAlignment="gravity"
                    style="@style/SbChipGreenBackground"/>
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
        <com.stockbit.common.uikit.ExViewPager
            android:id="@+id/evp_calendar_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <include
        android:id="@+id/dialog_paywall"
        android:visibility="gone"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        layout="@layout/dialog_bottom_sheet_info"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
