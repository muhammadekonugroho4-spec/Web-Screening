<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_print_upload_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_16"
            android:id="@+id/actv_title"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_16"
            android:text="@string/transfer_stock_title_upload"
            android:layout_marginStart="@dimen/item_gap_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SbTextView.ListTitle.Highempasis.Bold"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/actv_desc"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:text="@string/transfer_stock_title_upload_desc"
            android:layout_marginStart="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/item_gap_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/actv_title"
            style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_tnq_list"
            android:background="?attr/themeGreenTnC"
            android:paddingBottom="@dimen/item_gap_12"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:layout_marginStart="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/item_gap_20"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/actv_desc"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_border_shimmer_color"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_16"
            android:layout_marginBottom="@dimen/item_gap_50"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/rv_tnq_list"
            app:layout_constraintStart_toStartOf="@+id/rv_tnq_list"
            app:layout_constraintTop_toBottomOf="@+id/rv_tnq_list">
            <TextView
                android:gravity="left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/item_gap_18"
                android:layout_marginTop="@dimen/item_gap_18"
                android:text="@string/transfer_stock_title_upload_second"
                android:textAlignment="gravity"
                style="@style/SbTextView.ListTitle.Highempasis.Bold"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_file_upload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_10"
                android:layout_marginStart="@dimen/item_gap_18"
                android:layout_marginEnd="@dimen/item_gap_20"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <Button
                android:textSize="@dimen/text_size_13"
                android:textStyle="normal"
                android:layout_gravity="center_horizontal"
                android:tag="binding_1"
                android:background="@drawable/border_green_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/clickable_size_40"
                android:layout_marginTop="@dimen/item_gap_18"
                android:text="@string/transfer_stock_upload_button_add"
                android:layout_marginStart="@dimen/item_gap_18"
                android:layout_marginEnd="@dimen/item_gap_18"
                style="@style/SbBtnBorderless.Default"/>
            <TextView
                android:gravity="left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_18"
                android:layout_marginBottom="@dimen/item_gap_18"
                android:text="@string/transfer_stock_upload_tnq"
                android:textAlignment="gravity"
                android:layout_marginStart="@dimen/item_gap_18"
                android:layout_marginEnd="@dimen/item_gap_18"
                style="@style/SbTextView.ListSubtitle.Highgray"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
