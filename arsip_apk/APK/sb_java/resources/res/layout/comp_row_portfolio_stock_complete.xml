<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/ll_stock_value"
    android:tag="layout/comp_row_portfolio_stock_complete_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:baselineAligned="false"
    android:minHeight="@dimen/portfolio_row_item_complete_height"
    android:paddingHorizontal="@dimen/spacing_20"
    app:layout_constraintBottom_toTopOf="@+id/v_item_divider"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rl_trading_portfolio_row_code"
        android:layout_width="@dimen/width_83"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center_vertical"
            android:id="@+id/tv_trading_portfolio_row_symbol"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingXSmall"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_trading_portfolio_row_notation_company"
            android:visibility="gone"
            android:layout_width="@dimen/width_12"
            android:layout_height="@dimen/height_12"
            android:scaleType="fitXY"
            android:layout_marginStart="@dimen/spacing_4"
            app:layout_constraintBottom_toBottomOf="@+id/tv_trading_portfolio_row_symbol"
            app:layout_constraintStart_toEndOf="@+id/tv_trading_portfolio_row_symbol"
            app:layout_constraintTop_toTopOf="@+id/tv_trading_portfolio_row_symbol"
            app:srcCompat="@drawable/ic_notasi_khusus"/>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rv_horizontal_notation"
            android:visibility="gone"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/width_12"
            android:minHeight="@dimen/height_16"
            android:layout_marginStart="@dimen/spacing_4"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="@+id/tv_trading_portfolio_row_symbol"
            app:layout_constraintStart_toEndOf="@+id/iv_trading_portfolio_row_notation_company"
            app:layout_constraintTop_toTopOf="@+id/tv_trading_portfolio_row_symbol"
            app:spanCount="1"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_trading_portfolio_row_corporate_action"
            android:visibility="gone"
            android:layout_width="@dimen/width_12"
            android:layout_height="@dimen/width_12"
            android:contentDescription="@string/SHARED_7"
            android:layout_marginStart="@dimen/spacing_4"
            app:layout_constraintBottom_toBottomOf="@+id/tv_trading_portfolio_row_symbol"
            app:layout_constraintStart_toEndOf="@+id/rv_horizontal_notation"
            app:layout_constraintTop_toTopOf="@+id/tv_trading_portfolio_row_symbol"
            app:srcCompat="@drawable/ic_corporate_action"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_company_delisted"
            android:visibility="gone"
            android:layout_width="@dimen/width_12"
            android:layout_height="@dimen/width_12"
            android:contentDescription="@string/SHARED_7"
            android:layout_marginStart="@dimen/spacing_4"
            app:layout_constraintBottom_toBottomOf="@+id/tv_trading_portfolio_row_symbol"
            app:layout_constraintStart_toEndOf="@+id/iv_trading_portfolio_row_corporate_action"
            app:layout_constraintTop_toTopOf="@+id/tv_trading_portfolio_row_symbol"
            app:srcCompat="@drawable/ic_portfolio_company_delisted_info"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_trading_portfolio_row_lot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:minHeight="15dp"
            android:layout_centerHorizontal="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_trading_portfolio_row_symbol"
            style="@style/TypeStyles.BodyXXSmall"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Space
        android:layout_width="@dimen/spacing_4"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:id="@+id/rl_trading_portfolio_row_invested"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <androidx.appcompat.widget.AppCompatTextView
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/tv_trading_portfolio_row_invested"
            android:tag="binding_2"
            android:paddingTop="@dimen/spacing_2"
            android:paddingBottom="@dimen/spacing_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            android:lines="1"
            android:layout_alignParentStart="true"
            style="@style/TypeStyles.BodyXSmall"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_trading_portfolio_row_price_avg"
            android:tag="binding_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:minHeight="15dp"
            android:layout_below="@+id/tv_trading_portfolio_row_invested"
            android:layout_centerHorizontal="true"
            style="@style/TypeStyles.BodyXXSmall"/>
    </RelativeLayout>
    <Space
        android:layout_width="@dimen/spacing_4"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:id="@+id/rl_trading_portfolio_row_market"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="end|center_vertical"
            android:id="@+id/tv_trading_portfolio_row_market"
            android:tag="binding_4"
            android:paddingTop="@dimen/spacing_2"
            android:paddingBottom="@dimen/spacing_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            android:layout_alignParentStart="true"
            style="@style/TypeStyles.BodyXSmall"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="end|center_vertical"
            android:id="@+id/tv_trading_portfolio_row_current_price"
            android:tag="binding_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:minHeight="15dp"
            android:layout_below="@+id/tv_trading_portfolio_row_market"
            android:layout_centerHorizontal="true"
            style="@style/TypeStyles.BodyXXSmall"/>
    </RelativeLayout>
    <Space
        android:layout_width="@dimen/spacing_4"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:id="@+id/rl_trading_portfolio_row_profit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="end|center_vertical"
            android:id="@+id/tv_trading_portfolio_row_pnl"
            android:tag="binding_6"
            android:paddingTop="@dimen/spacing_2"
            android:paddingBottom="@dimen/spacing_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="16dp"
            android:layout_centerHorizontal="true"
            style="@style/TypeStyles.HeadingXSmall"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="end|center_vertical"
            android:id="@+id/tv_trading_portfolio_row_gain"
            android:tag="binding_7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:minHeight="15dp"
            android:layout_below="@+id/tv_trading_portfolio_row_pnl"
            style="@style/TypeStyles.HeadingXSmall"/>
    </RelativeLayout>
</LinearLayout>
