<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlParentConversation"
    android:tag="layout/item_stream_conversation_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivUserProfile"
        android:tag="binding_1"
        android:padding="@dimen/item_gap_xxxs"
        android:focusable="false"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="@dimen/item_gap_m"
        android:layout_marginStart="@dimen/item_gap_20"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/parentCompStreamUserInfoAndBadgesRoot"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_24"
        android:layout_marginLeft="@dimen/spacing_10"
        android:layout_marginTop="@dimen/item_gap_m"
        android:layout_toRightOf="@+id/ivUserProfile">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvUserInfoUserName"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            style="@style/TypeStyles.HeadingRegular"/>
        <FrameLayout
            android:layout_width="@dimen/width_16"
            android:layout_height="@dimen/height_16"
            android:layout_marginLeft="@dimen/item_gap_4">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/ivUserInfoVerifiedBadge"
                android:tag="binding_3"
                android:layout_width="@dimen/width_12"
                android:layout_height="@dimen/height_12"
                android:scaleType="fitXY"
                android:contentDescription="@string/hint_verified_user_badge"/>
        </FrameLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_10"
            android:textColor="?attr/themeColorTextTetriary"
            android:layout_gravity="center"
            android:id="@+id/tvUserInfoTopUserBadge"
            android:tag="binding_4"
            android:background="@drawable/border_gray_rounded_stream"
            android:paddingLeft="@dimen/spacing_4"
            android:paddingTop="@dimen/height_2"
            android:paddingRight="@dimen/spacing_4"
            android:paddingBottom="@dimen/height_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_s"
            android:text="@string/lbl_badge_title_top"
            android:lines="1"
            style="@style/TypeStyles.Bold"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_10"
            android:textColor="?attr/themeColorTextTetriary"
            android:layout_gravity="center"
            android:id="@+id/tvUserInfoAdminUserBadge"
            android:background="@drawable/border_gray_rounded_stream"
            android:paddingLeft="@dimen/spacing_4"
            android:paddingTop="@dimen/height_2"
            android:paddingRight="@dimen/spacing_4"
            android:paddingBottom="@dimen/height_2"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_s"
            android:text="@string/lbl_badge_title_admin"
            android:lines="1"
            style="@style/TypeStyles.Bold"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_badge_violation_alert"
        android:visibility="gone"
        android:layout_width="@dimen/item_gap_59"
        android:layout_height="@dimen/height_20"
        android:src="?attr/themeIconStreamAlertFull"
        android:layout_alignTop="@+id/btnMore"
        android:layout_alignBottom="@+id/btnMore"
        android:contentDescription="@string/stream_dialog_title_content_warning"
        android:layout_marginEnd="@dimen/item_gap_12"
        android:layout_toStartOf="@+id/btnMore"/>
    <ImageButton
        android:gravity="right"
        android:layout_gravity="right"
        android:id="@+id/btnMore"
        android:tag="binding_5"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:focusable="false"
        android:layout_width="@dimen/height_24"
        android:layout_height="@dimen/width_24"
        android:layout_alignTop="@+id/parentCompStreamUserInfoAndBadgesRoot"
        android:layout_alignBottom="@+id/parentCompStreamUserInfoAndBadgesRoot"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:srcCompat="@drawable/ic_more_horizontal"
        app:tint="?attr/themeIconTintColor"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/vImageRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_2"
        android:layout_toRightOf="@+id/ivUserProfile"
        android:layout_below="@+id/parentCompStreamUserInfoAndBadgesRoot"
        android:layout_marginStart="@dimen/spacing_10"
        android:layout_marginEnd="@dimen/item_gap_20">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="center_vertical"
            android:id="@+id/tvConversationReplyDatePosted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TypeStyles.BodyXXSmall"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:ellipsize="end"
            android:id="@+id/tvItemConversationReplyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_6"
            style="@style/TypeStyles.BodyLarge"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/parent_comment_yt_preview"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            app:cardCornerRadius="@dimen/item_gap_null"
            app:cardElevation="@dimen/item_gap_null">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/parent_comment_item_yt_preview_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_youtube_thumb"
                    android:background="@drawable/bg_image_placeholder"
                    android:focusable="true"
                    android:visibility="visible"
                    android:clickable="true"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintDimensionRatio="v,16:9"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/iv_play_youtube"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_play_video"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_youtube_thumb"
                    app:layout_constraintEnd_toEndOf="@+id/iv_youtube_thumb"
                    app:layout_constraintStart_toStartOf="@+id/iv_youtube_thumb"
                    app:layout_constraintTop_toTopOf="@+id/iv_youtube_thumb"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="?attr/themeSeparatorGapColor"
                    android:paddingTop="@dimen/item_gap_8"
                    android:paddingBottom="@dimen/item_gap_8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/item_gap_12"
                    android:paddingEnd="@dimen/item_gap_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_youtube_thumb">
                    <TextView
                        android:id="@+id/tv_youtube_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/item_gap_8"
                        style="@style/SbTextView.ListTitle.Highempasis.Bold"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_youtube_provider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/SbTextView.ListTitle.Highempasis.Normal"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:layout_gravity="center_horizontal"
        android:id="@+id/cardConversationReplyImageContainer"
        android:tag="binding_6"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_m"
        android:layout_marginTop="@dimen/item_gap_m"
        android:layout_marginRight="@dimen/item_gap_l"
        android:layout_toRightOf="@+id/ivUserProfile"
        android:layout_below="@+id/vImageRoot"
        app:cardCornerRadius="@dimen/shape_radius_m"
        app:cardElevation="@dimen/item_gap_null">
        <FrameLayout
            android:gravity="center"
            android:id="@+id/parentConversationReplyImageContainer"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackgroundBorderless">
            <com.stockbit.stream.utils.AutoRatioImageView
                android:id="@+id/image_content"
                android:tag="binding_7"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/parentRepliedRoot"
        android:tag="binding_8"
        android:background="?attr/themeColorSurfaceVariant"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_m"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:layout_toRightOf="@+id/ivUserProfile"
        android:layout_below="@+id/cardConversationReplyImageContainer"
        android:layout_marginStart="@dimen/spacing_10"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:cardBackgroundColor="?attr/themeColorSurfaceVariant"
        app:cardCornerRadius="@dimen/shape_radius_m"
        app:cardElevation="@dimen/item_gap_null">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingTop="@dimen/item_gap_xs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/parentRepliedUserInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="?attr/themeColorTextTetriary"
                    android:id="@+id/tvRepliedUsername"
                    android:tag="binding_9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/item_gap_12"
                    android:layout_marginTop="@dimen/item_gap_10"
                    style="@style/TypeStyles.BodyXXSmall"/>
            </RelativeLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:ellipsize="end"
                android:id="@+id/tvRepliedCommentContent"
                android:paddingTop="@dimen/item_gap_6"
                android:paddingBottom="@dimen/item_gap_12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/item_gap_12"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/parentRepliedUserInfo"
                app:layout_goneMarginBottom="@dimen/shape_radius_l"
                app:layout_goneMarginTop="@dimen/shape_radius_l"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:id="@+id/tv_item_conversation_reply_read_more"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_read_more"
                android:layout_marginStart="@dimen/item_gap_12"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvRepliedCommentContent"
                style="@style/TypeStyles.BodyXSmall.Green"/>
            <com.stockbit.stream.utils.AutoRatioImageView
                android:id="@+id/ivRepliedCommentImage"
                android:tag="binding_10"
                android:background="@drawable/bg_image_placeholder"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/item_gap_m"
                android:layout_marginTop="@dimen/item_gap_m"
                android:layout_marginRight="@dimen/item_gap_m"
                android:contentDescription="@string/hint_post_image"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_item_conversation_reply_read_more"/>
            <Space
                android:id="@+id/space"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/item_gap_m"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivRepliedCommentImage"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/parentCompDownloadableContentRoot"
        android:background="@drawable/bg_rounded_gray_transparent_bg"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_m"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:layout_toRightOf="@+id/ivUserProfile"
        android:layout_below="@+id/parentRepliedRoot"
        android:layout_marginStart="@dimen/spacing_10"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:cardBackgroundColor="?attr/themeContentBackgroundStreamLastReply"
        app:cardCornerRadius="@dimen/shape_radius_m"
        app:cardElevation="@dimen/item_gap_null">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/clickable_size_32">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivCompDownloadableContentIcon"
                android:layout_width="@dimen/item_gap_l"
                android:layout_height="@dimen/item_gap_l"
                android:layout_marginLeft="@dimen/item_gap_s"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ic_attach_file_black_24dp"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:ellipsize="middle"
                android:id="@+id/tvCompDownloadableContentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/item_gap_s"
                android:layout_marginRight="@dimen/item_gap_l"
                android:singleLine="true"
                android:layout_toRightOf="@+id/ivCompDownloadableContentIcon"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                style="@style/TypeStyles.BodyRegular"/>
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_view_stream_emoji_reaction"
        android:tag="binding_11"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/ivUserProfile"
        android:layout_below="@+id/parentCompDownloadableContentRoot"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/acivRefresh"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_10"
        android:layout_toRightOf="@+id/ivUserProfile"
        android:layout_below="@+id/compose_view_stream_emoji_reaction"
        android:layout_marginStart="@dimen/spacing_10"
        app:srcCompat="@drawable/ic_refresh_red"/>
    <View
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/spacing_20"
        android:layout_below="@+id/acivRefresh"/>
</RelativeLayout>
