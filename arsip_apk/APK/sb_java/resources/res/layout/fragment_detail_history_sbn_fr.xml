<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_detail_history_sbn_fr_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_tradingHistory_dividend_stockbit_detail"
        android:paddingLeft="@dimen/spacing_0"
        android:paddingRight="@dimen/spacing_0"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:minHeight="?attr/actionBarSize"
        app:contentInsetLeft="@dimen/spacing_0"
        app:contentInsetStart="@dimen/spacing_0"
        app:contentInsetStartWithNavigation="@dimen/spacing_0"
        app:elevation="@dimen/spacing_0"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minHeight="?attr/actionBarSize">
            <TextView
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/tv_toolbar_title_trading_history_dividend_stockbit_detail"
                android:paddingLeft="@dimen/spacing_16"
                android:paddingRight="@dimen/spacing_16"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:singleLine="true"
                android:layout_centerHorizontal="true"
                android:textAlignment="gravity"
                style="@style/TopBar.Title"/>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/ll_company_info"
        android:background="@drawable/border_gray_rounded_white_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:layout_marginBottom="@dimen/spacing_16"
        android:foreground="?attr/selectableItemBackground"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_tradingHistory_dividend_stockbit_detail">
        <ImageView
            android:id="@+id/iv_company_logo"
            android:layout_width="@dimen/width_40"
            android:layout_height="@dimen/height_40"
            android:contentDescription="@string/company_profile_company"/>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/item_gap_10"
            android:layout_toEndOf="@+id/iv_company_logo">
            <TextView
                android:textColor="?attr/themeColorTextPrimary"
                android:id="@+id/tv_trading_history_dividend_stockbit_detail_symbol_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TypeStyles.HeadingRegular"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/tv_trading_history_dividend_stockbit_detail_desc_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2"
                android:maxLines="1"
                android:layout_below="@+id/tv_trading_history_dividend_stockbit_detail_symbol_title"
                style="@style/TypeStyles.BodyXSmall.Secondary"/>
            <RelativeLayout
                android:id="@+id/rl_history_detail_dividend_acceleration"
                android:background="@drawable/border_green_button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/clickable_size_18"
                android:layout_above="@+id/tv_trading_history_dividend_stockbit_detail_desc_title"
                android:layout_marginStart="@dimen/item_gap_s"
                android:layout_toEndOf="@+id/tv_trading_history_dividend_stockbit_detail_symbol_title"/>
        </RelativeLayout>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:background="@drawable/border_gray_rounded_white_bg"
        android:padding="@dimen/spacing_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_6"
        android:foreground="?attr/selectableItemBackground"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_company_info">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline_data"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.55"/>
        <TextView
            android:id="@+id/tv_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/guideline_data"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_date_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline_data"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:id="@+id/tv_sell_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_14"
            android:text="@string/sell_amount_currency_idr"
            app:layout_constraintEnd_toStartOf="@+id/guideline_data"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_date"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_sell_amount_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline_data"
            app:layout_constraintTop_toTopOf="@+id/tv_sell_amount"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:id="@+id/tv_sell_price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_14"
            android:text="@string/sell_price_percentage"
            app:layout_constraintEnd_toStartOf="@+id/guideline_data"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_sell_amount"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_sell_price_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline_data"
            app:layout_constraintTop_toTopOf="@+id/tv_sell_price"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:id="@+id/tv_avg_buy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_14"
            android:text="@string/avg_buy_price_percentage"
            app:layout_constraintEnd_toStartOf="@+id/guideline_data"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_sell_price"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_avg_buy_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline_data"
            app:layout_constraintTop_toTopOf="@+id/tv_avg_buy"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:id="@+id/tv_return_tax"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_14"
            android:text="@string/tax_return"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_avg_buy"
            style="@style/TypeStyles.BodyRegular"/>
        <ImageView
            android:id="@+id/iv_icon_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_info"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/spacing_4"
            app:layout_constraintBottom_toBottomOf="@+id/tv_return_tax"
            app:layout_constraintEnd_toStartOf="@+id/guideline_data"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/tv_return_tax"
            app:layout_constraintTop_toTopOf="@+id/tv_return_tax"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_return_tax_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline_data"
            app:layout_constraintTop_toTopOf="@+id/tv_return_tax"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:id="@+id/tv_total_amount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_14"
            app:layout_constraintEnd_toStartOf="@+id/guideline_data"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_return_tax"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_total_amount_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline_data"
            app:layout_constraintTop_toTopOf="@+id/tv_total_amount"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:id="@+id/tv_realized"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_14"
            app:layout_constraintEnd_toStartOf="@+id/guideline_data"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_total_amount"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_realized_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline_data"
            app:layout_constraintTop_toTopOf="@+id/tv_realized"
            style="@style/TypeStyles.HeadingRegular"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_maturity_redemption"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tv_sell_price,tv_sell_price_value,tv_sell_amount,tv_sell_amount_value,tv_avg_buy,tv_avg_buy_value,tv_return_tax,tv_return_tax_value,iv_icon_info,tv_realized,tv_realized_value"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
