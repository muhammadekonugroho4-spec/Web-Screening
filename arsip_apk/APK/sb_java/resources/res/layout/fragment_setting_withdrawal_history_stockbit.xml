<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_setting_withdrawal_history_stockbit_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_history_desc"
        android:background="@drawable/border_green_withdrawal_rounded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ic_lamp_inverse"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:layout_gravity="center"
            android:paddingTop="@dimen/item_gap_10"
            android:paddingBottom="@dimen/item_gap_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setting_withdrawal_history_desc"
            android:layout_centerInParent="true"
            android:textAlignment="gravity"
            android:layout_marginStart="@dimen/item_gap_16"
            style="@style/SbTextView.BodyDefault"/>
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="end"
        android:orientation="horizontal"
        android:id="@+id/rlWithdrawalHistoryPeriod"
        android:background="@drawable/bg_theme_gray_rounded_outline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_9"
        android:layout_marginBottom="@dimen/item_gap_9"
        android:paddingStart="@dimen/item_gap_12"
        android:paddingEnd="@dimen/item_gap_16"
        android:layout_marginEnd="@dimen/item_gap_20">
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="?attr/themeContentTextColor"
            android:gravity="center"
            android:id="@+id/tvWithdrawalHistoryPeriod"
            android:paddingTop="@dimen/item_gap_12"
            android:paddingBottom="@dimen/item_gap_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/all_history_trading"
            android:layout_weight="0.15"
            android:textAlignment="gravity"
            android:layout_marginStart="@dimen/item_gap_xxs"
            android:layout_marginEnd="@dimen/item_gap_12"
            style="@style/SbTextView.BodyDefault"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/ivWithdrawalHistoryPeriod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:rotation="90"
            android:layout_marginEnd="@dimen/item_gap_xxs"
            app:srcCompat="@drawable/ic_chevron_right_small"/>
    </LinearLayout>
    <ViewFlipper
        android:id="@+id/vf_content"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include layout="@layout/skeleton_history_wd_deposit"/>
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/srlFragmentWithdrawalHistory"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFragmentWithdrawalHistory"
                android:background="?attr/themeColorSurfaceDefault"
                android:scrollbars="vertical"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <include
            android:layout_gravity="center"
            android:id="@+id/parentErrorWithdrawalHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/comp_icon_error_view"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/item_gap_50">
            <ImageView
                android:layout_width="@dimen/width_100"
                android:layout_height="@dimen/height_100"
                android:src="@drawable/ic_no_deposit"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/history_withdrawal_empty"
                android:layout_marginStart="@dimen/item_gap_24"
                android:layout_marginEnd="@dimen/item_gap_24"
                style="@style/TypeStyles.BodyRegular"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/item_gap_95">
            <ImageView
                android:layout_width="@dimen/width_100"
                android:layout_height="@dimen/height_100"
                android:src="@drawable/ic_no_deposit"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/history_withdrawal_empty_period"
                android:layout_marginStart="@dimen/item_gap_24"
                android:layout_marginEnd="@dimen/item_gap_24"
                style="@style/TypeStyles.BodyRegular"/>
        </LinearLayout>
    </ViewFlipper>
</androidx.appcompat.widget.LinearLayoutCompat>
