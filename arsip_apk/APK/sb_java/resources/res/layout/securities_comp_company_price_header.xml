<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/border_gray_rounded_white_bg"
    android:foreground="?attr/selectableItemBackgroundBorderless">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_company_logo"
        android:layout_width="@dimen/spacing_40"
        android:layout_height="@dimen/spacing_40"
        android:layout_marginStart="@dimen/spacing_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tv_symbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2"
        android:text="@string/alert_detail_empty"
        android:layout_centerVertical="true"
        android:textAlignment="gravity"
        android:layout_marginStart="@dimen/spacing_12"
        app:layout_constraintStart_toEndOf="@+id/iv_company_logo"
        app:layout_constraintTop_toTopOf="@+id/iv_company_logo"
        style="@style/TypeStyles.HeadingRegular"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_notation_company"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/spacing_12"
        android:scaleType="fitXY"
        android:layout_toRightOf="@+id/tv_symbol"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/spacing_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_symbol"
        app:layout_constraintStart_toEndOf="@+id/tv_symbol"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol"
        app:srcCompat="@drawable/ic_notasi_khusus"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rv_notation"
        android:visibility="gone"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/spacing_12"
        android:scaleType="fitXY"
        android:minHeight="@dimen/height_16"
        android:layout_toRightOf="@+id/iv_notation_company"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/spacing_4"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="@+id/iv_notation_company"
        app:layout_constraintStart_toEndOf="@+id/iv_notation_company"
        app:layout_constraintTop_toTopOf="@+id/iv_notation_company"
        app:spanCount="1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_notation_x"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/rv_notation"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/spacing_4"
        app:layout_constraintBottom_toBottomOf="@+id/rv_notation"
        app:layout_constraintStart_toEndOf="@+id/rv_notation"
        app:layout_constraintTop_toTopOf="@+id/rv_notation"
        app:srcCompat="?attr/themeIconNotationX"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_corporate_action"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/spacing_12"
        android:layout_toRightOf="@+id/iv_notation_company"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/spacing_4"
        app:layout_constraintBottom_toBottomOf="@+id/iv_notation_x"
        app:layout_constraintStart_toEndOf="@+id/iv_notation_x"
        app:layout_constraintTop_toTopOf="@+id/iv_notation_x"
        app:srcCompat="@drawable/ic_corporate_action"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_notation_uma"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toRightOf="@+id/iv_notation_company"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/spacing_4"
        app:layout_constraintBottom_toBottomOf="@+id/iv_corporate_action"
        app:layout_constraintStart_toEndOf="@+id/iv_corporate_action"
        app:layout_constraintTop_toTopOf="@+id/iv_corporate_action"
        app:srcCompat="?attr/themeIconNotationUmaOrderPage"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_company_name"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:text="@string/alert_detail_empty"
        android:maxLines="1"
        android:maxEms="18"
        android:textAlignment="gravity"
        android:layout_marginEnd="@dimen/spacing_8"
        app:layout_constraintBottom_toBottomOf="@+id/iv_company_logo"
        app:layout_constraintEnd_toStartOf="@+id/cv_last_change"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tv_symbol"
        app:layout_constraintTop_toBottomOf="@+id/tv_symbol"
        app:layout_constraintWidth_default="wrap"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_company_info_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_16"
        app:layout_constraintBottom_toBottomOf="@+id/tv_company_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol"
        app:srcCompat="@drawable/ic_chevron_right_grey"
        app:tint="?attr/themeIconTintColor"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_day_trade_multiplier"
        android:background="@drawable/bg_day_trade_multiplier"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/item_gap_2"
        android:paddingEnd="@dimen/item_gap_4"
        android:layout_marginStart="@dimen/item_gap_4"
        android:paddingVertical="@dimen/item_gap_2"
        app:layout_constraintBottom_toBottomOf="@+id/iv_notation_uma"
        app:layout_constraintStart_toEndOf="@+id/iv_notation_uma"
        app:layout_constraintTop_toTopOf="@+id/iv_notation_uma">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_day_trade_multiplier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_day_trade_multiplier"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_securities_day_trade_multiplier"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/themeColorFeaturePeriwinkle"
            android:id="@+id/tv_day_trade_multiplier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/height_1"
            app:layout_constraintBottom_toBottomOf="@+id/iv_day_trade_multiplier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_day_trade_multiplier"
            app:layout_constraintTop_toTopOf="@+id/iv_day_trade_multiplier"
            style="@style/TypeStyles.HeadingXSmall"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorOliveDefault"
        android:id="@+id/tv_trading_limit"
        android:background="@drawable/bg_trading_limit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/spacing_4"
        android:paddingHorizontal="@dimen/spacing_4"
        android:paddingVertical="@dimen/item_gap_2"
        app:layout_constraintBottom_toBottomOf="@+id/iv_notation_company"
        app:layout_constraintStart_toEndOf="@+id/cl_day_trade_multiplier"
        app:layout_constraintTop_toTopOf="@+id/iv_notation_company"
        style="@style/TypeStyles.HeadingXSmall"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorPinkDefault"
        android:id="@+id/tv_margin_trading"
        android:background="@drawable/bg_margin_trading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="M"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/spacing_4"
        android:paddingHorizontal="@dimen/spacing_4"
        android:paddingVertical="@dimen/item_gap_2"
        app:layout_constraintBottom_toBottomOf="@+id/iv_notation_company"
        app:layout_constraintStart_toEndOf="@+id/tv_trading_limit"
        app:layout_constraintTop_toTopOf="@+id/iv_notation_company"
        style="@style/TypeStyles.HeadingXSmall"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/llc_badges_container"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_4"
        app:layout_constraintBottom_toBottomOf="@+id/iv_notation_company"
        app:layout_constraintEnd_toStartOf="@+id/iv_company_info_detail"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/tv_margin_trading"
        app:layout_constraintTop_toTopOf="@+id/iv_notation_company"/>
</merge>
