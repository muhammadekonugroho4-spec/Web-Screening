<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_screener_favorites_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="start"
        android:id="@+id/tv_no_swipe"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/clickable_size_56"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_delete_company_watch_list"
        android:background="@color/google_red"
        android:padding="@dimen/item_gap_m"
        android:layout_width="@dimen/clickable_size_72"
        android:layout_height="@dimen/clickable_size_56"
        android:text="@string/btn_delete_watchlist"
        android:layout_alignParentRight="true"
        style="@style/SbTextView.BodyDefault"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/cl_content_view"
        android:background="@drawable/bg_list_selector"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_56">
        <TextView
            android:textSize="@dimen/text_size_14"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_name"
            android:paddingLeft="@dimen/item_gap_20"
            android:paddingRight="@dimen/item_gap_20"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintBottom_toTopOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/SbTextView.BodyDefault"/>
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/item_gap_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_chevron_right_highray"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
