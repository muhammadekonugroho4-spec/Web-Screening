<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:tag="layout/dialog_stream_company_select_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.materrial.bottomsheet.BottomSheetBehavior">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_compose_target_price_company"
        android:layout_marginVertical="@dimen/spacing_8"
        style="@style/TypeStyles.HeadingLarge"/>
    <com.stockbit.uikit.topbar.TopBarStockbitSearch
        android:id="@+id/sb_company_select"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/transparent"
        android:layout_marginVertical="@dimen/spacing_8"
        app:topBarSearchPrefixIcon="@drawable/uikit_ic_stockbit_search_bar_search"
        app:topBarSearchQueryHint="@string/placeholder_search"
        app:topBarSearchVariant="container_fill"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/spacing_4"
        android:layout_marginBottom="@dimen/spacing_24">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_company_selector"
            android:tag="binding_1"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/spacing_20"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <androidx.core.widget.ContentLoadingProgressBar
            android:layout_gravity="center_horizontal"
            android:id="@+id/pb_company_selector"
            android:tag="binding_2"
            android:visibility="gone"
            android:layout_width="@dimen/clickable_size_32"
            android:layout_height="@dimen/clickable_size_32"
            android:layout_marginTop="@dimen/spacing_48"
            android:layout_marginBottom="@dimen/spacing_48"
            style="@style/Base.Widget.AppCompat.ProgressBar"/>
    </FrameLayout>
</LinearLayout>
