<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_rateus_0"
    android:background="@drawable/bg_rounded_white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lavAnimation"
        android:layout_width="90dp"
        android:layout_height="79dp"
        android:layout_marginTop="@dimen/clickable_size_24"
        android:scaleType="fitCenter"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="false"
        app:lottie_fileName="lottie_anim_rate_us_animation.json"
        app:lottie_loop="false"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:paddingLeft="@dimen/clickable_size_48"
        android:paddingRight="@dimen/clickable_size_48"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/clickable_size_24"
        android:text="Enjoying the App?"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lavAnimation"
        style="@style/SbTextView.PageHeadline"/>
    <View
        android:id="@+id/viewRateUsSeparator"
        android:background="?attr/themeSeparatorGapColor"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_l"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <Button
        android:textSize="@dimen/text_size_18"
        android:textColor="@color/green_text"
        android:id="@+id/btnLove"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="I love this App"
        android:textAllCaps="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewRateUsSeparator"
        style="@style/SbTextView.PageTitle"/>
    <View
        android:id="@+id/viewRateUsSep2"
        android:background="?attr/themeSeparatorGapColor"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_xxxs"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnLove"/>
    <Button
        android:textSize="@dimen/text_button"
        android:textColor="@color/highgray_light"
        android:id="@+id/btnDislike"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="I don&apos;t like this App"
        android:textAllCaps="false"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewRateUsSep2"
        style="@style/SbTextView.BodyDefault"/>
    <View
        android:id="@+id/viewRateUsSep3"
        android:background="?attr/themeSeparatorGapColor"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_xxxs"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnDislike"/>
    <Button
        android:textSize="@dimen/text_size_10"
        android:textColor="@color/gray_text"
        android:id="@+id/btnRemindLater"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="@dimen/item_gap_l"
        android:paddingRight="@dimen/item_gap_l"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Remind me later"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewRateUsSep3"
        style="@style/SbTextView.CaptionSecondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
