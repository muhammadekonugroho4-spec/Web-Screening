<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_parent_stream_polling_choice"
    android:tag="layout/item_conversation_polling_option_0"
    android:layout_width="match_parent"
    android:layout_height="@dimen/clickable_size_40"
    android:layout_marginLeft="@dimen/item_gap_l"
    android:layout_marginTop="@dimen/item_gap_s"
    android:layout_marginRight="@dimen/item_gap_l"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/rl_parent_stream_polling_choice">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_parent_stream_polling_vote_bar_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/item_gap_xxxs"
        android:layout_marginBottom="@dimen/item_gap_xxxs">
        <ImageView
            android:id="@+id/iv_stream_polling_percentage_visible"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            app:srcCompat="@drawable/bg_rounded_gray"
            app:tint="?attr/themeSeparatorGapColor"/>
        <View
            android:id="@+id/v_stream_polling_percentage_hidden"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_comp_stream_polling_question"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_m"
        android:singleLine="true"
        android:maxLength="@integer/polling_choice_length"
        android:layout_centerVertical="true"
        style="@style/SbTextView.StreamListContent"/>
    <ImageView
        android:id="@+id/iv_comp_stream_polling_choice_indicator"
        android:visibility="gone"
        android:layout_width="@dimen/item_gap_l"
        android:layout_height="@dimen/item_gap_l"
        android:layout_marginLeft="@dimen/item_gap_m"
        android:layout_toRightOf="@+id/tv_comp_stream_polling_question"
        android:layout_centerVertical="true"
        app:srcCompat="@drawable/ic_check_circle_green_24dp"
        app:tint="@color/highgray_light"/>
    <TextView
        android:id="@+id/tv_comp_stream_polling_percentage_value"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_m"
        android:layout_marginRight="@dimen/item_gap_m"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        style="@style/SbTextView.BodyDefault"/>
    <View
        android:id="@+id/v_comp_stream_polling_clickable_area"
        android:background="@drawable/btn_polling_option"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
