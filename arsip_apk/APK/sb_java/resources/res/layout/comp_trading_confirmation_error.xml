<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_trading_confirmation_error_0"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_trading_confirmation_status_header_layout"
        android:background="@drawable/bg_top_rounded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:id="@+id/tv_trading_confirmation_status_title_header"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_24"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="@dimen/spacing_16"
            style="@style/TypeStyles.HeadlineRegular"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_trading_confirmation_status_content_layout"
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_trading_confirmation_status_header_layout">
        <FrameLayout
            android:id="@+id/fl_trading_confirmation_status_icon_fab_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_24"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true">
            <com.airbnb.lottie.LottieAnimationView
                android:layout_gravity="center"
                android:id="@+id/lav_trading_confirmation_status_icon_animated"
                android:layout_width="@dimen/width_80"
                android:layout_height="@dimen/height_80"
                android:scaleType="fitCenter"
                app:lottie_autoPlay="true"
                app:lottie_fileName="ic_lottie_process_loading_animation.json"
                app:lottie_loop="false"/>
            <app.rive.runtime.kotlin.RiveAnimationView
                android:layout_gravity="center"
                android:id="@+id/riv_success_order"
                android:tag="binding_2"
                android:layout_width="@dimen/width_100"
                android:layout_height="@dimen/height_100"
                app:riveResource="@raw/anim_order_sent_success"/>
        </FrameLayout>
        <TextView
            android:textColor="?attr/themeColorTextRed"
            android:gravity="center"
            android:id="@+id/tv_trading_confirmation_status_error_message"
            android:tag="binding_3"
            android:paddingLeft="@dimen/spacing_16"
            android:paddingTop="@dimen/item_gap_m"
            android:paddingRight="@dimen/spacing_16"
            android:paddingBottom="@dimen/item_gap_m"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/fl_trading_confirmation_status_icon_fab_layout"
            android:textAlignment="gravity"
            style="@style/TypeStyles.BodyRegular"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/snb_button_share_trade"
            android:tag="binding_4"
            android:background="@drawable/bg_box_default"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            android:layout_below="@+id/tv_trading_confirmation_status_error_message"
            android:layout_marginHorizontal="@dimen/spacing_20">
            <ImageView
                android:padding="@dimen/spacing_2"
                android:layout_width="@dimen/height_20"
                android:layout_height="@dimen/height_20"
                android:layout_marginEnd="@dimen/spacing_4"
                android:layout_marginVertical="@dimen/spacing_12"
                app:srcCompat="@drawable/ic_share_portfolio"
                app:tint="?attr/themeColorTextGreen"/>
            <TextView
                android:textColor="?attr/themeColorTextGreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lbl_button_title_share_trade"
                style="@style/TypeStyles.HeadingRegular"/>
        </LinearLayout>
        <Button
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/btn_trading_confirmation_status_done"
            android:tag="binding_5"
            android:background="@drawable/border_green_rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:layout_marginBottom="@dimen/item_gap_20"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:text="@string/lbl_btn_done"
            android:layout_below="@+id/snb_button_share_trade"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/item_gap_20"
            android:layout_marginHorizontal="@dimen/spacing_20"
            style="@style/SbTextView.BodyDefault"/>
    </RelativeLayout>
</RelativeLayout>
