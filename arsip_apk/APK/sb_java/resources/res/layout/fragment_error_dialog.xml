<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme"
    android:tag="layout/fragment_error_dialog_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/vgErrorDialogHeader"
        android:background="@drawable/bg_top_rounded"
        android:paddingTop="@dimen/item_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivErrorDialogClose"
            android:background="?attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            android:tint="@color/gray_text"
            android:layout_marginEnd="@dimen/item_gap_20"
            android:layout_alignParentEnd="true"
            app:srcCompat="0x7f08063f"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llErrorDialog"
        android:background="?attr/themeDialogBackgroundColor"
        android:paddingBottom="@dimen/item_gap_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/vgErrorDialogHeader">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/ivErrorDialogImage"
            android:layout_width="@dimen/clickable_size_96"
            android:layout_height="@dimen/clickable_size_96"
            android:layout_marginTop="@dimen/item_gap_8"
            android:layout_marginBottom="@dimen/item_gap_24"
            app:srcCompat="@drawable/ic_error_no_internet_connection"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:gravity="center"
            android:id="@+id/tvErrorDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/item_gap_l"
            android:text="@string/error_message_no_internet"
            android:textAlignment="gravity"
            android:layout_marginStart="@dimen/item_gap_l"
            android:layout_marginEnd="@dimen/item_gap_l"
            style="@style/SbTextView.BodyDefault.Bold"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="?attr/titleTextColorHighgray"
            android:gravity="center"
            android:id="@+id/tvErrorDialogSubTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/item_gap_20"
            android:text="@string/n_dash"
            android:textAlignment="gravity"
            android:layout_marginStart="@dimen/item_gap_32"
            android:layout_marginEnd="@dimen/item_gap_32"
            style="@style/SbTextView.BodyDefault"/>
        <Button
            android:textColor="@color/white"
            android:id="@+id/btn_ok"
            android:background="@drawable/border_green_rounded"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/item_gap_20"
            android:layout_marginTop="@dimen/item_gap_20"
            android:layout_marginRight="@dimen/item_gap_20"
            android:text="@string/btn_positive_oke"
            style="@style/SbBtn"/>
    </LinearLayout>
</RelativeLayout>
