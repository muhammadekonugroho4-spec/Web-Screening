<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/item_gap_l"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/viewSkeletonDetailPortolioPrice"
        android:background="@drawable/bg_rounded_gray"
        android:paddingTop="@dimen/item_gap_l"
        android:paddingBottom="@dimen/item_gap_l"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_84"
        android:backgroundTint="?attr/themeSeparatorGapColor"/>
    <View
        android:id="@+id/viewSkeletonDetailPorto"
        android:background="@drawable/bg_rounded_gray"
        android:paddingTop="@dimen/item_gap_l"
        android:paddingBottom="@dimen/item_gap_l"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_256"
        android:layout_marginTop="@dimen/item_gap_l"
        android:layout_below="@+id/viewSkeletonDetailPortolioPrice"
        android:backgroundTint="?attr/themeSeparatorGapColor"/>
    <View
        android:id="@+id/viewSkeletonHistoryTransaction"
        android:background="@drawable/bg_rounded_gray"
        android:paddingTop="@dimen/item_gap_l"
        android:paddingBottom="@dimen/item_gap_l"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_84"
        android:layout_marginTop="@dimen/item_gap_l"
        android:layout_below="@+id/viewSkeletonDetailPorto"
        android:backgroundTint="?attr/themeSeparatorGapColor"/>
    <View
        android:id="@+id/viewSkeletonSmartOrder"
        android:background="@drawable/bg_rounded_gray"
        android:paddingTop="@dimen/item_gap_l"
        android:paddingBottom="@dimen/item_gap_l"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_126"
        android:layout_marginTop="@dimen/item_gap_l"
        android:layout_below="@+id/viewSkeletonHistoryTransaction"
        android:backgroundTint="?attr/themeSeparatorGapColor"/>
    <View
        android:background="@drawable/bg_rounded_gray"
        android:paddingTop="@dimen/item_gap_l"
        android:paddingBottom="@dimen/item_gap_l"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_l"
        android:layout_alignParentBottom="true"
        android:backgroundTint="?attr/themeSeparatorGapColor"/>
</RelativeLayout>
