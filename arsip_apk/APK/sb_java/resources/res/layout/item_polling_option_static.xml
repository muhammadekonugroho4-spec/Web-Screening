<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentCompStreamPollingChoice"
    android:tag="layout/item_polling_option_static_0"
    android:duplicateParentState="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/clickable_size_32"
    android:layout_marginLeft="@dimen/item_gap_l"
    android:layout_marginTop="@dimen/item_gap_s"
    android:layout_marginRight="@dimen/item_gap_l"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/parentCompStreamPollingChoice">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/parentCompStreamPollingVoteBarContainer"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/item_gap_xxxs"
        android:layout_marginBottom="@dimen/item_gap_xxxs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/viewCompStreamPollingPercentageVisible"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            app:srcCompat="@drawable/bg_rounded_gray"
            app:tint="?attr/themeSeparatorGapColor"/>
        <View
            android:id="@+id/viewCompStreamPollingPercentageHidden"
            android:duplicateParentState="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:id="@+id/tvCompStreamPollingQuestion"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_m"
        android:singleLine="true"
        android:maxLength="@integer/polling_choice_length"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/ivCompStreamPollingChoiceIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SbTextView.StreamListContent"/>
    <ImageView
        android:id="@+id/ivCompStreamPollingChoiceIndicator"
        android:visibility="gone"
        android:layout_width="@dimen/item_gap_l"
        android:layout_height="@dimen/item_gap_l"
        android:layout_marginLeft="@dimen/item_gap_m"
        android:layout_centerVertical="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tvCompStreamPollingPercentageValue"
        app:layout_constraintStart_toEndOf="@+id/tvCompStreamPollingQuestion"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_check_circle_green_24dp"
        app:tint="@color/highgray_light"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="12sp"
        android:id="@+id/tvCompStreamPollingPercentageValue"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_m"
        android:layout_marginRight="@dimen/item_gap_m"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SbTextView.BodyDefault"/>
    <View
        android:id="@+id/viewCompStreamPollingClickableArea"
        android:background="@drawable/btn_polling_option"
        android:visibility="gone"
        android:duplicateParentState="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
