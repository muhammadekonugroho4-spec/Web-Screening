<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentRowDiscoverWatchlistHotlistRoot"
    android:background="?attr/themeColorSurfaceDefault"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/clickable_size_64">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/llparentWatchlistHotlistTitle"
        android:paddingLeft="@dimen/item_gap_l"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/parentRowDiscoverWatchlistHotlistFollowingStatus"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginLeft="@dimen/item_gap_l">
        <TextView
            android:gravity="left"
            android:id="@+id/tvRowDiscoverWatchlistHotlistSymbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/SbTextView.ListTitle"/>
        <TextView
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/tvRowDiscoverWatchlistHotlistName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_xxxs"
            android:singleLine="true"
            style="@style/SbTextView.CaptionSecondary"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/parentRowDiscoverWatchlistHotlistFollowingStatus"
        android:padding="@dimen/item_gap_l"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ivRowDiscoverWatchlistHotlistFollowingStatusIcon"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:scaleType="fitCenter"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/pbRowDiscoverWatchlistHotlistFollowingStatusLoadingIndicator"
            android:visibility="gone"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:indeterminate="true"
            android:indeterminateTint="@color/green_text"/>
    </FrameLayout>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupRowDiscoverWatchlistHotlist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="llparentWatchlistHotlistTitle,parentRowDiscoverWatchlistHotlistFollowingStatus"/>
    <View
        android:id="@+id/viewRowHotlistBorder"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_m"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
