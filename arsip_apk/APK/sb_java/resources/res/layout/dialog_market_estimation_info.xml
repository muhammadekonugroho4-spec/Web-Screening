<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/dialog_market_estimation_info_0"
    android:background="@drawable/bg_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/item_gap_20"
    android:paddingVertical="@dimen/spacing_12">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:srcCompat="?attr/rectangle_dialog"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_24"
        android:text="@string/text_market_estimation"
        style="@style/TypeStyles.HeadingLarge"/>
    <TextView
        android:id="@+id/tv_iep_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_24"
        android:text="@string/text_market_estimation_iep_title"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:id="@+id/tv_iep_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:text="@string/text_market_estimation_iep_description"
        style="@style/TypeStyles.BodySmall"/>
    <TextView
        android:id="@+id/tv_iev_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_24"
        android:text="@string/text_market_estimation_iev_title"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:id="@+id/tv_iev_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:text="@string/text_market_estimation_iev_description"
        style="@style/TypeStyles.BodySmall"/>
</LinearLayout>
