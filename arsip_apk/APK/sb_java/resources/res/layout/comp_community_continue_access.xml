<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/comp_community_continue_access_0"
    android:background="@drawable/bg_registration_existing_member_info"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_16"
    android:paddingVertical="@dimen/spacing_12">
    <TextView
        android:id="@+id/tv_community_continue_access_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_community_has_investment_advisor_license"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:id="@+id/tv_community_continue_access_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:text="@string/desc_community_has_investment_advisor_license"
        style="@style/TypeStyles.BodySmall"/>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/btn_community_continue_term_condition"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_40"
        android:layout_marginTop="@dimen/item_gap_12"
        android:text="@string/button_community_has_investment_advisor_license"
        android:textAllCaps="false"
        app:primaryButtonColor="green"/>
</LinearLayout>
