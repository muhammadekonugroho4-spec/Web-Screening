<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_mutual_fund_info_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <include
        android:id="@+id/layout_indicator"
        layout="@layout/comp_dialog_header_indicator"/>
    <RelativeLayout
        android:id="@+id/rl_information_title"
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        android:layout_below="@+id/layout_indicator">
        <ImageButton
            android:id="@+id/ib_information_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:layout_marginRight="@dimen/item_gap_m"
            android:scaleType="centerInside"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/navigation_drawer_close"
            app:srcCompat="0x7f08063f"
            app:tint="@color/highgray_light"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_information_title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/clickable_size_32"
            android:layout_marginLeft="@dimen/item_gap_l"
            android:includeFontPadding="false"
            android:layout_toLeftOf="@+id/ib_information_close"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            style="@style/SbTextView.PageTitle"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_information_title">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.stockbit.component.webview.component.SbWebView
                android:id="@+id/wv_information_content"
                android:paddingLeft="@dimen/item_gap_m"
                android:paddingRight="@dimen/item_gap_m"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/clickable_size_24"
                android:minHeight="@dimen/clickable_size_72"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_information_error"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:paddingBottom="@dimen/item_gap_l"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_l"
                style="@style/SbTextView.BodyDefault"/>
            <androidx.core.widget.ContentLoadingProgressBar
                android:id="@+id/clb_information"
                android:layout_width="@dimen/clickable_size_32"
                android:layout_height="@dimen/clickable_size_32"
                android:layout_marginTop="@dimen/item_gap_l"
                android:layout_centerHorizontal="true"
                android:indeterminateTint="@color/green_text"
                style="@style/Widget.AppCompat.ProgressBar"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
