<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:tag="layout/item_arrange_watchlist_favorite_0"
    android:layout_width="match_parent"
    android:layout_height="@dimen/height_52"
    android:layout_marginTop="@dimen/item_gap_16"
    android:layout_marginHorizontal="@dimen/item_gap_20">
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_drag"
        android:layout_width="@dimen/width_24"
        android:layout_height="@dimen/height_24"
        android:layout_marginEnd="@dimen/item_gap_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_drag_vertical"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center_vertical"
        android:id="@+id/cl_parent"
        android:background="@drawable/bg_arrange_watchlist"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_52">
        <TextView
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_watchlist_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/item_gap_8"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/item_gap_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_watchlist_favorite"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.BodyRegular"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_watchlist_favorite"
            android:layout_width="@dimen/width_20"
            android:layout_height="@dimen/height_20"
            android:contentDescription="@string/btn_following"
            android:layout_marginEnd="@dimen/item_gap_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_star_unfavorite"/>
        <View
            android:id="@+id/v_click_favorite"
            android:layout_width="@dimen/clickable_size_50"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
