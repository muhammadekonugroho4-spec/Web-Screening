<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:tag="layout/item_group_requirement_indicator_0"
    android:paddingBottom="@dimen/item_gap_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/item_gap_20">
    <View
        android:background="?attr/themeColorBorderGreen"
        android:layout_width="@dimen/item_gap_2"
        android:layout_height="19dp"
        android:layout_marginEnd="@dimen/item_gap_12"/>
    <TextView
        android:id="@+id/tv_requirement_indicator_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/TypeStyles.BodySmall"/>
    <TextView
        android:id="@+id/tv_requirement_indicator_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TypeStyles.BodySmall"/>
</LinearLayout>
