<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_list_file"
    android:tag="layout/layout_doc_list_0"
    android:background="@drawable/bg_theme_content_gray_border_4"
    android:paddingTop="@dimen/item_gap_16"
    android:paddingBottom="@dimen/item_gap_18"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/item_gap_18"
    android:paddingEnd="@dimen/item_gap_18">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/doc_tranfer_stock"
        style="@style/SbTextView.BodyDefault.Highempasis.Bold"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_doc"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_10"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_empty_doc"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_10">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_img_empty"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/n_dash"
            android:layout_marginStart="@dimen/item_gap_12"/>
    </LinearLayout>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:tag="binding_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_10"
        app:shimmer_auto_start="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="@drawable/bg_rounded_6_gray"
                    android:layout_width="@dimen/item_gap_40"
                    android:layout_height="@dimen/height_40"
                    android:backgroundTint="?attr/themeSeparatorGapColor"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:background="@drawable/bg_rounded_gray"
                    android:layout_width="@dimen/width_140"
                    android:layout_height="@dimen/clickable_size_16"
                    android:layout_marginStart="@dimen/clickable_size_16"
                    android:backgroundTint="?attr/themeSeparatorGapColor"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_8">
                <View
                    android:background="@drawable/bg_rounded_6_gray"
                    android:layout_width="@dimen/item_gap_40"
                    android:layout_height="@dimen/height_40"
                    android:backgroundTint="?attr/themeSeparatorGapColor"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:background="@drawable/bg_rounded_gray"
                    android:layout_width="@dimen/width_180"
                    android:layout_height="@dimen/clickable_size_16"
                    android:layout_marginStart="@dimen/item_gap_16"
                    android:backgroundTint="?attr/themeSeparatorGapColor"/>
            </LinearLayout>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</LinearLayout>
