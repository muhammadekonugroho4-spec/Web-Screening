<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/skeleton_company_header_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_20"
    android:paddingVertical="@dimen/spacing_12">
    <View
        android:id="@+id/v_skeleton_company_name"
        android:tag="binding_1"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/company_header_skeleton_company_name_width"
        android:layout_height="@dimen/company_header_skeleton_company_name_height"
        android:backgroundTint="?attr/themeShimmer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_skeleton_price"
        android:tag="binding_2"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/company_header_skeleton_price_width"
        android:layout_height="@dimen/company_header_skeleton_price_height"
        android:layout_marginTop="@dimen/item_gap_8"
        android:backgroundTint="?attr/themeShimmer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_skeleton_company_name"/>
    <View
        android:id="@+id/v_skeleton_company_icon"
        android:tag="binding_3"
        android:background="@drawable/ic_circle_grey"
        android:layout_width="@dimen/company_header_skeleton_company_icon_size"
        android:layout_height="@dimen/company_header_skeleton_company_icon_size"
        android:backgroundTint="?attr/themeShimmer"
        app:layout_constraintBottom_toBottomOf="@+id/v_skeleton_price"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_skeleton_price"/>
    <View
        android:background="@drawable/bg_rounded_6_gray"
        android:layout_width="@dimen/company_header_skeleton_company_description_width"
        android:layout_height="@dimen/company_header_skeleton_company_description_height"
        android:layout_marginTop="@dimen/spacing_8"
        android:backgroundTint="?attr/themeShimmer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_skeleton_company_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
