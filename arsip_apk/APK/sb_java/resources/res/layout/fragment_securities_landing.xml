<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_securities_landing_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/flTradngLandingPinHeader"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Sb.Widget.AppBar">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/landingTradingToolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"/>
            <View
                android:background="?attr/themeColorDividerThin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_xxxs"/>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:id="@+id/parentMainLoginTradingSelectedBroker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ivMainLoginTradingSelectedBrokerIcon"
                android:padding="@dimen/item_gap_xs"
                android:layout_width="@dimen/item_gap_80"
                android:layout_height="@dimen/item_gap_46"
                android:src="?attr/themeSplashScreenDrawable"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_incomplete"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/vp_intro"
            android:layout_width="match_parent"
            android:layout_height="@dimen/onboarding_securities_height"
            android:layout_marginHorizontal="@dimen/spacing_20"
            app:layout_constraintBottom_toTopOf="@+id/guideline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
            android:id="@+id/di_intro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_270"
            android:layout_marginBottom="@dimen/spacing_20"
            app:dotsColor="@color/highgray_light"
            app:dotsCornerRadius="@dimen/spacing_8"
            app:dotsSize="5dp"
            app:dotsSpacing="@dimen/spacing_4"
            app:dotsWidthFactor="2.5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/vp_intro"
            app:selectedDotColor="@color/green_text"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintGuide_percent="0.6"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_btn_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/guideline">
            <com.stockbit.common.uikit.StockbitLoadingButton
                android:id="@+id/btn_opening_account"
                android:tag="binding_1"
                android:background="@drawable/border_green_rounded"
                android:layout_width="@dimen/spacing_0"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_4"
                app:buttonText="@string/button_preoa_register"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/themeColorTextSecondary"
            android:id="@+id/actv_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_preoa_switch_platform"
            android:layout_marginVertical="@dimen/height_32"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_btn_action"
            style="@style/TypeStyles.BodyRegular"/>
        <View
            android:background="?attr/separatorColor"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_marginStart="@dimen/spacing_24"
            android:layout_marginEnd="@dimen/spacing_12"
            app:layout_constraintBottom_toBottomOf="@+id/actv_switch"
            app:layout_constraintEnd_toStartOf="@+id/actv_switch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/actv_switch"/>
        <View
            android:id="@+id/gap"
            android:background="?attr/separatorColor"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_marginStart="@dimen/spacing_24"
            android:layout_marginEnd="@dimen/spacing_12"
            app:layout_constraintBottom_toBottomOf="@+id/actv_switch"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/actv_switch"
            app:layout_constraintTop_toTopOf="@+id/actv_switch"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_virtual_trading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/actv_switch">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/aciv_virtual"
                android:tag="binding_2"
                android:layout_width="@dimen/width_54"
                android:layout_height="@dimen/height_54"
                android:src="@drawable/ic_virtual"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/themeColorTextSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="@string/button_preoa_virtual_trading"
                app:layout_constraintEnd_toEndOf="@+id/aciv_virtual"
                app:layout_constraintStart_toStartOf="@+id/aciv_virtual"
                app:layout_constraintTop_toBottomOf="@+id/aciv_virtual"
                style="@style/TypeStyles.BodyRegular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
