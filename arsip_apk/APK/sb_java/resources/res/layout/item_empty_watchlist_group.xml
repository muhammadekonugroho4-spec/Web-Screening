<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rlEmptyAlert"
    android:tag="layout/item_empty_watchlist_group_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivEmptyDataWatchlistGroup"
        android:layout_width="@dimen/avatar_size_xxl"
        android:layout_height="@dimen/avatar_size_xxl"
        android:layout_marginTop="@dimen/item_gap_40"
        android:layout_centerHorizontal="true"
        app:srcCompat="?attr/themeIconEmptyWatchlistGroup"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvtitleEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_l"
        android:layout_marginBottom="@dimen/item_gap_l"
        android:text="@string/title_create_watchlist"
        android:layout_below="@+id/ivEmptyDataWatchlistGroup"
        android:textAlignment="gravity"
        style="@style/SbTextView.PageTitle"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvSubtitleEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/text_create_watchlist"
        android:layout_below="@+id/tvtitleEmpty"
        android:textAlignment="gravity"
        style="@style/SbTextView.ListSubtitle.Secondary"/>
    <Button
        android:textSize="@dimen/default_toolbar_text_size"
        android:textColor="@color/white"
        android:id="@+id/btnAddGroup"
        android:background="@drawable/btn_empty_green_bg_rounded"
        android:layout_width="match_parent"
        android:layout_height="@dimen/default_button_height"
        android:layout_marginLeft="@dimen/item_gap_50"
        android:layout_marginTop="@dimen/item_gap_50"
        android:layout_marginRight="@dimen/item_gap_50"
        android:layout_marginBottom="@dimen/item_gap_50"
        android:text="@string/button_create_watchlist"
        android:layout_below="@+id/tvSubtitleEmpty"
        android:textAllCaps="false"/>
</RelativeLayout>
