<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_subscription_history_0"
    android:paddingTop="@dimen/item_gap_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/item_gap_20">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_status_item_subscription_history"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="?attr/themeIconStatusSubscriptionHistory"
        app:layout_constraintBottom_toBottomOf="@+id/tv_date_item_subscription_history"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_type_item_subscription_history"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/item_gap_16"
        app:layout_constraintStart_toEndOf="@+id/iv_status_item_subscription_history"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingRegular"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_date_item_subscription_history"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_2"
        android:layout_marginStart="@dimen/item_gap_16"
        app:layout_constraintStart_toEndOf="@+id/iv_status_item_subscription_history"
        app:layout_constraintTop_toBottomOf="@+id/tv_type_item_subscription_history"
        style="@style/TypeStyles.BodyRegular"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="end"
        android:id="@+id/tv_amount_item_subscription_history"
        android:tag="binding_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/item_gap_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_type_item_subscription_history"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingRegular"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="end"
        android:id="@+id/tv_payment_type_item_subscription_history"
        android:tag="binding_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_2"
        android:layout_marginStart="@dimen/item_gap_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_date_item_subscription_history"
        app:layout_constraintTop_toBottomOf="@+id/tv_amount_item_subscription_history"
        style="@style/TypeStyles.BodyRegular"/>
    <View
        android:id="@+id/view_item_subscription_history"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_20"
        app:layout_constraintTop_toBottomOf="@+id/tv_date_item_subscription_history"/>
</androidx.constraintlayout.widget.ConstraintLayout>
