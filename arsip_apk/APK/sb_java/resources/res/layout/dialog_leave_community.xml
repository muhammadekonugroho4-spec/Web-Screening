<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_leave_community_0"
    android:background="@color/transparent"
    android:paddingBottom="@dimen/spacing_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_20">
    <ImageView
        android:id="@+id/iv_leave_trading_community"
        android:layout_width="@dimen/error_illustration_image_width"
        android:layout_height="@dimen/error_illustration_image_height"
        android:src="?attr/themeIconTradingCommunityLeaveCommunity"
        android:layout_marginVertical="@dimen/spacing_20"
        app:layout_constraintBottom_toTopOf="@+id/tv_leave_trading_community_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_leave_trading_community_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_leave_trading_community"
        app:layout_constraintBottom_toTopOf="@+id/tv_leave_trading_community_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_leave_trading_community"
        style="@style/TypeStyles.HeadlineRegular"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="center"
        android:id="@+id/tv_leave_trading_community_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/spacing_12"
        app:layout_constraintBottom_toTopOf="@+id/btn_leave_trading_community_exit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_leave_trading_community_title"
        style="@style/TypeStyles.BodyRegular"/>
    <com.stockbit.uikit.button.SecondaryNeutralButton
        android:id="@+id/btn_leave_trading_community_cancel"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:text="@string/btn_cancel"
        android:layout_marginEnd="@dimen/spacing_16"
        app:layout_constraintEnd_toStartOf="@+id/btn_leave_trading_community_exit"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_leave_trading_community_exit"
        app:secondaryNeutralButtonColor="neutral"/>
    <com.stockbit.uikit.button.SecondaryButton
        android:id="@+id/btn_leave_trading_community_exit"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:text="@string/btn_exit"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btn_leave_trading_community_cancel"
        app:layout_constraintTop_toBottomOf="@+id/tv_leave_trading_community_desc"
        app:secondaryButtonColor="red"/>
</androidx.constraintlayout.widget.ConstraintLayout>
