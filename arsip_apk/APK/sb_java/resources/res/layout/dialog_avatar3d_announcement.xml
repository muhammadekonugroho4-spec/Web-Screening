<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_avatar3d_announcement_0"
    android:background="@drawable/bg_top_rounded"
    android:paddingBottom="@dimen/item_gap_l"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/item_gap_l">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/vHandle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_14"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/rectangle_dialog"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivHeader"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/item_gap_40"
        android:scaleType="fitCenter"
        app:layout_constraintDimensionRatio="w,202:380"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vHandle"
        app:layout_constraintWidth_percent="0.7"
        app:srcCompat="0x7f08012a"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_40"
        android:text="@string/title_profile_avatar"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@+id/ivHeader"
        style="@style/SbTextView.PageTitle"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_l"
        android:text="@string/text_profile_avatar"
        android:textAlignment="center"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        style="@style/SbTextView.BodyDefault.MediumEmphasis"/>
    <Button
        android:id="@+id/btnChooseAvatar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_40"
        android:text="@string/button_choose_avatar"
        android:contentDescription="@string/SHARED_4"
        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"
        style="@style/SbBtn.PrimaryFullWidthFloating"/>
    <Button
        android:id="@+id/btn_skip_choose_avatar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_l"
        android:text="@string/button_skip"
        android:contentDescription="@string/SHARED_5"
        app:layout_constraintTop_toBottomOf="@+id/btnChooseAvatar"
        style="@style/SbBtnBorderless.Small"/>
</androidx.constraintlayout.widget.ConstraintLayout>
