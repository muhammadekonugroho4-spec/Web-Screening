<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_dialog_history_periode_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_white_rounded"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="center"
            android:id="@+id/drag_indicator"
            android:background="@drawable/bg_gray_collapse"
            android:layout_width="@dimen/clickable_size_38"
            android:layout_height="@dimen/item_gap_5"
            android:layout_marginTop="@dimen/item_gap_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:id="@+id/tv_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_24"
            android:text="@string/lbl_title_history_type"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/drag_indicator"
            style="@style/SbTextView.ListTitle"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:id="@+id/tv_all_time"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_44"
            android:text="@string/all_time_history_trading"
            android:layout_marginStart="@dimen/item_gap_20"
            app:layout_constraintEnd_toStartOf="@+id/iv_check_all_time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_header"
            style="@style/SbTextView.ListTitle"/>
        <ImageView
            android:id="@+id/iv_check_all_time"
            android:layout_width="@dimen/item_gap_18"
            android:layout_height="@dimen/item_gap_18"
            android:layout_marginEnd="@dimen/item_gap_22"
            app:layout_constraintBottom_toBottomOf="@+id/tv_all_time"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_all_time"
            app:srcCompat="@drawable/ic_check_circle_green_24dp"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/btn_all_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tv_all_time, iv_check_all_time"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/separator"
            android:background="?attr/themeBgDialogConfirm"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_marginTop="@dimen/item_gap_20"
            app:layout_constraintEnd_toEndOf="@+id/iv_check_all_time"
            app:layout_constraintStart_toStartOf="@+id/tv_all_time"
            app:layout_constraintTop_toBottomOf="@+id/tv_all_time"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:id="@+id/tv_one_month"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:text="@string/one_month_history_trading"
            app:layout_constraintEnd_toStartOf="@+id/iv_check_one_month"
            app:layout_constraintStart_toStartOf="@+id/separator"
            app:layout_constraintTop_toBottomOf="@+id/separator"
            style="@style/SbTextView.ListTitle"/>
        <ImageView
            android:id="@+id/iv_check_one_month"
            android:layout_width="@dimen/item_gap_18"
            android:layout_height="@dimen/item_gap_18"
            app:layout_constraintBottom_toBottomOf="@+id/tv_one_month"
            app:layout_constraintEnd_toEndOf="@+id/separator"
            app:layout_constraintTop_toTopOf="@+id/tv_one_month"
            app:srcCompat="@drawable/ic_check_circle_empty_24dp"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/btn_one_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tv_one_month,iv_check_one_month"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/separator_second"
            android:background="?attr/themeBgDialogConfirm"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_marginTop="@dimen/item_gap_20"
            app:layout_constraintEnd_toEndOf="@+id/iv_check_all_time"
            app:layout_constraintStart_toStartOf="@+id/tv_all_time"
            app:layout_constraintTop_toBottomOf="@+id/tv_one_month"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:id="@+id/tv_three_month"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:text="@string/three_month_history_trading"
            app:layout_constraintEnd_toStartOf="@+id/iv_check_three_month"
            app:layout_constraintStart_toStartOf="@+id/separator_second"
            app:layout_constraintTop_toBottomOf="@+id/separator_second"
            style="@style/SbTextView.ListTitle"/>
        <ImageView
            android:id="@+id/iv_check_three_month"
            android:layout_width="@dimen/item_gap_18"
            android:layout_height="@dimen/item_gap_18"
            app:layout_constraintBottom_toBottomOf="@+id/tv_three_month"
            app:layout_constraintEnd_toEndOf="@+id/separator_second"
            app:layout_constraintTop_toTopOf="@+id/tv_three_month"
            app:srcCompat="@drawable/ic_check_circle_empty_24dp"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/btn_three_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tv_three_month,iv_check_three_month"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/separator_ytd"
            android:background="?attr/themeBgDialogConfirm"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_marginTop="@dimen/item_gap_20"
            app:layout_constraintEnd_toEndOf="@+id/iv_check_all_time"
            app:layout_constraintStart_toStartOf="@+id/tv_all_time"
            app:layout_constraintTop_toBottomOf="@+id/tv_three_month"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:id="@+id/tv_ytd"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:text="@string/ytd_history_trading"
            app:layout_constraintEnd_toStartOf="@+id/iv_check_three_month"
            app:layout_constraintStart_toStartOf="@+id/separator_ytd"
            app:layout_constraintTop_toBottomOf="@+id/separator_ytd"
            style="@style/SbTextView.ListTitle"/>
        <ImageView
            android:id="@+id/iv_check_ytd"
            android:layout_width="@dimen/item_gap_18"
            android:layout_height="@dimen/item_gap_18"
            app:layout_constraintBottom_toBottomOf="@+id/tv_ytd"
            app:layout_constraintEnd_toEndOf="@+id/separator_ytd"
            app:layout_constraintTop_toTopOf="@+id/tv_ytd"
            app:srcCompat="@drawable/ic_check_circle_empty_24dp"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/btn_ytd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tv_ytd,iv_check_ytd"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/separator_third"
            android:background="?attr/themeBgDialogConfirm"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_marginTop="@dimen/item_gap_20"
            app:layout_constraintEnd_toEndOf="@+id/iv_check_all_time"
            app:layout_constraintStart_toStartOf="@+id/tv_all_time"
            app:layout_constraintTop_toBottomOf="@+id/tv_ytd"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:id="@+id/tv_one_year"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:text="@string/one_year_history_trading"
            app:layout_constraintEnd_toStartOf="@+id/iv_check_one_year"
            app:layout_constraintStart_toStartOf="@+id/separator_third"
            app:layout_constraintTop_toBottomOf="@+id/separator_third"
            style="@style/SbTextView.ListTitle"/>
        <ImageView
            android:id="@+id/iv_check_one_year"
            android:layout_width="@dimen/item_gap_18"
            android:layout_height="@dimen/item_gap_18"
            app:layout_constraintBottom_toBottomOf="@+id/tv_one_year"
            app:layout_constraintEnd_toEndOf="@+id/separator_third"
            app:layout_constraintTop_toTopOf="@+id/tv_one_year"
            app:srcCompat="@drawable/ic_check_circle_empty_24dp"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/btn_one_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tv_one_year,iv_check_one_year"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/separator_three_year"
            android:background="?attr/themeBgDialogConfirm"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_marginTop="@dimen/item_gap_20"
            app:layout_constraintEnd_toEndOf="@+id/iv_check_all_time"
            app:layout_constraintStart_toStartOf="@+id/tv_all_time"
            app:layout_constraintTop_toBottomOf="@+id/tv_one_year"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:id="@+id/tv_three_year"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:text="@string/three_year_history_trading"
            app:layout_constraintEnd_toStartOf="@+id/iv_check_three_year"
            app:layout_constraintStart_toStartOf="@+id/separator_three_year"
            app:layout_constraintTop_toBottomOf="@+id/separator_three_year"
            style="@style/SbTextView.ListTitle"/>
        <ImageView
            android:id="@+id/iv_check_three_year"
            android:layout_width="@dimen/item_gap_18"
            android:layout_height="@dimen/item_gap_18"
            app:layout_constraintBottom_toBottomOf="@+id/tv_three_year"
            app:layout_constraintEnd_toEndOf="@+id/separator_three_year"
            app:layout_constraintTop_toTopOf="@+id/tv_three_year"
            app:srcCompat="@drawable/ic_check_circle_empty_24dp"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/btn_three_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tv_three_year,iv_check_three_year"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/separator_fourth"
            android:background="?attr/themeBgDialogConfirm"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_marginTop="@dimen/item_gap_20"
            app:layout_constraintEnd_toEndOf="@+id/iv_check_all_time"
            app:layout_constraintStart_toStartOf="@+id/tv_all_time"
            app:layout_constraintTop_toBottomOf="@+id/tv_three_year"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:id="@+id/tv_custom"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:text="@string/custom_history_trading"
            app:layout_constraintEnd_toStartOf="@+id/iv_check_custom"
            app:layout_constraintStart_toStartOf="@+id/separator_fourth"
            app:layout_constraintTop_toBottomOf="@+id/separator_fourth"
            style="@style/SbTextView.ListTitle"/>
        <ImageView
            android:id="@+id/iv_check_custom"
            android:layout_width="@dimen/item_gap_18"
            android:layout_height="@dimen/item_gap_18"
            app:layout_constraintBottom_toBottomOf="@+id/tv_custom"
            app:layout_constraintEnd_toEndOf="@+id/separator_fourth"
            app:layout_constraintTop_toTopOf="@+id/tv_custom"
            app:srcCompat="@drawable/ic_check_circle_empty_24dp"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/btn_custom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tv_custom,iv_check_custom"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/separator_fifth"
            android:background="?attr/themeBgDialogConfirm"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_marginTop="@dimen/item_gap_20"
            app:layout_constraintEnd_toEndOf="@+id/iv_check_all_time"
            app:layout_constraintStart_toStartOf="@+id/tv_all_time"
            app:layout_constraintTop_toBottomOf="@+id/tv_custom"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/custom_date_picker"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="4.1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/separator_fifth">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llStartDateLayout"
                android:padding="@dimen/item_gap_20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                app:layout_constraintEnd_toStartOf="@+id/dash"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/separator_fifth">
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history_trading_start"
                    style="@style/SbTextView.ListTitle"/>
                <RelativeLayout
                    android:id="@+id/start_date_layout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/lbl_text_date_height"
                    android:layout_marginTop="@dimen/item_gap_s">
                    <TextView
                        android:gravity="center"
                        android:id="@+id/tv_start_date"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toLeftOf="@+id/ivSelectStartDate"
                        android:layout_centerInParent="true"
                        android:layout_toStartOf="@+id/ivSelectStartDate"
                        style="@style/SbTextView.BodyDefault"/>
                    <ImageView
                        android:id="@+id/ivSelectStartDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerInParent="true"
                        android:layout_alignParentEnd="true"
                        android:paddingVertical="@dimen/item_gap_12"
                        app:srcCompat="@drawable/ic_calendar"
                        app:tint="@color/gray_text"/>
                    <View
                        android:background="?attr/themeBgDialogConfirm"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/item_gap_xxxs"
                        android:layout_marginBottom="@dimen/item_gap_null"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
            </LinearLayout>
            <TextView
                android:gravity="center"
                android:id="@+id/dash"
                android:padding="@dimen/item_gap_m"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="-"
                android:layout_weight="0.1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/separator_fifth"
                style="@style/SbTextView.BodyDefault"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llend_date_layout"
                android:padding="@dimen/item_gap_20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                app:layout_constraintEnd_toStartOf="@+id/dash"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/separator_fifth">
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history_trading_end"
                    style="@style/SbTextView.ListTitle"/>
                <RelativeLayout
                    android:id="@+id/end_date_layout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/lbl_text_date_height"
                    android:layout_marginTop="@dimen/item_gap_s">
                    <TextView
                        android:gravity="center"
                        android:id="@+id/tv_end_date"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toLeftOf="@+id/iv_select_end_date"
                        android:layout_centerInParent="true"
                        android:layout_toStartOf="@+id/iv_select_end_date"
                        style="@style/SbTextView.BodyDefault"/>
                    <ImageView
                        android:id="@+id/iv_select_end_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentRight="true"
                        android:layout_centerInParent="true"
                        android:layout_alignParentEnd="true"
                        android:paddingVertical="@dimen/item_gap_12"
                        app:srcCompat="@drawable/ic_calendar"
                        app:tint="@color/gray_text"/>
                    <View
                        android:background="?attr/themeBgDialogConfirm"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/item_gap_xxxs"
                        android:layout_marginBottom="0dp"
                        android:layout_alignParentBottom="true"/>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
        <com.stockbit.uikit.buttons.PrimaryButton
            android:id="@+id/button_continue"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_48"
            android:layout_margin="@dimen/item_gap_20"
            android:text="@string/apply_realized_filter_period"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:textAllCaps="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/custom_date_picker"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
