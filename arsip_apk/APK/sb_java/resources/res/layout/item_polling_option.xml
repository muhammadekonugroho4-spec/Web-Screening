<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_polling_parent"
    android:tag="layout/item_polling_option_0"
    android:layout_width="match_parent"
    android:layout_height="@dimen/clickable_size_40"
    android:layout_marginTop="@dimen/spacing_6"
    android:layout_marginHorizontal="@dimen/spacing_16"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/rl_polling_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_parent_polling"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginVertical="@dimen/item_gap_xxxs">
        <ImageView
            android:id="@+id/iv_polling_percentage"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="match_parent"
            android:layout_weight="0"
            app:srcCompat="@drawable/bg_rounded_gray"
            app:tint="?attr/themeSeparatorGapColor"/>
        <View
            android:id="@+id/v_polling_percentage"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_polling_question"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:maxLength="@integer/polling_choice_length"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/item_gap_10"
        style="@style/TypeStyles.BodyRegular"/>
    <ImageView
        android:id="@+id/iv_polling_indicator"
        android:visibility="gone"
        android:layout_width="@dimen/spacing_16"
        android:layout_height="@dimen/spacing_16"
        android:layout_toRightOf="@+id/tv_polling_question"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/item_gap_10"
        app:srcCompat="@drawable/ic_check_circle_green_24dp"
        app:tint="@color/highgray_light"/>
    <TextView
        android:id="@+id/tv_percentage"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginHorizontal="@dimen/item_gap_10"
        style="@style/TypeStyles.BodyRegular"/>
    <View
        android:id="@+id/v_clickable_area"
        android:background="@drawable/btn_polling_option"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>
