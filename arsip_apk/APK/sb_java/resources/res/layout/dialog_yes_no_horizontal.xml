<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme"
    android:tag="layout/dialog_yes_no_horizontal_0"
    android:background="@drawable/bg_top_rounded_16"
    android:paddingBottom="@dimen/dialog_yes_no_horizontal_padding_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dialog_yes_no_horizontal_padding_horizontal"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <FrameLayout
        android:id="@+id/fl_vtop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/v_top"
            android:background="@drawable/bg_rounded_gray_gray_bg"
            android:layout_width="@dimen/v_top_width"
            android:layout_height="@dimen/v_top_height"
            android:layout_marginTop="@dimen/v_dialog_yes_no_horizontal_top_margin_top"
            android:layout_marginBottom="@dimen/v_dialog_yes_no_horizontal_top_margin_bottom"/>
    </FrameLayout>
    <ImageView
        android:id="@+id/iv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fl_vtop"/>
    <TextView
        android:textSize="@dimen/tv_title_dialog_horizontal_text_size"
        android:gravity="center_horizontal"
        android:id="@+id/tv_title"
        android:tag="binding_1"
        android:paddingTop="@dimen/tv_title_dialog_yes_no_horizontal_margin_top"
        android:paddingBottom="@dimen/item_gap_10"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv"
        style="@style/SbTextView.BodyDefault.Highempasis.Bold"/>
    <TextView
        android:textColor="@color/highgray_light"
        android:gravity="center_horizontal"
        android:id="@+id/tv_description"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/SbTextView.BodyDefault"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/text_button_dialog"
        android:id="@+id/btn_negative"
        android:tag="binding_3"
        android:background="@drawable/bg_rounded_4_transparent_downgray"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAllCaps="false"
        android:layout_marginEnd="@dimen/btn_negative_dialog_yes_no_horizontal_margin_end"
        app:layout_constraintEnd_toStartOf="@+id/btn_positive"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_positive"
        style="@style/SbTextView.Button.HighEmphasys"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/text_button_dialog"
        android:textColor="@color/white"
        android:id="@+id/btn_positive"
        android:tag="binding_4"
        android:background="@drawable/border_green_rounded"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/btn_positive_dialog_yes_no_horizontal_margin_top"
        android:textAllCaps="false"
        android:paddingVertical="@dimen/btn_positive_dialog_yes_no_horizontal_padding_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_negative"
        app:layout_constraintTop_toBottomOf="@+id/tv_description"
        style="@style/SbTextView.Button.Regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
