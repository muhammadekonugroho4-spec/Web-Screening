<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_trading_smart_order_classic_0"
    android:paddingTop="@dimen/spacing_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/ORDER_18">
    <com.stockbit.uikit.control.ControlCheckbox
        android:layout_gravity="center"
        android:id="@+id/ccb_select_parent"
        android:visibility="gone"
        android:layout_width="@dimen/width_24"
        android:layout_height="@dimen/height_24"
        android:contentDescription="@string/ORDER_20"
        android:layout_marginStart="@dimen/spacing_20"
        app:checkBoxType="box"
        app:layout_constraintBottom_toBottomOf="@+id/ll_parent_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ll_parent_row"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_expand_collapse"
        android:visibility="visible"
        android:layout_width="@dimen/width_12"
        android:layout_height="@dimen/height_12"
        android:src="@drawable/uikit_ic_stockbit_text_field_chevron_down"
        android:layout_marginStart="@dimen/item_gap_7"
        android:layout_marginEnd="@dimen/item_gap_2"
        app:layout_constraintBottom_toBottomOf="@+id/ll_parent_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ll_parent_row"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_symbol_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="ccb_select_parent, ccb_select_child, iv_expand_collapse"/>
    <ImageView
        android:id="@+id/iv_child_line"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="0dp"
        android:layout_marginTop="-2dp"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/ll_child_row"
        app:layout_constraintEnd_toEndOf="@+id/iv_expand_collapse"
        app:layout_constraintTop_toBottomOf="@+id/iv_expand_collapse"/>
    <View
        android:id="@+id/view_click_parent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ll_parent_row"
        app:layout_constraintEnd_toEndOf="@+id/ll_parent_row"
        app:layout_constraintStart_toEndOf="@+id/view_click_smart_order"
        app:layout_constraintTop_toTopOf="@+id/ll_parent_row"/>
    <View
        android:id="@+id/view_click_smart_order"
        android:layout_width="@dimen/item_gap_45"
        android:layout_height="0dp"
        android:maxHeight="@dimen/item_gap_24"
        app:layout_constraintBottom_toBottomOf="@+id/ll_parent_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <View
        android:id="@+id/view_click_child"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/ll_child_row"
        app:layout_constraintEnd_toEndOf="@+id/ll_child_row"
        app:layout_constraintStart_toStartOf="@+id/ll_child_row"
        app:layout_constraintTop_toTopOf="@+id/ll_child_row"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_parent_row"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:weightSum="100"
        android:paddingEnd="@dimen/spacing_20"
        android:layout_marginStart="@dimen/item_gap_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/barrier_symbol_start"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_symbol"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_weight="26"
            android:foregroundGravity="center"
            android:layout_marginEnd="@dimen/spacing_8"
            style="@style/TypeStyles.BodyXXSmall"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="left"
            android:id="@+id/tv_amount"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_weight="24"
            android:textAlignment="gravity"
            android:layout_marginEnd="@dimen/spacing_8"
            style="@style/TypeStyles.BodyXXSmall"/>
        <TextView
            android:gravity="left"
            android:id="@+id/tv_price"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="13.2"
            android:textAlignment="gravity"
            android:layout_marginEnd="@dimen/spacing_8"
            style="@style/TypeStyles.BodyXXSmall"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="left"
            android:id="@+id/tv_expiry"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="13"
            android:textAlignment="gravity"
            android:layout_marginEnd="@dimen/spacing_8"
            style="@style/TypeStyles.BodyXXSmall"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="left"
            android:id="@+id/tv_order_status"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_weight="23.78"
            android:textAlignment="gravity"
            style="@style/TypeStyles.BodyXXSmall"/>
    </LinearLayout>
    <com.stockbit.uikit.control.ControlCheckbox
        android:layout_gravity="center"
        android:id="@+id/ccb_select_child"
        android:visibility="gone"
        android:layout_width="@dimen/width_24"
        android:layout_height="@dimen/height_24"
        android:contentDescription="@string/ORDER_20"
        android:layout_marginStart="@dimen/spacing_20"
        app:checkBoxType="box"
        app:layout_constraintBottom_toBottomOf="@+id/ll_child_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ll_child_row"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_child_row"
        android:layout_width="0dp"
        android:layout_height="24dp"
        android:layout_marginTop="6dp"
        android:weightSum="100"
        android:paddingEnd="@dimen/spacing_20"
        android:layout_marginStart="@dimen/item_gap_7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/barrier_symbol_start"
        app:layout_constraintTop_toBottomOf="@+id/ll_parent_row">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="start"
            android:id="@+id/tv_symbol_child"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_weight="26"
            android:foregroundGravity="center"
            android:layout_marginEnd="@dimen/spacing_8"
            style="@style/TypeStyles.BodyXXSmall"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="left"
            android:id="@+id/tv_amount_child"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_weight="24"
            android:textAlignment="gravity"
            android:layout_marginEnd="@dimen/spacing_8"
            style="@style/TypeStyles.BodyXXSmall"/>
        <TextView
            android:gravity="left"
            android:id="@+id/tv_price_child"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="13.2"
            android:textAlignment="gravity"
            android:layout_marginEnd="@dimen/spacing_8"
            style="@style/TypeStyles.BodyXXSmall"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="left"
            android:id="@+id/tv_expiry_child"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="13"
            android:textAlignment="gravity"
            android:layout_marginEnd="@dimen/spacing_8"
            style="@style/TypeStyles.BodyXXSmall"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="left"
            android:id="@+id/tv_order_status_child"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_weight="23.78"
            android:textAlignment="gravity"
            style="@style/TypeStyles.BodyXXSmall"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_of_child"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="ll_child_row, view_click_child"/>
    <View
        android:id="@+id/spacer_content"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/spacing_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_child_row"/>
</androidx.constraintlayout.widget.ConstraintLayout>
