<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:tag="layout/comp_field_toggle_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_label_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/item_gap_4"
        android:layout_toStartOf="@+id/cts_form"
        android:layout_alignParentStart="true"
        style="@style/TypeStyles.BodyRegular"/>
    <com.stockbit.uikit.control.ControlToggleSwitch
        android:id="@+id/cts_form"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        app:switchType="Small"/>
</RelativeLayout>
