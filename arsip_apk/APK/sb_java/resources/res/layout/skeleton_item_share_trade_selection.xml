<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_avatar"
        android:background="@drawable/bg_circle_gray"
        android:layout_width="@dimen/spacing_48"
        android:layout_height="@dimen/spacing_48"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_marginStart="@dimen/item_gap_32"
        android:backgroundTint="?attr/themeShimmer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_decs_avatar"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_62"
        android:layout_marginStart="@dimen/item_gap_12"
        android:layout_marginEnd="@dimen/item_gap_32"
        android:backgroundTint="?attr/themeShimmer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/v_avatar"
        app:layout_constraintTop_toTopOf="@+id/v_avatar"/>
    <View
        android:id="@+id/v_divider_top"
        android:background="?attr/themeShimmer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_8"
        android:layout_marginTop="@dimen/spacing_20"
        app:layout_constraintTop_toBottomOf="@+id/v_decs_avatar"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_divider_top">
        <include layout="@layout/skeleton_people_list_2"/>
        <include layout="@layout/skeleton_people_list_2"/>
        <include layout="@layout/skeleton_people_list_2"/>
        <include layout="@layout/skeleton_people_list_2"/>
        <include layout="@layout/skeleton_people_list_2"/>
        <include layout="@layout/skeleton_people_list_2"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
