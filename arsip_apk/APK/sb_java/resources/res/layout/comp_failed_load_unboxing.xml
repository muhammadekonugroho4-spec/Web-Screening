<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_failed_load_unboxing_0"
    android:layout_width="match_parent"
    android:layout_height="@dimen/height_unboxing_error_card"
    app:cardBackgroundColor="@color/transparent"
    app:cardCornerRadius="@dimen/spacing_4"
    app:cardElevation="0dp"
    app:strokeColor="?attr/themeColorBorder"
    app:strokeWidth="@dimen/item_gap_1">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_comp_failed_load"
            android:layout_width="@dimen/width_120"
            android:layout_height="@dimen/height_80"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_comp_failed_load_title"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/themeIconFailedLoadBox"/>
        <TextView
            android:id="@+id/tv_comp_failed_load_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/item_gap_8"
            android:text="@string/title_error_unable_load_unboxing"
            android:layout_marginStart="@dimen/spacing_4"
            app:layout_constraintBottom_toTopOf="@+id/tv_comp_failed_load_sub_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_comp_failed_load"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/TypeStyles.HeadingLarge"/>
        <TextView
            android:textColor="@color/green_text"
            android:gravity="center"
            android:id="@+id/tv_comp_failed_load_sub_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/button_try_again"
            android:drawablePadding="@dimen/item_gap_xxs"
            app:drawableStartCompat="@drawable/ic_refresh"
            app:drawableTint="@color/green_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_comp_failed_load_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_comp_failed_load_title"
            style="@style/TypeStyles.HeadingRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
