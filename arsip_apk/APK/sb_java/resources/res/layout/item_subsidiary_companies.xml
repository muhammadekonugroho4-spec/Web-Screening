<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:tag="layout/item_subsidiary_companies_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_13"
        android:id="@+id/tv_company_name"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/height_margin_list_item"
        android:layout_marginEnd="@dimen/spacing_8"
        app:layout_constraintEnd_toStartOf="@+id/tv_percentage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodySmall"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:id="@+id/tv_company_type"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_0"
        android:layout_marginTop="@dimen/spacing_2"
        app:layout_constraintTop_toBottomOf="@+id/tv_company_name"
        style="@style/TypeStyles.BodySmall"/>
    <TextView
        android:textSize="@dimen/text_size_13"
        android:gravity="end"
        android:id="@+id/tv_percentage"
        android:layout_width="@dimen/spacing_50"
        android:layout_height="wrap_content"
        android:lines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_company_name"
        style="@style/TypeStyles.HeadingXSmall"/>
    <View
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/uikit_divider_thin"
        android:layout_marginTop="@dimen/height_margin_list_item"
        app:layout_constraintTop_toBottomOf="@+id/tv_company_type"/>
</androidx.constraintlayout.widget.ConstraintLayout>
