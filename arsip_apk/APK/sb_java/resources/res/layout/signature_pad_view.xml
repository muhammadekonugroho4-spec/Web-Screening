<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/signature_pad_view_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.github.gcacace.signaturepad.views.SignaturePad
            android:id="@+id/signature_pad"
            android:background="?attr/themeSignaturePadButtonEnable"
            android:saveEnabled="false"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            app:penColor="?attr/themeColorTextGreen"
            app:penMaxWidth="3dp"
            app:penMinWidth="1dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/signature_image"
            android:background="?attr/themeSignaturePadButtonEnable"
            android:padding="1dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="280dp"/>
    </RelativeLayout>
    <Button
        android:textSize="@dimen/text_size_14"
        android:id="@+id/btn_clear"
        android:background="?attr/themeSignaturePadButtonClearEnable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_14"
        android:layout_marginBottom="@dimen/spacing_24"
        android:minHeight="@dimen/height_40"
        android:text="@string/lbl_ulangi"
        android:drawablePadding="@dimen/item_gap_8"
        android:paddingStart="@dimen/item_gap_15"
        android:paddingEnd="@dimen/item_gap_15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/signature_pad"
        style="@style/SbBtnBorderless.Default"/>
</LinearLayout>
