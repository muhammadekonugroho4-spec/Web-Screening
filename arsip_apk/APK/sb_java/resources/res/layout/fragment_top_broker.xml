<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_parent"
    android:tag="layout/fragment_top_broker_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="?attr/themeColorSurfaceDefault"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.stockbit.brokeractivity.ui.topbroker.TopbarTopBroker
            android:id="@+id/top_bar_top_broker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:topBarTitleFirstIcon="@drawable/uikit_ic_stockbit_row_info_grey"
            app:topBarTitleSubtitle=""
            app:topBarTitleTitle="@string/title_top_broker"/>
        <com.stockbit.component.pulltorefresh.PullToRefreshLayout
            android:id="@+id/ptr_top_broker"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_bar_top_broker">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:tag="binding_1"
                android:background="?attr/themeColorSurfaceDefault"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_top_broker_filter"
                    android:background="@drawable/bg_transparent_with_artboard_border_and_radius_6"
                    android:layout_width="@dimen/spacing_0"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_8"
                    android:layout_marginHorizontal="@dimen/item_gap_16"
                    android:paddingHorizontal="@dimen/item_gap_14"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="@dimen/top_broker_content_max_width">
                    <ImageView
                        android:id="@+id/iv_prev_date"
                        android:tag="binding_2"
                        android:layout_width="@dimen/clickable_size_16"
                        android:layout_height="@dimen/clickable_size_16"
                        android:src="@drawable/ic_chevron_arrow_left"
                        android:contentDescription="@null"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="?attr/themeColorIconDefault"/>
                    <ImageView
                        android:tag="binding_3"
                        android:layout_width="@dimen/clickable_size_16"
                        android:layout_height="@dimen/clickable_size_16"
                        android:src="@drawable/uikit_ic_stockbit_text_field_chevron_down"
                        android:contentDescription="@null"
                        android:layout_marginEnd="@dimen/item_gap_14"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/v_divider_investor_and_market_type"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="?attr/themeColorIconDefault"/>
                    <TextView
                        android:textColor="?attr/themeColorTextPrimary"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_filter_period"
                        android:tag="binding_4"
                        android:layout_width="@dimen/spacing_0"
                        android:layout_height="@dimen/spacing_0"
                        android:maxLines="1"
                        android:lines="1"
                        android:layout_marginEnd="@dimen/item_gap_14"
                        android:paddingHorizontal="@dimen/spacing_8"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/iv_next_date"
                        app:layout_constraintStart_toEndOf="@+id/iv_prev_date"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TypeStyles.BodySmall"/>
                    <ImageView
                        android:id="@+id/iv_next_date"
                        android:tag="binding_5"
                        android:layout_width="@dimen/clickable_size_16"
                        android:layout_height="@dimen/clickable_size_16"
                        android:src="@drawable/ic_chevron_arrow_right"
                        android:contentDescription="@null"
                        android:layout_marginEnd="@dimen/item_gap_14"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/v_divider_investor_and_market_type"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <View
                        android:id="@+id/v_divider_investor_and_market_type"
                        android:background="?attr/themeColorBorder"
                        android:layout_width="@dimen/item_gap_1"
                        android:layout_height="@dimen/spacing_0"
                        android:layout_marginEnd="@dimen/item_gap_14"
                        android:layout_marginVertical="@dimen/item_gap_10"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tv_filter_market_type"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textColor="?attr/themeColorTextPrimary"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/tv_filter_market_type"
                        android:layout_width="@dimen/width_130"
                        android:layout_height="wrap_content"
                        android:lines="1"
                        android:textAlignment="textStart"
                        android:paddingVertical="@dimen/item_gap_12"
                        app:drawableEndCompat="@drawable/uikit_ic_stockbit_text_field_chevron_down"
                        app:drawableTint="?attr/themeColorIconDefault"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TypeStyles.BodySmall"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/cv_table_top_broker"
                    android:layout_width="@dimen/spacing_0"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/item_gap_18"
                    android:layout_marginHorizontal="@dimen/spacing_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cl_top_broker_filter"
                    app:layout_constraintWidth_max="@dimen/top_broker_content_max_width"/>
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/sfl_top_broker_filter"
                    android:tag="binding_6"
                    android:layout_width="@dimen/spacing_0"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_8"
                    android:layout_marginHorizontal="@dimen/item_gap_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="@dimen/top_broker_content_max_width"
                    style="@style/SBShimmerLayout">
                    <include layout="@layout/comp_item_top_broker_shimmer_filter"/>
                </com.facebook.shimmer.ShimmerFrameLayout>
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/sfl_top_broker"
                    android:tag="binding_7"
                    android:background="?attr/themeColorSurfaceDefault"
                    android:layout_width="@dimen/spacing_0"
                    android:layout_height="@dimen/spacing_0"
                    android:layout_marginTop="@dimen/item_gap_20"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/sfl_top_broker_filter"
                    app:layout_constraintWidth_max="@dimen/top_broker_content_max_width"
                    style="@style/SBShimmerLayout">
                    <include layout="@layout/comp_item_top_broker_shimmer"/>
                </com.facebook.shimmer.ShimmerFrameLayout>
                <include
                    android:id="@+id/layout_error_top_broker"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cl_top_broker_filter"
                    layout="@layout/comp_top_broker_error"/>
                <include
                    android:id="@+id/layout_empty_top_broker"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cl_top_broker_filter"
                    layout="@layout/comp_top_broker_empty"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.stockbit.component.pulltorefresh.PullToRefreshLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_blurry_top_broker"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/item_gap_10"
            android:src="?attr/themeBackgroundBlurryTopBroker"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_bar_top_broker"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/dialog_paywall"
        android:visibility="gone"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        layout="@layout/dialog_bottom_sheet_info"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
