<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_comment_limitation_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_top_rounded_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/item_gap_20">
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/v_handle"
            android:background="@drawable/bg_rounded_gray"
            android:layout_width="@dimen/clickable_size_38"
            android:layout_height="@dimen/item_gap_5"
            android:alpha="0.6"
            android:layout_marginVertical="@dimen/item_gap_16"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_comment_setting"
            android:layout_marginVertical="@dimen/item_gap_8"
            style="@style/TypeStyles.HeadingLarge"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/item_gap_8"
            android:text="@string/text_comment_setting"
            style="@style/TypeStyles.BodyRegular"/>
        <View
            android:background="?attr/titleTextColorDowngray"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_marginVertical="@dimen/item_gap_8"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/cl_everyone"
            android:tag="binding_1"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:paddingVertical="@dimen/item_gap_16">
            <TextView
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_comment_everyone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/text_comment_everyone"
                android:drawablePadding="@dimen/item_gap_14"
                app:drawableLeftCompat="@drawable/ic_comment_limit_globe"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/rb_check_global"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.BodyRegular"/>
            <RadioButton
                android:id="@+id/rb_check_global"
                android:background="@null"
                android:layout_width="@dimen/clickable_size_18"
                android:layout_height="@dimen/clickable_size_18"
                android:button="@drawable/bg_radio_circle_check_green"
                android:layout_centerVertical="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/cl_following"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:paddingVertical="@dimen/item_gap_16">
            <TextView
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_comment_people_following"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/text_comment_you_follow"
                android:drawablePadding="@dimen/item_gap_14"
                app:drawableLeftCompat="@drawable/ic_comment_limit_following"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/rb_check_people_following"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.BodyRegular"/>
            <RadioButton
                android:id="@+id/rb_check_people_following"
                android:background="@null"
                android:layout_width="@dimen/clickable_size_18"
                android:layout_height="@dimen/clickable_size_18"
                android:checked="false"
                android:button="@drawable/bg_radio_circle_check_green"
                android:layout_centerVertical="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:id="@+id/cl_mention"
            android:tag="binding_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:paddingVertical="@dimen/item_gap_16">
            <TextView
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_comment_people_mention"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/text_comment_you_mention"
                android:drawablePadding="@dimen/item_gap_14"
                app:drawableLeftCompat="@drawable/ic_comment_limit_mention"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/rb_check_people_mention"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.BodyRegular"/>
            <RadioButton
                android:id="@+id/rb_check_people_mention"
                android:background="@null"
                android:layout_width="@dimen/clickable_size_18"
                android:layout_height="@dimen/clickable_size_18"
                android:checked="false"
                android:button="@drawable/bg_radio_circle_check_green"
                android:layout_centerVertical="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="horizontal"
            android:tag="binding_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/item_gap_4"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:paddingVertical="@dimen/item_gap_16">
            <TextView
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_comment_only_me"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/text_comment_only_you"
                android:drawablePadding="@dimen/item_gap_14"
                app:drawableLeftCompat="@drawable/ic_comment_limit_none"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/rb_check_only_me"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.BodyRegular"/>
            <RadioButton
                android:id="@+id/rb_check_only_me"
                android:background="@null"
                android:layout_width="@dimen/clickable_size_18"
                android:layout_height="@dimen/clickable_size_18"
                android:checked="false"
                android:button="@drawable/bg_radio_circle_check_green"
                android:layout_centerVertical="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
