<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_parent_jump_page"
    android:tag="layout/item_unboxing_jump_to_page_0"
    android:layout_width="match_parent"
    android:layout_height="@dimen/width_180"
    android:layout_marginHorizontal="@dimen/item_gap_8"
    android:layout_marginVertical="@dimen/item_gap_10"
    app:cardCornerRadius="@dimen/shape_radius_4"
    app:cardElevation="0dp"
    app:strokeColor="?attr/themeColorModalsBorder"
    app:strokeWidth="@dimen/item_gap_1">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_content_jump_page"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/title_unboxing"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/pb_jump_to"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/green_text"
            app:indicatorSize="@dimen/clickable_size_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:trackColor="?attr/themeSeparatorGapColorSecondary"/>
        <TextView
            android:enabled="false"
            android:gravity="center"
            android:id="@+id/tv_jump_page_indicator"
            android:tag="binding_1"
            android:background="@drawable/bg_jump_page_indicator"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingXSmall"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
