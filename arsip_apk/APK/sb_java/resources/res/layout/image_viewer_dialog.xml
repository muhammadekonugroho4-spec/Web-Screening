<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/image_viewer_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.github.piasy.biv.view.BigImageView
        android:id="@+id/ivImageViewerBigImage"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:failureImage="?attr/themeIconError"
        app:failureImageInitScaleType="center"
        app:initScaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:optimizeDisplay="true"/>
    <FrameLayout
        android:id="@+id/parentMediaViewerCloseButtonContainer"
        android:tag="binding_2"
        android:layout_width="@dimen/clickable_size_32"
        android:layout_height="@dimen/clickable_size_32"
        android:layout_marginTop="@dimen/item_gap_l"
        android:alpha="0"
        android:translationY="-48dp"
        android:layout_marginEnd="@dimen/item_gap_l"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivMediaViewerCloseButtonBackground"
            android:background="@drawable/bg_circle"
            android:layout_width="@dimen/clickable_size_32"
            android:layout_height="@dimen/clickable_size_32"
            android:contentDescription="@string/hint_close"
            app:backgroundTint="@color/background_black_70_alpha"/>
        <ImageButton
            android:layout_gravity="center"
            android:id="@+id/ibMediaViewerCloseMediaViewer"
            android:tag="binding_3"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:contentDescription="@string/hint_close"
            app:srcCompat="0x7f08063f"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
