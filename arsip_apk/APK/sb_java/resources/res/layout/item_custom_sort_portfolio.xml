<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_custom_sort_portfolio_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_drag"
        android:layout_width="@dimen/width_24"
        android:layout_height="@dimen/height_24"
        android:src="@drawable/ic_drag_vertical"
        android:layout_marginStart="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_symbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_marginStart="@dimen/spacing_16"
        app:layout_constraintStart_toEndOf="@+id/iv_drag"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingSmall"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/ll_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_symbol"
        app:layout_constraintTop_toBottomOf="@+id/tv_symbol">
        <TextView
            android:id="@+id/tv_invested_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:layout_constraintStart_toStartOf="@+id/tv_symbol"
            app:layout_constraintTop_toBottomOf="@+id/tv_symbol"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:gravity="center_horizontal"
            android:id="@+id/tv_pl_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:layout_constraintStart_toStartOf="@+id/tv_symbol"
            app:layout_constraintTop_toBottomOf="@+id/tv_symbol"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_gain_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:layout_constraintStart_toStartOf="@+id/tv_symbol"
            app:layout_constraintTop_toBottomOf="@+id/tv_symbol"
            style="@style/TypeStyles.BodySmall"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_20"
        android:layout_marginEnd="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_symbol"
        app:layout_constraintTop_toBottomOf="@+id/ll_value">
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/lbl_portfolio_invested"
            android:layout_weight="1"
            app:layout_constraintStart_toStartOf="@+id/tv_symbol"
            app:layout_constraintTop_toBottomOf="@+id/tv_symbol"
            style="@style/TypeStyles.BodyXXSmall"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="center_horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/lbl_portfolio_loss_pl"
            android:layout_weight="1"
            app:layout_constraintStart_toStartOf="@+id/tv_symbol"
            app:layout_constraintTop_toBottomOf="@+id/tv_symbol"
            style="@style/TypeStyles.BodyXXSmall"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="end"
            android:id="@+id/tv_gain_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/lbl_portfolio_gain"
            android:layout_weight="1"
            app:layout_constraintStart_toStartOf="@+id/tv_symbol"
            app:layout_constraintTop_toBottomOf="@+id/tv_symbol"
            style="@style/TypeStyles.BodyXXSmall"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>
