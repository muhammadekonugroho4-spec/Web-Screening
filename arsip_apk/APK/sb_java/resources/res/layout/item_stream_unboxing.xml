<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/parent_stream_unboxing"
    android:tag="layout/item_stream_unboxing_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/sfl_stream_unboxing"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:shimmer_auto_start="true">
        <include layout="@layout/skeleton_unboxing_banner_section"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <TextView
        android:id="@+id/tv_title_unboxing_section"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:text="@string/title_unboxing"
        android:layout_marginStart="@dimen/item_gap_20"
        style="@style/TypeStyles.HeadingLarge"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/rv_stream_unboxing"
        android:paddingBottom="@dimen/spacing_20"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:paddingHorizontal="@dimen/spacing_20"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/layout_unboxing_stream_error"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_140"
        android:layout_margin="@dimen/item_gap_20"
        layout="@layout/comp_failed_load_unboxing"/>
    <View
        android:background="?attr/themeColorDividerThick"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_8"/>
</LinearLayout>
