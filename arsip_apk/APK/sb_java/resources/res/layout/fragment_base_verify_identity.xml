<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_base_verify_identity_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stockbit.uikit.topbar.TopbarStockbitTitle
        android:id="@+id/tb_verify_identity"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:topBarTitleTitle="@string/identity_validation_title_2_step_verification"
        app:topBarType="CenterTitle">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/aciv_support"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="?attr/themeIconStockbitSupportRound"
            android:layout_marginEnd="@dimen/item_gap_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.stockbit.uikit.topbar.TopbarStockbitTitle>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll_view"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        app:layout_constraintBottom_toTopOf="@+id/btn_continue"
        app:layout_constraintTop_toBottomOf="@+id/tb_verify_identity">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_20"
            android:paddingVertical="@dimen/spacing_36">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_icon"
                android:layout_width="@dimen/width_70"
                android:layout_height="@dimen/height_70"
                app:srcCompat="?attr/themeIconIdentityRound70"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/themeColorTextPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:text="@string/identity_validation_subtitle_verify_identity"
                style="@style/TypeStyles.HeadlineRegular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/themeColorTextSecondary"
                android:id="@+id/actv_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="@string/identity_validation_msg_verify_identity"
                style="@style/TypeStyles.BodyRegular"/>
            <com.stockbit.uikit.input.TextFieldBox
                android:id="@+id/tf_identity_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_32"
                android:inputType="text"
                android:imeOptions="actionNext"
                app:inputLabel="@string/identity_validation_label_identity_number"
                app:inputMaxLength="16"/>
            <com.stockbit.uikit.input.DropdownBox
                android:id="@+id/dd_birth_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                app:inputLabel="@string/identity_validation_label_birth_date"/>
            <com.stockbit.uikit.input.TextFieldBox
                android:id="@+id/tf_account_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:inputType="number"
                android:imeOptions="actionNext"
                app:inputLabel="@string/identity_validation_label_disbursement_account"/>
            <com.stockbit.uikit.input.TextFieldBox
                android:id="@+id/tf_mothers_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:inputType="textCapWords"
                android:imeOptions="actionDone"
                app:inputLabel="@string/identity_validation_label_mother_maiden_name"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
    <com.stockbit.uikit.button.PrimaryStickyButton
        android:enabled="false"
        android:id="@+id/btn_continue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/identity_validation_btn_continue"/>
</LinearLayout>
