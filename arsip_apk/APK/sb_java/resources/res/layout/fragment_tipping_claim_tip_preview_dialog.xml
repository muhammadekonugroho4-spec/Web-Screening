<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme"
    android:tag="layout/fragment_tipping_claim_tip_preview_dialog_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/vgTippingClaimDialogHeader"
        android:background="@drawable/bg_top_rounded"
        android:paddingTop="@dimen/item_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/viewFragmentTippingClaimDialogHandler"
            android:background="@drawable/bg_rounded_gray_gray_bg"
            android:layout_width="@dimen/clickable_size_64"
            android:layout_height="@dimen/item_gap_xs"
            android:layout_marginBottom="@dimen/item_gap_s"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvTippingClaimDialogLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/vgTippingClaimDialogHeader">
        <RelativeLayout
            android:id="@+id/rlTippingClaimPreviewDialogSuccessMainLayout"
            android:background="?attr/themeDialogBackgroundColor"
            android:paddingBottom="@dimen/item_gap_l"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/ivTippingClaimPreviewDialogHeaderIcon"
                android:layout_width="@dimen/avatar_size_xl"
                android:layout_height="@dimen/avatar_size_xl"
                android:layout_margin="@dimen/item_gap_l"
                android:layout_alignParentTop="true"
                android:layout_centerInParent="true"
                app:srcCompat="@drawable/ic_tipping_claim_success"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tvTippingClaimPreviewSuccessDialogTitle"
                android:padding="@dimen/item_gap_m"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_tipping_claim_success_title"
                android:layout_below="@+id/ivTippingClaimPreviewDialogHeaderIcon"
                android:textAlignment="gravity"
                style="@style/SbTextView.ListTitle"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tvTippingClaimPreviewSuccessDialogSubTitle"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/item_gap_l"
                android:layout_marginRight="@dimen/item_gap_l"
                android:text="@string/title_tipping_claim_success_sub_title"
                android:layout_below="@+id/tvTippingClaimPreviewSuccessDialogTitle"
                android:textAlignment="gravity"
                style="@style/SbTextView.BodyDefault"/>
            <RelativeLayout
                android:id="@+id/rlTippingClaimPreviewSuccessDialogContentLayout"
                android:background="@drawable/border_gray_rounded_outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/item_gap_l"
                android:layout_below="@+id/tvTippingClaimPreviewSuccessDialogSubTitle">
                <TextView
                    android:id="@+id/tvTippingClaimPreviewSuccessDialogContentSuccessTipsTitle"
                    android:padding="@dimen/item_gap_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_tipping_my_jar_dialog_claim_pending_disbursement_title"
                    android:layout_alignParentStart="true"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textColor="@color/gray_text"
                    android:gravity="end|center_vertical"
                    android:id="@+id/tvTippingClaimPreviewSuccessDialogContentClaimTips"
                    android:padding="@dimen/item_gap_m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/n_dash"
                    android:textAlignment="gravity"
                    android:layout_toEndOf="@+id/tvTippingClaimPreviewSuccessDialogContentSuccessTipsTitle"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:id="@+id/tvTippingClaimPreviewSuccessDialogContentStockbitFeeTitle"
                    android:padding="@dimen/item_gap_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_tipping_claim_success_stockbit_fee_title"
                    android:layout_below="@+id/tvTippingClaimPreviewSuccessDialogContentClaimTips"
                    android:layout_alignParentStart="true"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textColor="@color/gray_text"
                    android:gravity="end|center_vertical"
                    android:id="@+id/tvTippingClaimPreviewSuccessDialogContentStockbitFee"
                    android:padding="@dimen/item_gap_m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/n_dash"
                    android:layout_below="@+id/tvTippingClaimPreviewSuccessDialogContentSuccessTipsTitle"
                    android:textAlignment="gravity"
                    android:layout_toEndOf="@+id/tvTippingClaimPreviewSuccessDialogContentStockbitFeeTitle"
                    style="@style/SbTextView.BodyDefault"/>
                <View
                    android:id="@+id/vwDividerMainLayout"
                    android:background="@color/gray_border"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_gap_xxxs"
                    android:layout_below="@+id/tvTippingClaimPreviewSuccessDialogContentStockbitFeeTitle"/>
                <TextView
                    android:id="@+id/tvTippingClaimPreviewSuccessDialogContentTotalTitle"
                    android:padding="@dimen/item_gap_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_tipping_claim_success_total_title"
                    android:layout_below="@+id/vwDividerMainLayout"
                    android:layout_alignParentStart="true"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:gravity="end|center_vertical"
                    android:id="@+id/tvTippingClaimPreviewSuccessDialogContentTotal"
                    android:padding="@dimen/item_gap_m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/n_dash"
                    android:layout_below="@+id/tvTippingClaimPreviewSuccessDialogContentStockbitFeeTitle"
                    android:textAlignment="gravity"
                    android:layout_toEndOf="@+id/tvTippingClaimPreviewSuccessDialogContentTotalTitle"
                    style="@style/SbTextView.BodyDefault.Bold"/>
                <TextView
                    android:textColor="@color/gray_text"
                    android:gravity="end|center_vertical"
                    android:id="@+id/tvTippingClaimPreviewSuccessDialogContentGopayNumber"
                    android:padding="@dimen/item_gap_m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/n_dash"
                    android:layout_below="@+id/tvTippingClaimPreviewSuccessDialogContentTotal"
                    style="@style/SbTextView.BodyDefault"/>
            </RelativeLayout>
            <Button
                android:id="@+id/btnTippingClaimPreviewSuccessDialogDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/item_gap_l"
                android:text="@string/button_next"
                android:layout_below="@+id/rlTippingClaimPreviewSuccessDialogContentLayout"
                android:textAllCaps="true"
                style="@style/SbBtn.PrimaryFullWidthFloating"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
