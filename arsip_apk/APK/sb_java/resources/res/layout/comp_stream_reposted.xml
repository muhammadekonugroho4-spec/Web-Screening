<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent_reposted_post_root"
    android:tag="layout/comp_stream_reposted_0"
    android:focusable="true"
    android:visibility="gone"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    app:cardBackgroundColor="@color/transparent"
    app:cardCornerRadius="@dimen/shape_radius_m"
    app:cardElevation="@dimen/item_gap_null"
    app:strokeColor="?attr/themeColorBorder"
    app:strokeWidth="@dimen/item_gap_xxxs">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:tag="binding_1"
        android:paddingTop="@dimen/item_gap_10"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_reposted_post_user_profile"
            android:tag="binding_2"
            android:layout_width="@dimen/item_gap_28"
            android:layout_height="@dimen/item_gap_28"
            android:layout_marginStart="@dimen/item_gap_12"
            app:layout_constraintBottom_toBottomOf="@+id/tv_date_time_reposted"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ll_parent_reposted_username"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_parent_reposted_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/item_gap_8"
            app:layout_constraintStart_toEndOf="@+id/iv_reposted_post_user_profile"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:id="@+id/tv_reposted_post_username"
                android:tag="binding_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TypeStyles.HeadingSmall"/>
            <FrameLayout
                android:layout_width="@dimen/width_16"
                android:layout_height="@dimen/height_16"
                android:layout_marginStart="@dimen/item_gap_4">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_verified_badge"
                    android:tag="binding_4"
                    android:layout_width="@dimen/item_gap_12"
                    android:layout_height="@dimen/item_gap_12"
                    android:scaleType="fitXY"/>
            </FrameLayout>
        </LinearLayout>
        <TextView
            android:textColor="?attr/themeColorTextTetriary"
            android:id="@+id/tv_date_time_reposted"
            android:tag="binding_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/item_gap_8"
            app:layout_constraintStart_toEndOf="@+id/iv_reposted_post_user_profile"
            app:layout_constraintTop_toBottomOf="@+id/ll_parent_reposted_username"
            style="@style/TypeStyles.BodyXSmall"/>
        <TextView
            android:textColor="?attr/themeColorTextTetriary"
            android:id="@+id/tv_edited_date_time_reposted"
            android:tag="binding_6"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:paddingStart="@dimen/item_gap_4"
            app:layout_constraintStart_toEndOf="@+id/tv_date_time_reposted"
            app:layout_constraintTop_toBottomOf="@+id/ll_parent_reposted_username"
            style="@style/TypeStyles.BodyXSmall"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tv_reposted_post_comment_content"
            android:paddingBottom="@dimen/item_gap_8"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_4"
            android:maxLines="@integer/stream_text_max_line"
            android:layout_marginHorizontal="@dimen/item_gap_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_date_time_reposted"
            app:layout_goneMarginBottom="@dimen/shape_radius_l"
            app:layout_goneMarginTop="@dimen/shape_radius_l"
            style="@style/TypeStyles.BodyRegular"/>
        <ImageView
            android:id="@+id/iv_repost_news_icon"
            android:tag="binding_7"
            android:layout_width="@dimen/spacing_12"
            android:layout_height="@dimen/spacing_12"
            android:layout_marginStart="@dimen/spacing_12"
            app:layout_constraintBottom_toBottomOf="@+id/tv_repost_news_source"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_repost_news_source"/>
        <TextView
            android:id="@+id/tv_repost_news_source"
            android:tag="binding_8"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_2"
            android:singleLine="true"
            android:layout_marginStart="@dimen/spacing_4"
            android:layout_marginEnd="@dimen/item_gap_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/iv_repost_news_icon"
            app:layout_constraintTop_toBottomOf="@+id/tv_reposted_post_comment_content"
            app:layout_goneMarginStart="@dimen/spacing_16"
            style="@style/TypeStyles.BodyXSmall.Secondary"/>
        <ImageView
            android:id="@+id/iv_reposted_post_comment_image"
            android:tag="binding_9"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="@dimen/spacing_0"
            android:layout_marginTop="@dimen/spacing_16"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerCrop"
            android:contentDescription="@string/hint_post_image"
            app:layout_constraintDimensionRatio="v,16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_repost_news_source"/>
        <include
            android:id="@+id/stream_share_trade_repost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_12"
            android:layout_marginVertical="@dimen/spacing_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_reposted_post_comment_image"
            layout="@layout/comp_stream_share_trade"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
