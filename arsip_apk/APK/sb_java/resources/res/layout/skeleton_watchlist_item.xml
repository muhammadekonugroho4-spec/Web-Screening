<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/clickable_size_64">
    <View
        android:id="@+id/viewWatchlistItemSkeletonSymbol"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="50dp"
        android:layout_height="@dimen/item_gap_l"
        android:layout_marginLeft="@dimen/item_gap_l"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintBottom_toTopOf="@+id/viewWatchlistItemSkeletonName"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <View
        android:id="@+id/viewWatchlistItemSkeletonName"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="150dp"
        android:layout_height="@dimen/item_gap_l"
        android:layout_marginLeft="@dimen/item_gap_l"
        android:layout_marginTop="@dimen/item_gap_s"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewWatchlistItemSkeletonSymbol"/>
    <View
        android:id="@+id/viewWatchlistItemSkeletonValue"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="64dp"
        android:layout_height="@dimen/item_gap_l"
        android:layout_marginRight="@dimen/item_gap_l"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintBottom_toTopOf="@+id/viewWatchlistItemSkeletonPercent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <View
        android:id="@+id/viewWatchlistItemSkeletonPercent"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="72dp"
        android:layout_height="@dimen/item_gap_l"
        android:layout_marginTop="@dimen/item_gap_s"
        android:layout_marginRight="@dimen/item_gap_l"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewWatchlistItemSkeletonValue"/>
    <View
        android:id="@+id/viewWatchlistItemSkeletonBottomBorder"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_xxxs"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
