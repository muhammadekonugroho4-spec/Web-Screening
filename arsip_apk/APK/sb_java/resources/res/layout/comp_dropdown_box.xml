<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_dropdown_box_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gl_dropdown_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/spacing_12"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_dropdown_input_layout"
        android:background="@drawable/bg_box_default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:paddingVertical="@dimen/spacing_16"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColorHint="?attr/themeColorTextTetriary"
            android:id="@+id/tv_dropdown_value"
            android:background="@null"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_marginEnd="@dimen/spacing_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_dropdown_arrow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.BodyRegular"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_dropdown_arrow"
            android:layout_width="@dimen/icon_placeholder_16"
            android:layout_height="@dimen/icon_placeholder_16"
            android:layout_marginEnd="@dimen/spacing_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_chevron_down_secondary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/v_dropdown_label_background"
        android:visibility="gone"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="@dimen/spacing_0"
        app:layout_constraintBottom_toBottomOf="@+id/tv_dropdown_label"
        app:layout_constraintEnd_toEndOf="@+id/tv_dropdown_label"
        app:layout_constraintStart_toStartOf="@+id/tv_dropdown_label"
        app:layout_constraintTop_toTopOf="@+id/tv_dropdown_label"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_dropdown_label"
        android:background="?attr/themeContentBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_8"
        android:paddingHorizontal="@dimen/spacing_4"
        app:layout_constraintBottom_toTopOf="@+id/cl_dropdown_input_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cl_dropdown_input_layout"
        style="@style/TypeStyles.BodyXSmall"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_dropdown_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        app:layout_constraintStart_toStartOf="@+id/gl_dropdown_start"
        app:layout_constraintTop_toBottomOf="@+id/cl_dropdown_input_layout"
        app:srcCompat="@drawable/ic_input_error"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorTextRed"
        android:id="@+id/tv_dropdown_error_text"
        android:visibility="gone"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_dropdown_error"
        app:layout_constraintTop_toTopOf="@+id/iv_dropdown_error"
        app:layout_goneMarginStart="@dimen/spacing_0"
        app:layout_goneMarginTop="@dimen/spacing_8"
        style="@style/TypeStyles.BodyXSmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
