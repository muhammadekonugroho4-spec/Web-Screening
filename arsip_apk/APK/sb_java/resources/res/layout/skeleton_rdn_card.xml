<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/FBShimmerFrameLayout">
    <RelativeLayout
        android:paddingTop="@dimen/spacing_14"
        android:paddingBottom="@dimen/spacing_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_16">
        <FrameLayout
            android:id="@+id/view_bank_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/view_rdn"
            android:layout_alignBottom="@+id/view_account_number"
            android:layout_alignParentStart="true">
            <View
                android:layout_gravity="center"
                android:layout_width="@dimen/avatar_size_36"
                android:layout_height="@dimen/avatar_size_36"
                style="@style/FBShimmerItem.Circular"/>
        </FrameLayout>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="top"
            android:id="@+id/view_rdn"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rdn"
            android:layout_alignParentTop="true"
            android:lineSpacingExtra="2sp"
            android:translationY="-0.8sp"
            android:layout_marginStart="@dimen/spacing_12"
            android:layout_toEndOf="@+id/view_bank_logo"
            style="@style/TypeStyles.BodyXXSmall"/>
        <TextView
            android:textColor="?attr/themeDarkHighGray"
            android:ellipsize="end"
            android:gravity="top"
            android:id="@+id/tv_account_name_2"
            android:visibility="invisible"
            android:layout_width="@dimen/width_120"
            android:layout_height="wrap_content"
            android:text="X"
            android:maxLines="1"
            android:layout_below="@+id/view_rdn"
            android:lineSpacingExtra="2sp"
            android:translationY="-1.08sp"
            android:layout_marginEnd="@dimen/spacing_24"
            android:layout_alignStart="@+id/view_rdn"
            style="@style/TypeStyles.BodySmall"/>
        <View
            android:id="@+id/view_account_name"
            android:layout_width="@dimen/width_120"
            android:layout_height="@dimen/height_18"
            android:layout_below="@+id/view_rdn"
            android:layout_alignTop="@+id/tv_account_name_2"
            android:layout_alignBottom="@+id/tv_account_name_2"
            android:layout_marginEnd="42dp"
            android:layout_alignStart="@+id/tv_account_name_2"
            android:layout_marginVertical="2dp"
            style="@style/FBShimmerItem.Large"/>
        <TextView
            android:textColor="?attr/themeDarkHighGray"
            android:ellipsize="end"
            android:gravity="top"
            android:id="@+id/tv_account_number_2"
            android:visibility="invisible"
            android:layout_width="@dimen/width_80"
            android:layout_height="wrap_content"
            android:text="X"
            android:maxLines="1"
            android:layout_below="@+id/view_account_name"
            android:lineSpacingExtra="2sp"
            android:translationY="-1.08sp"
            android:layout_alignStart="@+id/view_account_name"
            android:layout_alignEnd="@+id/view_account_name"
            style="@style/TypeStyles.HeadingSmall"/>
        <View
            android:id="@+id/view_account_number"
            android:layout_width="@dimen/width_80"
            android:layout_height="@dimen/height_18"
            android:layout_alignTop="@+id/tv_account_number_2"
            android:layout_alignBottom="@+id/tv_account_number_2"
            android:layout_alignStart="@+id/tv_account_number_2"
            android:layout_marginVertical="2dp"
            style="@style/FBShimmerItem"/>
    </RelativeLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
