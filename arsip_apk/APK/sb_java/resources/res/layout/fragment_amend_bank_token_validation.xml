<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_amend_bank_token_validation_0"
    android:background="?attr/themeDialogBackgroundColor"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewFlipper
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:id="@+id/progressbarTippingMyJar"
                android:tag="binding_2"
                android:layout_width="@dimen/clickable_size_32"
                android:layout_height="@dimen/clickable_size_32"
                android:indeterminateTint="@color/green_text"
                style="@style/Widget.AppCompat.ProgressBar"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/item_gap_36"
            android:layout_marginEnd="@dimen/item_gap_36">
            <ImageView
                android:layout_width="@dimen/avatar_size_l"
                android:layout_height="@dimen/avatar_size_l"
                android:layout_marginBottom="@dimen/item_gap_34"
                app:srcCompat="@drawable/ic_bank_amend_expired"/>
            <TextView
                android:textSize="@dimen/text_size_18"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/item_gap_10"
                android:text="@string/setting_amend_bank_confirmation_expired_title"
                style="@style/SbTextView.BodyDefault.Bold"/>
            <TextView
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_amend_bank_confirmation_expired_body"
                style="@style/SbTextView.BodySecondary"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/item_gap_36"
            android:layout_marginEnd="@dimen/item_gap_36">
            <ImageView
                android:layout_width="@dimen/avatar_size_l"
                android:layout_height="@dimen/avatar_size_l"
                android:layout_marginBottom="@dimen/item_gap_34"
                app:srcCompat="@drawable/ic_bank_amend_invalid"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/item_gap_10"
                android:text="@string/setting_amend_bank_confirmation_invalid_title"
                style="@style/SbTextView.BodyDefault.Bold"/>
            <TextView
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_amend_bank_confirmation_invalid_body"
                style="@style/SbTextView.BodySecondary"/>
        </LinearLayout>
    </ViewFlipper>
    <Button
        android:textSize="@dimen/text_size_16"
        android:textColor="@color/white"
        android:id="@+id/btnBackHomePage"
        android:tag="binding_3"
        android:background="@drawable/border_green_rounded"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_44"
        android:layout_margin="@dimen/item_gap_20"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:text="@string/setting_amend_bank_back_to_home"
        android:layout_alignParentBottom="true"
        android:textAllCaps="false"
        style="@style/SbTextView.BodyDefault.Green.Bold"/>
</RelativeLayout>
