<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_choose_screener_screen_column_dialog_0"
    android:background="?attr/themeDialogBackgroundColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/rl_header"
        android:background="@drawable/bg_top_rounded"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48">
        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/n_dash"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            style="@style/SbTextView.TitleSmall"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_header">
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"/>
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/rl_sort_asc"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_sort_asc_icon"
                android:layout_width="@dimen/clickable_size_16"
                android:layout_height="@dimen/clickable_size_16"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ic_android_stream_up"/>
            <TextView
                android:textColor="@color/green_text"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_sort_asc_title"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/row_screener_height"
                android:text="@string/screener_screen_column_choose_sort_asc"
                android:layout_toRightOf="@+id/iv_sort_asc_icon"
                android:layout_centerVertical="true"
                style="@style/SbTextView.ListTitle"/>
        </RelativeLayout>
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"/>
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/rl_sort_desc"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_sort_desc_icon"
                android:layout_width="@dimen/clickable_size_16"
                android:layout_height="@dimen/clickable_size_16"
                android:layout_centerVertical="true"
                android:rotation="180"
                app:srcCompat="@drawable/ic_android_stream_up"/>
            <TextView
                android:textColor="@color/green_text"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_sort_desc_title"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/row_screener_height"
                android:text="@string/screener_screen_column_choose_sort_desc"
                android:layout_toRightOf="@+id/iv_sort_desc_icon"
                android:layout_centerVertical="true"
                style="@style/SbTextView.ListTitle"/>
        </RelativeLayout>
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"/>
        <RelativeLayout
            android:gravity="center"
            android:id="@+id/rl_remove_column"
            android:background="?attr/selectableItemBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_remove_column_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"
                android:tint="@color/red_item"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ic_screener_save_delete"/>
            <TextView
                android:textColor="@color/google_red"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_remove_column_title"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/row_screener_height"
                android:text="@string/screener_screen_column_choose_remove_column"
                android:layout_toRightOf="@+id/iv_remove_column_icon"
                android:layout_centerVertical="true"
                style="@style/SbTextView.ListTitle"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
