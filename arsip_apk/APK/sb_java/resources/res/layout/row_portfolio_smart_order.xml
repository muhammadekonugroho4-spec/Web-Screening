<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_portfolio_smart_order_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center"
        android:id="@+id/separator"
        android:background="?attr/titleTextColorDowngray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/uikit_divider_thin"
        android:layout_marginBottom="@dimen/spacing_16"
        android:layout_marginHorizontal="@dimen/uikit_divider_thin"/>
    <RelativeLayout
        android:id="@+id/rl_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_16"
        android:layout_below="@+id/separator"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="start"
            android:id="@+id/tv_desc_sell_target"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/uikit_divider_thin"
            android:layout_toLeftOf="@+id/btn_edit"
            android:layout_alignParentLeft="true"
            style="@style/TypeStyles.HeadingRegular"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/green_text"
            android:gravity="end"
            android:id="@+id/btn_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_edit"
            android:layout_alignParentRight="true"
            android:layout_marginStart="@dimen/spacing_8"
            style="@style/TypeStyles.HeadingSmall"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="start"
            android:id="@+id/tv_lot_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginBottom="@dimen/uikit_divider_thin"
            android:text="@string/smart_order_lot"
            android:layout_below="@+id/tv_desc_sell_target"
            android:layout_alignParentLeft="true"
            style="@style/TypeStyles.BodyRegular"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="end"
            android:id="@+id/tv_lot_value"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_toRightOf="@+id/tv_lot_title"
            android:layout_below="@+id/tv_desc_sell_target"
            android:layout_alignParentRight="true"
            android:layout_marginStart="@dimen/spacing_8"
            style="@style/TypeStyles.BodyRegular"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="start"
            android:id="@+id/tv_price_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginBottom="@dimen/uikit_divider_thin"
            android:text="@string/smart_order_price"
            android:layout_below="@+id/tv_lot_title"
            android:layout_alignParentLeft="true"
            style="@style/TypeStyles.BodyRegular"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="end"
            android:id="@+id/tv_price_value"
            android:tag="binding_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_toRightOf="@+id/tv_price_title"
            android:layout_below="@+id/tv_lot_title"
            android:layout_alignParentRight="true"
            android:layout_marginStart="@dimen/spacing_8"
            style="@style/TypeStyles.BodyRegular"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="start"
            android:id="@+id/tv_pnl"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginBottom="@dimen/uikit_divider_thin"
            android:text="@string/lbl_portfolio_loss_pl"
            android:layout_below="@+id/tv_price_title"
            android:layout_alignParentLeft="true"
            style="@style/TypeStyles.BodyRegular"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="end"
            android:id="@+id/tv_pnl_value"
            android:tag="binding_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_toRightOf="@+id/tv_pnl"
            android:layout_below="@+id/tv_price_value"
            android:layout_alignParentRight="true"
            android:layout_marginStart="@dimen/spacing_8"
            style="@style/TypeStyles.BodyRegular"/>
    </RelativeLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/error_lot"
        android:tag="binding_6"
        android:background="@drawable/bg_rounded_red_outline"
        android:padding="@dimen/spacing_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_container"
        android:layout_marginHorizontal="@dimen/spacing_16"
        android:layout_marginVertical="@dimen/spacing_8">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleType="fitEnd"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_8"
            app:srcCompat="@drawable/portfolio_ic_lot_error_13dp"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/smart_order_error_porfolio_detail"
            android:layout_weight="1"
            style="@style/TypeStyles.BodyXSmall"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</RelativeLayout>
