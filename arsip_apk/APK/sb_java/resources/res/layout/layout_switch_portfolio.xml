<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:tag="layout/layout_switch_portfolio_0"
    android:background="@drawable/bg_switch_portfolio_background"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/themeColorTextGreen"
        android:ellipsize="end"
        android:id="@+id/tv_title"
        android:background="@drawable/bg_switch_portfolio_foreground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="148dp"
        android:maxLines="1"
        android:drawablePadding="@dimen/spacing_4"
        android:paddingStart="@dimen/spacing_8"
        android:paddingEnd="@dimen/spacing_10"
        android:paddingVertical="@dimen/spacing_4"
        app:drawableStartCompat="@drawable/ic_chat_list_share_trade"
        app:drawableTint="?attr/themeColorFeatureGreen"
        style="@style/TypeStyles.BodyRegular"/>
    <ImageView
        android:layout_width="@dimen/spacing_14"
        android:layout_height="@dimen/spacing_14"
        android:src="@drawable/uikit_ic_stockbit_text_field_chevron_down"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/spacing_4"
        android:layout_marginEnd="@dimen/spacing_8"/>
</LinearLayout>
