<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme"
    android:tag="layout/fragment_withdraw_not_allowed_dialog_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/vgStockbitWithdrawalDialogHeader"
        android:background="@drawable/bg_top_rounded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivStockbitWithdrawalDialog"
            android:padding="@dimen/item_gap_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            app:srcCompat="0x7f080641"
            app:tint="?attr/titleTextColorLowgray"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/vgStockbitWithdrawalDialogHeader">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="@dimen/avatar_size_xxl"
            android:layout_height="@dimen/avatar_size_xxl"
            app:srcCompat="?attr/themeIconWithdrawNotAllowed"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_24"
            android:layout_marginBottom="@dimen/item_gap_l"
            android:text="@string/setting_withdraw_not_allowed"
            style="@style/SbTextView.BodyDefault.Bold"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/item_gap_l"
            android:text="@string/setting_withdraw_not_allowed_content"
            android:textAlignment="gravity"
            android:layout_marginStart="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/item_gap_20"
            style="@style/SbTextView.BodySecondary"/>
    </LinearLayout>
</RelativeLayout>
