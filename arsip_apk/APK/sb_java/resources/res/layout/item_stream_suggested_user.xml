<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentSuggestionUser"
    android:tag="layout/item_stream_suggested_user_0"
    android:background="?attr/themeColorDividerThick"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <HorizontalScrollView
        android:id="@+id/hsvTab"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_11"
        android:fillViewport="true"
        android:paddingEnd="@dimen/spacing_16"
        app:layout_constraintEnd_toStartOf="@+id/btnSuggestionsShowAll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.stockbit.uikit.chips.SBChipsGroup
            android:id="@+id/sbcgTab"
            android:paddingTop="@dimen/item_gap_13"
            android:paddingBottom="@dimen/item_gap_13"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_20"
            app:chipsActionMode="single_pick"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.stockbit.uikit.chips.SBChips
                android:id="@+id/sbcTrending"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:chipsSelected="true"
                app:chipsText="@string/tabs_discover_people_trending"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.stockbit.uikit.chips.SBChips
                android:id="@+id/sbcSuggestions"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:chipsSelected="false"
                app:chipsText="@string/tabs_stream_people_suggested"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.stockbit.uikit.chips.SBChips
                android:id="@+id/sbcFriends"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                app:chipsSelected="false"
                app:chipsText="@string/tabs_discover_people_friends"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </com.stockbit.uikit.chips.SBChipsGroup>
    </HorizontalScrollView>
    <TextView
        android:id="@+id/btnSuggestionsShowAll"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_see_all_suggestions"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="@dimen/spacing_20"
        android:paddingHorizontal="@dimen/item_gap_8"
        app:layout_constraintBottom_toBottomOf="@+id/hsvTab"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/hsvTab"
        style="@style/SbTextView.BodyDefault.Green"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/sflSuggestedUserLoading"
        android:visibility="gone"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/hsvTab">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/item_gap_s"
            android:paddingEnd="@dimen/item_gap_l">
            <View
                android:background="@drawable/bg_rounded_gray"
                android:layout_width="@dimen/img_grid_xl"
                android:layout_height="180dp"
                android:layout_marginTop="@dimen/item_gap_m"
                android:layout_marginBottom="@dimen/item_gap_m"
                android:layout_marginStart="@dimen/item_gap_m"
                android:backgroundTint="?attr/themeSeparatorGapColor"/>
            <View
                android:background="@drawable/bg_rounded_gray"
                android:layout_width="@dimen/img_grid_xl"
                android:layout_height="180dp"
                android:layout_marginTop="@dimen/item_gap_m"
                android:layout_marginBottom="@dimen/item_gap_m"
                android:layout_marginStart="@dimen/item_gap_m"
                android:backgroundTint="?attr/themeSeparatorGapColor"/>
            <View
                android:background="@drawable/bg_rounded_gray"
                android:layout_width="@dimen/img_grid_xl"
                android:layout_height="180dp"
                android:layout_marginTop="@dimen/item_gap_m"
                android:layout_marginBottom="@dimen/item_gap_m"
                android:layout_marginStart="@dimen/item_gap_m"
                android:backgroundTint="?attr/themeSeparatorGapColor"/>
            <View
                android:background="@drawable/bg_rounded_gray"
                android:layout_width="@dimen/img_grid_xl"
                android:layout_height="180dp"
                android:layout_marginTop="@dimen/item_gap_m"
                android:layout_marginBottom="@dimen/item_gap_m"
                android:layout_marginStart="@dimen/item_gap_m"
                android:backgroundTint="?attr/themeSeparatorGapColor"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <ViewFlipper
        android:id="@+id/vfSuggestedUserList"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/hsvTab">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/rvSuggestedPeople"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/spacing_8"
            android:paddingEnd="@dimen/spacing_12"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/sbcgTab"/>
        <include
            android:id="@+id/layoutFriendNotConnect"
            layout="@layout/item_stream_suggested_user_friend_not_connected"/>
        <include
            android:id="@+id/layoutSuggestionEmpty"
            layout="@layout/item_stream_suggested_user_suggestion_empty"/>
        <include
            android:id="@+id/layoutFriendEmpty"
            layout="@layout/item_stream_suggested_user_friend_empty"/>
    </ViewFlipper>
</androidx.constraintlayout.widget.ConstraintLayout>
