<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_error_max_order"
    android:tag="layout/comp_error_max_order_transaction_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_max_order_error_logo"
        android:layout_width="@dimen/width_180"
        android:layout_height="@dimen/height_120"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/themeIconMaxTrailingStopOrderError"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_max_order_error_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:text="@string/title_error_max_order"
        android:textAlignment="gravity"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintTop_toBottomOf="@+id/iv_max_order_error_logo"
        style="@style/TypeStyles.HeadingLarge"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="center"
        android:id="@+id/tv_max_order_error_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_8"
        android:text="@string/subtitle_error_max_order"
        android:textAlignment="gravity"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintTop_toBottomOf="@+id/tv_max_order_error_title"
        style="@style/TypeStyles.BodyRegular"/>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/btn_max_order_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:layout_marginBottom="@dimen/item_gap_20"
        android:text="@string/btn_positive_oke"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintTop_toBottomOf="@+id/tv_max_order_error_desc"/>
    <com.stockbit.uikit.button.FloatingButton
        android:id="@+id/btn_max_order_order_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:layout_marginBottom="@dimen/item_gap_20"
        android:text="@string/text_go_to_order_list"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_max_order_error"/>
</androidx.constraintlayout.widget.ConstraintLayout>
