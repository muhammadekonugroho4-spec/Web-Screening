            android:orientation="horizontal"
            android:id="@+id/ll_company_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/tv_symbol_title"
            android:paddingEnd="@dimen/spacing_16"
            android:layout_alignParentEnd="true">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_company_logo"
                android:layout_width="@dimen/spacing_16"
                android:layout_height="@dimen/spacing_16"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_symbol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/spacing_6"
                android:textAlignment="gravity"
                style="@style/TypeStyles.HeadingRegular"/>
        </LinearLayout>
        <View
            android:id="@+id/view_separate"
            android:background="?attr/themeColorModalsDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_1"
            android:layout_marginTop="@dimen/item_gap_12"
            android:layout_below="@+id/ll_company_symbol"/>
        <TextView
            android:id="@+id/tv_order_type_title"
            android:layout_width="@dimen/fixed_min_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:text="@string/smart_order_order_type"
            android:layout_below="@+id/view_separate"
            android:paddingStart="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_order_type_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/spacing_6"
            android:layout_toRightOf="@+id/tv_order_type_title"
            android:layout_below="@+id/view_separate"
            android:layout_alignTop="@+id/tv_order_type_title"
            android:textAlignment="gravity"
            android:paddingEnd="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:id="@+id/tv_expiry_title"
            android:layout_width="@dimen/row_width_preview_trade"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:text="@string/trading_preview_expiry_title"
            android:layout_below="@+id/tv_order_type_title"
            android:paddingStart="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_expiry_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/tv_expiry_title"
            android:layout_below="@+id/tv_order_type_title"
            android:layout_alignTop="@+id/tv_expiry_title"
            android:layout_centerVertical="true"
            android:textAlignment="gravity"
            android:paddingEnd="@dimen/spacing_16"
            android:layout_marginStart="@dimen/spacing_6"
            android:layout_toEndOf="@+id/tv_expiry_title"
            android:layout_alignParentEnd="true"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:id="@+id/tv_title_trigger_price"
            android:visibility="gone"
            android:layout_width="@dimen/fixed_min_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:text="@string/smart_order_trigger_price"
            android:layout_below="@+id/tv_lot_title"
            android:paddingStart="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_trigger_price_comparison"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/tv_title_trigger_price"
            android:layout_alignBottom="@+id/tv_trigger_price"
            android:textAlignment="gravity"
            android:layout_marginEnd="@dimen/item_gap_4"
            android:layout_toStartOf="@+id/tv_trigger_price"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_trigger_price"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/tv_title_trigger_price"
            android:textAlignment="gravity"
            android:paddingEnd="@dimen/spacing_16"
            android:layout_alignParentEnd="true"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:id="@+id/tv_lot_title"
            android:layout_width="@dimen/row_width_preview_trade"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:text="@string/trading_preview_lot_title"
            android:layout_below="@+id/tv_expiry_title"
            android:layout_alignParentLeft="true"
            android:paddingStart="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
