            android:id="@+id/tv_lot_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/spacing_6"
            android:layout_toRightOf="@+id/tv_lot_title"
            android:layout_alignTop="@+id/tv_lot_title"
            android:textAlignment="gravity"
            android:paddingEnd="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_lot_split_order_sell"
            android:background="?attr/themeColorPeriwinkleLowMedium"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:layout_below="@+id/tv_title_trigger_price"
            android:layout_marginHorizontal="@dimen/spacing_16">
            <TextView
                android:id="@+id/tv_lot_split_order_title_sell"
                android:layout_width="@dimen/fixed_min_width"
                android:layout_height="wrap_content"
                android:text="@string/trading_preview_lot_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_lot_split_order_sell"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/spacing_6"
                android:textAlignment="gravity"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_lot_split_order_title_sell"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:id="@+id/tv_child_lot_one_title_sell"
                android:layout_width="@dimen/fixed_min_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_12"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_lot_split_order_title_sell"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:gravity="end"
                android:id="@+id/tv_child_lot_one_sell"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/spacing_6"
                android:layout_marginTop="@dimen/item_gap_12"
                android:textAlignment="gravity"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_child_lot_one_title_sell"
                app:layout_constraintTop_toBottomOf="@+id/tv_lot_split_order_title_sell"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:id="@+id/tv_child_lot_two_title_sell"
                android:visibility="gone"
                android:layout_width="@dimen/fixed_min_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_12"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_child_lot_one_sell"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:gravity="end"
                android:id="@+id/tv_child_lot_two"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/spacing_6"
                android:layout_marginTop="@dimen/item_gap_12"
                android:textAlignment="gravity"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_child_lot_two_title_sell"
                app:layout_constraintTop_toBottomOf="@+id/tv_child_lot_one_sell"
                style="@style/TypeStyles.BodyRegular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:id="@+id/tv_price_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:text="@string/sell_title_price"
            android:minEms="10"
            android:layout_below="@+id/cl_lot_split_order_sell"
            android:paddingStart="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_price_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/n_dash"
            android:layout_toRightOf="@+id/tv_price_title"
            android:layout_below="@+id/cl_lot_split_order_sell"
            android:layout_alignTop="@+id/tv_price_title"
            android:textAlignment="gravity"
            android:paddingEnd="@dimen/spacing_16"
            android:layout_marginStart="@dimen/spacing_6"
            android:layout_toEndOf="@+id/tv_price_title"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:id="@+id/tv_sell_price_title"
            android:visibility="gone"
            android:layout_width="@dimen/row_width_preview_trade"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:text="@string/auto_order_sell_price_title"
            android:layout_below="@+id/tv_price_title"
            android:paddingStart="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_sell_price_value"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/price_value_market_title"
            android:hint="@string/n_dash"
            android:layout_toRightOf="@+id/tv_sell_price_title"
            android:layout_below="@+id/tv_price_value"
            android:layout_alignTop="@+id/tv_sell_price_title"
            android:textAlignment="gravity"
            android:paddingEnd="@dimen/spacing_16"
            android:layout_marginStart="@dimen/spacing_6"
            android:layout_toEndOf="@+id/tv_sell_price_title"
            style="@style/TypeStyles.BodyRegular"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_volume_trigger_bid_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:layout_below="@+id/tv_sell_price_title"
            android:paddingHorizontal="@dimen/spacing_16">
            <TextView
                android:id="@+id/tv_sell_volume_trigger_bid_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trading_preview_remaining_bid_vol_title"
                android:layout_weight="1"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_sell_volume_trigger_bid_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/price_value_market_title"
                android:hint="@string/n_dash"
                android:layout_weight="1"
                android:textAlignment="gravity"
                style="@style/TypeStyles.BodyRegular"/>
        </LinearLayout>
        <TextView
            android:id="@+id/tv_trail_percentage_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:text="@string/trading_preview_trail_percentage_title"
            android:layout_below="@+id/ll_volume_trigger_bid_layout"
            android:paddingStart="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_trail_percentage_value"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/n_dash"
            android:layout_toRightOf="@+id/tv_price_title"
            android:layout_below="@+id/tv_sell_price_value"
            android:layout_alignTop="@+id/tv_trail_percentage_title"
            android:textAlignment="gravity"
            android:paddingEnd="@dimen/spacing_16"
            android:layout_marginStart="@dimen/spacing_6"
            android:layout_toEndOf="@+id/tv_price_title"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:id="@+id/tv_initial_stop_price_title"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:text="@string/trading_preview_initial_stop_price_title"
            android:layout_below="@+id/tv_trail_percentage_title"
            android:paddingStart="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_initial_stop_price_value"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/n_dash"
            android:layout_toRightOf="@+id/tv_price_title"
            android:layout_below="@+id/tv_trail_percentage_value"
            android:layout_alignTop="@+id/tv_initial_stop_price_title"
            android:textAlignment="gravity"
            android:paddingEnd="@dimen/spacing_16"
            android:layout_marginStart="@dimen/spacing_6"
            android:layout_toEndOf="@+id/tv_price_title"
            style="@style/TypeStyles.BodyRegular"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_trading_confirmation_preview_sell_split_order_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_initial_stop_price_title"
            android:layout_marginHorizontal="@dimen/spacing_16">
            <TextView
                android:id="@+id/tv_split_quantity_title"
                android:layout_width="@dimen/fixed_min_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_12"
                android:text="@string/tv_split_order_quantity_title"
                app:layout_constraintEnd_toStartOf="@+id/tv_split_quantity_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_split_quantity_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toEndOf="@+id/tv_split_quantity_title"
                app:layout_constraintTop_toTopOf="@+id/tv_split_quantity_title"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:id="@+id/tv_split_method_title"
                android:layout_width="@dimen/fixed_min_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_12"
                android:text="@string/tv_split_method_title"
                app:layout_constraintEnd_toStartOf="@+id/tv_split_method_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_split_quantity_title"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_split_method_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_6"
                app:layout_constraintBottom_toBottomOf="@+id/tv_split_method_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_split_method_title"
                app:layout_constraintTop_toTopOf="@+id/tv_split_method_title"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:id="@+id/tv_split_range_lot_title"
                android:layout_width="@dimen/fixed_min_width"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_12"
                android:text="@string/tv_trading_confirmation_preview_buy_split_range_lot_title"
                app:layout_constraintEnd_toStartOf="@+id/tv_split_range_lot_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_split_method_title"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_split_range_lot_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_6"
                app:layout_constraintBottom_toBottomOf="@+id/tv_split_range_lot_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_split_range_lot_title"
                app:layout_constraintTop_toTopOf="@+id/tv_split_range_lot_title"
                style="@style/TypeStyles.BodyRegular"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_split_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tv_split_range_lot_title, tv_split_range_lot_value"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tv_proceed_amount_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:minWidth="@dimen/row_width_preview_trade"
            android:text="@string/trading_preview_amount_proceed_title"
            android:maxLines="1"
            android:layout_below="@+id/cl_trading_confirmation_preview_sell_split_order_layout"
            android:paddingStart="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_proceed_amount_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/spacing_6"
            android:layout_toRightOf="@+id/tv_price_title"
            android:layout_below="@+id/cl_trading_confirmation_preview_sell_split_order_layout"
            android:layout_alignTop="@+id/tv_proceed_amount_title"
            android:layout_centerVertical="true"
            android:textAlignment="gravity"
            android:paddingEnd="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:id="@+id/tv_broker_fee_title"
            android:layout_width="@dimen/fixed_min_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:text="@string/trading_preview_broker_fee_title"
            android:layout_below="@+id/tv_proceed_amount_value"
            android:paddingStart="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_broker_fee_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/spacing_6"
            android:layout_toRightOf="@+id/tv_broker_fee_title"
            android:layout_below="@+id/tv_proceed_amount_value"
            android:layout_alignTop="@+id/tv_broker_fee_title"
            android:textAlignment="gravity"
            android:paddingEnd="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <LinearLayout
            android:id="@+id/rl_exchange_fee_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:weightSum="1"
            android:layout_below="@+id/tv_broker_fee_title"
            android:layout_marginHorizontal="@dimen/spacing_16">
            <TextView
                android:id="@+id/tv_exchange_fee_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trading_preview_exchange_fee_title"
                android:layout_weight="1"
                style="@style/TypeStyles.BodyRegular"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_exchange_fee_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/item_gap_4"
                app:srcCompat="@drawable/ic_info_fee"/>
        </LinearLayout>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_exchange_fee_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/spacing_6"
            android:layout_toRightOf="@+id/rl_exchange_fee_title"
            android:layout_below="@+id/tv_broker_fee_title"
            android:layout_alignTop="@+id/rl_exchange_fee_title"
            android:textAlignment="gravity"
            android:paddingEnd="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_surface_emphasis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:layout_below="@+id/rl_exchange_fee_title"
            android:paddingHorizontal="@dimen/spacing_16"
            android:paddingVertical="@dimen/spacing_12">
