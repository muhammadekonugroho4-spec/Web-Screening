            android:layout_width="@dimen/row_width_preview_trade"
            android:layout_height="wrap_content"
            android:text="@string/trading_preview_stock_title"
            android:layout_alignParentLeft="true"
            android:paddingStart="@dimen/spacing_16"
            style="@style/TypeStyles.BodyRegular"/>
        <LinearLayout
