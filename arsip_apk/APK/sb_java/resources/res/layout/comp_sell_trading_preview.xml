        android:id="@+id/rl_trading_confirmation_preview_sell_stock_content_layout"
        android:background="@drawable/border_gray_rounded_transparent_bg"
        android:paddingTop="@dimen/spacing_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
