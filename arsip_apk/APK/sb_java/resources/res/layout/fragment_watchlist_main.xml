<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentFragmentWatchlistRoot"
    android:tag="layout/fragment_watchlist_main_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/ablFragmentWatchlist"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="@dimen/item_gap_null">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarFragmentWatchlist"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationContentDescription="@string/SHARED_1"
            style="@style/Sb.Widget.AppBar">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/ivFragmentStreamCompanyLogo"
                android:padding="@dimen/item_gap_xxs"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/clickable_size_32"
                android:scaleType="centerInside"
                android:contentDescription="@string/app_name"
                app:srcCompat="?attr/themeStockbitLogoWithText"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <RelativeLayout
        android:id="@+id/parentFragmentWatchlistContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/ablFragmentWatchlist">
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshList"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFragmentWatchlistMain"
                android:background="?attr/themeColorSurfaceDefault"
                android:paddingBottom="@dimen/bottom_navigation_view_height"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <androidx.cardview.widget.CardView
            android:id="@+id/parentWatchlistFragmentPriceOutdated"
            android:background="@color/background_warning"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/clickable_size_32"
            android:layout_marginTop="@dimen/clickable_size_24"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:alpha="0"
            android:translationY="-24dp"
            app:cardBackgroundColor="@color/background_warning"
            app:cardCornerRadius="@dimen/item_gap_l"
            app:cardElevation="@dimen/item_gap_null">
            <RelativeLayout
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/clickable_size_32">
                <ImageView
                    android:id="@+id/ivWatchlistFragmentInfoIcon"
                    android:layout_width="@dimen/item_gap_l"
                    android:layout_height="@dimen/item_gap_l"
                    android:layout_marginLeft="@dimen/item_gap_m"
                    app:srcCompat="@drawable/ic_info_black_24dp"
                    app:tint="@color/highgray_light"/>
                <TextView
                    android:paddingLeft="@dimen/item_gap_s"
                    android:paddingRight="@dimen/item_gap_m"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_watchlist_price_outdated"
                    android:layout_toRightOf="@+id/ivWatchlistFragmentInfoIcon"
                    style="@style/SbTextView.Caption.Bold"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>
</RelativeLayout>
