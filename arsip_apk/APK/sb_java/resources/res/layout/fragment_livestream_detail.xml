<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_livestream_detail_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:titleTextAppearance="@style/SbTextView.PageTitle"
        style="@style/Sb.Widget.AppBar">
        <TextView
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_live"
            style="@style/SbTextView.PageTitle"/>
    </androidx.appcompat.widget.Toolbar>
    <View
        android:id="@+id/view_separate_toolbar"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_below="@+id/toolbar"/>
    <include
        android:id="@+id/comp_shimmer_livestream"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_separate_toolbar"
        layout="@layout/skeleton_livestream"/>
    <FrameLayout
        android:id="@+id/parent_detail_livestream"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_separate_toolbar">
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/srl_detail_livestream"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_youtube_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/view_separate_toolbar">
                    <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                        android:id="@+id/youtube_player_view"
                        android:tag="binding_2"
                        android:visibility="gone"
                        android:layout_width="@dimen/spacing_0"
                        android:layout_height="@dimen/spacing_0"
                        app:enableAutomaticInitialization="false"
                        app:layout_constraintDimensionRatio="h,16:9"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/iv_livestream_banner_video"
                        android:tag="binding_3"
                        android:layout_width="@dimen/spacing_0"
                        android:layout_height="@dimen/spacing_0"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/livestream_cover_image_youtube"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="h,16:9"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageView
                        android:id="@+id/iv_livestream_player"
                        android:tag="binding_4"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_play_video"
                        android:contentDescription="@string/livestream_cover_image_youtube"
                        android:layout_marginVertical="@dimen/height_80"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_livestream_banner_video"
                        app:layout_constraintEnd_toEndOf="@+id/iv_livestream_banner_video"
                        app:layout_constraintStart_toStartOf="@+id/iv_livestream_banner_video"
                        app:layout_constraintTop_toTopOf="@+id/iv_livestream_banner_video"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.core.widget.NestedScrollView
                    android:tag="binding_5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <include
                        android:id="@+id/layout_banner_title"
                        layout="@layout/comp_livestream_item"/>
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/full_screen_view_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</RelativeLayout>
