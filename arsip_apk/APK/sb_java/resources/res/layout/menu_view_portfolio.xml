<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/clickable_size_48"
    android:layout_height="@dimen/clickable_size_48">
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/ibSharePortfolio"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="@dimen/clickable_size_24"
        android:layout_height="@dimen/clickable_size_24"
        android:contentDescription="@string/action_share_portfolio"
        app:srcCompat="@drawable/ic_android_share"
        app:tint="?attr/themeIconTintColor"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lavSharePortfolio"
        android:visibility="gone"
        android:layout_width="@dimen/clickable_size_48"
        android:layout_height="@dimen/clickable_size_48"
        app:lottie_autoPlay="true"
        app:lottie_fileName="lottie_share_button_animation.json"
        app:lottie_loop="true"/>
</FrameLayout>
