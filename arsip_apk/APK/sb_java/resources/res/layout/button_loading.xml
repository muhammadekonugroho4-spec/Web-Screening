<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentActivityLoginSubmit"
    android:background="@drawable/bg_button_loading_active"
    android:layout_width="match_parent"
    android:layout_height="@dimen/clickable_size_48">
    <ProgressBar
        android:id="@+id/progressbarLogin"
        android:visibility="gone"
        android:layout_width="@dimen/clickable_size_24"
        android:layout_height="@dimen/clickable_size_24"
        android:layout_centerVertical="true"
        android:indeterminateTint="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Widget.AppCompat.ProgressBar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clContent"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivIcon"
            android:visibility="gone"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/item_gap_24"
            android:layout_centerVertical="true"
            android:contentDescription="Icon"
            android:layout_marginEnd="6dp"
            android:layout_toStartOf="@+id/tvActivityLoginSubmit"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvActivityLoginSubmit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:enabled="false"
            android:textColor="?attr/themeTextColorOnAnimatedPrice"
            android:gravity="center"
            android:id="@+id/tvActivityLoginSubmit"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/btn_login_next"
            android:textAlignment="gravity"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ivIcon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SbTextView.Button.Regular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
