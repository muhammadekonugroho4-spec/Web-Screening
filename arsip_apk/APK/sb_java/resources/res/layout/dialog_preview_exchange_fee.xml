<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_preview_exchange_fee_0"
    android:paddingBottom="@dimen/item_gap_32"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/item_gap_20">
    <TextView
        android:id="@+id/tv_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        app:layout_constraintEnd_toEndOf="@+id/tv_desc"
        app:layout_constraintStart_toStartOf="@+id/tv_desc"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc"
        style="@style/TypeStyles.BodyRegular"/>
    <RelativeLayout
        android:background="@drawable/border_gray_rounded_transparent_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        android:layout_below="@+id/tv_subtitle"
        android:paddingHorizontal="@dimen/item_gap_16"
        android:paddingVertical="@dimen/item_gap_12"
        app:layout_constraintTop_toBottomOf="@+id/tv_subtitle">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_exchange_fee_info"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <View
            android:id="@+id/view_separator"
            android:background="?attr/titleTextColorDowngray"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_below="@+id/rv_exchange_fee_info"/>
        <TextView
            android:id="@+id/tv_fee_total_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:layout_below="@+id/view_separator"
            android:layout_centerVertical="true"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tvTradingExchangeFeeTotal"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:layout_toRightOf="@+id/tv_fee_total_title"
            android:layout_below="@+id/view_separator"
            android:textAlignment="gravity"
            android:layout_marginStart="@dimen/item_gap_s"
            style="@style/TypeStyles.HeadingRegular"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
