<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/bottom_sheet_phone_registered_0"
    android:background="@drawable/bg_top_rounded_16"
    android:paddingBottom="@dimen/item_gap_34"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/item_gap_20"
    android:paddingEnd="@dimen/item_gap_20">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_info"
        android:visibility="visible"
        android:layout_width="125dp"
        android:layout_height="105dp"
        android:layout_marginTop="@dimen/item_gap_24"
        android:src="?attr/themeIconPhoneRegistered"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:text="@string/title_regist_phone_duplicate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_info"
        style="@style/TypeStyles.HeadlineRegular"/>
    <TextView
        android:textColorLink="?attr/themeColorTextGreen"
        android:gravity="center"
        android:id="@+id/tv_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        android:text="@string/msg_regist_phone_duplicate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/TypeStyles.BodyRegular"/>
    <com.stockbit.uikit.buttons.PrimaryButton
        android:textColor="@color/white"
        android:id="@+id/btn_login"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_44"
        android:layout_marginTop="@dimen/item_gap_40"
        android:text="@string/button_log_in"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc"/>
    <com.stockbit.uikit.buttons.SecondaryButton
        android:id="@+id/btn_use_another_phone"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_44"
        android:layout_marginTop="@dimen/item_gap_16"
        android:text="@string/button_use_another_phone_number"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="@+id/btn_login"
        app:layout_constraintStart_toStartOf="@+id/btn_login"
        app:layout_constraintTop_toBottomOf="@+id/btn_login"/>
</androidx.constraintlayout.widget.ConstraintLayout>
