<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme"
    android:tag="layout/fragment_running_trade_access_dialog_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/rl_dialog_title"
        android:background="@drawable/bg_top_rounded"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48">
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/running_trade_title"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            style="@style/TypeStyles.HeadingRegular"/>
        <ImageButton
            android:id="@+id/iv_close"
            android:background="?attr/selectableItemBackground"
            android:padding="@dimen/item_gap_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080641"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_dialog_title">
        <View
            android:id="@+id/view_separate"
            android:background="?attr/themeColorModalsDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_1"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/text_gray_darkest"
            android:gravity="center"
            android:id="@+id/tv_subtitle"
            android:padding="@dimen/item_gap_m"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_l"
            android:layout_marginBottom="@dimen/item_gap_l"
            android:text="@string/lbl_orderbook_for_non_pro_user"
            android:textAlignment="gravity"
            style="@style/TypeStyles.BodyRegular"/>
        <com.stockbit.uikit.button.EllipseButton
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/btn_open_account"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/buy_height_btn"
            android:layout_marginLeft="@dimen/item_gap_32"
            android:layout_marginRight="@dimen/item_gap_32"
            android:layout_marginBottom="@dimen/item_gap_l"
            android:text="@string/title_create_account"
            android:textAllCaps="true"/>
    </LinearLayout>
</RelativeLayout>
