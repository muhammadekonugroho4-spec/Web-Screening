<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_stock_filter_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stockbit.uikit.topbar.TopbarStockbitTitle
        android:id="@+id/toolbar_filter_stock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:topBarTitleTitle="@string/stock_to_display"
        app:topBarType="CenterTitle"/>
    <com.stockbit.feature.stocksfilter.component.StockFilterEditText
        android:id="@+id/et_header_search_input"
        android:background="@drawable/bg_border_gray_rounded"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_44"
        android:layout_marginTop="@dimen/spacing_8"
        android:minHeight="@dimen/clickable_size_32"
        android:hint="@string/text_hint_search_stock"
        android:layout_centerVertical="true"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionGo"
        android:layout_marginHorizontal="@dimen/spacing_20"
        android:paddingHorizontal="@dimen/clickable_size_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_filter_stock"
        style="@style/SbEditTextStyle.GrayBackground"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/ib__header_search_button"
        android:padding="@dimen/item_gap_xs"
        android:layout_width="@dimen/clickable_size_20"
        android:layout_height="@dimen/clickable_size_20"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:contentDescription="@string/hint_search_content"
        android:layout_marginStart="@dimen/item_gap_s"
        app:layout_constraintBottom_toBottomOf="@+id/et_header_search_input"
        app:layout_constraintStart_toStartOf="@+id/et_header_search_input"
        app:layout_constraintTop_toTopOf="@+id/et_header_search_input"
        app:srcCompat="@drawable/ic_android_search"
        app:tint="@color/highgray_light"/>
    <ImageButton
        android:id="@+id/ib__header_clear_query"
        android:background="@null"
        android:padding="@dimen/spacing_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:contentDescription="@string/hint_clear_search_text"
        android:layout_alignParentEnd="true"
        android:layout_marginHorizontal="@dimen/spacing_6"
        app:layout_constraintBottom_toBottomOf="@+id/et_header_search_input"
        app:layout_constraintEnd_toEndOf="@+id/et_header_search_input"
        app:layout_constraintTop_toTopOf="@+id/et_header_search_input"
        app:srcCompat="@drawable/ic_close_outline"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_stocks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/spacing_8"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_header_search_input"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_empty"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_header_search_input"
        app:srcCompat="@drawable/ic_search_empty"/>
    <TextView
        android:textSize="@dimen/text_size_13"
        android:id="@+id/tv_search_empty"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:text="@string/msg_no_results_found"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_empty"
        style="@style/TypeStyles.Secondary"/>
    <include
        android:id="@+id/shimmer_search_stock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:layout_marginHorizontal="@dimen/spacing_20"
        app:layout_constraintTop_toBottomOf="@+id/et_header_search_input"
        layout="@layout/item_stocks_search_shimmer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
