<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_open_access_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="@dimen/spacing_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_background_open_access"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:src="?attr/themeIconOpenAccessPaywall"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_close_open_access"
            android:layout_width="@dimen/spacing_24"
            android:layout_height="@dimen/spacing_24"
            android:layout_marginTop="@dimen/spacing_16"
            android:src="@drawable/uikit_ic_stockbit_top_bar_close"
            android:layout_marginEnd="@dimen/spacing_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_all_feature_title"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="@string/title_headline_subscription"
            android:layout_marginHorizontal="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_background_open_access"
            style="@style/TypeStyles.NominalLarge"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_professional_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:text="@string/title_professional_stockbit"
            android:layout_marginHorizontal="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_all_feature_title"
            style="@style/TypeStyles.NominalLarge"/>
        <View
            android:id="@+id/v_professional_title_underline"
            android:background="?attr/themeColorGreenDefault"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="@dimen/spacing_3"
            app:layout_constraintEnd_toEndOf="@+id/tv_professional_title"
            app:layout_constraintStart_toStartOf="@+id/tv_professional_title"
            app:layout_constraintTop_toBottomOf="@+id/tv_professional_title"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_unlimited_title"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:text="@string/title_paywall_no_limit"
            android:layout_marginHorizontal="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_professional_title"
            style="@style/TypeStyles.NominalLarge"/>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_open_stock"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:layout_marginHorizontal="@dimen/spacing_20"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="@dimen/spacing_8"
            app:cardElevation="@dimen/spacing_0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_unlimited_title"
            app:rippleColor="@color/transparent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="?attr/themeBackgroundOpenAccessPaywall"
                android:paddingTop="@dimen/spacing_6"
                android:paddingBottom="@dimen/spacing_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_open_stock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="?attr/themeIconOpenStockPaywall"
                    android:layout_marginStart="@dimen/spacing_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/tv_open_stock_title"
                    android:layout_width="@dimen/spacing_0"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:text="@string/title_paywall_open_trading_account"
                    android:layout_marginHorizontal="@dimen/spacing_12"
                    app:layout_constraintEnd_toStartOf="@+id/iv_arrow_open_stock"
                    app:layout_constraintStart_toEndOf="@+id/iv_open_stock"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TypeStyles.HeadlineRegular"/>
                <TextView
                    android:id="@+id/tv_open_stock_desc"
                    android:layout_width="@dimen/spacing_0"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:layout_marginBottom="@dimen/spacing_24"
                    android:text="@string/desc_paywall_open_stock"
                    android:layout_marginHorizontal="@dimen/spacing_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/iv_arrow_open_stock"
                    app:layout_constraintStart_toEndOf="@+id/iv_open_stock"
                    app:layout_constraintTop_toBottomOf="@+id/tv_open_stock_title"
                    style="@style/TypeStyles.BodySmall"/>
                <ImageView
                    android:id="@+id/iv_arrow_open_stock"
                    android:layout_width="@dimen/icon_placeholder_18"
                    android:layout_height="@dimen/icon_placeholder_18"
                    android:src="@drawable/uikit_ic_stockbit_top_bar_chevron_right"
                    android:layout_marginEnd="@dimen/spacing_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?attr/themeColorFeatureGreen"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btn_subscription"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:layout_marginHorizontal="@dimen/spacing_20"
            app:cardBackgroundColor="@color/transparent"
            app:cardCornerRadius="@dimen/spacing_8"
            app:cardElevation="@dimen/spacing_0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_open_stock"
            app:rippleColor="@color/transparent"
            app:strokeColor="?attr/themeColorBorder"
            app:strokeWidth="1dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingTop="@dimen/spacing_6"
                android:paddingBottom="@dimen/spacing_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_subscription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="?attr/themeIconSubscriptionPaywall"
                    android:layout_marginStart="@dimen/spacing_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:id="@+id/tv_subscription_title"
                    android:layout_width="@dimen/spacing_0"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_24"
                    android:text="@string/title_subscribe"
                    android:layout_marginHorizontal="@dimen/spacing_12"
                    app:layout_constraintEnd_toStartOf="@+id/iv_arrow_subscription"
                    app:layout_constraintStart_toEndOf="@+id/iv_subscription"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TypeStyles.HeadlineRegular"/>
                <TextView
                    android:id="@+id/tv_subscription_desc"
                    android:layout_width="@dimen/spacing_0"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    android:layout_marginBottom="@dimen/spacing_24"
                    android:text="@string/desc_paywall_subscribe"
                    android:layout_marginHorizontal="@dimen/spacing_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/iv_arrow_subscription"
                    app:layout_constraintStart_toEndOf="@+id/iv_subscription"
                    app:layout_constraintTop_toBottomOf="@+id/tv_subscription_title"
                    style="@style/TypeStyles.BodySmall"/>
                <ImageView
                    android:id="@+id/iv_arrow_subscription"
                    android:layout_width="@dimen/icon_placeholder_18"
                    android:layout_height="@dimen/icon_placeholder_18"
                    android:src="@drawable/uikit_ic_stockbit_top_bar_chevron_right"
                    android:layout_marginEnd="@dimen/spacing_12"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?attr/themeIconTintColorLow"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
