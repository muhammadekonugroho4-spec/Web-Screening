<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_parent"
    android:tag="layout/row_tipping_my_jar_notification_0"
    android:background="?attr/themeContentBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="@dimen/clickable_size_64">
    <View
        android:id="@+id/v_notification_row_unread_indicator"
        android:background="?attr/themeSeparatorGapColor"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.9"
        app:layout_constraintBottom_toBottomOf="@+id/view_notification_row_border"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/fl_notification_row_icon_container"
        android:layout_width="@dimen/avatar_size_default"
        android:layout_height="@dimen/avatar_size_default"
        android:layout_marginTop="@dimen/item_gap_l"
        android:layout_marginStart="@dimen/item_gap_l"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_notification_row_icon"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_circle_gray"
            android:contentDescription="@string/user_profile_photo"/>
    </FrameLayout>
    <TextView
        android:id="@+id/tv_notification_row_content"
        android:paddingLeft="@dimen/item_gap_l"
        android:paddingTop="@dimen/item_gap_m"
        android:paddingRight="@dimen/item_gap_l"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/tv_notification_row_time"
        app:layout_constraintLeft_toRightOf="@+id/fl_notification_row_icon_container"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/SbTextView.BodyDefault"/>
    <TextView
        android:id="@+id/tv_notification_row_time"
        android:paddingLeft="@dimen/item_gap_l"
        android:paddingRight="@dimen/item_gap_l"
        android:paddingBottom="@dimen/item_gap_m"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_s"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/fl_notification_row_icon_container"
        app:layout_constraintTop_toBottomOf="@+id/tv_notification_row_content"
        style="@style/SbTextView.CaptionSecondary"/>
    <View
        android:id="@+id/view_notification_row_border"
        android:background="?attr/themeSeparatorGapColor"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_xxxs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
