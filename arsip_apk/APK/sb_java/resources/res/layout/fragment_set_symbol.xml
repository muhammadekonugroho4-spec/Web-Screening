<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_set_symbol_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="0dp">
    <androidx.core.widget.NestedScrollView
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_nested"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/btn_set_symbol_noe_empty"
                android:tag="binding_2"
                android:background="@drawable/border_green_button"
                android:padding="@dimen/item_gap_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/symbol_list">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="@dimen/height_16"
                    android:layout_height="@dimen/item_gap_16"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/ic_add_circle_outline"
                    app:tint="@color/green_text"/>
                <TextView
                    android:layout_gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/stock_code"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/item_gap_9"
                    style="@style/SbTextView.BodyDefault.Green"/>
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="@dimen/item_gap_6"
                    android:layout_height="@dimen/item_gap_12"
                    app:srcCompat="@drawable/ic_chevron_right"/>
            </LinearLayout>
            <include
                android:id="@+id/symbol_list"
                layout="@layout/layout_symbol_list"/>
            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_32"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/themeIcStockAndCase"/>
            <TextView
                android:textSize="@dimen/text_size_18"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="@string/choose_stock_code"
                app:layout_constraintEnd_toEndOf="@+id/imageView2"
                app:layout_constraintStart_toStartOf="@+id/imageView2"
                app:layout_constraintTop_toBottomOf="@+id/imageView2"
                style="@style/SbTextView.ListTitle.Highempasis.Bold"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/set_symbol_subtitle"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"
                style="@style/SbTextView.BodyDefault.MediumEmphasis"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/linearLayout"
                android:tag="binding_3"
                android:background="@drawable/border_green_button"
                android:padding="@dimen/item_gap_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_50"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_subtitle">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/imageView3"
                    android:layout_width="@dimen/height_16"
                    android:layout_height="@dimen/item_gap_16"
                    app:srcCompat="@drawable/ic_add_circle_outline"
                    app:tint="@color/green_text"/>
                <TextView
                    android:layout_gravity="center"
                    android:id="@+id/textView5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/stock_code"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/item_gap_9"
                    style="@style/SbTextView.BodyDefault.Green"/>
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/imageView4"
                    android:layout_width="@dimen/item_gap_6"
                    android:layout_height="@dimen/item_gap_12"
                    app:srcCompat="@drawable/ic_chevron_right"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/empty_list"
                android:tag="binding_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="imageView2,tv_title,tv_subtitle, linearLayout"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/not_empty_list"
                android:tag="binding_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="symbol_list,btn_set_symbol_noe_empty"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/linearLayout2"
        android:tag="binding_6"
        android:background="?attr/themeSeparatorGapColor"
        android:paddingTop="@dimen/item_gap_12"
        android:paddingBottom="@dimen/item_gap_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/item_gap_18"
        android:paddingEnd="@dimen/item_gap_18"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/checkBox"
            android:tag="binding_7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/bg_checkbox_square"
            android:layout_weight="0"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_12"
            android:id="@+id/tv_tnc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tnc_add_stock"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/item_gap_12"
            style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
