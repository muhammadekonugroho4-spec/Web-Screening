<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_chat_other_text_stream_preview_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:layout_width="@dimen/item_gap_null"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/item_gap_20"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/img_max_width">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/llc_content"
            android:tag="binding_1"
            android:background="@drawable/bg_bubble_chat_other_with_radius_14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/item_gap_xxs"
            app:layout_constraintBottom_toTopOf="@+id/time_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <include
                android:id="@+id/layout_chat_forwarded"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/item_gap_12"
                android:layout_marginVertical="@dimen/item_gap_6"
                layout="@layout/comp_chat_forwarded_other"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_stream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/item_gap_1">
                <com.stockbit.chat.component.ChatStreamPreviewView
                    android:id="@+id/ssp_stream"
                    android:tag="binding_2"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/v_stream_clickable"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="@dimen/item_gap_null"
                    android:foreground="?attr/selectableItemBackground"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColorLink="@color/stockbit_violet"
                android:gravity="start"
                android:id="@+id/actv_message"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_6"
                android:layout_marginBottom="@dimen/item_gap_10"
                android:textAlignment="gravity"
                android:layout_marginStart="@dimen/item_gap_12"
                android:layout_marginEnd="@dimen/item_gap_12"
                style="@style/SbTextView.BodyDefault.Link"/>
            <com.stockbit.chat.component.ChatBubbleTextView
                android:id="@+id/comp_text_chat"
                android:tag="binding_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/gray_text"
            android:layout_gravity="start|bottom"
            android:id="@+id/time_text"
            android:tag="binding_4"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_xs"
            android:layout_marginBottom="@dimen/text_size_12"
            android:layout_marginEnd="@dimen/item_gap_s"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@+id/llc_content"
            app:layout_constraintTop_toBottomOf="@+id/llc_content"
            style="@style/chat_timings"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@+id/fl_selected_layer"
        android:background="@drawable/bg_chat_selected"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
