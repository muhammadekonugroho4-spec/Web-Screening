<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <View
        android:id="@+id/v_comp_analyst_research_title_background"
        android:tag="layout/comp_analyst_research_view_0"
        android:background="?attr/themeColorPeriwinkleLow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_43"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_comp_analyst_research_title"
        android:tag="layout/comp_analyst_research_view_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_comp_analyst_research_title"
        android:layout_marginHorizontal="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="@+id/v_comp_analyst_research_title_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_comp_analyst_research_title_background"
        style="@style/TypeStyles.HeadingRegular"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/cl_comp_analyst_research_error"
        android:tag="layout/comp_analyst_research_view_2"
        android:paddingTop="@dimen/spacing_40"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/v_comp_analyst_research_title_background">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            app:srcCompat="?attr/themeIconCompanyAnalystEmptyState"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:layout_gravity="center"
            android:id="@+id/tv_comp_analyst_research_error_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:text="@string/tv_comp_analyst_research_error_title"
            style="@style/TypeStyles.BodyRegular"/>
        <LinearLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="?attr/themeIconRefresh"/>
            <TextView
                android:textColor="?attr/themeColorTextGreen"
                android:id="@+id/tv_comp_analyst_research_try_again"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tv_comp_analyst_research_try_again"
                android:layout_marginStart="@dimen/spacing_4"
                style="@style/TypeStyles.HeadingSmall"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_comp_analyst_research_content"
        android:tag="layout/comp_analyst_research_view_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_marginHorizontal="@dimen/spacing_20"
        app:layout_constraintTop_toBottomOf="@+id/v_comp_analyst_research_title_background"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:textColor="?attr/themeColorTextGreen"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_comp_analyst_research_read_less"
        android:tag="layout/comp_analyst_research_view_4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:text="@string/tv_comp_analyst_research_read_less"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_comp_analyst_research_content"
        style="@style/TypeStyles.BodyRegular"/>
</merge>
