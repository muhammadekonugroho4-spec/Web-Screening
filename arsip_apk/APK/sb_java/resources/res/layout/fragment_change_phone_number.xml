<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_change_phone_number_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stockbit.uikit.topbar.TopbarStockbitTitle
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:topBarTitleTitle="@string/personal_amend_title_change_phone_number"
        app:topBarType="CenterTitle"/>
    <ViewFlipper
        android:id="@+id/vf_current_phone"
        android:tag="binding_1"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_24"
        android:measureAllChildren="false"
        android:layout_marginStart="@dimen/spacing_20"
        android:layout_marginEnd="@dimen/spacing_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">
        <RelativeLayout
            android:id="@+id/ll_current_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center_horizontal"
                android:id="@+id/actv_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/personal_amend_text_current_phone_number"
                style="@style/TypeStyles.HeadingXSmall"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/actw_phone_number"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:layout_marginBottom="@dimen/personal_amend_change_phone_current_phone_margin"
                android:includeFontPadding="false"
                android:layout_below="@+id/actv_label"
                android:layout_marginEnd="@dimen/spacing_8"
                style="@style/TypeStyles.BodyRegular"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/aciv_replace"
                android:layout_width="@dimen/icon_placeholder_20"
                android:layout_height="@dimen/icon_placeholder_20"
                android:src="@drawable/ic_subs"
                android:tint="?attr/themeColorIconDefault"
                android:layout_below="@+id/actw_phone_number"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/personal_amend_text_change_to"
                android:layout_below="@+id/actw_phone_number"
                android:layout_marginStart="@dimen/spacing_4"
                android:layout_toEndOf="@+id/aciv_replace"
                style="@style/TypeStyles.HeadingRegular"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_empty_phone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/personal_amend_change_phone_empty_icon_size"
                android:layout_height="@dimen/personal_amend_change_phone_empty_icon_size"
                android:src="@drawable/ic_smartphone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/text_size_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:text="@string/text_preoa_new_phone_number"
                style="@style/SbTextView.BodyDefault.Bold"/>
            <TextView
                android:id="@+id/actv_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="@string/change_phone_your_phone_desc"
                style="@style/SbTextView.ListSubtitle.Highgray"/>
        </LinearLayout>
    </ViewFlipper>
    <com.stockbit.uikit.input.InputPhoneLine
        android:id="@+id/sfPhoneNumberNew"
        android:tag="binding_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:layout_marginStart="@dimen/spacing_20"
        android:layout_marginEnd="@dimen/spacing_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vf_current_phone"
        app:phoneHint="@string/personal_amend_hint_new_phone_number"
        app:phoneLabel="@string/personal_amend_label_new_phone_number"/>
    <com.stockbit.uikit.buttons.PrimaryButton
        android:id="@+id/slb_change_phone"
        android:tag="binding_4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        android:text="@string/personal_amend_button_save"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
