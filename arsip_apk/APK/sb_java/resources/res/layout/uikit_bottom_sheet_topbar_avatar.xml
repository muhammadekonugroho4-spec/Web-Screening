<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/top_bar_height">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/bottom_sheet_topbar_avatar_iv_avatar"
        android:layout_width="@dimen/uikit_bottomsheet_topbar_avatar_size"
        android:layout_height="@dimen/uikit_bottomsheet_topbar_avatar_size"
        android:adjustViewBounds="true"
        android:layout_marginStart="@dimen/spacing_20"
        app:shapeAppearanceOverlay="@style/UikitCircleImageView"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_12">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/themeColorTextPrimary"
                android:ellipsize="end"
                android:id="@+id/bottom_sheet_topbar_avatar_tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/TypeStyles.HeadingLarge"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/bottom_sheet_topbar_avatar_iv_title_right"
                android:layout_width="@dimen/icon_placeholder_16"
                android:layout_height="@dimen/icon_placeholder_16"
                android:layout_marginStart="@dimen/spacing_2"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/themeColorTextSecondary"
            android:ellipsize="end"
            android:id="@+id/bottom_sheet_topbar_avatar_tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/TypeStyles.BodyXXSmall"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
