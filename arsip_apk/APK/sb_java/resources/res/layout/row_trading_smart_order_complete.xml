<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_trading_smart_order_complete_0"
    android:paddingTop="@dimen/spacing_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/ORDER_18">
    <com.stockbit.uikit.control.ControlCheckbox
        android:layout_gravity="center"
        android:id="@+id/ccb_select_parent"
        android:visibility="gone"
        android:layout_width="@dimen/width_24"
        android:layout_height="@dimen/height_24"
        android:contentDescription="@string/ORDER_20"
        android:layout_marginStart="@dimen/spacing_20"
        app:checkBoxType="box"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_expand_collapse"
        android:visibility="visible"
        android:layout_width="@dimen/width_12"
        android:layout_height="@dimen/height_12"
        android:layout_marginTop="2dp"
        android:src="@drawable/uikit_ic_stockbit_text_field_chevron_down"
        android:layout_marginStart="@dimen/item_gap_7"
        android:layout_marginEnd="@dimen/item_gap_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_symbol_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="ccb_select_parent, ccb_select_child, iv_expand_collapse"/>
    <ImageView
        android:id="@+id/iv_child_line"
        android:visibility="gone"
        android:layout_width="6dp"
        android:layout_height="0dp"
        android:layout_marginTop="-2dp"
        android:layout_marginBottom="6dp"
        android:layout_marginEnd="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_symbol_child"
        app:layout_constraintEnd_toEndOf="@+id/iv_expand_collapse"
        app:layout_constraintTop_toBottomOf="@+id/iv_expand_collapse"/>
    <View
        android:id="@+id/view_click_parent"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_50"
        app:layout_constraintBottom_toBottomOf="@+id/tv_lot"
        app:layout_constraintEnd_toEndOf="@+id/rl_order_status"
        app:layout_constraintStart_toStartOf="@+id/tv_symbol"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol"/>
    <View
        android:id="@+id/view_click_smart_order"
        android:layout_width="@dimen/item_gap_45"
        android:layout_height="0dp"
        android:maxHeight="@dimen/item_gap_24"
        app:layout_constraintBottom_toBottomOf="@+id/tv_lot"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <View
        android:id="@+id/view_click_child"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_50"
        app:layout_constraintBottom_toBottomOf="@+id/tv_lot_child"
        app:layout_constraintEnd_toEndOf="@+id/rl_status_child"
        app:layout_constraintStart_toStartOf="@+id/tv_symbol_child"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol_child"/>
    <TextView
        android:id="@+id/tv_symbol"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ORDER_6"
        android:layout_marginStart="@dimen/spacing_8"
        android:layout_marginEnd="@dimen/spacing_8"
        android:paddingVertical="@dimen/spacing_2"
        app:layout_constraintEnd_toStartOf="@+id/tv_amount"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/barrier_symbol_start"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyXSmall"/>
    <TextView
        android:id="@+id/tv_lot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ORDER_7"
        app:layout_constraintEnd_toEndOf="@+id/tv_symbol"
        app:layout_constraintStart_toStartOf="@+id/tv_symbol"
        app:layout_constraintTop_toBottomOf="@+id/tv_symbol"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_amount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ORDER_8"
        android:textAlignment="textEnd"
        android:layout_marginEnd="@dimen/spacing_8"
        android:paddingVertical="@dimen/spacing_2"
        app:layout_constraintEnd_toStartOf="@+id/rl_order_status"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/tv_symbol"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol"
        style="@style/TypeStyles.BodyXSmall"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ORDER_9"
        app:layout_constraintEnd_toEndOf="@+id/tv_amount"
        app:layout_constraintStart_toStartOf="@+id/tv_amount"
        app:layout_constraintTop_toBottomOf="@+id/tv_amount"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
    <RelativeLayout
        android:id="@+id/rl_order_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/tv_amount"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol">
        <TextView
            android:id="@+id/tv_order_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/ORDER_10"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="@dimen/spacing_4"
            android:paddingVertical="@dimen/spacing_2"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.BodyXXSmall"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/text_size_10"
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="end"
        android:layout_gravity="end"
        android:id="@+id/tv_expiry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ORDER_11"
        android:textAlignment="textEnd"
        app:layout_constraintEnd_toEndOf="@+id/rl_order_status"
        app:layout_constraintStart_toStartOf="@+id/rl_order_status"
        app:layout_constraintTop_toBottomOf="@+id/rl_order_status"
        style="@style/TypeStyles.BodyXXSmall"/>
    <com.stockbit.uikit.control.ControlCheckbox
        android:layout_gravity="center"
        android:id="@+id/ccb_select_child"
        android:visibility="gone"
        android:layout_width="@dimen/width_24"
        android:layout_height="@dimen/height_24"
        android:contentDescription="@string/ORDER_20"
        android:layout_marginStart="@dimen/spacing_20"
        app:checkBoxType="box"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol_child"/>
    <TextView
        android:id="@+id/tv_symbol_child"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/height_24"
        android:layout_marginStart="@dimen/spacing_8"
        android:paddingVertical="@dimen/spacing_2"
        app:layout_constraintEnd_toEndOf="@+id/tv_symbol"
        app:layout_constraintStart_toEndOf="@+id/barrier_symbol_start"
        app:layout_constraintTop_toBottomOf="@+id/tv_lot"
        style="@style/TypeStyles.BodyXSmall"/>
    <TextView
        android:id="@+id/tv_lot_child"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/tv_symbol_child"
        app:layout_constraintStart_toStartOf="@+id/tv_symbol_child"
        app:layout_constraintTop_toBottomOf="@+id/tv_symbol_child"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_amount_child"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="textEnd"
        android:layout_marginEnd="@dimen/spacing_8"
        android:paddingVertical="@dimen/spacing_2"
        app:layout_constraintBottom_toBottomOf="@+id/tv_symbol_child"
        app:layout_constraintEnd_toStartOf="@+id/rl_order_status"
        app:layout_constraintStart_toStartOf="@+id/tv_amount"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol_child"
        style="@style/TypeStyles.BodyXSmall"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_price_child"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/tv_amount_child"
        app:layout_constraintStart_toStartOf="@+id/tv_amount_child"
        app:layout_constraintTop_toBottomOf="@+id/tv_amount_child"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
    <RelativeLayout
        android:id="@+id/rl_status_child"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_2"
        app:layout_constraintBottom_toBottomOf="@+id/tv_symbol_child"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/rl_order_status"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol_child">
        <TextView
            android:id="@+id/tv_order_status_child"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="@dimen/spacing_4"
            android:paddingVertical="@dimen/spacing_2"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.BodyXXSmall"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/text_size_10"
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="end"
        android:layout_gravity="end"
        android:id="@+id/tv_expiry_child"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="textEnd"
        app:layout_constraintEnd_toEndOf="@+id/rl_status_child"
        app:layout_constraintStart_toStartOf="@+id/rl_status_child"
        app:layout_constraintTop_toBottomOf="@+id/rl_status_child"
        style="@style/TypeStyles.BodyXXSmall"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_of_child"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:constraint_referenced_ids="tv_symbol_child, tv_lot_child, tv_amount_child, tv_price_child, rl_status_child, tv_expiry_child, view_click_child"/>
    <View
        android:id="@+id/spacer_content"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/spacing_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_expiry_child"/>
</androidx.constraintlayout.widget.ConstraintLayout>
