<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_parent_shareholder_number"
    android:tag="layout/comp_company_profile_shareholder_number_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_shareholder_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_24"
        android:text="@string/title_company_profile_number_shareholder"
        android:layout_marginStart="@dimen/item_gap_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingRegular"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_shareholder_number"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:nestedScrollingEnabled="false"
        android:layout_marginHorizontal="@dimen/item_gap_16"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/tv_shareholder_title"/>
    <View
        android:id="@+id/v_shareholder_number_separator"
        android:background="?attr/themeColorDividerThick"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_8"
        app:layout_constraintTop_toBottomOf="@+id/rv_shareholder_number"
        app:layout_goneMarginTop="@dimen/item_gap_20"/>
</androidx.constraintlayout.widget.ConstraintLayout>
