<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_user_share_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/item_gap_12">
    <ImageView
        android:id="@+id/iv_item_image"
        android:tag="binding_1"
        android:padding="@dimen/item_gap_4"
        android:layout_width="@dimen/width_58"
        android:layout_height="@dimen/height_58"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="@+id/iv_check"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_check"
        android:visibility="gone"
        android:layout_width="@dimen/clickable_size_18"
        android:layout_height="@dimen/clickable_size_18"
        android:layout_marginBottom="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_item_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_checked_circle"/>
    <TextView
        android:textSize="@dimen/text_size_10"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:tag="binding_2"
        android:paddingLeft="@dimen/item_gap_s"
        android:paddingRight="@dimen/item_gap_s"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_user_profile_verified_badge"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_item_image"
        style="@style/SbTextView.Caption.Highempasis"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_user_profile_verified_badge"
        android:tag="binding_3"
        android:layout_width="@dimen/item_gap_10"
        android:layout_height="@dimen/item_gap_10"
        android:scaleType="fitXY"
        android:contentDescription="@string/verified_account"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title"
        app:srcCompat="@drawable/ic_verified_green_white_24dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
