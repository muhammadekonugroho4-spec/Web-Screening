<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_screener_preset_empty_state_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="?attr/themeIconScreenerSavedNewEmptyState"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_24"
            android:text="@string/title_screener_preset_empty"
            style="@style/SbTextView.BodyDefault.Bold"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/highgray_light"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/message_screener_preset_empty"
            style="@style/SbTextView.BodyDefault"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
