<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_stream_general_post"
    android:tag="layout/comp_stream_general_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/stream_user_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_10"
        android:layout_marginStart="@dimen/spacing_20"
        layout="@layout/comp_stream_user_profile"/>
    <include
        android:id="@+id/stream_general_news"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_10"
        android:layout_marginHorizontal="@dimen/spacing_20"
        layout="@layout/comp_content_news"/>
    <TextView
        android:textSize="@dimen/stream_post_item_content_text_size"
        android:ellipsize="end"
        android:id="@+id/tv_stream_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_10"
        android:layout_marginHorizontal="@dimen/spacing_20"
        style="@style/TypeStyles.BodyLarge"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:id="@+id/tv_read_more_content"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_10"
        android:text="@string/button_read_more"
        android:layout_marginHorizontal="@dimen/spacing_20"
        style="@style/TypeStyles.BodyXSmall.Green"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/parent_stream_general_youtube_preview"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_10"
        app:cardCornerRadius="@dimen/item_gap_null"
        app:cardElevation="@dimen/item_gap_null">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/parent_stream_general_youtube_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_youtube_thumb"
                android:background="@drawable/bg_image_placeholder"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                app:layout_constraintDimensionRatio="v,16:9"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <ImageView
                android:id="@+id/iv_play_youtube"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_play_video"
                app:layout_constraintBottom_toBottomOf="@+id/iv_youtube_thumb"
                app:layout_constraintEnd_toEndOf="@+id/iv_youtube_thumb"
                app:layout_constraintStart_toStartOf="@+id/iv_youtube_thumb"
                app:layout_constraintTop_toTopOf="@+id/iv_youtube_thumb"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="?attr/themeSeparatorGapColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/item_gap_12"
                android:paddingVertical="@dimen/item_gap_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_youtube_thumb">
                <TextView
                    android:id="@+id/tv_youtube_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/item_gap_8"
                    style="@style/TypeStyles.HeadlineRegular"/>
                <TextView
                    android:id="@+id/tv_youtube_provider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/TypeStyles.BodyRegular"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/parent_stream_general_image"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_10"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="@dimen/item_gap_null"
        app:cardElevation="@dimen/item_gap_null">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/parent_stream_general_image_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="horizontal"
                android:id="@+id/rv_stream_images"
                android:tag="binding_2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.stockbit.common.uikit.TextIndicator
                android:id="@+id/ti_stream"
                android:background="@drawable/bg_text_indicator"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:alpha="0.8"
                android:layout_marginEnd="@dimen/spacing_8"
                android:paddingHorizontal="@dimen/spacing_8"
                android:paddingVertical="@dimen/spacing_4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/rv_stream_images"
                style="@style/TypeStyles.BodyXSmall"/>
            <ru.tinkoff.scrollingpagerindicator.ScrollingPagerIndicator
                android:layout_gravity="center_horizontal"
                android:id="@+id/dot_indicator_stream"
                android:tag="binding_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_stream_images"
                app:spi_dotColor="?attr/themeColorModalsBorder"
                app:spi_dotSelectedColor="@color/green_text"
                app:spi_dotSelectedSize="@dimen/clickable_size_4"
                app:spi_dotSize="@dimen/clickable_size_4"
                app:spi_dotSpacing="@dimen/item_gap_6"
                app:spi_visibleDotCount="5"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
        android:id="@+id/parent_stream_general_attachment"
        android:background="@drawable/bg_rounded_gray_transparent_bg"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_10"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:layout_marginHorizontal="@dimen/spacing_20"
        app:cardBackgroundColor="?attr/themeContentBackgroundStreamLastReply"
        app:cardCornerRadius="@dimen/shape_radius_m"
        app:cardElevation="@dimen/item_gap_null">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/clickable_size_32">
                <ImageView
                    android:id="@+id/iv_attachment_icon"
                    android:layout_width="@dimen/clickable_size_16"
                    android:layout_height="@dimen/clickable_size_16"
                    android:layout_marginStart="@dimen/item_gap_s"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_attach_file_black_24dp"/>
                <TextView
                    android:ellipsize="middle"
                    android:id="@+id/tv_download_content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:maxEms="9"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/item_gap_6"
                    android:layout_marginEnd="@dimen/item_gap_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_pdf_pages"
                    app:layout_constraintStart_toEndOf="@+id/iv_attachment_icon"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TypeStyles.BodyRegular"/>
                <TextView
                    android:id="@+id/tv_pdf_pages"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/item_gap_20"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1"
                    app:layout_constraintStart_toEndOf="@+id/tv_download_content"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TypeStyles.BodySmall"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:layout_gravity="center"
                android:id="@+id/rv_pdf_view"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/height_200"
                android:layout_marginBottom="@dimen/item_gap_10"
                android:layout_marginHorizontal="@dimen/item_gap_10"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <include
        android:id="@+id/stream_target_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_10"
        android:layout_marginHorizontal="@dimen/spacing_20"
        layout="@layout/comp_stream_target_price"/>
    <include
        android:id="@+id/stream_polling"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_10"
        android:layout_marginHorizontal="@dimen/spacing_20"
        layout="@layout/comp_stream_polling"/>
    <include
        android:id="@+id/stream_share_trade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_10"
        android:layout_marginHorizontal="@dimen/spacing_20"
        layout="@layout/comp_stream_share_trade"/>
    <include
        android:id="@+id/stream_reposted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_10"
        android:layout_marginHorizontal="@dimen/spacing_20"
        layout="@layout/comp_stream_reposted"/>
</LinearLayout>
