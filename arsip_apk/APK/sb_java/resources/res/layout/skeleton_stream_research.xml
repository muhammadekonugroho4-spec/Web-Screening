<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_16">
    <View
        android:id="@+id/v_research_image"
        android:layout_width="@dimen/stream_skeleton_research_width"
        android:layout_height="@dimen/stream_skeleton_research_height"
        android:layout_marginEnd="@dimen/spacing_20"
        app:layout_constraintBottom_toTopOf="@+id/v_border"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FBShimmerItem"/>
    <View
        android:id="@+id/v_research_title"
        android:layout_width="@dimen/stream_research_width_193"
        android:layout_height="@dimen/spacing_16"
        android:layout_marginStart="@dimen/spacing_20"
        app:layout_constraintBottom_toTopOf="@+id/v_research_desc"
        app:layout_constraintEnd_toStartOf="@+id/v_research_image"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_research_image"
        app:layout_constraintVertical_bias="0"
        style="@style/FBShimmerItem"/>
    <View
        android:id="@+id/v_research_desc"
        android:layout_width="@dimen/stream_research_width_133"
        android:layout_height="@dimen/height_16"
        android:layout_marginTop="@dimen/item_gap_8"
        android:layout_marginStart="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="@+id/v_research_image"
        app:layout_constraintEnd_toStartOf="@+id/v_research_image"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_research_title"
        style="@style/FBShimmerItem"/>
    <View
        android:id="@+id/v_border"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_8"
        android:layout_marginTop="@dimen/item_gap_20"
        android:backgroundTint="?attr/themeColorDividerThick"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_research_image"
        style="@style/FBShimmerItem"/>
</androidx.constraintlayout.widget.ConstraintLayout>
