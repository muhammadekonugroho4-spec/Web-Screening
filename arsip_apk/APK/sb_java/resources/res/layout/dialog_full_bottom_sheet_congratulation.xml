<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_full_bottom_sheet_congratulation_0"
    android:background="?attr/themeContentBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/confetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_fileName="lottie_anim_confetti.json"
        app:lottie_loop="false"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/imageViewCongratulation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/height_40"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/iconCongratulationState"/>
            <TextView
                android:textSize="@dimen/text_size_18"
                android:id="@+id/textViewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_14"
                android:text="@string/kode_referral_diaog_congratulation_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageViewCongratulation"
                style="@style/SbTextView.ListTitle"/>
            <TextView
                android:gravity="center"
                android:id="@+id/textViewDesc"
                android:layout_width="@dimen/item_gap_null"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_13"
                android:textAlignment="gravity"
                android:layout_marginStart="@dimen/item_gap_23"
                android:layout_marginEnd="@dimen/item_gap_23"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewTitle"
                style="@style/SbTextView.BodyDefault"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_null"
                android:layout_marginTop="@dimen/item_gap_44"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_default="wrap"
                app:layout_constraintHeight_max="@dimen/height_240"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewDesc"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/green_text"
            android:gravity="center"
            android:id="@+id/buttonAgreement"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/item_gap_10"
            android:text="@string/kode_referral_button_perjanjian"
            android:textAlignment="gravity"
            android:layout_marginStart="@dimen/item_gap_44"
            android:layout_marginEnd="@dimen/item_gap_44"
            app:layout_constraintBottom_toTopOf="@+id/buttonAmbilHadiah"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/SbTextView.BodyDefault"/>
        <Button
            android:id="@+id/buttonAmbilHadiah"
            android:background="@drawable/border_green_rounded"
            android:layout_marginBottom="@dimen/item_gap_23"
            android:text="@string/kode_referral_button_selesai"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/item_gap_20"
            app:layout_constraintBottom_toTopOf="@+id/footer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/SbBtn.PrimaryFullWidthFloating"/>
        <RelativeLayout
            android:gravity="center"
            android:layout_gravity="bottom"
            android:id="@+id/footer"
            android:background="?attr/themeColorExtendedGreen5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/item_gap_40"
            android:paddingVertical="@dimen/item_gap_30"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/text_dark_gray_2"
                android:gravity="center"
                android:id="@+id/textViewFooter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/kode_referral_info"
                android:textAlignment="gravity"
                style="@style/SbTextView.BodyDefault"/>
        </RelativeLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
