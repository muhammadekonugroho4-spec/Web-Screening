<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_stream_conversation_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_scrollFlags="enterAlways|scroll"
        app:titleTextAppearance="@style/SbTextView.PageTitle">
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_title"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            app:autoSizeTextType="none"
            style="@style/TypeStyles.HeadingLarge"/>
    </androidx.appcompat.widget.Toolbar>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:tag="binding_2"
            android:layout_width="@dimen/spacing_24"
            android:layout_height="@dimen/spacing_24"
            android:indeterminate="true"
            android:indeterminateBehavior="repeat"
            android:layout_centerInParent="true"
            android:progressTintMode="src_atop"
            android:progressBackgroundTintMode="src_atop"
            app:indicatorColor="?attr/themeSeparatorGapColorSecondary"
            app:indicatorSize="@dimen/spacing_24"
            app:trackColor="@color/green_text"
            app:trackThickness="2.5dp"/>
        <com.stockbit.stream.utils.pulltorefresh.PullRefreshLayout
            android:id="@+id/prl_refresh"
            android:tag="binding_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/rl_conversation_reply"
            app:progressSize="23"
            app:pullThreshold="60"
            app:topMargin="22">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_stream_conversation"
                android:tag="binding_4"
                android:background="?attr/themeColorSurfaceDefault"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </com.stockbit.stream.utils.pulltorefresh.PullRefreshLayout>
        <RelativeLayout
            android:gravity="bottom"
            android:id="@+id/rl_conversation_reply"
            android:background="?attr/themeColorSurfaceDefault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:animateLayoutChanges="true">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_post_preview"
                android:tag="binding_5"
                android:background="?attr/themeSeparatorGapColor"
                android:layout_width="match_parent"
                android:layout_height="88dp">
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_canvas_image_attachment"
                    android:tag="binding_6"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/item_gap_14"
                    android:layout_marginBottom="@dimen/item_gap_10"
                    android:layout_marginStart="@dimen/item_gap_l"
                    app:cardBackgroundColor="?attr/themeSeparatorGapColor"
                    app:cardCornerRadius="@dimen/shape_radius_m"
                    app:cardElevation="@dimen/item_gap_null"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_preview_image"
                        android:tag="binding_7"
                        android:focusable="false"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.cardview.widget.CardView>
                <androidx.appcompat.widget.AppCompatImageButton
                    android:layout_gravity="right"
                    android:id="@+id/ib_delete_image"
                    android:tag="binding_8"
                    android:background="@drawable/bg_circle_black"
                    android:padding="@dimen/item_gap_xs"
                    android:layout_width="@dimen/clickable_size_16"
                    android:layout_height="@dimen/clickable_size_16"
                    android:scaleType="fitCenter"
                    app:backgroundTint="@color/highgray_light"
                    app:layout_constraintBottom_toTopOf="@+id/card_canvas_image_attachment"
                    app:layout_constraintEnd_toEndOf="@+id/card_canvas_image_attachment"
                    app:layout_constraintStart_toEndOf="@+id/card_canvas_image_attachment"
                    app:layout_constraintTop_toTopOf="@+id/card_canvas_image_attachment"
                    app:srcCompat="0x7f08063f"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <RelativeLayout
                android:id="@+id/cl_post_previewRepliedContainer"
                android:tag="binding_9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/cl_post_preview">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:paddingTop="@dimen/item_gap_14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/rl_user_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/item_gap_20"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toLeftOf="@+id/cl_delete_quote"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textColor="?attr/titleTextColorHighgray"
                            android:id="@+id/tv_reply_comment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_comment_attach_reply_reference"
                            style="@style/SbTextView.Description"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textStyle="bold"
                            android:textColor="@color/green_text"
                            android:id="@+id/tv_reply_commentUsername"
                            android:tag="binding_10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/item_gap_xs"
                            android:layout_toEndOf="@+id/tv_reply_comment"
                            style="@style/SbTextView.Description"/>
                    </RelativeLayout>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:ellipsize="end"
                        android:id="@+id/tv_reply_comment_content"
                        android:tag="binding_11"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_xs"
                        android:maxLines="2"
                        android:layout_marginStart="@dimen/item_gap_20"
                        android:layout_marginEnd="@dimen/item_gap_m"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toLeftOf="@+id/iv_reply_comment_image"
                        app:layout_constraintTop_toBottomOf="@+id/rl_user_info"
                        app:layout_goneMarginBottom="@dimen/shape_radius_l"
                        app:layout_goneMarginTop="@dimen/shape_radius_l"
                        style="@style/SbTextView.Caption"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_reply_comment_image"
                        android:tag="binding_12"
                        android:visibility="gone"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/item_gap_s"
                        android:layout_marginBottom="@dimen/item_gap_s"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/hint_post_image"
                        android:layout_marginStart="@dimen/item_gap_m"
                        android:layout_marginEnd="@dimen/item_gap_m"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintDimensionRatio="v,1:1"
                        app:layout_constraintRight_toLeftOf="@+id/cl_delete_quote"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_delete_quote"
                        android:tag="binding_13"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/item_gap_10"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/item_gap_5"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/ib_delete_quote"
                            android:tag="binding_14"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:tint="?attr/themeContentBackgroundDeeper"
                            android:rotation="45"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ic_plus_rounded_corner"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </RelativeLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_document_attachment"
                android:tag="binding_15"
                android:background="@drawable/border_gray_rounded_full_outline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/clickable_size_48"
                android:layout_marginTop="@dimen/item_gap_m"
                android:layout_below="@+id/cl_post_previewRepliedContainer"
                android:layout_marginHorizontal="@dimen/item_gap_20">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_document_icon"
                    android:padding="@dimen/item_gap_l"
                    android:layout_width="@dimen/clickable_size_48"
                    android:layout_height="@dimen/clickable_size_48"
                    android:tint="?attr/themeIconTintColor"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_android_document"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="center_vertical"
                    android:id="@+id/tv_file_attachment"
                    android:tag="binding_16"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/clickable_size_48"
                    android:text="@string/btn_new_update_upload_docs"
                    android:textAlignment="gravity"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toRightOf="@+id/iv_document_icon"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/SbTextView.BodyDefault"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:textColor="@color/green_text"
                    android:id="@+id/btn_edit_file"
                    android:tag="binding_17"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:paddingLeft="@dimen/item_gap_l"
                    android:paddingRight="@dimen/item_gap_l"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/clickable_size_48"
                    android:minWidth="@dimen/clickable_size_48"
                    android:text="@string/btn_edit"
                    android:textAllCaps="false"
                    android:textAlignment="gravity"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/Base.Widget.AppCompat.Button.Borderless"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_send_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/cl_document_attachment"
                android:paddingEnd="@dimen/item_gap_4"
                android:layout_marginHorizontal="@dimen/item_gap_16"
                android:paddingVertical="@dimen/item_gap_12">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/ib_add_attachment"
                    android:tag="binding_18"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:focusable="false"
                    android:layout_width="@dimen/clickable_size_24"
                    android:layout_height="@dimen/clickable_size_24"
                    android:layout_marginBottom="7dp"
                    android:scaleType="center"
                    android:tint="@color/green_text"
                    app:layout_constraintBottom_toBottomOf="@+id/sset_comment"
                    app:layout_constraintStart_toStartOf="parent"
                    app:srcCompat="@drawable/ic_plus_rounded_corner"/>
                <com.stockbit.common.uikit.StockbitStreamEditText
                    android:textColor="?attr/themeColorTextPrimary"
                    android:textColorHint="?attr/themeColorTextTetriary"
                    android:gravity="center_vertical"
                    android:id="@+id/sset_comment"
                    android:tag="binding_19"
                    android:background="@drawable/bg_rounded_grey_with_border_and_radius_20"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="39dp"
                    android:hint="@string/placeholder_stream_comment"
                    android:maxLines="12"
                    android:inputType="textMultiLine"
                    android:dropDownWidth="match_parent"
                    android:dropDownAnchor="@+id/cl_send_message"
                    android:layout_marginStart="@dimen/item_gap_8"
                    android:paddingHorizontal="@dimen/item_gap_16"
                    android:paddingVertical="@dimen/item_gap_10"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ib_submit_comment"
                    app:layout_constraintStart_toEndOf="@+id/ib_add_attachment"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_goneMarginEnd="0dp"
                    style="@style/SbEditTextStyle.Medium.ChatInput"/>
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/ib_submit_comment"
                    android:tag="binding_20"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:focusable="false"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginBottom="2.5dp"
                    android:paddingStart="@dimen/item_gap_8"
                    android:paddingVertical="@dimen/item_gap_8"
                    app:layout_constraintBottom_toBottomOf="@+id/sset_comment"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:srcCompat="@drawable/selector_send"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:background="?attr/themeColorDividerThin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_xxxs"
                android:layout_alignParentTop="true"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:gravity="center_horizontal"
                android:id="@+id/tv_comment_limited"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/comment_limit_disabled"
                android:layout_below="@+id/cl_send_message"
                android:layout_marginVertical="@dimen/item_gap_22"
                style="@style/TypeStyles.ParagraphRegular"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/ll_post_not_found"
            android:tag="binding_21"
            android:background="?attr/themeColorSurfaceDefault"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/item_gap_200">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_error_logo"
                android:layout_width="@dimen/width_180"
                android:layout_height="135dp"
                android:layout_marginTop="@dimen/item_gap_24"
                app:srcCompat="?attr/themeIconPostNotFound"/>
            <TextView
                android:gravity="center_horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/stream_post_not_found"
                style="@style/TypeStyles.HeadingLarge"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_8"
                android:text="@string/stream_detail_post_not_found"
                android:layout_marginHorizontal="@dimen/item_gap_20"
                style="@style/TypeStyles.BodyRegular"/>
            <com.stockbit.uikit.buttons.PrimaryButton
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_previous_page"
                android:tag="binding_22"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_28"
                android:text="@string/stream_previous_page"
                android:paddingHorizontal="@dimen/item_gap_30"
                app:buttonRadius="@dimen/clickable_size_50"/>
        </LinearLayout>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/compose_view_emoji_reactions_dialog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
</LinearLayout>
