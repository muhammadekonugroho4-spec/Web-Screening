<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_parent_watchlist_filter"
    android:tag="layout/item_my_watchlist_filter_0"
    android:background="@drawable/half_top_border"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_20"
    android:paddingHorizontal="@dimen/spacing_20">
    <TextView
        android:id="@+id/tv_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="@dimen/spacing_8"
        android:text="@string/my_watchlist_filter"
        style="@style/TypeStyles.HeadingRegular"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_watchlist_filter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/item_gap_10">
        <TextView
            android:id="@+id/watchlist_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="test"
            android:layout_weight="1"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:id="@+id/tv_stock_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TypeStyles.BodyXSmall.Secondary"/>
        <com.stockbit.uikit.control.ControlCheckbox
            android:id="@+id/ccb_stock"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="@dimen/spacing_24"
            android:layout_height="@dimen/spacing_20"
            android:layout_marginStart="@dimen/spacing_12"
            app:checkBoxType="round"/>
    </LinearLayout>
    <com.stockbit.uikit.divider.SBDivider
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_1"/>
    <ProgressBar
        android:id="@+id/loading_watchlist"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_24"
        android:layout_marginTop="@dimen/spacing_8"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_error_watchlist"
        android:padding="@dimen/spacing_8"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:foregroundGravity="center">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_error_watchlist"
            android:layout_width="@dimen/height_20"
            android:layout_height="@dimen/height_20"
            app:srcCompat="@drawable/uikit_ic_stockbit_top_bar_reload"
            app:tint="@color/green_text"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/green_text"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_error_watchlist"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/btn_tap_to_reload"
            android:layout_marginStart="@dimen/item_gap_4"
            style="@style/TypeStyles.HeadingRegular"/>
    </LinearLayout>
    <View
        android:id="@+id/view_empty"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_16"/>
</LinearLayout>
