<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_personal_change_email_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stockbit.uikit.topbar.TopbarStockbitTitle
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:topBarTitleTitle="@string/title_change_email"
        app:topBarType="CenterTitle"/>
    <com.stockbit.uikit.input.TextFieldLine
        android:enabled="false"
        android:id="@+id/sf_current_email"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_24"
        android:layout_marginStart="@dimen/spacing_20"
        android:layout_marginEnd="@dimen/spacing_20"
        app:inputHint="Email belum terdaftar"
        app:inputLabel="@string/text_current_email"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/aciv_replace"
        android:layout_width="@dimen/icon_placeholder_20"
        android:layout_height="@dimen/icon_placeholder_20"
        android:layout_marginTop="@dimen/clickable_size_18"
        android:src="@drawable/ic_subs"
        android:tint="?attr/themeIconTintColor"
        android:layout_marginStart="@dimen/spacing_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sf_current_email"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_change"
        android:layout_marginStart="@dimen/spacing_4"
        app:layout_constraintBottom_toBottomOf="@+id/aciv_replace"
        app:layout_constraintStart_toEndOf="@+id/aciv_replace"
        app:layout_constraintTop_toTopOf="@+id/aciv_replace"
        style="@style/SbTextView.ListTitle.Highgray.Normal"/>
    <com.stockbit.uikit.input.TextFieldLine
        android:id="@+id/sf_email_new"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:inputType="textNoSuggestions"
        android:layout_marginStart="@dimen/spacing_20"
        android:layout_marginEnd="@dimen/spacing_20"
        android:importantForAutofill="noExcludeDescendants"
        app:inputHint="@string/placeholder_new_email"
        app:inputLabel="@string/text_new_email"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/aciv_replace"/>
    <com.stockbit.common.uikit.StockbitLoadingButton
        android:id="@+id/rl_save"
        android:tag="binding_3"
        android:background="@drawable/bg_selector_btn_green"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        app:buttonText="@string/button_save"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
