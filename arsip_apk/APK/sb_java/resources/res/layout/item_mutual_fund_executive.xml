<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:tag="layout/item_mutual_fund_executive_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/clickable_size_32">
    <TextView
        android:id="@+id/tv_executive_title"
        android:paddingLeft="@dimen/item_gap_l"
        android:paddingTop="@dimen/item_gap_s"
        android:paddingRight="@dimen/item_gap_l"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/SbTextView.BodyDefault.Bold"/>
    <TextView
        android:id="@+id/tv_executive_names"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_l"
        android:layout_marginTop="@dimen/item_gap_s"
        android:layout_marginRight="@dimen/item_gap_l"
        android:layout_below="@+id/tv_executive_title"
        style="@style/SbTextView.BodyDefault"/>
</RelativeLayout>
