<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/coordinatorLayout"
    android:tag="layout/fragment_forgot_pass_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/ivForgotPassIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_l"
            android:layout_marginTop="@dimen/item_gap_l"
            android:layout_marginRight="@dimen/item_gap_l"
            app:srcCompat="?attr/imgForgotPassword"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:id="@+id/tvForgotPasswordTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_l"
            android:layout_marginTop="@dimen/item_gap_l"
            android:layout_marginRight="@dimen/item_gap_l"
            android:layout_marginBottom="@dimen/item_gap_s"
            android:text="@string/title_forgot_password_search_account"
            android:layout_below="@+id/ivForgotPassIcon"
            style="@style/SbTextView.BodyDefault.Bold"/>
        <TextView
            android:id="@+id/tvForgotPasswordSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_l"
            android:layout_marginTop="@dimen/item_gap_s"
            android:layout_marginRight="@dimen/item_gap_l"
            android:layout_marginBottom="@dimen/item_gap_s"
            android:text="@string/text_forgot_password_search_account"
            android:layout_below="@+id/tvForgotPasswordTitle"
            style="@style/SbTextView.BodyDefault"/>
        <com.stockbit.uikit.input.InputTextFieldLine
            android:id="@+id/itfl_forgot_pass_email_address"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_l"
            android:layout_marginTop="@dimen/item_gap_l"
            android:layout_marginRight="@dimen/item_gap_l"
            android:layout_below="@+id/tvForgotPasswordSubtitle"
            android:importantForAutofill="no"
            app:textFieldHint="@string/text_forgot_password_input_email"
            app:textFieldInputType="textNoSuggestions"
            style="@style/Sb.Widget.TextInputEditText"/>
        <com.stockbit.uikit.buttons.StickyButton
            android:textColor="@color/white"
            android:id="@+id/btnForgotPassword"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_next"
            android:layout_alignParentBottom="true"
            android:lineHeight="@dimen/clickable_size_48"/>
    </RelativeLayout>
</androidx.core.widget.NestedScrollView>
