<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_round"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true">
    <RelativeLayout
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/popup_logout_headerWrapper"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:text="Preview Order"
                android:layout_centerHorizontal="true"
                style="@style/SbTextView.ListTitle"/>
        </RelativeLayout>
        <View
            android:background="@color/gray_border"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/popup_logout_headerWrapper"/>
        <RelativeLayout
            android:id="@+id/popup_logout_infoWrapper"
            android:paddingTop="10dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_below="@+id/popup_logout_headerWrapper"
            android:layout_centerHorizontal="true"
            android:paddingStart="10dp"
            android:paddingEnd="16dp">
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/layout_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/gray_text"
                    android:id="@+id/stockcode"
                    android:padding="6dp"
                    android:layout_width="@dimen/row_width_preview_trade"
                    android:layout_height="wrap_content"
                    android:text="Stock"
                    android:layout_alignParentStart="true"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:id="@+id/symbol"
                    android:padding="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/n_dash"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@+id/stockcode"
                    style="@style/SbTextView.BodyDefault"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/layout_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/layout_1">
                <TextView
                    android:textColor="@color/gray_text"
                    android:id="@+id/totalCost"
                    android:padding="6dp"
                    android:layout_width="@dimen/row_width_preview_trade"
                    android:layout_height="wrap_content"
                    android:text="Lot"
                    android:layout_alignParentStart="true"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:id="@+id/lot"
                    android:padding="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/n_dash"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@+id/totalCost"
                    style="@style/SbTextView.BodyDefault"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/layout_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/layout_2">
                <TextView
                    android:textColor="@color/gray_text"
                    android:id="@+id/totalPrice"
                    android:padding="6dp"
                    android:layout_width="@dimen/row_width_preview_trade"
                    android:layout_height="wrap_content"
                    android:text="Price"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:id="@+id/price"
                    android:padding="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/n_dash"
                    android:hint="@string/n_dash"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@+id/totalPrice"
                    style="@style/SbTextView.BodyDefault"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/layout_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/layout_3">
                <TextView
                    android:textColor="@color/gray_text"
                    android:id="@+id/totalLot"
                    android:padding="6dp"
                    android:layout_width="@dimen/row_width_preview_trade"
                    android:layout_height="wrap_content"
                    android:text="Sell Amount"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:id="@+id/sellAmount"
                    android:padding="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/n_dash"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@+id/totalLot"
                    style="@style/SbTextView.BodyDefault"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/layout_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/layout_4">
                <TextView
                    android:textColor="@color/gray_text"
                    android:id="@+id/t_profitloss"
                    android:padding="6dp"
                    android:layout_width="@dimen/row_width_preview_trade"
                    android:layout_height="wrap_content"
                    android:text="Profit Loss"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:id="@+id/profitLoss"
                    android:padding="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/n_dash"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@+id/t_profitloss"
                    style="@style/SbTextView.BodyDefault"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rlExpiryLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/layout_5">
                <TextView
                    android:textColor="@color/gray_text"
                    android:id="@+id/tvExpiryTitle"
                    android:padding="@dimen/item_gap_s"
                    android:layout_width="@dimen/row_width_preview_trade"
                    android:layout_height="wrap_content"
                    android:text="@string/trading_preview_expiry_title"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:id="@+id/tvExpiry"
                    android:padding="@dimen/item_gap_s"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/n_dash"
                    android:layout_marginStart="@dimen/item_gap_s"
                    android:layout_toEndOf="@+id/tvExpiryTitle"
                    style="@style/SbTextView.BodyDefault"/>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
