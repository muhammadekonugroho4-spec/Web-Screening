<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/dialog_key_stats_currency_0"
    android:background="@drawable/bg_top_rounded_16"
    android:paddingBottom="@dimen/spacing_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_20">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_idr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16">
        <ImageView
            android:layout_width="@dimen/width_24"
            android:layout_height="@dimen/height_24"
            app:srcCompat="?attr/themeIconFlagIndonesia30px"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/indonesian_rupiah_idr"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_10"
            style="@style/TypeStyles.BodyRegular"/>
        <ImageView
            android:id="@+id/iv_idr_check"
            android:layout_width="@dimen/width_24"
            android:layout_height="@dimen/width_24"
            android:layout_marginEnd="@dimen/item_gap_3"
            app:srcCompat="?attr/themeIconCheckboxRoundChecked"/>
        <ImageView
            android:id="@+id/iv_idr_uncheck"
            android:layout_width="@dimen/width_24"
            android:layout_height="@dimen/width_24"
            android:layout_marginEnd="@dimen/item_gap_3"
            app:srcCompat="?attr/themeIconCheckboxRoundUncheckedWithBorder"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_usd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_22">
        <ImageView
            android:layout_width="@dimen/width_24"
            android:layout_height="@dimen/height_24"
            app:srcCompat="?attr/themeIconFlagUS30px"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/united_states_dollar_usd"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_10"
            style="@style/TypeStyles.BodyRegular"/>
        <ImageView
            android:id="@+id/iv_usd_check"
            android:layout_width="@dimen/width_24"
            android:layout_height="@dimen/width_24"
            android:layout_marginEnd="@dimen/item_gap_3"
            app:srcCompat="?attr/themeIconCheckboxRoundChecked"/>
        <ImageView
            android:id="@+id/iv_usd_uncheck"
            android:layout_width="@dimen/width_24"
            android:layout_height="@dimen/width_24"
            android:layout_marginEnd="@dimen/item_gap_3"
            app:srcCompat="?attr/themeIconCheckboxRoundUncheckedWithBorder"/>
    </LinearLayout>
</LinearLayout>
