<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_parent"
    android:tag="layout/item_public_expose_cell_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/llc_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        android:paddingStart="0dp"
        android:paddingEnd="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/calendar_table_text_size"
            android:gravity="end"
            android:id="@+id/actv_date"
            android:tag="binding_1"
            android:layout_width="@dimen/company_date_width"
            android:layout_height="wrap_content"
            style="@style/SbTextView.ListTitle.Highempasis.Normal"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/calendar_table_text_size"
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/actv_time"
            android:tag="binding_2"
            android:layout_width="@dimen/company_time_width"
            android:layout_height="wrap_content"
            style="@style/SbTextView.ListTitle.Highempasis.Normal"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/calendar_table_text_size"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/actv_venue"
            android:tag="binding_3"
            android:layout_width="@dimen/company_venue_width"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_marginStart="@dimen/item_gap_40"
            style="@style/SbTextView.ListTitle.Highempasis.Normal"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:background="?attr/themeColorDividerThin"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/item_gap_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/llc_content"
        app:layout_constraintStart_toStartOf="@+id/llc_content"
        app:layout_constraintTop_toBottomOf="@+id/llc_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
