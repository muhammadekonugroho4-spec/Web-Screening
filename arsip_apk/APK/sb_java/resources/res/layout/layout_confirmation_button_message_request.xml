<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/lyt_confirmation_button"
    android:tag="layout/layout_confirmation_button_message_request_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <View
        android:background="?attr/themeColorDividerGreyBorder"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/lyt_button_delete"
        android:tag="binding_1"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/item_gap_23"
        app:layout_constraintEnd_toStartOf="@+id/lyt_button_accept"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_delete_16dp"/>
        <TextView
            android:textColor="?attr/themeColorTextButtonSecondaryRedActive"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_8"
            style="@style/TypeStyles.HeadingRegular"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/lyt_button_accept"
        android:tag="binding_3"
        android:background="?attr/selectableItemBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/item_gap_23"
        app:layout_constraintBottom_toBottomOf="@+id/lyt_button_delete"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/lyt_button_delete"
        app:layout_constraintTop_toTopOf="@+id/lyt_button_delete">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_check_16dp"
            app:tint="?attr/themeColorTextPrimary"/>
        <TextView
            android:textColor="?attr/themeColorTextButtonSecondaryNeutralActive"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_8"
            style="@style/TypeStyles.HeadingRegular"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
