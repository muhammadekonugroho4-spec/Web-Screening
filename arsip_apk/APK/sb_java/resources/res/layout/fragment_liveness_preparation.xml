<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_liveness_preparation_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarLiveness"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        app:layout_collapseMode="pin"
        app:layout_scrollFlags="enterAlways|scroll">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_add_bank_acc"
            style="@style/SbTextView.BodyDefault.Bold"/>
    </androidx.appcompat.widget.Toolbar>
    <ViewFlipper
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbarLiveness">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ScrollView
                android:paddingBottom="@dimen/clickable_size_48"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true">
                <RelativeLayout
                    android:tag="binding_2"
                    android:paddingBottom="@dimen/spacing_20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/ivLivenessIcon"
                        android:layout_width="@dimen/width_70"
                        android:layout_height="@dimen/height_70"
                        android:layout_marginTop="@dimen/item_gap_20"
                        android:src="?attr/themeIconLivenessPreparation"
                        android:layout_marginStart="@dimen/item_gap_20"
                        android:layout_marginEnd="@dimen/item_gap_20"/>
                    <TextView
                        android:textSize="@dimen/text_size_18"
                        android:id="@+id/tvVerificationTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_20"
                        android:layout_marginBottom="@dimen/item_gap_8"
                        android:text="@string/title_liveness_test"
                        android:layout_below="@+id/ivLivenessIcon"
                        android:layout_marginStart="@dimen/item_gap_20"
                        android:layout_marginEnd="@dimen/item_gap_20"
                        style="@style/TypeStyles.HeadlineRegular"/>
                    <TextView
                        android:textColor="@color/highgray_light"
                        android:id="@+id/tvSVerificationContent"
                        android:tag="binding_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/item_gap_20"
                        android:layout_below="@+id/tvVerificationTitle"
                        android:layout_marginStart="@dimen/item_gap_20"
                        android:layout_marginEnd="@dimen/item_gap_20"
                        style="@style/TypeStyles.BodyRegular"/>
                    <include layout="@layout/fragment_liveness_instruction"/>
                </RelativeLayout>
            </ScrollView>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/spacing_20">
                <ImageView
                    android:layout_width="@dimen/width_160"
                    android:layout_height="@dimen/height_120"
                    android:layout_marginBottom="@dimen/spacing_20"
                    android:src="?attr/themeIconSuccessAmendBank"/>
                <TextView
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_12"
                    android:text="@string/title_liveness_test_success"
                    style="@style/TypeStyles.HeadlineRegular"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_liveness_success_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TypeStyles.BodyRegular"/>
            </LinearLayout>
            <com.stockbit.uikit.button.PrimaryButton
                android:id="@+id/btnBackToHompegae"
                android:layout_width="match_parent"
                android:layout_height="@dimen/clickable_size_48"
                android:layout_margin="@dimen/spacing_20"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:text="@string/button_back_homepage"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:paddingTop="@dimen/item_gap_20"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ScrollView
                android:paddingBottom="@dimen/clickable_size_48"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:tag="binding_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/ivLivenessFailed"
                        android:layout_width="@dimen/avatar_size_l"
                        android:layout_height="@dimen/avatar_size_l"
                        android:layout_marginBottom="@dimen/item_gap_34"
                        android:layout_marginStart="@dimen/item_gap_20"
                        android:layout_marginEnd="@dimen/item_gap_20"
                        app:srcCompat="@drawable/ic_liveness_failed"/>
                    <TextView
                        android:id="@+id/tvLivenessFailedTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/item_gap_10"
                        android:text="@string/title_liveness_test_unsuccess"
                        android:layout_marginStart="@dimen/item_gap_20"
                        android:layout_marginEnd="@dimen/item_gap_20"
                        style="@style/SbTextView.PageTitle"/>
                    <TextView
                        android:gravity="center"
                        android:id="@+id/tvLivenessFailedSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/item_gap_16"
                        android:text="@string/text_liveness_test_limit_day"
                        android:layout_marginStart="@dimen/item_gap_20"
                        android:layout_marginEnd="@dimen/item_gap_20"
                        style="@style/SbTextView.BodySecondary"/>
                    <include
                        android:id="@+id/liveness_instruction"
                        layout="@layout/fragment_liveness_instruction"/>
                </LinearLayout>
            </ScrollView>
        </RelativeLayout>
    </ViewFlipper>
    <com.stockbit.common.uikit.StockbitLoadingButton
        android:id="@+id/btnStartLiveness"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        android:layout_marginBottom="@dimen/spacing_20"
        android:text="@string/button_liveness_test_start"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/spacing_20"/>
</RelativeLayout>
