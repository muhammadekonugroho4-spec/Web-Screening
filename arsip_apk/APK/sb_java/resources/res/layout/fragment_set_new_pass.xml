<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_set_new_pass_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/settingCreateNewPassToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_scrollFlags="enterAlways|scroll">
        <TextView
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/personal_amend_title_create_password"
            style="@style/SbTextView.PageTitle"/>
    </androidx.appcompat.widget.Toolbar>
    <View
        android:id="@+id/view"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        app:layout_constraintTop_toBottomOf="@+id/settingCreateNewPassToolbar"/>
    <ProgressBar
        android:id="@+id/progress"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-7dp"
        android:layout_marginBottom="-7dp"
        android:indeterminate="true"
        app:layout_constraintTop_toBottomOf="@+id/view"
        style="?android:attr/progressBarStyleHorizontal"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/progress">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rlChangePassApp"
                android:background="@color/fifty_percent_transparency_grey_400"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ProgressBar
                    android:id="@+id/progressChangePassApp"
                    android:visibility="visible"
                    android:layout_width="@dimen/clickable_size_32"
                    android:layout_height="@dimen/clickable_size_32"
                    android:indeterminate="true"
                    android:layout_centerInParent="true"
                    style="@style/Widget.AppCompat.ProgressBar"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_m"
                    android:text="@string/loading"
                    android:layout_below="@+id/progressChangePassApp"
                    android:layout_centerInParent="true"
                    style="@style/SbTextView.BodyDefault"/>
            </RelativeLayout>
            <ImageView
                android:id="@+id/iv_register_password_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_36"
                android:layout_marginStart="@dimen/clickable_size_16"
                android:layout_marginEnd="@dimen/clickable_size_16"
                app:srcCompat="?attr/imgRegisterPassword"/>
            <TextView
                android:id="@+id/tv_register_password_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_marginBottom="@dimen/item_gap_s"
                android:text="@string/personal_amend_title_create_password"
                android:layout_below="@+id/iv_register_password_icon"
                android:layout_marginStart="@dimen/clickable_size_16"
                android:layout_marginEnd="@dimen/clickable_size_16"
                style="@style/TypeStyles.HeadlineRegular"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:id="@+id/tv_register_password_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_10"
                android:layout_marginBottom="@dimen/item_gap_s"
                android:text="@string/personal_amend_subtitle_create_password"
                android:layout_below="@+id/tv_register_password_title"
                android:layout_marginStart="@dimen/clickable_size_16"
                android:layout_marginEnd="@dimen/clickable_size_16"
                style="@style/TypeStyles.BodyRegular"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/tv_register_password_subtitle">
                <com.stockbit.uikit.input.InputTextFieldLine
                    android:id="@+id/sbfp_password"
                    android:tag="binding_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_30"
                    android:layout_marginStart="@dimen/clickable_size_16"
                    android:layout_marginEnd="@dimen/clickable_size_16"
                    app:textFieldHint="@string/personal_amend_hint_input_password"
                    app:textFieldInputType="textPassword"
                    app:textFieldLabel="@string/personal_amend_label_create_password"/>
                <com.stockbit.uikit.input.InputTextFieldLine
                    android:id="@+id/sbfp_password_confirmation"
                    android:tag="binding_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_20"
                    android:layout_marginStart="@dimen/clickable_size_16"
                    android:layout_marginEnd="@dimen/clickable_size_16"
                    app:textFieldHint="@string/personal_amend_label_confirm_password"
                    app:textFieldInputType="textPassword"
                    app:textFieldLabel="@string/personal_amend_hint_input_confirm_password"/>
            </LinearLayout>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
    <com.stockbit.uikit.buttons.StickyButton
        android:id="@+id/rl_register_password"
        android:tag="binding_4"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        android:layout_marginTop="@dimen/item_gap_45"
        android:text="@string/button_next"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
