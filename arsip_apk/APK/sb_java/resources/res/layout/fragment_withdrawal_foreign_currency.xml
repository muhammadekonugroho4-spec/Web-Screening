<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_withdrawal_foreign_currency_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/setting_activity_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:layout_scrollFlags="enterAlways|scroll">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_withdrawal"
            style="@style/TypeStyles.HeadingLarge"/>
    </androidx.appcompat.widget.Toolbar>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/clickable_size_56"
        android:fillViewport="true"
        android:layout_below="@+id/setting_activity_toolbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/item_gap_20">
            <TextView
                android:textColor="?attr/themeColorTextPrimary"
                android:id="@+id/tv_transfer_title_currency_foreign"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_32"
                android:text="@string/setting_transfer_to_foreign"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.HeadingRegular"/>
            <RelativeLayout
                android:id="@+id/rl_withdrawal_account_currency"
                android:background="@drawable/bg_rounded_4_transparent_colorborder"
                android:padding="@dimen/item_gap_16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_transfer_title_currency_foreign">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_rdn_bank_currency"
                    android:tag="binding_1"
                    android:layout_width="@dimen/width_40"
                    android:layout_height="@dimen/height_40"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textColor="?attr/themeColorTextPrimary"
                    android:id="@+id/tv_rdn_bank_name_currency"
                    android:tag="binding_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/item_gap_16"
                    android:layout_toEndOf="@+id/iv_rdn_bank_currency"
                    style="@style/TypeStyles.BodyXSmall"/>
                <ImageView
                    android:id="@+id/tv_indicator_dot"
                    android:layout_width="@dimen/item_gap_10"
                    android:layout_height="@dimen/item_gap_10"
                    android:layout_alignTop="@+id/tv_rdn_bank_name_currency"
                    android:layout_alignBottom="@+id/tv_rdn_bank_name_currency"
                    android:layout_marginStart="@dimen/item_gap_4"
                    android:layout_toEndOf="@+id/tv_rdn_bank_name_currency"
                    app:srcCompat="0x7f0803bc"
                    app:tint="?attr/themeColorTextPrimary"/>
                <TextView
                    android:textColor="?attr/themeColorTextPrimary"
                    android:id="@+id/tv_rdn_bank_country_currency"
                    android:tag="binding_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/item_gap_4"
                    android:layout_toEndOf="@+id/tv_indicator_dot"
                    style="@style/TypeStyles.BodyXSmall"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:id="@+id/tv_rdn_number_currency"
                    android:tag="binding_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_2"
                    android:layout_toRightOf="@+id/iv_rdn_bank_currency"
                    android:layout_below="@+id/tv_rdn_bank_name_currency"
                    android:layout_marginStart="@dimen/item_gap_16"
                    style="@style/TypeStyles.HeadingRegular"/>
                <TextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:id="@+id/tv_rdn_name_currency"
                    android:tag="binding_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_2"
                    android:layout_below="@+id/tv_rdn_number_currency"
                    android:textAllCaps="false"
                    android:layout_marginStart="@dimen/item_gap_16"
                    android:layout_marginEnd="@dimen/item_gap_16"
                    android:layout_toEndOf="@+id/iv_rdn_bank_currency"
                    style="@style/TypeStyles.BodyXSmall"/>
            </RelativeLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/themeColorTextPrimary"
                android:id="@+id/tv_title_destination_currency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_32"
                android:text="@string/text_title_option_currency_withdraw"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rl_withdrawal_account_currency"
                style="@style/TypeStyles.HeadingRegular"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_option_currency"
                android:background="@drawable/bg_box_default"
                android:padding="@dimen/item_gap_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_8"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_destination_currency"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_warning_destination_currency"
                android:background="@drawable/bg_periwinkle_rounded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_8"
                android:text="@string/text_desc_warning_destination_currency"
                android:paddingHorizontal="@dimen/item_gap_12"
                android:paddingVertical="@dimen/item_gap_8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_option_currency"
                style="@style/TypeStyles.BodyXSmall"/>
            <TextView
                android:textColor="?attr/themeColorTextPrimary"
                android:id="@+id/tv_title_swift_code_currency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_32"
                android:text="@string/deposit_swift_code_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_warning_destination_currency"
                style="@style/TypeStyles.HeadingRegular"/>
            <RelativeLayout
                android:id="@+id/rl_swift_code"
                android:background="@drawable/bg_box_default"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_swift_code_currency">
                <androidx.appcompat.widget.AppCompatEditText
                    android:textSize="@dimen/text_size_14"
                    android:id="@+id/et_swift_code_withdraw_foreign"
                    android:tag="binding_6"
                    android:background="@null"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/text_input_swift_code"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:paddingStart="@dimen/item_gap_12"
                    android:paddingVertical="@dimen/item_gap_16"
                    style="@style/SbEditTextStyle"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_error_swift_code"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/rl_swift_code">
                <ImageView
                    android:id="@+id/iv_warning"
                    android:layout_width="@dimen/width_16"
                    android:layout_height="@dimen/height_16"
                    android:src="@drawable/ic_warning_red"
                    android:layout_centerVertical="true"/>
                <TextView
                    android:textColor="?attr/themeColorTextRed"
                    android:id="@+id/tv_withdrawal_swift_code_error"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/text_error_swift_code"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/item_gap_6"
                    android:layout_toEndOf="@+id/iv_warning"
                    style="@style/TypeStyles.BodyXSmall"/>
            </RelativeLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_warning_swift_code"
                android:background="@drawable/bg_periwinkle_rounded"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_8"
                android:text="@string/text_desc_warning_swift_code"
                android:paddingHorizontal="@dimen/item_gap_12"
                android:paddingVertical="@dimen/item_gap_8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rl_error_swift_code"
                style="@style/TypeStyles.BodyXSmall"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <Button
        android:textColor="@color/white"
        android:id="@+id/btn_next"
        android:tag="binding_7"
        android:background="@drawable/bg_selector_btn_green"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        android:text="@string/button_next"
        android:layout_alignParentBottom="true"
        android:textAllCaps="false"
        style="@style/TypeStyles.HeadingRegular"/>
</RelativeLayout>
