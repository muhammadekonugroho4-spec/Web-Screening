<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/comp_blur_comparison_metrics_group_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_blur_metric_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/item_gap_20"
        android:paddingVertical="@dimen/item_gap_16">
        <TextView
            android:textColor="?attr/themeColorTextPrimary"
            android:id="@+id/tv_metric_group_name"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingRegular"/>
        <ImageView
            android:id="@+id/iv_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f080621"
            android:rotation="180"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/themeIconTintColor"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.stockbit.uikit.divider.SBDivider
        android:id="@+id/divider_separator_metric_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dividerVariant="thin_grey"/>
</LinearLayout>
