<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_history_trading_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stateListAnimator="@null">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/ctl_search_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="exitUntilCollapsed|scroll"
            app:titleEnabled="false">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/parent_search_history_all"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_5">
                <EditText
                    android:gravity="center_vertical"
                    android:id="@+id/et_search_input"
                    android:background="@drawable/bg_border_gray_rounded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/item_gap_34"
                    android:hint="@string/history_search_stock_or_action"
                    android:layout_centerVertical="true"
                    android:inputType="textCapCharacters"
                    android:imeOptions="actionDone"
                    android:paddingStart="@dimen/clickable_size_32"
                    android:paddingEnd="@dimen/clickable_size_24"
                    android:layout_marginStart="@dimen/spacing_16"
                    android:layout_marginEnd="@dimen/spacing_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/SbEditTextStyle.SearchHistory"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_history_search_button"
                    android:padding="@dimen/item_gap_xs"
                    android:layout_width="@dimen/clickable_size_20"
                    android:layout_height="@dimen/clickable_size_20"
                    android:scaleType="fitCenter"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/hint_search_content"
                    android:layout_marginStart="@dimen/spacing_6"
                    app:layout_constraintBottom_toBottomOf="@+id/et_search_input"
                    app:layout_constraintStart_toStartOf="@+id/et_search_input"
                    app:layout_constraintTop_toTopOf="@+id/et_search_input"
                    app:srcCompat="@drawable/ic_android_search"
                    app:tint="@color/highgray_light"/>
                <ImageView
                    android:id="@+id/ib_clear_query_search"
                    android:padding="@dimen/item_gap_xxs"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="fitCenter"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/hint_clear_search_text"
                    android:layout_marginEnd="@dimen/spacing_6"
                    android:layout_alignParentEnd="true"
                    app:layout_constraintBottom_toBottomOf="@+id/et_search_input"
                    app:layout_constraintEnd_toEndOf="@+id/et_search_input"
                    app:layout_constraintTop_toTopOf="@+id/et_search_input"
                    app:srcCompat="@drawable/ic_close_outline"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
        <FrameLayout
            android:id="@+id/fl_history_header"
            android:tag="binding_1"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_48">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/header_stock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="@dimen/spacing_20"
                android:paddingEnd="@dimen/spacing_16">
                <TextView
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_header_action"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="match_parent"
                    android:text="@string/trade_title_action"
                    app:layout_constraintEnd_toStartOf="@+id/tv_header_amount"
                    app:layout_constraintHorizontal_weight="40.9"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <TextView
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_header_amount"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="match_parent"
                    android:text="@string/trade_title_amount"
                    app:layout_constraintEnd_toStartOf="@+id/tv_header_price"
                    app:layout_constraintHorizontal_weight="37.2"
                    app:layout_constraintStart_toEndOf="@+id/tv_header_action"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <TextView
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_header_price"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="match_parent"
                    android:text="@string/trade_title_price"
                    android:textAlignment="gravity"
                    app:layout_constraintEnd_toStartOf="@+id/tv_header_date"
                    app:layout_constraintHorizontal_weight="21.9"
                    app:layout_constraintStart_toEndOf="@+id/tv_header_amount"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <TextView
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_header_date"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:minWidth="65dp"
                    android:text="@string/trade_title_date"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/tv_header_price"
                    style="@style/TypeStyles.BodyXXSmall"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <ViewFlipper
        android:id="@+id/vf_main_history"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/sfl_all_history_loading"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/FBShimmerFrameLayout">
            <LinearLayout
                android:orientation="vertical"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include layout="@layout/skeleton_item_history_stockbit"/>
                <include layout="@layout/skeleton_item_history_stockbit"/>
                <include layout="@layout/skeleton_item_history_stockbit"/>
                <include layout="@layout/skeleton_item_history_stockbit"/>
                <include layout="@layout/skeleton_item_history_stockbit"/>
                <include layout="@layout/skeleton_item_history_stockbit"/>
                <include layout="@layout/skeleton_item_history_stockbit"/>
                <include layout="@layout/skeleton_item_history_stockbit"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/srl_data_trading_history"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_all_history"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:scrollbars="none"
                    android:clickable="true"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        </RelativeLayout>
        <include
            android:layout_gravity="center"
            android:id="@+id/view_network_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/comp_error_no_connection_view"/>
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/srl_all_history_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/nsv_all_history_stockbit"
                android:tag="binding_4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">
                <include
                    android:id="@+id/empty_history"
                    layout="@layout/comp_empty_data_trading_stockbit_history"/>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_search_suggest"
                android:focusable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:isScrollContainer="false"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_icon_not_found"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="?attr/themeIconEmptySearch"/>
            <TextView
                android:textSize="@dimen/text_size_13"
                android:textColor="?attr/themeColorTextSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/msg_no_results_found"/>
        </LinearLayout>
    </ViewFlipper>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
