<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/spacing_16">
    <View
        android:id="@+id/view_company_profile_search"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_32"
        android:layout_marginTop="@dimen/item_gap_20"
        android:backgroundTint="?attr/themeShimmer"
        android:layout_marginHorizontal="@dimen/spacing_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_company_profile_avatar"
        android:background="@drawable/ic_circle_grey"
        android:layout_width="@dimen/item_gap_40"
        android:layout_height="@dimen/item_gap_40"
        android:layout_marginTop="@dimen/height_42"
        android:layout_marginStart="@dimen/spacing_16"
        android:backgroundTint="?attr/themeShimmer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_company_profile_search"/>
    <View
        android:id="@+id/view_company_profile_title"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="220dp"
        android:layout_height="@dimen/item_gap_12"
        android:layout_marginStart="@dimen/item_gap_13"
        android:backgroundTint="?attr/themeShimmer"
        app:layout_constraintStart_toEndOf="@+id/view_company_profile_avatar"
        app:layout_constraintTop_toTopOf="@+id/view_company_profile_avatar"/>
    <View
        android:id="@+id/view_company_profile_desc"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="80dp"
        android:layout_height="@dimen/item_gap_12"
        android:layout_marginTop="@dimen/item_gap_12"
        android:layout_marginStart="@dimen/item_gap_13"
        android:backgroundTint="?attr/themeShimmer"
        app:layout_constraintStart_toEndOf="@+id/view_company_profile_avatar"
        app:layout_constraintTop_toBottomOf="@+id/view_company_profile_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
