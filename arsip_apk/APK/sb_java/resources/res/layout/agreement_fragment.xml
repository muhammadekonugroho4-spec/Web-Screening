<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/agreement_fragment_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/themeContentBackground"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/settingActivityToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_collapseMode="pin"
            app:layout_scrollFlags="enterAlways|scroll">
            <TextView
                android:textSize="@dimen/text_size_16"
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/SbTextView.BodyDefault.Bold"/>
        </androidx.appcompat.widget.Toolbar>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/progress"
                android:layout_width="@dimen/clickable_size_32"
                android:layout_height="@dimen/clickable_size_32"
                android:indeterminate="true"
                android:layout_centerInParent="true"
                android:indeterminateTint="@color/green_text"
                style="@style/Widget.AppCompat.ProgressBar"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/agreementContainer"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/imageViewTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_23"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_disclaimer"/>
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:gravity="center"
                    android:id="@+id/textViewTitleAgreement"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_23"
                    android:text="@string/kode_referral_disclaimer_title"
                    android:layout_marginStart="@dimen/item_gap_24"
                    android:layout_marginEnd="@dimen/height_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/imageViewTitle"
                    style="@style/SbTextView.PageHeadline"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/textViewAgreement"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_18"
                    app:layout_constraintEnd_toEndOf="@+id/textViewTitleAgreement"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toStartOf="@+id/textViewTitleAgreement"
                    app:layout_constraintTop_toBottomOf="@+id/textViewTitleAgreement"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/textViewAgreementName"
                    android:layout_width="@dimen/avatar_size_xxxl"
                    android:layout_height="wrap_content"
                    android:text="Nama"
                    app:layout_constraintStart_toStartOf="@+id/textViewAgreement"
                    app:layout_constraintTop_toBottomOf="@+id/textViewAgreement"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/textViewAgreementNameValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@+id/textViewAgreementName"
                    app:layout_constraintTop_toBottomOf="@+id/textViewAgreement"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/textViewAgreementCustomerCode"
                    android:layout_width="@dimen/avatar_size_xxxl"
                    android:layout_height="wrap_content"
                    android:text="Kode Nasabah"
                    app:layout_constraintStart_toStartOf="@+id/textViewAgreement"
                    app:layout_constraintTop_toBottomOf="@+id/textViewAgreementName"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:textStyle="bold"
                    android:id="@+id/textViewAgreementCustomerCodevalue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@+id/textViewAgreementCustomerCode"
                    app:layout_constraintTop_toBottomOf="@+id/textViewAgreementNameValue"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/textViewAgreementAccoutNumber"
                    android:layout_width="@dimen/avatar_size_xxxl"
                    android:layout_height="wrap_content"
                    android:text="No. Rekening"
                    app:layout_constraintStart_toStartOf="@+id/textViewAgreementCustomerCode"
                    app:layout_constraintTop_toBottomOf="@+id/textViewAgreementCustomerCode"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/textViewAgreementAccoutNumberValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@+id/textViewAgreementAccoutNumber"
                    app:layout_constraintTop_toBottomOf="@+id/textViewAgreementCustomerCodevalue"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/textViewAgreementSID"
                    android:layout_width="@dimen/avatar_size_xxxl"
                    android:layout_height="wrap_content"
                    android:text="No. SID"
                    app:layout_constraintStart_toStartOf="@+id/textViewAgreementAccoutNumber"
                    app:layout_constraintTop_toBottomOf="@+id/textViewAgreementAccoutNumber"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/textViewAgreementSIDValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@+id/textViewAgreementSID"
                    app:layout_constraintTop_toBottomOf="@+id/textViewAgreementAccoutNumberValue"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/tVDescTitle"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="@string/kode_referral_agreement_sub_title"
                    app:layout_constraintEnd_toEndOf="@+id/textViewAgreement"
                    app:layout_constraintStart_toStartOf="@+id/textViewAgreement"
                    app:layout_constraintTop_toBottomOf="@+id/textViewAgreementSID"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/tVNo1"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="1. "
                    app:layout_constraintEnd_toStartOf="@+id/tVDesc2"
                    app:layout_constraintStart_toStartOf="@+id/textViewAgreement"
                    app:layout_constraintTop_toBottomOf="@+id/tVDescTitle"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/tVDesc1"
                    android:paddingBottom="@dimen/item_gap_xs"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="@+id/textViewAgreement"
                    app:layout_constraintStart_toEndOf="@+id/tVNo1"
                    app:layout_constraintTop_toBottomOf="@+id/tVDescTitle"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/tVNo2"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="2. "
                    app:layout_constraintStart_toStartOf="@+id/textViewAgreement"
                    app:layout_constraintTop_toBottomOf="@+id/tVDesc1"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/tVDesc2"
                    android:paddingBottom="@dimen/item_gap_xs"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="@string/kode_referral_agreement_no_2"
                    app:layout_constraintEnd_toEndOf="@+id/textViewAgreement"
                    app:layout_constraintStart_toEndOf="@+id/tVNo2"
                    app:layout_constraintTop_toBottomOf="@+id/tVDesc1"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/tVNo3"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="3. "
                    app:layout_constraintStart_toStartOf="@+id/textViewAgreement"
                    app:layout_constraintTop_toBottomOf="@+id/tVDesc2"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/tVDesc3"
                    android:paddingBottom="@dimen/item_gap_xs"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="@string/kode_referral_agreement_no_3"
                    app:layout_constraintEnd_toEndOf="@+id/textViewAgreement"
                    app:layout_constraintStart_toEndOf="@+id/tVNo3"
                    app:layout_constraintTop_toBottomOf="@+id/tVDesc2"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/tVNo4"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="4. "
                    app:layout_constraintStart_toStartOf="@+id/textViewAgreement"
                    app:layout_constraintTop_toBottomOf="@+id/tVDesc3"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/tVDesc4"
                    android:paddingBottom="@dimen/item_gap_xs"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="@string/kode_referral_agreement_no_4"
                    app:layout_constraintEnd_toEndOf="@+id/textViewAgreement"
                    app:layout_constraintStart_toEndOf="@+id/tVNo4"
                    app:layout_constraintTop_toBottomOf="@+id/tVDesc3"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/tVNo5"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="5. "
                    app:layout_constraintStart_toStartOf="@+id/textViewAgreement"
                    app:layout_constraintTop_toBottomOf="@+id/tVDesc4"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/tVDesc5"
                    android:paddingBottom="@dimen/item_gap_xs"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="@string/kode_referral_agreement_no_5"
                    app:layout_constraintEnd_toEndOf="@+id/textViewAgreement"
                    app:layout_constraintStart_toEndOf="@+id/tVNo5"
                    app:layout_constraintTop_toBottomOf="@+id/tVDesc4"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/tVNo6"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="6. "
                    app:layout_constraintStart_toStartOf="@+id/textViewAgreement"
                    app:layout_constraintTop_toBottomOf="@+id/tVDesc5"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/tVDesc6"
                    android:paddingBottom="@dimen/item_gap_xs"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="@string/kode_referral_agreement_no_6"
                    android:textAllCaps="false"
                    app:layout_constraintEnd_toEndOf="@+id/textViewAgreement"
                    app:layout_constraintStart_toEndOf="@+id/tVNo6"
                    app:layout_constraintTop_toBottomOf="@+id/tVDesc5"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/tVNo7"
                    android:visibility="gone"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="7. "
                    app:layout_constraintStart_toStartOf="@+id/textViewAgreement"
                    app:layout_constraintTop_toBottomOf="@+id/tVDesc6"
                    style="@style/SbTextView.BodyDefault"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/tVDesc7"
                    android:paddingBottom="@dimen/item_gap_xs"
                    android:visibility="gone"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="@string/kode_referral_agreement_no_7"
                    android:textAllCaps="false"
                    app:layout_constraintEnd_toEndOf="@+id/textViewAgreement"
                    app:layout_constraintStart_toEndOf="@+id/tVNo7"
                    app:layout_constraintTop_toBottomOf="@+id/tVDesc6"
                    style="@style/SbTextView.BodyDefault"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </RelativeLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
