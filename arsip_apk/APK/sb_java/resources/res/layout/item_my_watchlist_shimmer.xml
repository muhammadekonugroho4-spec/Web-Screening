<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/item_my_watchlist_shimmer_0"
    android:background="@drawable/bg_border_gray_rounded"
    android:paddingTop="@dimen/spacing_12"
    android:paddingBottom="@dimen/spacing_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_20"
    android:paddingHorizontal="@dimen/spacing_16">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_8"
        android:text="@string/my_watchlist_filter"
        style="@style/TypeStyles.HeadingRegular"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
</LinearLayout>
