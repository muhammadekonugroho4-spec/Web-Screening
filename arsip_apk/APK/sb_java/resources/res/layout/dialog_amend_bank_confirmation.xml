<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_amend_bank_confirmation_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mcv_bank_info"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_marginHorizontal="@dimen/spacing_20"
        app:cardBackgroundColor="@color/transparent"
        app:cardCornerRadius="@dimen/spacing_4"
        app:cardElevation="@dimen/spacing_0"
        app:contentPaddingBottom="@dimen/spacing_12"
        app:contentPaddingLeft="@dimen/spacing_16"
        app:contentPaddingRight="@dimen/spacing_16"
        app:contentPaddingTop="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="?attr/themeColorModalsBorder"
        app:strokeWidth="1dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/tv_title_community_name"
                android:layout_width="@dimen/spacing_0"
                android:layout_height="wrap_content"
                android:text="@string/title_add_bank_name"
                android:layout_marginEnd="@dimen/spacing_12"
                app:layout_constraintEnd_toStartOf="@+id/tv_value_community_name"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:ellipsize="end"
                android:gravity="end"
                android:id="@+id/tv_value_community_name"
                android:tag="binding_1"
                android:layout_width="@dimen/spacing_0"
                android:layout_height="wrap_content"
                android:maxLines="2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_title_community_name"
                app:layout_constraintTop_toTopOf="@+id/tv_title_community_name"
                style="@style/TypeStyles.HeadingRegular"/>
            <TextView
                android:id="@+id/tv_title_buy_fee"
                android:layout_width="@dimen/spacing_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/title_add_acc_number"
                android:layout_marginEnd="@dimen/spacing_12"
                app:layout_constraintEnd_toStartOf="@+id/tv_value_buy_fee"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_value_community_name"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:id="@+id/tv_title_sell_fee"
                android:layout_width="@dimen/spacing_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/title_add_acc_owner"
                android:layout_marginEnd="@dimen/spacing_12"
                app:layout_constraintEnd_toStartOf="@+id/tv_value_sell_fee"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_buy_fee"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_value_buy_fee"
                android:tag="binding_2"
                android:layout_width="@dimen/spacing_0"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tv_title_buy_fee"
                app:layout_constraintTop_toTopOf="@+id/tv_title_buy_fee"
                style="@style/TypeStyles.HeadingRegular"/>
            <TextView
                android:ellipsize="end"
                android:gravity="end"
                android:id="@+id/tv_value_sell_fee"
                android:tag="binding_3"
                android:layout_width="@dimen/spacing_0"
                android:layout_height="wrap_content"
                android:maxLines="2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tv_title_sell_fee"
                app:layout_constraintTop_toTopOf="@+id/tv_title_sell_fee"
                style="@style/TypeStyles.HeadingRegular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="center"
        android:id="@+id/tv_add_bank_confirmation_desc"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_24"
        android:text="@string/text_amend_bank_confirmation"
        android:layout_marginHorizontal="@dimen/spacing_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mcv_bank_info"
        style="@style/TypeStyles.BodyRegular"/>
    <com.stockbit.uikit.button.SecondaryNeutralButton
        android:id="@+id/btn_add_bank_re_check"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_20"
        android:text="@string/button_amend_bank_re_check"
        android:layout_marginStart="@dimen/spacing_20"
        android:layout_marginEnd="@dimen/spacing_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_add_bank_continue"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_add_bank_continue"
        app:secondaryNeutralButtonColor="green"/>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/btn_add_bank_continue"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_36"
        android:layout_marginBottom="@dimen/spacing_20"
        android:text="@string/button_next"
        android:layout_marginStart="@dimen/spacing_8"
        android:layout_marginEnd="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btn_add_bank_re_check"
        app:layout_constraintTop_toBottomOf="@+id/tv_add_bank_confirmation_desc"/>
</androidx.constraintlayout.widget.ConstraintLayout>
