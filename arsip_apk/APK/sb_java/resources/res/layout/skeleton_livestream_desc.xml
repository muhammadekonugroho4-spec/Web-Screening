<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/border_gray_rounded_transparent_bg"
    android:padding="@dimen/item_gap_l"
    android:paddingTop="@dimen/item_gap_20"
    android:paddingBottom="@dimen/item_gap_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/item_gap_20"
    android:layout_marginBottom="@dimen/item_gap_20"
    android:layout_marginStart="@dimen/item_gap_20"
    android:layout_marginEnd="@dimen/item_gap_20">
    <View
        android:id="@+id/view_stream_skeleton_avatar"
        android:background="@drawable/ic_circle_grey"
        android:layout_width="@dimen/avatar_size_default"
        android:layout_height="@dimen/avatar_size_default"
        android:backgroundTint="?attr/themeShimmer"/>
    <View
        android:id="@+id/view_stream_skeleton_host_name"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_220"
        android:layout_height="@dimen/item_gap_14"
        android:layout_toRightOf="@+id/view_stream_skeleton_avatar"
        android:layout_marginStart="@dimen/item_gap_13"
        android:backgroundTint="?attr/themeShimmer"/>
    <View
        android:id="@+id/view_stream_skeleton_host"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_80"
        android:layout_height="@dimen/item_gap_14"
        android:layout_marginTop="@dimen/item_gap_12"
        android:layout_marginBottom="@dimen/item_gap_20"
        android:layout_toRightOf="@+id/view_stream_skeleton_avatar"
        android:layout_below="@+id/view_stream_skeleton_host_name"
        android:layout_marginStart="@dimen/item_gap_13"
        android:backgroundTint="?attr/themeShimmer"/>
    <View
        android:id="@+id/view_stream_skeleton_desc"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_220"
        android:layout_height="@dimen/item_gap_14"
        android:layout_toRightOf="@+id/view_stream_skeleton_avatar"
        android:layout_below="@+id/view_stream_skeleton_host"
        android:layout_marginStart="@dimen/item_gap_13"
        android:backgroundTint="?attr/themeShimmer"/>
    <View
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_80"
        android:layout_height="@dimen/item_gap_14"
        android:layout_marginTop="@dimen/item_gap_12"
        android:layout_toRightOf="@+id/view_stream_skeleton_avatar"
        android:layout_below="@+id/view_stream_skeleton_desc"
        android:layout_marginStart="@dimen/item_gap_13"
        android:backgroundTint="?attr/themeShimmer"/>
</RelativeLayout>
