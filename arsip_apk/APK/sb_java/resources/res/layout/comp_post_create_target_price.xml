<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mc_publish_target_price"
    android:tag="layout/comp_post_create_target_price_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_20"
    android:layout_marginVertical="@dimen/spacing_16"
    app:cardBackgroundColor="?attr/themeContentBackground"
    app:cardCornerRadius="@dimen/spacing_6"
    app:cardElevation="@dimen/spacing_0"
    app:strokeColor="?attr/themeColorBorder"
    app:strokeWidth="@dimen/height_1">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/parent_publish_target_price_composer"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_publish_target_price_composer_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/title_compose_target_price"
            android:layout_marginStart="@dimen/spacing_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingRegular"/>
        <ImageView
            android:id="@+id/iv_close_target_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/uikit_ic_stockbit_search_bar_close_fill"
            android:layout_marginEnd="@dimen/spacing_16"
            app:layout_constraintBottom_toBottomOf="@+id/tv_publish_target_price_composer_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_publish_target_price_composer_title"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/parent_clickable_publish_target_price_composer_symbol"
            android:background="@drawable/bg_text_input_inactive"
            android:layout_width="0dp"
            android:layout_height="@dimen/spacing_36"
            android:layout_marginTop="@dimen/spacing_16"
            android:layout_marginHorizontal="@dimen/spacing_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_publish_target_price_composer_title">
            <TextView
                android:textColorHint="?attr/themeColorTextTetriary"
                android:gravity="center_vertical"
                android:id="@+id/tv_publish_target_price_composer_symbol_value"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="@string/placeholder_compose_target_price_stock"
                android:layout_weight="1"
                android:paddingHorizontal="@dimen/spacing_12"
                style="@style/TypeStyles.BodyRegular"/>
            <ImageView
                android:layout_width="@dimen/spacing_20"
                android:layout_height="@dimen/spacing_20"
                android:src="@drawable/uikit_ic_stockbit_top_bar_chevron_right"
                android:layout_marginEnd="@dimen/spacing_12"/>
        </LinearLayout>
        <com.google.android.material.textfield.TextInputEditText
            android:textColor="?attr/themeColorTextPrimary"
            android:textColorHint="?attr/themeColorTextTetriary"
            android:id="@+id/etPublishTargetPriceComposerPriceValue"
            android:background="@drawable/bg_input_text_selector"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_36"
            android:layout_marginTop="@dimen/spacing_8"
            android:hint="@string/placeholder_compose_target_price"
            android:maxEms="13"
            android:maxLength="13"
            android:digits="0123456789"
            android:inputType="numberSigned"
            android:imeOptions="actionDone"
            android:layout_marginHorizontal="@dimen/spacing_16"
            android:paddingHorizontal="@dimen/spacing_12"
            android:paddingVertical="@dimen/spacing_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/parent_clickable_publish_target_price_composer_symbol"
            style="@style/TypeStyles.BodyRegular"/>
        <com.stockbit.uikit.divider.SBDivider
            android:id="@+id/divider_comp_create_polling"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            app:dividerVariant="thin_grey"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etPublishTargetPriceComposerPriceValue"/>
        <TextView
            android:id="@+id/tv_comp_post_create_poll_expire_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placeholder_compose_target_duration"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_marginVertical="@dimen/spacing_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider_comp_create_polling"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_comp_post_create_poll_expire_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/spacing_4"
            android:layout_marginEnd="@dimen/spacing_16"
            app:drawableEndCompat="@drawable/ic_duration_chevron_down"
            app:drawableTint="?attr/themeColorIconDefault"
            app:layout_constraintBottom_toBottomOf="@+id/tv_comp_post_create_poll_expire_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_comp_post_create_poll_expire_label"
            style="@style/TypeStyles.BodyRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
