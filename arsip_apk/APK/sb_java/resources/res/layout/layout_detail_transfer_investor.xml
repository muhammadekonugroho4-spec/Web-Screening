<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_detail_transfer_investor"
    android:tag="layout/layout_detail_transfer_investor_0"
    android:background="@drawable/bg_theme_content_gray_border_4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/item_gap_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/source_securities"
                android:layout_weight="1"
                style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="end"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/item_gap_14"
                style="@style/SbTextView.BodyDefault.Highempasis.Bold"/>
            <include
                android:layout_gravity="end"
                android:layout_width="@dimen/clickable_size_140"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                layout="@layout/skeleton_horizontal"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:tag="binding_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12">
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_withdrawal_nama"
                android:layout_weight="1"
                style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="end"
                android:tag="binding_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/item_gap_64"
                style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
            <include
                android:layout_gravity="end"
                android:layout_width="@dimen/clickable_size_140"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                layout="@layout/skeleton_horizontal"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:tag="binding_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12">
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_kode_nasabah"
                android:layout_weight="1"
                style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="end"
                android:tag="binding_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/item_gap_10"
                style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
            <include
                android:layout_gravity="end"
                android:layout_width="@dimen/clickable_size_140"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                layout="@layout/skeleton_horizontal"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:tag="binding_7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12">
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sid_number"
                android:layout_weight="1"
                style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="end"
                android:tag="binding_8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="54dp"
                style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
            <include
                android:layout_gravity="end"
                android:layout_width="@dimen/clickable_size_140"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                layout="@layout/skeleton_horizontal"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
