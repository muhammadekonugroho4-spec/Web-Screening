<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_phone_line_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_phone_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingXSmall"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_phone_input_layout"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_phone_label"
        app:layout_goneMarginTop="@dimen/spacing_0">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/themeColorTextPrimary"
            android:gravity="center"
            android:id="@+id/tv_phone_country_selection"
            android:background="?attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/spacing_8"
            android:textAlignment="gravity"
            app:drawableEndCompat="@drawable/ic_arrow_down"
            app:layout_constraintBottom_toBottomOf="@+id/edt_phone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/edt_phone"
            style="@style/TypeStyles.BodyRegular"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/edt_phone"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_phone_clear_text"
            app:layout_constraintStart_toEndOf="@+id/tv_phone_country_selection"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Sb.Widget.TextInputEditText"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_phone_clear_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/edt_phone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/edt_phone"
            app:layout_constraintTop_toTopOf="@+id/edt_phone"
            app:srcCompat="@drawable/uikit_ic_stockbit_search_bar_close_fill"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/v_phone_indicator"
        android:background="?attr/themeColorBorder"
        android:layout_width="match_parent"
        android:layout_height="@dimen/uikit_divider_thin"
        android:layout_marginTop="@dimen/spacing_8"
        app:layout_constraintEnd_toEndOf="@+id/cl_phone_input_layout"
        app:layout_constraintStart_toStartOf="@+id/cl_phone_input_layout"
        app:layout_constraintTop_toBottomOf="@+id/cl_phone_input_layout"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_phone_error"
        android:visibility="gone"
        android:layout_width="@dimen/icon_placeholder_16"
        android:layout_height="@dimen/icon_placeholder_16"
        app:layout_constraintBottom_toBottomOf="@+id/tv_phone_helper"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_phone_helper"
        app:srcCompat="@drawable/ic_input_error"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorTextSecondary"
        android:id="@+id/tv_phone_helper"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/uikit_margin_input_helper_indicator"
        android:layout_marginStart="@dimen/spacing_8"
        android:layout_marginEnd="@dimen/spacing_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_phone_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_phone_error"
        app:layout_constraintTop_toBottomOf="@+id/v_phone_indicator"
        app:layout_goneMarginEnd="@dimen/spacing_0"
        app:layout_goneMarginStart="@dimen/spacing_0"
        app:layout_goneMarginTop="@dimen/spacing_0"
        style="@style/TypeStyles.BodyXSmall"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/uikit_color_text_input_button"
        android:id="@+id/tv_phone_button"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_phone_indicator"
        style="@style/TypeStyles.HeadingSmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
