    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/cl_portfolio"
        android:background="?attr/themeColorSurfaceVariant"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_26">
        <ImageView
            android:id="@+id/iv_portfolio"
            android:layout_width="@dimen/spacing_16"
            android:layout_height="@dimen/spacing_16"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/guide_line_iv_porto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guide_line_iv_porto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.12"/>
        <View
            android:id="@+id/view_separator_portfolio_icon"
            android:background="?attr/themeColorDividerGreyBorder"
            android:layout_width="@dimen/spacing_1"
            android:layout_height="match_parent"
            android:layout_marginVertical="@dimen/spacing_6"
            app:layout_constraintStart_toEndOf="@+id/guide_line_iv_porto"/>
