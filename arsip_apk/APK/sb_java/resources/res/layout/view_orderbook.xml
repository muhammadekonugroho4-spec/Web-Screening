            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_avg_price"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/spacing_16"
            app:layout_constraintStart_toEndOf="@+id/view_separator_portfolio_icon"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:gravity="center"
                android:id="@+id/tv_avg"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/lbl_orderbook_avg"
                style="@style/TypeStyles.BodySmall"/>
            <TextView
                android:ellipsize="end"
                android:gravity="end|center_vertical"
                android:id="@+id/tv_avg_price"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_marginStart="@dimen/spacing_4"
                style="@style/TypeStyles.HeadingSmall"/>
        </LinearLayout>
        <View
            android:id="@+id/view_separator_portfolio_avg"
            android:background="?attr/themeColorDividerGreyBorder"
            android:layout_width="@dimen/spacing_1"
            android:layout_height="match_parent"
            android:layout_marginVertical="@dimen/spacing_6"
            app:layout_constraintStart_toEndOf="@+id/guide_line_portfolio"
            app:layout_constraintStart_toStartOf="@+id/guide_line_portfolio"/>
