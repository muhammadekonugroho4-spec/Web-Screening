<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/ll_portfolio_action"
    android:tag="layout/comp_row_portfolio_stock_complete_action_0"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:minHeight="@dimen/portfolio_row_item_complete_height">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_portfolio_action_buy"
        android:background="@color/green_text"
        android:layout_width="@dimen/portfolio_row_item_complete_height"
        android:layout_height="match_parent"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:minHeight="@dimen/portfolio_row_item_complete_height"
        android:text="@string/btn_buy_watchlist"
        android:layout_alignParentLeft="true"
        style="@style/TypeStyles.HeadingXSmall"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="start"
        android:id="@+id/tv_portfolio_action_sell"
        android:background="@color/google_red"
        android:layout_width="@dimen/portfolio_row_item_complete_height"
        android:layout_height="match_parent"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:minHeight="@dimen/portfolio_row_item_complete_height"
        android:text="@string/btn_sell"
        android:layout_toRightOf="@+id/tv_trading_portfolio_row_buy"
        style="@style/TypeStyles.HeadingXSmall"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_portfolio_action_exercise"
        android:background="?attr/themeColorFeatureViolet"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:minWidth="@dimen/portfolio_row_item_complete_height"
        android:minHeight="@dimen/portfolio_row_item_complete_height"
        android:text="@string/btn_exercise_portfolio"
        android:layout_toRightOf="@+id/tv_trading_portfolio_row_sell"
        android:paddingHorizontal="@dimen/spacing_4"
        style="@style/TypeStyles.HeadingXSmall"/>
</androidx.appcompat.widget.LinearLayoutCompat>
