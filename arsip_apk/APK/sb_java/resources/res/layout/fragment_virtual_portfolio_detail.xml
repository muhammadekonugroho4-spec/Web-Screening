<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_virtual_portfolio_detail_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:paddingLeft="@dimen/item_gap_null"
        android:paddingRight="@dimen/item_gap_null"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:contentInsetLeft="@dimen/item_gap_null"
        app:contentInsetStart="@dimen/item_gap_null"
        app:contentInsetStartWithNavigation="@dimen/item_gap_null"
        app:elevation="@dimen/item_gap_null">
        <RelativeLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/parentToolbarContentContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minHeight="?attr/actionBarSize">
            <TextView
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/tvToolbarTitleName"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/title_portfolio_detail"
                android:singleLine="true"
                android:layout_centerHorizontal="true"
                android:textAlignment="gravity"
                style="@style/SbTextView.PageTitle"/>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <View
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"/>
    <ViewFlipper
        android:id="@+id/vfFragmentTradingPortfolioDetail"
        android:tag="binding_1"
        android:background="?attr/themeContentBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include layout="@layout/skeleton_item_portfolio_detail"/>
                <include layout="@layout/skeleton_item_portfolio_detail"/>
                <include layout="@layout/skeleton_item_portfolio_detail"/>
                <include layout="@layout/skeleton_item_portfolio_detail"/>
                <include layout="@layout/skeleton_item_portfolio_detail"/>
                <include layout="@layout/skeleton_item_portfolio_detail"/>
                <include layout="@layout/skeleton_item_portfolio_detail"/>
                <include layout="@layout/skeleton_item_portfolio_detail"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <RelativeLayout
            android:background="?attr/themeContentBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <com.google.android.material.card.MaterialCardView
                android:layout_gravity="bottom"
                android:id="@+id/cvSellContainer"
                android:padding="0dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="0dp"
                android:layout_alignParentBottom="true"
                app:cardBackgroundColor="?attr/themeContentBackground"
                app:cardCornerRadius="0dp"
                app:cardElevation="@dimen/item_gap_20"
                app:cardUseCompatPadding="false">
                <Button
                    android:textColor="@color/red_item"
                    android:gravity="center"
                    android:id="@+id/btnSellFragmentTradingPortfolioDetail"
                    android:background="@drawable/bg_small_rounded_gray_outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/item_gap_20"
                    android:text="@string/btn_sell"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/red_item"
                    style="@style/SbBtn.PrimaryFullWidthFloating"/>
            </com.google.android.material.card.MaterialCardView>
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:layout_above="@+id/cvSellContainer">
                <RelativeLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/parentPortfolioDetailCompanyInfo"
                        android:background="@drawable/bg_small_rounded_gray_outline"
                        android:paddingTop="@dimen/item_gap_l"
                        android:paddingBottom="@dimen/item_gap_l"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_10"
                        android:foreground="?attr/selectableItemBackground"
                        android:minHeight="@dimen/clickable_size_48"
                        android:backgroundTint="?attr/titleTextColorDowngray"
                        android:layout_marginHorizontal="@dimen/item_gap_20">
                        <TextView
                            android:id="@+id/tvPortfolioDetailSymbol"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/item_gap_l"
                            app:layout_constraintBottom_toTopOf="@+id/tvCompanyName"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/SbTextView.ListTitle"/>
                        <TextView
                            android:ellipsize="end"
                            android:id="@+id/tvCompanyName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            app:layout_constraintStart_toStartOf="@+id/tvPortfolioDetailSymbol"
                            app:layout_constraintTop_toBottomOf="@+id/tvPortfolioDetailSymbol"
                            style="@style/SbTextView.CaptionSecondary"/>
                        <View
                            android:id="@+id/vSymbolIconSpacing"
                            android:layout_width="@dimen/item_gap_xs"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="@+id/tvPortfolioDetailSymbol"
                            app:layout_constraintStart_toEndOf="@+id/tvPortfolioDetailSymbol"
                            app:layout_constraintTop_toTopOf="@+id/tvPortfolioDetailSymbol"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivIcNotation"
                            android:visibility="gone"
                            android:layout_width="@dimen/avatar_size_11.5"
                            android:layout_height="wrap_content"
                            android:scaleType="fitXY"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/item_gap_xs"
                            app:layout_constraintBottom_toBottomOf="@+id/tvPortfolioDetailSymbol"
                            app:layout_constraintStart_toEndOf="@+id/vSymbolIconSpacing"
                            app:layout_constraintTop_toTopOf="@+id/tvPortfolioDetailSymbol"
                            app:srcCompat="@drawable/ic_notasi_khusus"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/ivIcCorporateAction"
                            android:visibility="gone"
                            android:layout_width="@dimen/avatar_size_11.5"
                            android:layout_height="wrap_content"
                            android:scaleType="fitXY"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/item_gap_xs"
                            app:layout_constraintBottom_toBottomOf="@+id/tvPortfolioDetailSymbol"
                            app:layout_constraintStart_toEndOf="@+id/ivIcNotation"
                            app:layout_constraintTop_toTopOf="@+id/tvPortfolioDetailSymbol"
                            app:srcCompat="@drawable/ic_corporate_action"/>
                        <ImageView
                            android:id="@+id/ivPortfolioDetailIcon"
                            android:padding="@dimen/item_gap_xs"
                            android:layout_width="@dimen/clickable_size_24"
                            android:layout_height="@dimen/clickable_size_24"
                            android:scaleType="centerInside"
                            android:rotation="180"
                            android:layout_marginEnd="@dimen/item_gap_s"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/back_toolbar"
                            app:tint="@color/highempasis_dark"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <RelativeLayout
                        android:id="@+id/parentPortfolioDetailBalanceInfo"
                        android:background="@drawable/bg_small_rounded_gray_outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_10"
                        android:layout_below="@+id/parentPortfolioDetailCompanyInfo"
                        android:backgroundTint="?attr/titleTextColorDowngray"
                        android:layout_marginHorizontal="@dimen/item_gap_20">
                        <TextView
                            android:id="@+id/tvTitleBalanceLot"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/item_gap_l"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_title_balance_lot"
                            android:layout_alignParentLeft="true"
                            android:paddingStart="@dimen/item_gap_l"
                            android:paddingEnd="@dimen/item_gap_l"
                            android:layout_alignParentStart="true"
                            style="@style/SbTextView.BodyDefault"/>
                        <TextView
                            android:gravity="end"
                            android:id="@+id/tvBalanceLot"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/item_gap_l"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/n_dash"
                            android:layout_toRightOf="@+id/tvTitleBalanceLot"
                            android:layout_alignParentRight="true"
                            android:textAlignment="gravity"
                            android:paddingStart="@dimen/item_gap_l"
                            android:paddingEnd="@dimen/item_gap_l"
                            android:layout_toEndOf="@+id/tvTitleBalanceLot"
                            android:layout_alignParentEnd="true"
                            style="@style/SbTextView.BodyDefault"/>
                        <TextView
                            android:id="@+id/tvTitleAvailableLot"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/item_gap_l"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_title_available_lot"
                            android:layout_below="@+id/tvTitleBalanceLot"
                            android:layout_alignParentLeft="true"
                            android:paddingStart="@dimen/item_gap_l"
                            android:paddingEnd="@dimen/item_gap_l"
                            android:layout_alignParentStart="true"
                            style="@style/SbTextView.BodyDefault"/>
                        <TextView
                            android:gravity="end"
                            android:id="@+id/tvAvailableLot"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/item_gap_l"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/n_dash"
                            android:layout_toRightOf="@+id/tvTitleAvailableLot"
                            android:layout_below="@+id/tvTitleBalanceLot"
                            android:layout_alignParentRight="true"
                            android:textAlignment="gravity"
                            android:paddingStart="@dimen/item_gap_l"
                            android:paddingEnd="@dimen/item_gap_l"
                            android:layout_toEndOf="@+id/tvTitleAvailableLot"
                            android:layout_alignParentEnd="true"
                            style="@style/SbTextView.BodyDefault"/>
                        <TextView
                            android:id="@+id/tvTitleAveragePrice"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/item_gap_l"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_title_average_price"
                            android:layout_below="@+id/tvTitleAvailableLot"
                            android:layout_alignParentLeft="true"
                            android:paddingStart="@dimen/item_gap_l"
                            android:paddingEnd="@dimen/item_gap_l"
                            android:layout_alignParentStart="true"
                            style="@style/SbTextView.BodyDefault"/>
                        <TextView
                            android:gravity="end"
                            android:id="@+id/tvAveragePrice"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/item_gap_l"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/n_dash"
                            android:layout_toRightOf="@+id/tvTitleAveragePrice"
                            android:layout_below="@+id/tvTitleAvailableLot"
                            android:layout_alignParentRight="true"
                            android:textAlignment="gravity"
                            android:paddingStart="@dimen/item_gap_l"
                            android:paddingEnd="@dimen/item_gap_l"
                            android:layout_toEndOf="@+id/tvTitleAveragePrice"
                            android:layout_alignParentEnd="true"
                            style="@style/SbTextView.BodyDefault"/>
                        <TextView
                            android:id="@+id/tvTitleCurrentPrice"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/item_gap_l"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_title_current_price"
                            android:layout_below="@+id/tvTitleAveragePrice"
                            android:layout_alignParentLeft="true"
                            android:paddingStart="@dimen/item_gap_l"
                            android:paddingEnd="@dimen/item_gap_l"
                            android:layout_alignParentStart="true"
                            style="@style/SbTextView.BodyDefault"/>
                        <TextView
                            android:gravity="end"
                            android:id="@+id/tvCurrentPrice"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/item_gap_l"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/n_dash"
                            android:layout_toRightOf="@+id/tvTitleCurrentPrice"
                            android:layout_below="@+id/tvTitleAveragePrice"
                            android:layout_alignParentRight="true"
                            android:textAlignment="gravity"
                            android:paddingStart="@dimen/item_gap_l"
                            android:paddingEnd="@dimen/item_gap_l"
                            android:layout_toEndOf="@+id/tvTitleCurrentPrice"
                            android:layout_alignParentEnd="true"
                            style="@style/SbTextView.BodyDefault"/>
                        <TextView
                            android:id="@+id/tvTitleInvested"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/item_gap_l"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_title_invested"
                            android:layout_below="@+id/tvTitleCurrentPrice"
                            android:layout_alignParentLeft="true"
                            android:paddingStart="@dimen/item_gap_l"
                            android:paddingEnd="@dimen/item_gap_l"
                            android:layout_alignParentStart="true"
                            style="@style/SbTextView.BodyDefault"/>
                        <TextView
                            android:gravity="end"
                            android:id="@+id/invested"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/item_gap_l"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/n_dash"
                            android:layout_toRightOf="@+id/tvTitleInvested"
                            android:layout_below="@+id/tvTitleCurrentPrice"
                            android:layout_alignParentRight="true"
                            android:textAlignment="gravity"
                            android:paddingStart="@dimen/item_gap_l"
                            android:paddingEnd="@dimen/item_gap_l"
                            android:layout_toEndOf="@+id/tvTitleInvested"
                            android:layout_alignParentEnd="true"
                            style="@style/SbTextView.BodyDefault"/>
                        <TextView
                            android:id="@+id/tvTitlemarketValue"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/item_gap_l"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_title_market_value"
                            android:layout_below="@+id/tvTitleInvested"
                            android:layout_alignParentLeft="true"
                            android:paddingStart="@dimen/item_gap_l"
                            android:paddingEnd="@dimen/item_gap_l"
                            android:layout_alignParentStart="true"
                            style="@style/SbTextView.BodyDefault"/>
                        <TextView
                            android:gravity="end"
                            android:id="@+id/tvMarketValue"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/item_gap_l"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/n_dash"
                            android:layout_toRightOf="@+id/tvTitlemarketValue"
                            android:layout_below="@+id/tvTitleInvested"
                            android:layout_alignParentRight="true"
                            android:textAlignment="gravity"
                            android:paddingStart="@dimen/item_gap_l"
                            android:paddingEnd="@dimen/item_gap_l"
                            android:layout_toEndOf="@+id/tvTitlemarketValue"
                            android:layout_alignParentEnd="true"
                            style="@style/SbTextView.BodyDefault"/>
                        <TextView
                            android:id="@+id/tvTitlePotentialPl"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/item_gap_l"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_title_potential_pl"
                            android:layout_below="@+id/tvTitlemarketValue"
                            android:layout_alignParentLeft="true"
                            android:paddingStart="@dimen/item_gap_l"
                            android:paddingEnd="@dimen/item_gap_l"
                            android:layout_alignParentStart="true"
                            style="@style/SbTextView.BodyDefault"/>
                        <TextView
                            android:gravity="end"
                            android:id="@+id/tvPotentialPl"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/item_gap_l"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/n_dash"
                            android:layout_toRightOf="@+id/tvTitlePotentialPl"
                            android:layout_below="@+id/tvTitlemarketValue"
                            android:layout_alignParentRight="true"
                            android:textAlignment="gravity"
                            android:paddingStart="@dimen/item_gap_l"
                            android:paddingEnd="@dimen/item_gap_l"
                            android:layout_toEndOf="@+id/tvTitlePotentialPl"
                            android:layout_alignParentEnd="true"
                            style="@style/SbTextView.BodyDefault"/>
                        <TextView
                            android:id="@+id/tvTitlePercentage"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/item_gap_l"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lbl_title_percentage"
                            android:layout_below="@+id/tvTitlePotentialPl"
                            android:layout_alignParentLeft="true"
                            android:paddingStart="@dimen/item_gap_l"
                            android:paddingEnd="@dimen/item_gap_l"
                            android:layout_alignParentStart="true"
                            style="@style/SbTextView.BodyDefault"/>
                        <TextView
                            android:textColor="@color/green_text"
                            android:gravity="end"
                            android:id="@+id/tvPercentage"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/item_gap_l"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/n_dash"
                            android:layout_toRightOf="@+id/tvTitlePercentage"
                            android:layout_below="@+id/tvTitlePotentialPl"
                            android:layout_alignParentRight="true"
                            android:textAlignment="gravity"
                            android:paddingStart="@dimen/item_gap_l"
                            android:paddingEnd="@dimen/item_gap_l"
                            android:layout_toEndOf="@+id/tvTitlePercentage"
                            android:layout_alignParentEnd="true"
                            style="@style/SbTextView.BodyDefault"/>
                    </RelativeLayout>
                </RelativeLayout>
            </androidx.core.widget.NestedScrollView>
        </RelativeLayout>
        <include
            android:layout_gravity="center"
            android:id="@+id/parentErrorTradingPortfolioDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/comp_icon_error_view"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsvFragmentTradingPortfolioDetail"
            android:tag="binding_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <include layout="@layout/comp_empty_data_virtual_portfolio"/>
        </androidx.core.widget.NestedScrollView>
    </ViewFlipper>
</androidx.appcompat.widget.LinearLayoutCompat>
