<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentRowDiscoverSuggestedRoot"
    android:tag="layout/row_discover_friend_0"
    android:background="?attr/themeContentBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/symbolCompany"
        android:tag="binding_1"
        android:layout_width="@dimen/spacing_48"
        android:layout_height="@dimen/spacing_48"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/spacing_20"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/parentRowDiscoverSuggestedUserInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/item_gap_m"
        android:layout_marginEnd="@dimen/spacing_8"
        android:layout_toStartOf="@+id/fl_follow_unfollow"
        android:layout_toEndOf="@+id/symbolCompany">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ln_username_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/username"
                android:tag="binding_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                style="@style/TypeStyles.HeadingRegular"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_verified_badge"
                android:tag="binding_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/item_gap_4"/>
        </LinearLayout>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:id="@+id/name_full_name"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_xxs"
            android:maxLines="1"
            style="@style/TypeStyles.BodyRegular"/>
    </LinearLayout>
    <ViewFlipper
        android:id="@+id/fl_follow_unfollow"
        android:tag="binding_5"
        android:layout_width="@dimen/width_80"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/spacing_20">
        <com.stockbit.uikit.button.SecondaryNeutralButton
            android:id="@+id/btnRowDiscoverSuggestedFollowed"
            android:tag="binding_6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/following"
            app:secondaryNeutralButtonColor="neutral"
            app:secondaryNeutralButtonSize="smallSize"/>
        <com.stockbit.uikit.button.PrimaryButton
            android:id="@+id/btnRowDiscoverSuggestedFollow"
            android:tag="binding_7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_follow"
            app:primaryButtonSize="smallSize"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progress_follow_status"
            android:focusable="false"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:indeterminate="true"
            android:indeterminateTint="@color/green_text"/>
    </ViewFlipper>
    <View
        android:id="@+id/border"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_below="@+id/symbolCompany"
        android:layout_marginHorizontal="@dimen/spacing_20"/>
</RelativeLayout>
