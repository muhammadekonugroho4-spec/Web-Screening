<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_trading_stockbit_portfolio_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewFlipper
        android:id="@+id/vfFragmentTradingPortfolio"
        android:tag="binding_1"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/sflTradingPortfolioLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/FBShimmerFrameLayout">
            <LinearLayout
                android:orientation="vertical"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include layout="@layout/skeleton_header_portfolio_box"/>
                <View
                    android:background="@drawable/bg_rounded_gray"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_gap_8"
                    android:backgroundTint="?attr/themeColorDividerThick"
                    android:layout_marginVertical="@dimen/item_gap_8"/>
                <include layout="@layout/skeleton_item_portfolio"/>
                <include layout="@layout/skeleton_item_portfolio"/>
                <include layout="@layout/skeleton_item_portfolio"/>
                <include layout="@layout/skeleton_item_portfolio"/>
                <include layout="@layout/skeleton_item_portfolio"/>
                <include layout="@layout/skeleton_item_portfolio"/>
                <include layout="@layout/skeleton_item_portfolio"/>
                <include layout="@layout/skeleton_item_portfolio"/>
                <include layout="@layout/skeleton_item_portfolio"/>
                <include layout="@layout/skeleton_item_portfolio"/>
                <include layout="@layout/skeleton_item_portfolio"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/srlFragmentTradingPortfolio"
            android:tag="binding_3"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFragmentTradingPortfolio"
                    android:background="?attr/themeColorSurfaceDefault"
                    android:scrollbars="none"
                    android:clipToPadding="false"
                    android:descendantFocusability="blocksDescendants"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <com.stockbit.component.banner.BannerView
                    android:id="@+id/banner_view"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <include
            android:layout_gravity="center"
            android:id="@+id/view_network_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/comp_error_no_connection_view"/>
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/srlFragmentTradingPortfolioEmptyState"
            android:tag="binding_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/nsvFragmentTradingPortfolio"
                android:tag="binding_5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">
                <include
                    android:id="@+id/parentTradingPortfolioEmptyLayout"
                    layout="@layout/comp_empty_data_trading_portfolio_main"/>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </ViewFlipper>
</RelativeLayout>
