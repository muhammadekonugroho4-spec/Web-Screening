<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_change_font_size_0"
    android:focusableInTouchMode="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/abl_change_font_size"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            style="@style/Sb.Widget.AppBar">
            <TextView
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_watchlist_text_size"
                style="@style/TypeStyles.HeadingLarge"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_insider"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/cl_save_button_container"
        app:layout_constraintTop_toBottomOf="@+id/abl_change_font_size">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="vertical"
                android:id="@+id/rv_watchlist_font_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_10"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/divider"
                android:background="?attr/themeColorDividerThick"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_8"
                android:layout_marginTop="@dimen/spacing_10"
                app:layout_constraintTop_toBottomOf="@+id/rv_watchlist_font_size"/>
            <TextView
                android:id="@+id/tv_small"
                android:layout_width="@dimen/item_gap_null"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/font_size_small"
                android:layout_marginStart="@dimen/spacing_16"
                app:layout_constraintEnd_toStartOf="@+id/iv_check_small"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider"
                style="@style/TypeStyles.BodyRegular"/>
            <ImageView
                android:id="@+id/iv_check_small"
                android:layout_width="@dimen/clickable_size_18"
                android:layout_height="@dimen/clickable_size_18"
                android:layout_marginEnd="@dimen/spacing_16"
                app:layout_constraintBottom_toBottomOf="@+id/tv_small"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_small"
                app:srcCompat="@drawable/ic_check_circle_empty_24dp"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/btn_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tv_small,iv_check_small"/>
            <TextView
                android:id="@+id/tv_default"
                android:layout_width="@dimen/item_gap_null"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/font_size_default"
                android:layout_marginStart="@dimen/spacing_16"
                app:layout_constraintEnd_toStartOf="@+id/iv_check_default"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_small"
                style="@style/TypeStyles.BodyRegular"/>
            <ImageView
                android:id="@+id/iv_check_default"
                android:layout_width="@dimen/clickable_size_18"
                android:layout_height="@dimen/clickable_size_18"
                android:layout_marginEnd="@dimen/spacing_16"
                app:layout_constraintBottom_toBottomOf="@+id/tv_default"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_default"
                app:srcCompat="@drawable/ic_check_circle_empty_24dp"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/btn_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tv_default,iv_check_default"/>
            <TextView
                android:id="@+id/tv_large"
                android:layout_width="@dimen/item_gap_null"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/font_size_large"
                android:layout_marginStart="@dimen/spacing_16"
                app:layout_constraintEnd_toStartOf="@+id/iv_check_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_default"
                style="@style/TypeStyles.BodyRegular"/>
            <ImageView
                android:id="@+id/iv_check_large"
                android:layout_width="@dimen/clickable_size_18"
                android:layout_height="@dimen/clickable_size_18"
                android:layout_marginEnd="@dimen/spacing_16"
                app:layout_constraintBottom_toBottomOf="@+id/tv_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_large"
                app:srcCompat="@drawable/ic_check_circle_empty_24dp"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/btn_large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tv_large,iv_check_large"/>
            <TextView
                android:id="@+id/tv_extra_large"
                android:layout_width="@dimen/item_gap_null"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/font_size_extra_large"
                android:layout_marginStart="@dimen/spacing_16"
                app:layout_constraintEnd_toStartOf="@+id/iv_check_extra_large"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_large"
                style="@style/TypeStyles.BodyRegular"/>
            <ImageView
                android:id="@+id/iv_check_extra_large"
                android:layout_width="@dimen/clickable_size_18"
                android:layout_height="@dimen/clickable_size_18"
                android:layout_marginEnd="@dimen/spacing_16"
                app:layout_constraintBottom_toBottomOf="@+id/tv_extra_large"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_extra_large"
                app:srcCompat="@drawable/ic_check_circle_empty_24dp"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/btn_extra_large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tv_extra_large,iv_check_extra_large"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_save_button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.stockbit.common.uikit.StockbitLoadingButton
            android:id="@+id/btn_apply"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:buttonText="@string/button_apply_font_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
