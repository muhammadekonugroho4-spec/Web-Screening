<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_screener_universe_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Sb.Widget.AppBar">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_universe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:id="@+id/tv_toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_screener_stock_universe_title"
                style="@style/SbTextView.PageTitle"/>
            <TextView
                android:gravity="center_horizontal"
                android:layout_gravity="end"
                android:id="@+id/tv_toolbar_done"
                android:tag="binding_1"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/item_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_screener_done"
                style="@style/SbTextView.ListTitle"/>
        </androidx.appcompat.widget.Toolbar>
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"/>
    </com.google.android.material.appbar.AppBarLayout>
    <RelativeLayout
        android:id="@+id/rl_parent_layout"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <RelativeLayout
            android:id="@+id/rl_loading"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true">
            <ProgressBar
                android:id="@+id/progress_loading"
                android:layout_width="@dimen/clickable_size_32"
                android:layout_height="@dimen/clickable_size_32"
                android:layout_centerInParent="true"/>
            <TextView
                android:padding="@dimen/item_gap_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loading"
                android:layout_below="@+id/progress_loading"
                android:layout_centerInParent="true"
                style="@style/SbTextView.BodyDefault"/>
        </RelativeLayout>
        <SearchView
            android:id="@+id/sv_screener_universe"
            android:background="@drawable/bg_selector_background_gray_rounded_outline"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_40"
            android:layout_marginTop="@dimen/item_gap_l"
            android:layout_marginBottom="@dimen/item_gap_l"
            android:minHeight="@dimen/clickable_size_40"
            android:layout_below="@+id/rl_loading"
            android:layout_alignParentLeft="true"
            android:iconifiedByDefault="false"
            android:queryHint="@string/hint_search_universe"
            android:layout_marginStart="@dimen/item_gap_l"
            android:layout_marginEnd="@dimen/item_gap_l"
            android:layout_alignParentStart="true"
            android:closeIcon="0x7f08063f"
            android:searchIcon="0x7f080db9"
            android:queryBackground="@color/transparent"
            style="?attr/themeContentTextColor"/>
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/rg_screener_type"
            android:tag="binding_3"
            android:background="@drawable/border_gray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_l"
            android:layout_marginRight="@dimen/item_gap_l"
            android:layout_marginBottom="@dimen/item_gap_l"
            android:minHeight="@dimen/clickable_size_48"
            android:layout_below="@+id/sv_screener_universe">
            <RadioButton
                android:gravity="center"
                android:id="@+id/rb_indeks"
                android:tag="binding_4"
                android:background="@drawable/selector_gray_bg"
                android:padding="@dimen/item_gap_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/item_gap_xxxs"
                android:button="@color/transparent"
                android:text="@string/screener_universe_type_index_title"
                android:layout_weight="1"
                android:textAlignment="gravity"
                style="@style/SbTextView.BodyDefault"/>
            <View
                android:background="?attr/themeColorDividerThin"
                android:layout_width="@dimen/item_gap_xxxs"
                android:layout_height="match_parent"/>
            <RadioButton
                android:gravity="center"
                android:id="@+id/rb_sektor"
                android:tag="binding_5"
                android:background="@drawable/selector_gray_bg"
                android:padding="@dimen/item_gap_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_xxxs"
                android:layout_marginBottom="@dimen/item_gap_xxxs"
                android:button="@color/transparent"
                android:text="@string/screener_universe_type_sector_title"
                android:layout_weight="1"
                android:textAlignment="gravity"
                style="@style/SbTextView.BodyDefault"/>
            <View
                android:background="?attr/themeColorDividerThin"
                android:layout_width="@dimen/item_gap_xxxs"
                android:layout_height="match_parent"/>
            <RadioButton
                android:gravity="center"
                android:id="@+id/rb_watchlist"
                android:tag="binding_6"
                android:background="@drawable/selector_gray_bg"
                android:padding="@dimen/item_gap_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_xxxs"
                android:layout_marginRight="@dimen/item_gap_xxxs"
                android:layout_marginBottom="@dimen/item_gap_xxxs"
                android:button="@color/transparent"
                android:text="@string/screener_universe_type_watchlist_title"
                android:layout_weight="1"
                android:textAlignment="gravity"
                android:layout_marginEnd="@dimen/item_gap_xxxs"
                style="@style/SbTextView.BodyDefault"/>
        </RadioGroup>
        <View
            android:id="@+id/view_separator"
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_below="@+id/rg_screener_type"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_universe_content"
            android:tag="binding_7"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/view_separator"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true">
            <include
                android:id="@+id/parentScreenerClickableEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/comp_empty_state_screener_view"/>
            <ExpandableListView
                android:id="@+id/elv_screener_universe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:groupIndicator="@null"
                android:childDivider="?attr/themeColorDividerThin"
                android:divider="?attr/themeColorDividerThin"
                android:dividerHeight="@dimen/item_gap_xxxs"/>
        </LinearLayout>
        <com.stockbit.component.tooltip.SbContainerTooltip
            android:id="@+id/tooltip_screener_universe"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
