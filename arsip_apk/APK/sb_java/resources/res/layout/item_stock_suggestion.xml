<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_stock_suggestion_0"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/spacing_48">
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tv_stock_name"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:textAlignment="gravity"
        android:paddingStart="@dimen/spacing_16"
        android:paddingEnd="@dimen/spacing_6"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tv_stock_description"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_toRightOf="@+id/tv_stock_name"
        android:textAlignment="gravity"
        android:paddingStart="@dimen/spacing_6"
        android:paddingEnd="@dimen/spacing_16"
        style="@style/TypeStyles.BodyRegular"/>
    <com.stockbit.uikit.divider.SBDivider
        android:id="@+id/v_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:layout_alignParentBottom="true"
        app:dividerVariant="thin_grey"/>
</RelativeLayout>
