<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/row_trading_stockbit_portfolio_change_to_real_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/rlTradingPortfolioRowBuySell"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/clickable_size_75">
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tvTradingPortfolioRowBuy"
                android:background="@color/green_text"
                android:padding="@dimen/item_gap_m"
                android:layout_width="@dimen/swipe_size_80"
                android:layout_height="@dimen/clickable_size_75"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:text="@string/btn_buy_watchlist"
                android:layout_alignParentLeft="true"
                style="@style/SbTextView.BodyDefault.Bold.Semi"/>
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="start"
                android:id="@+id/tvTradingPortfolioRowSell"
                android:background="@color/google_red"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="@dimen/swipe_size_80"
                android:layout_height="@dimen/clickable_size_75"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:minWidth="@dimen/clickable_size_76"
                android:text="@string/btn_sell"
                android:layout_toRightOf="@+id/tvTradingPortfolioRowBuy"
                style="@style/SbTextView.BodyDefault.Bold.Semi"/>
            <TextView
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tvTradingPortfolioRowExercise"
                android:background="?attr/themeColorFeatureViolet"
                android:padding="@dimen/item_gap_m"
                android:visibility="gone"
                android:layout_width="@dimen/swipe_size_80"
                android:layout_height="@dimen/clickable_size_75"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:text="@string/btn_exercise_portfolio"
                android:layout_toRightOf="@+id/tvTradingPortfolioRowSell"
                style="@style/SbTextView.BodyDefault.Bold.Semi"/>
        </RelativeLayout>
        <LinearLayout
            android:layout_gravity="end"
            android:id="@+id/rlTradingPortfolioRowDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="?attr/themeContentBackground"
                android:gravity="center"
                android:layout_gravity="end"
                android:background="?attr/themeContentBackground"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/clickable_size_75"
                style="@style/SbTextView.BodyDefault"/>
        </LinearLayout>
        <RelativeLayout
            android:id="@+id/rlTradingPortfolioRowItem"
            android:background="?attr/themeColorSurfaceDefault"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_75"
            android:foreground="?attr/selectableItemBackground">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llTradingPortfolioRowSymbolContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/item_gap_l"
                android:layout_marginTop="@dimen/item_gap_l">
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/tvTradingPortfolioRowSymbol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/item_gap_xs"
                    style="@style/SbTextView.BodyDefault.Bold"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/ivTradingPortfolioRowNotationCompany"
                    android:visibility="gone"
                    android:layout_width="@dimen/avatar_size_11.5"
                    android:layout_height="@dimen/avatar_size_11.5"
                    android:scaleType="fitXY"
                    android:layout_marginStart="@dimen/item_gap_xs"
                    android:layout_marginEnd="@dimen/item_gap_xs"
                    app:srcCompat="@drawable/ic_notasi_khusus"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/ivTradingPortfolioRowCorporateAction"
                    android:visibility="gone"
                    android:layout_width="@dimen/avatar_size_11.5"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/item_gap_xs"
                    android:layout_marginEnd="@dimen/item_gap_xs"
                    app:srcCompat="@drawable/ic_corporate_action"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/clickable_size_75"
                android:layout_toLeftOf="@+id/ivTradingPortfolioRowChevronRight"
                android:layout_below="@+id/llTradingPortfolioRowSymbolContainer"
                android:layout_marginStart="@dimen/item_gap_l"
                android:layout_marginEnd="@dimen/item_gap_s">
                <RelativeLayout
                    android:id="@+id/rlTradingPortfolioRowBalance"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/text_size_13"
                        android:id="@+id/tvTradingPortfolioRowInvested"
                        android:paddingTop="@dimen/item_gap_xxs"
                        android:paddingBottom="@dimen/item_gap_xxs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentLeft="true"
                        style="@style/SbTextView.BodyDefault"/>
                    <TextView
                        android:textSize="@dimen/text_size_11"
                        android:textColor="?attr/titleTextColorHighgray"
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_portfolio_invested"
                        android:layout_below="@+id/tvTradingPortfolioRowInvested"
                        android:layout_alignParentLeft="true"
                        style="@style/SbTextView.BodySecondary"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rlTradingPortfolioRowInves"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="@dimen/text_size_13"
                        android:gravity="center"
                        android:id="@+id/tvTradingPortfolioRowPnl"
                        android:paddingTop="@dimen/item_gap_xxs"
                        android:paddingBottom="@dimen/item_gap_xxs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/n_dash"
                        android:layout_centerHorizontal="true"
                        style="@style/SbTextView.BodyDefault"/>
                    <TextView
                        android:textSize="@dimen/text_size_11"
                        android:textColor="?attr/titleTextColorHighgray"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_title_pl"
                        android:layout_below="@+id/tvTradingPortfolioRowPnl"
                        android:layout_centerHorizontal="true"
                        style="@style/SbTextView.BodySecondary"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rlTradingPortfolioRowProfit"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_weight="1.1">
                    <TextView
                        android:textSize="@dimen/text_size_13"
                        android:gravity="end"
                        android:id="@+id/tvTradingPortfolioRowGhain"
                        android:paddingTop="@dimen/item_gap_xxs"
                        android:paddingBottom="@dimen/item_gap_xxs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/n_dash"
                        android:layout_alignLeft="@+id/tvTradingPortfolioRowGhainTitle"
                        android:layout_alignRight="@+id/tvTradingPortfolioRowGhainTitle"
                        style="@style/SbTextView.BodyDefault"/>
                    <TextView
                        android:textSize="@dimen/text_size_11"
                        android:textColor="?attr/titleTextColorHighgray"
                        android:gravity="end"
                        android:id="@+id/tvTradingPortfolioRowGhainTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minWidth="@dimen/clickable_size_76"
                        android:text="@string/lbl_portfolio_gain"
                        android:layout_below="@+id/tvTradingPortfolioRowGhain"
                        style="@style/SbTextView.BodySecondary"/>
                </RelativeLayout>
            </LinearLayout>
            <ImageView
                android:id="@+id/ivTradingPortfolioRowChevronRight"
                android:layout_width="@dimen/clickable_size_12"
                android:layout_height="@dimen/clickable_size_24"
                android:layout_marginLeft="@dimen/item_gap_m"
                android:layout_marginTop="@dimen/item_gap_s"
                android:layout_marginRight="@dimen/item_gap_s"
                android:scaleType="centerInside"
                android:layout_below="@+id/llTradingPortfolioRowSymbolContainer"
                android:layout_alignParentRight="true"
                android:rotation="180"
                app:srcCompat="@drawable/back_toolbar"/>
            <View
                android:background="?attr/themeColorDividerThin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_xxxs"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
    </FrameLayout>
</LinearLayout>
