<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:tag="layout/dialog_in_app_update_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/bg_in_app_update_dialog"
        android:padding="@dimen/spacing_32"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_20">
        <ImageView
            android:id="@+id/iv_in_app_update_dialog_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_in_app_update_light"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_title_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:text="@string/tv_title_content"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="center"
            android:id="@+id/tv_content_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginBottom="@dimen/spacing_12"
            android:text="@string/tv_content_description"
            style="@style/TypeStyles.BodyRegular"/>
        <com.stockbit.uikit.button.PrimaryButton
            android:id="@+id/pb_update_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_32"
            android:text="@string/pb_update_now"
            android:textAllCaps="false"
            android:layout_marginHorizontal="@dimen/spacing_20"/>
        <com.stockbit.uikit.button.FloatingButton
            android:id="@+id/fb_update_later"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/fb_update_later"
            android:textAllCaps="false"
            android:layout_marginHorizontal="@dimen/spacing_20"/>
    </LinearLayout>
</LinearLayout>
