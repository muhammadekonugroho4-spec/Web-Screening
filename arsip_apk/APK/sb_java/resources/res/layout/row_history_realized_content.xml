<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_realized_content"
    android:tag="layout/row_history_realized_content_0"
    android:background="@drawable/bg_list_selector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/clickable_size_48">
    <View
        android:id="@+id/v_top_divider"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/uikit_divider_thin"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_top_divider">
        <androidx.appcompat.widget.AppCompatTextView
            android:ellipsize="end"
            android:id="@+id/tv_realized_symbol"
            android:tag="binding_1"
            android:layout_width="@dimen/trading_history_realized_symbol_width"
            android:layout_height="wrap_content"
            android:maxLines="2"
            style="@style/TypeStyles.HeadingXSmall"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_realized"
            android:tag="binding_2"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/spacing_8"
            style="@style/TypeStyles.BodyXSmall"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="end|center_vertical"
            android:id="@+id/tv_realized_date"
            android:tag="binding_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/trading_history_realized_date_width"
            style="@style/TypeStyles.BodyXSmall"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:id="@+id/v_bottom_divider"
        android:background="?attr/themeColorDividerThin"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/uikit_divider_thin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
