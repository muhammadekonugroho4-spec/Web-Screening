<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:tag="layout/item_stream_suggested_user_friend_empty_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/spacing_20"
    android:paddingVertical="@dimen/item_gap_45">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Temanmu Belum Ditemukan"
        style="@style/TypeStyles.HeadingLarge"/>
    <TextView
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_10"
        android:text="Namun kamu akan terima notifikasi saat mereka mulai bergabung ke Stockbit."
        android:layout_marginHorizontal="@dimen/spacing_32"
        style="@style/TypeStyles.BodySmall"/>
    <TextView
        android:textColor="?attr/themeColorTextGreen"
        android:id="@+id/btnRecommendation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_14"
        android:text="Lihat Rekomendasi"
        android:textAllCaps="false"
        android:paddingHorizontal="@dimen/item_gap_20"
        android:paddingVertical="12.5dp"
        style="@style/TypeStyles.HeadingRegular"/>
</LinearLayout>
