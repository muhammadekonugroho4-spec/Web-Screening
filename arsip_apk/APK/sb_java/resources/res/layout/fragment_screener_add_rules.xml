<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_screener_add_rules_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/apl_add_rules"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Sb.Widget.AppBar">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_add_rules"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <TextView
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:id="@+id/tv_toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TypeStyles.HeadingLarge"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_0"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/apl_add_rules">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_20"
            android:paddingVertical="@dimen/spacing_16">
            <RelativeLayout
                android:id="@+id/rl_select_ratio"
                android:background="@drawable/bg_selector_border_gray_rounded_outline"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_48"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:gravity="center_vertical"
                    android:id="@+id/tv_select_ratio"
                    android:paddingLeft="@dimen/spacing_16"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/title_screener_rules_select_ratio_title"
                    android:layout_alignParentLeft="true"
                    android:paddingEnd="@dimen/spacing_16"
                    android:layout_alignParentStart="true"
                    style="@style/SbTextView.ListTitle"/>
                <ImageView
                    android:id="@+id/iv_select_ratio"
                    android:layout_width="@dimen/width_24"
                    android:layout_height="@dimen/height_24"
                    android:scaleType="centerInside"
                    android:layout_centerVertical="true"
                    android:rotation="180"
                    android:layout_marginEnd="@dimen/item_gap_m"
                    android:layout_alignParentEnd="true"
                    app:srcCompat="@drawable/back_toolbar"/>
            </RelativeLayout>
            <LinearLayout
                android:id="@+id/ll_ratio_comparison"
                android:background="@drawable/bg_screener_item_selected"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_48"
                android:layout_marginTop="@dimen/spacing_16"
                app:layout_constraintTop_toBottomOf="@+id/rl_select_ratio">
                <TextView
                    android:textColorHint="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_lower_than"
                    android:background="@drawable/bg_screener_item_selected"
                    android:padding="@dimen/item_gap_m"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/title_screener_rules_comparison_lower_than_title"
                    android:layout_weight="1"
                    android:textAlignment="gravity"
                    style="@style/SbTextView.PageTitle"/>
                <TextView
                    android:textColorHint="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_greater_than"
                    android:background="@drawable/bg_screener_item_not_selected"
                    android:padding="@dimen/item_gap_m"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/title_screener_rules_comparison_greater_than_title"
                    android:layout_weight="1"
                    android:textAlignment="gravity"
                    style="@style/SbTextView.PageTitle"/>
                <TextView
                    android:textColorHint="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_greater_than_equals"
                    android:background="@drawable/bg_screener_item_not_selected"
                    android:padding="@dimen/item_gap_m"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/title_screener_rules_comparison_greater_equals_title"
                    android:layout_weight="1"
                    android:textAlignment="gravity"
                    style="@style/SbTextView.PageTitle"/>
                <TextView
                    android:textColorHint="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_lower_than_equals"
                    android:background="@drawable/bg_screener_item_not_selected"
                    android:padding="@dimen/item_gap_m"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/title_screener_rules_comparison_lower_equals_title"
                    android:layout_weight="1"
                    android:textAlignment="gravity"
                    style="@style/SbTextView.PageTitle"/>
                <TextView
                    android:textColorHint="@color/black"
                    android:gravity="center"
                    android:id="@+id/tv_equals"
                    android:background="@drawable/bg_screener_item_not_selected"
                    android:padding="@dimen/item_gap_m"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="@string/title_screener_rules_comparison_equals_title"
                    android:layout_weight="1"
                    android:textAlignment="gravity"
                    style="@style/SbTextView.PageTitle"/>
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_ratio_comparison"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                app:errorEnabled="false"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@+id/ll_ratio_comparison">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_ratio_comparison"
                    android:background="@drawable/bg_input_selector_rounded_m"
                    android:paddingLeft="@dimen/spacing_16"
                    android:nextFocusDown="@+id/btnScreenerRulesScreener"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_48"
                    android:hint="@string/hint_screener_enter_comparing_value"
                    android:ems="10"
                    android:maxLength="15"
                    android:inputType="numberDecimal"
                    android:paddingEnd="@dimen/spacing_16"
                    style="@style/SbEditTextStyle"/>
            </com.google.android.material.textfield.TextInputLayout>
            <RelativeLayout
                android:id="@+id/rl_ratio_comparison"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                app:layout_constraintTop_toBottomOf="@+id/til_ratio_comparison">
                <ImageView
                    android:id="@+id/iv_cross_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_6"
                    android:src="0x7f080641"
                    android:paddingStart="@dimen/spacing_16"
                    android:paddingEnd="@dimen/spacing_16"
                    app:tint="?attr/themeIconTintColor"/>
                <RelativeLayout
                    android:id="@+id/rl_select_ratio_comparison"
                    android:background="@drawable/bg_selector_border_gray_rounded_outline"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/clickable_size_48"
                    android:layout_marginTop="@dimen/item_gap_m"
                    android:layout_below="@+id/iv_cross_layout">
                    <TextView
                        android:gravity="center_vertical"
                        android:id="@+id/tv_select_ratio_comparison"
                        android:paddingLeft="@dimen/spacing_16"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/title_screener_rules_select_ratio_title"
                        android:paddingEnd="@dimen/spacing_16"
                        style="@style/SbTextView.ListTitle"/>
                    <ImageView
                        android:id="@+id/iv_select_ratio_comparison"
                        android:layout_width="@dimen/width_24"
                        android:layout_height="@dimen/height_24"
                        android:layout_marginRight="@dimen/item_gap_m"
                        android:scaleType="centerInside"
                        android:layout_centerVertical="true"
                        android:rotation="180"
                        android:layout_alignParentEnd="true"
                        app:srcCompat="@drawable/back_toolbar"/>
                </RelativeLayout>
            </RelativeLayout>
            <Button
                android:id="@+id/btn_done"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_40"
                android:layout_marginTop="@dimen/spacing_24"
                android:text="@string/lbl_btn_done"
                app:layout_constraintTop_toBottomOf="@+id/rl_ratio_comparison"
                style="@style/SbBtn.PrimaryFullWidthFloating"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
