<?xml version="1.0" encoding="utf-8"?>
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vf_active_alert"
    android:tag="layout/fragment_active_alert_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/sfl_active_alert"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/FBShimmerFrameLayout">
        <LinearLayout
            android:orientation="vertical"
            android:tag="binding_1"
            android:paddingTop="@dimen/spacing_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include layout="@layout/skeleton_active_alert"/>
            <include layout="@layout/skeleton_active_alert"/>
            <include layout="@layout/skeleton_active_alert"/>
            <include layout="@layout/skeleton_active_alert"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/srl_alert_active"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="vertical"
                android:id="@+id/rv_alert"
                android:paddingTop="@dimen/alert_margin_top_list"
                android:paddingBottom="@dimen/spacing_12"
                android:visibility="visible"
                android:scrollbars="vertical"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_blurry_price_alert"
                android:paddingTop="@dimen/spacing_12"
                android:paddingBottom="@dimen/spacing_12"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_10"
                android:src="?attr/themeBackgroundBlurryPriceAlert"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <RelativeLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/tvMainAlertError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/msg_loading_alert_company_info_error"
            android:layout_centerHorizontal="true"
            style="@style/TypeStyles.BodyRegular"/>
        <com.stockbit.uikit.button.FloatingButton
            android:id="@+id/btnMainAlertReload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_6"
            android:text="@string/btn_click_to_refresh"
            android:layout_below="@+id/tvMainAlertError"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <include
        android:id="@+id/comp_empty_state"
        layout="@layout/comp_alert_empty_state"/>
</ViewFlipper>
