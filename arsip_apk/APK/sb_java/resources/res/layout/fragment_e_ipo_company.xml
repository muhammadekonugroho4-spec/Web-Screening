<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_e_ipo_company_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">
        <TextView
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/e_ipo_company_title"
            style="@style/SbTextView.PageTitle"/>
    </androidx.appcompat.widget.Toolbar>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/srl_e_ipo_company_list"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/cl_e_ipo_company"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/abl_e_ipo_company"
                android:background="?attr/themeColorSurfaceDefault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stateListAnimator="@null"
                app:elevation="0dp"
                app:liftOnScroll="false">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_scrollFlags="scroll">
                    <TextView
                        android:id="@+id/tv_e_ipo_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_l"
                        android:text="@string/e_ipo_company_title"
                        android:textAlignment="textStart"
                        android:layout_marginStart="@dimen/item_gap_20"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/SbTextView.PageTitle"/>
                    <ImageView
                        android:id="@+id/iv_e_ipo_icon"
                        android:layout_width="@dimen/item_gap_18"
                        android:layout_height="@dimen/item_gap_18"
                        android:contentDescription="@string/e_ipo_company_title"
                        android:layout_marginStart="@dimen/item_gap_s"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_e_ipo_title"
                        app:layout_constraintStart_toEndOf="@+id/tv_e_ipo_title"
                        app:layout_constraintTop_toTopOf="@+id/tv_e_ipo_title"
                        app:srcCompat="@drawable/ic_e_ipo_onboarding_one_icon"/>
                    <TextView
                        android:id="@+id/tv_e_ipo_onboarding_description"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_l"
                        android:text="@string/e_ipo_company_description"
                        android:lineSpacingExtra="@dimen/item_gap_7"
                        android:textAlignment="textStart"
                        android:layout_marginEnd="@dimen/item_gap_l"
                        app:layout_constraintEnd_toStartOf="@+id/iv_e_ipo_illustration"
                        app:layout_constraintStart_toStartOf="@+id/tv_e_ipo_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_e_ipo_title"
                        style="@style/SbTextView.Description"/>
                    <ImageView
                        android:id="@+id/iv_e_ipo_illustration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/e_ipo_company_title"
                        android:layout_marginEnd="@dimen/item_gap_20"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_e_ipo_title"
                        app:srcCompat="@drawable/ic_e_ipo_company"/>
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/cv_e_ipo_coh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@+id/iv_e_ipo_illustration"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:background="?attr/themeColorSurfaceDefault"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tv_e_ipo_company_list_title"
                        android:background="@drawable/bg_border_gray_rounded"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_24"
                        android:text="@string/e_ipo_company_sub_title"
                        android:drawablePadding="8dp"
                        android:textAlignment="textStart"
                        android:layout_marginStart="@dimen/item_gap_20"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp"
                        app:drawableEndCompat="0x7f080612"
                        app:drawableTint="?attr/themeColorIconDefault"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/SbTextView.PageTitle"/>
                    <ImageView
                        android:id="@+id/iv_underwriter_view_mode"
                        android:background="@drawable/bg_border_gray_rounded"
                        android:padding="4dp"
                        android:visibility="gone"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="20dp"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_e_ipo_company_list_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/tv_e_ipo_company_list_title"
                        app:srcCompat="@drawable/ic_stockbit_table"/>
                    <HorizontalScrollView
                        android:id="@+id/hsvCompanyEIpoHeader"
                        android:scrollbars="none"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_s"
                        android:layout_marginBottom="@dimen/item_gap_s"
                        android:fillViewport="true"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_e_ipo_company_list_title">
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/cg_company_e_ipo_header"
                            android:background="?attr/themeColorSurfaceDefault"
                            android:paddingLeft="@dimen/item_gap_20"
                            android:paddingTop="@dimen/item_gap_m"
                            android:paddingRight="@dimen/item_gap_20"
                            android:paddingBottom="@dimen/item_gap_m"
                            android:clipToPadding="false"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="@dimen/item_gap_s"
                            app:singleLine="true"
                            app:singleSelection="true"/>
                    </HorizontalScrollView>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.appbar.AppBarLayout>
            <ViewFlipper
                android:id="@+id/vf_company_e_ipo_item"
                android:tag="binding_2"
                android:background="?attr/themeColorSurfaceDefault"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:measureAllChildren="true"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">
                <include
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    layout="@layout/comp_empty_e_ipo_action"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_e_ipo_company"
                    android:paddingBottom="@dimen/item_gap_34"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </ViewFlipper>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/cv_underwriter"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
            <com.stockbit.common.uikit.BitRoundedLayout
                android:layout_gravity="center"
                android:tag="binding_3"
                android:paddingTop="@dimen/item_gap_14"
                android:paddingBottom="@dimen/item_gap_14"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/item_gap_l"
                android:paddingEnd="@dimen/item_gap_l"
                app:cornerRadius="@dimen/shape_radius_8"
                app:roundedColor="@color/highempasis_light_50">
                <ImageView
                    android:id="@+id/iv_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_loading_webview"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:textColor="@color/white"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_xxs"
                    android:text="@string/e_ipo_webview_loading"
                    android:textAlignment="textStart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_loading"
                    style="@style/SbTextView.PageTitle"/>
            </com.stockbit.common.uikit.BitRoundedLayout>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
