<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_payment_limit_method_item_0"
    android:background="@drawable/bg_border_transparent_gray"
    android:paddingBottom="@dimen/item_gap_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/item_gap_16">
    <TextView
        android:id="@+id/tv_title"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingRegular"/>
    <include
        android:id="@+id/comp_day_trade_multiplier"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintStart_toEndOf="@+id/tv_title"
        app:layout_constraintTop_toTopOf="@+id/tv_title"
        layout="@layout/comp_buy_day_trade_multiplier_periwinkle_medium"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/sfl_loading_amount"
        android:layout_width="@dimen/width_100"
        android:layout_height="@dimen/height_22"
        android:layout_marginStart="@dimen/spacing_8"
        app:layout_constraintStart_toEndOf="@+id/comp_day_trade_multiplier"
        app:layout_constraintTop_toTopOf="@+id/tv_title">
        <View
            android:background="@drawable/bg_rounded_6_gray"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <TextView
        android:id="@+id/tv_amount"
        android:background="@drawable/border_gray_rounded_15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_8"
        android:paddingHorizontal="@dimen/spacing_12"
        android:paddingVertical="3dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintStart_toEndOf="@+id/comp_day_trade_multiplier"
        app:layout_constraintTop_toTopOf="@+id/tv_title"
        style="@style/TypeStyles.HeadingXSmall"/>
    <TextView
        android:textColor="@color/highgray_light"
        android:id="@+id/tv_amount_desc"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:layout_marginEnd="@dimen/spacing_16"
        app:layout_constraintEnd_toStartOf="@+id/fl_controller_selection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/TypeStyles.BodyXSmall"/>
    <FrameLayout
        android:id="@+id/fl_controller_selection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        app:layout_constraintBottom_toBottomOf="@+id/tv_amount_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.stockbit.uikit.control.ControlRadioButton
            android:layout_gravity="center_vertical"
            android:id="@+id/controlRadioButton"
            android:clickable="false"
            android:layout_width="@dimen/width_30"
            android:layout_height="@dimen/height_24"
            app:radioType="tick"/>
        <com.stockbit.uikit.control.ControlRadioButton
            android:layout_gravity="center_vertical"
            android:id="@+id/crb_selected"
            android:clickable="false"
            android:layout_width="@dimen/width_30"
            android:layout_height="@dimen/height_24"
            android:paddingEnd="@dimen/spacing_16"
            app:radioType="round"/>
        <com.stockbit.uikit.button.EllipseButton
            android:layout_gravity="center_vertical"
            android:id="@+id/btn_activate"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_activate"
            app:ellipseButtonSize="smallSize"/>
    </FrameLayout>
    <include
        android:id="@+id/comp_option_day_trade_information"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_amount_desc"
        layout="@layout/comp_option_day_trade_information"/>
</androidx.constraintlayout.widget.ConstraintLayout>
