<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme"
    android:tag="layout/fragment_withdrawal_succes_dialog_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/parent_withdrawal_dialog_success"
        android:background="@drawable/bg_top_rounded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_40"
            app:srcCompat="?attr/themeIconWithdrawProcess"/>
        <TextView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:layout_marginBottom="@dimen/item_gap_8"
            android:text="@string/setting_withdraw_process_foreign"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:textColor="?attr/themeColorTextGreen"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_withdrawal_success_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="gravity"
            style="@style/TypeStyles.Nominal"/>
        <RelativeLayout
            android:background="?attr/themeTnc"
            android:paddingTop="@dimen/item_gap_12"
            android:paddingBottom="@dimen/item_gap_12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:paddingStart="@dimen/item_gap_16"
            android:paddingEnd="@dimen/item_gap_16"
            android:layout_marginStart="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/item_gap_20">
            <ImageView
                android:id="@+id/iv_withdrawal_success_dialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_info_blue"
                android:layout_centerVertical="true"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_desc_success_foreign_dialog"
                android:layout_toRightOf="@+id/iv_withdrawal_success_dialog"
                android:layout_marginStart="@dimen/item_gap_16"
                style="@style/TypeStyles.BodyXSmall"/>
        </RelativeLayout>
        <Button
            android:textColor="@color/white"
            android:id="@+id/btn_withdrawal_dialog_success"
            android:background="@drawable/btn_green_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_40"
            android:layout_marginBottom="@dimen/item_gap_40"
            android:foreground="?attr/selectableItemBackground"
            android:text="@string/button_done"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/item_gap_20"
            style="@style/TypeStyles.HeadingRegular"/>
    </LinearLayout>
</RelativeLayout>
