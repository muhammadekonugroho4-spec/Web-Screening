<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/fragment_order_queue_price_picker_dialog_0"
    android:background="@drawable/bg_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_handle"
        android:layout_width="@dimen/width_35"
        android:layout_height="5dp"
        android:layout_marginTop="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/bg_bottomsheetdialog_handle"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12">
        <TextView
            android:textColor="?attr/themeColorTextTetriary"
            android:id="@+id/tv_cancel"
            android:layout_width="@dimen/width_60"
            android:layout_height="wrap_content"
            android:text="@string/order_queue_price_picker_cancel"
            android:layout_marginStart="@dimen/spacing_20"
            android:paddingVertical="18.5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_handle"
            style="@style/TypeStyles.HeadingRegular"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textColor="?attr/themeColorTextTetriary"
            android:gravity="end"
            android:id="@+id/tv_done"
            android:layout_width="@dimen/width_60"
            android:layout_height="wrap_content"
            android:text="@string/order_queue_price_picker_done"
            android:layout_marginEnd="@dimen/spacing_20"
            android:paddingVertical="18.5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_handle"
            style="@style/TypeStyles.HeadingRegular"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/pb_loading"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="295dp"
        android:indeterminateTint="@color/green_text"/>
    <NumberPicker
        android:theme="@style/OrderQueueNumberPickerTheme"
        android:layout_gravity="center"
        android:id="@+id/np_prices"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/spacing_20"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/ll_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="295dp">
        <TextView
            android:textColor="?attr/themeColorTextTetriary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/order_queue_load_failed_label"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:textStyle="bold"
            android:textColor="?attr/themeColorBorderGreen"
            android:gravity="center"
            android:id="@+id/tv_error_try_again"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_6"
            android:text="@string/order_queue_load_failed_retry_label"
            android:drawablePadding="@dimen/spacing_4"
            app:drawableStartCompat="@drawable/ic_refresh_ccw"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
