<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/parentCompEmptyDataTradingHistory"
    android:tag="layout/comp_empty_data_trading_stockbit_realized_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_trading_history_empty_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_16"
        android:layout_centerHorizontal="true"
        app:srcCompat="?attr/themeIconEmptyJar"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_trading_history_title_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_marginBottom="@dimen/spacing_6"
        android:text="@string/empty_realized_title"
        android:layout_below="@+id/iv_trading_history_empty_img"
        android:layout_marginHorizontal="@dimen/spacing_16"
        style="@style/TypeStyles.HeadlineRegular"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="center"
        android:id="@+id/tv_trading_history_subtitle_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/empty_realized_desc"
        android:layout_below="@+id/tv_trading_history_title_empty"
        android:layout_marginHorizontal="@dimen/spacing_16"
        style="@style/TypeStyles.BodyRegular"/>
</RelativeLayout>
