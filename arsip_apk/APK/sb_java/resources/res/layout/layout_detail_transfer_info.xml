<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_transfer_info"
    android:tag="layout/layout_detail_transfer_info_0"
    android:background="@drawable/bg_theme_content_gray_border_4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:padding="@dimen/item_gap_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tranfer_id"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/item_gap_18"
                style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/transaction_id"
                android:tag="binding_2"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:layout_marginEnd="@dimen/item_gap_4"
                style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
            <include
                android:layout_width="@dimen/width_140"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:layout_marginEnd="@dimen/item_gap_4"
                layout="@layout/skeleton_horizontal"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_copy"
                android:tag="binding_3"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="@dimen/item_gap_18"
                android:layout_height="@dimen/item_gap_18"
                app:srcCompat="@drawable/ic_copy_fold"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:tag="binding_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/orderlist_detail_title_status"
                android:layout_weight="1"
                style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="end"
                android:tag="binding_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
            <include
                android:layout_width="@dimen/width_140"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:layout_marginEnd="@dimen/item_gap_4"
                layout="@layout/skeleton_horizontal"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:tag="binding_6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/date_transfer"
                android:layout_weight="1"
                style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
            <TextView
                android:gravity="end"
                android:tag="binding_7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
            <include
                android:layout_width="@dimen/width_140"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:layout_marginEnd="@dimen/item_gap_4"
                layout="@layout/skeleton_horizontal"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:tag="binding_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/date_done"
                android:layout_weight="1"
                style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
            <TextView
                android:gravity="end"
                android:tag="binding_9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
            <include
                android:layout_width="@dimen/width_140"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:layout_marginEnd="@dimen/item_gap_4"
                layout="@layout/skeleton_horizontal"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
