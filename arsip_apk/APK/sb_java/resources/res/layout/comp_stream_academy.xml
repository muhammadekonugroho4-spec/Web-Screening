<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentAcademy"
    android:tag="layout/comp_stream_academy_0"
    android:background="?attr/themeComponent"
    android:padding="@dimen/item_gap_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/item_gap_8"
        app:cardElevation="0dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="?attr/themeColorSurfaceDefault"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/text_size_16"
                android:id="@+id/tv_title_banner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_32"
                android:text="@string/academy_title"
                android:layout_marginStart="@dimen/item_gap_20"
                app:layout_constraintEnd_toStartOf="@+id/iv_banner"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/SbTextView.ListTitle.Highempasis.Bold"/>
            <TextView
                android:textSize="@dimen/text_size_13"
                android:textColor="?attr/titleTextColorHighgray"
                android:id="@+id/tv_msg_banner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_8"
                android:text="@string/academy_subtitle"
                android:layout_marginStart="@dimen/item_gap_20"
                app:layout_constraintEnd_toStartOf="@+id/iv_banner"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_banner"
                style="@style/SbTextView.Caption.Highgray"/>
            <ImageView
                android:id="@+id/iv_banner"
                android:layout_width="142dp"
                android:layout_height="142dp"
                android:layout_marginTop="@dimen/item_gap_24"
                android:layout_marginBottom="@dimen/item_gap_24"
                android:layout_marginEnd="@dimen/item_gap_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_stream_academy"/>
            <Button
                android:textColor="@color/white"
                android:id="@+id/btn_register"
                android:background="@drawable/border_green_rounded"
                android:layout_width="70dp"
                android:layout_height="@dimen/item_gap_28"
                android:layout_marginTop="@dimen/item_gap_16"
                android:layout_marginBottom="@dimen/item_gap_16"
                android:foreground="?attr/selectableItemBackground"
                android:text="@string/academy_mulai"
                android:textAllCaps="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tv_msg_banner"
                app:layout_constraintTop_toBottomOf="@+id/tv_msg_banner"
                app:layout_constraintVertical_bias="0"
                style="@style/SbTextView.BodyDefault.Bold"/>
            <ImageButton
                android:id="@+id/ivStreamAcademyClose"
                android:background="@null"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="@dimen/clickable_size_24"
                android:layout_height="@dimen/clickable_size_24"
                android:layout_marginTop="@dimen/item_gap_14"
                android:layout_marginEnd="@dimen/item_gap_14"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="0x7f080644"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
