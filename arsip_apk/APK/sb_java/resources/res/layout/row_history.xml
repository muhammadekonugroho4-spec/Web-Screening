<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/row_history_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_14"
        android:id="@+id/tv_month"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:layout_marginStart="@dimen/item_gap_20"
        style="@style/SbTextView.BodyDefault.MediumEmphasis"/>
    <RelativeLayout
        android:id="@+id/rl_content"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_80">
        <RelativeLayout
            android:id="@+id/rl_image_parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:layout_marginStart="@dimen/item_gap_20">
            <ImageView
                android:id="@+id/iv_history_success"
                android:visibility="gone"
                android:layout_width="@dimen/avatar_size_36"
                android:layout_height="@dimen/avatar_size_36"
                app:srcCompat="?attr/themeHistorySuccess"/>
            <ImageView
                android:id="@+id/iv_history_pending"
                android:visibility="gone"
                android:layout_width="@dimen/avatar_size_36"
                android:layout_height="@dimen/avatar_size_36"
                app:srcCompat="?attr/themeHistoryPending"/>
            <ImageView
                android:id="@+id/iv_history_failed"
                android:visibility="gone"
                android:layout_width="@dimen/avatar_size_36"
                android:layout_height="@dimen/avatar_size_36"
                app:srcCompat="?attr/themeHistoryFailed"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:id="@+id/tv_history_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:text="@string/n_dash"
            android:layout_toRightOf="@+id/rl_image_parent"
            android:paddingStart="@dimen/item_gap_16"
            android:paddingEnd="@dimen/item_gap_16"
            style="@style/SbTextView.BodyDefault.Bold.Semi"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:id="@+id/tv_history_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_xxs"
            android:layout_marginBottom="@dimen/item_gap_m"
            android:text="@string/n_dash"
            android:layout_toRightOf="@+id/rl_image_parent"
            android:layout_below="@+id/tv_history_status"
            android:paddingStart="@dimen/item_gap_16"
            android:paddingEnd="@dimen/item_gap_16"
            style="@style/SbTextView.BodySecondary"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_history_value"
            android:paddingTop="@dimen/item_gap_xxs"
            android:paddingBottom="@dimen/item_gap_xxs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:text="@string/n_dash"
            android:layout_toRightOf="@+id/tv_history_status"
            android:textAlignment="gravity"
            android:paddingStart="@dimen/item_gap_20"
            android:paddingEnd="@dimen/item_gap_20"
            android:layout_alignParentEnd="true"
            style="@style/SbTextView.BodyDefault.Bold"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_bank_account"
            android:paddingTop="@dimen/item_gap_xxs"
            android:paddingBottom="@dimen/item_gap_xxs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/n_dash"
            android:layout_toRightOf="@+id/tv_history_status"
            android:layout_below="@+id/tv_history_value"
            android:textAlignment="gravity"
            android:paddingStart="@dimen/item_gap_20"
            android:paddingEnd="@dimen/item_gap_20"
            android:layout_alignParentEnd="true"
            style="@style/SbTextView.BodySecondary"/>
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</LinearLayout>
