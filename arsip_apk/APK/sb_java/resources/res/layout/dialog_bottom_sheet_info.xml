<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_parent_info"
    android:tag="layout/dialog_bottom_sheet_info_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_16"
    app:behavior_draggable="false"
    app:behavior_peekHeight="@dimen/spacing_0"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_container"
        android:background="@drawable/bg_top_rounded_16"
        android:paddingBottom="@dimen/spacing_16"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/spacing_16"
        android:translationY="@dimen/spacing_20"
        android:paddingEnd="@dimen/spacing_20"
        android:elevation="30dp">
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_40"
            android:text="@string/text_title_access_reach_limit"
            android:layout_marginStart="@dimen/spacing_20"
            app:layout_constraintEnd_toStartOf="@+id/iv_close_open_access"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadlineLarge"/>
        <ImageView
            android:id="@+id/iv_close_open_access"
            android:visibility="gone"
            android:layout_width="@dimen/spacing_24"
            android:layout_height="@dimen/spacing_24"
            android:src="@drawable/uikit_ic_stockbit_top_bar_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/tv_title"
            app:layout_constraintTop_toTopOf="@+id/tv_title"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:id="@+id/tv_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="@string/text_description_access_reach_limit"
            android:layout_marginStart="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            style="@style/TypeStyles.BodyRegular"/>
        <com.stockbit.uikit.button.PrimaryButton
            android:id="@+id/btn_open_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_36"
            android:text="@string/text_open_access"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/spacing_20"
            app:layout_constraintBottom_toTopOf="@+id/btn_subscribe"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_description"/>
        <com.stockbit.uikit.button.SecondaryButton
            android:id="@+id/btn_subscribe"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="@string/text_continue_subscribe"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/spacing_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_open_access"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/v_shadow"
        android:background="@drawable/bg_paywall_shadow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_36"/>
</FrameLayout>
