<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_market_order_introduction_0"
    android:paddingBottom="@dimen/item_gap_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/item_gap_20">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lav_market_order_introduction"
        android:layout_width="0dp"
        android:layout_height="390dp"
        android:layout_marginTop="@dimen/item_gap_20"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="?attr/themeMarketOrderIntroductionAnimation"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_title_market_order_introduction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:text="@string/title_market_order_introduction"
        android:textAlignment="gravity"
        app:layout_constraintTop_toBottomOf="@+id/lav_market_order_introduction"
        style="@style/TypeStyles.HeadlineRegular"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_subtitle_market_order_introduction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        android:text="@string/subtitle_market_order_introduction"
        android:textAlignment="gravity"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_market_order_introduction"
        style="@style/TypeStyles.BodyRegular"/>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/btn_positive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32"
        android:text="@string/title_market_order_positive_button"
        app:layout_constraintTop_toBottomOf="@+id/tv_subtitle_market_order_introduction"/>
    <com.stockbit.uikit.button.FloatingButton
        android:id="@+id/btn_negative"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:text="@string/title_market_order_negative_button"
        app:layout_constraintTop_toBottomOf="@+id/btn_positive"/>
</androidx.constraintlayout.widget.ConstraintLayout>
