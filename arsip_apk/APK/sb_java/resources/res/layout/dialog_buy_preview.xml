<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_round"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true">
    <RelativeLayout
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true">
        <RelativeLayout
            android:id="@+id/popup_logout_headerWrapper"
            android:background="?attr/themeDialogBackgroundColor"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="20sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:text="Preview Order"
                android:layout_centerHorizontal="true"
                style="@style/SbTextView.ListTitle"/>
        </RelativeLayout>
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/popup_logout_headerWrapper"/>
        <RelativeLayout
            android:id="@+id/popup_logout_infoWrapper"
            android:paddingTop="10dp"
            android:paddingBottom="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_below="@+id/popup_logout_headerWrapper"
            android:layout_centerHorizontal="true"
            android:paddingStart="10dp"
            android:paddingEnd="16dp">
            <TextView
                android:textColor="@color/gray_text"
                android:id="@+id/stockcode"
                android:padding="6dp"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Stock"
                android:layout_alignParentStart="true"
                style="@style/SbTextView.BodyDefault"/>
            <TextView
                android:id="@+id/symbol"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AALI"
                android:layout_marginStart="5dp"
                android:layout_toEndOf="@+id/stockcode"
                style="@style/SbTextView.BodyDefault"/>
            <TextView
                android:textColor="@color/gray_text"
                android:id="@+id/totalCost"
                android:padding="6dp"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Price"
                android:layout_below="@+id/stockcode"
                android:layout_alignParentStart="true"
                style="@style/SbTextView.BodyDefault"/>
            <TextView
                android:id="@+id/cost"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:layout_below="@+id/stockcode"
                android:layout_marginStart="5dp"
                android:layout_toEndOf="@+id/totalCost"
                style="@style/SbTextView.BodyDefault"/>
            <TextView
                android:textColor="@color/gray_text"
                android:id="@+id/totalPrice"
                android:padding="6dp"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Amount"
                android:layout_below="@+id/totalCost"
                style="@style/SbTextView.BodyDefault"/>
            <TextView
                android:id="@+id/price"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:layout_below="@+id/cost"
                android:layout_marginStart="5dp"
                android:layout_toEndOf="@+id/totalPrice"
                style="@style/SbTextView.BodyDefault"/>
            <TextView
                android:textColor="@color/gray_text"
                android:id="@+id/totalLot"
                android:padding="6dp"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="Lot"
                android:layout_below="@+id/totalPrice"
                style="@style/SbTextView.BodyDefault"/>
            <TextView
                android:id="@+id/lot"
                android:padding="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:layout_below="@+id/price"
                android:layout_marginStart="5dp"
                android:layout_toEndOf="@+id/totalLot"
                style="@style/SbTextView.BodyDefault"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/desc_order"
            android:paddingTop="10dp"
            android:paddingBottom="15dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/popup_logout_infoWrapper"
            android:layout_centerHorizontal="true"
            android:paddingStart="10dp"
            android:paddingEnd="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="* Your Buy Amount differs from the input"
                style="@style/SbTextView.BodyDefault"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="   Amount because of the rounding down of odd"
                style="@style/SbTextView.BodyDefault"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="   lot to 4 decimal place."
                style="@style/SbTextView.BodyDefault"/>
        </LinearLayout>
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_below="@+id/desc_order"/>
    </RelativeLayout>
</RelativeLayout>
