<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_parent"
    android:tag="layout/fragment_broker_flow_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:layout_centerHorizontal="true"
            app:contentInsetLeft="@dimen/item_gap_null"
            app:contentInsetStart="@dimen/item_gap_null"
            app:contentInsetStartWithNavigation="@dimen/item_gap_null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_scrollFlags="enterAlways|scroll"
            app:titleTextAppearance="@style/SbTextView.PageTitle">
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tv_title_center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/broker_flow_title"
                    android:maxLines="2"
                    app:autoSizeMaxTextSize="@dimen/text_title"
                    app:autoSizeMinTextSize="@dimen/text_body"
                    app:autoSizeTextType="none"
                    style="@style/TypeStyles.HeadingLarge"/>
                <ImageView
                    android:id="@+id/iv_info"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="@dimen/spacing_6"
                    app:srcCompat="@drawable/ic_info"/>
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar">
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/sfl_chart_type"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_6"
                android:layout_marginHorizontal="@dimen/spacing_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:background="@drawable/bg_rounded_6_gray"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:backgroundTint="?attr/themeShimmer"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_14">
                        <View
                            android:background="@drawable/bg_circle"
                            android:layout_width="@dimen/width_64"
                            android:layout_height="@dimen/height_28"
                            android:backgroundTint="?attr/themeShimmer"/>
                        <View
                            android:background="@drawable/bg_circle"
                            android:layout_width="@dimen/width_72"
                            android:layout_height="@dimen/height_28"
                            android:layout_marginStart="@dimen/spacing_8"
                            android:backgroundTint="?attr/themeShimmer"/>
                    </LinearLayout>
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/cv_broker_flow_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.stockbit.uikit.chips.SBChipsGroup
                android:id="@+id/sbcg_chart_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_14"
                android:layout_marginStart="@dimen/spacing_16"
                app:chipsActionMode="single_pick"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cv_broker_flow_filter">
                <com.stockbit.uikit.chips.SBChips
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipsSelected="true"
                    app:chipsText="Value"/>
                <com.stockbit.uikit.chips.SBChips
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipsText="Volume"/>
            </com.stockbit.uikit.chips.SBChipsGroup>
            <ImageView
                android:id="@+id/iv_prev_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_chevron_arrow_left"
                android:contentDescription="@null"
                android:paddingEnd="@dimen/item_gap_13"
                app:layout_constraintBottom_toBottomOf="@+id/tv_date"
                app:layout_constraintEnd_toStartOf="@+id/tv_date"
                app:layout_constraintTop_toTopOf="@+id/tv_date"
                app:tint="@color/green_text"/>
            <TextView
                android:textColor="?attr/themeColorTextGreen"
                android:gravity="center_vertical"
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/spacing_8"
                app:drawableEndCompat="@drawable/ic_calendar_low_green"
                app:layout_constraintBottom_toBottomOf="@+id/sbcg_chart_type"
                app:layout_constraintEnd_toStartOf="@+id/iv_next_date"
                app:layout_constraintTop_toTopOf="@+id/sbcg_chart_type"
                style="@style/TypeStyles.BodySmall"/>
            <ImageView
                android:id="@+id/iv_next_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_chevron_arrow_right"
                android:contentDescription="@null"
                android:paddingStart="@dimen/item_gap_13"
                app:layout_constraintBottom_toBottomOf="@+id/tv_date"
                app:layout_constraintEnd_toStartOf="@+id/spacer_next_date"
                app:layout_constraintTop_toTopOf="@+id/tv_date"/>
            <Space
                android:id="@+id/spacer_next_date"
                android:layout_width="@dimen/width_16"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/iv_next_date"/>
            <com.stockbit.component.securities.brokerflow.chart.StockbitBrokerFlowChart
                android:id="@+id/comp_broker_flow_chart"
                android:paddingBottom="@dimen/spacing_20"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/spacing_16"
                android:paddingHorizontal="@dimen/spacing_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_date"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
