<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_notification_watchlist_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarMainNotificationMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="@dimen/item_gap_null"
        style="@style/Sb.Widget.AppBar">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <RelativeLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/parentToolbarContentContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minHeight="?attr/actionBarSize">
                <TextView
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:id="@+id/tvToolbarTitleName"
                    android:paddingLeft="@dimen/item_gap_l"
                    android:paddingRight="@dimen/item_gap_l"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/title_notification_report"
                    android:singleLine="true"
                    android:layout_centerHorizontal="true"
                    android:textAlignment="gravity"
                    style="@style/TypeStyles.HeadingLarge"/>
            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>
        <View
            android:background="?attr/themeColorBorder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"/>
    </com.google.android.material.appbar.AppBarLayout>
    <ViewFlipper
        android:id="@+id/vfFragmentNotifications"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <FrameLayout
            android:id="@+id/frameNotificationListing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </ViewFlipper>
    <com.stockbit.component.tooltip.SbContainerTooltip
        android:id="@+id/tooltipContainerNotificationWatchlist"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
