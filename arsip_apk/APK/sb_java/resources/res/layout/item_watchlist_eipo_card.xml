<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_watchlist_eipo_card_0"
    android:background="@drawable/rounded_eipo_card_background"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/height_60"
    android:foreground="?attr/selectableItemBackground"
    android:layout_marginStart="@dimen/item_gap_5"
    android:layout_marginEnd="@dimen/item_gap_10">
    <RelativeLayout
        android:id="@+id/rl_company_logo"
        android:background="@drawable/bg_border_circle_gray"
        android:layout_width="@dimen/item_gap_36"
        android:layout_height="@dimen/item_gap_36"
        android:layout_marginStart="@dimen/item_gap_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.mikhaellopez.circularimageview.CircularImageView
            android:id="@+id/civ_company_logo"
            android:tag="binding_1"
            android:layout_width="@dimen/width_30"
            android:layout_height="@dimen/height_30"
            android:scaleType="fitCenter"
            android:layout_centerInParent="true"
            app:civ_border_color="?attr/titleTextColorDowngray"
            app:civ_border_width="@dimen/item_gap_xxxs"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_symbol_company"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAllCaps="true"
        android:layout_marginStart="@dimen/item_gap_7"
        app:layout_constraintBottom_toBottomOf="@+id/rl_company_logo"
        app:layout_constraintEnd_toStartOf="@+id/iv_close"
        app:layout_constraintStart_toEndOf="@+id/rl_company_logo"
        app:layout_constraintTop_toTopOf="@+id/rl_company_logo"
        style="@style/SbTextView.TitleContent"/>
    <ImageView
        android:id="@+id/iv_close"
        android:padding="@dimen/item_gap_12"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/clickable_size_40"
        android:layout_height="@dimen/clickable_size_40"
        android:foreground="?attr/selectableItemBackground"
        android:src="0x7f08063f"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/neutral_light"/>
</androidx.constraintlayout.widget.ConstraintLayout>
