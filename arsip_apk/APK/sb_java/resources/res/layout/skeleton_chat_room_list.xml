<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/item_gap_32"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/item_gap_20">
    <View
        android:id="@+id/viewChatMeSkeleton"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="258dp"
        android:layout_height="@dimen/item_gap_18"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/viewChatMeSkeletonSub"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="127dp"
        android:layout_height="@dimen/item_gap_18"
        android:layout_marginTop="@dimen/item_gap_8"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintEnd_toEndOf="@+id/viewChatMeSkeleton"
        app:layout_constraintTop_toBottomOf="@+id/viewChatMeSkeleton"/>
    <View
        android:id="@+id/viewChatSkeletonAvatar"
        android:background="@drawable/ic_circle_grey"
        android:layout_width="@dimen/avatar_size_default"
        android:layout_height="@dimen/avatar_size_default"
        android:layout_marginTop="@dimen/item_gap_40"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewChatMeSkeletonSub"/>
    <View
        android:id="@+id/viewChatOtherSkeleton"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="258dp"
        android:layout_height="@dimen/item_gap_18"
        android:layout_marginStart="@dimen/item_gap_16"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintStart_toEndOf="@+id/viewChatSkeletonAvatar"
        app:layout_constraintTop_toTopOf="@+id/viewChatSkeletonAvatar"/>
    <View
        android:id="@+id/viewChatOtherSkeletonSub"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="127dp"
        android:layout_height="@dimen/item_gap_18"
        android:layout_marginTop="@dimen/item_gap_8"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintBottom_toBottomOf="@+id/viewChatSkeletonAvatar"
        app:layout_constraintStart_toStartOf="@+id/viewChatOtherSkeleton"
        app:layout_constraintTop_toBottomOf="@+id/viewChatOtherSkeleton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
