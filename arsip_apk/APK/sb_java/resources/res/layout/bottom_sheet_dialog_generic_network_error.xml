<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/bottom_sheet_dialog_generic_network_error_0"
    android:background="@drawable/bg_bottomsheetdialog_generic_network_error"
    android:paddingBottom="@dimen/spacing_40"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/iv_handle"
        android:background="@drawable/bg_bottomsheetdialog_handle"
        android:padding="@dimen/spacing_4"
        android:visibility="gone"
        android:layout_width="@dimen/uikit_bottomsheet_handle_width"
        android:layout_height="@dimen/uikit_bottomsheet_handle_height"
        android:layout_marginTop="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_close"
        android:padding="@dimen/spacing_4"
        android:layout_width="@dimen/icon_placeholder_24"
        android:layout_height="@dimen/icon_placeholder_24"
        android:layout_marginTop="@dimen/spacing_24"
        android:layout_marginRight="@dimen/spacing_20"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_snackbar_close"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_icon_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="iv_close,iv_handle"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_error_icon"
        android:layout_width="wrap_content"
        android:layout_height="120dp"
        android:layout_marginTop="@dimen/spacing_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/barrier_icon_top"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorTextPrimary"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_24"
        android:layout_marginHorizontal="@dimen/spacing_20"
        app:layout_constraintTop_toBottomOf="@+id/iv_error_icon"
        style="@style/TypeStyles.HeadingLarge"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="center"
        android:id="@+id/tv_description"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:layout_marginHorizontal="@dimen/spacing_20"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/TypeStyles.BodyRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
