<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_root"
    android:tag="layout/fragment_mutual_fund_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_company_detail"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:contentInsetLeft="@dimen/item_gap_null"
        app:contentInsetStart="@dimen/item_gap_null"
        app:contentInsetStartWithNavigation="@dimen/item_gap_null"
        app:layout_collapseMode="pin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_scrollFlags="snap">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_floating_company_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:translationZ="@dimen/item_gap_2">
            <TextView
                android:ellipsize="marquee"
                android:layout_gravity="center"
                android:id="@+id/tv_toolbar_company_name"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                style="@style/TypeStyles.HeadingLarge"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_arrow_down_toolbar_company_name"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_4"
                app:srcCompat="@drawable/ic_chevron_down_12"/>
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>
    <ViewFlipper
        android:id="@+id/vf_mutual_fund"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/pb_mutual_fund"
            android:layout_width="@dimen/clickable_size_32"
            android:layout_height="@dimen/clickable_size_32"
            android:indeterminate="true"
            style="@style/Widget.AppCompat.ProgressBar"/>
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/srl_mutual_fund"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/nsv_mutual_fund"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">
                <LinearLayout
                    android:orientation="vertical"
                    android:tag="binding_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include
                        android:id="@+id/layout_header"
                        layout="@layout/comp_mutual_fund_header"/>
                    <include
                        android:id="@+id/layout_summary"
                        layout="@layout/comp_mutual_fund_summary"/>
                    <include
                        android:id="@+id/layout_allocation_asset"
                        layout="@layout/comp_mutual_fund_allocation_asset"/>
                    <include
                        android:id="@+id/layout_top_holding"
                        layout="@layout/comp_mutual_fund_top_holding"/>
                    <include
                        android:id="@+id/layout_files"
                        layout="@layout/comp_mutual_fund_files"/>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_message_container"
            android:tag="binding_4"
            android:background="@drawable/border_black_square"
            android:padding="@dimen/item_gap_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tint="?attr/themeAccent"
                android:contentDescription="@string/btn_tap_to_refresh"
                app:srcCompat="@drawable/ic_loading"/>
            <TextView
                android:textSize="@dimen/default_text_size"
                android:layout_gravity="center"
                android:id="@+id/tv_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_m"
                android:text="@string/btn_tap_to_refresh"
                style="@style/SbTextView.BodyDefault"/>
        </LinearLayout>
    </ViewFlipper>
</LinearLayout>
