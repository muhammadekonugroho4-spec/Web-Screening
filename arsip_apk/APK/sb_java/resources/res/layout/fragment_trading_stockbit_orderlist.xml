<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_trading_stockbit_orderlist_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stockbit.component.banner.BannerView
        android:id="@+id/banner_view"
        android:paddingBottom="@dimen/spacing_4"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <HorizontalScrollView
            android:id="@+id/hsvStockbitOrderlistHeader"
            android:scrollbars="none"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:layout_marginEnd="@dimen/spacing_16"
            app:layout_constraintEnd_toStartOf="@+id/iv_more_option_kebab_menu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.stockbit.uikit.chips.SBChipsGroup
                android:id="@+id/chipStockbitOrderlistHeader"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/spacing_20"
                android:paddingVertical="@dimen/spacing_8"
                app:chipsActionMode="single_pick">
                <com.stockbit.uikit.chips.SBChips
                    android:id="@+id/chip_order"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipsText="@string/title_trading_order"/>
                <com.stockbit.uikit.chips.SBChips
                    android:id="@+id/chip_exercise"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipsText="@string/title_exercise"/>
                <com.stockbit.uikit.chips.SBChips
                    android:id="@+id/chip_cashback"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipsText="@string/referral_cashback"/>
            </com.stockbit.uikit.chips.SBChipsGroup>
        </HorizontalScrollView>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_more_option_kebab_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_16"
            app:layout_constraintBottom_toBottomOf="@+id/hsvStockbitOrderlistHeader"
            app:layout_constraintEnd_toStartOf="@+id/iv_filter"
            app:layout_constraintStart_toEndOf="@+id/hsvStockbitOrderlistHeader"
            app:layout_constraintTop_toTopOf="@+id/hsvStockbitOrderlistHeader"
            app:srcCompat="@drawable/ic_kebab_menu_horizontal"/>
        <ImageView
            android:id="@+id/iv_filter"
            android:tag="binding_1"
            android:background="@drawable/filter_border_inactive"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="?attr/themeIconFilterMore"
            android:layout_marginEnd="@dimen/spacing_20"
            android:paddingHorizontal="@dimen/spacing_10"
            android:paddingVertical="@dimen/spacing_8"
            app:layout_constraintBottom_toBottomOf="@+id/iv_more_option_kebab_menu"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_more_option_kebab_menu"
            app:layout_constraintTop_toTopOf="@+id/iv_more_option_kebab_menu"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/light_type_textwhite"
            android:gravity="center"
            android:layout_gravity="end|top"
            android:id="@+id/tv_filter_badge"
            android:tag="binding_2"
            android:background="@drawable/bg_filter_active_badge"
            android:paddingTop="3dp"
            android:paddingBottom="@dimen/spacing_2"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp"
            android:layout_marginEnd="-8dp"
            android:paddingHorizontal="@dimen/spacing_6"
            app:layout_constraintEnd_toEndOf="@+id/iv_filter"
            app:layout_constraintTop_toTopOf="@+id/iv_filter"
            style="@style/TypeStyles.BodyXXSmall"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar_header"
            android:background="?attr/themeColorSurfaceDefault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stateListAnimator="@null">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_search_history"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_5"
                android:layout_marginBottom="@dimen/spacing_8"
                app:layout_scrollFlags="snap|enterAlways|scroll">
                <EditText
                    android:gravity="center_vertical"
                    android:id="@+id/et_search_input"
                    android:tag="binding_3"
                    android:background="@drawable/bg_border_gray_rounded"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/item_gap_34"
                    android:hint="@string/history_search_stock_or_action"
                    android:layout_centerVertical="true"
                    android:inputType="textCapCharacters"
                    android:imeOptions="actionSearch"
                    android:paddingStart="@dimen/clickable_size_32"
                    android:paddingEnd="@dimen/clickable_size_24"
                    android:layout_marginStart="@dimen/spacing_16"
                    android:layout_marginEnd="@dimen/spacing_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/SbEditTextStyle.SearchHistory"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_history_search_button"
                    android:padding="@dimen/item_gap_xs"
                    android:layout_width="@dimen/clickable_size_20"
                    android:layout_height="@dimen/clickable_size_20"
                    android:scaleType="fitCenter"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/hint_search_content"
                    android:layout_marginStart="@dimen/spacing_6"
                    app:layout_constraintBottom_toBottomOf="@+id/et_search_input"
                    app:layout_constraintStart_toStartOf="@+id/et_search_input"
                    app:layout_constraintTop_toTopOf="@+id/et_search_input"
                    app:srcCompat="@drawable/ic_android_search"
                    app:tint="@color/highgray_light"/>
                <ImageView
                    android:id="@+id/ib_clear_query_search"
                    android:padding="@dimen/item_gap_xxs"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="fitCenter"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/hint_clear_search_text"
                    android:layout_marginEnd="@dimen/spacing_6"
                    android:layout_alignParentEnd="true"
                    app:layout_constraintBottom_toBottomOf="@+id/et_search_input"
                    app:layout_constraintEnd_toEndOf="@+id/et_search_input"
                    app:layout_constraintTop_toTopOf="@+id/et_search_input"
                    app:srcCompat="@drawable/ic_close_outline"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_order"
                android:tag="binding_4"
                android:paddingTop="@dimen/spacing_6"
                android:paddingBottom="@dimen/spacing_12"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/spacing_12">
                <com.stockbit.uikit.control.ControlCheckbox
                    android:layout_gravity="center"
                    android:id="@+id/ccb_select_order"
                    android:tag="binding_5"
                    android:visibility="gone"
                    android:layout_width="@dimen/width_24"
                    android:layout_height="@dimen/height_24"
                    android:contentDescription="@string/ORDER_19"
                    android:layout_marginStart="@dimen/spacing_8"
                    app:checkBoxType="box"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_lot"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_action"/>
                <TextView
                    android:id="@+id/tv_action"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/running_trade_action_title"
                    android:contentDescription="@string/ORDER_12"
                    android:layout_marginStart="@dimen/spacing_8"
                    android:layout_marginEnd="@dimen/spacing_8"
                    android:paddingVertical="@dimen/spacing_2"
                    app:layout_constraintEnd_toStartOf="@+id/tv_amount"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/ccb_select_order"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TypeStyles.BodyXSmall"/>
                <TextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:id="@+id/tv_lot"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/orderlist_detail_title_lot"
                    android:contentDescription="@string/ORDER_13"
                    app:layout_constraintEnd_toEndOf="@+id/tv_action"
                    app:layout_constraintStart_toStartOf="@+id/tv_action"
                    app:layout_constraintTop_toBottomOf="@+id/tv_action"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <TextView
                    android:gravity="end"
                    android:id="@+id/tv_amount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/trading_history_amount_done_title"
                    android:contentDescription="@string/ORDER_14"
                    android:textAlignment="textEnd"
                    android:layout_marginEnd="@dimen/spacing_8"
                    android:paddingVertical="@dimen/spacing_2"
                    app:layout_constraintEnd_toStartOf="@+id/tv_status"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/tv_action"
                    app:layout_constraintTop_toTopOf="@+id/tv_action"
                    style="@style/TypeStyles.BodyXSmall"/>
                <TextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:gravity="end"
                    android:id="@+id/tv_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/trading_history_price_title"
                    android:contentDescription="@string/ORDER_15"
                    app:layout_constraintEnd_toEndOf="@+id/tv_amount"
                    app:layout_constraintStart_toStartOf="@+id/tv_amount"
                    app:layout_constraintTop_toBottomOf="@+id/tv_amount"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <TextView
                    android:gravity="end"
                    android:id="@+id/tv_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/orderlist_detail_title_status"
                    android:contentDescription="@string/ORDER_16"
                    android:textAlignment="textEnd"
                    android:layout_marginEnd="@dimen/spacing_20"
                    android:paddingVertical="@dimen/spacing_2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/tv_amount"
                    app:layout_constraintTop_toTopOf="@+id/tv_action"
                    style="@style/TypeStyles.BodyXSmall"/>
                <TextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:gravity="end"
                    android:layout_gravity="end"
                    android:id="@+id/tv_expiry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/orderlist_detail_title_expiry"
                    android:contentDescription="@string/ORDER_17"
                    android:textAlignment="textEnd"
                    app:layout_constraintEnd_toEndOf="@+id/tv_status"
                    app:layout_constraintStart_toStartOf="@+id/tv_status"
                    app:layout_constraintTop_toBottomOf="@+id/tv_status"
                    style="@style/TypeStyles.BodyXXSmall"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/llTradingOrderlistHeader"
                android:tag="binding_6"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="100"
                android:layout_marginHorizontal="@dimen/spacing_20"
                android:layout_marginVertical="@dimen/spacing_16">
                <com.stockbit.uikit.control.ControlCheckbox
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/ccb_select_order_header"
                    android:tag="binding_7"
                    android:visibility="gone"
                    android:layout_width="@dimen/width_24"
                    android:layout_height="@dimen/height_24"
                    android:layout_marginEnd="@dimen/spacing_16"
                    app:checkBoxType="box"/>
                <TextView
                    android:textSize="@dimen/text_size_11"
                    android:gravity="start|center_vertical"
                    android:id="@+id/actionLabel"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="match_parent"
                    android:text="@string/trade_title_action"
                    android:layout_weight="26"
                    android:layout_marginEnd="@dimen/spacing_8"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <TextView
                    android:textSize="@dimen/text_size_11"
                    android:gravity="center"
                    android:id="@+id/amountLabel"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="match_parent"
                    android:text="@string/trade_title_amount"
                    android:layout_weight="24"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="@dimen/spacing_8"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <TextView
                    android:textSize="@dimen/text_size_11"
                    android:gravity="center"
                    android:id="@+id/priceLabel"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="match_parent"
                    android:text="@string/trade_title_price"
                    android:layout_weight="13.2"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="@dimen/spacing_8"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <TextView
                    android:textSize="@dimen/text_size_11"
                    android:gravity="center"
                    android:id="@+id/tvTradingOrderlistExpiryTitle"
                    android:visibility="gone"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="match_parent"
                    android:text="@string/trade_title_expiry"
                    android:layout_weight="13"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="@dimen/spacing_8"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <TextView
                    android:textSize="@dimen/text_size_11"
                    android:gravity="center"
                    android:id="@+id/statusLabel"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="match_parent"
                    android:text="@string/trade_title_status"
                    android:layout_weight="23.78"
                    android:textAlignment="gravity"
                    style="@style/TypeStyles.BodyXXSmall"/>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <ViewFlipper
            android:id="@+id/vf_fragment_trading_orderlist"
            android:tag="binding_8"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_shimmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/srl_fragment_trading_orderlist"
                android:tag="binding_9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <View
                        android:background="?attr/themeColorDividerThin"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/item_gap_xxxs"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_fragment_trading_orderlist"
                        android:scrollbars="none"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                </LinearLayout>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/fl_error"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/fl_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/srl_fragment_cashback_orderlist"
                android:tag="binding_10"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_fragment_cashback_orderlist"
                    android:tag="binding_11"
                    android:scrollbars="vertical"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_search_suggest"
                android:focusable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="blocksDescendants"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:isScrollContainer="false"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/text_size_13"
                android:textColor="?attr/themeColorTextSecondary"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/msg_no_results_found"
                android:drawablePadding="@dimen/spacing_8"
                android:textAlignment="center"
                app:drawableTopCompat="?attr/themeIconEmptySearch"
                app:layout_constraintEnd_toEndOf="@+id/iv_icon_not_found"
                app:layout_constraintStart_toStartOf="@+id/iv_icon_not_found"
                app:layout_constraintTop_toBottomOf="@+id/iv_icon_not_found"/>
            <FrameLayout
                android:layout_gravity="center"
                android:id="@+id/fl_empty_filter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </ViewFlipper>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
