<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_setting_referral_code_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/themeContentBackground"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/settingActivityToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_collapseMode="pin"
            app:layout_scrollFlags="enterAlways|scroll">
            <TextView
                android:textSize="@dimen/text_size_16"
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setting_kode_referral"
                style="@style/SbTextView.BodyDefault.Bold"/>
        </androidx.appcompat.widget.Toolbar>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/imageViewHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_34"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_gift_referral"/>
            <TextView
                android:textSize="@dimen/text_size_19"
                android:gravity="center"
                android:id="@+id/textViewTitle"
                android:layout_width="@dimen/item_gap_null"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/kode_referral_header"
                android:textAlignment="gravity"
                android:layout_marginStart="@dimen/item_gap_44"
                android:layout_marginEnd="@dimen/item_gap_44"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageViewHeader"
                style="@style/SbTextView.PageHeadline"/>
            <TextView
                android:gravity="center"
                android:id="@+id/textViewDesc"
                android:layout_width="@dimen/item_gap_null"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_14"
                android:text="@string/kode_referral_desc"
                android:textAlignment="gravity"
                android:layout_marginStart="@dimen/item_gap_16"
                android:layout_marginEnd="@dimen/item_gap_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewTitle"
                style="@style/SbTextView.BodyDefault"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:id="@+id/textView4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/height_40"
                android:text="Bagikan Kode Referralmu"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textViewDesc"
                style="@style/SbTextView.ListTitle"/>
            <RelativeLayout
                android:id="@+id/editReferralContainer"
                android:background="@drawable/bg_button_dashed"
                android:padding="@dimen/item_gap_16"
                android:layout_width="@dimen/item_gap_null"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_16"
                android:layout_marginStart="@dimen/item_gap_16"
                android:layout_marginEnd="@dimen/item_gap_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView4">
                <TextView
                    android:id="@+id/textViewReferralCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentLeft="true"
                    style="@style/SbTextView.ListTitle"/>
                <TextView
                    android:textColor="@color/green_text"
                    android:id="@+id/buttonEditReferralCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kode_referral_edit"
                    android:layout_alignParentRight="true"
                    style="@style/SbTextView.ListTitle"/>
            </RelativeLayout>
            <Button
                android:layout_gravity="center_horizontal"
                android:id="@+id/btnCopy"
                android:background="@drawable/btn_follow"
                android:layout_width="@dimen/item_gap_null"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_12"
                android:text="@string/kode_referral_copy"
                android:layout_marginEnd="@dimen/item_gap_xs"
                app:layout_constraintEnd_toStartOf="@+id/btnShare"
                app:layout_constraintStart_toStartOf="@+id/editReferralContainer"
                app:layout_constraintTop_toBottomOf="@+id/editReferralContainer"
                style="@style/SbBtnBorderless.Default"/>
            <Button
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/btnShare"
                android:paddingLeft="@dimen/item_gap_50"
                android:paddingRight="@dimen/item_gap_50"
                android:layout_width="@dimen/item_gap_null"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_12"
                android:text="@string/kode_referral_share"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_btn_share"
                android:layout_marginStart="@dimen/item_gap_xs"
                app:layout_constraintEnd_toEndOf="@+id/editReferralContainer"
                app:layout_constraintStart_toEndOf="@+id/btnCopy"
                app:layout_constraintTop_toBottomOf="@+id/editReferralContainer"
                style="@style/SbBtn.PrimaryFullWidthFloating"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/parentCard"
                android:background="@drawable/border_gray_rounded_white_bg"
                android:layout_width="@dimen/item_gap_null"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_24"
                app:layout_constraintEnd_toEndOf="@+id/btnShare"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="@+id/btnCopy"
                app:layout_constraintTop_toBottomOf="@+id/btnCopy">
                <TextView
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_16"
                    android:text="@string/kode_referral_card_title"
                    android:textAlignment="gravity"
                    style="@style/SbTextView.ListTitle"/>
                <TextView
                    android:textSize="@dimen/text_size_38"
                    android:textColor="@color/green_text"
                    android:gravity="center"
                    android:id="@+id/textViewRedeemCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/kode_referral_zero"
                    android:textAlignment="gravity"
                    style="@style/SbTextView.ListTitle"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:textColor="?attr/themeContentTextDesc"
                    android:gravity="center"
                    android:id="@+id/textViewRedeemDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kode_referral_card_desc"
                    android:textAlignment="gravity"
                    style="@style/SbTextView.BodyDefault"/>
                <View
                    android:id="@+id/gap"
                    android:background="?attr/separatorColor"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_gap_xxxs"
                    android:layout_marginTop="@dimen/text_size_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textViewRedeemDesc"/>
                <RelativeLayout
                    android:padding="@dimen/item_gap_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="?attr/themeContentTextColor"
                        android:id="@+id/textViewFriends"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kode_referral_ticket_desc"
                        android:layout_alignParentLeft="true"
                        style="@style/SbTextView.BodyDefault"/>
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="@color/green_text"
                        android:id="@+id/btnShowReferralList"
                        android:tag="binding_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/kode_referral_button_list"
                        android:layout_alignParentRight="true"
                        style="@style/SbTextView.ListTitle"/>
                </RelativeLayout>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/buttonFAQExpand"
                android:background="@drawable/border_gray_rounded_white_bg"
                android:padding="@dimen/item_gap_14"
                android:layout_width="@dimen/item_gap_null"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/item_gap_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/parentCard"
                app:layout_constraintStart_toStartOf="@+id/parentCard"
                app:layout_constraintTop_toBottomOf="@+id/parentCard"
                app:layout_constraintVertical_bias="0">
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:id="@+id/textViewFAQ"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kode_referral_faq_title"
                    android:layout_alignParentLeft="true"
                    style="@style/SbTextView.ListTitle"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imageViewExpanded"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_null"
                    android:layout_marginBottom="0dp"
                    android:src="@drawable/ic_expand_down"
                    android:layout_alignTop="@+id/textViewFAQ"
                    android:layout_alignBottom="@+id/textViewFAQ"
                    android:layout_alignParentRight="true"
                    android:foregroundGravity="center"
                    style="@style/SbTextView.ListTitle"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:id="@+id/textViewFAQDesc"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_10"
                    android:text="@string/kode_referral_faq_desc"
                    android:layout_below="@+id/textViewFAQ"
                    android:layout_alignParentLeft="true"
                    style="@style/SbTextView.BodyDefault"/>
            </RelativeLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
