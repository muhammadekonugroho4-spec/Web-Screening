<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_margin_trading_term_condition_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:layout_scrollFlags="enterAlways|scroll">
        <TextView
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/tv_toolbar_term_condition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_agreement"
            style="@style/TypeStyles.HeadingLarge"/>
    </androidx.appcompat.widget.Toolbar>
    <ViewFlipper
        android:id="@+id/vf_term_condition_margin_trading"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.stockbit.uikit.control.ControlProgressLoading
            android:layout_gravity="center"
            android:id="@+id/pb_disclaimer_smart_order"
            android:layout_width="@dimen/clickable_size_48"
            android:layout_height="@dimen/clickable_size_48"
            app:progressLoadingSize="large"
            style="@style/Widget.AppCompat.ProgressBar"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.stockbit.component.webview.component.SbWebView
                android:id="@+id/webview"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginHorizontal="@dimen/item_gap_20"
                app:layout_constraintBottom_toTopOf="@+id/v_divier"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/v_divier"
                android:background="?attr/themeSeparatorGapColorButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_xxxs"
                android:layout_marginBottom="@dimen/item_gap_16"
                app:layout_constraintBottom_toTopOf="@+id/ll_agreement_container"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <LinearLayout
                android:layout_gravity="center"
                android:id="@+id/ll_agreement_container"
                android:layout_width="@dimen/item_gap_null"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/item_gap_16"
                android:layout_marginStart="@dimen/spacing_20"
                android:layout_marginEnd="@dimen/spacing_20"
                app:layout_constraintBottom_toTopOf="@+id/pb_next"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:layout_gravity="center_vertical"
                    android:id="@+id/check_agreement"
                    android:padding="@dimen/spacing_4"
                    android:layout_width="@dimen/clickable_size_20"
                    android:layout_height="@dimen/clickable_size_20"
                    android:checked="false"
                    android:button="@drawable/bg_checkbox_box"/>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="?attr/themeColorTextPrimary"
                    android:layout_gravity="center"
                    android:id="@+id/tv_agreement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_agreement_checkmark"
                    android:layout_marginStart="@dimen/item_gap_8"
                    style="@style/TypeStyles.BodySmall"/>
            </LinearLayout>
            <com.stockbit.uikit.button.PrimaryButton
                android:id="@+id/pb_next"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="@dimen/clickable_size_48"
                android:text="@string/title_btn_next"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:textAllCaps="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:primaryButtonActive="false"
                app:primaryButtonSize="defaultSize"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/parent_clickable_reload_margin_trading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_reload_margin_trading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/btn_tap_to_refresh"
                app:srcCompat="?attr/themeIconErrorAcademy"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:id="@+id/tv_error_cause_margin_trading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="@string/title_unable_load_data"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:id="@+id/tv_error_try_again"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:text="@string/button_try_again"
                android:drawablePadding="@dimen/spacing_4"
                app:drawableStartCompat="@drawable/ic_try_again_two_arrows"
                style="@style/TypeStyles.HeadingSmall.Green"/>
        </LinearLayout>
    </ViewFlipper>
</androidx.appcompat.widget.LinearLayoutCompat>
