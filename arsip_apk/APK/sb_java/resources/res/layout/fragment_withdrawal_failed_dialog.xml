<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Sb.BottomSheetDialog"
    android:tag="layout/fragment_withdrawal_failed_dialog_0"
    android:background="@drawable/bg_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/rl_withdrawal_dialog_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_withdrawal_dialog"
            android:padding="@dimen/item_gap_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            app:srcCompat="0x7f080641"
            app:tint="?attr/titleTextColorLowgray"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_withdrawal_dialog_header">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="@dimen/avatar_size_xl"
            android:layout_height="@dimen/avatar_size_xl"
            app:srcCompat="?attr/themeIconWithdrawFailed"/>
        <TextView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:layout_marginBottom="@dimen/item_gap_8"
            android:text="@string/setting_withdraw_limit_foreign"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="?attr/themeColorTextRed"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_withdrawal_failed_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/item_gap_50"
            android:textAlignment="gravity"
            style="@style/TypeStyles.HeadlineRegular"/>
    </LinearLayout>
</RelativeLayout>
