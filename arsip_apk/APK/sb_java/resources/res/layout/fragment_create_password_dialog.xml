<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme"
    android:tag="layout/fragment_create_password_dialog_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/vgCreatePasswordDialogDialogHeader"
        android:background="@drawable/bg_top_rounded"
        android:paddingTop="@dimen/item_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/viewFragmentCreatePasswordDialogDialogHandler"
            android:background="@drawable/bg_rounded_gray_gray_bg"
            android:layout_width="@dimen/clickable_size_64"
            android:layout_height="@dimen/item_gap_xs"
            android:layout_marginBottom="@dimen/item_gap_s"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/parentFragmentCreateNewPassDialog"
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/clickable_size_72"
        android:layout_below="@+id/vgCreatePasswordDialogDialogHeader">
        <ImageView
            android:id="@+id/ivCreateNewPassIcon"
            android:background="@color/transparent"
            android:layout_width="@dimen/avatar_size_l"
            android:layout_height="@dimen/avatar_size_l"
            android:layout_marginTop="@dimen/item_gap_32"
            android:layout_marginBottom="@dimen/item_gap_l"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            app:srcCompat="?attr/themeIconPassword"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:textColor="?attr/themeContentTextColor"
            android:id="@+id/tvCreateNewPassTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_l"
            android:layout_marginTop="@dimen/item_gap_20"
            android:layout_marginRight="@dimen/item_gap_l"
            android:layout_marginBottom="@dimen/item_gap_s"
            android:text="@string/setting_create_new_pass_title"
            android:layout_below="@+id/ivCreateNewPassIcon"
            android:layout_centerHorizontal="true"
            style="@style/SbTextView.BodyDefault.Bold"/>
        <TextView
            android:textColor="?attr/themeContentTextColor"
            android:gravity="center"
            android:id="@+id/tvCreateNewPassSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_13"
            android:layout_marginBottom="@dimen/item_gap_s"
            android:text="@string/setting_create_new_pass_subtitle"
            android:layout_below="@+id/tvCreateNewPassTitle"
            android:layout_centerHorizontal="true"
            android:textAlignment="gravity"
            android:layout_marginStart="@dimen/item_gap_16"
            android:layout_marginEnd="@dimen/item_gap_16"
            style="@style/SbTextView.BodyDefault"/>
        <Button
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btnCreateNewPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_l"
            android:layout_marginBottom="@dimen/item_gap_l"
            android:text="@string/setting_create_buat_password"
            android:layout_below="@+id/tvCreateNewPassSubtitle"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/item_gap_l"
            android:layout_marginEnd="@dimen/item_gap_l"
            style="@style/SbBtn.PrimaryFullWidthFloating"/>
    </RelativeLayout>
</RelativeLayout>
