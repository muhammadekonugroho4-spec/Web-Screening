<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_screener_preset_child"
    android:tag="layout/item_screener_preset_child_0"
    android:background="@drawable/bg_rounded_8_outlined_preset"
    android:padding="@dimen/item_gap_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/item_gap_8"
    android:layout_marginBottom="@dimen/item_gap_8">
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_size_14"
        android:gravity="start"
        android:id="@+id/tv_preset_child_title"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/iv_chevron"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SbTextView.BodyDefault.Highempasis.Bold"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="start"
        android:id="@+id/tv_preset_child_description"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_9"
        app:layout_constraintEnd_toStartOf="@+id/iv_chevron"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_preset_child_title"
        style="@style/SbTextView.Caption.Highempasis"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_chevron"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/item_gap_18"
        android:layout_marginEnd="@dimen/item_gap_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_chevron_right_highray"/>
</androidx.constraintlayout.widget.ConstraintLayout>
