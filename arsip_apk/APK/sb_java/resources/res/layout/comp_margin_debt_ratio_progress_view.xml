<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ll_root"
    android:tag="layout/comp_margin_debt_ratio_progress_view_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/themeColorTextOrange"
        android:id="@+id/tv_debt_status"
        android:background="@drawable/bg_rounded_orange_low"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_6"
        android:paddingVertical="@dimen/spacing_4"
        style="@style/TypeStyles.BodyXSmall"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_debt_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_4"
        app:cardBackgroundColor="?attr/themeColorSurfaceVariant"
        app:cardCornerRadius="@dimen/spacing_4"
        app:cardElevation="@dimen/spacing_0">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:id="@+id/progress_debt_ratio"
                android:layout_width="@dimen/spacing_0"
                android:layout_height="@dimen/spacing_0"
                android:max="100"
                android:indeterminate="false"
                android:progressDrawable="@drawable/progress_debt_ratio"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>
            <TextView
                android:textColor="?attr/themeColorSpecialTextSecondary"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_margin_ratio"
                android:layout_marginStart="@dimen/spacing_8"
                android:layout_marginVertical="@dimen/spacing_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.BodyXSmall"/>
            <TextView
                android:id="@+id/tv_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_4"
                app:layout_constraintBottom_toBottomOf="@+id/tv_title"
                app:layout_constraintStart_toEndOf="@+id/tv_title"
                app:layout_constraintTop_toTopOf="@+id/tv_title"
                style="@style/TypeStyles.HeadingXSmall"/>
            <ImageView
                android:id="@+id/iv_chevron_right"
                android:layout_width="@dimen/spacing_10"
                android:layout_height="@dimen/item_gap_10"
                android:src="@drawable/ic_chevron_right"
                android:layout_marginStart="@dimen/spacing_4"
                android:layout_marginEnd="@dimen/spacing_8"
                app:layout_constraintBottom_toBottomOf="@+id/tv_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_percentage"
                app:layout_constraintTop_toTopOf="@+id/tv_title"
                app:tint="?attr/themeColorIconArrowList"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
