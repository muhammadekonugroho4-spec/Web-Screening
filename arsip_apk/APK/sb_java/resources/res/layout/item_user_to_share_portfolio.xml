<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_user_to_share_portfolio_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/item_gap_8"
    android:layout_marginBottom="@dimen/item_gap_8"
    android:layout_marginStart="@dimen/item_gap_20"
    android:layout_marginEnd="@dimen/item_gap_20">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/itemImage"
        android:tag="binding_1"
        android:layout_width="@dimen/item_gap_40"
        android:layout_height="@dimen/item_gap_40"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/item_gap_l"
        app:layout_constraintBottom_toBottomOf="@+id/itemImage"
        app:layout_constraintEnd_toStartOf="@+id/aciv_check"
        app:layout_constraintStart_toEndOf="@+id/itemImage"
        app:layout_constraintTop_toTopOf="@+id/itemImage">
        <TextView
            android:textSize="@dimen/text_size_12"
            android:id="@+id/tvTitle"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            style="@style/SbTextView.BodyDefault.Highempasis.Bold"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_verified_badge"
            android:tag="binding_3"
            android:layout_width="@dimen/item_gap_12"
            android:layout_height="@dimen/item_gap_12"
            android:layout_marginStart="@dimen/item_gap_4"
            app:srcCompat="@drawable/ic_verified_green_white_24dp"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/aciv_check"
        android:tag="binding_4"
        android:layout_width="18dp"
        android:layout_height="18dp"
        app:layout_constraintBottom_toBottomOf="@+id/itemImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/itemImage"
        app:srcCompat="@drawable/ic_checked_circle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
