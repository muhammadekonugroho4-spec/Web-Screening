<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/row_withdrawal_history_stockbit_list_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_14"
        android:id="@+id/tv_month"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/item_gap_20"
        style="@style/SbTextView.BodyDefault.Dark.Gray"/>
    <RelativeLayout
        android:id="@+id/rl_withdrawal_content"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_80">
        <RelativeLayout
            android:id="@+id/rlWithdrawalHistoryStockbitImageLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:layout_marginStart="@dimen/item_gap_20">
            <ImageView
                android:id="@+id/ivWithdrawalHistoryStockbitImageSuccess"
                android:visibility="gone"
                android:layout_width="@dimen/avatar_size_36"
                android:layout_height="@dimen/avatar_size_36"
                app:srcCompat="@drawable/ic_history_success"/>
            <ImageView
                android:id="@+id/ivWithdrawalHistoryStockbitImagePending"
                android:visibility="gone"
                android:layout_width="@dimen/avatar_size_36"
                android:layout_height="@dimen/avatar_size_36"
                app:srcCompat="@drawable/ic_history_pending"/>
            <ImageView
                android:id="@+id/ivWithdrawalHistoryStockbitImageFailed"
                android:visibility="gone"
                android:layout_width="@dimen/avatar_size_36"
                android:layout_height="@dimen/avatar_size_36"
                android:tint="@color/red_item"
                app:srcCompat="@drawable/ic_history_failed"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:id="@+id/tvSettingStockbitWithdrawalStatusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:text="@string/n_dash"
            android:layout_toRightOf="@+id/rlWithdrawalHistoryStockbitImageLayout"
            android:paddingStart="@dimen/item_gap_20"
            android:paddingEnd="@dimen/item_gap_20"
            style="@style/SbTextView.BodyDefault.Bold.Semi"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:id="@+id/tvSettingStockbitWithdrawalDateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_xxs"
            android:layout_marginBottom="@dimen/item_gap_m"
            android:text="@string/n_dash"
            android:layout_toRightOf="@+id/rlWithdrawalHistoryStockbitImageLayout"
            android:layout_below="@+id/tvSettingStockbitWithdrawalStatusTitle"
            android:paddingStart="@dimen/item_gap_20"
            android:paddingEnd="@dimen/item_gap_20"
            style="@style/SbTextView.BodySecondary"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:gravity="end|center_vertical"
            android:id="@+id/tvSettingStockbitWithdrawalValueTitle"
            android:paddingTop="@dimen/item_gap_xxs"
            android:paddingBottom="@dimen/item_gap_xxs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:text="@string/n_dash"
            android:layout_toRightOf="@+id/tvSettingStockbitWithdrawalStatusTitle"
            android:textAlignment="gravity"
            android:paddingStart="@dimen/item_gap_20"
            android:paddingEnd="@dimen/item_gap_20"
            android:layout_alignParentEnd="true"
            style="@style/SbTextView.BodyDefault.Bold"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:gravity="end|center_vertical"
            android:id="@+id/tvSettingStockbitWithdrawalBankTitle"
            android:paddingTop="@dimen/item_gap_xxs"
            android:paddingBottom="@dimen/item_gap_xxs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/n_dash"
            android:layout_toRightOf="@+id/tvSettingStockbitWithdrawalDateTitle"
            android:layout_below="@+id/tvSettingStockbitWithdrawalValueTitle"
            android:textAlignment="gravity"
            android:paddingStart="@dimen/item_gap_20"
            android:paddingEnd="@dimen/item_gap_20"
            android:layout_alignParentEnd="true"
            style="@style/SbTextView.BodySecondary"/>
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</LinearLayout>
