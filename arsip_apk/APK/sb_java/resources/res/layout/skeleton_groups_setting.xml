<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_titleGroupsSetting"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_100"
        android:layout_height="@dimen/height_xxs"
        android:layout_marginTop="@dimen/item_gap_8"
        android:layout_marginStart="@dimen/item_gap_20"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_descriptionGroupsSetting"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_220"
        android:layout_height="@dimen/height_xxs"
        android:layout_marginTop="@dimen/item_gap_4"
        android:layout_marginStart="@dimen/item_gap_20"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_titleGroupsSetting"/>
    <View
        android:id="@+id/v_itemGroups1"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_180"
        android:layout_height="@dimen/height_16"
        android:layout_marginTop="@dimen/item_gap_26"
        android:layout_marginStart="@dimen/item_gap_20"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_descriptionGroupsSetting"/>
    <View
        android:id="@+id/v_line_1"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/item_gap_18"
        app:layout_constraintTop_toBottomOf="@+id/v_itemGroups1"/>
    <View
        android:id="@+id/v_itemGroups2"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_180"
        android:layout_height="@dimen/height_xxs"
        android:layout_marginTop="@dimen/item_gap_18"
        android:layout_marginStart="@dimen/item_gap_20"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_line_1"/>
    <View
        android:id="@+id/v_line_2"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/item_gap_18"
        app:layout_constraintTop_toBottomOf="@+id/v_itemGroups2"/>
    <View
        android:id="@+id/v_itemGroups3"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_180"
        android:layout_height="@dimen/height_xxs"
        android:layout_marginTop="@dimen/item_gap_22"
        android:layout_marginStart="@dimen/item_gap_20"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_line_2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
