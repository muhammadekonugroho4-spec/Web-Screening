<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_history_detail_ipo_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:paddingLeft="@dimen/item_gap_null"
        android:paddingRight="@dimen/item_gap_null"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:contentInsetLeft="@dimen/item_gap_null"
        app:contentInsetStart="@dimen/item_gap_null"
        app:contentInsetStartWithNavigation="@dimen/item_gap_null"
        app:elevation="@dimen/item_gap_null">
        <RelativeLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minHeight="?attr/actionBarSize">
            <TextView
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/tv_toolbar_tiitle"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:singleLine="true"
                android:layout_centerHorizontal="true"
                android:textAlignment="gravity"
                style="@style/TopBar.Title"/>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <ViewFlipper
        android:tag="binding_1"
        android:background="?attr/themeContentBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:paddingTop="@dimen/item_gap_m"
            android:paddingBottom="@dimen/item_gap_l"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include layout="@layout/skeleton_item_history_stockbit_detail"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <RelativeLayout
                android:tag="binding_3"
                android:background="@drawable/border_gray_rounded_white_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_l"
                android:layout_marginBottom="@dimen/item_gap_s"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginStart="@dimen/item_gap_l"
                android:layout_marginEnd="@dimen/item_gap_l"
                android:paddingHorizontal="@dimen/spacing_16"
                android:paddingVertical="@dimen/spacing_12">
                <ImageView
                    android:id="@+id/iv_company_logo"
                    android:tag="binding_4"
                    android:layout_width="@dimen/width_40"
                    android:layout_height="@dimen/height_40"/>
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/item_gap_10"
                    android:layout_toEndOf="@+id/iv_company_logo">
                    <TextView
                        android:textColor="?attr/themeColorTextPrimary"
                        android:id="@+id/tv_symbol_title"
                        android:tag="binding_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TypeStyles.HeadingRegular"/>
                    <TextView
                        android:ellipsize="end"
                        android:id="@+id/tv_symbol_desc"
                        android:tag="binding_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_2"
                        android:maxLines="1"
                        android:layout_below="@+id/tv_symbol_title"
                        style="@style/TypeStyles.BodyXSmall.Secondary"/>
                    <RelativeLayout
                        android:id="@+id/rl_history_detail_ipo_acceleration"
                        android:tag="binding_7"
                        android:background="@drawable/border_green_button"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/clickable_size_18"
                        android:layout_above="@+id/tv_symbol_desc"
                        android:layout_alignTop="@+id/tv_symbol_title"
                        android:layout_marginStart="@dimen/item_gap_s"
                        android:layout_toEndOf="@+id/tv_symbol_title">
                        <TextView
                            android:textSize="@dimen/text_size_12"
                            android:textColor="@color/green_text"
                            android:id="@+id/badge_text"
                            android:tag="binding_8"
                            android:paddingLeft="@dimen/item_gap_8"
                            android:paddingRight="@dimen/item_gap_8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            style="@style/SbTextView.BodyDefault.Green.Bold"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:tag="binding_9"
                        android:background="@drawable/border_green_button"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/clickable_size_18"
                        android:layout_above="@+id/tv_symbol_desc"
                        android:layout_alignTop="@+id/tv_symbol_title"
                        android:layout_marginStart="@dimen/item_gap_s"
                        android:layout_toEndOf="@+id/rl_history_detail_ipo_acceleration">
                        <TextView
                            android:textColor="@color/green_text"
                            android:paddingLeft="@dimen/item_gap_8"
                            android:paddingRight="@dimen/item_gap_8"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/buy_title_syariah_title"
                            android:layout_centerInParent="true"
                            style="@style/SbTextView.BodyDefault.Green.Bold"/>
                    </RelativeLayout>
                </RelativeLayout>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/border_gray_rounded_white_bg"
                android:paddingTop="@dimen/item_gap_s"
                android:paddingBottom="@dimen/item_gap_s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_s"
                android:layout_marginBottom="@dimen/item_gap_l"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginStart="@dimen/item_gap_l"
                android:layout_marginEnd="@dimen/item_gap_l">
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/item_gap_l"
                    android:paddingRight="@dimen/item_gap_l"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:paddingTop="@dimen/item_gap_m"
                        android:paddingBottom="@dimen/item_gap_m"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/trading_history_date_title"
                        android:layout_weight="1"
                        style="@style/TypeStyles.BodyRegular"/>
                    <TextView
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_history_date"
                        android:paddingTop="@dimen/item_gap_m"
                        android:paddingBottom="@dimen/item_gap_m"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAlignment="gravity"
                        style="@style/TypeStyles.BodyRegular"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/item_gap_l"
                    android:paddingRight="@dimen/item_gap_l"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:paddingTop="@dimen/item_gap_m"
                        android:paddingBottom="@dimen/item_gap_m"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/trading_history_lot_title"
                        android:layout_weight="1"
                        style="@style/TypeStyles.BodyRegular"/>
                    <TextView
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_history_lot"
                        android:paddingTop="@dimen/item_gap_m"
                        android:paddingBottom="@dimen/item_gap_m"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAlignment="gravity"
                        style="@style/TypeStyles.BodyRegular"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/item_gap_l"
                    android:paddingRight="@dimen/item_gap_l"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:paddingTop="@dimen/item_gap_m"
                        android:paddingBottom="@dimen/item_gap_m"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/trading_history_price_title"
                        android:layout_weight="1"
                        style="@style/TypeStyles.BodyRegular"/>
                    <TextView
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_history_price"
                        android:paddingTop="@dimen/item_gap_m"
                        android:paddingBottom="@dimen/item_gap_m"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAlignment="gravity"
                        style="@style/TypeStyles.BodyRegular"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/item_gap_l"
                    android:paddingRight="@dimen/item_gap_l"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/tv_title_amount"
                        android:paddingTop="@dimen/item_gap_m"
                        android:paddingBottom="@dimen/item_gap_m"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/TypeStyles.HeadingRegular"/>
                    <TextView
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_history_amount"
                        android:paddingTop="@dimen/item_gap_m"
                        android:paddingBottom="@dimen/item_gap_m"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAlignment="gravity"
                        style="@style/TypeStyles.HeadingRegular"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ViewFlipper>
</LinearLayout>
