<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_smart_order_portfolio_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center"
        android:id="@+id/separator"
        android:background="?attr/titleTextColorDowngray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginBottom="@dimen/item_gap_16"
        android:layout_marginHorizontal="@dimen/item_gap_1"/>
    <RelativeLayout
        android:id="@+id/sell_target_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_16"
        android:layout_below="@+id/separator"
        android:layout_marginStart="@dimen/item_gap_l"
        android:layout_marginEnd="@dimen/item_gap_l">
        <TextView
            android:textSize="@dimen/text_size_14"
            android:gravity="start"
            android:id="@+id/tv_desc_sell_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/item_gap_xxxs"
            android:text="@string/smart_order_smart_order"
            android:layout_alignParentLeft="true"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:textColor="@color/green_text"
            android:gravity="end"
            android:id="@+id/btn_edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_edit"
            android:layout_toRightOf="@+id/tv_desc_sell_target"
            android:layout_alignParentRight="true"
            android:layout_marginStart="@dimen/item_gap_8"
            style="@style/TypeStyles.HeadingSmall"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:gravity="start"
            android:id="@+id/tv_lot_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:layout_marginBottom="1dp"
            android:text="@string/smart_order_lot"
            android:layout_below="@+id/tv_desc_sell_target"
            android:layout_alignParentLeft="true"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:gravity="end"
            android:id="@+id/tv_lot_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:layout_toRightOf="@+id/tv_desc_sell_target"
            android:layout_below="@+id/tv_desc_sell_target"
            android:layout_alignParentRight="true"
            android:layout_marginStart="@dimen/item_gap_8"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:gravity="start"
            android:id="@+id/tv_price_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:layout_marginBottom="@dimen/item_gap_xxxs"
            android:text="@string/smart_order_price"
            android:layout_below="@+id/tv_lot_title"
            android:layout_alignParentLeft="true"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:gravity="end"
            android:id="@+id/tv_price_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:layout_toRightOf="@+id/tv_desc_sell_target"
            android:layout_below="@+id/tv_lot_title"
            android:layout_alignParentRight="true"
            android:layout_marginStart="@dimen/item_gap_8"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:gravity="start"
            android:id="@+id/tv_pnl"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:layout_marginBottom="@dimen/item_gap_xxxs"
            android:text="@string/lbl_portfolio_loss_pl"
            android:layout_below="@+id/tv_price_title"
            android:layout_alignParentLeft="true"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:gravity="end"
            android:id="@+id/tv_pnl_value"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:layout_toRightOf="@+id/tv_desc_sell_target"
            android:layout_below="@+id/tv_price_value"
            android:layout_alignParentRight="true"
            android:layout_marginStart="@dimen/item_gap_8"
            style="@style/TypeStyles.BodyRegular"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/error_lot"
        android:background="@drawable/bg_rounded_red_outline"
        android:padding="@dimen/item_gap_8"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/sell_target_parent"
        android:layout_marginHorizontal="@dimen/item_gap_16"
        android:layout_marginVertical="@dimen/item_gap_8">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/item_gap_13"
            android:scaleType="fitEnd"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/item_gap_8"
            app:srcCompat="@drawable/ic_info_red"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/smart_order_error_porfolio_detail"
            android:layout_weight="1"
            style="@style/TypeStyles.BodyRegular"/>
    </LinearLayout>
</RelativeLayout>
