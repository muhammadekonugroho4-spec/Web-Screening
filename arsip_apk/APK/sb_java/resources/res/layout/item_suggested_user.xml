<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mcv_suggested_user"
    android:tag="layout/item_suggested_user_0"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:layout_marginStart="@dimen/spacing_12"
    app:cardBackgroundColor="?attr/themeColorSurfaceDefault"
    app:cardCornerRadius="@dimen/shape_radius_6"
    app:cardElevation="@dimen/item_gap_null"
    app:cardUseCompatPadding="false">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:padding="@dimen/spacing_16"
        android:layout_width="@dimen/stream_suggested_user_width_163"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/ib_hide_suggestion"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/spacing_20"
            android:layout_height="@dimen/spacing_20"
            android:src="0x7f08063f"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/gray_text"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/itemImage"
            android:tag="binding_1"
            android:layout_width="@dimen/width_72"
            android:layout_height="@dimen/height_72"
            android:scaleType="centerCrop"
            android:layout_alignParentTop="true"
            android:layout_toStartOf="@+id/ib_hide_suggestion"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_user"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/itemImage">
            <TextView
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_username"
                android:tag="binding_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:paddingStart="@dimen/spacing_6"
                android:layout_marginEnd="@dimen/spacing_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ivUserProfileVerifiedBadge"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.HeadingRegular"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ivUserProfileVerifiedBadge"
                android:tag="binding_3"
                android:layout_width="@dimen/item_gap_12"
                android:layout_height="@dimen/item_gap_12"
                android:scaleType="fitXY"
                android:layout_marginEnd="@dimen/item_gap_xxxs"
                app:layout_constraintBottom_toBottomOf="@+id/tv_username"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_username"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:ellipsize="end"
            android:gravity="top|center_horizontal"
            android:id="@+id/tv_suggestion_reason"
            android:tag="binding_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:maxLines="2"
            android:minLines="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_user"
            style="@style/TypeStyles.BodySmall"/>
        <ViewFlipper
            android:id="@+id/fl_follow_unfollow"
            android:tag="binding_5"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:layout_below="@+id/tv_suggestion_reason"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_suggestion_reason">
            <com.stockbit.uikit.button.SecondaryNeutralButton
                android:id="@+id/btn_following"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_28"
                android:text="@string/following"
                style="@style/TypeStyles.HeadingXSmall"/>
            <com.stockbit.uikit.button.PrimaryButton
                android:layout_gravity="center_horizontal"
                android:id="@+id/btn_follow"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_28"
                android:text="@string/btn_follow"
                style="@style/TypeStyles.HeadingXSmall"/>
        </ViewFlipper>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
