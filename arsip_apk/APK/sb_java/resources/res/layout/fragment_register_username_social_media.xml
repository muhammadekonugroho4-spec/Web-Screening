<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_register_username_social_media_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="800dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivRegisterUsernameSocialMediaIcon"
                android:tag="binding_1"
                android:layout_width="@dimen/avatar_size_xl"
                android:layout_height="@dimen/avatar_size_xl"
                android:layout_margin="@dimen/item_gap_l"
                android:src="@drawable/ic_avatar"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:id="@+id/tvRegisterUsernameSocialMediaTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/item_gap_l"
                android:layout_marginTop="@dimen/item_gap_l"
                android:layout_marginRight="@dimen/item_gap_l"
                android:layout_marginBottom="@dimen/item_gap_s"
                android:text="@string/title_register_username_title"
                android:layout_below="@+id/ivRegisterUsernameSocialMediaIcon"
                style="@style/TypeStyles.HeadlineRegular"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:id="@+id/tvRegisterUsernameSocialMediaSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/item_gap_l"
                android:layout_marginTop="@dimen/item_gap_s"
                android:layout_marginRight="@dimen/item_gap_l"
                android:layout_marginBottom="@dimen/item_gap_s"
                android:text="@string/title_register_username_subtitle"
                android:layout_below="@+id/tvRegisterUsernameSocialMediaTitle"
                style="@style/TypeStyles.BodyRegular"/>
            <com.stockbit.uikit.input.InputTextFieldLine
                android:id="@+id/itfl_register_username_social_media"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/item_gap_l"
                android:layout_marginTop="@dimen/item_gap_l"
                android:layout_marginRight="@dimen/item_gap_l"
                android:layout_marginBottom="@dimen/item_gap_46"
                android:layout_below="@+id/tvRegisterUsernameSocialMediaSubtitle"
                app:textFieldHint="@string/title_register_username_hint"/>
            <com.stockbit.uikit.buttons.PrimaryButton
                android:id="@+id/rlRegisterUsernameSocialMedia"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="@dimen/clickable_size_48"
                android:layout_marginTop="@dimen/item_gap_l"
                android:layout_marginBottom="@dimen/item_gap_l"
                android:text="@string/button_next"
                android:layout_below="@+id/itfl_register_username_social_media"
                android:layout_marginStart="@dimen/item_gap_l"
                android:layout_marginEnd="@dimen/item_gap_l"
                app:textFieldLabel="@string/hint_login_username"/>
            <Button
                android:textSize="@dimen/text_size_12"
                android:textColor="?attr/themeContentTextColor"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/btnRegisterUsernameSocialMediaOpenLogin"
                android:tag="binding_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/item_gap_l"
                android:layout_marginRight="@dimen/item_gap_l"
                android:text="@string/btn_title_login_on_register"
                android:maxLines="1"
                android:layout_below="@+id/rlRegisterUsernameSocialMedia"
                android:layout_centerHorizontal="true"
                style="@style/SbBtnBorderless"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
