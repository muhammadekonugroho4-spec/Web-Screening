<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_history_transaction_type_dialog_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/rl_dialog_header"
        android:background="@drawable/bg_top_rounded"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_48">
        <ImageView
            android:id="@+id/iv_close_dialog"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/spacing_16"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerInParent="true"
            app:srcCompat="0x7f080641"
            app:tint="?attr/themeIconTintColor"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:id="@+id/tv_set_trading_period_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_title_history_type"
            android:layout_centerInParent="true"
            style="@style/TypeStyles.HeadingLarge"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_dialog_header">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rl_set_trading_period_layout"
                android:background="?attr/themeDialogBackgroundColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:orientation="vertical"
                    android:id="@+id/rl_one_month_layout"
                    android:padding="@dimen/spacing_20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackgroundBorderless">
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/one_month_history_trading"
                        android:layout_toLeftOf="@+id/iv_one_month"
                        android:layout_centerVertical="true"
                        style="@style/TypeStyles.HeadingLarge"/>
                    <ImageView
                        android:id="@+id/iv_one_month"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        app:srcCompat="@drawable/ic_check_circle_empty_24dp"/>
                </RelativeLayout>
                <View
                    android:background="?attr/themeSeparatorGapColorSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_gap_xxxs"
                    android:layout_below="@+id/rl_one_month_layout"/>
                <RelativeLayout
                    android:orientation="vertical"
                    android:id="@+id/rl_three_months_layout"
                    android:padding="@dimen/spacing_20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:layout_below="@+id/rl_one_month_layout">
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/three_month_history_trading"
                        android:layout_toLeftOf="@+id/iv_three_months"
                        android:layout_centerVertical="true"
                        style="@style/TypeStyles.HeadingLarge"/>
                    <ImageView
                        android:id="@+id/iv_three_months"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        app:srcCompat="@drawable/ic_check_circle_green_24dp"/>
                </RelativeLayout>
                <View
                    android:background="?attr/themeSeparatorGapColorSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_gap_xxxs"
                    android:layout_below="@+id/rl_three_months_layout"/>
                <RelativeLayout
                    android:orientation="vertical"
                    android:id="@+id/rl_one_year_layout"
                    android:padding="@dimen/spacing_20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:layout_below="@+id/rl_three_months_layout">
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/one_year_history_trading"
                        android:layout_toLeftOf="@+id/iv_one_year"
                        android:layout_centerVertical="true"
                        style="@style/TypeStyles.HeadingLarge"/>
                    <ImageView
                        android:id="@+id/iv_one_year"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        app:srcCompat="@drawable/ic_check_circle_empty_24dp"/>
                </RelativeLayout>
                <View
                    android:background="?attr/themeSeparatorGapColorSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_gap_xxxs"
                    android:layout_below="@+id/rl_one_year_layout"/>
            </RelativeLayout>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
