<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_avatar"
        android:background="@drawable/ic_circle_grey"
        android:layout_width="@dimen/avatar_shimmer_size"
        android:layout_height="@dimen/avatar_shimmer_size"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="@dimen/item_gap_l"
        android:layout_marginTop="@dimen/spacing_8"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/view_avatar"
        app:layout_constraintStart_toStartOf="@+id/view_avatar"
        app:layout_constraintTop_toBottomOf="@+id/view_avatar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
