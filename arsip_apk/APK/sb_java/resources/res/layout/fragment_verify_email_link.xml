<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_verify_email_link_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarSettingForgotPassword"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:elevation="@dimen/item_gap_null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/genericToolbarSettingForgotPassword"
            android:paddingLeft="@dimen/item_gap_null"
            android:paddingRight="@dimen/item_gap_null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:contentInsetLeft="@dimen/item_gap_null"
            app:contentInsetStart="@dimen/item_gap_null"
            app:contentInsetStartWithNavigation="@dimen/item_gap_null"
            app:elevation="@dimen/item_gap_null">
            <TextView
                android:textSize="@dimen/text_size_16"
                android:ellipsize="middle"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tvToolbarSettingForgotPasswordTitleName"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_email_verification"
                android:singleLine="true"
                android:layout_centerHorizontal="true"
                android:textAlignment="gravity"
                style="@style/SbTextView.BodyDefault.Bold"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <ViewFlipper
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent">
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/llSettingForgotPasswordStockbit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/acivSettingForgotPasswordSend"
                android:layout_width="@dimen/clickable_size_72"
                android:layout_height="@dimen/clickable_size_72"
                android:layout_marginTop="@dimen/item_gap_20"
                android:src="?attr/themeIconMail"
                android:layout_marginStart="@dimen/item_gap_20"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_size_18"
                android:id="@+id/tvSettingForgotPasswordSendTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/title_reset_email_confirmation_send"
                android:layout_below="@+id/acivSettingForgotPasswordSend"
                android:textAlignment="gravity"
                android:layout_marginStart="@dimen/item_gap_20"
                style="@style/SbTextView.BodyDefault.Bold"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_size_14"
                android:id="@+id/tvSettingForgotPasswordSendSubtitle"
                android:tag="binding_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_m"
                android:layout_below="@+id/tvSettingForgotPasswordSendTitle"
                android:textAlignment="gravity"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20"
                style="@style/SbTextView.BodySecondary"/>
            <com.stockbit.common.uikit.StockbitLoadingButton
                android:id="@+id/rlSettingForgotPasswordSend"
                android:tag="binding_3"
                android:background="@drawable/bg_selector_btn_green"
                android:layout_width="match_parent"
                android:layout_height="@dimen/clickable_size_48"
                android:layout_alignParentBottom="true"
                app:buttonText="@string/button_send"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/llSettingSettingForgotPasswordSuccessStockbit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/acivSettingForgotPasswordSuccessIcon"
                android:layout_width="@dimen/clickable_size_72"
                android:layout_height="@dimen/clickable_size_72"
                android:layout_marginTop="@dimen/item_gap_20"
                android:src="?attr/themeIconMail"
                android:layout_marginStart="@dimen/item_gap_20"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_size_18"
                android:id="@+id/tvTitleSettingForgotPasswordTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/title_email_verification_sent"
                android:layout_below="@+id/acivSettingForgotPasswordSuccessIcon"
                android:textAlignment="gravity"
                android:layout_marginStart="@dimen/item_gap_20"
                style="@style/SbTextView.BodyDefault.Bold"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_size_14"
                android:id="@+id/tvSettingForgotPasswordSubtitle"
                android:tag="binding_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_m"
                android:layout_below="@+id/tvTitleSettingForgotPasswordTitle"
                android:textAlignment="gravity"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20"
                style="@style/SbTextView.BodySecondary"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_size_14"
                android:textColor="?attr/themeColorTextSecondary"
                android:id="@+id/tv_title_email_resend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/text_email_vericication_not_receive"
                android:layout_below="@+id/tvSettingForgotPasswordSubtitle"
                android:textAlignment="gravity"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20"
                style="@style/SbTextView.BodySecondary"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_size_14"
                android:id="@+id/tv_email_resend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_8"
                android:layout_below="@+id/tv_title_email_resend"
                android:textAlignment="gravity"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20"
                style="@style/SbTextView.BodySecondary.Bold"/>
            <com.stockbit.common.uikit.StockbitLoadingButton
                android:id="@+id/sb_done"
                android:background="@drawable/bg_selector_btn_green"
                android:layout_width="match_parent"
                android:layout_height="@dimen/clickable_size_48"
                android:layout_alignParentBottom="true"
                app:buttonText="@string/button_done"/>
        </RelativeLayout>
    </ViewFlipper>
</LinearLayout>
