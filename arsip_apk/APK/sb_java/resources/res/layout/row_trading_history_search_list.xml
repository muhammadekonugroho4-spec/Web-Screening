<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rv_item_stock"
    android:tag="layout/row_trading_history_search_list_0"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/clickable_size_48">
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tv_item_stock_name"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:textAlignment="gravity"
        android:paddingStart="@dimen/item_gap_l"
        android:paddingEnd="@dimen/item_gap_s"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tv_item_stock_desc"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_toRightOf="@+id/tv_item_stock_name"
        android:textAlignment="gravity"
        android:paddingStart="@dimen/item_gap_s"
        android:paddingEnd="@dimen/item_gap_l"
        style="@style/TypeStyles.BodyRegular"/>
    <View
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginBottom="@dimen/item_gap_xxxs"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
