<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent_sentiment_news"
    android:tag="layout/comp_stream_sentiment_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_parent_sentiment_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/row_height_separator_bandar"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_marginBottom="@dimen/spacing_8">
        <TextView
            android:gravity="center"
            android:id="@+id/tv_sentiment_page_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/spacing_6"
            android:layout_marginBottom="@dimen/spacing_2"
            android:text="@string/title_public_sentiment"
            android:layout_marginStart="@dimen/spacing_16"
            style="@style/TypeStyles.BodySmall"/>
        <ImageView
            android:id="@+id/iv_sentiment_info_icon"
            android:background="?attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/spacing_6"
            android:layout_toRightOf="@+id/tv_sentiment_page_title"
            android:layout_toEndOf="@+id/tv_sentiment_page_title"
            android:paddingVertical="@dimen/spacing_6"
            app:srcCompat="@drawable/ic_info"
            app:tint="?attr/themeIconTintColor"/>
        <ImageView
            android:id="@+id/iv_sentiment_beta_icon"
            android:background="?attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/spacing_6"
            android:layout_toRightOf="@+id/iv_sentiment_info_icon"
            android:layout_toEndOf="@+id/iv_sentiment_info_icon"
            android:paddingVertical="@dimen/spacing_6"
            app:srcCompat="@drawable/ic_beta"
            app:tint="?attr/themeIconTintColor"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="end|center_vertical"
            android:id="@+id/tv_sentiment_date_title"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/spacing_6"
            android:layout_marginBottom="@dimen/spacing_2"
            android:layout_toRightOf="@+id/iv_sentiment_beta_icon"
            android:layout_alignParentRight="true"
            android:layout_toEndOf="@+id/iv_sentiment_beta_icon"
            android:layout_alignParentEnd="true"
            android:layout_marginHorizontal="@dimen/spacing_16"
            style="@style/TypeStyles.BodySmall"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/parent_layout_sentiment_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_parent_sentiment_title"
        android:layout_marginHorizontal="@dimen/spacing_16">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_10"
            android:layout_marginTop="@dimen/spacing_16"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/iv_sentiment_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:alpha="0.8"
                android:layout_marginHorizontal="@dimen/uikit_divider_thin"
                app:srcCompat="@drawable/ic_sentiment_bar_1"/>
            <ImageView
                android:id="@+id/iv_sentiment_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:alpha="0.8"
                android:layout_marginHorizontal="@dimen/uikit_divider_thin"
                app:srcCompat="@drawable/ic_sentiment_bar_2"/>
            <ImageView
                android:id="@+id/iv_sentiment_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:alpha="0.8"
                android:layout_marginHorizontal="@dimen/uikit_divider_thin"
                app:srcCompat="@drawable/ic_sentiment_bar_3"/>
            <ImageView
                android:id="@+id/iv_sentiment_5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:alpha="0.8"
                android:layout_marginHorizontal="@dimen/uikit_divider_thin"
                app:srcCompat="@drawable/ic_sentiment_bar_4"/>
            <ImageView
                android:id="@+id/iv_sentiment_6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:alpha="0.8"
                app:srcCompat="@drawable/ic_sentiment_bar_5"/>
        </LinearLayout>
        <View
            android:id="@+id/v_separate"
            android:background="?attr/themeIconTintColor"
            android:layout_width="@dimen/spacing_2"
            android:layout_height="@dimen/row_height_separator_bandar"
            android:layout_marginTop="@dimen/spacing_6"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:id="@+id/ll_sentiment_subparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/parent_layout_sentiment_indicator"
        android:paddingHorizontal="@dimen/spacing_16">
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/text_public_sentiment_pessimistic"
            android:layout_weight="1"
            style="@style/TypeStyles.BodyXXSmall"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/text_public_sentiment_cautious"
            android:layout_weight="1"
            style="@style/TypeStyles.BodyXXSmall"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/text_public_sentiment_neutral"
            android:layout_weight="1"
            style="@style/TypeStyles.BodyXXSmall"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/text_public_sentiment_optimistic"
            android:layout_weight="1"
            style="@style/TypeStyles.BodyXXSmall"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/text_public_sentiment_positive"
            android:layout_weight="1"
            style="@style/TypeStyles.BodyXXSmall"/>
    </LinearLayout>
</RelativeLayout>
