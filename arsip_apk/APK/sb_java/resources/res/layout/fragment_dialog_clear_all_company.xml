<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_dialog_clear_all_company_0"
    android:background="@drawable/bg_top_rounded_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <View
        android:id="@+id/v_divider_top"
        android:background="@drawable/bg_rounded_gray_gray_bg"
        android:layout_width="@dimen/width_40"
        android:layout_height="@dimen/item_gap_5"
        android:layout_marginTop="@dimen/item_gap_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_description_dialog"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_22"
        android:layout_marginTop="@dimen/item_gap_22"
        android:layout_marginRight="@dimen/item_gap_22"
        android:text="@string/confirmation_text_clear_all"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_divider_top"
        style="@style/TypeStyles.ParagraphRegular"/>
    <com.stockbit.uikit.button.SecondaryNeutralButton
        android:id="@+id/snb_btn_cancel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32"
        android:layout_marginBottom="@dimen/spacing_20"
        android:text="@string/button_cancel"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/pb_btn_clear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_description_dialog"
        app:secondaryNeutralButtonColor="neutral"
        app:secondaryNeutralButtonSize="mediumSize"/>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/pb_btn_clear"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_positive_chat_clear"
        android:textAllCaps="false"
        android:layout_marginHorizontal="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="@+id/snb_btn_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/snb_btn_cancel"
        app:layout_constraintTop_toTopOf="@+id/snb_btn_cancel"
        app:primaryButtonColor="red"/>
</androidx.constraintlayout.widget.ConstraintLayout>
