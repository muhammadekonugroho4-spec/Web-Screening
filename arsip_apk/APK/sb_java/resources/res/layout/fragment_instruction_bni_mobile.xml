<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatButton
            android:gravity="center_vertical"
            android:id="@+id/instruction_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/sixteen_dp"
            android:layout_marginTop="@dimen/sixteen_dp"
            android:layout_marginRight="@dimen/sixteen_dp"
            android:text="@string/show_instruction"
            style="@style/ButtonSecondaryExpandable"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/instruction_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/light_gray"
                android:paddingLeft="@dimen/eight_dp"
                android:paddingTop="@dimen/five_dp"
                android:paddingRight="@dimen/eight_dp"
                android:paddingBottom="@dimen/five_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/four_dp">
                <TextView
                    android:layout_width="@dimen/twenty_four_dp"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_1"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:textSize="@dimen/secondary_text_size"
                    android:textColor="@color/black"
                    android:background="@color/light_gray"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bni_mobile_instruction_1"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:paddingLeft="@dimen/eight_dp"
                android:paddingTop="@dimen/five_dp"
                android:paddingRight="@dimen/eight_dp"
                android:paddingBottom="@dimen/five_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eight_dp">
                <TextView
                    android:layout_width="@dimen/twenty_four_dp"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_2"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:textSize="@dimen/secondary_text_size"
                    android:textColor="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bni_mobile_instruction_2"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/light_gray"
                android:paddingLeft="@dimen/eight_dp"
                android:paddingTop="@dimen/five_dp"
                android:paddingRight="@dimen/eight_dp"
                android:paddingBottom="@dimen/five_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/four_dp">
                <TextView
                    android:layout_width="@dimen/twenty_four_dp"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_3"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:textSize="@dimen/secondary_text_size"
                    android:textColor="@color/black"
                    android:background="@color/light_gray"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bni_mobile_instruction_3"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:paddingLeft="@dimen/eight_dp"
                android:paddingTop="@dimen/five_dp"
                android:paddingRight="@dimen/eight_dp"
                android:paddingBottom="@dimen/five_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eight_dp">
                <TextView
                    android:layout_width="@dimen/twenty_four_dp"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_4"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:textSize="@dimen/secondary_text_size"
                    android:textColor="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bni_mobile_instruction_4"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/light_gray"
                android:paddingLeft="@dimen/eight_dp"
                android:paddingTop="@dimen/five_dp"
                android:paddingRight="@dimen/eight_dp"
                android:paddingBottom="@dimen/five_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/four_dp">
                <TextView
                    android:layout_width="@dimen/twenty_four_dp"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_5"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:textSize="@dimen/secondary_text_size"
                    android:textColor="@color/black"
                    android:background="@color/light_gray"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bni_mobile_instruction_5"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:paddingLeft="@dimen/eight_dp"
                android:paddingTop="@dimen/five_dp"
                android:paddingRight="@dimen/eight_dp"
                android:paddingBottom="@dimen/five_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eight_dp">
                <TextView
                    android:layout_width="@dimen/twenty_four_dp"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_6"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:textSize="@dimen/secondary_text_size"
                    android:textColor="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bni_mobile_instruction_6"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
