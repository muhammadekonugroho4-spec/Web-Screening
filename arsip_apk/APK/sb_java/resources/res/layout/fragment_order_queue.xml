<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_order_queue_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stockbit.uikit.topbar.TopbarStockbitTitle
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:topBarType="CenterTitle"/>
    <com.google.android.material.textfield.TextInputLayout
        android:textColorHint="?attr/themeColorTextPrimary"
        android:id="@+id/til_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/item_gap_16"
        android:layout_marginVertical="9.5dp"
        app:boxStrokeColor="@color/color_input_price_outline"
        app:endIconDrawable="@drawable/uikit_ic_stockbit_search_bar_close_fill"
        app:endIconMode="none"
        app:endIconTint="@null"
        app:hintEnabled="false"
        app:prefixTextColor="?attr/themeColorTextSecondary"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <com.google.android.material.textfield.TextInputEditText
            android:textSize="@dimen/default_text_size"
            android:textColor="?attr/themeColorTextPrimary"
            android:textColorHint="?attr/themeColorTextPrimary"
            android:id="@+id/et_price"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_36"
            android:hint="@string/order_queue_input_price_hint"
            android:cursorVisible="false"
            android:inputType="number"
            android:textCursorDrawable="@null"
            android:paddingHorizontal="@dimen/spacing_12"
            android:paddingVertical="0dp"/>
    </com.google.android.material.textfield.TextInputLayout>
    <HorizontalScrollView
        android:id="@+id/hsv"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/ll_table_root"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <include
                android:id="@+id/order_queue_header"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                layout="@layout/item_order_queue_header"/>
            <include
                android:id="@+id/order_queue_header_all_price"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                layout="@layout/item_order_queue_header_all_price"/>
            <com.stockbit.component.pulltorefresh.PullToRefreshLayout
                android:id="@+id/prl_order_queue"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="vertical"
                    android:id="@+id/rv_order_queue"
                    android:background="?attr/themeColorSurfaceDefault"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"/>
            </com.stockbit.component.pulltorefresh.PullToRefreshLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </HorizontalScrollView>
    <ViewFlipper
        android:id="@+id/vp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/order_queue_empty_label"
            app:drawableTopCompat="@drawable/ic_order_queue_empty"
            style="@style/TypeStyles.BodyRegular"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_queue_load_failed_label"
                app:drawableTopCompat="@drawable/ic_order_queue_load_error"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:textSize="@dimen/text_size_13"
                android:textStyle="bold"
                android:textColor="?attr/themeColorBorderGreen"
                android:gravity="center"
                android:id="@+id/tv_error_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:text="@string/order_queue_load_failed_retry_label"
                android:drawablePadding="@dimen/spacing_4"
                app:drawableStartCompat="@drawable/ic_refresh_ccw"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </ViewFlipper>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/ll_my_order_root"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="?attr/themeColorDividerThick"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:layout_marginBottom="@dimen/spacing_20"
                android:text="@string/my_order_label"
                android:layout_marginStart="@dimen/spacing_20"
                style="@style/TypeStyles.BodySmall"/>
            <TextView
                android:id="@+id/tv_my_order_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:layout_marginBottom="@dimen/spacing_20"
                android:layout_marginStart="@dimen/spacing_4"
                style="@style/TypeStyles.HeadingSmall"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_my_order_prev"
                android:layout_width="@dimen/width_16"
                android:layout_height="@dimen/height_16"
                android:layout_marginTop="@dimen/item_gap_13"
                android:src="@drawable/ic_my_order_arrow_down"
                android:rotation="180"
                android:layout_marginEnd="@dimen/spacing_16"/>
            <ImageView
                android:id="@+id/iv_my_order_next"
                android:layout_width="@dimen/width_16"
                android:layout_height="@dimen/height_16"
                android:layout_marginTop="@dimen/item_gap_13"
                android:src="@drawable/ic_my_order_arrow_down"
                android:layout_marginEnd="@dimen/spacing_20"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
