<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.chip.ChipGroup xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chip_group_stream_header"
    android:tag="layout/row_discover_trending_time_0"
    android:clipToPadding="false"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_20"
    android:paddingVertical="@dimen/spacing_16"
    app:chipSpacingHorizontal="@dimen/spacing_8"
    app:singleLine="true"
    app:singleSelection="true">
    <com.google.android.material.chip.Chip
        android:textAppearance="@style/SdChipText"
        android:gravity="center"
        android:id="@+id/chip_weekly"
        android:padding="@dimen/item_gap_s"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/clickable_size_38"
        android:text="@string/weekly"
        android:textAlignment="gravity"
        style="@style/SbChipGreenBackground"/>
    <com.google.android.material.chip.Chip
        android:textAppearance="@style/SdChipText"
        android:gravity="center"
        android:id="@+id/chip_monthly"
        android:padding="@dimen/item_gap_s"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/clickable_size_38"
        android:text="@string/monthly"
        android:textAlignment="gravity"
        style="@style/SbChipGreenBackground"/>
    <com.google.android.material.chip.Chip
        android:textAppearance="@style/SdChipText"
        android:gravity="center"
        android:id="@+id/chip_all_time"
        android:padding="@dimen/item_gap_s"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/clickable_size_38"
        android:text="@string/all_time"
        android:textAlignment="gravity"
        style="@style/SbChipGreenBackground"/>
</com.google.android.material.chip.ChipGroup>
