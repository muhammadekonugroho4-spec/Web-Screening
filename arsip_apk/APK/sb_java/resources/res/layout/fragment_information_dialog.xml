<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_information_dialog_0"
    android:background="@drawable/bg_top_rounded"
    android:paddingTop="@dimen/item_gap_12"
    android:paddingBottom="@dimen/item_gap_32"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/item_gap_20">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/rectangle_dialog"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32"
        app:layout_constraintTop_toBottomOf="@+id/iv_line"
        style="@style/TypeStyles.HeadingLarge"/>
    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_l"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/TypeStyles.ParagraphRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
