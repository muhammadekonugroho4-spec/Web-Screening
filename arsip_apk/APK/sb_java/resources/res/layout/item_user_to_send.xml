<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_user_to_send_0"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/height_80"
    android:minWidth="@dimen/width_60">
    <ImageView
        android:id="@+id/iv_avatar"
        android:background="@drawable/ic_selected_border"
        android:padding="@dimen/avatar_padding"
        android:layout_width="@dimen/avatar_size"
        android:layout_height="@dimen/avatar_size"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_check"
        android:visibility="gone"
        android:layout_width="@dimen/check_size"
        android:layout_height="@dimen/check_size"
        android:layout_marginBottom="@dimen/check_margin"
        android:layout_marginEnd="@dimen/check_margin"
        app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
        app:layout_constraintEnd_toEndOf="@+id/iv_avatar"
        app:srcCompat="@drawable/ic_checked_circle"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:drawablePadding="@dimen/spacing_6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/TypeStyles.BodyXSmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
