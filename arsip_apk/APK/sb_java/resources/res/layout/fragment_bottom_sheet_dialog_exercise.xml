<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_bottom_sheet_dialog_exercise_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_white_rounded"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/v_handle"
            android:background="@drawable/bg_selector_bottom_sheet"
            android:layout_width="@dimen/clickable_size_38"
            android:layout_height="@dimen/item_gap_5"
            android:layout_marginTop="@dimen/item_gap_11"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/height_50"
            android:src="@drawable/ic_broadcast"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:id="@+id/textViewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_23"
            android:text="@string/exercise_title_annouce"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView"
            style="@style/SbTextView.ListTitle"/>
        <TextView
            android:textColor="?attr/themeContentTextDesc"
            android:gravity="center"
            android:id="@+id/textViewDesc"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:text="@string/exercise_desc_annouce"
            android:layout_marginStart="@dimen/item_gap_18"
            android:layout_marginEnd="@dimen/item_gap_18"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewTitle"
            style="@style/SbTextView.BodyDefault"/>
        <TextView
            android:textColor="@color/text_orange"
            android:gravity="center"
            android:id="@+id/textViewDescTime"
            android:visibility="gone"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_16"
            android:text="09 Desember 2021, pukul 10:00 WIB"
            android:layout_marginStart="@dimen/item_gap_18"
            android:layout_marginEnd="@dimen/item_gap_18"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewDesc"
            style="@style/SbTextView.BodyDefault.Highempasis.Bold"/>
        <Button
            android:id="@+id/buttonNext"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_44"
            android:layout_marginBottom="@dimen/item_gap_24"
            android:text="@string/exercise_button_annouce"
            android:layout_marginHorizontal="@dimen/item_gap_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textViewDesc"
            style="@style/SbBtn.PrimaryFullWidthFloating"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
