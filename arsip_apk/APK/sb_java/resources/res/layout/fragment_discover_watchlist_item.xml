<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentFragmentDiscoverWatchlistItem"
    android:tag="layout/fragment_discover_watchlist_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llDiscoverWatchlistItemTitle"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/tv_title_follow_your_friend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_32"
            android:text="@string/title_follow_stock"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/AppTabTextAppearance.Bold.Active"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_16"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_msg_follow_friend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_8"
            android:text="@string/text_follow_stock"
            android:paddingHorizontal="@dimen/spacing_40"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_follow_your_friend"
            style="@style/SbTextView.Caption.Mediumempasis"/>
        <include
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_24"
            android:layout_marginStart="@dimen/item_gap_l"
            android:layout_marginEnd="@dimen/item_gap_l"
            layout="@layout/comp_search_bar_rounded_bg"/>
    </LinearLayout>
    <View
        android:id="@+id/viewFragmentDiscoverWatchlistItem"
        android:background="?attr/themeSeparatorGapColor"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_below="@+id/llDiscoverWatchlistItemTitle"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/item_gap_4"
        android:minHeight="@dimen/clickable_size_72"
        android:layout_below="@+id/viewFragmentDiscoverWatchlistItem">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFragmentDiscoverWatchlistItem"
            android:paddingBottom="@dimen/item_gap_l"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/btnDiscoverWatchlistItemDone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <com.stockbit.uikit.buttons.StickyButton
            android:id="@+id/btnDiscoverWatchlistItemDone"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_add_list"
            android:layout_alignParentBottom="true"
            app:isActive="true"/>
    </RelativeLayout>
    <ProgressBar
        android:id="@+id/progressWatchlistItem"
        android:tag="binding_3"
        android:layout_width="@dimen/clickable_size_32"
        android:layout_height="@dimen/clickable_size_32"
        android:layout_centerInParent="true"/>
</RelativeLayout>
