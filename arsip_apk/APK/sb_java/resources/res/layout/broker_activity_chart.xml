<?xml version="1.0" encoding="utf-8"?>
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vf_content"
    android:tag="layout/broker_activity_chart_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/lc_chart"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <include
            android:layout_gravity="center"
            android:id="@+id/layout_empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            layout="@layout/broker_activity_chart_empty"/>
        <View
            android:id="@+id/v_divider"
            android:background="?attr/themeColorDividerGreyBorder"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/item_gap_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/lc_chart"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/rv_period"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/v_divider"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/rv_broker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            app:layout_constraintTop_toBottomOf="@+id/rv_period"/>
    </LinearLayout>
    <include
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/broker_activity_chart_loading"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/layout_error"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/broker_activity_chart_error"/>
</ViewFlipper>
