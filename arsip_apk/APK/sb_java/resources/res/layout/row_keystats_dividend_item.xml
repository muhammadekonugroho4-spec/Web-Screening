<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_keystats_dividend_item_0"
    android:paddingTop="@dimen/item_gap_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/item_gap_20">
    <TextView
        android:gravity="start|center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_period"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingRegular"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:gravity="end|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_dividend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="74dp"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="end|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_ex_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="100dp"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="end|center_vertical"
            android:id="@+id/tv_payment_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="100dp"
            style="@style/TypeStyles.BodyRegular"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
