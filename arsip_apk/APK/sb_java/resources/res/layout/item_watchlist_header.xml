<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_root"
    android:tag="layout/item_watchlist_header_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_50"
        android:paddingEnd="@dimen/item_gap_12"
        app:layout_constraintTop_toTopOf="parent">
        <ViewFlipper
            android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@+id/vf_watchlist_favorite_container"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/item_gap_16">
                <com.google.android.material.chip.Chip
                    android:textAppearance="@style/WatchlistChip"
                    android:textColor="@color/dark_artboard_border_green"
                    android:id="@+id/c_loading"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginTop="@dimen/item_gap_11"
                    android:text="All Watchlist"
                    android:layout_marginStart="@dimen/item_gap_16"
                    app:chipBackgroundColor="?attr/themeColorSurfaceDefault"
                    app:chipEndPadding="@dimen/item_gap_12"
                    app:chipStartPadding="@dimen/item_gap_12"
                    app:chipStrokeColor="?attr/themeColorBorderGreen"
                    app:chipStrokeWidth="1dp"
                    app:closeIcon="0x7f0803bf"
                    app:closeIconEnabled="true"
                    app:closeIconEndPadding="0dp"
                    app:closeIconSize="@dimen/height_16"
                    app:closeIconStartPadding="@dimen/item_gap_4"
                    app:closeIconTint="?attr/themeColorBorderGreen"
                    app:ensureMinTouchTargetSize="false"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:textEndPadding="0dp"
                    app:textStartPadding="0dp"/>
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:background="?attr/themeShimmer"
                    android:paddingTop="@dimen/item_gap_11"
                    android:paddingBottom="@dimen/item_gap_11"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginBottom="1dp"
                    android:layout_marginStart="@dimen/item_gap_8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/c_loading"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/FBShimmerFrameLayout">
                    <View
                        android:background="@drawable/bg_rounded_gray"
                        android:padding="@dimen/item_gap_16"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        style="@style/SBShimmerItem"/>
                </com.facebook.shimmer.ShimmerFrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/rv_watchlist_favorite"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:focusable="true"
                    android:clickable="true"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="@dimen/item_gap_16"
                    android:paddingEnd="@dimen/item_gap_m"
                    android:layout_marginEnd="@dimen/item_gap_16"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ViewFlipper>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_more"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/width_16"
            android:layout_height="@dimen/height_16"
            android:contentDescription="@string/lbl_watchlist_add_symbol"
            android:layout_marginEnd="@dimen/item_gap_8"
            app:srcCompat="@drawable/ic_more_horizontal"
            app:tint="?attr/themeColorIconDefault"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_add"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:contentDescription="@string/lbl_watchlist_add_symbol"
            android:layout_marginEnd="@dimen/item_gap_8"
            app:srcCompat="@drawable/ic_add_symbol"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
