<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="65dp">
    <View
        android:id="@+id/v_symbol_image"
        android:layout_width="@dimen/width_32"
        android:layout_height="@dimen/width_32"
        android:layout_marginStart="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FBShimmerItem.Circular"/>
    <View
        android:id="@+id/viewRoomNameSkeletonSub"
        android:layout_width="190dp"
        android:layout_height="@dimen/width_32"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_symbol_image"
        app:layout_constraintStart_toEndOf="@+id/v_symbol_image"
        app:layout_constraintTop_toTopOf="@+id/v_symbol_image"
        style="@style/FBShimmerItem"/>
    <View
        android:id="@+id/viewRoomNameSkeleton2Sub"
        android:layout_width="56dp"
        android:layout_height="@dimen/width_32"
        android:layout_marginEnd="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="@+id/viewRoomNameSkeletonSub"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/viewRoomNameSkeletonSub"
        style="@style/FBShimmerItem"/>
    <com.stockbit.uikit.divider.SBDivider
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
