<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_buy_expiry_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center"
        android:id="@+id/tvDescSetExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_16"
        android:text="@string/trading_desc_gdc"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        style="@style/TypeStyles.BodyRegular"/>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/rlGoodForDayLayout"
        android:paddingTop="@dimen/item_gap_l"
        android:paddingBottom="@dimen/item_gap_m"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:layout_below="@+id/tvDescSetExpiry"
        android:layout_marginHorizontal="@dimen/item_gap_20">
        <com.stockbit.uikit.control.ControlRadioButton
            android:id="@+id/crb_good_for_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/item_gap_s"
            android:layout_alignParentEnd="true"
            app:radioType="tick"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/crb_good_for_days"
            android:layout_centerVertical="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/item_gap_s"
                android:text="@string/buy_title_good_for_day"
                style="@style/TypeStyles.HeadingLarge"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/item_gap_s"
                android:text="@string/trading_desc_good_for_day"
                style="@style/TypeStyles.BodyRegular"/>
        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/rlGoodTillCanceledLayout"
        android:paddingTop="@dimen/item_gap_l"
        android:paddingBottom="@dimen/item_gap_m"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:layout_below="@+id/rlGoodForDayLayout"
        android:layout_marginHorizontal="@dimen/item_gap_20">
        <com.stockbit.uikit.control.ControlRadioButton
            android:id="@+id/crb_good_till_cancelled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/item_gap_s"
            android:layout_alignParentEnd="true"
            app:radioType="tick"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toLeftOf="@+id/crb_good_till_cancelled"
            android:layout_centerVertical="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/item_gap_s"
                android:text="@string/buy_title_good_till_canceled"
                style="@style/TypeStyles.HeadingLarge"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/item_gap_s"
                android:text="@string/trading_desc_good_till_cancelled"
                style="@style/TypeStyles.BodyRegular"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
