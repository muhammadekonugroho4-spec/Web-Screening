<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:id="@+id/ll_add_company"
    android:tag="layout/item_stocks_search_0"
    android:background="@drawable/bg_list_selector"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_20"
    android:paddingVertical="@dimen/item_gap_10">
    <ImageView
        android:id="@+id/iv_company_logo"
        android:layout_width="@dimen/spacing_20"
        android:layout_height="@dimen/spacing_20"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:gravity="top"
        android:id="@+id/tv_company_symbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/avatar_size_52"
        android:singleLine="true"
        android:layout_marginStart="@dimen/spacing_12"
        style="@style/TypeStyles.HeadingRegular"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorTextSecondary"
        android:ellipsize="end"
        android:gravity="top"
        android:id="@+id/tv_company_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_12"
        style="@style/TypeStyles.BodyRegular"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_item_unfollowed"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="@dimen/clickable_size_20"
        android:layout_height="@dimen/clickable_size_20"
        app:srcCompat="?attr/themeIconWatchlistMenuAddSymbolEnabled"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_item_followed"
        android:padding="@dimen/item_gap_3"
        android:focusable="false"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="@dimen/clickable_size_20"
        android:layout_height="@dimen/clickable_size_20"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/ic_check_circle_green_24dp"/>
</LinearLayout>
