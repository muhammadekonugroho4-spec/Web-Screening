<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_banner_parent"
    android:tag="layout/item_watchlist_eipo_0"
    android:paddingTop="@dimen/item_gap_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintLeft_toLeftOf="parent"
    app:layout_constraintRight_toRightOf="parent">
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:id="@+id/tv_label_eipo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/setting_e_ipo"
        android:layout_marginStart="@dimen/item_gap_16"
        android:layout_marginEnd="@dimen/item_gap_16"
        app:layout_constraintBottom_toTopOf="@+id/rv_ipo"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingLarge"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_ipo"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:layout_marginBottom="@dimen/item_gap_16"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_label_eipo"/>
    <View
        android:id="@+id/v_border_bottom"
        android:background="?attr/themeColorDividerThick"
        android:layout_width="match_parent"
        android:layout_height="@dimen/uikit_divider_thick"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
