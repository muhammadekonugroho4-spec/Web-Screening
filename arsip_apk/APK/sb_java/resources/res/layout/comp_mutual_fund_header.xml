<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_mutual_fund_header"
    android:tag="layout/comp_mutual_fund_header_0"
    android:paddingTop="@dimen/item_gap_l"
    android:paddingBottom="@dimen/item_gap_m"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="marquee"
        android:id="@+id/tv_company_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:drawablePadding="4dp"
        android:drawableEnd="@drawable/ic_chevron_down_12"
        android:layout_marginHorizontal="20dp"
        app:autoSizeMaxTextSize="@dimen/text_title"
        app:autoSizeMinTextSize="@dimen/text_body"
        app:autoSizeTextType="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"
        style="@style/TypeStyles.HeadlineRegular"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:id="@+id/tv_type"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="RD Pasar Uang"
        app:layout_constraintStart_toStartOf="@+id/tv_company_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_company_name"
        style="@style/TypeStyles.BodySmall"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="center"
        android:id="@+id/tv_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/lbl_nav"
        android:layout_marginStart="20dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_last_price_date"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_type"
        style="@style/TypeStyles.HeadingSmall"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:id="@+id/tv_last_price_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_badge"
        app:layout_constraintEnd_toStartOf="@+id/iv_fund_manager"
        app:layout_constraintStart_toEndOf="@+id/tv_badge"
        app:layout_constraintTop_toTopOf="@+id/tv_badge"
        style="@style/TypeStyles.BodySmall"/>
    <TextView
        android:textSize="34sp"
        android:id="@+id/tv_price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_last_price_date"
        app:layout_constraintStart_toStartOf="@+id/tv_badge"
        app:layout_constraintTop_toBottomOf="@+id/tv_badge"
        style="@style/SbTextView.PageTitle"/>
    <TextView
        android:textColor="@color/green_text"
        android:id="@+id/tv_price_changes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_below="@+id/tv_price"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_badge"
        app:layout_constraintTop_toBottomOf="@+id/tv_price"
        style="@style/TypeStyles.BodySmall"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:id="@+id/tv_periode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/periode_1_y"
        android:layout_below="@+id/tv_price"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_price_changes"
        app:layout_constraintEnd_toEndOf="@+id/tv_last_price_date"
        app:layout_constraintStart_toEndOf="@+id/tv_price_changes"
        app:layout_constraintTop_toTopOf="@+id/tv_price_changes"
        style="@style/TypeStyles.BodySmall"/>
    <ImageView
        android:id="@+id/iv_fund_manager"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:scaleType="fitEnd"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_periode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_last_price_date"
        app:layout_constraintTop_toTopOf="@+id/tv_last_price_date"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/rv_applied_comparison"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_l"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_periode"/>
    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/lc_mutual_fund"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="@dimen/item_gap_s"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_applied_comparison"/>
    <androidx.core.widget.ContentLoadingProgressBar
        android:id="@+id/progress_loading"
        android:tag="binding_2"
        android:layout_width="@dimen/icon_size"
        android:layout_height="@dimen/icon_size"
        android:indeterminate="true"
        android:layout_centerInParent="true"
        android:indeterminateTint="@color/green_text"
        app:layout_constraintBottom_toBottomOf="@+id/lc_mutual_fund"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_periode"
        style="@style/Widget.AppCompat.ProgressBar"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/rv_filters"
        android:paddingRight="@dimen/item_gap_l"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/clickable_size_32"
        android:layout_marginLeft="@dimen/item_gap_l"
        android:layout_marginTop="4dp"
        android:overScrollMode="never"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintHorizontal_bias="0.44"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lc_mutual_fund"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_s"
        app:layout_constraintTop_toBottomOf="@+id/rv_filters"/>
</androidx.constraintlayout.widget.ConstraintLayout>
