<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_parent"
    android:tag="layout/dialog_app_update_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_title_parent"
        android:background="@drawable/bg_top_rounded"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48">
        <ImageButton
            android:id="@+id/ib_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:layout_marginRight="@dimen/item_gap_m"
            android:scaleType="centerInside"
            android:tint="?attr/themeIconTintColor"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/navigation_drawer_close"
            app:srcCompat="0x7f08063f"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/clickable_size_32"
            android:layout_marginLeft="@dimen/item_gap_l"
            android:text="@string/title_update_your_app"
            android:includeFontPadding="false"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            style="@style/SbTextView.PageTitle"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_title_parent">
        <RelativeLayout
            android:background="?attr/themeDialogBackgroundColor"
            android:paddingTop="@dimen/item_gap_m"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="@dimen/avatar_size_xl"
                android:layout_height="@dimen/avatar_size_xl"
                android:layout_marginLeft="@dimen/item_gap_l"
                android:layout_centerHorizontal="true"
                app:srcCompat="@drawable/ic_confetti_new_update"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_description"
                android:paddingBottom="@dimen/item_gap_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/item_gap_l"
                android:layout_marginTop="@dimen/item_gap_l"
                android:layout_marginRight="@dimen/item_gap_l"
                android:text="@string/msg_new_update_available"
                android:layout_below="@+id/iv_icon"
                style="@style/SbTextView.IntroductionContent"/>
            <Button
                android:id="@+id/btn_update_now"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/item_gap_l"
                android:layout_marginTop="@dimen/item_gap_l"
                android:layout_marginRight="@dimen/item_gap_l"
                android:layout_marginBottom="@dimen/clickable_size_32"
                android:text="@string/update_now"
                android:layout_below="@+id/tv_description"
                android:layout_alignParentRight="true"
                android:textAllCaps="true"
                style="@style/SbBtn.PrimaryFullWidthFloating"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
