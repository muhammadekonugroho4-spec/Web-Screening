<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_bond_sell_0"
    android:background="@drawable/bg_bond_sell"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_16"
    android:paddingVertical="@dimen/spacing_12">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_symbol"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_symbol_logo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tv_symbol_title"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:textAlignment="textStart"
            android:layout_marginStart="@dimen/spacing_10"
            app:layout_constraintBottom_toTopOf="@+id/tv_symbol_subtitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_symbol_logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:id="@+id/tv_symbol_subtitle"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:textAlignment="textStart"
            android:layout_marginStart="@dimen/spacing_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_symbol_logo"
            app:layout_constraintTop_toBottomOf="@+id/tv_symbol_title"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/TypeStyles.BodyXSmall"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/divider"
        android:background="?attr/themeColorModalsBorder"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/spacing_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_symbol"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/divider">
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:id="@+id/tv_investment_capital_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bond_investment_capital_title"
            app:layout_constraintBottom_toTopOf="@+id/tv_total_unit_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:id="@+id/tv_investment_capital_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_investment_capital_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_investment_capital_title"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:id="@+id/tv_total_unit_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bond_sell_picker_unit_title"
            android:layout_marginVertical="@dimen/spacing_16"
            app:layout_constraintBottom_toTopOf="@+id/tv_buy_date_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_investment_capital_title"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:id="@+id/tv_total_unit_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_total_unit_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_total_unit_title"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:id="@+id/tv_buy_date_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bond_sell_picker_buy_date_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_total_unit_title"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:id="@+id/tv_buy_date_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_buy_date_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_buy_date_title"
            style="@style/TypeStyles.BodyRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
