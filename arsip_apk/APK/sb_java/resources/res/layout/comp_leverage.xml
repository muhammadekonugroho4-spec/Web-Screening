<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_leverage_0"
    android:paddingTop="@dimen/item_gap_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="start|center_vertical"
        android:id="@+id/tv_leverage_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/buy_title_leverage"
        android:textAlignment="gravity"
        android:layout_marginStart="@dimen/item_gap_16"
        app:layout_constraintBottom_toBottomOf="@+id/tv_leverage_option"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_leverage_option"
        style="@style/TypeStyles.BodyRegular"/>
    <ImageView
        android:id="@+id/iv_icon_info"
        android:layout_width="@dimen/spacing_16"
        android:layout_height="@dimen/spacing_16"
        android:src="@drawable/uikit_ic_stockbit_row_info_grey"
        android:layout_marginStart="@dimen/spacing_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_leverage_title"
        app:layout_constraintStart_toEndOf="@+id/tv_leverage_title"
        app:layout_constraintTop_toTopOf="@+id/tv_leverage_title"/>
    <TextView
        android:textColor="?attr/themeColorSemanticInactive"
        android:id="@+id/tv_leverage_none"
        android:background="@drawable/bg_chips_inactive"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/height_28"
        android:text="@string/day_trade_option_none"
        android:layout_marginEnd="@dimen/spacing_8"
        android:paddingHorizontal="@dimen/spacing_12"
        android:paddingVertical="@dimen/spacing_6"
        app:layout_constraintBottom_toBottomOf="@+id/tv_leverage_option"
        app:layout_constraintEnd_toStartOf="@+id/tv_leverage_option"
        app:layout_constraintTop_toTopOf="@+id/tv_leverage_option"
        style="@style/TypeStyles.HeadingXSmall"/>
    <TextView
        android:textColor="?attr/themeColorSemanticInactive"
        android:gravity="center"
        android:id="@+id/tv_leverage_option"
        android:background="@drawable/bg_chips_inactive"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/height_28"
        android:drawablePadding="@dimen/spacing_4"
        android:layout_marginEnd="@dimen/item_gap_16"
        android:paddingHorizontal="@dimen/spacing_12"
        android:paddingVertical="@dimen/spacing_6"
        app:drawableTint="?attr/themeColorIconDefault"
        app:layout_constraintBottom_toTopOf="@+id/divider_leverage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingXSmall"/>
    <com.stockbit.uikit.divider.SBDivider
        android:id="@+id/divider_leverage"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        app:dividerVariant="thin_grey"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_leverage_option"/>
</androidx.constraintlayout.widget.ConstraintLayout>
