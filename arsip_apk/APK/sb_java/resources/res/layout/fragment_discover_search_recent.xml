<?xml version="1.0" encoding="utf-8"?>
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vfShareholderMainDiscoverSearchRecent"
    android:tag="layout/fragment_discover_search_recent_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/plProgressDiscoverSearchRecent"
        android:layout_width="@dimen/clickable_size_32"
        android:layout_height="@dimen/clickable_size_32"
        android:indeterminate="true"
        android:indeterminateTint="?attr/themeIconTintColor"
        style="?android:attr/progressBarStyle"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:paddingTop="@dimen/item_gap_l"
                android:paddingBottom="@dimen/item_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recent_search_title"
                android:paddingStart="@dimen/spacing_20"
                android:paddingEnd="@dimen/item_gap_l"
                style="@style/TypeStyles.HeadlineRegular"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <TextView
                android:textColor="@color/green_text"
                android:id="@+id/tv_clear_all"
                android:paddingLeft="@dimen/spacing_8"
                android:paddingTop="@dimen/spacing_8"
                android:paddingRight="@dimen/spacing_8"
                android:paddingBottom="@dimen/spacing_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_clear_all"
                android:layout_marginEnd="@dimen/spacing_12"
                style="@style/TypeStyles.HeadingXSmall"/>
        </LinearLayout>
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDiscoverSearchRecent"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/rlDiscoverSearchRecentError"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:id="@+id/tvDiscoverSearchRecentError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/msg_loading_alert_company_info_error"
            android:layout_centerHorizontal="true"
            style="@style/SbTextView.BodyDefault"/>
        <Button
            android:id="@+id/btnDiscoverSearchRecentReload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_s"
            android:text="@string/btn_click_to_refresh"
            android:layout_below="@+id/tvDiscoverSearchRecentError"
            android:layout_centerHorizontal="true"
            style="@style/SbBtnBorderless.Small"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</ViewFlipper>
