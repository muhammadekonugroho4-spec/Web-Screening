<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:id="@+id/parentCompEmptyDataTradingOrderlist"
    android:tag="layout/comp_empty_data_virtual_portfolio_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ivEmptyImg"
        android:layout_width="@dimen/clickable_size_96"
        android:layout_height="@dimen/clickable_size_96"
        android:layout_marginTop="@dimen/item_gap_32"
        android:layout_marginBottom="@dimen/item_gap_24"
        app:srcCompat="@drawable/ic_portfolio"/>
    <TextView
        android:textSize="@dimen/text_size_16"
        android:gravity="center"
        android:id="@+id/tvtitleEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_l"
        android:text="@string/empty_portfolio_title"
        android:textAlignment="gravity"
        style="@style/SbTextView.BodyDefault.Bold"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="?attr/titleTextColorHighgray"
        android:gravity="center"
        android:id="@+id/tvSubtitleEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/empty_portfolio_subtitle"
        android:textAlignment="gravity"
        style="@style/SbTextView.BodyDefault"/>
    <Button
        android:textSize="@dimen/text_size_16"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_gravity="center"
        android:id="@+id/addEmptyBtn"
        android:background="@drawable/border_green_rounded"
        android:layout_width="@dimen/btn_width"
        android:layout_height="@dimen/default_button_height"
        android:layout_marginLeft="@dimen/item_gap_40"
        android:layout_marginTop="@dimen/item_gap_24"
        android:layout_marginRight="@dimen/item_gap_40"
        android:foreground="?attr/selectableItemBackground"
        android:text="@string/empty_button_portfolio"
        android:textAllCaps="false"/>
</LinearLayout>
