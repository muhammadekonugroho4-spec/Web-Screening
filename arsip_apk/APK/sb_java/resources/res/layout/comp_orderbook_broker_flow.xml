<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_orderbook_broker_flow_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_border"
        android:background="?attr/themeColorDividerThick"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_8"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_border">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_title_broker_flow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:text="@string/broker_flow_title"
            android:layout_marginStart="@dimen/item_gap_l"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingLarge"/>
        <ImageView
            android:id="@+id/iv_info"
            android:tag="binding_1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/spacing_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title_broker_flow"
            app:layout_constraintStart_toEndOf="@+id/tv_title_broker_flow"
            app:layout_constraintTop_toTopOf="@+id/tv_title_broker_flow"
            app:srcCompat="@drawable/ic_info"/>
        <LinearLayout
            android:gravity="end"
            android:id="@+id/ll_open_full_page"
            android:layout_width="0dp"
            android:layout_height="@dimen/height_24"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title_broker_flow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_info"
            app:layout_constraintTop_toTopOf="@+id/tv_title_broker_flow">
            <ImageView
                android:layout_width="@dimen/height_36"
                android:layout_height="@dimen/height_24"
                android:contentDescription="@null"
                android:paddingEnd="@dimen/item_gap_12"
                app:srcCompat="0x7f0804cf"
                app:tint="?attr/themeColorIconDefault"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_16"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_broker_flow">
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/sfl_chart_type"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:background="?attr/themeShimmer"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/height_32"
                        android:backgroundTint="?attr/themeShimmer"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16">
                        <View
                            android:background="@drawable/bg_circle"
                            android:layout_width="@dimen/width_64"
                            android:layout_height="@dimen/height_28"
                            android:backgroundTint="?attr/themeShimmer"/>
                        <View
                            android:background="@drawable/bg_circle"
                            android:layout_width="@dimen/width_72"
                            android:layout_height="@dimen/height_28"
                            android:layout_marginStart="@dimen/spacing_8"
                            android:backgroundTint="?attr/themeShimmer"/>
                        <Space
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <View
                            android:background="?attr/themeShimmer"
                            android:layout_width="@dimen/width_140"
                            android:layout_height="@dimen/height_20"
                            android:backgroundTint="?attr/themeShimmer"/>
                    </LinearLayout>
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/cv_broker_flow_filter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.stockbit.uikit.chips.SBChipsGroup
                android:id="@+id/sbcg_chart_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:layout_marginStart="@dimen/spacing_16"
                app:chipsActionMode="single_pick"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cv_broker_flow_filter">
                <com.stockbit.uikit.chips.SBChips
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipsSelected="true"
                    app:chipsText="Value"/>
                <com.stockbit.uikit.chips.SBChips
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipsText="Volume"/>
            </com.stockbit.uikit.chips.SBChipsGroup>
            <ImageView
                android:id="@+id/iv_prev_date"
                android:tag="binding_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_chevron_arrow_left"
                android:contentDescription="@null"
                android:paddingEnd="@dimen/item_gap_13"
                app:layout_constraintBottom_toBottomOf="@+id/tv_date"
                app:layout_constraintEnd_toStartOf="@+id/tv_date"
                app:layout_constraintTop_toTopOf="@+id/tv_date"
                app:tint="@color/green_text"/>
            <TextView
                android:textColor="?attr/themeColorTextGreen"
                android:gravity="center_vertical"
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/spacing_8"
                app:drawableEndCompat="@drawable/ic_calendar_low_green"
                app:layout_constraintBottom_toBottomOf="@+id/sbcg_chart_type"
                app:layout_constraintEnd_toStartOf="@+id/iv_next_date"
                app:layout_constraintTop_toTopOf="@+id/sbcg_chart_type"
                style="@style/TypeStyles.BodySmall"/>
            <ImageView
                android:id="@+id/iv_next_date"
                android:tag="binding_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_chevron_arrow_right"
                android:contentDescription="@null"
                android:paddingStart="@dimen/item_gap_13"
                app:layout_constraintBottom_toBottomOf="@+id/tv_date"
                app:layout_constraintEnd_toStartOf="@+id/spacer_next_date"
                app:layout_constraintTop_toTopOf="@+id/tv_date"/>
            <Space
                android:id="@+id/spacer_next_date"
                android:layout_width="@dimen/width_16"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/iv_next_date"/>
            <com.stockbit.component.securities.brokerflow.chart.StockbitBrokerFlowChart
                android:id="@+id/comp_broker_flow_chart"
                android:layout_width="match_parent"
                android:layout_height="458dp"
                android:layout_marginTop="@dimen/item_gap_14"
                android:paddingHorizontal="@dimen/spacing_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sbcg_chart_type"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
