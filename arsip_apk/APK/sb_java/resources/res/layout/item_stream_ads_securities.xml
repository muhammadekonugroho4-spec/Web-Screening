<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_banner"
    android:tag="layout/item_stream_ads_securities_0"
    android:visibility="visible"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bannerBackground"
        android:background="?attr/backgroundBubble"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:layout_marginStart="@dimen/item_gap_20"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close"
            android:padding="2dp"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="@dimen/item_gap_16"
            android:src="0x7f080644"
            android:layout_marginEnd="@dimen/item_gap_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/earlyBirdImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="@dimen/item_gap_20"
            android:layout_marginStart="@dimen/item_gap_14"
            android:layout_marginEnd="@dimen/item_gap_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/close"
            app:srcCompat="@drawable/ic_zero_broker_fee"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/aciv_logo_stockbit"
            android:layout_width="52dp"
            android:layout_height="@dimen/item_gap_20"
            android:layout_marginTop="26dp"
            android:scaleType="fitXY"
            android:layout_marginStart="@dimen/item_gap_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/themeStockbitLogoWithText"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:id="@+id/tv_free_broker_fee"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_16"
            android:text="@string/title_free_broker_fee_investment"
            android:layout_marginStart="@dimen/item_gap_16"
            android:layout_marginEnd="@dimen/item_gap_16"
            app:layout_constraintEnd_toStartOf="@+id/earlyBirdImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/aciv_logo_stockbit"
            style="@style/SbTextView.PageTitle.HighEmphasis"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnSignUp"
            android:background="@drawable/border_green_rounded"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="@dimen/height_16"
            android:layout_marginBottom="@dimen/item_gap_20"
            android:paddingStart="@dimen/item_gap_16"
            android:paddingEnd="@dimen/item_gap_16"
            app:layout_constraintStart_toStartOf="@+id/tv_free_broker_fee"
            app:layout_constraintTop_toBottomOf="@+id/tv_free_broker_fee">
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/pb_sign_up"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_earlybird"
                android:layout_weight="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/SbTextView.PageTitle"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/imageView2"
                android:layout_width="16dp"
                android:layout_height="10dp"
                android:layout_weight="1"
                android:paddingStart="@dimen/item_gap_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/textView"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_chevron_right"
                app:tint="@color/white"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/gap_banner"
        android:background="?attr/themeColorDividerThick"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_8"
        android:layout_marginTop="@dimen/item_gap_16"
        app:layout_constraintTop_toBottomOf="@+id/bannerBackground"/>
</androidx.constraintlayout.widget.ConstraintLayout>
