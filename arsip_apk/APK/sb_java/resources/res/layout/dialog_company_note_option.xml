<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/dialog_company_note_option_0"
    android:paddingTop="@dimen/spacing_8"
    android:paddingBottom="@dimen/spacing_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_20">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv_copy_text"
        android:background="?android:attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stream_company_note_copy_text"
        android:drawablePadding="@dimen/spacing_16"
        android:paddingStart="@dimen/spacing_8"
        android:paddingVertical="@dimen/spacing_8"
        app:drawableStartCompat="@drawable/ic_copy_outline"
        app:drawableTint="?attr/themeColorIconDefault"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv_edit_note"
        android:background="?android:attr/selectableItemBackground"
        android:padding="@dimen/spacing_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stream_company_note_edit_note"
        android:drawablePadding="@dimen/spacing_14"
        android:layout_marginVertical="@dimen/spacing_16"
        app:drawableStartCompat="@drawable/ic_stream_option_edit"
        app:drawableTint="?attr/themeColorIconDefault"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv_delete_note"
        android:background="?android:attr/selectableItemBackground"
        android:padding="@dimen/spacing_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stream_company_note_delete_note"
        android:drawablePadding="@dimen/spacing_14"
        app:drawableStartCompat="@drawable/ic_trash_outline"
        app:drawableTint="?attr/themeColorIconDefault"
        style="@style/TypeStyles.BodyRegular"/>
</LinearLayout>
