<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/bond_terms_bottom_sheet_layout_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/spacing_20">
    <TextView
        android:id="@+id/bond_terms_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bond_terms_and_condition_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadlineRegular"/>
    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        app:layout_constraintTop_toBottomOf="@+id/bond_terms_title">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/border_gray_rounded_transparent_bg"
                android:padding="@dimen/spacing_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bond_terms_and_condition_first"
                    style="@style/TypeStyles.HeadingSmall"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:text="@string/bond_terms_and_condition_content"
                    android:justificationMode="inter_word"
                    style="@style/TypeStyles.ParagraphSmall"/>
            </LinearLayout>
            <com.stockbit.uikit.button.PrimaryButton
                android:id="@+id/pb_bond_tnc_agree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:layout_marginBottom="@dimen/spacing_50"
                android:text="@string/bond_button_tnc_agree"
                app:primaryButtonColor="green"
                app:primaryButtonSize="defaultSize"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
