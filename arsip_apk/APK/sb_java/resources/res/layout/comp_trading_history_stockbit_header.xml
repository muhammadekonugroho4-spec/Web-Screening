<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/comp_trading_history_stockbit_header_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.stockbit.uikit.chips.SBChipsGroup
            android:layout_gravity="center"
            android:id="@+id/chip_group"
            android:paddingLeft="@dimen/item_gap_18"
            android:paddingRight="@dimen/item_gap_l"
            android:clipToPadding="false"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:paddingVertical="@dimen/item_gap_m"
            app:chipsActionMode="single_pick"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_header">
            <com.stockbit.uikit.chips.SBChips
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipsText="@string/stockbit_history_chip_all"/>
            <com.stockbit.uikit.chips.SBChips
                android:id="@+id/chip_realized"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipsText="@string/stockbit_history_chip_realized"/>
        </com.stockbit.uikit.chips.SBChipsGroup>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_gravity="end|center_vertical"
            android:id="@+id/ll_realized_filter"
            android:background="@drawable/bg_rounded_outline_artboard_border"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_20">
            <ImageView
                android:id="@+id/iv_realized_filter"
                android:layout_width="@dimen/width_14"
                android:layout_height="@dimen/height_14"
                android:layout_marginHorizontal="@dimen/item_gap_10"
                android:layout_marginVertical="@dimen/item_gap_7"
                app:srcCompat="?attr/themeIconFilterMore"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_history_period"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="@dimen/item_gap_20"
            android:layout_marginStart="@dimen/spacing_8">
            <TextView
                android:textSize="@dimen/text_size_12"
                android:textStyle="bold"
                android:textColor="@color/green_text"
                android:gravity="end|center_vertical"
                android:id="@+id/tv_trading_history_period"
                android:tag="binding_1"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="@dimen/item_gap_m"
                android:paddingBottom="@dimen/item_gap_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.15"
                android:textAlignment="gravity"
                android:layout_marginStart="@dimen/item_gap_xxs"
                android:layout_marginEnd="@dimen/spacing_4"
                style="@style/SbTextView.BodyDefault"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/iv_trading_history_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:srcCompat="@drawable/ic_arrow_down_green_16dp"
                app:tint="@color/highgray_light"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
