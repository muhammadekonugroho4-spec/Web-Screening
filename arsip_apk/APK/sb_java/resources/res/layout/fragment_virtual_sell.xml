<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_virtual_sell_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarTradingSell"
            android:paddingLeft="@dimen/item_gap_null"
            android:paddingRight="@dimen/item_gap_null"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="?attr/actionBarSize"
            app:contentInsetLeft="@dimen/item_gap_null"
            app:contentInsetStart="@dimen/item_gap_null"
            app:contentInsetStartWithNavigation="@dimen/item_gap_null"
            app:elevation="@dimen/item_gap_null">
            <RelativeLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minHeight="?attr/actionBarSize">
                <TextView
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:id="@+id/tvToolbarTitleTradingSell"
                    android:paddingLeft="@dimen/item_gap_l"
                    android:paddingRight="@dimen/item_gap_l"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/trading_sell_title"
                    android:singleLine="true"
                    android:layout_centerHorizontal="true"
                    android:textAlignment="gravity"
                    style="@style/SbTextView.PageTitle"/>
            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>
    </FrameLayout>
    <View
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"/>
    <ViewFlipper
        android:id="@+id/vfFragmentTradingSell"
        android:tag="binding_1"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/sflTradingSellLoading"
            android:paddingTop="@dimen/item_gap_m"
            android:paddingBottom="@dimen/item_gap_l"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include layout="@layout/skeleton_virtual_item_sell"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <RelativeLayout
            android:id="@+id/rlMainTradeSellLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/nsvLayoutView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:layout_above="@+id/llButtonLayout"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true">
                <RelativeLayout
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.stockbit.common.uikit.StockbitCompanyPrice
                        android:id="@+id/llCompanyInfoLayout"
                        android:tag="binding_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <RelativeLayout
                        android:id="@+id/rlTradeSellLayout"
                        android:background="@drawable/bg_surface_default"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_l"
                        android:layout_below="@+id/llCompanyInfoLayout"
                        android:layout_marginStart="@dimen/item_gap_l"
                        android:layout_marginEnd="@dimen/item_gap_l"
                        android:paddingVertical="@dimen/item_gap_l">
                        <LinearLayout
                            android:id="@+id/llMainSellLayout"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginHorizontal="@dimen/spacing_16">
                            <TextView
                                android:layout_gravity="center"
                                android:id="@+id/tvTitleAvailableLot"
                                android:paddingTop="@dimen/item_gap_m"
                                android:paddingBottom="@dimen/item_gap_m"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/sell_title_available_lot"
                                android:layout_weight="1"
                                style="@style/SbTextView.ListSubtitle"/>
                            <TextView
                                android:textStyle="bold"
                                android:gravity="end|center_vertical"
                                android:id="@+id/tvAvailableLot"
                                android:paddingTop="@dimen/item_gap_m"
                                android:paddingBottom="@dimen/item_gap_m"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:text="@string/n_dash"
                                android:layout_weight="0.5"
                                android:textAlignment="gravity"
                                style="@style/SbTextView.BodyDefault.Bold"/>
                        </LinearLayout>
                        <RelativeLayout
                            android:orientation="horizontal"
                            android:id="@+id/rlSeekbar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/llMainSellLayout"
                            android:layout_marginEnd="@dimen/spacing_16">
                            <com.google.android.material.slider.Slider
                                android:id="@+id/google_discrete"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:stepSize="1"
                                android:valueFrom="0"
                                android:layout_marginStart="@dimen/item_gap_s"
                                android:layout_marginEnd="@dimen/item_gap_6"
                                android:layout_toStartOf="@+id/tvPercentage"
                                app:haloColor="@color/green_text"
                                app:haloRadius="@dimen/spacing_16"
                                app:labelBehavior="gone"
                                app:thumbColor="@color/white"
                                app:thumbRadius="@dimen/spacing_12"
                                app:tickVisible="false"
                                app:trackColorActive="@color/green_text"
                                app:trackColorInactive="?attr/themeColorBorder"/>
                            <TextView
                                android:id="@+id/tvPercentage"
                                android:paddingBottom="@dimen/item_gap_s"
                                android:visibility="visible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sell_title_trading_percentage"
                                android:layout_centerVertical="true"
                                android:layout_alignParentEnd="true"
                                style="@style/SbTextView.ListSubtitle"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/rlLotLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/item_gap_l"
                            android:layout_below="@+id/rlSeekbar">
                            <TextView
                                android:id="@+id/tvTitleLot"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sell_title_lot"
                                android:layout_centerVertical="true"
                                style="@style/SbTextView.ListSubtitle"/>
                            <RelativeLayout
                                android:orientation="horizontal"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/height_28"
                                android:layout_centerInParent="true"
                                android:layout_toEndOf="@+id/tvTitleLot">
                                <Button
                                    android:textSize="@dimen/text_size_18"
                                    android:textStyle="normal"
                                    android:id="@+id/btnMinLot"
                                    android:background="@drawable/border_gray_rounded_white_bg"
                                    android:padding="0dp"
                                    android:layout_width="@dimen/width_28"
                                    android:layout_height="@dimen/height_28"
                                    android:text="@string/n_dash"
                                    android:layout_toStartOf="@+id/etTotalLot"
                                    style="@style/SbTextView.ListTitle"/>
                                <EditText
                                    android:gravity="center"
                                    android:id="@+id/etTotalLot"
                                    android:background="@null"
                                    android:focusable="true"
                                    android:layout_width="@dimen/width_113"
                                    android:layout_height="match_parent"
                                    android:minWidth="@dimen/buy_min_width_btn"
                                    android:hint="@string/n_dash"
                                    android:maxLines="1"
                                    android:selectAllOnFocus="true"
                                    android:digits="0123456789"
                                    android:inputType="numberDecimal"
                                    android:imeOptions="actionNext"
                                    android:layout_toStartOf="@+id/btnPlusLot"
                                    style="@style/SbTextView.ListSubtitle"/>
                                <Button
                                    android:textSize="@dimen/text_size_18"
                                    android:textStyle="normal"
                                    android:id="@+id/btnPlusLot"
                                    android:background="@drawable/border_gray_rounded_white_bg"
                                    android:padding="0dp"
                                    android:layout_width="@dimen/width_28"
                                    android:layout_height="@dimen/height_28"
                                    android:text="@string/n_plus"
                                    android:layout_alignParentEnd="true"
                                    style="@style/SbTextView.ListTitle"/>
                            </RelativeLayout>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/rlPriceLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/item_gap_l"
                            android:layout_below="@+id/rlLotLayout"
                            android:layout_marginHorizontal="@dimen/item_gap_l">
                            <TextView
                                android:id="@+id/tvTitlePrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/sell_title_limit_price"
                                android:layout_centerVertical="true"
                                style="@style/SbTextView.ListSubtitle"/>
                            <RelativeLayout
                                android:orientation="horizontal"
                                android:focusable="true"
                                android:focusableInTouchMode="true"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/height_28"
                                android:layout_centerInParent="true"
                                android:layout_toEndOf="@+id/tvTitlePrice">
                                <Button
                                    android:textSize="@dimen/text_size_18"
                                    android:textStyle="normal"
                                    android:id="@+id/btnMinPrice"
                                    android:background="@drawable/border_gray_rounded_white_bg"
                                    android:padding="0dp"
                                    android:layout_width="@dimen/width_28"
                                    android:layout_height="@dimen/height_28"
                                    android:text="@string/n_dash"
                                    android:layout_toStartOf="@+id/etTotalPrice"
                                    style="@style/SbTextView.ListTitle"/>
                                <EditText
                                    android:gravity="center"
                                    android:id="@+id/etTotalPrice"
                                    android:background="@null"
                                    android:focusable="true"
                                    android:layout_width="@dimen/width_113"
                                    android:layout_height="match_parent"
                                    android:minWidth="@dimen/buy_min_width_btn"
                                    android:hint="@string/n_dash"
                                    android:maxLines="1"
                                    android:selectAllOnFocus="true"
                                    android:digits="0123456789"
                                    android:inputType="numberDecimal"
                                    android:imeOptions="actionNext"
                                    android:layout_toStartOf="@+id/btnPlusPrice"
                                    style="@style/SbTextView.ListSubtitle"/>
                                <Button
                                    android:textSize="@dimen/text_size_18"
                                    android:textStyle="normal"
                                    android:id="@+id/btnPlusPrice"
                                    android:background="@drawable/border_gray_rounded_white_bg"
                                    android:padding="0dp"
                                    android:layout_width="@dimen/width_28"
                                    android:layout_height="@dimen/height_28"
                                    android:text="@string/n_plus"
                                    android:layout_alignParentEnd="true"
                                    style="@style/SbTextView.ListTitle"/>
                            </RelativeLayout>
                        </RelativeLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/llProceedAmountLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/rlPriceLayout"
                            android:layout_marginHorizontal="@dimen/spacing_16">
                            <TextView
                                android:id="@+id/tvTitleProceedAmount"
                                android:paddingTop="@dimen/item_gap_m"
                                android:paddingBottom="@dimen/item_gap_m"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ammendBuy_proceed_amount"
                                android:layout_weight="1"
                                style="@style/SbTextView.ListSubtitle"/>
                            <EditText
                                android:enabled="false"
                                android:gravity="end|center_vertical"
                                android:id="@+id/etProceedAmount"
                                android:background="@null"
                                android:focusable="false"
                                android:clickable="false"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="@string/n_dash"
                                android:hint="@string/n_dash"
                                android:layout_weight="1"
                                android:inputType="number"
                                android:textAlignment="gravity"
                                style="@style/SbTextView.ListSubtitle"/>
                        </LinearLayout>
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/llPriceLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/llProceedAmountLayout"
                            android:layout_marginHorizontal="@dimen/spacing_16">
                            <TextView
                                android:id="@+id/t_profitloss"
                                android:paddingTop="@dimen/item_gap_m"
                                android:paddingBottom="@dimen/item_gap_m"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ammendBuy_pl"
                                android:layout_weight="1"
                                style="@style/SbTextView.ListSubtitle"/>
                            <EditText
                                android:enabled="false"
                                android:gravity="end|center_vertical"
                                android:id="@+id/etProfitLoss"
                                android:background="@null"
                                android:focusable="false"
                                android:clickable="false"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="@string/n_dash"
                                android:hint="@string/n_dash"
                                android:layout_weight="1"
                                android:inputType="number"
                                android:textAlignment="gravity"
                                style="@style/SbTextView.ListSubtitle"/>
                        </LinearLayout>
                        <RelativeLayout
                            android:id="@+id/rlExpiryLayout"
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/llPriceLayout"
                            android:layout_marginHorizontal="@dimen/spacing_16">
                            <TextView
                                android:id="@+id/tvTitleExpiry"
                                android:paddingTop="@dimen/item_gap_m"
                                android:paddingBottom="@dimen/item_gap_m"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/buy_title_expiry"
                                style="@style/SbTextView.ListSubtitle"/>
                            <TextView
                                android:gravity="end"
                                android:id="@+id/tvExpiry"
                                android:paddingTop="@dimen/item_gap_m"
                                android:paddingBottom="@dimen/item_gap_m"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/n_dash"
                                android:textAlignment="gravity"
                                android:layout_marginStart="@dimen/item_gap_l"
                                android:layout_toEndOf="@+id/tvTitleExpiry"
                                android:layout_alignParentEnd="true"
                                style="@style/SbTextView.BodyDefault"/>
                        </RelativeLayout>
                    </RelativeLayout>
                    <com.stockbit.common.uikit.StockbitCompanyOrderbook
                        android:id="@+id/llCompanyOrderBookInfoLayout"
                        android:tag="binding_4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/rlTradeSellLayout"/>
                </RelativeLayout>
            </androidx.core.widget.NestedScrollView>
            <LinearLayout
                android:id="@+id/llButtonLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true">
                <Button
                    android:textColor="@color/white"
                    android:id="@+id/btnSwitchToReal"
                    android:background="@color/background_blue_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="@string/maintab_switch_to_real"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/item_gap_xxxs"
                    style="@style/SbBtnBorderless.Default"/>
                <Button
                    android:textColor="@color/white"
                    android:id="@+id/btnOrder"
                    android:background="@color/google_red"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="@string/title_trading_order_sell"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/item_gap_xxxs"
                    style="@style/SbBtnBorderless.Default"/>
            </LinearLayout>
        </RelativeLayout>
        <include
            android:layout_gravity="center"
            android:id="@+id/parentErrorTradingSell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/comp_icon_error_view"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsvFragmentTradingSell"
            android:tag="binding_5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <include layout="@layout/comp_empty_data_virtual_sell"/>
        </androidx.core.widget.NestedScrollView>
    </ViewFlipper>
</androidx.appcompat.widget.LinearLayoutCompat>
