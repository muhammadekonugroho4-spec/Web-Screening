<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_company_corporate_action_0"
    android:background="?attr/themeContentBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <HorizontalScrollView
            android:id="@+id/hsv_company_corporate_action_header"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_s"
            android:layout_marginBottom="@dimen/item_gap_s"
            android:fillViewport="true">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_company_corporate_action_header"
                android:tag="binding_1"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingTop="@dimen/item_gap_m"
                android:paddingRight="@dimen/item_gap_l"
                android:paddingBottom="@dimen/item_gap_m"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/item_gap_s"
                app:singleLine="true"
                app:singleSelection="true">
                <include layout="@layout/comp_company_corporate_action_subsection"/>
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
        <ViewFlipper
            android:id="@+id/vf_company_corporate_action_item"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:measureAllChildren="true"
            android:layout_below="@+id/hsv_company_corporate_action_header">
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/sfl_company_corporate_action"
                android:tag="binding_3"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include layout="@layout/skeleton_company_profile_item"/>
            </com.facebook.shimmer.ShimmerFrameLayout>
            <include
                android:layout_gravity="center"
                android:id="@+id/error_layout_company_corporate_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                layout="@layout/comp_icon_error_view"/>
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/comp_company_corporate_action_empty"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_all"
                android:paddingBottom="@dimen/bottom_navigation_view_height"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_dividen"
                android:paddingBottom="@dimen/bottom_navigation_view_height"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_stock_dividend"
                android:paddingBottom="@dimen/bottom_navigation_view_height"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_stock_split"
                android:paddingBottom="@dimen/bottom_navigation_view_height"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_reverse_split"
                android:paddingBottom="@dimen/bottom_navigation_view_height"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_right_issue"
                android:paddingBottom="@dimen/bottom_navigation_view_height"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_warrant"
                android:tag="binding_4"
                android:paddingBottom="@dimen/bottom_navigation_view_height"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_bonus"
                android:paddingBottom="@dimen/bottom_navigation_view_height"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_tender_offer"
                android:paddingBottom="@dimen/bottom_navigation_view_height"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_rups"
                android:paddingBottom="@dimen/bottom_navigation_view_height"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </ViewFlipper>
        <ViewStub
            android:id="@+id/vs_corp_action_blur"
            android:layout="@layout/comp_blur_corp_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/hsv_company_corporate_action_header"/>
    </RelativeLayout>
</androidx.core.widget.NestedScrollView>
