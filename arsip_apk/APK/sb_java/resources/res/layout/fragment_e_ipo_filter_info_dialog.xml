<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_e_ipo_filter_info_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/rl_header"
        android:background="@drawable/bg_top_rounded"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_20"/>
    <androidx.core.widget.NestedScrollView
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_header">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/rlErrorDialogMainLayout"
            android:background="?attr/themeDialogBackgroundColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingTop="@dimen/item_gap_24"
                android:paddingBottom="@dimen/height_46"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/item_gap_20"
                android:paddingEnd="@dimen/item_gap_20">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/btn_close"
                    android:layout_width="@dimen/item_gap_14"
                    android:layout_height="@dimen/item_gap_14"
                    android:src="0x7f080644"
                    android:tint="?attr/titleTextColorLowgray"
                    android:layout_alignParentEnd="true"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_e_ipo_info_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_e_ipo_info_title"/>
                <TextView
                    android:textSize="@dimen/text_size_18"
                    android:id="@+id/tv_e_ipo_info_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/e_ipo_info_title"
                    android:textAlignment="textStart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/SbTextView.PageTitle"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:id="@+id/tv_e_ipo_info_no_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_26"
                    android:text="1."
                    android:textAlignment="textStart"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_e_ipo_info_title"
                    style="@style/SbTextView.PageTitle"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:id="@+id/tv_e_ipo_info_title_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_26"
                    android:text="@string/e_ipo_info_title_1"
                    android:textAlignment="textStart"
                    android:layout_marginStart="@dimen/item_gap_8"
                    app:layout_constraintStart_toEndOf="@+id/tv_e_ipo_info_no_1"
                    app:layout_constraintTop_toBottomOf="@+id/tv_e_ipo_info_title"
                    style="@style/SbTextView.PageTitle"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:id="@+id/tv_e_ipo_info_content_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_6"
                    android:text="@string/e_ipo_info_content_1"
                    android:textAlignment="textStart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/tv_e_ipo_info_title_1"
                    app:layout_constraintTop_toBottomOf="@+id/tv_e_ipo_info_title_1"
                    style="@style/SbTextView"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:id="@+id/tv_e_ipo_info_no_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_24"
                    android:text="2."
                    android:textAlignment="textStart"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_e_ipo_info_content_1"
                    style="@style/SbTextView.PageTitle"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:id="@+id/tv_e_ipo_info_title_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/e_ipo_info_title_2"
                    android:textAlignment="textStart"
                    android:layout_marginStart="@dimen/item_gap_8"
                    app:layout_constraintStart_toEndOf="@+id/tv_e_ipo_info_no_2"
                    app:layout_constraintTop_toTopOf="@+id/tv_e_ipo_info_no_2"
                    style="@style/SbTextView.PageTitle"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:id="@+id/tv_e_ipo_info_content_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_6"
                    android:text="@string/e_ipo_info_content_2"
                    android:textAlignment="textStart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/tv_e_ipo_info_title_2"
                    app:layout_constraintTop_toBottomOf="@+id/tv_e_ipo_info_title_2"
                    style="@style/SbTextView"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:id="@+id/tv_e_ipo_info_no_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_24"
                    android:text="3."
                    android:textAlignment="textStart"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_e_ipo_info_content_2"
                    style="@style/SbTextView.PageTitle"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:id="@+id/tv_e_ipo_info_title_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/e_ipo_info_title_3"
                    android:textAlignment="textStart"
                    android:layout_marginStart="@dimen/item_gap_8"
                    app:layout_constraintStart_toEndOf="@+id/tv_e_ipo_info_no_3"
                    app:layout_constraintTop_toTopOf="@+id/tv_e_ipo_info_no_3"
                    style="@style/SbTextView.PageTitle"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:id="@+id/tv_e_ipo_info_content_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_6"
                    android:text="@string/e_ipo_info_content_3"
                    android:textAlignment="textStart"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/tv_e_ipo_info_title_3"
                    app:layout_constraintTop_toBottomOf="@+id/tv_e_ipo_info_title_3"
                    style="@style/SbTextView"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
