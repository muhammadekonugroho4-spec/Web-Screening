<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_parent_group_universe"
    android:tag="layout/row_screener_universe_group_0"
    android:background="?attr/selectableItemBackground"
    android:descendantFocusability="beforeDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/clickable_size_48">
    <androidx.appcompat.widget.AppCompatRadioButton
        android:id="@+id/rb_group"
        android:focusable="false"
        android:layout_width="@dimen/clickable_size_32"
        android:layout_height="@dimen/clickable_size_32"
        android:layout_marginLeft="@dimen/item_gap_m"
        android:buttonTint="@color/green_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_universe_group_click_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/rb_group"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_category_name_group"
        android:paddingLeft="@dimen/item_gap_m"
        android:paddingRight="@dimen/item_gap_m"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/tv_category_name_group_desc"
        app:layout_constraintLeft_toRightOf="@+id/rb_group"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SbTextView.ListTitle"/>
    <TextView
        android:gravity="start|center_vertical"
        android:id="@+id/tv_category_name_group_desc"
        android:paddingLeft="@dimen/item_gap_m"
        android:paddingRight="@dimen/item_gap_m"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/rb_group"
        app:layout_constraintTop_toBottomOf="@+id/tv_category_name_group"
        style="@style/SbTextView.CaptionSecondary"/>
    <ImageView
        android:id="@+id/iv_drop_down"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/item_gap_l"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
