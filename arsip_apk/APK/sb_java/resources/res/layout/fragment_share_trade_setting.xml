<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_share_trade_setting_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stockbit.uikit.topbar.TopbarStockbitTitle
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:topBarTitleTitle="@string/text_share_trade_setting_toolbar_title"/>
    <ViewFlipper
        android:id="@+id/vf_auto_share_order_status"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topbar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/topbar">
            <TextView
                android:id="@+id/tv_title_setting_auto_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:text="@string/text_share_trade_setting_auto_share_title"
                android:layout_marginHorizontal="@dimen/spacing_20"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:id="@+id/tv_subtitle_setting_auto_share"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2"
                android:text="@string/text_share_trade_setting_auto_share_off_subtitle"
                android:layout_marginEnd="@dimen/spacing_12"
                app:layout_constraintEnd_toStartOf="@+id/toggle_auto_share"
                app:layout_constraintStart_toStartOf="@+id/tv_title_setting_auto_share"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_setting_auto_share"
                style="@style/TypeStyles.BodyXSmall"/>
            <com.stockbit.uikit.control.ControlToggleSwitch
                android:id="@+id/toggle_auto_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_20"
                app:layout_constraintBottom_toBottomOf="@+id/tv_subtitle_setting_auto_share"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_title_setting_auto_share"
                app:switchType="Small"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_target_list"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_subtitle_setting_auto_share">
                <View
                    android:id="@+id/v_divider"
                    android:background="?attr/themeColorDividerThick"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/spacing_8"
                    android:layout_marginTop="@dimen/spacing_12"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ViewFlipper
                    android:id="@+id/vf_target_list_initial"
                    android:tag="binding_2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/v_divider">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:tag="binding_3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:textColor="?attr/themeColorTextSecondary"
                            android:id="@+id/tv_title_auto_share"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_12"
                            android:text="@string/text_share_trade_setting_auto_share_section"
                            android:layout_marginHorizontal="@dimen/spacing_20"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/TypeStyles.HeadingRegular"/>
                        <include
                            android:id="@+id/search_share_trade_setting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_16"
                            android:layout_marginHorizontal="@dimen/spacing_20"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_title_auto_share"
                            layout="@layout/comp_search_share_trade_setting"/>
                        <ViewFlipper
                            android:id="@+id/vf_target_list_searching"
                            android:tag="binding_4"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginVertical="@dimen/item_gap_20"
                            app:layout_constraintBottom_toTopOf="@+id/btn_save_setting"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/search_share_trade_setting">
                            <androidx.recyclerview.widget.RecyclerView
                                android:orientation="vertical"
                                android:id="@+id/rv_auto_share"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:tag="binding_5"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <include
                                    android:id="@+id/error_target_list_searching"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    layout="@layout/comp_error_state_target_list_searching"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:tag="binding_6"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <include
                                    android:id="@+id/empty_target_list_searching"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    layout="@layout/comp_empty_state_target_list_searching"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </ViewFlipper>
                        <com.stockbit.uikit.button.PrimaryButton
                            android:enabled="false"
                            android:id="@+id/btn_save_setting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/spacing_20"
                            android:text="@string/text_share_trade_setting_button_save"
                            android:layout_marginHorizontal="@dimen/spacing_20"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:tag="binding_7"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <include
                            android:id="@+id/loading_target_list_initial"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            layout="@layout/comp_loading_state_share_trade_target_list"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:tag="binding_8"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <include
                            android:id="@+id/error_target_list_initial"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            layout="@layout/comp_error_state_target_list_initial"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:tag="binding_9"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <include
                            android:id="@+id/empty_target_list_initial"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            layout="@layout/comp_empty_state_target_list_initial"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </ViewFlipper>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.stockbit.uikit.control.ControlProgressLoading
                android:id="@+id/pb_loading_auto_share_status"
                android:layout_width="@dimen/width_48"
                android:layout_height="@dimen/height_48"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:progressLoadingSize="large"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="binding_10"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include
                android:id="@+id/error_share_trade_setting"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/comp_error_state_share_trade_setting"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ViewFlipper>
</androidx.constraintlayout.widget.ConstraintLayout>
