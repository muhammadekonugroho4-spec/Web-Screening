<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_register_trading_withdrawal_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_parent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_next"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="0dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_intro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/aciv_icon"
                    android:layout_width="@dimen/item_gap_58"
                    android:layout_height="@dimen/item_gap_58"
                    android:layout_marginTop="@dimen/item_gap_20"
                    android:layout_marginStart="@dimen/item_gap_20"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/actv_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/clickable_size_16"
                    android:layout_marginEnd="@dimen/clickable_size_16"
                    app:layout_constraintBottom_toTopOf="@+id/actv_desc"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/aciv_icon"
                    app:layout_constraintTop_toTopOf="@+id/aciv_icon"
                    app:layout_constraintVertical_chainStyle="packed"
                    style="@style/TypeStyles.HeadingLarge"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:id="@+id/actv_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="@dimen/clickable_size_16"
                    android:layout_marginEnd="@dimen/clickable_size_16"
                    app:layout_constraintBottom_toBottomOf="@+id/aciv_icon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/aciv_icon"
                    app:layout_constraintTop_toBottomOf="@+id/actv_title"
                    style="@style/TypeStyles.BodyXSmall"/>
                <TextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:gravity="center_vertical"
                    android:id="@+id/txt_choose_bank_account_desc"
                    android:background="@drawable/bg_rounded_withdrawal_tooltip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_32"
                    android:drawablePadding="@dimen/item_gap_10"
                    android:layout_marginHorizontal="@dimen/spacing_20"
                    android:paddingHorizontal="@dimen/item_gap_12"
                    android:paddingVertical="@dimen/item_gap_8"
                    app:drawableStartCompat="@drawable/ic_logo_bibit"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/actv_desc"
                    style="@style/TypeStyles.BodyXSmall"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_option_bank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_20"
                app:layout_constraintTop_toBottomOf="@+id/cl_intro"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <com.stockbit.uikit.button.PrimaryButton
        android:layout_gravity="bottom"
        android:id="@+id/btn_next"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        android:layout_marginBottom="@dimen/item_gap_16"
        android:text="@string/button_next"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintBottom_toTopOf="@+id/btn_other_account"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.stockbit.uikit.button.FloatingButton
        android:id="@+id/btn_other_account"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_35"
        android:layout_marginBottom="@dimen/item_gap_20"
        android:text="@string/button_other_account"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
