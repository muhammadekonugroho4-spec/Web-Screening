<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_jago_sharia_benefit_0"
    android:paddingBottom="@dimen/spacing_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_20">
    <TextView
        android:id="@+id/tv_title_sharia_benefit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:text="@string/title_opening_account_jago_sharia"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadlineRegular"/>
    <TextView
        android:id="@+id/tv_desc_sharia_benefit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_6"
        android:text="@string/desc_opening_account_jago_sharia"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_sharia_benefit"
        style="@style/TypeStyles.BodySmall"/>
    <TextView
        android:id="@+id/tv_title_sharia_stock_transaction"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_24"
        android:text="@string/title_jago_sharia_stock_transaction"
        android:layout_marginStart="@dimen/spacing_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_sharia_stock_transaction"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc_sharia_benefit"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:id="@+id/tv_desc_sharia_stock_transaction"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_6"
        android:text="@string/desc_jago_sharia_stock_transaction"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_title_sharia_stock_transaction"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_sharia_stock_transaction"
        style="@style/TypeStyles.BodySmall"/>
    <ImageView
        android:id="@+id/iv_sharia_stock_transaction"
        android:layout_width="@dimen/spacing_32"
        android:layout_height="@dimen/spacing_32"
        android:src="?attr/themeIconJagoShariaStockTransaction"
        app:layout_constraintBottom_toBottomOf="@+id/tv_desc_sharia_stock_transaction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title_sharia_stock_transaction"/>
    <TextView
        android:id="@+id/tv_title_sharia_trading_adjustment"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:text="@string/title_jago_sharia_trading_adjustment"
        android:layout_marginStart="@dimen/spacing_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_sharia_trading_adjustment"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc_sharia_stock_transaction"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:id="@+id/tv_desc_sharia_trading_adjustment"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_6"
        android:text="@string/desc_jago_sharia_trading_adjustment"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_title_sharia_trading_adjustment"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_sharia_trading_adjustment"
        style="@style/TypeStyles.BodySmall"/>
    <ImageView
        android:id="@+id/iv_sharia_trading_adjustment"
        android:layout_width="@dimen/spacing_32"
        android:layout_height="@dimen/spacing_32"
        android:src="?attr/themeIconJagoShariaTradingAdjustment"
        app:layout_constraintBottom_toBottomOf="@+id/tv_desc_sharia_trading_adjustment"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title_sharia_trading_adjustment"/>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/btn_benefit_next"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_36"
        android:text="@string/lbl_btn_continue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc_sharia_trading_adjustment"/>
    <TextView
        android:textColor="?attr/themeColorTextGreen"
        android:gravity="center"
        android:id="@+id/btn_select_conventional_rdn"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:text="@string/button_select_conventional_rdn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_benefit_next"
        style="@style/TypeStyles.HeadingRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
