<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_orderbook_bandar_detector_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.stockbit.uikit.divider.SBDivider
        android:id="@+id/v_border"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_8"
        app:dividerVariant="thick_grey"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rl_bandar_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_border">
        <TextView
            android:textColor="?attr/themeColorTextPrimary"
            android:id="@+id/tv_title_broker_summary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_l"
            android:text="@string/title_orderbook_broker_summary"
            android:layout_marginHorizontal="@dimen/item_gap_20"
            app:layout_constraintEnd_toStartOf="@+id/ib_more_menu_broker_summary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingLarge"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:layout_gravity="start|center_vertical"
            android:id="@+id/ib_more_menu_broker_summary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:contentDescription="@string/button_menu_more"
            android:layout_marginHorizontal="@dimen/item_gap_20"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title_broker_summary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title_broker_summary"
            app:srcCompat="@drawable/ic_more_horizontal"
            app:tint="?attr/themeIconTintColor"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_market_investor_type"
            android:background="@drawable/bg_transparent_with_artboard_border_and_radius_6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginHorizontal="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_broker_summary">
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:id="@+id/tv_investor_type"
                android:tag="binding_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:paddingStart="@dimen/spacing_12"
                android:layout_marginEnd="@dimen/spacing_16"
                android:paddingVertical="@dimen/item_gap_10"
                app:drawableEndCompat="@drawable/uikit_ic_stockbit_text_field_chevron_down"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/v_divider_investor_and_market_type"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.BodyRegular"/>
            <View
                android:id="@+id/v_divider_investor_and_market_type"
                android:background="?attr/themeColorBorder"
                android:layout_width="@dimen/item_gap_1"
                android:layout_height="0dp"
                android:layout_marginVertical="@dimen/spacing_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:id="@+id/tv_market_type"
                android:tag="binding_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:paddingEnd="@dimen/spacing_12"
                android:layout_marginStart="@dimen/spacing_16"
                android:paddingVertical="@dimen/item_gap_10"
                app:drawableEndCompat="@drawable/uikit_ic_stockbit_text_field_chevron_down"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/v_divider_investor_and_market_type"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.BodyRegular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_calendar_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:layout_marginHorizontal="@dimen/item_gap_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_market_investor_type">
            <ImageView
                android:id="@+id/iv_prev_date"
                android:tag="binding_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_chevron_arrow_left"
                android:contentDescription="@null"
                android:paddingEnd="@dimen/item_gap_10"
                app:tint="@color/green_text"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:tag="binding_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="@color/green_text"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_calendar"
                    android:tag="binding_5"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/clickable_size_24"
                    style="@style/TypeStyles.BodySmall"/>
                <ImageView
                    android:id="@+id/iv_calendar"
                    android:padding="@dimen/item_gap_xxs"
                    android:layout_width="@dimen/clickable_size_16"
                    android:layout_height="@dimen/clickable_size_16"
                    android:layout_marginLeft="@dimen/item_gap_s"
                    android:src="@drawable/ic_calendar_bandar"
                    android:scaleType="fitCenter"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_calendar"
                    app:layout_constraintStart_toEndOf="@+id/tv_calendar"
                    app:layout_constraintTop_toTopOf="@+id/tv_calendar"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/iv_next_date"
                android:tag="binding_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_chevron_arrow_right"
                android:contentDescription="@null"
                android:paddingStart="@dimen/item_gap_10"/>
        </LinearLayout>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:id="@+id/tv_net"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_orderbook_net"
            android:layout_marginEnd="@dimen/item_gap_4"
            app:layout_constraintBottom_toBottomOf="@+id/ll_calendar_layout"
            app:layout_constraintEnd_toStartOf="@+id/iv_info_net"
            app:layout_constraintTop_toTopOf="@+id/ll_calendar_layout"
            style="@style/TypeStyles.BodySmall"/>
        <ImageView
            android:id="@+id/iv_info_net"
            android:layout_width="@dimen/width_12"
            android:layout_height="@dimen/height_12"
            android:contentDescription="@null"
            android:layout_marginEnd="@dimen/item_gap_6"
            app:layout_constraintBottom_toBottomOf="@+id/tv_net"
            app:layout_constraintEnd_toStartOf="@+id/switch_net"
            app:layout_constraintTop_toTopOf="@+id/tv_net"
            app:srcCompat="@drawable/uikit_ic_stockbit_row_info_grey"/>
        <com.stockbit.uikit.control.ControlToggleSwitch
            android:id="@+id/switch_net"
            android:tag="binding_7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/item_gap_16"
            app:layout_constraintBottom_toBottomOf="@+id/ll_calendar_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/ll_calendar_layout"
            app:switchType="Small"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_bandar_detector_layout"
            android:tag="binding_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/ll_calendar_layout">
            <RelativeLayout
                android:id="@+id/parent_broker_action_orderbook"
                android:tag="binding_9"
                android:background="?attr/selectableItemBackground"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/item_gap_20">
                <Button
                    android:textColor="?attr/themeColorTextTetriary"
                    android:id="@+id/btn_broker_action"
                    android:background="@null"
                    android:paddingRight="@dimen/item_gap_xxxs"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_orderbook_broker_summary_action"
                    android:textAllCaps="false"
                    style="@style/TypeStyles.BodyRegular"/>
                <ImageView
                    android:padding="@dimen/item_gap_s"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toRightOf="@+id/btn_broker_action"
                    android:layout_centerInParent="true"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/uikit_ic_stockbit_row_info_grey"/>
            </RelativeLayout>
            <include
                android:id="@+id/bandar_detector"
                layout="@layout/row_orderbook_bandar_detector_head"/>
            <FrameLayout
                android:id="@+id/hsv_broker_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/cv_broker_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_16"/>
            </FrameLayout>
            <RelativeLayout
                android:id="@+id/rl_broker_code_layout"
                android:tag="binding_10"
                android:background="@drawable/bg_transparent_with_artboard_border_and_radius_6"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_16"
                android:layout_marginVertical="@dimen/spacing_20"
                android:paddingHorizontal="@dimen/spacing_16"
                android:paddingVertical="11dp">
                <TextView
                    android:id="@+id/tv_fragment_orderbook_openBroker_code_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/title_orderbook_broker_code"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/spacing_12"
                    android:layout_toStartOf="@+id/iv_fragment_orderbook_open_broker"
                    android:layout_alignParentStart="true"
                    style="@style/TypeStyles.HeadingXSmall"/>
                <ImageView
                    android:id="@+id/iv_fragment_orderbook_open_broker"
                    android:paddingTop="@dimen/item_gap_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/item_gap_s"
                    android:layout_alignParentRight="true"
                    android:layout_centerVertical="true"
                    app:srcCompat="@drawable/ic_chevron_right_grey"/>
            </RelativeLayout>
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_expand_collapse"
                android:tag="binding_11"
                android:paddingTop="@dimen/item_gap_12"
                android:paddingBottom="@dimen/item_gap_11"
                android:layout_width="@dimen/width_60"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_20"
                app:srcCompat="@drawable/ic_chevron_down_secondary"
                app:tint="?attr/themeColorTextGreen"/>
            <ImageView
                android:id="@+id/iv_broker_summary_blur"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_20"
                android:src="?attr/themeBackgroundBlurryBrokerSummary"
                android:scaleType="fitXY"
                android:adjustViewBounds="true"
                android:contentDescription="@null"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
