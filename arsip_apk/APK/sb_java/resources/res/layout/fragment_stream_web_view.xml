<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_stream_web_view_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="@dimen/item_gap_null"
        style="@style/Sb.Widget.AppBar">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:contentInsetEnd="0dp"
            app:contentInsetLeft="0dp"
            app:contentInsetRight="0dp"
            app:contentInsetStart="0dp">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_icon"
                android:padding="@dimen/item_gap_xxs"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/clickable_size_32"
                android:scaleType="centerInside"
                android:contentDescription="@string/app_name"
                app:srcCompat="?attr/themeStockbitLogoWithText"/>
            <TextView
                android:layout_gravity="center"
                android:id="@+id/tv_title"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stream_snip"
                style="@style/TypeStyles.HeadingLarge"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/iv_share"
                android:visibility="gone"
                android:layout_width="@dimen/width_24"
                android:layout_height="@dimen/height_24"
                android:layout_marginEnd="@dimen/spacing_16"
                app:srcCompat="@drawable/ic_snips_share"/>
        </androidx.appcompat.widget.Toolbar>
        <View
            android:background="?attr/themeColorBorder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"/>
    </com.google.android.material.appbar.AppBarLayout>
    <ViewFlipper
        android:id="@+id/vf_chartbit"
        android:tag="binding_1"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/pb_chartbit"
            android:layout_width="@dimen/clickable_size_32"
            android:layout_height="@dimen/clickable_size_32"
            android:indeterminate="true"
            android:indeterminateTint="@color/green_text"
            style="@style/Widget.AppCompat.ProgressBar"/>
        <com.stockbit.stream.component.snips.StreamWebView
            android:id="@+id/wv_stream"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <include
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/comp_icon_error_view"/>
    </ViewFlipper>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
