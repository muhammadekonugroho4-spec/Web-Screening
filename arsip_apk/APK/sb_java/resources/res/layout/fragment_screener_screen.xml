<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_screener_screen_0"
    android:focusableInTouchMode="true"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/genericToolbar"
        android:paddingLeft="@dimen/item_gap_null"
        android:paddingRight="@dimen/item_gap_null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        app:contentInsetLeft="@dimen/item_gap_null"
        app:contentInsetStart="@dimen/item_gap_null"
        app:contentInsetStartWithNavigation="@dimen/item_gap_null"
        app:elevation="@dimen/item_gap_null"
        style="@style/Sb.Widget.AppBar">
        <TextView
            android:layout_gravity="center"
            android:id="@+id/tv_title_add_to_watchlist"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screener_screen_add_to_watchlist"
            style="@style/TypeStyles.HeadingLarge"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/rl_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize">
            <TextView
                android:ellipsize="end"
                android:id="@+id/tv_title"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:textAlignment="center"
                style="@style/TypeStyles.HeadingSmall"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/tv_subtitle"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:layout_below="@+id/tv_title"
                android:textAlignment="center"
                style="@style/TypeStyles.BodyXSmall"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.Toolbar>
    <com.stockbit.uikit.divider.SBDivider
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_1"
        android:layout_alignTop="@+id/screener_screen_bottom_bar"
        app:dividerVariant="thin_grey"/>
    <include
        android:id="@+id/screener_screen_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        layout="@layout/comp_screener_screen_bottombar"/>
    <ViewFlipper
        android:id="@+id/vf_screen_fragment"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:measureAllChildren="true"
        android:layout_above="@+id/screener_screen_bottom_bar"
        android:layout_below="@+id/genericToolbar">
        <LinearLayout
            android:orientation="vertical"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.evrencoskun.tableview.TableView
                android:id="@+id/table_view_data"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:allow_click_inside_column_header="true"
                app:allow_click_inside_row_header="true"
                app:row_header_width="@dimen/screener_width_row_header"
                app:separator_color="?attr/themeColorDividerThin"/>
            <include
                android:id="@+id/layout_screener_loading_item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.05"
                layout="@layout/comp_loading_item_screener_view"/>
        </LinearLayout>
        <RelativeLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:id="@+id/pb_screener"
                android:layout_width="@dimen/clickable_size_32"
                android:layout_height="@dimen/clickable_size_32"
                android:layout_centerHorizontal="true"
                android:indeterminateTint="@color/green_text"
                style="@style/Widget.AppCompat.ProgressBar"/>
            <TextView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_m"
                android:text="@string/lbl_loading_chat_list"
                android:layout_below="@+id/pb_screener"
                android:layout_centerHorizontal="true"
                style="@style/SbTextView.CaptionSecondary"/>
        </RelativeLayout>
        <include
            android:id="@+id/layout_screener_reload"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/comp_icon_error_view"/>
        <include
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/layout_screener_preset_empty_state"/>
    </ViewFlipper>
</RelativeLayout>
