<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_company_search_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stockbit.uikit.topbar.TopbarStockbitTitle
        android:id="@+id/tb_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:topBarTitleTitle="@string/title_search_company_for_new_price_alert"
        app:topBarType="CenterTitle"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/cl_search"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_12">
        <ImageView
            android:id="@+id/iv_search_icon"
            android:layout_width="@dimen/icon_placeholder_24"
            android:layout_height="@dimen/icon_placeholder_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_search_2"
            app:tint="?attr/themeIconTintColor"/>
        <EditText
            android:textColorHint="?attr/themeColorTextTetriary"
            android:gravity="center_vertical"
            android:id="@+id/et_search"
            android:background="@color/transparent"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:hint="@string/placeholder_search"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionSearch"
            android:layout_marginHorizontal="@dimen/spacing_8"
            android:paddingHorizontal="@dimen/spacing_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ib_clear_search"
            app:layout_constraintStart_toEndOf="@+id/iv_search_icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.BodyRegular"/>
        <ImageButton
            android:id="@+id/ib_clear_search"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:layout_width="@dimen/icon_placeholder_24"
            android:layout_height="@dimen/icon_placeholder_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_clear_edit_text"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.stockbit.uikit.divider.SBDivider
        android:id="@+id/v_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dividerVariant="thin_grey"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_company"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingVertical="@dimen/spacing_12"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
</LinearLayout>
