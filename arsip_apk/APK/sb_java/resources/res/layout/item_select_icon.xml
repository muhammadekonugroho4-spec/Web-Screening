<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_select_rdn"
    android:tag="layout/item_select_icon_0"
    android:background="@drawable/bg_rounded_outer_inactive_rdn"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/item_gap_16">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/item_gap_16">
        <ImageView
            android:id="@+id/iv_recommend_rdn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_10"
            android:layout_marginEnd="@dimen/item_gap_8"/>
        <TextView
            android:id="@+id/tv_recommend_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_10"
            android:text="@string/lbl_recommend_rdn_bca"
            style="@style/TypeStyles.BodySmall"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_container"
        android:background="@drawable/bg_rounded_inner_rdn"
        android:paddingBottom="@dimen/item_gap_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_10"
        android:layout_marginBottom="@dimen/item_gap_1"
        android:layout_marginHorizontal="@dimen/item_gap_1">
        <ImageView
            android:id="@+id/aciv_content"
            android:layout_width="@dimen/width_24"
            android:layout_height="@dimen/height_24"
            android:layout_marginTop="@dimen/item_gap_16"
            android:layout_marginStart="@dimen/clickable_size_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tv_deposit_bank"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/lbl_rdn_title"
            android:layout_marginHorizontal="@dimen/item_gap_8"
            app:layout_constraintBottom_toBottomOf="@+id/aciv_content"
            app:layout_constraintEnd_toStartOf="@+id/crb_select_rdn"
            app:layout_constraintStart_toEndOf="@+id/aciv_content"
            app:layout_constraintTop_toTopOf="@+id/aciv_content"
            style="@style/TypeStyles.HeadingLarge"/>
        <com.stockbit.uikit.control.ControlRadioButton
            android:id="@+id/crb_select_rdn"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/height_24"
            android:layout_marginTop="@dimen/item_gap_16"
            android:layout_marginEnd="@dimen/item_gap_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:radioType="tick"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_tooltip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="SBDivider,ll_tooltip"/>
        <com.stockbit.uikit.divider.SBDivider
            android:id="@+id/SBDivider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_1"
            android:layout_marginTop="@dimen/item_gap_16"
            app:dividerVariant="thin_grey"
            app:layout_constraintTop_toBottomOf="@+id/aciv_content"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_tooltip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/item_gap_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/SBDivider"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
