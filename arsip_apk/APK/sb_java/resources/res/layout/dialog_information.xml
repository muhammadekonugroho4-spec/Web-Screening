<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_information_0"
    android:background="@drawable/bg_top_rounded_20_theme_nav_background"
    android:paddingTop="@dimen/item_gap_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/item_gap_20">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/appCompatTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/tool_tip_payment_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SbTextView.PageTitle.HighEmphasis.Bold"/>
    <ImageButton
        android:id="@+id/imageButton"
        android:background="@null"
        android:layout_width="@dimen/item_gap_12"
        android:layout_height="@dimen/item_gap_12"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/appCompatTextView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/appCompatTextView"
        app:srcCompat="0x7f080644"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_21"
        android:layout_marginBottom="@dimen/item_gap_41"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/imageButton"
        app:layout_constraintStart_toStartOf="@+id/appCompatTextView"
        app:layout_constraintTop_toBottomOf="@+id/appCompatTextView"
        style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
