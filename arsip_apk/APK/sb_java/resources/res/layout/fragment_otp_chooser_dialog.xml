<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_otp_chooser_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="?attr/themeColorTextPrimary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/height_56"
            android:text="@string/title_otp_chooser"
            android:textAlignment="gravity"
            android:layout_marginStart="@dimen/item_gap_32"
            android:layout_marginEnd="@dimen/item_gap_32"
            style="@style/TypeStyles.HeadingLarge"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textStyle="normal"
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="start"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:textAlignment="gravity"
            android:layout_marginStart="@dimen/spacing_20"
            android:layout_marginEnd="@dimen/spacing_20"
            style="@style/TypeStyles.ParagraphRegular"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_send_by_wa"
            android:background="@drawable/background_otp_chooser_item_selected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:layout_marginStart="@dimen/spacing_20"
            android:layout_marginEnd="@dimen/spacing_20">
            <ImageView
                android:id="@+id/iv_logo_wa"
                android:layout_width="@dimen/height_20"
                android:layout_height="@dimen/height_20"
                android:src="@drawable/ic_otp_wa"
                android:layout_marginStart="@dimen/item_gap_16"
                app:layout_constraintBottom_toBottomOf="@+id/tv_item_subtitle_wa"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_item_title_wa"/>
            <com.stockbit.uikit.control.ControlCheckbox
                android:id="@+id/ccb_state_wa"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:focusable="true"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:drawablePadding="0dp"
                android:layout_marginEnd="@dimen/item_gap_16"
                app:checkBoxType="round"
                app:layout_constraintBottom_toBottomOf="@+id/tv_item_subtitle_wa"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_item_title_wa"/>
            <TextView
                android:id="@+id/tv_item_title_wa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_16"
                android:text="@string/text_send_otp_whatsapp"
                android:layout_marginStart="@dimen/spacing_12"
                app:layout_constraintStart_toEndOf="@+id/iv_logo_wa"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.HeadingRegular"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:id="@+id/tv_item_subtitle_wa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2"
                android:layout_marginBottom="@dimen/item_gap_16"
                android:text="@string/text_send_otp_whatsapp_desc"
                android:layout_marginStart="@dimen/spacing_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_logo_wa"
                app:layout_constraintTop_toBottomOf="@+id/tv_item_title_wa"
                style="@style/TypeStyles.BodyXSmall"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_send_by_sms"
            android:background="@drawable/background_otp_chooser_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginBottom="@dimen/spacing_32"
            android:layout_marginStart="@dimen/spacing_20"
            android:layout_marginEnd="@dimen/spacing_20">
            <ImageView
                android:id="@+id/iv_logo_sms"
                android:layout_width="@dimen/height_20"
                android:layout_height="@dimen/height_20"
                android:src="@drawable/ic_otp_sms"
                android:layout_marginStart="@dimen/item_gap_16"
                app:layout_constraintBottom_toBottomOf="@+id/tv_item_subtitle_sms"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_item_title_sms"/>
            <com.stockbit.uikit.control.ControlCheckbox
                android:id="@+id/ccb_state_sms"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:focusable="true"
                android:clickable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:drawablePadding="0dp"
                android:layout_marginEnd="@dimen/item_gap_16"
                app:checkBoxType="round"
                app:layout_constraintBottom_toBottomOf="@+id/tv_item_subtitle_sms"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_item_title_sms"/>
            <TextView
                android:id="@+id/tv_item_title_sms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_16"
                android:text="@string/text_send_otp_sms"
                android:layout_marginStart="@dimen/spacing_12"
                app:layout_constraintStart_toEndOf="@+id/iv_logo_sms"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.HeadingRegular"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:id="@+id/tv_item_subtitle_sms"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_2"
                android:layout_marginBottom="@dimen/item_gap_16"
                android:text="@string/text_send_otp_sms_desc"
                android:layout_marginStart="@dimen/spacing_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_logo_sms"
                app:layout_constraintTop_toBottomOf="@+id/tv_item_title_sms"
                style="@style/TypeStyles.BodyXSmall"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.stockbit.uikit.button.PrimaryButton
            android:textColor="@color/white"
            android:id="@+id/btn_send_otp_request"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_16"
            android:layout_marginBottom="@dimen/spacing_20"
            android:text="@string/button_send"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/spacing_20"
            android:layout_marginEnd="@dimen/spacing_20"
            style="@style/TypeStyles.HeadingRegular"/>
    </LinearLayout>
</RelativeLayout>
