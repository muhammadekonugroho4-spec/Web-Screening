<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_mutual_fund_summary"
    android:tag="layout/comp_mutual_fund_summary_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/btn_buy"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_32"
        android:layout_marginLeft="@dimen/item_gap_l"
        android:layout_marginRight="@dimen/item_gap_l"
        android:layout_marginBottom="@dimen/item_gap_l"
        android:text="@string/btn_mutual_fund_buy"
        app:primaryButtonColor="green"
        app:primaryButtonSize="mediumSize"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_border_gray_rounded_outline"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_l"
        android:layout_below="@+id/btn_buy"
        android:layout_marginHorizontal="@dimen/item_gap_l">
        <TextView
            android:id="@+id/tv_keystats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Key Stats"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingLarge"/>
        <TextView
            android:textColor="?attr/themeColorTextPrimary"
            android:id="@+id/tv_cagr_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/lbl_cagr_1_yr"
            app:layout_constraintEnd_toStartOf="@+id/tv_drawdown_label"
            app:layout_constraintStart_toStartOf="@+id/tv_keystats"
            app:layout_constraintTop_toBottomOf="@+id/tv_keystats"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:textStyle="bold"
            android:id="@+id/tv_cagr_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_xs"
            android:text="@string/lbl_loading_indicator_dash"
            app:layout_constraintEnd_toEndOf="@+id/tv_cagr_label"
            app:layout_constraintStart_toStartOf="@+id/tv_cagr_label"
            app:layout_constraintTop_toBottomOf="@+id/tv_cagr_label"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:id="@+id/tv_drawdown_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/lbl_drawdown_1_yr"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_cagr_label"
            app:layout_constraintTop_toTopOf="@+id/tv_cagr_label"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:textStyle="bold"
            android:id="@+id/tv_drawdown_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_xs"
            android:text="@string/lbl_loading_indicator_dash"
            app:layout_constraintEnd_toEndOf="@+id/tv_drawdown_label"
            app:layout_constraintStart_toStartOf="@+id/tv_drawdown_label"
            app:layout_constraintTop_toBottomOf="@+id/tv_drawdown_label"
            style="@style/TypeStyles.HeadingSmall"/>
        <TextView
            android:id="@+id/tv_expense_ratio_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/lbl_expense_ratio"
            app:layout_constraintEnd_toStartOf="@+id/tv_avg_yield_label"
            app:layout_constraintStart_toStartOf="@+id/tv_cagr_label"
            app:layout_constraintTop_toBottomOf="@+id/tv_cagr_value"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:textStyle="bold"
            android:id="@+id/tv_expense_ratio_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_xs"
            android:text="@string/lbl_loading_indicator_dash"
            app:layout_constraintEnd_toEndOf="@+id/tv_expense_ratio_label"
            app:layout_constraintStart_toStartOf="@+id/tv_expense_ratio_label"
            app:layout_constraintTop_toBottomOf="@+id/tv_expense_ratio_label"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:id="@+id/tv_avg_yield_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/lbl_avg_yield"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_cagr_label"
            app:layout_constraintTop_toTopOf="@+id/tv_expense_ratio_label"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:textStyle="bold"
            android:id="@+id/tv_avg_yield_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_xs"
            android:text="@string/lbl_loading_indicator_dash"
            app:layout_constraintEnd_toEndOf="@+id/tv_drawdown_label"
            app:layout_constraintStart_toStartOf="@+id/tv_drawdown_label"
            app:layout_constraintTop_toBottomOf="@+id/tv_avg_yield_label"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:id="@+id/tv_total_aumn_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/lbl_total_aum"
            app:layout_constraintEnd_toEndOf="@+id/tv_cagr_label"
            app:layout_constraintStart_toStartOf="@+id/tv_expense_ratio_value"
            app:layout_constraintTop_toBottomOf="@+id/tv_expense_ratio_value"
            app:layout_goneMarginTop="20dp"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:textStyle="bold"
            android:id="@+id/tv_total_aum_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_xs"
            android:text="@string/lbl_loading_indicator_dash"
            app:layout_constraintEnd_toEndOf="@+id/tv_total_aumn_label"
            app:layout_constraintStart_toStartOf="@+id/tv_total_aumn_label"
            app:layout_constraintTop_toBottomOf="@+id/tv_total_aumn_label"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:id="@+id/tv_risk_level_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/lbl_risk_level"
            android:singleLine="true"
            app:layout_constraintEnd_toEndOf="@+id/tv_drawdown_label"
            app:layout_constraintStart_toStartOf="@+id/tv_drawdown_label"
            app:layout_constraintTop_toTopOf="@+id/tv_total_aumn_label"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:textStyle="bold"
            android:id="@+id/tv_risk_level_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_xs"
            android:text="@string/lbl_loading_indicator_dash"
            app:layout_constraintEnd_toEndOf="@+id/tv_risk_level_label"
            app:layout_constraintStart_toStartOf="@+id/tv_risk_level_label"
            app:layout_constraintTop_toBottomOf="@+id/tv_risk_level_label"
            style="@style/TypeStyles.HeadingRegular"/>
        <View
            android:id="@+id/v_divider_1"
            android:background="?attr/themeColorBorder"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_total_aum_value"/>
        <TextView
            android:id="@+id/tv_informasi_investasi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Informasi Investasi"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_divider_1"
            style="@style/TypeStyles.HeadingLarge"/>
        <TextView
            android:id="@+id/tv_minimum_pembelian"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Minimum Pembelian"
            app:layout_constraintEnd_toStartOf="@+id/tv_minimum_pembelian_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_informasi_investasi"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_minimum_pembelian_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_minimum_pembelian"
            app:layout_constraintTop_toTopOf="@+id/tv_minimum_pembelian"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:id="@+id/tv_bank_kustodian"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Bank Kustodian"
            app:layout_constraintBottom_toBottomOf="@+id/tv_bank_custodian_value"
            app:layout_constraintEnd_toStartOf="@+id/tv_bank_custodian_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_bank_custodian_value"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_bank_custodian_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_minimum_pembelian_value"
            app:layout_constraintTop_toBottomOf="@+id/tv_minimum_pembelian"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:id="@+id/tv_bank_penampung"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Bank Penampung"
            app:layout_constraintEnd_toStartOf="@+id/tv_bank_penampung_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_bank_custodian_value"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_bank_penampung_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_bank_penampung"
            app:layout_constraintTop_toTopOf="@+id/tv_bank_penampung"
            style="@style/TypeStyles.BodySmall"/>
        <View
            android:id="@+id/v_divider_2"
            android:background="?attr/themeColorBorder"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_bank_penampung"/>
        <TextView
            android:id="@+id/tv_biaya_investasi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Biaya Investasi"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_divider_2"
            style="@style/TypeStyles.HeadingLarge"/>
        <TextView
            android:id="@+id/tv_komisi_pembelian"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Komisi Pembelian"
            app:layout_constraintEnd_toStartOf="@+id/tv_minimum_pembelian_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_biaya_investasi"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_komisi_pembelian_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_komisi_pembelian"
            app:layout_constraintTop_toTopOf="@+id/tv_komisi_pembelian"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:id="@+id/tv_komisi_penjualan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Komisi Penjualan"
            app:layout_constraintEnd_toStartOf="@+id/tv_minimum_pembelian_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_komisi_pembelian"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_komisi_penjualan_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_komisi_penjualan"
            app:layout_constraintTop_toTopOf="@+id/tv_komisi_penjualan"
            style="@style/TypeStyles.BodySmall"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
