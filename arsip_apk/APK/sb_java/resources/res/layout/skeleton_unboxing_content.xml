<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_20"
    android:layout_marginHorizontal="@dimen/spacing_20">
    <View
        android:id="@+id/v_unboxing_image"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="@dimen/clickable_size_75"
        app:layout_constraintBottom_toTopOf="@+id/v_border"
        app:layout_constraintDimensionRatio="w,4:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SBShimmerItem"/>
    <View
        android:id="@+id/v_unboxing_title"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="@dimen/height_58"
        android:layout_marginEnd="@dimen/spacing_16"
        app:layout_constraintBottom_toTopOf="@+id/v_unboxing_desc"
        app:layout_constraintEnd_toStartOf="@+id/v_unboxing_image"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/v_unboxing_image"
        app:layout_constraintVertical_bias="0"
        style="@style/SBShimmerItem"/>
    <View
        android:id="@+id/v_unboxing_desc"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_4"
        android:layout_marginEnd="@dimen/width_170"
        app:layout_constraintBottom_toBottomOf="@+id/v_unboxing_image"
        app:layout_constraintEnd_toStartOf="@+id/v_unboxing_image"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_unboxing_title"
        style="@style/SBShimmerItem"/>
    <View
        android:id="@+id/v_border"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/spacing_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_unboxing_image"
        style="@style/SBShimmerItem"/>
</androidx.constraintlayout.widget.ConstraintLayout>
