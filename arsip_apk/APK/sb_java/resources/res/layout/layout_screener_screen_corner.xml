<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_screener_screen_corner_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="@dimen/screener_width_row_header"
    android:layout_height="@dimen/cell_height">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_sorting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/item_gap_3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_sort_asc"
            android:layout_width="@dimen/item_gap_9"
            android:layout_height="@dimen/item_gap_8"
            android:contentDescription="@string/hint_sort_column_ascending"
            app:srcCompat="@drawable/ic_sort_asc"/>
        <ImageView
            android:id="@+id/iv_sort_desc"
            android:layout_width="@dimen/item_gap_9"
            android:layout_height="@dimen/item_gap_8"
            android:contentDescription="@string/hint_sort_column_descending"
            app:srcCompat="@drawable/ic_sort_desc"/>
    </LinearLayout>
    <com.stockbit.uikit.control.ControlCheckbox
        android:id="@+id/cb_screener_all"
        android:background="@color/transparent"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false"
        android:layout_marginStart="@dimen/spacing_20"
        app:checkBoxType="round"
        app:layout_constraintBottom_toBottomOf="@+id/tv_symbol"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol"/>
    <TextView
        android:textSize="@dimen/text_size"
        android:id="@+id/tv_symbol"
        android:paddingLeft="@dimen/spacing_20"
        android:paddingRight="@dimen/spacing_20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/screener_screen_symbol_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cb_screener_all"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SbTextView.Caption.Bold"/>
    <View
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
