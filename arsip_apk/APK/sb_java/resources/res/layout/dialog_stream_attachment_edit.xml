<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/dialog_stream_attachment_edit_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/parentPeriodSelectorTitle"
        android:background="@drawable/bg_top_rounded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_s">
        <TextView
            android:gravity="center"
            android:id="@+id/tvPeriodSelectorTitle"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_32"
            android:layout_centerVertical="true"
            style="@style/SbTextView.ListTitle"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/ibPeriodSelectorClearText"
            android:tag="binding_2"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:layout_marginTop="@dimen/item_gap_l"
            android:layout_marginRight="@dimen/item_gap_m"
            android:scaleType="centerInside"
            android:tint="?attr/themeIconTintColor"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="0x7f08063f"/>
    </RelativeLayout>
    <View
        android:id="@+id/sepRegisterFieldOption"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAttachments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
</LinearLayout>
