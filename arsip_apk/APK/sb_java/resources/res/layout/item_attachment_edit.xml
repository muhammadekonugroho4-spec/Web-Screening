<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_attachment_edit_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:ellipsize="middle"
        android:id="@+id/tvAttachment"
        android:paddingLeft="@dimen/item_gap_l"
        android:paddingTop="@dimen/item_gap_l"
        android:paddingRight="@dimen/item_gap_l"
        android:paddingBottom="@dimen/item_gap_l"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_toLeftOf="@+id/ibRowAttachmentDelete"
        style="@style/SbTextView.BodyDefault"/>
    <ImageButton
        android:id="@+id/ibRowAttachmentDelete"
        android:background="@drawable/bg_circle_black"
        android:padding="@dimen/item_gap_xs"
        android:layout_width="@dimen/clickable_size_24"
        android:layout_height="@dimen/clickable_size_24"
        android:layout_marginTop="@dimen/item_gap_s"
        android:layout_marginRight="@dimen/item_gap_m"
        android:scaleType="fitCenter"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="0x7f08063f"/>
    <View
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_below="@+id/tvAttachment"/>
</RelativeLayout>
