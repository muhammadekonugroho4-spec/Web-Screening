<?xml version="1.0" encoding="utf-8"?>
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vfFragmentTippingReceivedDialog"
    android:tag="layout/fragment_tipping_receive_dialog_0"
    android:background="@drawable/bg_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/flFragmentTippingReceivedDialogHeaderIcon"
            android:layout_width="@dimen/avatar_size_xl"
            android:layout_height="@dimen/avatar_size_xl"
            android:layout_margin="@dimen/item_gap_l"
            android:layout_alignParentTop="true"
            android:layout_centerInParent="true">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivFragmentTippingReceivedDialogHeaderIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/progressFragmentTippingReceivedDialogHeaderIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <TextView
            android:gravity="center"
            android:id="@+id/tvFragmentTippingReceivedDialogTitle"
            android:padding="@dimen/item_gap_m"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/n_dash"
            android:layout_below="@+id/flFragmentTippingReceivedDialogHeaderIcon"
            android:textAlignment="gravity"
            style="@style/SbTextView.ListTitle"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tvFragmentTippingReceivedDialogSubTitle"
            android:paddingLeft="@dimen/item_gap_l"
            android:paddingRight="@dimen/item_gap_l"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_l"
            android:layout_marginRight="@dimen/item_gap_l"
            android:text="@string/n_dash"
            android:layout_below="@+id/tvFragmentTippingReceivedDialogTitle"
            android:textAlignment="gravity"
            style="@style/SbTextView.BodyDefault"/>
        <RelativeLayout
            android:id="@+id/FragmentTippingReceivedDialogTipAmount"
            android:background="@drawable/border_gray_rounded_outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/item_gap_l"
            android:layout_below="@+id/tvFragmentTippingReceivedDialogSubTitle">
            <TextView
                android:id="@+id/tvFragmentTippingReceivedDialogTipsTitle"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingTop="@dimen/item_gap_m"
                android:paddingRight="@dimen/item_gap_l"
                android:paddingBottom="@dimen/item_gap_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_tipping_claim_success_tips_title"
                android:layout_alignParentStart="true"
                style="@style/SbTextView.BodyDefault"/>
            <TextView
                android:gravity="end|center_vertical"
                android:id="@+id/tvFragmentTippingReceivedDialogAmount"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingTop="@dimen/item_gap_m"
                android:paddingRight="@dimen/item_gap_l"
                android:paddingBottom="@dimen/item_gap_m"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/n_dash"
                android:textAlignment="gravity"
                android:layout_toEndOf="@+id/tvFragmentTippingReceivedDialogTipsTitle"
                style="@style/SbTextView.BodyDefault.Bold"/>
            <TextView
                android:textColor="@color/gray_text"
                android:gravity="end|center_vertical"
                android:id="@+id/tvFragmentTippingReceivedDialogDate"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingTop="@dimen/item_gap_m"
                android:paddingRight="@dimen/item_gap_l"
                android:paddingBottom="@dimen/item_gap_m"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/n_dash"
                android:layout_below="@+id/tvFragmentTippingReceivedDialogAmount"
                android:textAlignment="gravity"
                style="@style/SbTextView.BodyDefault"/>
        </RelativeLayout>
        <TextView
            android:id="@+id/tvReceiveTippingDialogContentSendMessageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_l"
            android:layout_marginRight="@dimen/item_gap_l"
            android:text="@string/title_tipping_my_jar_dialog_receive_send_message_title"
            android:layout_below="@+id/FragmentTippingReceivedDialogTipAmount"
            style="@style/SbTextView.BodyDefault"/>
        <HorizontalScrollView
            android:id="@+id/hsvFragmentTippingReceivedDialogMessageTemplate"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_l"
            android:layout_marginTop="@dimen/item_gap_m"
            android:layout_marginRight="@dimen/item_gap_l"
            android:layout_below="@+id/tvReceiveTippingDialogContentSendMessageTitle">
            <RadioGroup
                android:orientation="horizontal"
                android:id="@+id/radioGroupFragmentTippingReceivedDialogMsgTemplate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <RadioButton
                    android:gravity="center"
                    android:id="@+id/radioButtonFragmentTippingReceivedDialogThx"
                    android:background="@drawable/bg_radiobutton_gray_outline"
                    android:paddingLeft="@dimen/item_gap_l"
                    android:paddingTop="@dimen/item_gap_xs"
                    android:paddingRight="@dimen/item_gap_l"
                    android:paddingBottom="@dimen/item_gap_xs"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/clickable_size_32"
                    android:button="@null"
                    android:text="@string/title_tipping_my_jar_dialog_receive_thank_you_title"
                    android:layout_weight="1"
                    style="@style/SbTextView.BodyDefault"/>
                <RadioButton
                    android:gravity="center"
                    android:id="@+id/radioButtonFragmentTippingReceivedDialogAppreciate"
                    android:background="@drawable/bg_radiobutton_gray_outline"
                    android:paddingLeft="@dimen/item_gap_l"
                    android:paddingTop="@dimen/item_gap_xs"
                    android:paddingRight="@dimen/item_gap_l"
                    android:paddingBottom="@dimen/item_gap_xs"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/clickable_size_32"
                    android:button="@null"
                    android:text="@string/title_tipping_my_jar_dialog_receive_appreciate_title"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/item_gap_m"
                    style="@style/SbTextView.BodyDefault"/>
                <RadioButton
                    android:gravity="center"
                    android:id="@+id/radioButtonFragmentTippingReceivedDialogThxGift"
                    android:background="@drawable/bg_radiobutton_gray_outline"
                    android:paddingLeft="@dimen/item_gap_l"
                    android:paddingTop="@dimen/item_gap_xs"
                    android:paddingRight="@dimen/item_gap_l"
                    android:paddingBottom="@dimen/item_gap_xs"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/clickable_size_32"
                    android:button="@null"
                    android:text="@string/title_tipping_my_jar_dialog_receive_thank_gift_title"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/item_gap_m"
                    style="@style/SbTextView.BodyDefault"/>
            </RadioGroup>
        </HorizontalScrollView>
        <EditText
            android:id="@+id/etFragmentTippingReceivedDialogMessage"
            android:background="@drawable/border_gray_rounded_outline"
            android:padding="@dimen/item_gap_m"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_l"
            android:layout_marginTop="@dimen/item_gap_m"
            android:layout_marginRight="@dimen/item_gap_l"
            android:hint="@string/title_tipping_my_jar_dialog_receive_say_something_nice"
            android:maxLines="1"
            android:layout_below="@+id/hsvFragmentTippingReceivedDialogMessageTemplate"
            android:inputType="textShortMessage"
            android:imeOptions="actionDone"
            style="@style/SbEditTextStyle.Transparent"/>
        <Button
            android:id="@+id/btnFragmentTippingReceivedDialogDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/item_gap_l"
            android:text="@string/btn_done_tipping"
            android:layout_below="@+id/etFragmentTippingReceivedDialogMessage"
            style="@style/SbBtn.PrimaryFullWidthFloating"/>
    </RelativeLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:layout_width="@dimen/clickable_size_32"
        android:layout_height="@dimen/clickable_size_32"
        android:indeterminate="true"
        android:indeterminateTint="@color/green_text"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/layoutErrorView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/comp_icon_error_view"/>
</ViewFlipper>
