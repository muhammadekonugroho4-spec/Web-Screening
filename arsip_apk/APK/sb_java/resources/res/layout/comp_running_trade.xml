<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_rt"
    android:tag="layout/comp_running_trade_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/fl_running_trade"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/cv_running_trade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textColor="@color/green_text"
                android:layout_gravity="center"
                android:id="@+id/tv_running_trade_see_more"
                android:paddingTop="@dimen/item_gap_15"
                android:paddingBottom="@dimen/item_gap_15"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_10"
                android:layout_marginBottom="@dimen/item_gap_15"
                android:text="@string/button_see_more"
                android:drawablePadding="@dimen/spacing_4"
                android:paddingStart="@dimen/spacing_16"
                android:paddingEnd="@dimen/spacing_16"
                app:drawableEndCompat="@drawable/ic_chevron_right_green"
                style="@style/TypeStyles.HeadingSmall"/>
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
