<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/srl_main_livestream"
    android:tag="layout/fragment_livestream_main_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <TextView
                android:layout_gravity="center"
                android:id="@+id/tv_title_toolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_research_event"
                style="@style/TypeStyles.HeadingLarge"/>
        </androidx.appcompat.widget.Toolbar>
        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/cl_livestream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/abl_livestream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Sb.Widget.AppBar">
                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/spacing_0"
                    app:layout_scrollFlags="exitUntilCollapsed|scroll">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ViewStub
                            android:id="@+id/comp_livestream_live"
                            android:tag="binding_2"
                            android:visibility="gone"
                            android:layout="@layout/comp_livestream_live"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                        <TextView
                            android:id="@+id/tv_all_event"
                            android:tag="binding_3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_20"
                            android:text="@string/title_research_all_event"
                            android:layout_marginHorizontal="@dimen/spacing_20"
                            style="@style/TypeStyles.HeadingRegular"/>
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/cg_livestream_chip"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_12"
                            android:layout_marginBottom="@dimen/spacing_24"
                            android:fillViewport="true"
                            android:layout_marginHorizontal="@dimen/spacing_20"
                            app:chipSpacingHorizontal="@dimen/spacing_8"
                            app:singleSelection="true"/>
                    </LinearLayout>
                </com.google.android.material.appbar.CollapsingToolbarLayout>
            </com.google.android.material.appbar.AppBarLayout>
            <com.stockbit.livestream.component.LivestreamNestedScrollView
                android:id="@+id/nsv_livestream"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_livestream"
                    android:tag="binding_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <androidx.recyclerview.widget.RecyclerView
                        android:orientation="vertical"
                        android:id="@+id/rv_livestream_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fillViewport="true"
                        android:nestedScrollingEnabled="true"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                    <ViewStub
                        android:id="@+id/comp_livestream_empty"
                        android:tag="binding_5"
                        android:visibility="gone"
                        android:layout="@layout/comp_livestream_empty"
                        android:inflatedId="@+id/inflate_comp_livestream_empty"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="@dimen/spacing_20"/>
                    <include
                        android:id="@+id/shimmer_livestream_list"
                        android:visibility="gone"
                        layout="@layout/skeleton_livestream_main"/>
                </LinearLayout>
            </com.stockbit.livestream.component.LivestreamNestedScrollView>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
        <include
            android:id="@+id/shimmer_livestream_main"
            layout="@layout/skeleton_livestream_main"/>
    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
