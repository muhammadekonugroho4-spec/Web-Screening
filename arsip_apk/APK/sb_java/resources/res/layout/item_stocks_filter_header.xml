<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_stocks_filter_header_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/item_gap_10">
    <com.stockbit.feature.stocksfilter.component.StocksFilterEditText
        android:id="@+id/et_header_search_input"
        android:background="@drawable/bg_border_gray_rounded"
        android:focusable="false"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_44"
        android:layout_marginTop="@dimen/spacing_8"
        android:minHeight="@dimen/clickable_size_32"
        android:hint="@string/text_hint_search_stock"
        android:layout_centerVertical="true"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionGo"
        android:layout_marginHorizontal="@dimen/spacing_20"
        android:paddingHorizontal="@dimen/clickable_size_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SbEditTextStyle.GrayBackground"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/ib_header_search_button"
        android:padding="@dimen/item_gap_xs"
        android:layout_width="@dimen/clickable_size_20"
        android:layout_height="@dimen/clickable_size_20"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:contentDescription="@string/hint_search_content"
        android:layout_marginStart="@dimen/item_gap_s"
        app:layout_constraintBottom_toBottomOf="@+id/et_header_search_input"
        app:layout_constraintStart_toStartOf="@+id/et_header_search_input"
        app:layout_constraintTop_toTopOf="@+id/et_header_search_input"
        app:srcCompat="@drawable/ic_android_search"
        app:tint="@color/highgray_light"/>
    <ImageButton
        android:id="@+id/ib_header_clear_query"
        android:background="@null"
        android:padding="@dimen/spacing_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:contentDescription="@string/hint_clear_search_text"
        android:layout_alignParentEnd="true"
        android:layout_marginHorizontal="@dimen/spacing_6"
        app:layout_constraintBottom_toBottomOf="@+id/et_header_search_input"
        app:layout_constraintEnd_toEndOf="@+id/et_header_search_input"
        app:layout_constraintTop_toTopOf="@+id/et_header_search_input"
        app:srcCompat="@drawable/ic_close_outline"/>
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/group_stocks"
        android:background="@drawable/bg_border_gray_rounded"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_8"
        app:chipSpacingVertical="@dimen/item_gap_10"
        app:layout_constraintEnd_toEndOf="@+id/et_header_search_input"
        app:layout_constraintStart_toStartOf="@+id/et_header_search_input"
        app:layout_constraintTop_toBottomOf="@+id/et_header_search_input"/>
    <TextView
        android:id="@+id/tv_max_stock"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/max_stocks"
        app:layout_constraintEnd_toEndOf="@+id/et_header_search_input"
        app:layout_constraintStart_toStartOf="@+id/et_header_search_input"
        app:layout_constraintTop_toBottomOf="@+id/group_stocks"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_all_stock"
        android:background="@drawable/bg_border_gray_rounded"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_10"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="@+id/et_header_search_input"
        app:layout_constraintStart_toStartOf="@+id/et_header_search_input"
        app:layout_constraintTop_toBottomOf="@+id/tv_max_stock">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/all_stocks"
            android:layout_weight="1"
            style="@style/TypeStyles.HeadingRegular"/>
        <com.stockbit.uikit.control.ControlCheckbox
            android:id="@+id/cb_all_stock"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="@dimen/spacing_24"
            android:layout_height="@dimen/spacing_20"
            android:checked="true"
            app:checkBoxType="round"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
