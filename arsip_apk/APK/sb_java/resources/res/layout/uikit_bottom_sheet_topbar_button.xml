<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/top_bar_height">
    <com.stockbit.uikit.bottomsheet.topbar.TopBarButton
        android:id="@+id/bottom_sheet_topbar_button_btn_left"
        android:layout_width="@dimen/uikit_bottomsheet_topbar_button_width"
        android:layout_height="wrap_content"
        android:text="Button"
        android:layout_marginStart="@dimen/spacing_20"
        app:topBarButtonColor="red"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/spacing_16">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/bottom_sheet_topbar_button_iv_title_left"
                android:visibility="gone"
                android:layout_width="@dimen/icon_placeholder_16"
                android:layout_height="@dimen/icon_placeholder_16"
                android:layout_marginEnd="@dimen/spacing_4"
                app:layout_constraintBottom_toBottomOf="@+id/bottom_sheet_topbar_button_tv_title"
                app:layout_constraintEnd_toStartOf="@+id/bottom_sheet_topbar_button_tv_title"
                app:layout_constraintTop_toTopOf="@+id/bottom_sheet_topbar_button_tv_title"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/themeColorTextPrimary"
                android:ellipsize="end"
                android:id="@+id/bottom_sheet_topbar_button_tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.HeadingLarge"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/bottom_sheet_topbar_button_iv_title_right"
                android:visibility="gone"
                android:layout_width="@dimen/icon_placeholder_16"
                android:layout_height="@dimen/icon_placeholder_16"
                android:layout_marginStart="@dimen/spacing_4"
                app:layout_constraintBottom_toBottomOf="@+id/bottom_sheet_topbar_button_tv_title"
                app:layout_constraintStart_toEndOf="@+id/bottom_sheet_topbar_button_tv_title"
                app:layout_constraintTop_toTopOf="@+id/bottom_sheet_topbar_button_tv_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/themeColorTextSecondary"
            android:ellipsize="end"
            android:id="@+id/bottom_sheet_topbar_button_tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/TypeStyles.BodyXXSmall"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.stockbit.uikit.bottomsheet.topbar.TopBarButton
        android:gravity="end"
        android:id="@+id/bottom_sheet_topbar_button_btn_right"
        android:layout_width="@dimen/uikit_bottomsheet_topbar_button_width"
        android:layout_height="wrap_content"
        android:text="Button"
        android:layout_marginEnd="@dimen/spacing_20"
        app:topBarButtonColor="green"/>
</androidx.appcompat.widget.LinearLayoutCompat>
