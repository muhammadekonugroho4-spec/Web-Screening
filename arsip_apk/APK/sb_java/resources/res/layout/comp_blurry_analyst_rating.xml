<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_analyst_rating"
    android:tag="layout/comp_blurry_analyst_rating_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_analyst_rating"
        android:paddingBottom="@dimen/spacing_20"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_marginStart="@dimen/spacing_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingRegular"/>
    <ImageView
        android:id="@+id/iv_title_info"
        android:layout_width="@dimen/spacing_16"
        android:layout_height="@dimen/spacing_16"
        android:layout_marginStart="@dimen/spacing_6"
        app:layout_constraintStart_toEndOf="@+id/tv_analyst_rating"
        app:layout_constraintTop_toTopOf="@+id/tv_analyst_rating"
        app:srcCompat="@drawable/ic_info"/>
    <ImageView
        android:id="@+id/iv_analyst_rating_round"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_analyst_rating_round"
        android:paddingEnd="@dimen/spacing_24"
        android:layout_marginStart="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_analyst_rating"
        app:tint="?attr/themeColorSurfaceVariant"/>
    <ImageView
        android:id="@+id/iv_analyst_rating_1_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_analyst_rating_bar"
        app:layout_constraintBottom_toTopOf="@+id/iv_analyst_rating_2_bar"
        app:layout_constraintStart_toEndOf="@+id/iv_analyst_rating_round"
        app:layout_constraintTop_toTopOf="@+id/iv_analyst_rating_round"
        app:tint="?attr/themeColorSurfaceVariant"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_analyst_rating_buy"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/spacing_8"
        app:layout_constraintBottom_toBottomOf="@+id/iv_analyst_rating_1_bar"
        app:layout_constraintStart_toEndOf="@+id/iv_analyst_rating_1_bar"
        app:layout_constraintTop_toTopOf="@+id/iv_analyst_rating_1_bar"
        style="@style/TypeStyles.BodyXSmall"/>
    <ImageView
        android:id="@+id/iv_analyst_rating_2_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_analyst_rating_bar"
        app:layout_constraintBottom_toTopOf="@+id/iv_analyst_rating_3_bar"
        app:layout_constraintStart_toEndOf="@+id/iv_analyst_rating_round"
        app:layout_constraintTop_toBottomOf="@+id/iv_analyst_rating_1_bar"
        app:tint="?attr/themeColorSurfaceVariant"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_analyst_rating_hold"
        android:layout_marginStart="@dimen/spacing_8"
        app:layout_constraintBottom_toBottomOf="@+id/iv_analyst_rating_2_bar"
        app:layout_constraintStart_toEndOf="@+id/iv_analyst_rating_2_bar"
        app:layout_constraintTop_toTopOf="@+id/iv_analyst_rating_2_bar"
        style="@style/TypeStyles.BodyXSmall"/>
    <ImageView
        android:id="@+id/iv_analyst_rating_3_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_analyst_rating_bar"
        app:layout_constraintBottom_toBottomOf="@+id/iv_analyst_rating_round"
        app:layout_constraintStart_toEndOf="@+id/iv_analyst_rating_round"
        app:layout_constraintTop_toBottomOf="@+id/iv_analyst_rating_2_bar"
        app:tint="?attr/themeColorSurfaceVariant"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_analyst_rating_sell"
        android:layout_marginStart="@dimen/spacing_8"
        app:layout_constraintBottom_toBottomOf="@+id/iv_analyst_rating_3_bar"
        app:layout_constraintStart_toEndOf="@+id/iv_analyst_rating_3_bar"
        app:layout_constraintTop_toTopOf="@+id/iv_analyst_rating_3_bar"
        style="@style/TypeStyles.BodyXSmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
