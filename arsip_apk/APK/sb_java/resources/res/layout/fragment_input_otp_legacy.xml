<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_input_otp_legacy_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:elevation="@dimen/item_gap_null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar_sms"
                android:paddingLeft="@dimen/item_gap_null"
                android:paddingRight="@dimen/item_gap_null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize"
                app:contentInsetLeft="@dimen/item_gap_null"
                app:contentInsetStart="@dimen/item_gap_null"
                app:contentInsetStartWithNavigation="@dimen/item_gap_null"
                app:elevation="@dimen/item_gap_null">
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:paddingLeft="@dimen/item_gap_l"
                    android:paddingRight="@dimen/item_gap_l"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_phone_number_verification"
                    android:singleLine="true"
                    android:layout_centerHorizontal="true"
                    android:textAlignment="gravity"
                    style="@style/TypeStyles.HeadingLarge"/>
            </androidx.appcompat.widget.Toolbar>
        </com.google.android.material.appbar.AppBarLayout>
        <ImageView
            android:id="@+id/iv_icon"
            android:layout_width="@dimen/clickable_size_72"
            android:layout_height="@dimen/clickable_size_72"
            android:layout_marginTop="@dimen/item_gap_20"
            android:src="?attr/themeIconRegisterOtp"
            android:layout_marginStart="@dimen/item_gap_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/app_bar"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:text="@string/title_verification_code"
            android:singleLine="true"
            android:textAlignment="gravity"
            android:layout_marginStart="@dimen/item_gap_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_icon"
            style="@style/TypeStyles.HeadlineRegular"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:id="@+id/tv_subtitle"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            android:textAlignment="gravity"
            android:layout_marginStart="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/item_gap_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            style="@style/TypeStyles.BodyRegular"/>
        <com.stockbit.uikit.input.InputOtpCode
            android:id="@+id/otp_code"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_subtitle"
            app:otpIsShowError="true"
            app:otpStartTimerWhenResend="false"/>
        <com.stockbit.uikit.buttons.StickyButton
            android:id="@+id/sb_submit_otp"
            android:tag="binding_3"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_48"
            android:layout_marginTop="@dimen/item_gap_16"
            android:text="@string/button_next"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/otp_code"
            app:layout_constraintVertical_bias="1"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
