<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_tap_mantion_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/rl_tagged"
        android:tag="binding_1"
        android:background="@drawable/bg_circle_theme_component"
        android:layout_width="30dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon_tagged_group"
        app:layout_constraintEnd_toEndOf="@+id/iv_icon_tagged_group"
        app:layout_constraintStart_toStartOf="@+id/iv_icon_tagged_group"
        app:layout_constraintTop_toTopOf="@+id/iv_icon_tagged_group"/>
    <ImageView
        android:id="@+id/iv_icon_tagged_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_10"
        android:src="@drawable/ic_tagged"
        app:layout_constraintStart_toEndOf="@+id/tv_tag_count"
        app:layout_constraintTop_toTopOf="@+id/tv_tag_count"
        app:tint="@color/light_icon_default"/>
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_tag_count"
        android:tag="binding_2"
        android:background="@drawable/bg_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/spacing_16"
        android:minHeight="@dimen/spacing_16"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/spacing_4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyXSmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
