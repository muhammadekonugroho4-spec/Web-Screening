<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_amend_buy_fragment_layout"
    android:tag="layout/fragment_amend_buy_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_trading_buy"
        android:paddingLeft="@dimen/spacing_0"
        android:paddingRight="@dimen/spacing_0"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:contentInsetLeft="@dimen/spacing_0"
        app:contentInsetStart="@dimen/spacing_0"
        app:contentInsetStartWithNavigation="@dimen/spacing_0"
        app:elevation="@dimen/spacing_0">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="?attr/actionBarSize">
            <TextView
                android:id="@+id/tv_toolbar_symbol"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ll_order_type"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.HeadingLarge"/>
            <include
                android:id="@+id/ll_order_type"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/item_gap_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/layout_amend_order_type_chip"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>
    <ViewFlipper
        android:id="@+id/vf_fragment_trading_buy"
        android:tag="binding_2"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/sfl_trading_buy_loading"
            android:paddingTop="@dimen/item_gap_m"
            android:paddingBottom="@dimen/spacing_16"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include layout="@layout/skeleton_item_buy"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/nsv_layout_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:layout_above="@+id/btn_order"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_parent_layout"
                    android:tag="binding_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.stockbit.component.securities.companyprice.StockbitCompanyPriceV2View
                        android:id="@+id/ll_company_info_layout"
                        android:tag="binding_5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <include
                        android:id="@+id/view_banner_info"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_12"
                        android:layout_marginStart="@dimen/spacing_16"
                        android:layout_marginEnd="@dimen/spacing_16"
                        layout="@layout/comp_information_banner_view"/>
                    <RelativeLayout
                        android:id="@+id/rl_buy_header"
                        android:background="@drawable/border_red"
                        android:paddingTop="@dimen/spacing_12"
                        android:paddingBottom="@dimen/spacing_12"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:paddingStart="@dimen/spacing_16"
                        android:paddingEnd="@dimen/spacing_16"
                        android:layout_marginHorizontal="@dimen/spacing_16">
                        <TextView
                            android:id="@+id/tv_title_deposit_now"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/buy_balance_not_enough"
                            style="@style/TypeStyles.HeadingXSmall"/>
                        <TextView
                            android:id="@+id/tv_trading_not_enough"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_2"
                            android:text="@string/buy_balance_deposit_amount"
                            android:layout_below="@+id/tv_title_deposit_now"
                            android:layout_marginEnd="@dimen/spacing_16"
                            android:layout_toStartOf="@+id/tv_deposit"
                            style="@style/SbTextView.Helper.Error"/>
                        <TextView
                            android:id="@+id/tv_deposit"
                            android:background="@drawable/bg_card_green_light"
                            android:paddingTop="@dimen/spacing_6"
                            android:paddingBottom="@dimen/spacing_6"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_deposit_title"
                            android:layout_centerVertical="true"
                            android:textAlignment="gravity"
                            android:paddingStart="@dimen/spacing_16"
                            android:paddingEnd="@dimen/spacing_16"
                            android:layout_alignParentEnd="true"
                            style="@style/SbTextView.Label.Active"/>
                    </RelativeLayout>
                    <LinearLayout
                        android:id="@+id/ll_max_lot_order_warning"
                        android:background="@drawable/bg_border_rounded_red"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:layout_marginHorizontal="@dimen/spacing_16"
                        android:paddingHorizontal="@dimen/spacing_16"
                        android:paddingVertical="@dimen/spacing_12">
                        <TextView
                            android:textColor="?attr/themeColorTextRed"
                            android:id="@+id/tv_max_lot_order_warning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/max_lot_order_warning"
                            android:contentDescription="@string/LIMIT_MAX_INPUT_LOT_4"
                            style="@style/TypeStyles.BodyRegular"/>
                    </LinearLayout>
                    <com.stockbit.feature.transaction.util.StockbitAmendBuyV2
                        android:id="@+id/main_amend_buy_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/cv_amend_buy_bracket_order"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_12"/>
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/cv_amend_buy_volume_trigger_order"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_order_book_title"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/fixed_height"
                        android:paddingStart="@dimen/item_gap_l"
                        android:paddingEnd="@dimen/item_gap_l">
                        <View
                            android:layout_gravity="center"
                            android:background="?attr/themeColorBorder"
                            android:padding="0dp"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>
                        <TextView
                            android:gravity="center"
                            android:layout_gravity="center"
                            android:id="@+id/tv_title_order_book"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/orderBook_trade"
                            android:textAlignment="gravity"
                            android:layout_marginHorizontal="@dimen/spacing_8"
                            style="@style/SbTextView.CaptionSecondary"/>
                        <View
                            android:layout_gravity="center"
                            android:background="?attr/themeColorBorder"
                            android:padding="0dp"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <com.stockbit.component.orderbook.CollapsibleOrderbookView
                        android:id="@+id/view_orderbook"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <View
                        android:id="@+id/border"
                        android:background="?attr/themeSeparatorGapColor"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/spacing_8"
                        android:layout_marginBottom="@dimen/spacing_20"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_title_running_Trade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/running_trade_title"
                        android:layout_marginStart="@dimen/spacing_16"
                        style="@style/TypeStyles.HeadingLarge"/>
                    <com.stockbit.component.runningtrade.main.StockbitRunningTrade
                        android:id="@+id/comp_running_trade"
                        android:tag="binding_6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_24"/>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_retry_order_book"
                android:tag="binding_7"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true">
                <com.stockbit.uikit.layout.BitRoundedLayout
                    android:layout_width="@dimen/width_120"
                    android:layout_height="@dimen/height_120"
                    app:cornerRadius="@dimen/shape_radius_8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:roundedColor="?attr/themeColorModalsEmphasis">
                    <com.stockbit.uikit.control.ControlProgressLoading
                        android:layout_gravity="center"
                        android:id="@+id/cpl_dialog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:progressLoadingSize="large"/>
                </com.stockbit.uikit.layout.BitRoundedLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.stockbit.uikit.button.PrimaryStickyButton
                android:textSize="@dimen/text_size_16"
                android:id="@+id/btn_order"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/orderlist_detail_title_ammend"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true"
                app:buttonRadius="@dimen/spacing_0"
                app:cornerRadius="0dp"/>
        </RelativeLayout>
        <include
            android:layout_gravity="center"
            android:id="@+id/parent_error_trading_buy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/comp_icon_error_view"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsv_fragment_trading_buy"
            android:tag="binding_8"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <include layout="@layout/comp_empty_data_trading_stockbit_buy"/>
        </androidx.core.widget.NestedScrollView>
    </ViewFlipper>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cv_order_limit_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"/>
</androidx.appcompat.widget.LinearLayoutCompat>
