<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_roomlist_search_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_scrollFlags="enterAlways|scroll">
    <com.stockbit.common.uikit.StockbitSearchBar
        android:id="@+id/ssb_search"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/item_gap_10"
        android:layout_marginEnd="@dimen/item_gap_2"
        app:layout_constraintEnd_toStartOf="@+id/tv_btn_cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="@dimen/item_gap_10"
        app:stockbitSearchBarHint="@string/hint_chat_search_recent"/>
    <TextView
        android:id="@+id/tv_btn_cancel"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/button_cancel"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:layout_constraintBottom_toBottomOf="@+id/ssb_search"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ssb_search"
        style="@style/SbTextView.Label.Active"/>
</androidx.constraintlayout.widget.ConstraintLayout>
