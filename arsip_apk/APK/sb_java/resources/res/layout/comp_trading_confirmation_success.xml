<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_success"
    android:tag="layout/comp_trading_confirmation_success_0"
    android:background="@drawable/bg_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_success_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32"
        android:layout_marginStart="@dimen/spacing_20"
        android:layout_marginEnd="@dimen/spacing_20"
        app:layout_constraintBottom_toTopOf="@+id/btn_back_to_order"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_top_side"
            android:background="@drawable/bg_dialog_confirmation_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/v_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center_horizontal"
                android:id="@+id/tv_company_symbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_company_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.HeadingLarge"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_company_name"
                android:paddingBottom="@dimen/item_gap_32"
                android:layout_width="@dimen/spacing_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:layout_marginStart="@dimen/spacing_20"
                android:layout_marginEnd="@dimen/spacing_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_company_symbol"
                style="@style/TypeStyles.BodyXSmall"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/v_divider"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            app:layout_constraintBottom_toTopOf="@+id/cl_bottom_side"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_top_side">
            <View
                android:id="@+id/v_left"
                android:background="@drawable/bg_modal_rounded_right"
                android:layout_width="15dp"
                android:layout_height="28dp"
                android:foregroundTint="?attr/themeColorModalsBorder"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/v_line"
                android:background="@drawable/bg_dotted_line"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/v_right"
                app:layout_constraintStart_toEndOf="@+id/v_left"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/v_right"
                android:background="@drawable/bg_modal_rounded_left"
                android:layout_width="15dp"
                android:layout_height="28dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_bottom_side"
            android:background="@drawable/bg_dialog_confirmation_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/v_divider">
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center_horizontal"
                android:id="@+id/tv_order_success"
                android:paddingTop="@dimen/item_gap_12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/title_order_sent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"
                style="@style/TypeStyles.HeadingLarge"/>
            <app.rive.runtime.kotlin.RiveAnimationView
                android:layout_gravity="center"
                android:id="@+id/riv_success_order"
                android:layout_width="@dimen/width_100"
                android:layout_height="@dimen/height_100"
                android:layout_marginTop="@dimen/item_gap_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_order_success"
                app:layout_constraintVertical_bias="0"
                app:riveResource="@raw/anim_order_sent_success"/>
            <View
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/v_line_gap"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_32"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/riv_success_order"
                app:layout_constraintVertical_bias="0"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/snb_button_share_trade"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_24"
                android:layout_marginBottom="12dp"
                android:layout_marginHorizontal="@dimen/spacing_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/riv_success_order">
                <ImageView
                    android:padding="@dimen/spacing_2"
                    android:layout_width="@dimen/width_18"
                    android:layout_height="@dimen/height_18"
                    android:layout_marginEnd="@dimen/spacing_4"
                    android:layout_marginVertical="@dimen/spacing_12"
                    app:srcCompat="@drawable/ic_share_portfolio"
                    app:tint="?attr/themeColorTextGreen"/>
                <TextView
                    android:textColor="?attr/themeColorTextGreen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_button_title_share_trade"
                    style="@style/TypeStyles.HeadingRegular"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_company_logo"
        android:layout_width="@dimen/spacing_48"
        android:layout_height="@dimen/spacing_48"
        android:layout_marginTop="@dimen/spacing_20"
        app:layout_constraintBottom_toTopOf="@+id/cl_success_info"
        app:layout_constraintEnd_toEndOf="@+id/cl_success_info"
        app:layout_constraintStart_toStartOf="@+id/cl_success_info"
        app:layout_constraintTop_toTopOf="@+id/cl_success_info"/>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/btn_see_status_order"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_marginBottom="@dimen/spacing_20"
        android:text="@string/button_done"
        android:layout_marginHorizontal="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_back_to_order"/>
    <com.stockbit.uikit.button.SecondaryButton
        android:id="@+id/btn_back_to_order"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:text="@string/button_return_order"
        android:textAllCaps="false"
        android:layout_marginHorizontal="@dimen/spacing_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_success_info"
        app:secondaryButtonActive="true"
        app:secondaryButtonColor="green"
        app:secondaryButtonSize="defaultSize"/>
</androidx.constraintlayout.widget.ConstraintLayout>
