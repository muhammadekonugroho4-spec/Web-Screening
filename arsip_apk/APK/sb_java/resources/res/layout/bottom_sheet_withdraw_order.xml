<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/bottom_sheet_withdraw_order_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_12"
    android:layout_marginBottom="@dimen/item_gap_32">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_withdraw_order_layout"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_8">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_withdraw_order_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tv_withdraw_multiple_order_title"
            android:drawablePadding="@dimen/spacing_12"
            app:drawableStartCompat="@drawable/ic_withdraw_order"
            style="@style/TypeStyles.BodyRegular"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_switch_classic_layout"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_8">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_switch_classic_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/title_switch_classic"
            android:drawablePadding="@dimen/spacing_12"
            android:layout_weight="1"
            app:drawableStartCompat="@drawable/ic_switch_classic_mode"
            style="@style/TypeStyles.BodyRegular"/>
        <com.stockbit.uikit.control.ControlToggleSwitch
            android:gravity="center_vertical"
            android:id="@+id/cts_classic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>
