<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_withdrawal_pin_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/sv_withdrawal_verify_pin_header"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_withdrawal_verify_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="@dimen/avatar_size_m"
                android:layout_height="@dimen/avatar_size_m"
                android:layout_marginTop="@dimen/item_gap_40"
                android:layout_marginBottom="@dimen/item_gap_40"
                app:srcCompat="@drawable/ic_trading_pin"/>
            <TextView
                android:textSize="@dimen/text_size_22"
                android:gravity="center"
                android:id="@+id/tv_withdrawal_verify_pin_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/item_gap_40"
                android:text="@string/title_input_pin_trading"
                android:lineSpacingExtra="@dimen/item_gap_s"
                android:textAlignment="gravity"
                style="@style/SbTextView.BodyDefault.Bold"/>
            <FrameLayout
                android:id="@+id/fl_pin_verify_input_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/clickable_size_48"
                android:paddingStart="@dimen/item_gap_l"
                android:paddingEnd="@dimen/item_gap_l">
                <com.poovam.pinedittextfield.CirclePinField
                    android:textSize="@dimen/text_size_12"
                    android:id="@+id/circle_field_verify_pin"
                    android:background="?attr/selectableItemBackground"
                    android:focusable="false"
                    android:focusableInTouchMode="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:inputType="number"
                    app:circleRadius="7dp"
                    app:distanceInBetween="@dimen/item_gap_l"
                    app:fieldBgColor="@color/green_text_transparent_chip_light"
                    app:fieldColor="@color/green_text_transparent_chip_light"
                    app:fillerColor="@color/green_text"
                    app:fillerRadius="7dp"
                    app:isCursorEnabled="false"
                    app:noOfFields="6"/>
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/sfl_pin_loading"
                    android:tag="binding_1"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <include layout="@layout/securities_skeleton_item_setting_pin"/>
                </com.facebook.shimmer.ShimmerFrameLayout>
            </FrameLayout>
            <TextView
                android:textSize="@dimen/text_size_16"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_forgot_pin"
                android:tag="binding_2"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/item_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_30"
                android:layout_marginBottom="@dimen/item_gap_58"
                android:text="@string/button_forgot_pin_trading"
                android:lineSpacingExtra="@dimen/item_gap_s"
                android:textAlignment="gravity"
                style="@style/SbTextView.BodyDefault.Green.Bold"/>
            <com.stockbit.common.uikit.StockbitSecuritiesPin
                android:gravity="end|center_vertical"
                android:id="@+id/custom_keyboard_withdrawal_verify_pin"
                android:tag="binding_3"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/item_gap_l"
                android:maxLines="1"
                android:textAlignment="gravity"
                style="@style/TypeStyles.Bold"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
