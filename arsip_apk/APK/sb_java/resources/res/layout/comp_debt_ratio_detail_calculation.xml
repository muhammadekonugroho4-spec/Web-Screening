<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_debt_ratio_detail_calculation_0"
    android:background="@drawable/bg_rounded_4_transparent_colormodal"
    android:padding="@dimen/spacing_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <TextView
        android:id="@+id/tv_title_total_debt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_total_debt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_total_debt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_total_debt"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title_total_debt"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title_total_debt"
        style="@style/TypeStyles.BodyRegular"/>
    <com.stockbit.feature.portfolio.component.MathOperationSeparator
        android:id="@+id/mos_divide"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_total_debt"
        app:mathOperator="divide"/>
    <TextView
        android:id="@+id/tv_title_total_market_value"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:text="@string/title_total_market_value"
        app:layout_constraintEnd_toEndOf="@+id/guideline_center_horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mos_divide"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_total_market_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_total_debt"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title_total_market_value"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title_total_market_value"
        style="@style/TypeStyles.BodyRegular"/>
    <com.stockbit.feature.portfolio.component.MathOperationSeparator
        android:id="@+id/mos_equal"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_total_market_value"
        app:mathOperator="equal"/>
    <TextView
        android:id="@+id/tv_title_debt_ratio_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:text="@string/title_debt_ratio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mos_equal"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:id="@+id/tv_debt_ratio_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_total_debt"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title_debt_ratio_result"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title_debt_ratio_result"
        style="@style/TypeStyles.HeadingRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
