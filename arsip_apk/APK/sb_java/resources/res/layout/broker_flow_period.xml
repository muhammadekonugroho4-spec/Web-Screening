<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/broker_flow_period_0"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/tv_period"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingHorizontal="@dimen/spacing_8"
        android:paddingVertical="@dimen/item_gap_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyXSmall"/>
    <View
        android:id="@+id/v_active"
        android:background="@drawable/border_green_rounded"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_period"
        app:layout_constraintEnd_toEndOf="@+id/tv_period"
        app:layout_constraintStart_toStartOf="@+id/tv_period"/>
</androidx.constraintlayout.widget.ConstraintLayout>
