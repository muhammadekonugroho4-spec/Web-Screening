<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:orientation="vertical"
    android:tag="layout/fragment_bibit_confirmation_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rl_header"
        android:background="@drawable/bg_top_rounded"
        android:padding="@dimen/item_gap_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_title_dialog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bibit_term_privacy_title"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/TypeStyles.HeadingLarge"/>
        <ImageView
            android:id="@+id/btn_close"
            android:layout_width="@dimen/item_gap_20"
            android:layout_height="@dimen/item_gap_10"
            android:layout_marginBottom="@dimen/item_gap_10"
            android:src="0x7f080644"
            android:paddingStart="@dimen/item_gap_10"
            android:layout_alignParentEnd="true"
            app:layout_constraintBottom_toTopOf="@+id/tv_title_dialog"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="?attr/titleTextColorLowgray"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/nsv_content"
            android:background="?attr/themeDialogBackgroundColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.stockbit.common.uikit.BitRoundedLayout
                android:padding="@dimen/item_gap_20"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20"
                app:borderStrokeColor="?attr/themeSeparatorGapColorSecondary"
                app:borderStrokeWidth="@dimen/item_gap_1"
                app:cornerRadius="@dimen/shape_radius_m"
                app:roundedColor="@color/transparent">
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/item_gap_14"
                    android:text="@string/bibit_term_privacy_subtitle"
                    style="@style/TypeStyles.HeadingRegular"/>
                <TableLayout
                    android:id="@+id/tl_instruction_detail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/item_gap_12"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title">
                    <TableRow>
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/item_gap_4"
                            android:src="@drawable/ic_green_dot"/>
                        <TextView
                            android:textSize="@dimen/text_size_12"
                            android:layout_gravity="center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/bibit_term_privacy_one"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/item_gap_20"
                            style="@style/TypeStyles.BodyXSmall"/>
                    </TableRow>
                    <TableRow android:layout_marginTop="@dimen/item_gap_16">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/item_gap_4"
                            android:src="@drawable/ic_green_dot"/>
                        <TextView
                            android:textSize="@dimen/text_size_12"
                            android:layout_gravity="center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/bibit_term_privacy_two"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/item_gap_20"
                            style="@style/TypeStyles.BodyXSmall"/>
                    </TableRow>
                    <TableRow android:layout_marginTop="@dimen/item_gap_16">
                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/item_gap_4"
                            android:src="@drawable/ic_green_dot"/>
                        <TextView
                            android:textSize="@dimen/text_size_12"
                            android:layout_gravity="center_vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/bibit_term_privacy_three"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/item_gap_20"
                            style="@style/TypeStyles.BodyXSmall"/>
                    </TableRow>
                </TableLayout>
            </com.stockbit.common.uikit.BitRoundedLayout>
            <View
                android:id="@+id/v_separator"
                android:background="?attr/themeSeparatorGapColorSecondary"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/item_gap_16"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20">
                <com.stockbit.uikit.control.ControlCheckbox
                    android:layout_gravity="top"
                    android:id="@+id/cb_agreement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/bg_checkbox_square"
                    android:layout_marginEnd="@dimen/item_gap_8"/>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bibit_term_privacy_confirmation"
                    style="@style/TypeStyles.BodyXSmall"/>
            </LinearLayout>
            <com.stockbit.uikit.buttons.PrimaryButton
                android:id="@+id/btn_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_16"
                android:layout_marginBottom="@dimen/item_gap_40"
                android:text="@string/btn_allow"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
