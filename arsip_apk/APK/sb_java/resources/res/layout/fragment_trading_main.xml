<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_trading_main_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarFragmentTrading"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_scrollFlags="exitUntilCollapsed|scroll"
        app:navigationContentDescription="@string/SHARED_1">
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/rl_virtual"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_virtual"
                android:layout_width="@dimen/icon_size"
                android:layout_height="@dimen/icon_size"
                android:layout_centerVertical="true"
                app:srcCompat="@mipmap/ic_launcher"/>
            <TextView
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_trading_virtual"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/item_gap_s"
                android:layout_toEndOf="@+id/iv_virtual"
                style="@style/SbTextView.PageTitle"/>
        </RelativeLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/iv_stockbit_logo"
            android:layout_width="@dimen/height_78"
            android:layout_height="@dimen/item_gap_30"
            app:srcCompat="?attr/themeIconStockbitLogo"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_switch_account"
            android:tag="binding_1"
            android:background="@drawable/bg_rounded_switch_account"
            android:paddingTop="9dp"
            android:paddingBottom="7dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="148dp"
            android:maxLines="1"
            android:drawablePadding="@dimen/spacing_4"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_12"
            app:drawableEndCompat="@drawable/uikit_ic_stockbit_text_field_chevron_down"
            style="@style/TypeStyles.BodySmall"/>
    </androidx.appcompat.widget.Toolbar>
    <ViewFlipper
        android:id="@+id/vfFragmentTradingBuy"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarFragmentTrading">
        <FrameLayout
            android:id="@+id/fl_trading_main_shimmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/parentFragmentTradingRoot"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:id="@+id/appBarFragmentTrading"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/compose_tab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <com.stockbit.common.uikit.ExViewPager
                android:id="@+id/viewPagerFragmentTrading"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/appBarFragmentTrading"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include
            android:layout_gravity="center"
            android:id="@+id/parentErrorTradingMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/comp_icon_error_view"/>
    </ViewFlipper>
</androidx.constraintlayout.widget.ConstraintLayout>
