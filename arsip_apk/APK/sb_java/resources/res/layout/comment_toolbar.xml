<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/genericToolbar"
    android:tag="layout/comment_toolbar_0"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:layout_centerHorizontal="true"
    app:layout_scrollFlags="enterAlways|scroll"
    app:titleTextAppearance="@style/SbTextView.PageTitle">
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/text_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        app:autoSizeMaxTextSize="@dimen/text_title"
        app:autoSizeMinTextSize="@dimen/text_body"
        app:autoSizeTextType="none"
        style="@style/SbTextView.PageTitle"/>
</androidx.appcompat.widget.Toolbar>
