<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:id="@+id/llc_item_country"
    android:tag="layout/list_item_country_code_0"
    android:background="?attr/selectableItemBackground"
    android:padding="@dimen/spacing_12"
    android:layout_width="match_parent"
    android:layout_height="@dimen/country_selector_list_item_size">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_country_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TypeStyles.HeadingLarge"/>
    <Space
        android:layout_width="@dimen/spacing_12"
        android:layout_height="wrap_content"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorTextPrimary"
        android:id="@+id/tv_country_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/TypeStyles.HeadingLarge"/>
    <Space
        android:layout_width="@dimen/spacing_12"
        android:layout_height="wrap_content"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorTextSecondary"
        android:id="@+id/tv_country_code"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TypeStyles.BodyXSmall"/>
</androidx.appcompat.widget.LinearLayoutCompat>
