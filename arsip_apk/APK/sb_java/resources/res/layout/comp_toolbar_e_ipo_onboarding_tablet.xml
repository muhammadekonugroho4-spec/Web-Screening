<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbarEIpoOnboarding"
    android:tag="layout/comp_toolbar_e_ipo_onboarding_tablet_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:paddingLeft="@dimen/item_gap_null"
    android:paddingRight="@dimen/item_gap_null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/actionBarSize"
    app:contentInsetLeft="@dimen/item_gap_null"
    app:contentInsetStart="@dimen/item_gap_null"
    app:contentInsetStartWithNavigation="@dimen/item_gap_null"
    app:elevation="@dimen/item_gap_null">
    <RelativeLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/parentToolbarContentContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize">
        <TextView
            android:ellipsize="middle"
            android:gravity="center"
            android:id="@+id/tvToolbarTitleName"
            android:paddingLeft="@dimen/item_gap_l"
            android:paddingRight="@dimen/item_gap_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_centerHorizontal="true"
            android:textAlignment="gravity"
            style="@style/SbTextView.PageTitle"/>
        <ProgressBar
            android:id="@+id/progressBarEIpoOnboarding"
            android:visibility="gone"
            android:layout_width="@dimen/width_progress_bar_e_ipo_onboarding"
            android:layout_height="@dimen/item_gap_l"
            android:max="40"
            android:progress="10"
            android:indeterminate="false"
            android:layout_centerHorizontal="true"
            android:progressTint="@color/green_text"
            android:progressBackgroundTint="@color/green_text"
            style="?android:attr/progressBarStyleHorizontal"/>
    </RelativeLayout>
</androidx.appcompat.widget.Toolbar>
