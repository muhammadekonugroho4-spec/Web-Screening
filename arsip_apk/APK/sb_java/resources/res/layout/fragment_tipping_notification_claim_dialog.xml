<?xml version="1.0" encoding="utf-8"?>
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/vfFragmentTippingClaimNotificationDialog"
    android:tag="layout/fragment_tipping_notification_claim_dialog_0"
    android:background="?attr/themeDialogBackgroundColor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:id="@+id/flFragmentTippingClaimNotificationDialogHeaderIcon"
            android:layout_width="@dimen/avatar_size_xl"
            android:layout_height="@dimen/avatar_size_xl"
            android:layout_margin="@dimen/item_gap_l"
            android:layout_alignParentTop="true"
            android:layout_centerInParent="true">
            <ImageView
                android:id="@+id/ivFragmentTippingClaimNotificationDialogHeaderIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/item_gap_l"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/progressFragmentTippingClaimNotificationDialogHeaderIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </FrameLayout>
        <TextView
            android:gravity="center"
            android:id="@+id/tvFragmentTippingClaimNotificationDialogTitle"
            android:padding="@dimen/item_gap_m"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/n_dash"
            android:layout_below="@+id/flFragmentTippingClaimNotificationDialogHeaderIcon"
            android:textAlignment="gravity"
            style="@style/SbTextView.ListTitle"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tvFragmentTippingClaimNotificationDialogSubTitle"
            android:paddingLeft="@dimen/item_gap_l"
            android:paddingRight="@dimen/item_gap_l"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_l"
            android:layout_marginRight="@dimen/item_gap_l"
            android:text="@string/n_dash"
            android:layout_below="@+id/tvFragmentTippingClaimNotificationDialogTitle"
            android:textAlignment="gravity"
            style="@style/SbTextView.BodyDefault"/>
        <RelativeLayout
            android:id="@+id/parentFragmentTippingClaimNotificationDialogTipAmount"
            android:background="@drawable/border_gray_rounded_outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/item_gap_l"
            android:layout_below="@+id/tvFragmentTippingClaimNotificationDialogSubTitle">
            <TextView
                android:id="@+id/tvFragmentTippingClaimNotificationDialogTipsTitle"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingTop="@dimen/item_gap_m"
                android:paddingRight="@dimen/item_gap_l"
                android:paddingBottom="@dimen/item_gap_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_tipping_my_jar_dialog_claim_pending_disbursement_title"
                android:layout_alignParentStart="true"
                style="@style/SbTextView.BodyDefault"/>
            <TextView
                android:gravity="end|center_vertical"
                android:id="@+id/tvFragmentTippingClaimNotificationDialogAmount"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingTop="@dimen/item_gap_m"
                android:paddingRight="@dimen/item_gap_l"
                android:paddingBottom="@dimen/item_gap_m"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/n_dash"
                android:textAlignment="gravity"
                android:layout_toEndOf="@+id/tvFragmentTippingClaimNotificationDialogTipsTitle"
                style="@style/SbTextView.BodyDefault.Bold"/>
            <TextView
                android:textColor="@color/gray_text"
                android:gravity="end|center_vertical"
                android:id="@+id/tvFragmentTippingClaimNotificationDialogDate"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingTop="@dimen/item_gap_m"
                android:paddingRight="@dimen/item_gap_l"
                android:paddingBottom="@dimen/item_gap_m"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/n_dash"
                android:layout_below="@+id/tvFragmentTippingClaimNotificationDialogAmount"
                android:textAlignment="gravity"
                style="@style/SbTextView.BodyDefault"/>
        </RelativeLayout>
        <Button
            android:id="@+id/btnFragmentTippingClaimNotificationDialogDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/item_gap_l"
            android:text="@string/btn_done_tipping"
            android:layout_below="@+id/parentFragmentTippingClaimNotificationDialogTipAmount"
            style="@style/SbBtn.PrimaryFullWidthFloating"/>
    </RelativeLayout>
    <ProgressBar
        android:layout_gravity="center"
        android:layout_width="@dimen/clickable_size_32"
        android:layout_height="@dimen/clickable_size_32"
        android:indeterminate="true"
        android:indeterminateTint="@color/green_text"/>
    <include
        android:layout_gravity="center"
        android:id="@+id/layoutErrorView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        layout="@layout/comp_icon_error_view"/>
</ViewFlipper>
