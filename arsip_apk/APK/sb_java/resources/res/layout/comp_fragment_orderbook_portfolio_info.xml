<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentFragmentOrderbookPortfolioInfoRoot"
    android:tag="layout/comp_fragment_orderbook_portfolio_info_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:paddingTop="@dimen/item_gap_l"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_trade_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/guideFragmentOrderbookDetail1"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingXSmall"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideFragmentOrderbookDetail1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/item_gap_l"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideFragmentOrderbookDetail2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideFragmentOrderbookDetail3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/item_gap_l"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <TextView
        android:layout_gravity="center"
        android:id="@+id/tvFragmentOrderbookAveragePrice"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        app:layout_constraintLeft_toLeftOf="@+id/guideFragmentOrderbookDetail1"
        app:layout_constraintTop_toBottomOf="@+id/tv_trade_type"
        app:layout_goneMarginTop="@dimen/spacing_0"
        style="@style/TypeStyles.HeadingSmall"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:layout_gravity="center"
        android:id="@+id/tvFragmentOrderbookPortfolioInfoAvgPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_investment_avgprice"
        app:layout_constraintLeft_toLeftOf="@+id/guideFragmentOrderbookDetail1"
        app:layout_constraintTop_toBottomOf="@+id/tvFragmentOrderbookAveragePrice"
        style="@style/TypeStyles.BodyXXSmall"/>
    <TextView
        android:id="@+id/tvFragmentOrderbookBalanceLot"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvFragmentOrderbookAveragePrice"
        style="@style/TypeStyles.HeadingSmall"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:layout_gravity="center"
        android:id="@+id/tvFragmentOrderbookPortfolioInfoBalanceLotLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_investment_balancelot"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFragmentOrderbookBalanceLot"
        style="@style/TypeStyles.BodyXXSmall"/>
    <TextView
        android:id="@+id/tvFragmentOrderbookAvailableLot"
        android:tag="binding_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toLeftOf="@+id/guideFragmentOrderbookDetail3"
        app:layout_constraintTop_toTopOf="@+id/tvFragmentOrderbookAveragePrice"
        style="@style/TypeStyles.HeadingSmall"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:layout_gravity="center"
        android:id="@+id/tvFragmentOrderbookPortfolioInfoAvailLotLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_investment_availlot"
        app:layout_constraintRight_toLeftOf="@+id/guideFragmentOrderbookDetail3"
        app:layout_constraintTop_toBottomOf="@+id/tvFragmentOrderbookAvailableLot"
        style="@style/TypeStyles.BodyXXSmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
