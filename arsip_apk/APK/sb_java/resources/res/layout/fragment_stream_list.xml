<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/srlStreamRefresh"
    android:tag="layout/fragment_stream_list_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/sfl_stream_loading"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/FBShimmerFrameLayout">
            <LinearLayout
                android:orientation="vertical"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <View
                    android:id="@+id/viewStreamItemSkeletonContent"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_gap_32"
                    android:layout_marginTop="@dimen/item_gap_16"
                    android:layout_marginBottom="@dimen/item_gap_8"
                    android:layout_marginStart="@dimen/item_gap_16"
                    android:layout_marginEnd="@dimen/item_gap_24"
                    style="@style/FBShimmerItem"/>
                <include layout="@layout/skeleton_stream_item"/>
                <include layout="@layout/skeleton_stream_item"/>
                <include layout="@layout/skeleton_stream_item"/>
                <include layout="@layout/skeleton_stream_item"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFragmentStreamMain"
            android:tag="binding_2"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <ProgressBar
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-7dp"
            android:layout_marginBottom="-7dp"
            android:indeterminate="true"
            style="?android:attr/progressBarStyleHorizontal"/>
        <com.google.android.material.card.MaterialCardView
            android:layout_gravity="center_horizontal"
            android:id="@+id/parentStreamHeaderNewPostAvailableIndicator"
            android:tag="binding_3"
            android:background="?attr/themeColorSurfaceDefault"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/clickable_size_32"
            android:layout_marginTop="@dimen/item_gap_l"
            android:alpha="0"
            android:translationY="-16dp"
            app:cardBackgroundColor="?attr/themeColorSurfaceDefault"
            app:cardCornerRadius="@dimen/item_gap_l"
            app:cardElevation="@dimen/item_gap_null"
            app:strokeColor="?attr/titleTextColorLowgray"
            app:strokeWidth="@dimen/item_gap_xxxs">
            <TextView
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackground"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingTop="@dimen/item_gap_s"
                android:paddingRight="@dimen/item_gap_l"
                android:paddingBottom="@dimen/item_gap_s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_new_update_available"
                android:layout_centerInParent="true"
                style="@style/SbTextView.StreamListContent"/>
        </com.google.android.material.card.MaterialCardView>
        <com.stockbit.component.tooltip.SbContainerTooltip
            android:id="@+id/tooltipContainerStreamTrending"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/compose_view_emoji_reactions_dialog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
