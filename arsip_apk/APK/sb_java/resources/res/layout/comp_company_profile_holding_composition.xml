<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_parent_holding_composition"
    android:tag="layout/comp_company_profile_holding_composition_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_holding_composition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_18"
        android:text="@string/title_company_profile_holding_composition"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingRegular"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/iv_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/item_gap_6"
        app:layout_constraintBottom_toBottomOf="@+id/tv_holding_composition"
        app:layout_constraintStart_toEndOf="@+id/tv_holding_composition"
        app:layout_constraintTop_toTopOf="@+id/tv_holding_composition"
        app:srcCompat="@drawable/ic_info"/>
    <ViewFlipper
        android:id="@+id/vf_holding_composition_chart"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_holding_composition"
        app:layout_constraintVertical_bias="0">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/composeViewWebContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/item_gap_6"
                android:layout_marginBottom="@dimen/spacing_20"
                android:minHeight="@dimen/height_340"
                android:layout_marginHorizontal="@dimen/item_gap_20"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:id="@+id/pb_wv_chart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_wv_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/item_gap_16">
            <ImageView
                android:id="@+id/iv_error_wv_chart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/item_gap_30"
                app:srcCompat="?attr/themeIconNetworkErrorInternalServer"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="?attr/themeColorTextPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/item_gap_8"
                android:text="@string/uikit_generic_network_error_title_internal_server"
                android:fontFamily="@font/bitsans_bold"
                style="@style/TypeStyles.HeadingRegular"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="?attr/themeColorTextSecondary"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/item_gap_20"
                android:text="@string/uikit_generic_network_error_desc_internal_server"
                android:fontFamily="@font/bitsans_regular"
                style="@style/TypeStyles.BodyXSmall"/>
            <com.stockbit.uikit.buttons.EllipseButton
                android:textSize="@dimen/text_button_dialog"
                android:textColor="@color/white"
                android:id="@+id/btn_try_again"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/height_40"
                android:text="@string/common_try_again_en"
                android:textAllCaps="false"
                android:fontFamily="@font/bitsans_bold"/>
        </LinearLayout>
    </ViewFlipper>
    <View
        android:id="@+id/v_holding_number_separator"
        android:background="?attr/themeColorDividerThick"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_8"
        app:layout_constraintTop_toBottomOf="@+id/vf_holding_composition_chart"
        app:layout_goneMarginTop="@dimen/item_gap_18"/>
</androidx.constraintlayout.widget.ConstraintLayout>
