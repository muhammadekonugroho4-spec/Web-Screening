<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_screener_preset_detail_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_screener_preset"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_scrollFlags="enterAlways|scroll"
        style="@style/Sb.Widget.AppBar"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/ns_screener_preset"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_preset_category"
                android:layout_width="@dimen/width_64"
                android:layout_height="@dimen/height_64"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_size_18"
                android:id="@+id/tv_preset_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_8"
                app:layout_constraintEnd_toEndOf="@+id/iv_preset_category"
                app:layout_constraintStart_toStartOf="@+id/iv_preset_category"
                app:layout_constraintTop_toBottomOf="@+id/iv_preset_category"
                style="@style/SbTextView.BodyDefault.Bold"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_preset_list"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_24"
                android:text="@string/title_screener_preset_list"
                android:layout_marginStart="@dimen/item_gap_20"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_preset_category"
                style="@style/SbTextView.BodyDefault.Bold"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/highgray_light"
                android:id="@+id/tv_preset_count"
                android:background="@drawable/bg_rounded_20_transparent_downgray"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/item_gap_20"
                android:paddingHorizontal="@dimen/item_gap_12"
                android:paddingVertical="@dimen/item_gap_6"
                app:layout_constraintBottom_toBottomOf="@+id/tv_preset_list"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_preset_list"
                style="@style/SbTextView.BodyDefault"/>
            <androidx.recyclerview.widget.RecyclerView
                android:orientation="vertical"
                android:id="@+id/rv_screener_preset_child"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_12"
                android:layout_marginBottom="@dimen/height_100"
                android:nestedScrollingEnabled="false"
                android:layout_marginHorizontal="@dimen/item_gap_20"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintTop_toBottomOf="@+id/tv_preset_count"/>
            <include
                android:id="@+id/layout_skeleton_preset_detail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/layout_skeleton_screener_preset_detail"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/group_preset_data"
                android:tag="binding_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="iv_preset_category,tv_preset_category,tv_preset_list,tv_preset_count,rv_screener_preset_child"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
