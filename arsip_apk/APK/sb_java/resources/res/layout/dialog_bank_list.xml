<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.midtrans.sdk.uikit.widgets.DefaultTextView
        android:textSize="@dimen/header_text_size"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/bank_list_title"
        android:padding="@dimen/twenty_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <View
        android:background="@color/gray_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/one_dp"
        android:layout_below="@+id/bank_list_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/bank_list_items"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bank_list_ok"
        android:layout_below="@+id/bank_list_title"/>
    <View
        android:background="@color/gray_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/one_dp"
        android:layout_above="@+id/bank_list_ok"/>
    <com.midtrans.sdk.uikit.widgets.DefaultTextView
        android:textSize="@dimen/primary_text_size"
        android:textStyle="bold"
        android:textColor="@color/colorPrimary"
        android:gravity="center"
        android:id="@+id/bank_list_ok"
        android:padding="@dimen/twelve_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ok"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
