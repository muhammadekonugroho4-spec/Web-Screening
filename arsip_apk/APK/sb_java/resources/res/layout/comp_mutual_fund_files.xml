<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_mutual_fund_prospectur_and_fund_sheet"
    android:tag="layout/comp_mutual_fund_files_0"
    android:background="@drawable/bg_border_gray_rounded_outline"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/item_gap_l"
    android:layout_marginRight="@dimen/item_gap_l"
    android:layout_marginBottom="@dimen/item_gap_l">
    <TextView
        android:id="@+id/tv_document"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Dokumen"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingLarge"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_prospektus"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingVertical="12.5dp"
        app:layout_constraintEnd_toStartOf="@+id/ll_fund_fact"
        app:layout_constraintStart_toStartOf="@+id/tv_document"
        app:layout_constraintTop_toBottomOf="@+id/tv_document">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            app:srcCompat="@drawable/ic_document"
            app:tint="?attr/themeColorTextGreen"/>
        <TextView
            android:textColor="?attr/themeColorTextGreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_prospectus"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            style="@style/TypeStyles.BodyRegular"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_fund_fact"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingVertical="12.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ll_prospektus"
        app:layout_constraintTop_toTopOf="@+id/ll_prospektus">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            app:srcCompat="@drawable/ic_document"
            app:tint="?attr/themeColorTextGreen"/>
        <TextView
            android:textColor="?attr/themeColorTextGreen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/lbl_fund_fact_sheet"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            style="@style/TypeStyles.BodyRegular"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
