<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer"
    android:tag="layout/layout_skeleton_screener_preset_detail_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shimmer_auto_start="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/item_gap_21">
        <View
            android:id="@+id/v_image"
            android:background="@drawable/bg_circle"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:backgroundTint="?attr/themeShimmer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/v_title"
            android:background="@drawable/bg_rounded_gray"
            android:layout_width="@dimen/width_100"
            android:layout_height="@dimen/height_16"
            android:layout_marginTop="@dimen/item_gap_8"
            android:backgroundTint="?attr/themeShimmer"
            app:layout_constraintEnd_toEndOf="@+id/v_image"
            app:layout_constraintStart_toStartOf="@+id/v_image"
            app:layout_constraintTop_toBottomOf="@+id/v_image"/>
        <View
            android:id="@+id/v_subtitle"
            android:background="@drawable/bg_rounded_gray"
            android:layout_width="61dp"
            android:layout_height="16dp"
            android:layout_marginTop="38dp"
            android:backgroundTint="?attr/themeShimmer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_title"/>
        <include
            android:id="@+id/skeleton_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_25"
            app:layout_constraintTop_toBottomOf="@+id/v_subtitle"
            layout="@layout/skeleton_item_preset"/>
        <include
            android:id="@+id/skeleton_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_25"
            app:layout_constraintTop_toBottomOf="@+id/skeleton_1"
            layout="@layout/skeleton_item_preset"/>
        <include
            android:id="@+id/skeleton_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_25"
            app:layout_constraintTop_toBottomOf="@+id/skeleton_2"
            layout="@layout/skeleton_item_preset"/>
        <include
            android:id="@+id/skeleton_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_25"
            app:layout_constraintTop_toBottomOf="@+id/skeleton_3"
            layout="@layout/skeleton_item_preset"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
