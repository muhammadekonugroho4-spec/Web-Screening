<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/FBShimmerFrameLayout">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/FBShimmerFrameLayout">
        <RelativeLayout
            android:paddingTop="@dimen/item_gap_24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/viewCompanyItemSkeletonSearch"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_22"
                android:layout_marginHorizontal="@dimen/item_gap_20"
                style="@style/FBShimmerItem"/>
            <View
                android:id="@+id/viewCompanyItemSkeletonAvatar"
                android:layout_width="@dimen/clickable_size_74"
                android:layout_height="@dimen/clickable_size_74"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_below="@+id/viewCompanyItemSkeletonSearch"
                android:layout_marginStart="@dimen/item_gap_36"
                style="@style/FBShimmerItem.Circular"/>
            <View
                android:id="@+id/viewCompanyItemSkeletonUsername"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_19"
                android:layout_toRightOf="@+id/viewCompanyItemSkeletonAvatar"
                android:layout_alignTop="@+id/viewCompanyItemSkeletonAvatar"
                android:layout_marginStart="24dp"
                android:layout_toEndOf="@+id/viewCompanyItemSkeletonAvatar"
                android:layout_alignEnd="@+id/viewCompanyItemSkeletonSearch"
                style="@style/FBShimmerItem"/>
            <View
                android:id="@+id/viewCompanyItemSkeletonDate"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_19"
                android:layout_marginTop="@dimen/item_gap_8"
                android:layout_below="@+id/viewCompanyItemSkeletonUsername"
                android:layout_alignStart="@+id/viewCompanyItemSkeletonUsername"
                android:layout_alignEnd="@+id/viewCompanyItemSkeletonUsername"
                style="@style/FBShimmerItem"/>
            <View
                android:id="@+id/viewCompanyItemSkeletonDate3"
                android:layout_width="@dimen/width_100"
                android:layout_height="@dimen/height_19"
                android:layout_marginTop="@dimen/item_gap_8"
                android:layout_below="@+id/viewCompanyItemSkeletonDate"
                android:layout_alignStart="@+id/viewCompanyItemSkeletonDate"
                style="@style/FBShimmerItem"/>
            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_4"
                android:layout_marginTop="@dimen/item_gap_24"
                android:layout_below="@+id/viewCompanyItemSkeletonAvatar"
                style="@style/FBShimmerItem"/>
            <View
                android:id="@+id/viewCompanyItemSkeletonContent"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_22"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_below="@+id/divider"
                android:layout_marginHorizontal="@dimen/item_gap_20"
                style="@style/FBShimmerItem"/>
            <View
                android:id="@+id/viewCompanyItemSkeletonContent2"
                android:layout_width="match_parent"
                android:layout_height="205dp"
                android:layout_marginTop="@dimen/item_gap_16"
                android:layout_below="@+id/viewCompanyItemSkeletonContent"
                android:layout_marginHorizontal="@dimen/item_gap_20"
                style="@style/FBShimmerItem.Large"/>
            <View
                android:id="@+id/divider2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_4"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_below="@+id/viewCompanyItemSkeletonContent2"
                style="@style/FBShimmerItem"/>
            <View
                android:id="@+id/viewCompanyItemSkeletonContent3"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_22"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_below="@+id/divider2"
                android:layout_marginHorizontal="@dimen/item_gap_20"
                style="@style/FBShimmerItem"/>
            <View
                android:id="@+id/viewCompanyItemSkeletonContent4"
                android:layout_width="match_parent"
                android:layout_height="205dp"
                android:layout_marginTop="@dimen/item_gap_16"
                android:layout_below="@+id/viewCompanyItemSkeletonContent3"
                android:layout_marginHorizontal="@dimen/item_gap_20"
                style="@style/FBShimmerItem.Large"/>
            <View
                android:id="@+id/divider3"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_12"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_below="@+id/viewCompanyItemSkeletonContent4"
                style="@style/FBShimmerItem"/>
        </RelativeLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_last_update"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_31"
        android:layout_marginBottom="@dimen/item_gap_48"
        android:text="@string/title_shimmer_update_analyst"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
</LinearLayout>
