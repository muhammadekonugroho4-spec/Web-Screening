<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:tag="layout/comp_error_and_empty_plan_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_icon_error_plan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="?attr/themeIconTradingCommunityNetworkError"/>
    <TextView
        android:id="@+id/tv_title_error_plan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_24"
        android:text="@string/error_message_no_connection"
        style="@style/TypeStyles.HeadlineRegular"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="center"
        android:id="@+id/tv_description_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="@string/error_message_no_connection_subtitle"
        android:layout_marginHorizontal="@dimen/spacing_20"
        style="@style/TypeStyles.BodyRegular"/>
    <com.stockbit.uikit.button.EllipseButton
        android:id="@+id/pb_button_reload"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_24"
        android:text="@string/btn_tap_to_reload"
        app:cornerRadius="@dimen/spacing_20"
        app:primaryButtonColor="green"/>
</LinearLayout>
