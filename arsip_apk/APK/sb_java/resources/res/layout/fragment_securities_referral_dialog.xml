<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_securities_referral_dialog_0"
    android:background="?attr/themeDialogBackgroundColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
        <RelativeLayout
            android:id="@+id/rl_separator_dialog"
            android:background="@drawable/bg_top_rounded"
            android:paddingTop="@dimen/item_gap_20"
            android:paddingBottom="@dimen/item_gap_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@drawable/bg_rounded_gray_gray_bg"
                android:layout_width="@dimen/clickable_size_38"
                android:layout_height="@dimen/item_gap_s"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="@dimen/item_gap_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl_separator_dialog"
            android:paddingStart="@dimen/item_gap_20"
            android:paddingEnd="@dimen/item_gap_20">
            <ImageView
                android:id="@+id/iv_content"
                android:layout_width="@dimen/clickable_size_96"
                android:layout_height="@dimen/clickable_size_96"
                android:layout_marginTop="@dimen/item_gap_24"
                android:src="@drawable/ic_registration_complete"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/text_size_18"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_16"
                android:text="@string/oa_success_register_title"
                android:lineSpacingExtra="@dimen/item_gap_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_content"
                style="@style/TypeStyles.HeadingRegular"/>
            <TextView
                android:gravity="center_horizontal"
                android:id="@+id/tv_referral_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_24"
                android:text="@string/oa_referral_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"
                style="@style/SbTextView.ListSubtitle.Highempasis.Bold"/>
            <TextView
                android:id="@+id/tv_referral_label_optional"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/oa_referral_label_optional"
                android:layout_marginStart="@dimen/item_gap_4"
                app:layout_constraintStart_toEndOf="@+id/tv_referral_label"
                app:layout_constraintTop_toTopOf="@+id/tv_referral_label"
                style="@style/SbTextView.ListSubtitle.Highempasis"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:textSize="@dimen/text_size_14"
                android:id="@+id/et_referral_code"
                android:background="@null"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_12"
                android:hint="@string/oa_referral_label_input_hint"
                android:singleLine="true"
                android:maxLength="@integer/referral_code_length"
                android:layout_marginEnd="@dimen/item_gap_91"
                app:layout_constraintBottom_toTopOf="@+id/view_underline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_referral_label"
                style="@style/SbEditTextStyle.Medium"/>
            <View
                android:id="@+id/view_underline"
                android:background="?attr/titleTextColorLowgray"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/item_gap_10"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/et_referral_code"
                app:layout_constraintTop_toBottomOf="@+id/et_referral_code"/>
            <TextView
                android:textSize="@dimen/text_size_14"
                android:textColor="@color/green_text"
                android:id="@+id/tv_use"
                android:tag="binding_1"
                android:layout_width="wrap_content"
                android:layout_height="25dp"
                android:text="@string/oa_button_use"
                android:paddingStart="@dimen/item_gap_16"
                android:paddingEnd="@dimen/item_gap_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/et_referral_code"
                style="@style/SbTextView.ListTitle.Highempasis.Bold"/>
            <ProgressBar
                android:tag="binding_2"
                android:layout_width="@dimen/clickable_size_24"
                android:layout_height="@dimen/clickable_size_24"
                android:layout_marginEnd="@dimen/item_gap_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/et_referral_code"/>
            <TextView
                android:id="@+id/tv_referral_success_label"
                android:tag="binding_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_4"
                android:text="@string/oa_used_referral_from"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_underline"
                style="@style/SbTextView.BodyDefault"/>
            <TextView
                android:ellipsize="end"
                android:id="@+id/tv_referral_success_user"
                android:tag="binding_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_4"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:layout_marginStart="@dimen/item_gap_4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_referral_success_label"
                app:layout_constraintTop_toBottomOf="@+id/view_underline"
                style="@style/SbTextView.BodyDefault.Bold"/>
            <TextView
                android:textColor="@color/bg_red_warning_dark"
                android:id="@+id/tv_referral_error_label"
                android:tag="binding_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_4"
                android:text="@string/oa_referral_label_error_not_found"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_underline"
                style="@style/SbTextView.BodyDefault"/>
            <Button
                android:textColor="@color/white"
                android:id="@+id/btn_done"
                android:background="@drawable/btn_empty_green_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/clickable_size_40"
                android:layout_marginTop="@dimen/item_gap_44"
                android:text="@string/btn_positive_oke"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_referral_error_label"
                style="@style/SbBtn"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
</androidx.core.widget.NestedScrollView>
