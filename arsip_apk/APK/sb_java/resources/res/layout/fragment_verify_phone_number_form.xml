<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_verify_phone_number_form_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stockbit.uikit.topbar.TopbarStockbitTitle
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:topBarTitleFourthIcon="?attr/themeIconLiveSupport"
        app:topBarTitleTitle="@string/personal_amend_title_change_phone_number"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_36"
        android:src="?attr/themeIconSmsOtpBadge"
        android:layout_marginHorizontal="@dimen/spacing_20"/>
    <TextView
        android:textSize="@dimen/text_size_18"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:text="@string/personal_amend_title_input_phone_number"
        android:lineSpacingExtra="-2sp"
        android:translationY="-1.04sp"
        android:textAlignment="gravity"
        android:layout_marginHorizontal="@dimen/spacing_20"
        android:lineHeight="24sp"
        style="@style/TypeStyles.HeadlineRegular"/>
    <com.stockbit.uikit.input.InputPhoneLine
        android:id="@+id/sfPhoneNumberNew"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:layout_marginHorizontal="@dimen/spacing_20"
        app:phoneHint="@string/personal_amend_title_input_phone_number"
        app:phoneLabel="@string/personal_amend_title_input_phone_number"/>
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <com.stockbit.uikit.buttons.PrimaryButton
        android:id="@+id/slb_change_phone"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        android:text="@string/next"
        app:layout_constraintBottom_toBottomOf="parent"/>
</LinearLayout>
