<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_unboxing_reader_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.github.barteksc.pdfviewer.PDFView
        android:id="@+id/pv_unboxing_reader"
        android:tag="binding_1"
        android:background="@color/component_dark"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/pb_unboxing_reader"
        android:tag="binding_2"
        android:layout_width="@dimen/clickable_size_24"
        android:layout_height="@dimen/clickable_size_24"
        android:indeterminate="true"
        android:layout_marginVertical="@dimen/width_92"
        app:indicatorColor="@color/green_text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:trackColor="?attr/themeSeparatorGapColorSecondary"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_unboxing_reader_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.stockbit.common.uikit.TextIndicator
            android:textSize="@dimen/text_size_16"
            android:textStyle="bold"
            android:textColor="@color/midgray_dark"
            android:id="@+id/ti_unboxing_reader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:translationY="-64dp"
            android:layout_marginStart="@dimen/item_gap_16"
            app:layout_constraintBottom_toBottomOf="@+id/iv_close_unboxing_reader"
            app:layout_constraintStart_toEndOf="@+id/iv_close_unboxing_reader"
            app:layout_constraintTop_toTopOf="@+id/iv_close_unboxing_reader"
            style="@style/TypeStyles.HeadingLarge"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_close_unboxing_reader"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/item_gap_28"
            android:layout_height="@dimen/item_gap_28"
            android:layout_marginTop="@dimen/item_gap_16"
            android:contentDescription="@string/hint_close"
            android:alpha="0"
            android:translationY="-64dp"
            android:layout_marginStart="@dimen/item_gap_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_mediaviewer_circle_close"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_jump_to_unboxing_reader"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/item_gap_28"
            android:layout_height="@dimen/item_gap_28"
            android:layout_marginTop="@dimen/item_gap_16"
            android:contentDescription="@string/hint_close"
            android:alpha="0"
            android:translationY="-64dp"
            android:layout_marginEnd="@dimen/item_gap_12"
            app:layout_constraintEnd_toStartOf="@+id/iv_download_unboxing_reader"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_circle_tile"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_download_unboxing_reader"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/item_gap_28"
            android:layout_height="@dimen/item_gap_28"
            android:layout_marginTop="@dimen/item_gap_16"
            android:contentDescription="@string/hint_close"
            android:alpha="0"
            android:translationY="-64dp"
            android:layout_marginEnd="@dimen/item_gap_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_circle_download"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
