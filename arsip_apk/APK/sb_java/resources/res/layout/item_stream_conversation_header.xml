<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/parentStreamItemMainPostRoot"
    android:tag="layout/item_stream_conversation_header_0"
    android:focusable="false"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <TextView
        android:textColor="@color/gray_text"
        android:gravity="center"
        android:id="@+id/tv_deleted_note"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_72"
        android:text="@string/msg_stream_post_deleted"
        style="@style/SbTextView.StreamListContent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_content"
        android:tag="binding_1"
        android:paddingBottom="@dimen/spacing_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/stream_user_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_10"
            android:layout_marginStart="@dimen/spacing_20"
            layout="@layout/comp_stream_user_profile"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/parentStreamItemMainPostContent"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/item_gap_20">
            <include
                android:id="@+id/stream_news"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_10"
                layout="@layout/comp_content_news"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_view_summary"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_10"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/stream_post_item_content_text_size"
                android:ellipsize="end"
                android:id="@+id/tvItemFeedStreamText"
                android:paddingTop="@dimen/item_gap_s"
                android:paddingBottom="@dimen/item_gap_s"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/TypeStyles.BodyLarge"/>
        </LinearLayout>
        <include
            android:id="@+id/stream_youtube"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_10"
            layout="@layout/comp_stream_content_youtube"/>
        <include
            android:id="@+id/stream_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_10"
            layout="@layout/comp_stream_content_image"/>
        <include
            android:id="@+id/stream_attachment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_10"
            android:layout_marginHorizontal="@dimen/spacing_20"
            layout="@layout/comp_stream_content_attachment"/>
        <include
            android:id="@+id/comp_conversation_target_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_10"
            android:layout_marginHorizontal="@dimen/spacing_20"
            layout="@layout/comp_stream_target_price"/>
        <include
            android:id="@+id/stream_polling"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_10"
            android:layout_marginHorizontal="@dimen/spacing_20"
            layout="@layout/comp_stream_polling"/>
        <include
            android:id="@+id/stream_share_trade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_10"
            android:layout_marginHorizontal="@dimen/spacing_20"
            layout="@layout/comp_stream_share_trade"/>
        <include
            android:id="@+id/stream_reposted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_10"
            android:layout_marginHorizontal="@dimen/spacing_20"
            layout="@layout/comp_stream_reposted"/>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/compose_view_stream_emoji_reaction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardViewConversationSincePostedRoot"
            android:tag="binding_3"
            android:background="?attr/themeColorSurfaceDefault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginHorizontal="@dimen/item_gap_20"
            app:cardBackgroundColor="?attr/themeColorSurfaceDefault"
            app:cardCornerRadius="@dimen/shape_radius_m"
            app:cardElevation="@dimen/item_gap_null">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/bar_value"
                    android:tag="binding_4"
                    android:background="@color/gray_text"
                    android:layout_width="@dimen/item_gap_8"
                    android:layout_height="@dimen/clickable_size_64"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/parentConversationSincePostedRoot"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/clickable_size_64"
                    android:layout_weight="1"
                    android:paddingStart="@dimen/item_gap_8"
                    android:paddingEnd="@dimen/item_gap_16">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/txt_symbol_title"
                        android:tag="binding_5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:layout_marginEnd="@dimen/item_gap_8"
                        app:layout_constraintBottom_toTopOf="@+id/txt_price_change"
                        app:layout_constraintEnd_toStartOf="@+id/tvConversationSincePostedThenLabel"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"
                        style="@style/TypeStyles.HeadingRegular"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textColor="@color/green_text"
                        android:id="@+id/txt_price_change"
                        android:tag="binding_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_xs"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/txt_symbol_title"
                        app:layout_constraintTop_toBottomOf="@+id/txt_symbol_title"
                        style="@style/TypeStyles.BodySmall"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/txt_then_value"
                        android:tag="binding_7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBaseline_toBaselineOf="@+id/txt_symbol_title"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TypeStyles.HeadingSmall"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/txt_now_value"
                        android:tag="binding_8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_xs"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/txt_then_value"
                        style="@style/TypeStyles.HeadingSmall"/>
                    <androidx.constraintlayout.widget.Barrier
                        android:id="@+id/barrierConversationSincePostedThenNowValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:barrierDirection="start"
                        app:constraint_referenced_ids="txt_then_value,txt_now_value"/>
                    <TextView
                        android:id="@+id/tvConversationSincePostedThenLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/item_gap_s"
                        android:text="Then:"
                        app:layout_constraintBaseline_toBaselineOf="@+id/txt_then_value"
                        app:layout_constraintRight_toLeftOf="@+id/barrierConversationSincePostedThenNowValue"
                        style="@style/TypeStyles.BodySmall"/>
                    <TextView
                        android:id="@+id/tvConversationSincePostedNowLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/item_gap_s"
                        android:text="Now:"
                        app:layout_constraintBaseline_toBaselineOf="@+id/txt_now_value"
                        app:layout_constraintRight_toLeftOf="@+id/barrierConversationSincePostedThenNowValue"
                        style="@style/TypeStyles.BodySmall"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:tag="binding_9"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginHorizontal="@dimen/item_gap_20"
            app:cardBackgroundColor="?attr/themeColorSurfaceVariant"
            app:cardCornerRadius="@dimen/item_gap_4"
            app:cardElevation="0dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_icon_caution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/item_gap_23"
                    android:layout_marginVertical="@dimen/item_gap_20"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_comment_limit_info_24dp"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/title_limit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_16"
                    android:text="@string/title_stream_comment_limit"
                    android:layout_marginStart="@dimen/item_gap_16"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_icon_caution"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TypeStyles.Secondary.Bold"/>
                <TextView
                    android:id="@+id/tv_desc_limit"
                    android:tag="binding_10"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/item_gap_16"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_icon_caution"
                    app:layout_constraintTop_toBottomOf="@+id/title_limit"
                    app:layout_constraintVertical_bias="0.18"
                    style="@style/TypeStyles.BodySmall"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <Button
        android:textSize="@dimen/default_text_size"
        android:textColor="@color/green_text"
        android:gravity="start|center_vertical"
        android:id="@+id/btnConversationHeaderLoadPrevComments"
        android:background="@drawable/bg_list_selector"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        android:minHeight="0dp"
        android:text="@string/btn_view_previous_comments"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        style="@style/SbBtnBorderless.Default"/>
    <ProgressBar
        android:theme="@style/CircularProgress"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/pbConversationHeaderLoadingPrevComments"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="@dimen/clickable_size_24"
        android:layout_height="@dimen/clickable_size_48"
        style="@style/Widget.AppCompat.ProgressBar"/>
</LinearLayout>
