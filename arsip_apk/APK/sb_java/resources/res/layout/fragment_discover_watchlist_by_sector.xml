<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_discover_watchlist_by_sector_0"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/abl_discover_watchlist_by_sector"
        android:tag="binding_1"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/toolbar"
            layout="@layout/comp_toolbar_discover_watchlist"/>
    </com.google.android.material.appbar.AppBarLayout>
    <include
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_height_m"
        android:layout_below="@+id/abl_discover_watchlist_by_sector"
        layout="@layout/comp_search_bar_discover_watchlist"/>
    <View
        android:id="@+id/viewFragmentDiscoverWatchlistBySector"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_below="@+id/search_bar"/>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayoutFragmentDiscoverWatchlistBySector"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/viewFragmentDiscoverWatchlistBySector">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFragmentDiscoverWatchlistBySector"
            android:tag="binding_3"
            android:paddingBottom="@dimen/item_gap_l"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</RelativeLayout>
