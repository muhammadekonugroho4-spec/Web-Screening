<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_error"
    android:tag="layout/comp_empty_state_target_list_initial_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/item_gap_20">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_20"
        app:srcCompat="@drawable/ic_empty_target_list"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_8"
        android:text="@string/text_target_list_on_empty_initial_message"
        android:textAlignment="center"
        android:layout_marginHorizontal="@dimen/spacing_20"
        style="@style/TypeStyles.BodyRegular"/>
</LinearLayout>
