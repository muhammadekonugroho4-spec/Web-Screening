<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_company_item_container"
    android:tag="layout/item_font_size_watchlist_medium_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:paddingTop="@dimen/spacing_8"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:elevation="@dimen/item_gap_s">
    <ImageView
        android:id="@+id/iv_company_logo"
        android:layout_width="@dimen/item_gap_32"
        android:layout_height="@dimen/item_gap_32"
        android:layout_marginBottom="@dimen/spacing_8"
        android:layout_marginStart="@dimen/item_gap_20"
        app:layout_constraintBottom_toTopOf="@+id/v_separator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rl_company_symbol_badge_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/img_min_width"
        android:layout_marginStart="@dimen/spacing_8"
        app:layout_constraintBottom_toTopOf="@+id/tv_name"
        app:layout_constraintStart_toEndOf="@+id/iv_company_logo"
        app:layout_constraintTop_toTopOf="@+id/iv_company_logo"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintVertical_chainStyle="spread"
        app:layout_goneMarginStart="@dimen/item_gap_20">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:id="@+id/tv_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="22dp"
            android:singleLine="true"
            android:paddingEnd="@dimen/item_gap_3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingLarge"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="16dp"
        android:singleLine="true"
        android:layout_below="@+id/rl_company_symbol_badge_container"
        android:layout_marginStart="@dimen/item_gap_8"
        android:layout_marginEnd="@dimen/item_gap_8"
        app:layout_constraintBottom_toBottomOf="@+id/iv_company_logo"
        app:layout_constraintEnd_toStartOf="@+id/lc_company"
        app:layout_constraintStart_toEndOf="@+id/iv_company_logo"
        app:layout_constraintTop_toBottomOf="@+id/rl_company_symbol_badge_container"
        app:layout_goneMarginStart="@dimen/item_gap_20"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/lc_company"
        android:visibility="gone"
        android:layout_width="@dimen/width_60"
        android:layout_height="@dimen/height_32"
        android:minWidth="@dimen/width_60"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cv_price_container"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_price_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/width_104"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/item_gap_14"
        app:cardBackgroundColor="?attr/themeColorSurfaceDefault"
        app:cardCornerRadius="@dimen/shape_radius_s"
        app:cardElevation="@dimen/item_gap_null"
        app:layout_constraintBottom_toBottomOf="@+id/tv_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rl_company_symbol_badge_container">
        <LinearLayout
            android:gravity="end"
            android:layout_gravity="end|center_vertical"
            android:orientation="vertical"
            android:id="@+id/ll_price_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/width_104"
            android:paddingVertical="@dimen/item_gap_6">
            <TextView
                android:textSize="@dimen/text_size_18"
                android:gravity="end"
                android:id="@+id/tv_last_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/item_gap_66"
                android:minHeight="22dp"
                android:singleLine="true"
                android:textAlignment="gravity"
                android:paddingStart="@dimen/item_gap_s"
                android:paddingEnd="@dimen/item_gap_6"
                style="@style/TypeStyles.HeadingLarge"/>
            <TextView
                android:textSize="@dimen/text_size_15"
                android:gravity="end"
                android:id="@+id/tv_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_null"
                android:minWidth="@dimen/item_gap_91"
                android:minHeight="19dp"
                android:singleLine="true"
                android:textAlignment="gravity"
                android:paddingEnd="@dimen/item_gap_6"
                style="@style/TypeStyles.BodyRegular"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <View
        android:id="@+id/v_separator"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
