<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:paddingBottom="@dimen/sixteen_dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <com.midtrans.sdk.uikit.widgets.DefaultTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TokenNotification"/>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/container_card_number"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/sixteen_dp"
        android:layout_marginTop="@dimen/sixteen_dp"
        android:layout_marginRight="@dimen/sixteen_dp">
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/edit_card_number"
            android:nextFocusDown="@+id/edit_challenge_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_mandiri_debit_card_no"
            android:maxLines="1"
            android:maxLength="19"
            android:digits="0123456789 "
            android:inputType="number"
            android:imeOptions="actionNext"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/container_challenge_token"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/sixteen_dp"
        android:layout_marginTop="@dimen/eight_dp"
        android:layout_marginRight="@dimen/sixteen_dp">
        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/edit_challenge_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_challenge_token"
            android:maxLines="1"
            android:maxLength="6"
            android:inputType="number"/>
    </com.google.android.material.textfield.TextInputLayout>
    <androidx.core.widget.NestedScrollView
        android:background="@android:color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:paddingBottom="@dimen/eight_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/sixteen_dp"
                android:layout_marginTop="@dimen/sixteen_dp"
                android:layout_marginRight="@dimen/sixteen_dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eight_dp">
                    <com.midtrans.sdk.uikit.widgets.DefaultTextView
                        android:textSize="@dimen/secondary_text_size"
                        android:textColor="@color/dark_gray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/appli"/>
                    <com.midtrans.sdk.uikit.widgets.DefaultTextView
                        android:textSize="@dimen/secondary_text_size"
                        android:textColor="@color/dark_gray"
                        android:gravity="end"
                        android:layout_gravity="end"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/text_three"
                        android:layout_weight="1"/>
                </LinearLayout>
                <View
                    android:background="@color/dark_gray"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/eight_dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eight_dp">
                    <com.midtrans.sdk.uikit.widgets.DefaultTextView
                        android:textSize="@dimen/secondary_text_size"
                        android:textColor="@color/dark_gray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/input_1"/>
                    <com.midtrans.sdk.uikit.widgets.DefaultTextView
                        android:textSize="@dimen/secondary_text_size"
                        android:textColor="@color/dark_gray"
                        android:gravity="end"
                        android:id="@+id/text_input_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/text_input_one_here"
                        android:layout_weight="1"/>
                </LinearLayout>
                <View
                    android:background="@color/dark_gray"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/eight_dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eight_dp">
                    <com.midtrans.sdk.uikit.widgets.DefaultTextView
                        android:textSize="@dimen/secondary_text_size"
                        android:textColor="@color/dark_gray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/input_2"/>
                    <com.midtrans.sdk.uikit.widgets.DefaultTextView
                        android:textSize="@dimen/secondary_text_size"
                        android:textColor="@color/dark_gray"
                        android:gravity="end"
                        android:id="@+id/text_input_2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/text_input_two_here"
                        android:layout_weight="1"/>
                </LinearLayout>
                <View
                    android:background="@color/dark_gray"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/eight_dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/eight_dp">
                    <com.midtrans.sdk.uikit.widgets.DefaultTextView
                        android:textSize="@dimen/secondary_text_size"
                        android:textColor="@color/dark_gray"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/input_3"/>
                    <com.midtrans.sdk.uikit.widgets.DefaultTextView
                        android:textSize="@dimen/secondary_text_size"
                        android:textColor="@color/dark_gray"
                        android:gravity="end"
                        android:id="@+id/text_input_3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/text_input_three_here"
                        android:layout_weight="1"/>
                </LinearLayout>
                <View
                    android:background="@color/dark_gray"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/eight_dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatButton
                    android:gravity="center_vertical"
                    android:id="@+id/instruction_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/sixteen_dp"
                    android:layout_marginRight="@dimen/sixteen_dp"
                    android:text="@string/show_instruction"
                    style="@style/ButtonSecondaryExpandable"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/instruction_layout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.midtrans.sdk.uikit.widgets.DefaultTextView
                        android:textSize="@dimen/secondary_text_size"
                        android:textColor="@color/black"
                        android:background="@color/light_gray"
                        android:paddingLeft="@dimen/sixteen_dp"
                        android:paddingTop="@dimen/two_dp"
                        android:paddingRight="@dimen/sixteen_dp"
                        android:paddingBottom="@dimen/two_dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mandiri_click_pay_instruction_step1"
                        android:lineSpacingExtra="2dp"/>
                    <com.midtrans.sdk.uikit.widgets.DefaultTextView
                        android:textSize="@dimen/secondary_text_size"
                        android:textColor="@color/black"
                        android:paddingLeft="@dimen/sixteen_dp"
                        android:paddingTop="@dimen/two_dp"
                        android:paddingRight="@dimen/sixteen_dp"
                        android:paddingBottom="@dimen/two_dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mandiri_click_pay_instruction_step2"
                        android:lineSpacingExtra="2dp"/>
                    <com.midtrans.sdk.uikit.widgets.DefaultTextView
                        android:textSize="@dimen/secondary_text_size"
                        android:textColor="@color/black"
                        android:background="@color/light_gray"
                        android:paddingLeft="@dimen/sixteen_dp"
                        android:paddingTop="@dimen/two_dp"
                        android:paddingRight="@dimen/sixteen_dp"
                        android:paddingBottom="@dimen/two_dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mandiri_click_pay_instruction_step3"
                        android:lineSpacingExtra="2dp"/>
                    <com.midtrans.sdk.uikit.widgets.DefaultTextView
                        android:textSize="@dimen/secondary_text_size"
                        android:textColor="@color/black"
                        android:paddingLeft="@dimen/sixteen_dp"
                        android:paddingTop="@dimen/two_dp"
                        android:paddingRight="@dimen/sixteen_dp"
                        android:paddingBottom="@dimen/two_dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mandiri_click_pay_instruction_step4"
                        android:lineSpacingExtra="2dp"/>
                    <com.midtrans.sdk.uikit.widgets.DefaultTextView
                        android:textSize="@dimen/secondary_text_size"
                        android:textColor="@color/black"
                        android:background="@color/light_gray"
                        android:paddingLeft="@dimen/sixteen_dp"
                        android:paddingTop="@dimen/two_dp"
                        android:paddingRight="@dimen/sixteen_dp"
                        android:paddingBottom="@dimen/two_dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mandiri_click_pay_instruction_step5"
                        android:lineSpacingExtra="2dp"/>
                    <com.midtrans.sdk.uikit.widgets.DefaultTextView
                        android:textSize="@dimen/secondary_text_size"
                        android:textColor="@color/black"
                        android:paddingLeft="@dimen/sixteen_dp"
                        android:paddingTop="@dimen/two_dp"
                        android:paddingRight="@dimen/sixteen_dp"
                        android:paddingBottom="@dimen/two_dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mandiri_click_pay_instruction_step6"
                        android:lineSpacingExtra="2dp"/>
                    <com.midtrans.sdk.uikit.widgets.DefaultTextView
                        android:textSize="@dimen/secondary_text_size"
                        android:textColor="@color/black"
                        android:background="@color/light_gray"
                        android:paddingLeft="@dimen/sixteen_dp"
                        android:paddingTop="@dimen/two_dp"
                        android:paddingRight="@dimen/sixteen_dp"
                        android:paddingBottom="@dimen/two_dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/eight_dp"
                        android:text="@string/mandiri_click_pay_instruction_step7"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
