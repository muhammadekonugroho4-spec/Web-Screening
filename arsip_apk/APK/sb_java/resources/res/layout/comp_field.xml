<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_field_0"
    android:paddingBottom="@dimen/item_gap_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center_horizontal"
        android:id="@+id/actv_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SbTextView.FieldTitle.Bold.SemiHigh"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center_horizontal"
        android:id="@+id/actv_optional"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_securities_oa_optional"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/actv_label"
        app:layout_constraintStart_toEndOf="@+id/actv_label"
        app:layout_constraintTop_toTopOf="@+id/actv_label"
        style="@style/SbTextView.FieldTitle.SemiHigh"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_text_input"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actv_label">
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/themeContentTextColor"
            android:gravity="center"
            android:id="@+id/actv_country_code"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableRight="0x7f0804bc"
            android:drawablePadding="@dimen/item_gap_xs"
            android:textAlignment="gravity"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/acet_field"
            app:layout_constraintEnd_toStartOf="@+id/acet_field"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/acet_field"
            style="@style/SbTextView.BodyDefault"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:textColor="?attr/themeContentTextColor"
            android:textColorHint="?attr/titleTextColorSemiMediumHighempasis"
            android:id="@+id/acet_field"
            android:background="@null"
            android:paddingTop="8dp"
            android:paddingBottom="@dimen/item_gap_10"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/setting_change_password_app_enter_new_pass"
            android:includeFontPadding="false"
            android:paddingStart="2dp"
            android:paddingEnd="@dimen/item_gap_8"
            app:layout_constraintBottom_toTopOf="@+id/view_underline"
            app:layout_constraintEnd_toStartOf="@+id/aciv_seen"
            app:layout_constraintStart_toEndOf="@+id/actv_country_code"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SbEditTextStyle"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/aciv_seen"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="0x7f08079d"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/acet_field"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/acet_field"/>
        <View
            android:id="@+id/view_underline"
            android:background="?attr/titleTextColorLowgray"
            android:layout_width="0dp"
            android:layout_height="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/acet_field"
            app:layout_constraintTop_toBottomOf="@+id/acet_field"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_11"
            android:id="@+id/actv_tooltip"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0dp"
            android:layout_marginTop="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_underline"
            style="@style/SbTextView.Caption.Green"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_11"
            android:id="@+id/actv_tooltip_trading"
            android:background="@drawable/bg_tooltip_trading"
            android:paddingTop="@dimen/item_gap_8"
            android:paddingBottom="@dimen/item_gap_8"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0dp"
            android:layout_marginTop="@dimen/item_gap_5"
            android:paddingStart="@dimen/item_gap_12"
            android:paddingEnd="@dimen/item_gap_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_underline"
            style="@style/SbTextView.Caption"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/actv_error"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="0dp"
            android:layout_marginTop="2dp"
            android:drawablePadding="4dp"
            android:drawableStart="@drawable/ic_warning_red"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/actv_tooltip"
            style="@style/SbTextView.InputError"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
