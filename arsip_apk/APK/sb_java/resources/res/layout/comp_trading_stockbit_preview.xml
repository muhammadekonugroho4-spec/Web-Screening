<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/comp_trading_stockbit_preview_0"
    android:background="@drawable/bg_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_trading_confirmation_preview_header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/item_gap_6">
        <TextView
            android:id="@+id/tv_trading_confirmation_preview_header_title"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            style="@style/TypeStyles.HeadingLarge"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_trading_confirmation_preview_content_layout"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/item_gap_12"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/ll_button"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintTop_toBottomOf="@+id/rl_trading_confirmation_preview_header_layout">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_trading_confirmation_preview_content_header_layout"
            android:tag="binding_3"
            android:background="?attr/themeDialogBackgroundColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/rl_trading_confirmation_preview_buy_content_layout"
                layout="@layout/comp_trading_stockbit_preview_buy"/>
            <include
                android:id="@+id/rl_trading_confirmation_preview_sell_content_layout"
                layout="@layout/comp_trading_stockbit_preview_sell"/>
            <include
                android:id="@+id/rl_trading_confirmation_preview_exercise_content_layout"
                layout="@layout/comp_trading_stockbit_preview_exercise"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:layout_marginBottom="@dimen/item_gap_20"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sv_trading_confirmation_preview_content_layout">
        <com.stockbit.uikit.button.SecondaryNeutralButton
            android:id="@+id/btn_trading_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/button_cancel"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/spacing_8"
            app:secondaryNeutralButtonColor="red"
            app:secondaryNeutralButtonPosition="bottomsheet"/>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/sfl_btn_trading_confirmation"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:background="@drawable/bg_shimmer_on_modals"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    style="@style/FBShimmerItem"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <com.stockbit.uikit.buttons.PrimaryButton
            android:id="@+id/btn_trading_confirmation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/confirm"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_8"/>
    </LinearLayout>
    <include
        android:id="@+id/llTradingConfirmationPreviewWithdrawLayout"
        layout="@layout/comp_trading_stockbit_preview_cancel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
