<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/parentCompEmptyDataTradingHistory"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivTradingHistoryEmptyImg"
        android:layout_width="@dimen/avatar_size_xl"
        android:layout_height="@dimen/avatar_size_xl"
        android:layout_marginBottom="@dimen/item_gap_l"
        android:layout_centerHorizontal="true"
        app:srcCompat="@drawable/ic_empty_withdrawal_history"/>
    <TextView
        android:textSize="@dimen/text_size_13"
        android:gravity="center"
        android:id="@+id/tvTradingHistoryTitleEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_l"
        android:layout_marginTop="@dimen/item_gap_20"
        android:layout_marginRight="@dimen/item_gap_l"
        android:layout_marginBottom="@dimen/item_gap_s"
        android:text="@string/empty_withdrawal_history_title"
        android:layout_below="@+id/ivTradingHistoryEmptyImg"
        style="@style/SbTextView.BodySecondary.Bold.Semi"/>
</RelativeLayout>
