<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_virtual_amend_sell_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarTradingSell"
        android:paddingLeft="@dimen/item_gap_null"
        android:paddingRight="@dimen/item_gap_null"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:contentInsetLeft="@dimen/item_gap_null"
        app:contentInsetStart="@dimen/item_gap_null"
        app:contentInsetStartWithNavigation="@dimen/item_gap_null"
        app:elevation="@dimen/item_gap_null">
        <RelativeLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minHeight="?attr/actionBarSize">
            <TextView
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/tvToolbarTitleTradingSell"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/trading_sell_title"
                android:singleLine="true"
                android:layout_centerHorizontal="true"
                android:textAlignment="gravity"
                style="@style/SbTextView.PageTitle"/>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <View
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"/>
    <ViewFlipper
        android:id="@+id/vfFragmentTradingSell"
        android:tag="binding_1"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/sflTradingSellLoading"
            android:paddingTop="@dimen/item_gap_m"
            android:paddingBottom="@dimen/item_gap_l"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include layout="@layout/skeleton_virtual_item_buy"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/nsvLayoutView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:layout_above="@+id/llButtonLayout"
                android:layout_alignParentTop="true"
                android:layout_alignParentStart="true">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.stockbit.common.uikit.StockbitCompanyPrice
                        android:id="@+id/llCompanyInfoLayout"
                        android:tag="binding_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                    <RelativeLayout
                        android:id="@+id/parentTradingNotEnough"
                        android:background="@drawable/border_gray"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/item_gap_l"
                        android:layout_marginRight="@dimen/item_gap_l"
                        android:layout_marginBottom="@dimen/item_gap_s"
                        android:layout_below="@+id/llCompanyInfoLayout">
                        <ImageView
                            android:id="@+id/ivNotEnoughIcon"
                            android:paddingTop="@dimen/item_gap_m"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            app:srcCompat="@drawable/ic_info"/>
                        <TextView
                            android:gravity="center"
                            android:id="@+id/tvTradingNotEnough"
                            android:padding="@dimen/item_gap_s"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/balance_not_enough"
                            android:layout_below="@+id/ivNotEnoughIcon"
                            android:textAlignment="gravity"
                            style="@style/SbTextView.BodyDefault"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/rlTradeSellLayout"
                        android:background="@drawable/border_gray"
                        android:paddingTop="@dimen/item_gap_s"
                        android:paddingBottom="@dimen/item_gap_s"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/parentTradingNotEnough"
                        android:layout_marginStart="@dimen/item_gap_l"
                        android:layout_marginEnd="@dimen/item_gap_l">
                        <LinearLayout
                            android:orientation="horizontal"
                            android:id="@+id/ltb"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingRight="@dimen/item_gap_l"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/t_balance"
                                android:paddingTop="@dimen/item_gap_m"
                                android:paddingBottom="@dimen/item_gap_m"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/ammendBuy_available_lot"
                                android:layout_weight="1"
                                style="@style/SbTextView.ListSubtitle"/>
                            <TextView
                                android:gravity="end"
                                android:id="@+id/availablelot"
                                android:paddingTop="@dimen/item_gap_m"
                                android:paddingBottom="@dimen/item_gap_m"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/ammendBuy_item_height"
                                android:text="@string/n_dash"
                                android:maxLines="1"
                                android:layout_weight="1"
                                android:textAlignment="gravity"
                                style="@style/SbTextView.ListTitle"/>
                        </LinearLayout>
                        <RelativeLayout
                            android:orientation="horizontal"
                            android:id="@+id/lseekbar"
                            android:paddingRight="@dimen/item_gap_l"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/ltb">
                            <com.google.android.material.slider.Slider
                                android:id="@+id/google_discrete"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:stepSize="1"
                                android:valueFrom="0"
                                android:valueTo="100"
                                android:layout_toStartOf="@+id/percentTextView"
                                app:haloColor="@color/green_text"
                                app:haloRadius="@dimen/item_gap_l"
                                app:labelBehavior="gone"
                                app:thumbColor="@color/green_text"
                                app:thumbRadius="@dimen/item_gap_s"
                                app:tickVisible="false"
                                app:trackColorActive="@color/green_text"/>
                            <TextView
                                android:textColor="?attr/themeContentTextColor"
                                android:gravity="end|center_vertical"
                                android:id="@+id/percentTextView"
                                android:paddingBottom="5dp"
                                android:visibility="visible"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="@dimen/ammend_min_width_percentage_seekbar"
                                android:text="100%"
                                android:layout_centerVertical="true"
                                android:textAlignment="gravity"
                                android:layout_alignParentEnd="true"
                                style="@style/SbTextView.BodyDefault"/>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/ltc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="@dimen/item_gap_l"
                            android:layout_below="@+id/lseekbar">
                            <TextView
                                android:id="@+id/t_totallot"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ammendBuy_lot"
                                android:layout_centerVertical="true"
                                android:layout_alignParentStart="true"
                                style="@style/SbTextView.ListSubtitle"/>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:background="?attr/themeContentBackground"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/height_28"
                                android:layout_alignParentEnd="true">
                                <Button
                                    android:textSize="@dimen/text_size_18"
                                    android:textStyle="normal"
                                    android:id="@+id/l_min"
                                    android:background="@drawable/border_gray_rounded_white_bg"
                                    android:padding="0dp"
                                    android:layout_width="@dimen/width_28"
                                    android:layout_height="@dimen/height_28"
                                    android:text="@string/n_dash"
                                    style="@style/SbTextView.ListTitle"/>
                                <EditText
                                    android:gravity="center"
                                    android:id="@+id/et_totallot"
                                    android:background="@null"
                                    android:focusable="true"
                                    android:focusableInTouchMode="true"
                                    android:layout_width="@dimen/width_113"
                                    android:layout_height="match_parent"
                                    android:minWidth="@dimen/buy_min_width_btn"
                                    android:maxLines="1"
                                    android:selectAllOnFocus="true"
                                    android:digits="0123456789"
                                    android:inputType="numberDecimal"
                                    android:imeOptions="actionDone"
                                    style="@style/SbTextView.ListSubtitle"/>
                                <Button
                                    android:textSize="@dimen/text_size_18"
                                    android:textStyle="normal"
                                    android:id="@+id/l_plus"
                                    android:background="@drawable/border_gray_rounded_white_bg"
                                    android:padding="0dp"
                                    android:layout_width="@dimen/width_28"
                                    android:layout_height="@dimen/height_28"
                                    android:text="+"
                                    style="@style/SbTextView.ListTitle"/>
                            </LinearLayout>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/ltp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/item_gap_l"
                            android:layout_below="@+id/ltc"
                            android:layout_marginHorizontal="@dimen/item_gap_l">
                            <TextView
                                android:id="@+id/t_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ammendBuy_price"
                                android:layout_centerVertical="true"
                                android:layout_alignParentStart="true"
                                style="@style/SbTextView.ListSubtitle"/>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/llAmmendSellPriceLayout"
                                android:background="?attr/themeColorSurfaceDefault"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/height_28"
                                android:layout_alignParentEnd="true">
                                <Button
                                    android:textSize="@dimen/text_size_18"
                                    android:textStyle="normal"
                                    android:id="@+id/p_min"
                                    android:background="@drawable/border_gray_rounded_white_bg"
                                    android:padding="0dp"
                                    android:layout_width="@dimen/width_28"
                                    android:layout_height="@dimen/height_28"
                                    android:text="@string/n_dash"
                                    style="@style/SbTextView.ListTitle"/>
                                <EditText
                                    android:gravity="center"
                                    android:id="@+id/et_totalprice"
                                    android:background="@null"
                                    android:focusable="true"
                                    android:focusableInTouchMode="true"
                                    android:layout_width="@dimen/width_113"
                                    android:layout_height="match_parent"
                                    android:minWidth="@dimen/buy_min_width_btn"
                                    android:maxLines="1"
                                    android:selectAllOnFocus="true"
                                    android:digits="0123456789"
                                    android:inputType="numberDecimal"
                                    android:imeOptions="actionDone"
                                    style="@style/SbTextView.ListSubtitle"/>
                                <Button
                                    android:textSize="@dimen/text_size_18"
                                    android:textStyle="normal"
                                    android:id="@+id/p_plus"
                                    android:background="@drawable/border_gray_rounded_white_bg"
                                    android:padding="0dp"
                                    android:layout_width="@dimen/width_28"
                                    android:layout_height="@dimen/height_28"
                                    android:text="+"
                                    style="@style/SbTextView.ListTitle"/>
                            </LinearLayout>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/l_lot"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingRight="@dimen/item_gap_l"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/ltp">
                            <TextView
                                android:id="@+id/t_lot"
                                android:paddingTop="@dimen/item_gap_m"
                                android:paddingBottom="@dimen/item_gap_m"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ammendBuy_proceed_amount"
                                android:layout_alignParentStart="true"
                                style="@style/SbTextView.ListSubtitle"/>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:background="?attr/themeColorSurfaceDefault"
                                android:paddingLeft="@dimen/item_gap_s"
                                android:paddingRight="@dimen/item_gap_s"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/ammendBuy_item_height"
                                android:paddingStart="@dimen/item_gap_s"
                                android:paddingEnd="@dimen/item_gap_s"
                                android:layout_toEndOf="@+id/t_lot">
                                <TextView
                                    android:gravity="end|center_vertical"
                                    android:id="@+id/sellAmount"
                                    android:background="@null"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:text="@string/n_dash"
                                    android:inputType="number"
                                    android:textAlignment="gravity"
                                    style="@style/SbTextView.ListSubtitle"/>
                            </LinearLayout>
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/l_profit_lost"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingRight="@dimen/item_gap_l"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ammendBuy_item_height"
                            android:layout_below="@+id/l_lot">
                            <TextView
                                android:textSize="@dimen/text_size_12"
                                android:id="@+id/t_profitloss"
                                android:paddingTop="@dimen/item_gap_m"
                                android:paddingBottom="@dimen/item_gap_m"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ammendBuy_pl"
                                android:layout_centerInParent="true"
                                android:layout_alignParentStart="true"
                                style="@style/SbTextView.ListSubtitle"/>
                            <LinearLayout
                                android:orientation="horizontal"
                                android:id="@+id/llPLLayout"
                                android:background="?attr/themeColorSurfaceDefault"
                                android:paddingLeft="@dimen/item_gap_s"
                                android:paddingRight="@dimen/item_gap_s"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/ammendBuy_item_height"
                                android:paddingStart="@dimen/item_gap_s"
                                android:paddingEnd="@dimen/item_gap_s"
                                android:layout_toEndOf="@+id/t_profitloss"
                                android:layout_alignParentEnd="true">
                                <TextView
                                    android:gravity="end|center_vertical"
                                    android:id="@+id/profitLoss"
                                    android:background="@null"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:text="@string/n_dash"
                                    android:inputType="number"
                                    android:textAlignment="gravity"
                                    style="@style/SbTextView.ListSubtitle"/>
                            </LinearLayout>
                        </RelativeLayout>
                    </RelativeLayout>
                    <com.stockbit.common.uikit.StockbitCompanyOrderbook
                        android:id="@+id/llCompanyOrderBookInfoLayout"
                        android:tag="binding_4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/rlTradeSellLayout"/>
                </RelativeLayout>
            </androidx.core.widget.NestedScrollView>
            <LinearLayout
                android:id="@+id/llButtonLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_alignParentStart="true">
                <Button
                    android:textColor="@color/white"
                    android:id="@+id/btnSwitchToReal"
                    android:background="@color/background_blue_medium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="@string/maintab_switch_to_real"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/item_gap_xxxs"
                    style="@style/SbTextView.ListTitle"/>
                <Button
                    android:textColor="@color/white"
                    android:id="@+id/btnOrder"
                    android:background="@color/google_red"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:text="@string/orderlist_detail_title_ammend"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/item_gap_xxxs"
                    style="@style/SbTextView.ListTitle"/>
            </LinearLayout>
        </RelativeLayout>
        <include
            android:layout_gravity="center"
            android:id="@+id/parentErrorTradingSell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/comp_icon_error_view"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsvFragmentTradingSell"
            android:tag="binding_5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <include layout="@layout/comp_empty_data_virtual_sell"/>
        </androidx.core.widget.NestedScrollView>
    </ViewFlipper>
</androidx.appcompat.widget.LinearLayoutCompat>
