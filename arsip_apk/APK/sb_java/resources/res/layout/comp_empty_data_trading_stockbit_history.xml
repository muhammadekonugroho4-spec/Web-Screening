<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/parent_comp_empty_data_trading_history"
    android:tag="layout/comp_empty_data_trading_stockbit_history_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_trading_history_empty_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        app:srcCompat="?attr/iconEmptyState"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_trading_history_title_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32"
        android:layout_marginBottom="@dimen/item_gap_s"
        android:text="@string/empty_history_title"
        android:layout_below="@+id/iv_trading_history_empty_img"
        android:layout_marginHorizontal="@dimen/spacing_16"
        style="@style/TypeStyles.HeadingLarge"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="center"
        android:id="@+id/tv_trading_history_subtitle_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/spacing_16"
        android:layout_marginRight="@dimen/spacing_16"
        android:text="@string/start_investing_now"
        android:layout_below="@+id/tv_trading_history_title_empty"/>
    <com.stockbit.uikit.buttons.EllipseButton
        android:textSize="@dimen/text_size_14"
        android:layout_gravity="center"
        android:id="@+id/btn_add_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32"
        android:text="@string/empty_button_history"
        android:layout_below="@+id/tv_trading_history_subtitle_empty"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
