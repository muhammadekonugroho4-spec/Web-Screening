<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/item_gap_s"
    android:paddingBottom="@dimen/item_gap_s"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/item_gap_l"
    android:paddingEnd="@dimen/item_gap_l">
    <View
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/item_gap_s"
        android:layout_weight="1.3"
        android:backgroundTint="?attr/themeSeparatorGapColor"/>
    <View
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/item_gap_s"
        android:layout_weight="1"
        android:backgroundTint="?attr/themeSeparatorGapColor"/>
    <View
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/item_gap_s"
        android:layout_weight="1.1"
        android:backgroundTint="?attr/themeSeparatorGapColor"/>
    <View
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/item_gap_s"
        android:layout_weight="1.2"
        android:backgroundTint="?attr/themeSeparatorGapColor"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_s"
        android:layout_marginBottom="@dimen/item_gap_s"
        android:layout_weight="1.35">
        <View
            android:background="@drawable/bg_rounded_gray"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/item_gap_s"
            android:layout_marginEnd="@dimen/item_gap_s"
            android:backgroundTint="?attr/themeSeparatorGapColor"/>
        <View
            android:background="@drawable/bg_rounded_gray"
            android:paddingTop="@dimen/item_gap_s"
            android:paddingBottom="@dimen/item_gap_s"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/item_gap_s"
            android:layout_marginEnd="@dimen/item_gap_s"
            android:backgroundTint="?attr/themeSeparatorGapColor"/>
    </LinearLayout>
</LinearLayout>
