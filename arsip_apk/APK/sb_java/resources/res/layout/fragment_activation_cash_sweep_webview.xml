<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_activation_cash_sweep_webview_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_centerHorizontal="true"
        app:contentInsetStartWithNavigation="@dimen/spacing_0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/uikit_ic_stockbit_top_bar_close"
        app:titleTextAppearance="@style/SbTextView.PageTitle">
        <androidx.appcompat.widget.AppCompatTextView
            android:ellipsize="end"
            android:gravity="start"
            android:layout_gravity="start"
            android:id="@+id/text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_cash_sweep_webview_bibit"
            android:lines="1"
            style="@style/TypeStyles.HeadingLarge"/>
        <ImageView
            android:ellipsize="end"
            android:gravity="end"
            android:layout_gravity="end"
            android:id="@+id/iv_reload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/uikit_ic_stockbit_top_bar_reload"
            android:layout_marginEnd="@dimen/item_gap_16"/>
    </androidx.appcompat.widget.Toolbar>
    <com.stockbit.cashsweep.ui.screen.common.webview.CashSweepWebview
        android:id="@+id/wv_cash_sweep"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_loading"
        android:background="?attr/themeColorSurfaceDefault"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/iv_bibit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/iv_loading"
                android:layout_width="@dimen/width_160"
                android:layout_height="@dimen/height_120"
                android:src="?attr/themeIconCashSweepWebviewLoading"/>
            <TextView
                android:textColor="?attr/themeColorTextPrimary"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:text="@string/txt_cash_sweep_webview_loading_title"
                android:textAlignment="center"
                style="@style/TypeStyles.HeadingRegular"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:gravity="center"
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="@string/txt_cash_sweep_webview_loading_description"
                android:textAlignment="center"
                style="@style/TypeStyles.BodyRegular"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_bibit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_powered_by_bibit"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
