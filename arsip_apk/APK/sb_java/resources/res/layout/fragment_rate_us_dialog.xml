<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme"
    android:tag="layout/fragment_rate_us_dialog_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/vgLogoutDialogDialogHeader"
        android:background="@drawable/bg_top_rounded"
        android:paddingTop="@dimen/item_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/viewFragmentLogoutDialogHandler"
            android:background="@drawable/bg_rounded_gray_gray_bg"
            android:layout_width="@dimen/clickable_size_38"
            android:layout_height="@dimen/item_gap_s"
            android:layout_marginBottom="@dimen/item_gap_s"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/parentLogoutDialog"
        android:background="?attr/themeDialogBackgroundColor"
        android:paddingTop="@dimen/item_gap_s"
        android:paddingBottom="@dimen/item_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/vgLogoutDialogDialogHeader">
        <com.airbnb.lottie.LottieAnimationView
            android:layout_gravity="center"
            android:id="@+id/ivRateUsHeroImageAnimated"
            android:layout_width="@dimen/height_90"
            android:layout_height="@dimen/width_80"
            android:layout_marginTop="@dimen/clickable_size_24"
            android:scaleType="fitCenter"
            app:lottie_autoPlay="false"
            app:lottie_fileName="lottie_anim_rate_us_animation.json"
            app:lottie_loop="false"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:gravity="center"
            android:layout_gravity="center"
            android:paddingLeft="@dimen/clickable_size_48"
            android:paddingRight="@dimen/clickable_size_48"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/clickable_size_24"
            android:text="@string/setting_rate_us_title"
            style="@style/SbTextView.BodyDefault.Bold"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:gravity="center"
            android:layout_gravity="center"
            android:paddingLeft="@dimen/clickable_size_48"
            android:paddingRight="@dimen/clickable_size_48"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/clickable_size_24"
            android:text="@string/setting_rate_us_title"
            style="@style/SbTextView.BodySecondary"/>
        <LinearLayout
            android:orientation="horizontal"
            android:padding="@dimen/item_gap_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="@dimen/text_size_16"
                android:textColor="@color/green_text"
                android:layout_gravity="center"
                android:id="@+id/btnRateUsRemindLater"
                android:background="?attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setting_rate_us_nanti"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginEnd="@dimen/item_gap_xxs"
                style="@style/SbTextView.BodyDefault.Green.Bold"/>
            <Button
                android:textSize="@dimen/text_size_16"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:id="@+id/btnRateUsLoveStockbit"
                android:background="@drawable/border_green_rounded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground"
                android:text="@string/setting_rate_us_ya"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/item_gap_xxs"
                style="@style/SbTextView.BodyDefault.Bold"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
