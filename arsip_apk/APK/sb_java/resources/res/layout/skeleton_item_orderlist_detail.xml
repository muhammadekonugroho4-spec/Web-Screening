<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:paddingTop="@dimen/item_gap_s"
    android:paddingBottom="@dimen/item_gap_s"
    android:layout_width="match_parent"
    android:layout_height="@dimen/clickable_size_48"
    android:paddingStart="@dimen/item_gap_l"
    android:paddingEnd="@dimen/item_gap_l">
    <View
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:layout_marginStart="@dimen/item_gap_s"
        android:layout_marginEnd="@dimen/item_gap_xxs"
        android:backgroundTint="?attr/themeSeparatorGapColor"/>
    <View
        android:background="@drawable/bg_rounded_gray"
        android:paddingTop="@dimen/item_gap_s"
        android:paddingBottom="@dimen/item_gap_s"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/item_gap_xxs"
        android:layout_marginEnd="@dimen/item_gap_xxs"
        android:backgroundTint="?attr/themeSeparatorGapColor"/>
</LinearLayout>
