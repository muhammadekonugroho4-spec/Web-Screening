<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentFragmentDiscoverWatchlistItem"
    android:tag="layout/fragment_discover_watchlist_item_dialog_0"
    android:background="@drawable/bg_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/llDiscoverWatchlistItemTitle"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:id="@+id/tvDiscoverWatchlistItemDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_40"
            android:text="@string/title_watchlist_item_dialog_title"
            android:includeFontPadding="false"
            android:textAlignment="gravity"
            style="@style/SbTextView.PageTitle"/>
        <include
            android:id="@+id/search_bar"
            layout="@layout/comp_search_bar_rounded_bg"/>
    </LinearLayout>
    <View
        android:id="@+id/viewFragmentDiscoverWatchlistItem"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_below="@+id/llDiscoverWatchlistItemTitle"/>
    <RelativeLayout
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="@dimen/clickable_size_72"
        android:layout_below="@+id/viewFragmentDiscoverWatchlistItem">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFragmentDiscoverWatchlistItem"
            android:paddingBottom="@dimen/item_gap_l"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/btnDiscoverWatchlistItemDone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <Button
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btnDiscoverWatchlistItemDone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/item_gap_l"
            android:text="@string/buy_title_canceled_btn"
            android:layout_alignParentBottom="true"
            android:textAllCaps="true"
            style="@style/SbBtn.PrimaryFullWidthFloating"/>
    </RelativeLayout>
    <ProgressBar
        android:id="@+id/progressWatchlistItem"
        android:layout_width="@dimen/clickable_size_32"
        android:layout_height="@dimen/clickable_size_32"
        android:layout_centerInParent="true"/>
</RelativeLayout>
