<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingHorizontal="@dimen/spacing_16"
    android:paddingVertical="@dimen/spacing_12">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_company_logo"
        android:layout_width="@dimen/spacing_40"
        android:layout_height="@dimen/spacing_40"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tv_symbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/alert_detail_empty"
        android:layout_centerVertical="true"
        android:textAlignment="gravity"
        android:layout_marginStart="@dimen/spacing_12"
        app:layout_constraintBottom_toTopOf="@+id/v_center"
        app:layout_constraintStart_toEndOf="@+id/iv_company_logo"
        style="@style/TypeStyles.HeadingRegular"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/rv_horizontal_notation"
        android:visibility="visible"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/spacing_2"
        android:layout_marginEnd="@dimen/spacing_12"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="@+id/tv_symbol"
        app:layout_constraintEnd_toStartOf="@+id/br_price"
        app:layout_constraintStart_toEndOf="@+id/tv_symbol"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol"
        app:spanCount="1"/>
    <View
        android:id="@+id/v_center"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_company_logo"
        app:layout_constraintEnd_toStartOf="@+id/br_price"
        app:layout_constraintStart_toEndOf="@+id/iv_company_logo"
        app:layout_constraintTop_toTopOf="@+id/iv_company_logo"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_desc"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:text="@string/alert_detail_empty"
        android:maxLines="1"
        android:maxEms="18"
        android:textAlignment="gravity"
        android:layout_marginEnd="@dimen/spacing_12"
        app:layout_constraintEnd_toStartOf="@+id/br_price"
        app:layout_constraintStart_toStartOf="@+id/tv_symbol"
        app:layout_constraintTop_toBottomOf="@+id/v_center"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/br_price"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:barrierDirection="left"
        app:constraint_referenced_ids="iv_company_info_detail, cv_last_change"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_company_info_detail"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tv_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol"
        app:srcCompat="@drawable/ic_chevron_right_grey"
        app:tint="?attr/themeIconTintColor"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_last_change"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/spacing_0"
        app:cardBackgroundColor="?attr/themeContentBackground"
        app:cardCornerRadius="@dimen/spacing_4"
        app:cardElevation="@dimen/spacing_0"
        app:layout_constraintBottom_toBottomOf="@+id/tv_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="?attr/themeColorTextPrimary"
                android:layout_gravity="right"
                android:id="@+id/tv_last_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alert_detail_empty"
                android:textAlignment="gravity"
                style="@style/TypeStyles.HeadingRegular"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="bottom"
                android:layout_gravity="right"
                android:id="@+id/tv_last_change"
                android:paddingLeft="@dimen/item_gap_xxxs"
                android:paddingRight="@dimen/item_gap_xxxs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/alert_detail_empty"
                style="@style/TypeStyles.BodyXSmall"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</merge>
