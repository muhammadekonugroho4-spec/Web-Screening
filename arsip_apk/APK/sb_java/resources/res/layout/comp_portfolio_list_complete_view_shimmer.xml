<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/comp_portfolio_list_complete_view_shimmer_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/top_shimmer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/FBShimmerFrameLayout">
        <LinearLayout
            android:orientation="vertical"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/skeleton_header_portfolio_box"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <View
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_8"
        android:layout_marginTop="@dimen/item_gap_8"
        android:backgroundTint="?attr/themeColorDividerThick"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/portfolio_row_item_complete_height">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:minHeight="@dimen/height_32"
            android:layout_marginHorizontal="@dimen/spacing_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <RelativeLayout
                android:layout_width="@dimen/width_83"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="start"
                    android:id="@+id/tv_trading_portfolio_row_code"
                    android:paddingTop="@dimen/spacing_2"
                    android:paddingBottom="@dimen/spacing_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_portfolio_header_complete_code"
                    android:layout_alignParentStart="true"
                    style="@style/TypeStyles.BodyXSmall"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:gravity="start"
                    android:id="@+id/tv_trading_portfolio_row_lot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_portfolio_header_complete_lot"
                    android:layout_below="@+id/tv_trading_portfolio_row_code"
                    android:layout_centerHorizontal="true"
                    style="@style/TypeStyles.BodyXXSmall"/>
            </RelativeLayout>
            <Space
                android:layout_width="@dimen/spacing_4"
                android:layout_height="wrap_content"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="end"
                    android:id="@+id/tv_trading_portfolio_row_invested"
                    android:paddingTop="@dimen/spacing_2"
                    android:paddingBottom="@dimen/spacing_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_portfolio_header_complete_invested"
                    android:layout_alignParentStart="true"
                    style="@style/TypeStyles.BodyXSmall"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:gravity="end"
                    android:id="@+id/tv_trading_portfolio_row_price_avg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_portfolio_header_complete_avg_price"
                    android:layout_below="@+id/tv_trading_portfolio_row_invested"
                    android:layout_centerHorizontal="true"
                    style="@style/TypeStyles.BodyXXSmall"/>
            </RelativeLayout>
            <Space
                android:layout_width="@dimen/spacing_4"
                android:layout_height="wrap_content"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="end"
                    android:id="@+id/tv_trading_portfolio_row_market"
                    android:paddingTop="@dimen/spacing_2"
                    android:paddingBottom="@dimen/spacing_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_portfolio_header_complete_market"
                    android:layout_alignParentStart="true"
                    style="@style/TypeStyles.BodyXSmall"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:gravity="end"
                    android:id="@+id/tv_trading_portfolio_row_current_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_portfolio_header_complete_current_price"
                    android:layout_below="@+id/tv_trading_portfolio_row_market"
                    android:layout_centerHorizontal="true"
                    style="@style/TypeStyles.BodyXXSmall"/>
            </RelativeLayout>
            <Space
                android:layout_width="@dimen/spacing_4"
                android:layout_height="wrap_content"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="end"
                    android:id="@+id/tv_trading_portfolio_row_pnl"
                    android:paddingTop="@dimen/spacing_2"
                    android:paddingBottom="@dimen/spacing_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_portfolio_header_complete_pnl"
                    android:layout_centerHorizontal="true"
                    style="@style/TypeStyles.BodyXSmall"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:gravity="end"
                    android:id="@+id/tv_trading_portfolio_row_gain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/text_portfolio_header_complete_gain"
                    android:layout_below="@+id/tv_trading_portfolio_row_pnl"
                    style="@style/TypeStyles.BodyXSmall"/>
            </RelativeLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_1"
        android:backgroundTint="?attr/themeColorDividerThin"/>
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/bottom_shimmer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/FBShimmerFrameLayout">
        <LinearLayout
            android:orientation="vertical"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/skeleton_item_portfolio_complete_view"/>
            <include layout="@layout/skeleton_item_portfolio_complete_view"/>
            <include layout="@layout/skeleton_item_portfolio_complete_view"/>
            <include layout="@layout/skeleton_item_portfolio_complete_view"/>
            <include layout="@layout/skeleton_item_portfolio_complete_view"/>
            <include layout="@layout/skeleton_item_portfolio_complete_view"/>
            <include layout="@layout/skeleton_item_portfolio_complete_view"/>
            <include layout="@layout/skeleton_item_portfolio_complete_view"/>
            <include layout="@layout/skeleton_item_portfolio_complete_view"/>
            <include layout="@layout/skeleton_item_portfolio_complete_view"/>
            <include layout="@layout/skeleton_item_portfolio_complete_view"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</LinearLayout>
