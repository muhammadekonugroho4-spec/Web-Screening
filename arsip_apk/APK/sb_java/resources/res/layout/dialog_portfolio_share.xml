<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_portfolio_share_0"
    android:background="@drawable/bg_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    app:behavior_fitToContents="true"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/cl_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_share_portfolio_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <View
                android:id="@+id/v_share_post"
                android:background="@drawable/bg_rounded_gray_gray_bg"
                android:layout_width="@dimen/clickable_size_38"
                android:layout_height="@dimen/item_gap_5"
                android:layout_marginTop="@dimen/item_gap_l"
                android:layout_centerHorizontal="true"
                android:alpha="0.5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_share_portfolio_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/lbl_share"
                app:layout_constraintEnd_toEndOf="@+id/v_share_post"
                app:layout_constraintStart_toStartOf="@+id/v_share_post"
                app:layout_constraintTop_toBottomOf="@+id/v_share_post"
                style="@style/SbTextView.TitleSmall"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_entire_portfolio"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_share_portfolio_title"
                app:layout_constraintWidth_max="335dp"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/compose_particular_portfolio"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_share_portfolio_title"
                app:layout_constraintWidth_max="335dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/cv_toggle_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <View
            android:id="@+id/v_sep_share1"
            android:background="?attr/themeContentButtonBorder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_share_portfolio_header"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_share_to"
            android:background="?attr/themeDialogBackgroundColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/item_gap_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_sep_share1">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/actv_share_to"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialog_share_portfolio_title_icon"
                android:paddingHorizontal="@dimen/item_gap_20"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/SbTextView.ListTitle.Highempasis.Bold"/>
            <HorizontalScrollView
                android:id="@+id/hsv_share_to"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_10"
                android:paddingHorizontal="@dimen/item_gap_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/actv_share_to">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_container_share_via"
                        android:tag="binding_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:foreground="?attr/selectableItemBackground">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/aciv_share_via"
                            android:background="@drawable/bg_circle_border"
                            android:layout_width="@dimen/clickable_size_50"
                            android:layout_height="@dimen/clickable_size_50"
                            android:foreground="?attr/selectableItemBackground"
                            android:src="@drawable/ic_share"
                            android:scaleType="centerInside"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/text_size_10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/icon_share_via_title"
                            app:layout_constraintEnd_toEndOf="@+id/aciv_share_via"
                            app:layout_constraintStart_toStartOf="@+id/aciv_share_via"
                            app:layout_constraintTop_toBottomOf="@+id/aciv_share_via"
                            style="@style/SbTextView.Caption.Highempasis"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_container_ig_story"
                        android:tag="binding_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:foreground="?attr/selectableItemBackground"
                        android:layout_marginStart="@dimen/item_gap_20">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/aciv_share_ig_story"
                            android:layout_width="@dimen/clickable_size_50"
                            android:layout_height="@dimen/clickable_size_50"
                            android:foreground="?attr/selectableItemBackground"
                            android:src="@drawable/ic_ig_story"
                            android:scaleType="centerInside"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/text_size_10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/icon_share_ig_story_title"
                            app:layout_constraintEnd_toEndOf="@+id/aciv_share_ig_story"
                            app:layout_constraintStart_toStartOf="@+id/aciv_share_ig_story"
                            app:layout_constraintTop_toBottomOf="@+id/aciv_share_ig_story"
                            style="@style/SbTextView.Caption.Highempasis"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_container_ig_post"
                        android:tag="binding_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:foreground="?attr/selectableItemBackground"
                        android:layout_marginStart="@dimen/item_gap_20">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/aciv_share_ig_post"
                            android:layout_width="@dimen/clickable_size_50"
                            android:layout_height="@dimen/clickable_size_50"
                            android:foreground="?attr/selectableItemBackground"
                            android:src="@drawable/ic_ig_post"
                            android:scaleType="centerInside"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/text_size_10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/icon_share_ig_post_title"
                            app:layout_constraintEnd_toEndOf="@+id/aciv_share_ig_post"
                            app:layout_constraintStart_toStartOf="@+id/aciv_share_ig_post"
                            app:layout_constraintTop_toBottomOf="@+id/aciv_share_ig_post"
                            style="@style/SbTextView.Caption.Highempasis"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_container_whatsapp"
                        android:tag="binding_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:foreground="?attr/selectableItemBackground"
                        android:layout_marginStart="@dimen/item_gap_20">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/aciv_share_whatsapp"
                            android:background="@drawable/bg_circle_border"
                            android:layout_width="@dimen/clickable_size_50"
                            android:layout_height="@dimen/clickable_size_50"
                            android:foreground="?attr/selectableItemBackground"
                            android:src="@drawable/ic_whatsapp"
                            android:scaleType="centerInside"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/text_size_10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/icon_share_whatsapp_title"
                            app:layout_constraintEnd_toEndOf="@+id/aciv_share_whatsapp"
                            app:layout_constraintStart_toStartOf="@+id/aciv_share_whatsapp"
                            app:layout_constraintTop_toBottomOf="@+id/aciv_share_whatsapp"
                            style="@style/SbTextView.Caption.Highempasis"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_container_telegram"
                        android:tag="binding_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:foreground="?attr/selectableItemBackground"
                        android:layout_marginStart="@dimen/item_gap_20">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/aciv_share_telegram"
                            android:background="@drawable/bg_circle_border"
                            android:layout_width="@dimen/clickable_size_50"
                            android:layout_height="@dimen/clickable_size_50"
                            android:foreground="?attr/selectableItemBackground"
                            android:src="@drawable/ic_telegram"
                            android:scaleType="centerInside"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/text_size_10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/icon_share_telegram_title"
                            app:layout_constraintEnd_toEndOf="@+id/aciv_share_telegram"
                            app:layout_constraintStart_toStartOf="@+id/aciv_share_telegram"
                            app:layout_constraintTop_toBottomOf="@+id/aciv_share_telegram"
                            style="@style/SbTextView.Caption.Highempasis"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_container_twitter"
                        android:tag="binding_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:foreground="?attr/selectableItemBackground"
                        android:layout_marginStart="@dimen/item_gap_20">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/aciv_share_twitter"
                            android:background="@drawable/bg_circle_border"
                            android:layout_width="@dimen/clickable_size_50"
                            android:layout_height="@dimen/clickable_size_50"
                            android:foreground="?attr/selectableItemBackground"
                            android:src="@drawable/ic_twitter"
                            android:scaleType="centerInside"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/text_size_10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/icon_share_twitter_title"
                            app:layout_constraintEnd_toEndOf="@+id/aciv_share_twitter"
                            app:layout_constraintStart_toStartOf="@+id/aciv_share_twitter"
                            app:layout_constraintTop_toBottomOf="@+id/aciv_share_twitter"
                            style="@style/SbTextView.Caption.Highempasis"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </HorizontalScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/v_sep_share2"
            android:background="?attr/themeContentButtonBorder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_share_to"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_share_other"
            android:background="?attr/themeDialogBackgroundColor"
            android:padding="@dimen/item_gap_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_sep_share2">
            <HorizontalScrollView
                android:id="@+id/hsv_share_other"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_container_save"
                        android:tag="binding_7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:foreground="?attr/selectableItemBackground">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/aciv_save"
                            android:background="@drawable/bg_circle_border"
                            android:layout_width="@dimen/clickable_size_50"
                            android:layout_height="@dimen/clickable_size_50"
                            android:foreground="?attr/selectableItemBackground"
                            android:src="@drawable/ic_save"
                            android:scaleType="centerInside"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/text_size_10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/icon_share_save_title"
                            app:layout_constraintEnd_toEndOf="@+id/aciv_save"
                            app:layout_constraintStart_toStartOf="@+id/aciv_save"
                            app:layout_constraintTop_toBottomOf="@+id/aciv_save"
                            style="@style/SbTextView.Caption.Highempasis"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_container_stream"
                        android:tag="binding_8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:foreground="?attr/selectableItemBackground"
                        android:layout_marginStart="@dimen/item_gap_20">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/aciv_share_stream"
                            android:background="@drawable/bg_circle_border"
                            android:layout_width="@dimen/clickable_size_50"
                            android:layout_height="@dimen/clickable_size_50"
                            android:foreground="?attr/selectableItemBackground"
                            android:src="@drawable/ic_share_stream"
                            android:scaleType="centerInside"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/text_size_10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/icon_share_stream_title"
                            app:layout_constraintEnd_toEndOf="@+id/aciv_share_stream"
                            app:layout_constraintStart_toStartOf="@+id/aciv_share_stream"
                            app:layout_constraintTop_toBottomOf="@+id/aciv_share_stream"
                            style="@style/SbTextView.Caption.Highempasis"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_container_chat"
                        android:tag="binding_9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:foreground="?attr/selectableItemBackground"
                        android:layout_marginStart="@dimen/item_gap_20">
                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/aciv_share_chat"
                            android:background="@drawable/bg_circle_border"
                            android:layout_width="@dimen/clickable_size_50"
                            android:layout_height="@dimen/clickable_size_50"
                            android:foreground="?attr/selectableItemBackground"
                            android:src="@drawable/ic_share_chat"
                            android:scaleType="centerInside"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <androidx.appcompat.widget.AppCompatTextView
                            android:textSize="@dimen/text_size_10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="@string/icon_share_chat_title"
                            app:layout_constraintEnd_toEndOf="@+id/aciv_share_chat"
                            app:layout_constraintStart_toStartOf="@+id/aciv_share_chat"
                            app:layout_constraintTop_toBottomOf="@+id/aciv_share_chat"
                            style="@style/SbTextView.Caption.Highempasis"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </HorizontalScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/v__sep_share3"
            android:background="?attr/themeContentButtonBorder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_share_other"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_share_portfolio_footer"
            android:background="?attr/themeContentCircleFill"
            android:padding="@dimen/item_gap_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:id="@+id/tv_share_portfolio_footer_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_cancel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/SbTextView"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.core.widget.NestedScrollView>
