<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_trading_stockbit_orderlist_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true">
    <TextView
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="start"
        android:id="@+id/no_swipe"
        android:background="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/spacing_48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="end"
        android:id="@+id/delete_button"
        android:background="@color/google_red"
        android:padding="@dimen/spacing_6"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/spacing_48"
        android:text="@string/btn_cancel_order"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyRegular"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content_view"
        android:background="?attr/themeColorSurfaceDefault"
        android:paddingTop="@dimen/item_gap_16"
        android:paddingBottom="@dimen/spacing_16"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/content_layout"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/view_click_bracket_order"
                    android:layout_width="@dimen/item_gap_45"
                    android:layout_height="0dp"
                    android:maxHeight="@dimen/item_gap_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.stockbit.uikit.control.ControlCheckbox
                    android:id="@+id/ccb_select_order"
                    android:visibility="gone"
                    android:layout_width="@dimen/width_24"
                    android:layout_height="@dimen/height_24"
                    android:layout_marginStart="@dimen/item_gap_20"
                    app:checkBoxType="box"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/iv_expand_collapse"
                    android:visibility="gone"
                    android:layout_width="@dimen/width_12"
                    android:layout_height="@dimen/height_12"
                    android:src="@drawable/uikit_ic_stockbit_text_field_chevron_down"
                    android:layout_marginStart="@dimen/item_gap_7"
                    android:layout_marginEnd="@dimen/item_gap_2"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ccb_select_order"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.Barrier
                    android:orientation="vertical"
                    android:id="@+id/barrier_start_symbol"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:barrierDirection="end"
                    app:constraint_referenced_ids="iv_expand_collapse, ccb_select_order"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rl_symbol"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/amount"
                    app:layout_constraintHorizontal_chainStyle="spread"
                    app:layout_constraintHorizontal_weight="26"
                    app:layout_constraintStart_toEndOf="@+id/barrier_start_symbol"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textColor="@color/green_text"
                        android:id="@+id/symbol"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:contentDescription="@string/ORDER_6"
                        android:layout_marginEnd="@dimen/spacing_6"
                        app:layout_constraintBottom_toTopOf="@+id/iv_non_syariah"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/TypeStyles.BodyXXSmall"/>
                    <ImageView
                        android:id="@+id/iv_non_syariah"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/SHARED_6"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/symbol"
                        app:srcCompat="?attr/themeIconNonSharia"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="left"
                    android:id="@+id/amount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="2"
                    android:contentDescription="@string/ORDER_8"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="@dimen/spacing_8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/price"
                    app:layout_constraintHorizontal_weight="24"
                    app:layout_constraintStart_toEndOf="@+id/rl_symbol"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <TextView
                    android:gravity="left"
                    android:id="@+id/price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:contentDescription="@string/ORDER_9"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="@dimen/spacing_8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvExpiryOrder"
                    app:layout_constraintHorizontal_weight="13.2"
                    app:layout_constraintStart_toEndOf="@+id/amount"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="left"
                    android:id="@+id/tvExpiryOrder"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:contentDescription="@string/ORDER_11"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="@dimen/spacing_8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tvStatusOrder"
                    app:layout_constraintHorizontal_weight="13"
                    app:layout_constraintStart_toEndOf="@+id/price"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="left"
                    android:id="@+id/tvStatusOrder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/ORDER_10"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="@dimen/spacing_20"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="23.78"
                    app:layout_constraintStart_toEndOf="@+id/tvExpiryOrder"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/TypeStyles.BodyXXSmall"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_negotiation_reqeust"
            android:background="@drawable/bg_order_nego_requested"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/item_gap_31"
            android:layout_marginTop="@dimen/spacing_8"
            android:paddingStart="@dimen/spacing_12"
            android:paddingEnd="@dimen/spacing_8"
            android:layout_marginStart="@dimen/spacing_20"
            android:layout_marginEnd="@dimen/spacing_20"
            android:paddingVertical="@dimen/spacing_6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/content_layout">
            <ImageView
                android:id="@+id/ivHandShake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_handshake"/>
            <TextView
                android:id="@+id/tv_nego_request_desc"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/spacing_4"
                style="@style/TypeStyles.BodyXSmall"/>
            <ImageView
                android:id="@+id/iv_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_arrow_gray"
                app:tint="?attr/themeIconTintColorLow"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_tp_sl"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/item_gap_10"
            android:paddingEnd="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/content_layout">
            <ImageView
                android:id="@+id/iv_first_list"
                android:visibility="gone"
                android:layout_width="@dimen/item_gap_7"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/item_gap_3"
                android:layout_marginEnd="@dimen/item_gap_2"
                app:layout_constraintBottom_toTopOf="@+id/spacer_sl"
                app:layout_constraintEnd_toStartOf="@+id/ll_sl"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_first_order_list_point"/>
            <Space
                android:id="@+id/spacer_sl"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_4"
                app:layout_constraintBottom_toBottomOf="@+id/v_ll_sl_mirror"
                app:layout_constraintStart_toStartOf="@+id/v_ll_sl_mirror"
                app:layout_constraintTop_toTopOf="@+id/v_ll_sl_mirror"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier_first_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="ll_sl"/>
            <ImageView
                android:id="@+id/iv_second_list"
                android:visibility="gone"
                android:layout_width="@dimen/item_gap_7"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/item_gap_3"
                android:layout_marginEnd="@dimen/item_gap_2"
                app:layout_constraintBottom_toTopOf="@+id/spacer_tp"
                app:layout_constraintEnd_toStartOf="@+id/ll_tp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_first_list"
                app:srcCompat="@drawable/ic_second_order_list_point"/>
            <Space
                android:id="@+id/spacer_tp"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/spacing_4"
                app:layout_constraintBottom_toBottomOf="@+id/v_ll_tp_mirror"
                app:layout_constraintStart_toStartOf="@+id/v_ll_tp_mirror"
                app:layout_constraintTop_toTopOf="@+id/v_ll_tp_mirror"/>
            <View
                android:id="@+id/v_ll_sl_mirror"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="7dp"
                app:layout_constraintBottom_toBottomOf="@+id/ll_sl"
                app:layout_constraintEnd_toEndOf="@+id/ll_sl"
                app:layout_constraintStart_toStartOf="@+id/ll_sl"
                app:layout_constraintTop_toTopOf="@+id/ll_sl"/>
            <LinearLayout
                android:id="@+id/ll_sl"
                android:paddingTop="@dimen/item_gap_10"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_first_list"
                app:layout_constraintTop_toTopOf="@+id/iv_first_list">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="?attr/themeColorTextRed"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_sl_symbol"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="BUY ADHI"
                    android:maxLines="2"
                    android:layout_weight="26"
                    android:foregroundGravity="center"
                    android:contentDescription="@string/ORDER_6"
                    android:layout_marginEnd="@dimen/spacing_8"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="center"
                    android:id="@+id/tv_sl_amount"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="63,000"
                    android:maxLines="2"
                    android:layout_weight="24"
                    android:contentDescription="@string/ORDER_8"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="@dimen/spacing_8"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_sl_price"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="630"
                    android:maxLines="1"
                    android:layout_weight="13.2"
                    android:contentDescription="@string/ORDER_9"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="@dimen/spacing_8"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="center"
                    android:id="@+id/tv_sl_expiry_order"
                    android:layout_width="@dimen/spacing_0"
                    android:layout_height="wrap_content"
                    android:text="DAY"
                    android:maxLines="1"
                    android:layout_weight="13"
                    android:contentDescription="@string/ORDER_11"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="@dimen/spacing_8"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="center"
                    android:layout_gravity="right"
                    android:id="@+id/tv_sl_status_order"
                    android:layout_width="@dimen/spacing_0"
                    android:layout_height="wrap_content"
                    android:text="WITHDRAWN"
                    android:maxLines="2"
                    android:layout_weight="23.78"
                    android:contentDescription="@string/ORDER_10"
                    android:textAlignment="gravity"
                    style="@style/TypeStyles.BodyXXSmall"/>
            </LinearLayout>
            <View
                android:id="@+id/v_ll_tp_mirror"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="7dp"
                app:layout_constraintBottom_toBottomOf="@+id/ll_tp"
                app:layout_constraintEnd_toEndOf="@+id/ll_tp"
                app:layout_constraintStart_toStartOf="@+id/ll_tp"
                app:layout_constraintTop_toTopOf="@+id/ll_tp"/>
            <LinearLayout
                android:id="@+id/ll_tp"
                android:paddingTop="@dimen/item_gap_10"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_second_list"
                app:layout_constraintTop_toBottomOf="@+id/ll_sl">
                <androidx.appcompat.widget.AppCompatTextView
                    android:textColor="?attr/themeColorTextRed"
                    android:gravity="start|center_vertical"
                    android:id="@+id/tv_tp_symbol"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="BUY ADHI"
                    android:maxLines="2"
                    android:layout_weight="26"
                    android:foregroundGravity="center"
                    android:contentDescription="@string/ORDER_6"
                    android:layout_marginEnd="@dimen/item_gap_8"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="center"
                    android:id="@+id/tv_tp_amount"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="63,000"
                    android:maxLines="2"
                    android:layout_weight="24"
                    android:contentDescription="@string/ORDER_8"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="@dimen/spacing_8"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_tp_price"
                    android:layout_width="@dimen/item_gap_null"
                    android:layout_height="wrap_content"
                    android:text="630"
                    android:maxLines="1"
                    android:layout_weight="13.2"
                    android:contentDescription="@string/ORDER_9"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="@dimen/spacing_8"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="center"
                    android:id="@+id/tv_tp_expiry_order"
                    android:layout_width="@dimen/spacing_0"
                    android:layout_height="wrap_content"
                    android:text="DAY"
                    android:maxLines="1"
                    android:layout_weight="13"
                    android:contentDescription="@string/ORDER_11"
                    android:textAlignment="gravity"
                    android:layout_marginEnd="@dimen/spacing_8"
                    style="@style/TypeStyles.BodyXXSmall"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="center"
                    android:layout_gravity="right"
                    android:id="@+id/tv_tp_status_order"
                    android:layout_width="@dimen/spacing_0"
                    android:layout_height="wrap_content"
                    android:text="WITHDRAWN"
                    android:maxLines="2"
                    android:layout_weight="23.78"
                    android:contentDescription="@string/ORDER_10"
                    android:textAlignment="gravity"
                    style="@style/TypeStyles.BodyXXSmall"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/spacer_content"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_xxxs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/content_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
