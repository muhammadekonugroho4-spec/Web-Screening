<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_filter_type_0"
    android:background="?attr/themeColorModalsBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_people"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        android:layout_marginVertical="@dimen/item_gap_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="@dimen/item_gap_28"
            android:layout_height="@dimen/item_gap_28"/>
        <TextView
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_username"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:drawablePadding="@dimen/item_gap_4"
            android:layout_marginStart="@dimen/item_gap_12"
            style="@style/TypeStyles.HeadingSmall"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_fullname"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_marginStart="@dimen/item_gap_8"
            style="@style/TypeStyles.BodySmall"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rl_company"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        android:layout_marginVertical="@dimen/item_gap_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/tv_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/item_gap_45"
            android:layout_centerVertical="true"
            style="@style/TypeStyles.HeadingSmall"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:ellipsize="end"
            android:id="@+id/tv_company_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_toRightOf="@+id/tv_symbol"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/item_gap_18"
            style="@style/TypeStyles.BodySmall"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
