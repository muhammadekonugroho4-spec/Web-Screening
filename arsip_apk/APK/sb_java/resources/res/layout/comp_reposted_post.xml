<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentRepostedPostRoot"
    android:focusable="true"
    android:visibility="gone"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/item_gap_l"
    android:layout_marginTop="@dimen/item_gap_m"
    android:layout_marginRight="@dimen/item_gap_l"
    android:layout_marginBottom="@dimen/item_gap_m"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    app:cardBackgroundColor="@color/transparent"
    app:cardCornerRadius="@dimen/shape_radius_m"
    app:cardElevation="@dimen/item_gap_null"
    app:strokeColor="?attr/titleTextColorLowgray"
    app:strokeWidth="@dimen/item_gap_xxxs">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="@dimen/item_gap_xs"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/parentRepostedPostUserInfo"
            android:paddingTop="@dimen/item_gap_s"
            android:paddingBottom="@dimen/item_gap_s"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/ivRepostedPostUserProfile"
                android:layout_width="@dimen/avatar_size_xs"
                android:layout_height="@dimen/avatar_size_xs"
                android:layout_marginLeft="@dimen/item_gap_m"
                android:layout_marginRight="@dimen/item_gap_m"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/ivRepostedPostUserProfile"
                android:layout_centerVertical="true">
                <TextView
                    android:id="@+id/tvRepostedPostUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/SbTextView.BodyDefault"/>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tvRepostedPostCommentContent"
            android:paddingBottom="@dimen/item_gap_m"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_m"
            android:layout_marginTop="@dimen/item_gap_s"
            android:layout_marginRight="@dimen/item_gap_m"
            android:maxLines="7"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/parentRepostedPostUserInfo"
            app:layout_goneMarginBottom="@dimen/shape_radius_l"
            app:layout_goneMarginTop="@dimen/shape_radius_l"
            style="@style/SbTextView.StreamListContent"/>
        <ImageView
            android:id="@+id/ivRepostedPostCommentImage"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:scaleType="centerCrop"
            android:contentDescription="@string/hint_post_image"
            app:layout_constraintDimensionRatio="v,16:9"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvRepostedPostCommentContent"/>
        <Space
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/item_gap_m"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivRepostedPostCommentImage"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
