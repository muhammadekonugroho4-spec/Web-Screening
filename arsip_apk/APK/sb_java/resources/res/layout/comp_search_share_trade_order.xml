<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_search"
    android:tag="layout/comp_search_share_trade_order_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <EditText
        android:textColorHint="?attr/themeColorTextTetriary"
        android:id="@+id/et_search_input"
        android:background="@drawable/bg_border_gray_rounded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/height_35"
        android:hint="@string/text_share_trade_order_search_hint"
        android:layout_centerVertical="true"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionSearch"
        android:paddingHorizontal="@dimen/item_gap_35"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SbEditTextStyle.GrayBackground"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/ib_search_button"
        android:padding="@dimen/item_gap_xs"
        android:layout_width="@dimen/clickable_size_20"
        android:layout_height="@dimen/clickable_size_20"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:contentDescription="@string/hint_search_content"
        android:layout_marginStart="@dimen/item_gap_s"
        app:layout_constraintBottom_toBottomOf="@+id/et_search_input"
        app:layout_constraintStart_toStartOf="@+id/et_search_input"
        app:layout_constraintTop_toTopOf="@+id/et_search_input"
        app:srcCompat="@drawable/ic_android_search"
        app:tint="@color/highgray_light"/>
    <ImageButton
        android:id="@+id/ib_clear_query"
        android:background="@null"
        android:padding="@dimen/spacing_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:contentDescription="@string/hint_clear_search_text"
        android:layout_marginHorizontal="@dimen/spacing_6"
        app:layout_constraintBottom_toBottomOf="@+id/et_search_input"
        app:layout_constraintEnd_toEndOf="@+id/et_search_input"
        app:layout_constraintTop_toTopOf="@+id/et_search_input"
        app:srcCompat="@drawable/ic_clear_search_share_trade"/>
</androidx.constraintlayout.widget.ConstraintLayout>
