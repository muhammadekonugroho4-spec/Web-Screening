<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_registration_blocker_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/vgTradingSecurityListHeader"
        android:background="@drawable/bg_top_rounded"
        android:paddingTop="@dimen/item_gap_20"
        android:paddingBottom="@dimen/item_gap_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_close"
            android:layout_width="@dimen/item_gap_10"
            android:layout_height="@dimen/item_gap_10"
            android:src="0x7f080644"
            android:tint="?attr/titleTextColorLowgray"
            android:layout_marginEnd="@dimen/item_gap_20"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvTradingSecurityListLayout"
        android:background="?attr/themeContentBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/vgTradingSecurityListHeader">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/rlTradingSecurityListMainLayout"
            android:background="?attr/themeDialogBackgroundColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/aciv_content"
                    android:background="@drawable/bg_green_icon"
                    android:padding="@dimen/item_gap_11"
                    android:layout_width="@dimen/item_gap_58"
                    android:layout_height="@dimen/item_gap_58"
                    android:src="@drawable/ic_lamp_green"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="center"
                    android:id="@+id/actv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/height_24"
                    android:text="@string/lbl_trading_registratoin_blocker_1"
                    android:textAlignment="center"
                    android:paddingStart="@dimen/item_gap_50"
                    android:paddingEnd="@dimen/item_gap_50"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/aciv_content"
                    style="@style/SbTextView.ListTitle.Highempasis.Normal"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="center"
                    android:id="@+id/actv_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_16"
                    android:text="@string/lbl_trading_registratoin_blocker_2"
                    android:textAlignment="center"
                    android:paddingStart="@dimen/item_gap_50"
                    android:paddingEnd="@dimen/item_gap_50"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/actv_title"
                    style="@style/SbTextView.ListTitle.Highempasis.Normal"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:textSize="13sp"
                    android:id="@+id/btn_cs"
                    android:tag="binding_1"
                    android:background="@drawable/border_green_button"
                    android:paddingTop="@dimen/item_gap_10"
                    android:paddingBottom="@dimen/item_gap_10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_24"
                    android:layout_marginBottom="@dimen/item_gap_40"
                    android:text="Chat Live Support"
                    android:drawablePadding="4dp"
                    android:drawableStart="@drawable/ic_live_support"
                    android:paddingStart="@dimen/item_gap_12"
                    android:paddingEnd="@dimen/item_gap_12"
                    app:drawableTint="@color/green_text"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/actv_desc"
                    style="@style/SbBtnBorderless.Small"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
