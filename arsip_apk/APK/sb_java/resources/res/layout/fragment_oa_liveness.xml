<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_oa_liveness_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_liveness"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_alignParentTop="true"
        app:layout_collapseMode="pin"
        app:layout_scrollFlags="enterAlways|scroll">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/tv_oa_liveness_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_liveness_test_process"
            style="@style/SbTextView.BodyDefault.Bold"/>
    </androidx.appcompat.widget.Toolbar>
    <ViewFlipper
        android:id="@+id/vf_oa_liveness"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar_liveness">
        <ScrollView
            android:id="@+id/sv_oa_liveness_preparation"
            android:paddingBottom="@dimen/clickable_size_48"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:tag="binding_1"
                android:paddingBottom="@dimen/spacing_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_liveness_icon"
                    android:layout_width="@dimen/width_70"
                    android:layout_height="@dimen/height_70"
                    android:layout_marginTop="@dimen/item_gap_20"
                    android:src="?attr/themeIconLivenessPreparation"
                    android:layout_marginStart="@dimen/item_gap_20"
                    android:layout_marginEnd="@dimen/item_gap_20"/>
                <TextView
                    android:textSize="@dimen/text_size_18"
                    android:id="@+id/tv_verification_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_20"
                    android:layout_marginBottom="@dimen/item_gap_8"
                    android:text="@string/title_liveness_test"
                    android:layout_below="@+id/iv_liveness_icon"
                    android:layout_marginStart="@dimen/item_gap_20"
                    android:layout_marginEnd="@dimen/item_gap_20"
                    style="@style/TypeStyles.HeadlineRegular"/>
                <TextView
                    android:textColor="@color/highgray_light"
                    android:id="@+id/tv_verification_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/item_gap_20"
                    android:text="@string/text_liveness_oa_desc"
                    android:layout_below="@+id/tv_verification_title"
                    android:layout_marginStart="@dimen/item_gap_20"
                    android:layout_marginEnd="@dimen/item_gap_20"
                    style="@style/TypeStyles.BodyRegular"/>
                <include
                    android:id="@+id/oa_liveness_instruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_verification_content"
                    android:layout_marginStart="@dimen/item_gap_20"
                    android:layout_marginEnd="@dimen/item_gap_20"
                    android:layout_alignParentStart="true"
                    layout="@layout/fragment_liveness_instruction"/>
            </RelativeLayout>
        </ScrollView>
        <ViewStub
            android:id="@+id/vs_oa_liveness_success"
            android:layout="@layout/comp_liveness_success"
            android:inflatedId="@+id/inflate_comp_liveness_success"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ViewStub
            android:id="@+id/vs_oa_liveness_timeout"
            android:layout="@layout/comp_liveness_failed"
            android:inflatedId="@+id/inflate_comp_liveness_failed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ViewStub
            android:id="@+id/vs_oa_liveness_face_failed"
            android:layout="@layout/comp_liveness_failed"
            android:inflatedId="@+id/inflate_comp_liveness_failed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </ViewFlipper>
    <include
        android:id="@+id/layout_data_privacy_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_20"
        android:layout_above="@+id/btn_start_liveness"
        android:layout_marginHorizontal="@dimen/spacing_20"
        layout="@layout/comp_data_privacy_info"/>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/btn_start_liveness"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        android:layout_marginBottom="@dimen/spacing_20"
        android:text="@string/button_liveness_test_start"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="@dimen/spacing_20"/>
</RelativeLayout>
