<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlSearchBarRoundedSearching"
    android:tag="layout/comp_search_bar_rounded_bg_0"
    android:background="@drawable/bg_searchbar_gray_rounded"
    android:layout_width="match_parent"
    android:layout_height="@dimen/clickable_size_40"
    android:layout_margin="@dimen/item_gap_m"
    android:layout_marginTop="@dimen/item_gap_s">
    <ProgressBar
        android:id="@+id/ivSearchBarRoundedIndicator"
        android:visibility="gone"
        android:layout_width="@dimen/clickable_size_18"
        android:layout_height="@dimen/clickable_size_18"
        android:layout_marginLeft="@dimen/item_gap_m"
        android:indeterminate="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/item_gap_m"
        android:indeterminateTint="?attr/themeIconTintColor"/>
    <ImageView
        android:id="@+id/ivSearchBarRoundedSearchIcon"
        android:layout_width="@dimen/clickable_size_18"
        android:layout_height="@dimen/clickable_size_18"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/item_gap_10"
        app:srcCompat="@drawable/ic_android_search"
        app:tint="@color/highgray_light"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textColorHint="?attr/themeColorTextTetriary"
        android:id="@+id/etSearchBarRoundedSearch"
        android:background="@null"
        android:paddingLeft="@dimen/item_gap_m"
        android:paddingRight="@dimen/item_gap_l"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_height_m"
        android:hint="@string/placeholder_search"
        android:layout_toRightOf="@+id/ivSearchBarRoundedSearchIcon"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:paddingStart="@dimen/item_gap_m"
        android:paddingEnd="@dimen/item_gap_l"
        android:layout_toEndOf="@+id/ivSearchBarRoundedSearchIcon"
        style="@style/SbEditTextStyle"/>
    <ImageView
        android:id="@+id/ibSearchBarRoundedSearchClearQuery"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="?attr/themeCloseCircle"
        android:scaleType="fitCenter"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/item_gap_10"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
