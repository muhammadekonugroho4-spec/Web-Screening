<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_compose_single_image"
    android:tag="layout/item_attachment_single_image_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/item_gap_8"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="@dimen/shape_radius_8"
    app:cardElevation="@dimen/item_gap_null"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/parent_compose_post_single_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_compose_post_single_image"
            android:tag="binding_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:minHeight="168dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/ib_delete_compose_post_single_image"
            android:tag="binding_2"
            android:background="@drawable/circle_black_solid_background"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:layout_marginTop="@dimen/item_gap_s"
            android:layout_marginRight="@dimen/item_gap_s"
            android:scaleX="0"
            android:scaleY="0"
            android:layout_marginEnd="@dimen/item_gap_s"
            android:backgroundTint="#a6000000"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="0x7f08063f"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_compose_single_post_gif_tag"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="20dp"
            android:layout_marginLeft="@dimen/item_gap_m"
            android:layout_marginBottom="@dimen/item_gap_s"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:srcCompat="@drawable/ic_gif_button"
            app:tint="@color/highgray_light"/>
        <FrameLayout
            android:id="@+id/fl_compression_loading_overlay"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:indeterminate="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_compose_post_single_image"
            app:layout_constraintEnd_toEndOf="@+id/iv_compose_post_single_image"
            app:layout_constraintStart_toStartOf="@+id/iv_compose_post_single_image"
            app:layout_constraintTop_toTopOf="@+id/iv_compose_post_single_image">
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:layout_gravity="center"
                android:id="@+id/cpi_compression_loading_single"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/light_green_green50"
                app:indicatorSize="24dp"
                app:trackColor="@android:color/transparent"
                app:trackCornerRadius="3dp"
                app:trackThickness="2dp"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/fl_compression_retry_overlay"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_compose_post_single_image"
            app:layout_constraintEnd_toEndOf="@+id/iv_compose_post_single_image"
            app:layout_constraintStart_toStartOf="@+id/iv_compose_post_single_image"
            app:layout_constraintTop_toTopOf="@+id/iv_compose_post_single_image">
            <androidx.appcompat.widget.AppCompatImageButton
                android:layout_gravity="center"
                android:id="@+id/ib_compression_retry_single"
                android:background="@android:color/transparent"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:srcCompat="@drawable/ic_error_create_post_image_compress"/>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
