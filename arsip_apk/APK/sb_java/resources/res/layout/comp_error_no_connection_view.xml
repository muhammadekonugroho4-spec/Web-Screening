<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/parent_clickable_reload"
    android:tag="layout/comp_error_no_connection_view_0"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:padding="@dimen/item_gap_l"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_refresh_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/btn_tap_to_refresh"
        app:srcCompat="0x7f08084e"/>
    <TextView
        android:textSize="@dimen/text_size_18"
        android:gravity="center"
        android:id="@+id/tv_error_tittle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_14"
        android:text="@string/error_message_no_connection"
        style="@style/TypeStyles.HeadlineRegular"/>
    <TextView
        android:textSize="@dimen/text_size_16"
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="center"
        android:id="@+id/tv_error_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_8"
        android:text="@string/error_message_no_connection_subtitle"
        style="@style/TypeStyles.BodyLarge"/>
    <com.stockbit.uikit.button.EllipseButton
        android:id="@+id/btn_retry_network"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_14"
        android:text="@string/btn_tap_to_reload"/>
</LinearLayout>
