<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_invitation_0"
    android:background="@drawable/bg_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="343dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <View
        android:id="@+id/view_rounded"
        android:background="@drawable/bg_rounded_modal_indicator"
        android:layout_width="@dimen/clickable_size_38"
        android:layout_height="@dimen/item_gap_5"
        android:layout_marginTop="@dimen/item_gap_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.stockbit.uikit.layout.BitRoundedLayout
        android:id="@+id/brl_group_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_24"
        android:layout_marginStart="@dimen/item_gap_20"
        app:isFullRounded="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_rounded"
        app:roundedColor="@color/transparent">
        <ImageView
            android:id="@+id/iv_group_image"
            android:tag="binding_1"
            android:layout_width="@dimen/width_50"
            android:layout_height="@dimen/height_50"/>
    </com.stockbit.uikit.layout.BitRoundedLayout>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_group_name"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_6"
        android:maxLines="1"
        android:layout_marginStart="@dimen/item_gap_16"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/brl_group_image"
        app:layout_constraintTop_toTopOf="@+id/brl_group_image"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:textColor="?attr/themeContentTextColorSecondary"
        android:ellipsize="end"
        android:id="@+id/tv_group_created"
        android:tag="binding_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_6"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/brl_group_image"
        app:layout_constraintEnd_toEndOf="@+id/tv_group_name"
        app:layout_constraintStart_toStartOf="@+id/tv_group_name"
        style="@style/TypeStyles.BodyRegular"/>
    <View
        android:id="@+id/v_divider"
        android:background="?attr/themeColorModalsDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_1"
        android:layout_marginTop="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/brl_group_image"/>
    <TextView
        android:id="@+id/tv_total_members"
        android:tag="binding_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:layout_marginStart="@dimen/item_gap_20"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_divider"
        style="@style/TypeStyles.HeadingRegular"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/rv_members"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_8"
        android:paddingHorizontal="@dimen/item_gap_10"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_total_members"/>
    <androidx.constraintlayout.widget.Group
        android:tag="binding_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="brl_group_image, tv_group_name, tv_group_created, v_divider, tv_total_members, rv_members"/>
    <ImageView
        android:id="@+id/iv_not_found"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_24"
        android:src="?attr/themeIconGroupNotFound"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_rounded"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_not_found_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:text="@string/chat_group_invitation_not_found_title"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_not_found"
        style="@style/TypeStyles.HeadingLarge"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_not_found_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_8"
        android:text="@string/chat_group_invitation_not_found_subtitle"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_not_found_title"
        style="@style/TypeStyles.BodyRegular"/>
    <com.google.android.material.button.MaterialButton
        android:textAppearance="@style/TypeStyles.HeadingRegular"
        android:textColor="?attr/themeColorTextPrimary"
        android:id="@+id/btn_close"
        android:tag="binding_6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:layout_marginBottom="@dimen/item_gap_32"
        android:text="@string/hint_close"
        android:textAllCaps="false"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:cornerRadius="@dimen/item_gap_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_not_found_subtitle"
        app:strokeColor="?attr/themeColorModalsBorder"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    <androidx.constraintlayout.widget.Group
        android:tag="binding_7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="iv_not_found, tv_not_found_title, tv_not_found_subtitle, btn_close"/>
    <com.stockbit.uikit.layout.BitRoundedLayout
        android:id="@+id/brl_hide_member_group_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_36"
        app:isFullRounded="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_rounded"
        app:roundedColor="@color/transparent">
        <ImageView
            android:id="@+id/iv_hide_member_group_image"
            android:tag="binding_8"
            android:layout_width="100dp"
            android:layout_height="100dp"/>
    </com.stockbit.uikit.layout.BitRoundedLayout>
    <TextView
        android:textSize="@dimen/text_size_24"
        android:textColor="?attr/themeColorTextPrimary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_hide_member_group_name"
        android:tag="binding_9"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/brl_hide_member_group_image"
        style="@style/SbTextView.PageTitle.HighEmphasis.Bold"/>
    <TextView
        android:textColor="?attr/themeContentTextColorSecondary"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_hide_member_group_created"
        android:tag="binding_10"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_hide_member_group_name"
        style="@style/TypeStyles.BodyRegular"/>
    <androidx.constraintlayout.widget.Group
        android:tag="binding_11"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="brl_hide_member_group_image, tv_hide_member_group_created, tv_hide_member_group_name"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_success_content_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="rv_members, tv_hide_member_group_created"/>
    <com.google.android.material.button.MaterialButton
        android:textAppearance="@style/TypeStyles.HeadingRegular"
        android:textColor="?attr/themeColorTextPrimary"
        android:id="@+id/btn_cancel"
        android:tag="binding_12"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32"
        android:layout_marginBottom="@dimen/item_gap_32"
        android:text="@string/button_cancel"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/item_gap_20"
        android:layout_marginEnd="@dimen/item_gap_10"
        app:cornerRadius="@dimen/item_gap_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_join_group"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrier_success_content_bottom"
        app:strokeColor="?attr/themeColorModalsBorder"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    <com.google.android.material.button.MaterialButton
        android:textAppearance="@style/TypeStyles.HeadingRegular"
        android:textColor="?attr/themeColorTextGreen"
        android:id="@+id/btn_join_group"
        android:tag="binding_13"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32"
        android:layout_marginBottom="@dimen/item_gap_32"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/item_gap_10"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:cornerRadius="@dimen/item_gap_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btn_cancel"
        app:layout_constraintTop_toBottomOf="@+id/barrier_success_content_bottom"
        app:strokeColor="?attr/themeColorModalsBorder"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
    <androidx.constraintlayout.widget.Group
        android:tag="binding_14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="btn_cancel, btn_join_group"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:tag="binding_15"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="?attr/themeColorTextGreen"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_rounded"
        app:trackCornerRadius="@dimen/item_gap_4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
