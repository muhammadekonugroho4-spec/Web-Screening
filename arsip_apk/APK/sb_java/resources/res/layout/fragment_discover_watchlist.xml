<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_discover_watchlist_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/abl_discover_watchlist"
        android:tag="binding_1"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include
            android:id="@+id/toolbar"
            layout="@layout/comp_toolbar_discover_watchlist"/>
    </com.google.android.material.appbar.AppBarLayout>
    <include
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/search_height_m"
        android:layout_below="@+id/abl_discover_watchlist"
        layout="@layout/comp_search_bar_discover_watchlist"/>
    <View
        android:id="@+id/view_discover_watchlist_top_border"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_below="@+id/search_bar"/>
    <FrameLayout
        android:id="@+id/fl_discover_watchlist"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/view_discover_watchlist_top_border">
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/srl_activity_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/nsv_discover_watchlist"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_for_you"
                        android:tag="binding_2"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginLeft="@dimen/item_gap_l"
                        android:layout_marginTop="@dimen/item_gap_l"
                        android:minHeight="105dp"
                        app:cardCornerRadius="@dimen/shape_radius_m"
                        app:cardElevation="@dimen/item_gap_null"
                        app:layout_constraintDimensionRatio="4:3"
                        app:layout_constraintHorizontal_chainStyle="spread_inside"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toLeftOf="@+id/cv_popular"
                        app:layout_constraintTop_toTopOf="parent">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:background="@drawable/ic_img_background_for_you"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:minWidth="105dp">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iv_for_you_icon"
                                android:layout_width="@dimen/clickable_size_32"
                                android:layout_height="@dimen/clickable_size_32"
                                app:layout_constraintBottom_toTopOf="@+id/tv_for_you_label"
                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintRight_toRightOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintVertical_chainStyle="packed"
                                app:srcCompat="@drawable/ic_discover_watchlist_for_you"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textColor="@color/white"
                                android:id="@+id/tv_for_you_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/item_gap_s"
                                android:text="@string/lbl_discover_watchlist_for_you"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintRight_toRightOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/iv_for_you_icon"
                                style="@style/SbTextView.PageTitle"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_popular"
                        android:tag="binding_3"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginLeft="@dimen/item_gap_m"
                        android:minHeight="105dp"
                        app:cardCornerRadius="@dimen/shape_radius_m"
                        app:cardElevation="@dimen/item_gap_null"
                        app:layout_constraintDimensionRatio="4:3"
                        app:layout_constraintLeft_toRightOf="@+id/cv_for_you"
                        app:layout_constraintRight_toLeftOf="@+id/cv_trending"
                        app:layout_constraintTop_toTopOf="@+id/cv_for_you">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:background="@drawable/ic_img_background_popular"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:minWidth="105dp">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iv_popular_icon"
                                android:layout_width="@dimen/clickable_size_32"
                                android:layout_height="@dimen/clickable_size_32"
                                app:layout_constraintBottom_toTopOf="@+id/iv_popular_label"
                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintRight_toRightOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintVertical_chainStyle="packed"
                                app:srcCompat="@drawable/ic_discover_watchlist_popular"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textColor="@color/white"
                                android:id="@+id/iv_popular_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/item_gap_s"
                                android:text="@string/lbl_discover_watchlist_popular"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintRight_toRightOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/iv_popular_icon"
                                style="@style/SbTextView.PageTitle"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cv_trending"
                        android:tag="binding_4"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginLeft="@dimen/item_gap_m"
                        android:layout_marginRight="@dimen/item_gap_l"
                        android:minHeight="105dp"
                        app:cardCornerRadius="@dimen/shape_radius_m"
                        app:cardElevation="@dimen/item_gap_null"
                        app:layout_constraintDimensionRatio="4:3"
                        app:layout_constraintLeft_toRightOf="@+id/cv_popular"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/cv_for_you">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:background="@drawable/ic_img_background_trending"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:minWidth="105dp">
                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iv_trending_icon"
                                android:layout_width="@dimen/clickable_size_32"
                                android:layout_height="@dimen/clickable_size_32"
                                app:layout_constraintBottom_toTopOf="@+id/iv_trending_label"
                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintRight_toRightOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintVertical_chainStyle="packed"
                                app:srcCompat="@drawable/ic_discover_watchlist_trending"/>
                            <androidx.appcompat.widget.AppCompatTextView
                                android:textColor="@color/white"
                                android:id="@+id/iv_trending_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/item_gap_s"
                                android:text="@string/lbl_discover_watchlist_trending"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintLeft_toLeftOf="parent"
                                app:layout_constraintRight_toRightOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/iv_trending_icon"
                                style="@style/SbTextView.PageTitle"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_discover_catalog"
                        android:clipToPadding="false"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/cv_trending"/>
                    <TextView
                        android:textStyle="normal"
                        android:id="@+id/tv_discover_sector_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/item_gap_l"
                        android:layout_marginTop="@dimen/clickable_size_24"
                        android:text="@string/text_sectors"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/rv_discover_catalog"
                        style="@style/TypeStyles.BodyRegular"/>
                    <androidx.recyclerview.widget.RecyclerView
                        android:orientation="vertical"
                        android:id="@+id/rv_discover_sector"
                        android:tag="binding_5"
                        android:paddingTop="@dimen/item_gap_m"
                        android:clipToPadding="false"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/spacing_12"
                        app:layoutManager="GridLayoutManager"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_discover_sector_title"
                        app:spanCount="3"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
        <RelativeLayout
            android:id="@+id/rl_search_result"
            android:background="@color/background_black_70_alpha"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_search_watchlist_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
    </FrameLayout>
</RelativeLayout>
