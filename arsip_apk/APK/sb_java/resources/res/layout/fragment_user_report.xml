<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_user_report_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleTextAppearance="@style/SbTextView.PageTitle">
        <TextView
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/user_report_title"
            style="@style/SbTextView.PageTitle"/>
    </androidx.appcompat.widget.Toolbar>
    <com.stockbit.common.uikit.StockbitDropdown
        android:textColor="?attr/titleTextColorHighempasis"
        android:id="@+id/sd_report_type"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:layout_marginStart="@dimen/item_gap_20"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:dropdownHint="@string/user_report_type_subtitle"
        app:dropdownLabel="@string/user_report_type_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32"
        app:layout_constraintEnd_toEndOf="@+id/sd_report_type"
        app:layout_constraintStart_toStartOf="@+id/sd_report_type"
        app:layout_constraintTop_toBottomOf="@+id/sd_report_type">
        <TextView
            android:textColor="?attr/titleTextColorHighempasis"
            android:id="@+id/tv_label_reason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/user_report_reason_title"
            style="@style/SbTextView.Dropdown.Title"/>
        <EditText
            android:textColorHint="?attr/titleTextColorMidgray"
            android:gravity="start|top"
            android:layout_gravity="center_vertical"
            android:id="@+id/et_report_message"
            android:tag="binding_2"
            android:background="@null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_8"
            android:hint="@string/user_report_reason_hint"
            android:maxLines="5"
            android:inputType="textMultiLine"
            android:importantForAutofill="no"
            style="@style/SbEditTextStyle"/>
        <View
            android:background="?attr/titleTextColorLowgray"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/item_gap_4"/>
    </LinearLayout>
    <Button
        android:id="@+id/btn_cancel"
        android:tag="binding_3"
        android:background="@drawable/border_green_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_32"
        android:foreground="?attr/selectableItemBackground"
        android:text="@string/btn_negative_cancel"
        android:layout_marginStart="@dimen/item_gap_20"
        android:layout_marginEnd="@dimen/item_gap_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_confirm"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/SbBtnBorderless.Default"/>
    <Button
        android:id="@+id/btn_confirm"
        android:tag="binding_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_32"
        android:text="@string/confirm"
        android:layout_marginStart="@dimen/item_gap_8"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_cancel"
        style="@style/SbBtn.PrimaryFullWidthFloating"/>
</androidx.constraintlayout.widget.ConstraintLayout>
