<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/text_size_14"
        android:id="@+id/tvStockbitWithdrawalSkeletonTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:text="@string/setting_withdrawal_title"
        android:layout_centerHorizontal="true"
        style="@style/SbTextView.BodyDefault.Bold"/>
    <View
        android:id="@+id/tvStockbitWithdrawalSkeletonDate"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_24"
        android:layout_marginTop="@dimen/item_gap_xs"
        android:layout_below="@+id/tvStockbitWithdrawalSkeletonTitle"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/item_gap_20"
        android:layout_marginEnd="@dimen/item_gap_20"/>
    <View
        android:id="@+id/tvStockbitWithdrawalSkeletonBalance"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_36"
        android:layout_marginTop="@dimen/item_gap_20"
        android:layout_below="@+id/tvStockbitWithdrawalSkeletonDate"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/item_gap_20"
        android:layout_marginEnd="@dimen/item_gap_20"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:id="@+id/tvStockbitWithdrawalSkeletonNominalTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_40"
        android:text="@string/setting_withdrawal_amount"
        android:layout_below="@+id/tvStockbitWithdrawalSkeletonBalance"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/item_gap_20"
        android:layout_alignParentStart="true"
        style="@style/SbTextView.BodyDefault.Bold"/>
    <View
        android:id="@+id/etStockbitWithdrawNominal"
        android:background="@drawable/bg_rounded_gray"
        android:paddingTop="@dimen/item_gap_13"
        android:paddingBottom="@dimen/item_gap_14"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_36"
        android:layout_marginLeft="@dimen/item_gap_20"
        android:layout_marginTop="@dimen/item_gap_m"
        android:layout_marginRight="@dimen/item_gap_20"
        android:layout_marginBottom="@dimen/item_gap_m"
        android:layout_below="@+id/tvStockbitWithdrawalSkeletonNominalTitle"
        android:paddingStart="@dimen/item_gap_20"
        android:paddingEnd="@dimen/item_gap_20"
        android:layout_marginStart="@dimen/item_gap_20"
        android:layout_marginEnd="@dimen/item_gap_20"
        style="@style/SbEditTextStyle.Medium"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:id="@+id/tvWithdrawalTransferTarikSemuaSaldo"
        android:paddingTop="@dimen/item_gap_m"
        android:paddingBottom="@dimen/item_gap_m"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_m"
        android:text="@string/setting_tarik_semua_saldo"
        android:layout_toLeftOf="@+id/switchWithdrawalTransferTarikSemuaSaldo"
        android:layout_below="@+id/etStockbitWithdrawNominal"
        style="@style/SbTextView.BodyDefault"/>
    <androidx.appcompat.widget.SwitchCompat
        android:theme="@style/SbSwitch.Regular"
        android:id="@+id/switchWithdrawalTransferTarikSemuaSaldo"
        android:padding="@dimen/item_gap_m"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_l"
        android:layout_below="@+id/etStockbitWithdrawNominal"
        android:layout_alignParentRight="true"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:id="@+id/tvStockbitWithdrawalSkeletonTransferTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:text="@string/setting_withdrawal_transfer_to"
        android:layout_below="@+id/tvWithdrawalTransferTarikSemuaSaldo"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/item_gap_20"
        android:layout_alignParentStart="true"
        style="@style/SbTextView.BodyDefault.Bold"/>
    <RelativeLayout
        android:id="@+id/rlStockbitWithdrawTransferAccount"
        android:background="@drawable/border_gray_rounded_transparent_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_m"
        android:layout_below="@+id/tvStockbitWithdrawalSkeletonTransferTitle"
        android:layout_marginStart="@dimen/item_gap_20"
        android:layout_marginEnd="@dimen/item_gap_20">
        <View
            android:id="@+id/tvRekeningBankIconNasabahValue"
            android:background="@drawable/bg_rounded_gray"
            android:paddingTop="@dimen/item_gap_xs"
            android:paddingBottom="@dimen/item_gap_xs"
            android:layout_width="@dimen/width_m"
            android:layout_height="@dimen/height_36"
            android:layout_marginTop="@dimen/item_gap_l"
            android:paddingStart="@dimen/item_gap_m"
            android:paddingEnd="@dimen/item_gap_m"
            android:layout_marginStart="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/item_gap_m"
            style="@style/SbTextView.BodyDefault"/>
        <View
            android:id="@+id/tvRekeningBankNasabahValue"
            android:background="@drawable/bg_rounded_gray"
            android:paddingTop="@dimen/item_gap_xs"
            android:paddingBottom="@dimen/item_gap_xs"
            android:layout_width="@dimen/width_l"
            android:layout_height="@dimen/height_36"
            android:layout_marginTop="@dimen/item_gap_l"
            android:layout_toRightOf="@+id/tvRekeningBankIconNasabahValue"
            android:layout_marginStart="@dimen/item_gap_m"
            android:layout_marginEnd="@dimen/item_gap_20"
            style="@style/SbTextView.BodyDefault.Bold.Semi"/>
        <View
            android:id="@+id/tvRekeningBankNamaNasabahValue"
            android:background="@drawable/bg_rounded_gray"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_36"
            android:layout_marginTop="@dimen/item_gap_m"
            android:layout_marginBottom="@dimen/item_gap_18"
            android:layout_below="@+id/tvRekeningBankNasabahValue"
            android:layout_marginStart="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/item_gap_20"
            style="@style/SbTextView.BodyDefault"/>
    </RelativeLayout>
    <View
        android:textSize="@dimen/text_size_16"
        android:id="@+id/btnStockbitWithdrawalSkeletonSubmit"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_44"
        android:text="@string/title_withdrawal_submit"
        android:layout_alignParentBottom="true"
        android:textAllCaps="false"/>
</RelativeLayout>
