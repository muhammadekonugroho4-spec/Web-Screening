<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_broker_code_dialog_0"
    android:background="@drawable/bg_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingVertical="@dimen/item_gap_12"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_broker_code_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/rectangle_dialog"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_glossary_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:text="@string/title_orderbook_code_broker"
            android:paddingVertical="@dimen/item_gap_10"
            app:layout_constraintTop_toBottomOf="@+id/iv_line"
            style="@style/TypeStyles.HeadingLarge"/>
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cg_broker_code"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/item_gap_18"
            android:paddingEnd="@dimen/item_gap_20"
            android:paddingVertical="@dimen/item_gap_11"
            app:chipSpacingHorizontal="@dimen/item_gap_s"
            app:layout_constraintTop_toBottomOf="@+id/tv_glossary_title"
            app:singleLine="true"
            app:singleSelection="true"/>
        <TextView
            android:id="@+id/tv_broker_code_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:minWidth="@dimen/row_width_bandar_broker_code"
            android:text="@string/title_orderbook_name_code"
            android:layout_marginHorizontal="@dimen/item_gap_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cg_broker_code"
            style="@style/TypeStyles.HeadingRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ViewFlipper
        android:id="@+id/vf_broker_code"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/cl_broker_code_header">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/item_gap_8">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_broker_code"
                android:tag="binding_1"
                android:paddingTop="@dimen/item_gap_4"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/progress"
                android:tag="binding_2"
                android:layout_width="@dimen/clickable_size_32"
                android:layout_height="@dimen/clickable_size_32"/>
        </FrameLayout>
    </ViewFlipper>
</RelativeLayout>
