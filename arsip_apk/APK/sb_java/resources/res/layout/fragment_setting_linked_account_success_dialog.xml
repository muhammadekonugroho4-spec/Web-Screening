<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme"
    android:tag="layout/fragment_setting_linked_account_success_dialog_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/vgStockbitWithdrawalDialogHeader"
        android:background="@drawable/bg_top_rounded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/height_44">
        <View
            android:id="@+id/viewSheetMutualFundSummary"
            android:background="@drawable/bg_rounded_gray_gray_bg"
            android:layout_width="@dimen/clickable_size_64"
            android:layout_height="@dimen/item_gap_s"
            android:layout_margin="@dimen/item_gap_20"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/parentStockbitWithdrawalDialog"
        android:background="?attr/themeDialogBackgroundColor"
        android:paddingTop="@dimen/item_gap_l"
        android:paddingBottom="@dimen/item_gap_64"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/vgStockbitWithdrawalDialogHeader">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="@dimen/avatar_size_xl"
            android:layout_height="@dimen/avatar_size_xl"
            app:srcCompat="@drawable/ic_withdrawal_confirmation_success_icon"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:layout_gravity="center"
            android:id="@+id/tvStockbitWithdrawalSuccessDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_40"
            android:layout_marginBottom="@dimen/item_gap_l"
            android:text="@string/n_dash"
            style="@style/SbTextView.BodyDefault.Bold"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tvStockbitWithdrawalSuccessDialogSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/item_gap_l"
            android:textAlignment="gravity"
            style="@style/SbTextView.BodyDefault"/>
    </LinearLayout>
</RelativeLayout>
