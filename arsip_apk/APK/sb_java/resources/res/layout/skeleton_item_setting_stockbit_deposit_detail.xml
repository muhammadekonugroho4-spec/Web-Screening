<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/text_size_12"
        android:id="@+id/viewSettingStockbitDepositDetailTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_20"
        android:layout_marginTop="@dimen/item_gap_20"
        android:text="@string/setting_stockbit_deposit_detail_rekening_rdn"
        android:layout_alignParentStart="true"
        style="@style/SbTextView.BodySecondary.Bold.Semi"/>
    <View
        android:id="@+id/viewSettingStockbitDepositDetailRdnBank"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_72"
        android:layout_height="@dimen/clickable_size_20"
        android:layout_marginLeft="@dimen/item_gap_20"
        android:layout_marginTop="@dimen/item_gap_m"
        android:layout_marginBottom="@dimen/item_gap_m"
        android:layout_below="@+id/viewSettingStockbitDepositDetailTitle"/>
    <View
        android:id="@+id/viewSettingStockbitDepositDetailRdnNumber"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_162"
        android:layout_height="@dimen/clickable_size_20"
        android:layout_marginTop="@dimen/item_gap_m"
        android:layout_marginBottom="@dimen/item_gap_m"
        android:layout_toRightOf="@+id/viewSettingStockbitDepositDetailRdnBank"
        android:layout_below="@+id/viewSettingStockbitDepositDetailTitle"
        android:layout_marginStart="@dimen/item_gap_l"/>
    <TextView
        android:id="@+id/viewSettingStockbitDepositDetailRdnSalin"
        android:layout_width="@dimen/width_s"
        android:layout_height="@dimen/clickable_size_20"
        android:layout_marginTop="@dimen/item_gap_m"
        android:layout_marginRight="@dimen/item_gap_20"
        android:layout_marginBottom="@dimen/item_gap_m"
        android:text="@string/setting_salin"
        android:layout_below="@+id/viewSettingStockbitDepositDetailTitle"
        android:layout_marginStart="@dimen/item_gap_l"
        android:layout_alignParentEnd="true"
        style="@style/SbTextView.BodyDefault.Green.Bold"/>
    <View
        android:id="@+id/viewSettingStockbitDepositDetailRdnName"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_162"
        android:layout_height="@dimen/clickable_size_20"
        android:layout_marginLeft="@dimen/item_gap_20"
        android:layout_marginBottom="@dimen/item_gap_28"
        android:layout_below="@+id/viewSettingStockbitDepositDetailRdnBank"/>
    <View
        android:id="@+id/viewSeparatorSettingStockbitDepositDetailRdnName"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginBottom="@dimen/item_gap_m"
        android:layout_below="@+id/viewSettingStockbitDepositDetailRdnName"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:id="@+id/viewSettingStockbitDepositDetailMetodeTransfer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_m"
        android:layout_marginRight="@dimen/item_gap_20"
        android:layout_marginBottom="@dimen/item_gap_m"
        android:text="@string/setting_stockbit_deposit_detail_metode_transfer"
        android:layout_below="@+id/viewSeparatorSettingStockbitDepositDetailRdnName"
        android:layout_marginStart="@dimen/item_gap_l"
        style="@style/SbTextView.BodySecondary.Bold.Semi"/>
    <View
        android:id="@+id/viewSeparatorSettingStockbitDepositDetailMetodeTransfer"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_m"
        android:layout_marginBottom="@dimen/item_gap_l"
        android:layout_below="@+id/viewSettingStockbitDepositDetailMetodeTransfer"/>
    <View
        android:id="@+id/viewSettingStockbitDepositDetailAtmBca"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_162"
        android:layout_height="@dimen/clickable_size_20"
        android:layout_marginLeft="@dimen/item_gap_20"
        android:layout_below="@+id/viewSeparatorSettingStockbitDepositDetailMetodeTransfer"/>
    <View
        android:id="@+id/viewSeparatorSettingStockbitDepositDetailAtmBca"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_l"
        android:layout_marginBottom="@dimen/item_gap_l"
        android:layout_below="@+id/viewSettingStockbitDepositDetailAtmBca"/>
    <View
        android:id="@+id/viewSettingStockbitDepositDetailKlikBca"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_162"
        android:layout_height="@dimen/clickable_size_20"
        android:layout_marginLeft="@dimen/item_gap_20"
        android:layout_below="@+id/viewSeparatorSettingStockbitDepositDetailAtmBca"/>
    <View
        android:id="@+id/viewSeparatorSettingStockbitDepositDetailKlikBca"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_l"
        android:layout_marginBottom="@dimen/item_gap_l"
        android:layout_below="@+id/viewSettingStockbitDepositDetailKlikBca"/>
    <View
        android:id="@+id/viewSettingStockbitDepositDetailMobileBca"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_162"
        android:layout_height="@dimen/clickable_size_20"
        android:layout_marginLeft="@dimen/item_gap_20"
        android:layout_below="@+id/viewSeparatorSettingStockbitDepositDetailKlikBca"/>
    <View
        android:id="@+id/viewSeparatorSettingStockbitDepositDetailMobileBca"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_l"
        android:layout_marginBottom="@dimen/item_gap_l"
        android:layout_below="@+id/viewSettingStockbitDepositDetailMobileBca"/>
</RelativeLayout>
