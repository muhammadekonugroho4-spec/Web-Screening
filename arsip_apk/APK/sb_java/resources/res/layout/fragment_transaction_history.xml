<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_transaction_history_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_title_transaction_history"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:text="@string/setting_estatement_tax_periode_history"
        android:layout_marginStart="@dimen/spacing_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingRegular"/>
    <com.stockbit.estatement.utils.StockbitDateChooserTextView
        android:id="@+id/et_date_start"
        android:tag="binding_1"
        android:background="@drawable/bg_border_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:layout_marginStart="@dimen/spacing_20"
        android:layout_marginEnd="@dimen/spacing_16"
        app:layout_constraintEnd_toStartOf="@+id/tv_dash"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_transaction_history"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center"
        android:id="@+id/tv_dash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/n_dash"
        app:layout_constraintBottom_toBottomOf="@+id/et_date_start"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/et_date_start"
        style="@style/TypeStyles.HeadingRegular"/>
    <com.stockbit.estatement.utils.StockbitDateChooserTextView
        android:id="@+id/et_date_end"
        android:tag="binding_2"
        android:background="@drawable/bg_border_card"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_dash"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_transaction_history"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_warning_transaction_history"
        android:tag="binding_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_warning_red"
        android:layout_marginEnd="@dimen/spacing_8"
        app:layout_constraintEnd_toStartOf="@+id/tv_warning_transaction_history"
        app:layout_constraintTop_toTopOf="@+id/tv_warning_transaction_history"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorTextRed"
        android:id="@+id/tv_warning_transaction_history"
        android:tag="binding_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_6"
        android:layout_marginStart="@dimen/spacing_50"
        android:layout_marginEnd="@dimen/spacing_36"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_date_end"
        style="@style/TypeStyles.BodyXSmall"/>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/btn_ok"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_40"
        android:text="@string/setting_estatement_send_email"
        android:layout_marginStart="@dimen/spacing_20"
        android:layout_marginEnd="@dimen/spacing_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_warning_transaction_history"/>
</androidx.constraintlayout.widget.ConstraintLayout>
