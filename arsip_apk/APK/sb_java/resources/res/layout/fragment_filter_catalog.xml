            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:srcCompat="?attr/themeIconRadioRoundChecked"
            app:tint="@color/green_text"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llTopLoserSortLayout"
        android:tag="binding_5"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:paddingHorizontal="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_8">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvSortCatalogByTopLoser"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/lbl_catalog_top_loser_sort_title"
            android:layout_weight="0.1"
            style="@style/TypeStyles.BodyRegular"/>
        <ImageView
            android:id="@+id/ivSortCatalogByTopLoser"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:srcCompat="?attr/themeIconRadioRoundChecked"
            app:tint="@color/green_text"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llPriceHighestSortLayout"
        android:tag="binding_6"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:paddingHorizontal="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_8">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvSortCatalogByPriceHighest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/lbl_catalog_price_highest_sort_title"
            android:layout_weight="0.1"
            style="@style/TypeStyles.BodyRegular"/>
        <ImageView
            android:id="@+id/ivSortCatalogByPriceHighest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:srcCompat="?attr/themeIconRadioRoundChecked"
            app:tint="@color/green_text"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llPriceLowestSortLayout"
        android:tag="binding_7"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:paddingHorizontal="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_8">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvSortCatalogByPriceLowest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
