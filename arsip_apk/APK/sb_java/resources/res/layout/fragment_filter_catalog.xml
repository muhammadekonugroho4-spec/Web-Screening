    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llMarketCapHighestSortLayout"
        android:tag="binding_8"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:paddingHorizontal="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_8">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvSortCatalogByMarketCaptHighest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/lbl_catalog_market_cap_highest_sort_title"
            android:layout_weight="0.1"
            style="@style/TypeStyles.BodyRegular"/>
        <ImageView
            android:id="@+id/ivSortCatalogByMarketCaptHighest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:srcCompat="?attr/themeIconRadioRoundChecked"
            app:tint="@color/green_text"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/llLiquidityHighestSortLayout"
        android:tag="binding_9"
        android:background="?attr/selectableItemBackground"
        android:paddingBottom="@dimen/item_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:paddingHorizontal="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_8">
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tvSortCatalogByLiquidityHighest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/lbl_catalog_liquidity_highest_sort_title"
            android:layout_weight="0.1"
            style="@style/TypeStyles.BodyRegular"/>
        <ImageView
            android:id="@+id/ivSortCatalogByLiquidityHighest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:srcCompat="?attr/themeIconRadioRoundChecked"
            app:tint="@color/green_text"/>
    </LinearLayout>
    <com.stockbit.uikit.divider.SBDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dividerVariant="thin_grey_border"/>
</LinearLayout>
