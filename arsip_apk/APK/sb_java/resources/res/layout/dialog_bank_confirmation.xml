<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_bank_confirmation_0"
    android:background="@drawable/bg_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/v_handle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/rectangle_dialog"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_title"
        android:paddingTop="@dimen/spacing_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:layout_marginBottom="@dimen/spacing_12"
        android:text="@string/confirmation_withdraw_title"
        app:layout_constraintTop_toBottomOf="@+id/v_handle"
        style="@style/TypeStyles.HeadingLarge"/>
    <RelativeLayout
        android:id="@+id/relativeLayout"
        android:background="@drawable/bg_rounded_4_transparent_colormodal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/height_30"
        android:layout_marginStart="@dimen/spacing_20"
        android:layout_marginEnd="@dimen/spacing_20"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_bank_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="start"
                android:id="@+id/tv_bank_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bank_name"
                android:layout_weight="1"
                app:layout_constraintTop_toBottomOf="@+id/v_handle"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_bank_name_value"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintTop_toBottomOf="@+id/v_handle"
                style="@style/TypeStyles.HeadingRegular"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_account_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:layout_below="@+id/ll_bank_name">
            <TextView
                android:gravity="start"
                android:id="@+id/tv_account_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bank_acc_number"
                android:layout_weight="1"
                app:layout_constraintTop_toBottomOf="@+id/v_handle"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_account_number_value"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintTop_toBottomOf="@+id/v_handle"
                style="@style/TypeStyles.HeadingRegular"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_account_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:layout_below="@+id/ll_account_number">
            <TextView
                android:gravity="start"
                android:id="@+id/tv_account_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bank_acc_holder_name"
                android:layout_weight="1"
                app:layout_constraintTop_toBottomOf="@+id/v_handle"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_account_name_value"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintTop_toBottomOf="@+id/v_handle"
                style="@style/TypeStyles.HeadingRegular"/>
        </LinearLayout>
    </RelativeLayout>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_24"
        android:text="@string/confirmation_withdraw_caption"
        app:layout_constraintEnd_toEndOf="@+id/relativeLayout"
        app:layout_constraintStart_toStartOf="@+id/relativeLayout"
        app:layout_constraintTop_toBottomOf="@+id/relativeLayout"
        style="@style/TypeStyles.Secondary"/>
    <com.stockbit.uikit.button.SecondaryButton
        android:id="@+id/btn_re_check"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_36"
        android:layout_marginBottom="@dimen/spacing_20"
        android:text="@string/lbl_edit"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_next"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_caption"
        app:layout_constraintVertical_bias="0"/>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/btn_next"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_20"
        android:text="@string/lbl_confirm"
        android:layout_marginEnd="@dimen/spacing_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_re_check"
        app:layout_constraintTop_toTopOf="@+id/btn_re_check"
        app:layout_constraintVertical_bias="0"/>
</androidx.constraintlayout.widget.ConstraintLayout>
