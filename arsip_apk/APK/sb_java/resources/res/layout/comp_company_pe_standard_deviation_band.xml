<?xml version="1.0" encoding="utf-8"?>
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentFinancialPEStandartDeviation"
    android:tag="layout/comp_company_pe_standard_deviation_band_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:paddingLeft="@dimen/item_gap_l"
    android:paddingRight="@dimen/item_gap_l"
    android:paddingBottom="@dimen/item_gap_l"
    android:layout_width="match_parent"
    android:layout_height="@dimen/fixed_max_height_fundachart"
    android:measureAllChildren="true"
    android:animateLayoutChanges="true">
    <RelativeLayout
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:id="@+id/pbFinancialPEStandartDeviation"
            android:layout_width="@dimen/clickable_size_32"
            android:layout_height="@dimen/clickable_size_32"
            android:indeterminate="true"
            android:layout_centerInParent="true"
            style="@style/Widget.AppCompat.ProgressBar"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <WebView
            android:id="@+id/chartFinancialPEStandartDeviation"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
    <RelativeLayout
        android:layout_gravity="center"
        android:id="@+id/parentFinancialPEStandartDeviationErrorLayout"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/item_gap_l"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/ivRefreshIconPEStandartDeviationError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:contentDescription="@string/btn_tap_to_refresh"
            app:srcCompat="@drawable/ic_loading"
            app:tint="?attr/themeOnPrimary"/>
        <TextView
            android:id="@+id/tvErrorCausePEStandartDeviationError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_l"
            android:text="@string/btn_tap_to_refresh"
            android:layout_below="@+id/ivRefreshIconPEStandartDeviationError"
            android:layout_centerHorizontal="true"
            style="@style/SbTextView.BodyDefault.Bold"/>
    </RelativeLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/comp_empty_explore"/>
</ViewFlipper>
