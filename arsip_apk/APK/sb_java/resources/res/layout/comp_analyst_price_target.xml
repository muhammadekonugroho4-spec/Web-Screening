<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_analyst_price_target_0"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingRegular"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/titleInfo"
        android:layout_width="@dimen/clickable_size_16"
        android:layout_height="@dimen/clickable_size_16"
        android:layout_marginStart="@dimen/item_gap_4"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintStart_toEndOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/title"
        app:srcCompat="@drawable/ic_info"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_size_14"
        android:textStyle="normal"
        android:textColor="?attr/themeTabAppearanceActive"
        android:id="@+id/subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        style="@style/TypeStyles.BodyRegular"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomGraph"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_15"
        app:layout_constraintBottom_toTopOf="@+id/priceLow">
        <View
            android:id="@+id/line"
            android:background="?attr/themeContentBackgroundDeeper"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginHorizontal="7.5dp"
            app:layout_constraintBottom_toBottomOf="@+id/lineDotStart"
            app:layout_constraintTop_toTopOf="@+id/lineDotStart"/>
        <View
            android:id="@+id/lineDotStart"
            android:background="@drawable/bg_circle"
            android:layout_width="@dimen/item_gap_15"
            android:layout_height="@dimen/item_gap_15"
            android:backgroundTint="?attr/themeContentBackgroundDeeper"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/lineDotEnd"
            android:background="@drawable/bg_circle"
            android:layout_width="@dimen/item_gap_15"
            android:layout_height="@dimen/item_gap_15"
            android:backgroundTint="?attr/themeContentBackgroundDeeper"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_35"
        android:layout_marginBottom="7.5dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottomGraph"
        app:layout_constraintEnd_toEndOf="@+id/bottomGraph"
        app:layout_constraintStart_toStartOf="@+id/bottomGraph"
        app:layout_constraintTop_toBottomOf="@+id/subtitle">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_13"
            android:textColor="?attr/themeDarkHigh"
            android:id="@+id/priceCurrent"
            android:background="@drawable/bg_rounded_6_gray"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="?attr/themeChatBalloonDateColor"
            android:paddingHorizontal="@dimen/item_gap_14"
            android:paddingVertical="@dimen/item_gap_8"
            app:layout_constraintBottom_toTopOf="@+id/priceCurrentLine"
            app:layout_constraintEnd_toStartOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/AppTabTextAppearance.Bold.NotActive"/>
        <View
            android:id="@+id/priceCurrentLine"
            android:background="?attr/themeIconTintColor"
            android:layout_width="1dp"
            android:layout_height="57dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/priceCurrentDot"
            android:background="@drawable/bg_circle"
            android:layout_width="@dimen/item_gap_15"
            android:layout_height="@dimen/item_gap_15"
            android:backgroundTint="?attr/themeIconTintColor"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/text_size_13"
            android:textColor="@color/green_text"
            android:id="@+id/priceTarget"
            android:background="@drawable/bg_rounded_6_gray"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="?attr/priceTargetBgColor"
            android:paddingHorizontal="@dimen/item_gap_14"
            android:paddingVertical="@dimen/item_gap_8"
            app:layout_constraintBottom_toTopOf="@+id/priceTargetLine"
            app:layout_constraintEnd_toStartOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/AppTabTextAppearance.Bold.NotActive"/>
        <View
            android:id="@+id/priceTargetLine"
            android:background="@color/green_text"
            android:layout_width="1dp"
            android:layout_height="@dimen/item_gap_18"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/priceTargetDot"
            android:background="@drawable/bg_circle"
            android:layout_width="@dimen/item_gap_15"
            android:layout_height="@dimen/text_size_15"
            android:backgroundTint="?attr/themeContentBackground"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="parent"
            app:srcCompat="@drawable/price_target"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_size_14"
        android:id="@+id/priceLow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/AppTabTextAppearance.Bold.NotActive"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_size_14"
        android:id="@+id/priceHigh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/AppTabTextAppearance.Bold.NotActive"/>
</androidx.constraintlayout.widget.ConstraintLayout>
