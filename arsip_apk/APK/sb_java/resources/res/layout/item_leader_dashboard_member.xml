<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ll_root"
    android:tag="layout/item_leader_dashboard_member_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tv_username"
        android:background="@drawable/bg_divider_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="28"
        android:paddingStart="@dimen/item_gap_20"
        android:paddingVertical="@dimen/item_gap_12"
        style="@style/TypeStyles.BodyXXSmall"/>
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tv_phone_number"
        android:background="@drawable/bg_divider_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="26"
        android:paddingStart="@dimen/item_gap_20"
        android:paddingVertical="@dimen/item_gap_12"
        style="@style/TypeStyles.BodyXXSmall"/>
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tv_joined_at"
        android:background="@drawable/bg_divider_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="24"
        android:paddingStart="@dimen/item_gap_20"
        android:paddingVertical="@dimen/item_gap_12"
        style="@style/TypeStyles.BodyXXSmall"/>
    <TextView
        android:textColor="?attr/themeColorTextGreen"
        android:gravity="center_vertical"
        android:id="@+id/tv_status"
        android:background="@drawable/bg_divider_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="22"
        android:textAllCaps="true"
        android:paddingStart="@dimen/item_gap_20"
        android:paddingVertical="@dimen/item_gap_12"
        style="@style/TypeStyles.BodyXXSmall"/>
</LinearLayout>
