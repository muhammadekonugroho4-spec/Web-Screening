<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_main_tab_content"
    android:tag="layout/activity_main_0"
    android:background="?attr/themeBottomNavBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_main_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/abl_main"
            android:background="?attr/themeColorSurfaceDefault"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="@dimen/item_gap_null">
            <ViewFlipper
                android:id="@+id/vf_toolbar_container"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/t_toolbar_title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <RelativeLayout
                        android:gravity="center"
                        android:layout_gravity="center_horizontal"
                        android:id="@+id/parentToolbarContentContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="?attr/actionBarSize">
                        <TextView
                            android:ellipsize="middle"
                            android:gravity="center"
                            android:id="@+id/tvToolbarTitleName"
                            android:paddingLeft="@dimen/item_gap_l"
                            android:paddingRight="@dimen/item_gap_l"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:layout_centerHorizontal="true"
                            android:textAlignment="gravity"
                            style="@style/SbTextView.PageTitle"/>
                    </RelativeLayout>
                </androidx.appcompat.widget.Toolbar>
                <include
                    android:id="@+id/comp_toolbar_e_ipo_onboarding"
                    layout="@layout/comp_toolbar_e_ipo_onboarding"/>
            </ViewFlipper>
        </com.google.android.material.appbar.AppBarLayout>
        <com.stockbit.core.ui.splitview.GutterTouchForwardingLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:baselineAligned="false"
            android:layout_weight="1">
            <com.google.android.material.navigationrail.NavigationRailView
                android:id="@+id/bnv_main_tab_left_side"
                android:visibility="gone"
                app:menu="@menu/menu_bottom_nav_main"
                style="@style/Widget.Stockbit.NavigationRail"/>
            <View
                android:id="@+id/v_separator_rail"
                android:background="?attr/themeColorSurfaceVariant"
                android:visibility="gone"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_main_layout_left_side"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="match_parent">
                <androidx.fragment.app.FragmentContainerView
                    android:name="androidx.navigation.fragment.NavHostFragment"
                    android:id="@+id/fcm_left_side"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    app:navGraph="@navigation/nav_graph_main_left_side"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_trading_withdrawal_option_left"
                    android:background="?attr/themeColorSurfaceDefault"
                    android:padding="@dimen/spacing_20"
                    android:focusable="true"
                    android:visibility="gone"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <com.stockbit.uikit.button.SecondaryNeutralButton
                        android:textColor="?attr/themeColorTextPrimary"
                        android:id="@+id/snb_trading_withdrawal_cancel_left"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/snb_trading_withdrawal_cancel"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_8"
                        app:secondaryNeutralButtonActive="true"
                        app:secondaryNeutralButtonColor="neutral"
                        app:secondaryNeutralButtonSize="defaultSize"/>
                    <com.stockbit.uikit.button.PrimaryButton
                        android:id="@+id/pb_trading_withdrawal_ok_left"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/pb_trading_withdrawal_ok"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_8"
                        app:primaryButtonActive="false"
                        app:primaryButtonColor="red"
                        app:primaryButtonSize="defaultSize"/>
                </LinearLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_gravity="center_vertical"
                android:id="@+id/divider_views"
                android:layout_width="@dimen/clickable_size_20"
                android:layout_height="wrap_content">
                <View
                    android:layout_gravity="center"
                    android:id="@+id/view_drag_handle"
                    android:background="@drawable/bg_drag_handle"
                    android:layout_width="@dimen/spacing_4"
                    android:layout_height="@dimen/height_52"/>
                <View
                    android:layout_gravity="center"
                    android:id="@+id/view_dragging_handle"
                    android:background="@drawable/bg_dragging_handle"
                    android:visibility="gone"
                    android:layout_width="@dimen/spacing_12"
                    android:layout_height="@dimen/height_52"/>
            </FrameLayout>
            <androidx.fragment.app.FragmentContainerView
                android:name="androidx.navigation.fragment.NavHostFragment"
                android:id="@+id/fcm_main_tab_content_container"
                android:paddingBottom="@dimen/bottom_navigation_height"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:defaultNavHost="true"
                app:navGraph="@navigation/nav_graph_main_app"/>
        </com.stockbit.core.ui.splitview.GutterTouchForwardingLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/bottom_nav_container"
        android:background="?attr/themeBottomNavBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/v_separator"
            android:background="?attr/themeColorSurfaceVariant"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bnv_main_tab"
                app:labelVisibilityMode="labeled"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:menu="@menu/menu_bottom_nav_main"
                style="@style/Widget.Stockbit.BottomNav"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_trading_withdrawal_option"
                android:background="?attr/themeColorSurfaceDefault"
                android:padding="@dimen/spacing_20"
                android:focusable="true"
                android:visibility="gone"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent">
                <com.stockbit.uikit.button.SecondaryNeutralButton
                    android:textColor="?attr/themeColorTextPrimary"
                    android:id="@+id/snb_trading_withdrawal_cancel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/snb_trading_withdrawal_cancel"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_8"
                    app:secondaryNeutralButtonActive="true"
                    app:secondaryNeutralButtonColor="neutral"
                    app:secondaryNeutralButtonSize="defaultSize"/>
                <com.stockbit.uikit.button.PrimaryButton
                    android:id="@+id/pb_trading_withdrawal_ok"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/pb_trading_withdrawal_ok"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_8"
                    app:primaryButtonActive="false"
                    app:primaryButtonColor="red"
                    app:primaryButtonSize="defaultSize"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</FrameLayout>
