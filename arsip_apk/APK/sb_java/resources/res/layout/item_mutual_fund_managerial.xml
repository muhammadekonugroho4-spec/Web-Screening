<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:tag="layout/item_mutual_fund_managerial_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/clickable_size_32">
    <TextView
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/tv_managerial_detail"
        android:paddingLeft="@dimen/item_gap_l"
        android:paddingTop="@dimen/item_gap_s"
        android:paddingRight="@dimen/item_gap_l"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_toLeftOf="@+id/tv_managerial_value"
        android:layout_alignParentLeft="true"
        style="@style/SbTextView.BodySecondary"/>
    <TextView
        android:gravity="right"
        android:id="@+id/tv_managerial_value"
        android:paddingLeft="@dimen/item_gap_s"
        android:paddingTop="@dimen/item_gap_s"
        android:paddingRight="@dimen/item_gap_l"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        style="@style/SbTextView.BodySecondary"/>
    <View
        android:id="@+id/view_managerial"
        android:background="@color/downgray_light"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginLeft="@dimen/item_gap_l"
        android:layout_marginTop="@dimen/item_gap_s"
        android:layout_marginRight="@dimen/item_gap_l"
        android:layout_below="@+id/tv_managerial_detail"/>
</RelativeLayout>
