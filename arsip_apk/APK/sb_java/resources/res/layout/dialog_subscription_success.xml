<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/dialog_subscription_success_0"
    android:background="@drawable/bg_top_rounded_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_20">
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/v_handle"
        android:background="@drawable/bg_rounded_gray_gray_bg"
        android:layout_width="@dimen/width_38"
        android:layout_height="@dimen/item_gap_5"
        android:layout_marginVertical="@dimen/spacing_12"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="?attr/themeIconSuccessSubscription"
        android:layout_marginVertical="@dimen/spacing_20"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_paywall_success_subscription"
        style="@style/TypeStyles.HeadlineRegular"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_subscribe_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        style="@style/TypeStyles.BodyRegular"/>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/btn_ok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_positive_oke"
        android:textAllCaps="false"
        android:layout_marginVertical="@dimen/spacing_36"/>
</LinearLayout>
