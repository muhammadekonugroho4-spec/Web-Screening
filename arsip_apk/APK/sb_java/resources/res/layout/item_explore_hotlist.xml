<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_parent"
    android:tag="layout/item_explore_hotlist_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/clickable_size_64"
    android:foreground="?attr/selectableItemBackground">
    <TextView
        android:textColor="@color/gray_text"
        android:id="@+id/tv_position"
        android:layout_width="@dimen/item_gap_m"
        android:layout_height="@dimen/item_gap_l"
        android:layout_marginStart="@dimen/item_gap_l"
        app:autoSizeMaxTextSize="@dimen/text_body"
        app:autoSizeMinTextSize="@dimen/text_badge"
        app:autoSizeTextType="uniform"
        app:layout_constraintBaseline_toBaselineOf="@+id/rl_symbol_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SbTextView.BodyDefault.Bold"/>
    <RelativeLayout
        android:id="@+id/rl_symbol_parent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/tv_position"
        app:layout_constraintRight_toLeftOf="@+id/cv_price_parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginLeft="@dimen/item_gap_l">
        <RelativeLayout
            android:id="@+id/rl_symbol_data_parent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="start"
                android:id="@+id/tv_symbol_company"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/item_gap_s"
                style="@style/SbTextView.ListTitle"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_notation_company"
                android:visibility="gone"
                android:layout_width="@dimen/avatar_size_11.5"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/item_gap_s"
                android:layout_marginEnd="@dimen/item_gap_s"
                android:layout_toEndOf="@+id/tv_symbol_company"
                app:srcCompat="@drawable/ic_notasi_khusus"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_corporate_action"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/item_gap_s"
                android:layout_marginEnd="@dimen/item_gap_s"
                android:layout_toEndOf="@+id/iv_notation_company"
                app:srcCompat="@drawable/ic_corporate_action"/>
        </RelativeLayout>
        <TextView
            android:textColor="?attr/titleTextColorMidgray"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/tv_name_company"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_2"
            android:maxLines="1"
            android:layout_below="@+id/rl_symbol_data_parent"
            android:layout_marginStart="@dimen/item_gap_s"
            style="@style/SbTextView.CaptionSecondary"/>
    </RelativeLayout>
    <androidx.cardview.widget.CardView
        android:gravity="end"
        android:id="@+id/cv_price_parent"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/watchlist_last_change_width"
        android:minHeight="@dimen/clickable_size_48"
        android:layout_marginEnd="@dimen/item_gap_m"
        app:cardBackgroundColor="?attr/themeColorSurfaceDefault"
        app:cardCornerRadius="@dimen/shape_radius_s"
        app:cardElevation="@dimen/item_gap_null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="end"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/ll_price_background"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="@dimen/watchlist_last_change_width"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <TextView
                android:gravity="bottom"
                android:id="@+id/tv_last_value"
                android:paddingLeft="@dimen/item_gap_s"
                android:paddingTop="@dimen/item_gap_s"
                android:paddingRight="@dimen/item_gap_s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="gravity"
                style="@style/SbTextView.BodyDefault.Bold"/>
            <TextView
                android:id="@+id/tv_percentage"
                android:paddingLeft="@dimen/item_gap_s"
                android:paddingRight="@dimen/item_gap_s"
                android:paddingBottom="@dimen/item_gap_s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_xxxs"
                android:maxLines="1"
                style="@style/SbTextView.CaptionSecondary"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <View
        android:id="@+id/view_separator"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_m"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_symbol_company,tv_name_company,cv_price_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
