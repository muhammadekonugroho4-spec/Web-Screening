<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menuContainer"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="@dimen/clickable_size_48"
    android:layout_height="@dimen/clickable_size_48">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/ibSetting"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="3.9dp"
        android:layout_width="@dimen/clickable_size_24"
        android:layout_height="@dimen/clickable_size_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_setting"
        app:tint="?attr/themeIconTintColor"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lavSetting"
        android:visibility="gone"
        android:layout_width="@dimen/clickable_size_32"
        android:layout_height="@dimen/clickable_size_32"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="false"
        app:lottie_rawRes="?attr/themeNotificationSettingAnimation"/>
</androidx.constraintlayout.widget.ConstraintLayout>
