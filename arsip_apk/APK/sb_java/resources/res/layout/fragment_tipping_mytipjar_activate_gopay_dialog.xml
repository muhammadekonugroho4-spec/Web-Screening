<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_tipping_mytipjar_activate_gopay_dialog_0"
    android:background="?attr/themeContentBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/vgTippingGopayActivateDialogHeader"
        android:background="@drawable/bg_top_rounded"
        android:paddingTop="@dimen/item_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/viewFragmentTippingGopayActivateDialogHandler"
            android:background="@drawable/bg_rounded_gray_gray_bg"
            android:layout_width="@dimen/clickable_size_64"
            android:layout_height="@dimen/item_gap_xs"
            android:layout_marginBottom="@dimen/item_gap_s"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsvReceiveTippingGopayActivateDialogLayout"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/vgTippingGopayActivateDialogHeader">
        <RelativeLayout
            android:id="@+id/rlTippingGopayActivateDialogDialogSuccessMainLayout"
            android:background="?attr/themeDialogBackgroundColor"
            android:paddingBottom="@dimen/item_gap_l"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/ibTippingGopayActivateDialogClose"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="@dimen/clickable_size_24"
                android:layout_height="@dimen/clickable_size_24"
                android:layout_marginTop="@dimen/item_gap_s"
                android:layout_marginRight="@dimen/item_gap_l"
                android:scaleType="centerInside"
                android:tint="@color/highgray_light"
                android:layout_alignParentTop="true"
                android:layout_alignParentRight="true"
                app:srcCompat="0x7f08063f"/>
            <ImageView
                android:id="@+id/ivTippingGopayActivateDialogDialogHeaderIcon"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/avatar_size_xl"
                android:layout_margin="@dimen/item_gap_l"
                android:layout_alignParentTop="true"
                android:layout_centerInParent="true"
                app:srcCompat="?attr/themeIconGopayHeader"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tvReceiveTippingGopayActivateDialogTitle"
                android:padding="@dimen/item_gap_m"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_tipping_my_jar_gopay_activate_dialog_title"
                android:layout_below="@+id/ivTippingGopayActivateDialogDialogHeaderIcon"
                android:textAlignment="gravity"
                style="@style/SbTextView.ListTitle"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tvReceiveTippingGopayActivateDialogSubTitle"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/item_gap_l"
                android:layout_marginRight="@dimen/item_gap_l"
                android:text="@string/title_tipping_claim_gopay_not_connected_sub_title"
                android:layout_below="@+id/tvReceiveTippingGopayActivateDialogTitle"
                android:textAlignment="gravity"
                style="@style/SbTextView.BodyDefault"/>
            <Button
                android:id="@+id/btnTippingGopayActivateDialogDownload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/item_gap_l"
                android:text="@string/lbl_connect_gopay_account"
                android:layout_below="@+id/tvReceiveTippingGopayActivateDialogSubTitle"
                style="@style/SbBtn.PrimaryFullWidthFloating"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
