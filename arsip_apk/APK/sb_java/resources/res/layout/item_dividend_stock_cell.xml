<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_dividend_stock_cell_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/item_gap_20"
        android:layout_marginVertical="@dimen/spacing_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/tv_ratio"
            android:tag="binding_1"
            android:layout_width="@dimen/company_dividend_value_width"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:ellipsize="end"
            android:gravity="end"
            android:tag="binding_2"
            android:layout_width="@dimen/company_dividend_last_price_width"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:gravity="end"
            android:tag="binding_3"
            android:layout_width="@dimen/company_date_width"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:gravity="end"
            android:tag="binding_4"
            android:layout_width="@dimen/company_date_width"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:gravity="end"
            android:tag="binding_5"
            android:layout_width="@dimen/company_date_recording_width"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/TypeStyles.BodySmall"/>
        <TextView
            android:gravity="end"
            android:tag="binding_6"
            android:layout_width="@dimen/company_date_payment_width"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/TypeStyles.BodySmall"/>
    </LinearLayout>
    <View
        android:background="?attr/themeColorDividerThin"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/ll_content"
        app:layout_constraintStart_toStartOf="@+id/ll_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
