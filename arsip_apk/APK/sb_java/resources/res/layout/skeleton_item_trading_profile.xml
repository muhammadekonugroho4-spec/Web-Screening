<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/text_size_12"
        android:id="@+id/tvKodeNasabahTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_18"
        android:text="@string/setting_kode_nasabah"
        android:layout_marginStart="@dimen/item_gap_18"
        style="@style/SbTextView.BodySecondary.Bold.Semi"/>
    <View
        android:id="@+id/tvKodeNasabahValue"
        android:background="@drawable/bg_rounded_gray"
        android:paddingTop="@dimen/item_gap_xs"
        android:paddingBottom="@dimen/item_gap_xs"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_32"
        android:layout_marginTop="@dimen/item_gap_8"
        android:layout_toLeftOf="@+id/tvKodeNasabahSalin"
        android:layout_below="@+id/tvKodeNasabahTitle"
        android:layout_marginStart="@dimen/item_gap_18"
        android:layout_marginEnd="@dimen/item_gap_18"
        style="@style/SbTextView.BodyDefault.Bold.Semi"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="?attr/themeAccent"
        android:id="@+id/tvKodeNasabahSalin"
        android:padding="@dimen/item_gap_s"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_8"
        android:text="@string/setting_salin"
        android:layout_below="@+id/tvKodeNasabahTitle"
        android:layout_marginEnd="@dimen/item_gap_18"
        android:layout_alignParentEnd="true"
        style="@style/SbTextView.BodyDefault.Bold"/>
    <View
        android:id="@+id/viewSeparatorKodeNasabah"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_18"
        android:layout_below="@+id/tvKodeNasabahValue"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:id="@+id/tvNamaNasabahTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_18"
        android:text="@string/setting_nama_nasabah"
        android:layout_below="@+id/viewSeparatorKodeNasabah"
        android:layout_marginStart="@dimen/item_gap_18"
        style="@style/SbTextView.BodySecondary.Bold.Semi"/>
    <View
        android:id="@+id/tvNamaNasabahValue"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_32"
        android:layout_marginTop="@dimen/item_gap_8"
        android:layout_below="@+id/tvNamaNasabahTitle"
        android:layout_marginStart="@dimen/item_gap_18"
        android:layout_marginEnd="@dimen/item_gap_18"
        style="@style/SbTextView.BodyDefault.Bold.Semi"/>
    <View
        android:id="@+id/viewSeparatorNamaNasabah"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_18"
        android:layout_below="@+id/tvNamaNasabahValue"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:id="@+id/tvSidNasabahTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_18"
        android:text="@string/setting_sid_nasabah"
        android:layout_below="@+id/viewSeparatorNamaNasabah"
        android:layout_marginStart="@dimen/item_gap_18"
        style="@style/SbTextView.BodySecondary.Bold.Semi"/>
    <View
        android:id="@+id/tvSidNasabahValue"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/clickable_size_32"
        android:layout_marginTop="@dimen/item_gap_8"
        android:layout_below="@+id/tvSidNasabahTitle"
        android:layout_marginStart="@dimen/item_gap_18"
        android:layout_marginEnd="@dimen/item_gap_18"
        style="@style/SbTextView.BodyDefault.Bold.Semi"/>
    <View
        android:id="@+id/viewSeparatorSidNasabah"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_18"
        android:layout_below="@+id/tvSidNasabahValue"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:id="@+id/tvNomorKseiNasabahTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_18"
        android:text="@string/setting_nomor_ksei_nasabah"
        android:layout_below="@+id/viewSeparatorSidNasabah"
        android:layout_marginStart="@dimen/item_gap_18"
        style="@style/SbTextView.BodySecondary.Bold.Semi"/>
    <View
        android:id="@+id/tvNomorKseiNasabahValue"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/clickable_size_32"
        android:layout_marginTop="@dimen/item_gap_8"
        android:layout_below="@+id/tvNomorKseiNasabahTitle"
        android:layout_marginStart="@dimen/item_gap_18"
        android:layout_marginEnd="@dimen/item_gap_18"
        style="@style/SbTextView.BodyDefault.Bold.Semi"/>
    <View
        android:id="@+id/viewSeparatorNomorKseiNasabah"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_18"
        android:layout_below="@+id/tvNomorKseiNasabahValue"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:id="@+id/tvRekeningRdnNasabahTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_18"
        android:text="@string/setting_rekening_rdn_nasabah"
        android:layout_below="@+id/viewSeparatorNomorKseiNasabah"
        android:layout_marginStart="@dimen/item_gap_18"
        style="@style/SbTextView.BodySecondary.Bold.Semi"/>
    <View
        android:id="@+id/tvRekeningRdnIconNasabahValue"
        android:background="@drawable/bg_rounded_gray"
        android:paddingTop="@dimen/item_gap_xs"
        android:paddingBottom="@dimen/item_gap_xs"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/clickable_size_32"
        android:layout_marginTop="@dimen/item_gap_8"
        android:layout_toLeftOf="@+id/tvRekeningRdnNasabahSalin"
        android:layout_below="@+id/tvRekeningRdnNasabahTitle"
        android:paddingStart="@dimen/item_gap_m"
        android:paddingEnd="@dimen/item_gap_m"
        android:layout_marginStart="@dimen/item_gap_18"
        android:layout_marginEnd="@dimen/item_gap_18"
        style="@style/SbTextView.BodyDefault"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:id="@+id/tvRekeningRdnNasabahValue"
        android:paddingTop="@dimen/item_gap_xs"
        android:paddingBottom="@dimen/item_gap_xs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_8"
        android:layout_toRightOf="@+id/tvRekeningRdnIconNasabahValue"
        android:layout_below="@+id/tvRekeningRdnNasabahTitle"
        android:layout_marginStart="@dimen/item_gap_18"
        style="@style/SbTextView.BodyDefault.Bold.Semi"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="?attr/themeAccent"
        android:id="@+id/tvRekeningRdnNasabahSalin"
        android:padding="@dimen/item_gap_s"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_8"
        android:text="@string/setting_salin"
        android:layout_below="@+id/tvRekeningRdnNasabahTitle"
        android:layout_marginEnd="@dimen/item_gap_18"
        android:layout_alignParentEnd="true"
        style="@style/SbTextView.BodyDefault.Bold"/>
    <View
        android:id="@+id/tvRekeningRdnNamaNasabahValue"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/clickable_size_32"
        android:layout_marginTop="@dimen/item_gap_m"
        android:layout_below="@+id/tvRekeningRdnNasabahValue"
        android:layout_marginStart="@dimen/item_gap_18"
        android:layout_marginEnd="@dimen/item_gap_18"
        style="@style/SbTextView.BodyDefault"/>
    <View
        android:id="@+id/viewSeparatorRekeningRdnNasabah"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_18"
        android:layout_below="@+id/tvRekeningRdnNamaNasabahValue"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:id="@+id/tvRekeningBankNasabahTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_18"
        android:text="@string/setting_rekening_bank_nasabah"
        android:layout_below="@+id/viewSeparatorRekeningRdnNasabah"
        android:layout_marginStart="@dimen/item_gap_18"
        style="@style/SbTextView.BodySecondary.Bold.Semi"/>
    <View
        android:id="@+id/tvRekeningBankIconNasabahValue"
        android:background="@drawable/bg_rounded_gray"
        android:paddingTop="@dimen/item_gap_xs"
        android:paddingBottom="@dimen/item_gap_xs"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/clickable_size_32"
        android:layout_marginTop="@dimen/item_gap_8"
        android:layout_toLeftOf="@+id/tvRekeningBankNasabahSalin"
        android:layout_below="@+id/tvRekeningBankNasabahTitle"
        android:paddingStart="@dimen/item_gap_m"
        android:paddingEnd="@dimen/item_gap_m"
        android:layout_marginStart="@dimen/item_gap_18"
        android:layout_marginEnd="@dimen/item_gap_18"
        style="@style/SbTextView.BodyDefault"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:id="@+id/tvRekeningBankNasabahValue"
        android:paddingTop="@dimen/item_gap_xs"
        android:paddingBottom="@dimen/item_gap_xs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_8"
        android:layout_toRightOf="@+id/tvRekeningBankIconNasabahValue"
        android:layout_below="@+id/tvRekeningBankNasabahTitle"
        android:layout_marginStart="@dimen/item_gap_18"
        style="@style/SbTextView.BodyDefault.Bold.Semi"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="?attr/themeAccent"
        android:id="@+id/tvRekeningBankNasabahSalin"
        android:padding="@dimen/item_gap_s"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_8"
        android:text="@string/setting_salin"
        android:layout_below="@+id/tvRekeningBankNasabahTitle"
        android:layout_marginEnd="@dimen/item_gap_18"
        android:layout_alignParentEnd="true"
        style="@style/SbTextView.BodyDefault.Bold"/>
    <View
        android:id="@+id/tvRekeningBankNamaNasabahValue"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/clickable_size_32"
        android:layout_marginTop="@dimen/item_gap_m"
        android:layout_below="@+id/tvRekeningBankNasabahValue"
        android:layout_marginStart="@dimen/item_gap_18"
        android:layout_marginEnd="@dimen/item_gap_18"
        style="@style/SbTextView.BodyDefault"/>
    <View
        android:id="@+id/viewSeparatorRekeningBankNasabah"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_18"
        android:layout_below="@+id/tvRekeningBankNamaNasabahValue"/>
</RelativeLayout>
