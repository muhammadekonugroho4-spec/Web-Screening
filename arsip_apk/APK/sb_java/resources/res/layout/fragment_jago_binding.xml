<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_jago_binding_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_close"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_18"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_close_oa_status_dark"/>
    <ImageView
        android:id="@+id/iv_jago_binding_icon"
        android:visibility="gone"
        android:layout_width="@dimen/width_160"
        android:layout_height="@dimen/height_120"
        android:layout_marginTop="@dimen/item_gap_20"
        app:layout_constraintBottom_toTopOf="@+id/tv_jago_binding_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:srcCompat="@drawable/ic_binding_jago_light"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_jago_binding_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:text="@string/lbl_loading_jago_title"
        android:textAlignment="gravity"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintBottom_toTopOf="@+id/tv_jago_binding_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_jago_binding_icon"
        style="@style/TypeStyles.HeadlineRegular"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_jago_binding_subtitle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        android:text="@string/lbl_loading_jago_subtitle"
        android:textAlignment="gravity"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintBottom_toTopOf="@+id/btn_rdn_bca"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_jago_binding_title"
        style="@style/TypeStyles.BodyRegular"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_information"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="tv_jago_binding_subtitle,tv_jago_binding_title,iv_jago_binding_icon"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="btn_other_rdn,btn_try_again"/>
    <com.stockbit.uikit.button.SecondaryButton
        android:id="@+id/btn_other_rdn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_20"
        android:text="@string/lbl_error_binding_jago_btn_secondary_title"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_try_again"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/btn_try_again"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_20"
        android:text="@string/lbl_error_binding_jago_btn_primary_title"
        android:layout_marginEnd="@dimen/spacing_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_other_rdn"
        app:layout_constraintTop_toTopOf="@+id/btn_other_rdn"
        app:layout_constraintVertical_bias="0"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_sharia"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="btn_rdn_bca"/>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/btn_rdn_bca"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        android:layout_marginBottom="@dimen/item_gap_20"
        android:text="@string/lbl_error_jago_sharia_btn_title"
        android:textAllCaps="false"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <FrameLayout
        android:id="@+id/fl_webview_jago"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
