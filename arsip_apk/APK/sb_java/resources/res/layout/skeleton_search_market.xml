<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/view_market_status"
        android:background="@color/red_item"
        android:layout_width="@dimen/spacing_4"
        android:layout_height="@dimen/spacing_0"
        android:layout_marginLeft="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="@+id/tv_market_symbol"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/tv_market_symbol"
        android:background="@color/black"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_ihsg"
        android:paddingHorizontal="@dimen/spacing_6"
        android:paddingVertical="@dimen/spacing_4"
        app:layout_constraintLeft_toRightOf="@+id/view_market_status"
        app:layout_constraintTop_toTopOf="@+id/view_market_status"
        style="@style/TypeStyles.HeadingLarge"/>
    <View
        android:id="@+id/view_skeleton_market_price"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_140"
        android:layout_height="@dimen/height_26"
        android:layout_marginStart="@dimen/spacing_16"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintStart_toEndOf="@+id/tv_market_symbol"
        app:layout_constraintTop_toTopOf="@+id/tv_market_symbol"/>
    <View
        android:id="@+id/view_skeleton_chart"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_161"
        android:layout_marginTop="@dimen/spacing_14"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        android:layout_marginHorizontal="@dimen/spacing_16"
        app:layout_constraintTop_toBottomOf="@+id/view_skeleton_market_price"/>
    <View
        android:id="@+id/view_skeleton_middle_content_1"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_90"
        android:layout_marginTop="@dimen/spacing_20"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        android:layout_marginHorizontal="@dimen/spacing_16"
        app:layout_constraintTop_toBottomOf="@+id/view_skeleton_chart"/>
    <View
        android:id="@+id/view_skeleton_middle_content_2"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_20"
        android:layout_marginTop="@dimen/spacing_8"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        android:layout_marginHorizontal="@dimen/spacing_16"
        app:layout_constraintTop_toBottomOf="@+id/view_skeleton_middle_content_1"/>
    <View
        android:id="@+id/view_skeleton_bottom_content_1"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_90"
        android:layout_marginTop="@dimen/spacing_20"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        android:layout_marginHorizontal="@dimen/spacing_16"
        app:layout_constraintTop_toBottomOf="@+id/view_skeleton_middle_content_2"/>
    <View
        android:id="@+id/view_skeleton_bottom_content_2"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_200"
        android:layout_marginTop="@dimen/spacing_20"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        android:layout_marginHorizontal="@dimen/spacing_16"
        app:layout_constraintTop_toBottomOf="@+id/view_skeleton_bottom_content_1"/>
</androidx.constraintlayout.widget.ConstraintLayout>
