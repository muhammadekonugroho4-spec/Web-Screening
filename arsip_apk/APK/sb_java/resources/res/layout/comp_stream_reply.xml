<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cv_content_reply"
    android:tag="layout/comp_stream_reply_0"
    android:focusable="true"
    android:visibility="gone"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    app:cardBackgroundColor="?attr/themeColorSurfaceVariant"
    app:cardCornerRadius="@dimen/shape_radius_m"
    app:cardElevation="@dimen/item_gap_null"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <include
            android:id="@+id/user_profile_reply"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/comp_stream_user_profile_reply"/>
        <TextView
            android:ellipsize="end"
            android:id="@+id/tv_reply_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_7"
            android:maxLines="@integer/stream_text_max_line"
            android:layout_marginHorizontal="@dimen/item_gap_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/user_profile_reply"
            app:layout_goneMarginBottom="@dimen/shape_radius_l"
            app:layout_goneMarginTop="@dimen/shape_radius_l"
            style="@style/TypeStyles.BodyRegular"/>
        <ImageView
            android:id="@+id/iv_reply_content"
            android:tag="binding_2"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/item_gap_s"
            android:scaleType="centerCrop"
            android:contentDescription="@string/hint_post_image"
            android:layout_marginHorizontal="@dimen/item_gap_12"
            app:layout_constraintDimensionRatio="v,16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_reply_content"/>
        <TextView
            android:textColor="?attr/themeColorTextTetriary"
            android:id="@+id/tv_open_all_reply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_10"
            android:text="@string/button_stream_more_convo"
            android:layout_marginStart="@dimen/item_gap_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_reply_content"
            style="@style/TypeStyles.BodyXXSmall"/>
        <Space
            android:layout_width="wrap_content"
            android:layout_height="@dimen/spacing_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_open_all_reply"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
