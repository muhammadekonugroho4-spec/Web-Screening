<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_filter_order_queue_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stockbit.uikit.topbar.TopbarStockbitTitle
        android:id="@+id/toolbar_filter_order_queue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:topBarTitleTitle="@string/title_filter_order_queue"
        app:topBarType="CenterTitle"/>
    <TextView
        android:id="@+id/tv_find_by_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:text="@string/title_find_by"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_filter_order_queue"
        style="@style/TypeStyles.HeadingRegular"/>
    <com.stockbit.uikit.input.ContainerBox
        android:id="@+id/container_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        android:inputType="number"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:inputHint="@string/title_hint_price"
        app:layout_constraintEnd_toEndOf="@+id/tv_find_by_title"
        app:layout_constraintStart_toStartOf="@+id/tv_find_by_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_find_by_title"/>
    <com.stockbit.uikit.input.ContainerBox
        android:id="@+id/container_order_id"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:inputType="number"
        app:inputHint="@string/title_hint_order_id"
        app:layout_constraintEnd_toEndOf="@+id/tv_find_by_title"
        app:layout_constraintStart_toStartOf="@+id/tv_find_by_title"
        app:layout_constraintTop_toBottomOf="@+id/container_price"/>
    <TextView
        android:id="@+id/tv_action_type_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:text="@string/title_action_type"
        app:layout_constraintEnd_toEndOf="@+id/tv_find_by_title"
        app:layout_constraintStart_toStartOf="@+id/tv_find_by_title"
        app:layout_constraintTop_toBottomOf="@+id/container_order_id"
        style="@style/TypeStyles.HeadingRegular"/>
    <com.stockbit.uikit.chips.SBChipsGroup
        android:layout_gravity="center"
        android:id="@+id/chip_group_action_type"
        android:clipToPadding="false"
        android:layout_width="@dimen/item_gap_null"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        app:chipsActionMode="single_pick"
        app:layout_constraintEnd_toEndOf="@+id/tv_find_by_title"
        app:layout_constraintStart_toStartOf="@+id/tv_find_by_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_action_type_title">
        <com.stockbit.uikit.chips.SBChips
            android:id="@+id/chip_action_type_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipsText="@string/title_chip_all"/>
        <com.stockbit.uikit.chips.SBChips
            android:id="@+id/chip_action_type_buy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipsText="@string/title_chip_buy"/>
        <com.stockbit.uikit.chips.SBChips
            android:id="@+id/chip_action_type_sell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipsText="@string/title_chip_sell"/>
    </com.stockbit.uikit.chips.SBChipsGroup>
    <TextView
        android:id="@+id/tv_order_status_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:text="@string/title_order_status"
        app:layout_constraintEnd_toEndOf="@+id/tv_find_by_title"
        app:layout_constraintStart_toStartOf="@+id/tv_find_by_title"
        app:layout_constraintTop_toBottomOf="@+id/chip_group_action_type"
        style="@style/TypeStyles.HeadingRegular"/>
    <com.stockbit.uikit.chips.SBChipsGroup
        android:layout_gravity="center"
        android:id="@+id/chip_group_order_status"
        android:layout_width="@dimen/item_gap_null"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        app:chipsActionMode="single_pick"
        app:layout_constraintEnd_toEndOf="@+id/tv_find_by_title"
        app:layout_constraintStart_toStartOf="@+id/tv_find_by_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_order_status_title">
        <com.stockbit.uikit.chips.SBChips
            android:id="@+id/chip_order_status_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipsText="@string/title_chip_all"/>
        <com.stockbit.uikit.chips.SBChips
            android:id="@+id/chip_order_status_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipsText="@string/title_chip_open"/>
        <com.stockbit.uikit.chips.SBChips
            android:id="@+id/chip_order_status_match"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipsText="@string/title_chip_match"/>
        <com.stockbit.uikit.chips.SBChips
            android:id="@+id/chip_order_status_withdrawn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipsText="@string/title_chip_withdrawn"/>
        <com.stockbit.uikit.chips.SBChips
            android:id="@+id/chip_order_status_partial_match"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipsText="@string/title_chip_partial_match"/>
        <com.stockbit.uikit.chips.SBChips
            android:id="@+id/chip_order_status_amend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipsText="@string/title_chip_amend"/>
    </com.stockbit.uikit.chips.SBChipsGroup>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:id="@+id/tv_board_type_title"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:text="@string/title_board_type"
        app:layout_constraintEnd_toEndOf="@+id/tv_find_by_title"
        app:layout_constraintStart_toStartOf="@+id/tv_find_by_title"
        app:layout_constraintTop_toBottomOf="@+id/chip_group_order_status"
        style="@style/TypeStyles.HeadingRegular"/>
    <com.stockbit.uikit.chips.SBChipsGroup
        android:layout_gravity="center"
        android:id="@+id/chip_group_board_type"
        android:visibility="gone"
        android:layout_width="@dimen/item_gap_null"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        app:chipsActionMode="single_pick"
        app:layout_constraintEnd_toEndOf="@+id/tv_find_by_title"
        app:layout_constraintStart_toStartOf="@+id/tv_find_by_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_board_type_title">
        <com.stockbit.uikit.chips.SBChips
            android:id="@+id/chip_board_type_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipsText="@string/title_chip_all"/>
        <com.stockbit.uikit.chips.SBChips
            android:id="@+id/chip_board_type_rg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipsText="@string/title_chip_rg"/>
        <com.stockbit.uikit.chips.SBChips
            android:id="@+id/chip_board_type_ng"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipsText="@string/title_chip_ng"/>
        <com.stockbit.uikit.chips.SBChips
            android:id="@+id/chip_board_type_tn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipsText="@string/title_chip_tn"/>
    </com.stockbit.uikit.chips.SBChipsGroup>
    <TextView
        android:id="@+id/tv_time_range_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:text="@string/title_time_range"
        app:layout_constraintEnd_toEndOf="@+id/tv_find_by_title"
        app:layout_constraintStart_toStartOf="@+id/tv_find_by_title"
        app:layout_constraintTop_toBottomOf="@+id/chip_group_board_type"
        style="@style/TypeStyles.HeadingRegular"/>
    <View
        android:id="@+id/view_click_time_from"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:translationZ="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/container_time_from"
        app:layout_constraintEnd_toEndOf="@+id/container_time_from"
        app:layout_constraintStart_toStartOf="@+id/container_time_from"
        app:layout_constraintTop_toTopOf="@+id/container_time_from"/>
    <com.stockbit.uikit.input.ContainerBox
        android:id="@+id/container_time_from"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        android:inputType="number"
        android:layout_marginEnd="@dimen/item_gap_8"
        app:inputHint="@string/title_hint_time_from"
        app:layout_constraintEnd_toStartOf="@+id/container_time_to"
        app:layout_constraintStart_toStartOf="@+id/tv_find_by_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_time_range_title"/>
    <View
        android:id="@+id/view_click_time_to"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:translationZ="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/container_time_to"
        app:layout_constraintEnd_toEndOf="@+id/container_time_to"
        app:layout_constraintStart_toStartOf="@+id/container_time_to"
        app:layout_constraintTop_toTopOf="@+id/container_time_to"/>
    <com.stockbit.uikit.input.ContainerBox
        android:id="@+id/container_time_to"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:layout_marginStart="@dimen/item_gap_8"
        app:inputHint="@string/title_hint_time_to"
        app:layout_constraintEnd_toEndOf="@+id/tv_find_by_title"
        app:layout_constraintStart_toEndOf="@+id/container_time_from"
        app:layout_constraintTop_toTopOf="@+id/container_time_from"/>
    <TextView
        android:id="@+id/tv_error_filter_time"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_6"
        android:text="@string/error_time_to_less_than_time_before"
        app:layout_constraintEnd_toEndOf="@+id/container_time_to"
        app:layout_constraintStart_toStartOf="@+id/container_time_from"
        app:layout_constraintTop_toBottomOf="@+id/container_time_from"
        style="@style/TypeStyles.BodyXSmall.Red"/>
    <View
        android:id="@+id/background"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="@+id/divider"/>
    <View
        android:id="@+id/divider"
        android:background="?attr/titleTextColorDowngray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_1"
        android:layout_marginBottom="@dimen/item_gap_20"
        app:layout_constraintBottom_toTopOf="@+id/btn_apply"/>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/btn_apply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_20"
        android:text="@string/title_btn_apply"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
