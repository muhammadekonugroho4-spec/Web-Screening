<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_portfolio_detail_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stockbit.component.securities.topbar.TopBarPortfolio
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:topBarPortfolioTitle="@string/title_portfolio_detail"
        app:topBarPortfolioTooltipTitle="@string/msg_tooltip_share_portfolio"/>
    <ViewFlipper
        android:id="@+id/vf_trading_portfolio_detail"
        android:tag="binding_1"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/FBShimmerFrameLayout">
            <include layout="@layout/skeleton_portfolio_detail"/>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <View
                android:id="@+id/v_divider"
                android:background="?attr/themeColorDividerGreyBorder"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_1"
                android:layout_marginBottom="@dimen/item_gap_20"
                android:layout_above="@+id/ll_portfolio_transaction_btn"/>
            <LinearLayout
                android:id="@+id/ll_portfolio_transaction_btn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_44"
                android:layout_marginBottom="@dimen/spacing_16"
                android:weightSum="3"
                android:layout_alignParentBottom="true"
                android:layout_marginHorizontal="@dimen/spacing_16">
                <com.stockbit.uikit.button.SecondaryButton
                    android:id="@+id/btn_buy"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/btn_buy_portfolio"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:layout_marginEnd="@dimen/item_gap_12"
                    app:secondaryButtonColor="green"/>
                <com.stockbit.uikit.button.SecondaryButton
                    android:id="@+id/btn_sell"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/btn_sell"
                    android:layout_weight="2"
                    app:secondaryButtonColor="red"/>
            </LinearLayout>
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:layout_above="@+id/v_divider">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:tag="binding_3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/spacing_20"
                    android:layout_marginBottom="@dimen/spacing_16">
                    <com.stockbit.component.securities.companyprice.CompanyPriceHeaderView
                        android:id="@+id/cph_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_16"
                        android:layout_marginHorizontal="@dimen/spacing_16"/>
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/cv_banner_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_16"
                        android:layout_marginHorizontal="@dimen/spacing_16"/>
                    <include
                        android:id="@+id/v_balance_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/spacing_16"
                        layout="@layout/comp_portfolio_detail_balance_info"/>
                    <include
                        android:id="@+id/v_allocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:layout_marginHorizontal="@dimen/spacing_16"
                        layout="@layout/comp_portfolio_detail_allocation"/>
                    <include
                        android:id="@+id/v_transaction_history"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:layout_marginHorizontal="@dimen/spacing_16"
                        layout="@layout/comp_portfolio_detail_transaction_history"/>
                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/shimmer_smart_order"
                        android:padding="@dimen/spacing_16"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/spacing_16"
                        style="@style/FBShimmerFrameLayout">
                        <View
                            android:paddingTop="@dimen/spacing_16"
                            android:paddingBottom="@dimen/spacing_16"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/height_126"
                            style="@style/FBShimmerItem.Large"/>
                    </com.facebook.shimmer.ShimmerFrameLayout>
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/cv_smart_order"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:layout_marginHorizontal="@dimen/item_gap_18"/>
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/cv_order_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:layout_marginHorizontal="@dimen/item_gap_18"/>
                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/cv_order_histories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16"
                        android:layout_marginHorizontal="@dimen/item_gap_18"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.core.widget.NestedScrollView>
        </RelativeLayout>
        <include
            android:layout_gravity="center"
            android:id="@+id/v_network_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/comp_portfolio_detail_error_network"/>
    </ViewFlipper>
</androidx.appcompat.widget.LinearLayoutCompat>
