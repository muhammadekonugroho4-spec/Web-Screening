<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/item_applied_comparison_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginRight="@dimen/item_gap_m"
    android:minHeight="@dimen/clickable_size_48">
    <ImageView
        android:textColor="@color/color_single_choice"
        android:id="@+id/iv_applied_comparison"
        android:background="@drawable/bg_circle_black"
        android:padding="@dimen/item_gap_s"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="@dimen/clickable_size_48"
        android:layout_height="@dimen/clickable_size_48"
        android:scaleType="fitCenter"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_avatar"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_applied_comparison"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.55"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageButton
        android:id="@+id/ib_delete_file"
        android:background="@drawable/bg_circle_gray"
        android:visibility="visible"
        android:layout_width="@dimen/clickable_size_24"
        android:layout_height="@dimen/clickable_size_24"
        android:contentDescription="@string/btn_delete_watchlist"
        android:rotation="45"
        app:layout_constraintLeft_toRightOf="@+id/guideline_applied_comparison"
        app:layout_constraintRight_toRightOf="parent"
        app:srcCompat="@drawable/ic_android_plus"
        app:tint="@color/google_red"/>
    <View
        android:id="@+id/view_comparison"
        android:background="@color/green_text"
        android:layout_width="@dimen/item_gap_l"
        android:layout_height="@dimen/item_gap_xs"
        android:layout_marginTop="@dimen/item_gap_s"
        android:layout_below="@+id/iv_applied_comparison"
        android:layout_centerHorizontal="true"
        app:layout_constraintLeft_toLeftOf="@+id/guideline_applied_comparison"
        app:layout_constraintRight_toRightOf="@+id/guideline_applied_comparison"
        app:layout_constraintTop_toBottomOf="@+id/guideline_applied_comparison"/>
</androidx.constraintlayout.widget.ConstraintLayout>
