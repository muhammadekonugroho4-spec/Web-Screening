<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_stocks_filter_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stockbit.uikit.topbar.TopbarStockbitTitle
        android:id="@+id/toolbar_filter_stock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:topBarTitleTitle="@string/stock_to_display"
        app:topBarType="CenterTitle"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_filter_stock"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/divider_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_filter_stock"/>
    <com.stockbit.uikit.divider.SBDivider
        android:id="@+id/divider_btn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_1"
        android:layout_marginBottom="@dimen/spacing_20"
        app:layout_constraintBottom_toTopOf="@+id/btn_apply"/>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/btn_apply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_20"
        android:text="@string/button_apply"
        app:layout_constraintBottom_toBottomOf="parent"
        app:primaryButtonActive="false"
        app:primaryButtonSize="mediumSize"/>
    <ProgressBar
        android:id="@+id/pb_loading"
        android:visibility="gone"
        android:layout_width="@dimen/clickable_size_24"
        android:layout_height="@dimen/clickable_size_24"
        android:layout_centerVertical="true"
        android:indeterminateTint="@color/white"
        app:layout_constraintBottom_toBottomOf="@+id/btn_apply"
        app:layout_constraintEnd_toEndOf="@+id/btn_apply"
        app:layout_constraintStart_toStartOf="@+id/btn_apply"
        app:layout_constraintTop_toTopOf="@+id/btn_apply"
        style="@style/Widget.AppCompat.ProgressBar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
