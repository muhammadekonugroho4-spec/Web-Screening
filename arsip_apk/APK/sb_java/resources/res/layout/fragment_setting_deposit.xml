<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_setting_deposit_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/settingActivityToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:layout_scrollFlags="enterAlways|scroll">
        <TextView
            android:textSize="@dimen/text_size_16"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_deposit_title"
            style="@style/SbTextView.BodyDefault.Bold"/>
    </androidx.appcompat.widget.Toolbar>
    <ViewFlipper
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:layout_gravity="start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_20"
                    android:layout_marginBottom="@dimen/item_gap_20"
                    android:text="@string/setting_stockbit_deposit_rdn_title"
                    android:layout_marginStart="@dimen/item_gap_20"
                    android:layout_marginEnd="@dimen/item_gap_20"
                    style="@style/TypeStyles.HeadingLarge"/>
                <RelativeLayout
                    android:background="@drawable/bg_rounded_4_transparent_colorborder"
                    android:padding="@dimen/item_gap_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/item_gap_20"
                    android:layout_marginEnd="@dimen/item_gap_20">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_rdn_bank"
                        android:tag="binding_2"
                        android:layout_width="@dimen/width_40"
                        android:layout_height="@dimen/height_40"/>
                    <TextView
                        android:textColor="?attr/themeColorTextSecondary"
                        android:id="@+id/tv_rdn_name"
                        android:tag="binding_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/item_gap_16"
                        android:layout_marginEnd="@dimen/item_gap_16"
                        android:layout_toStartOf="@+id/tv_copy_rdn_number"
                        android:layout_toEndOf="@+id/iv_rdn_bank"
                        style="@style/TypeStyles.BodyRegular"/>
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:id="@+id/tv_rdn_number"
                        android:tag="binding_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_6"
                        android:layout_toRightOf="@+id/iv_rdn_bank"
                        android:layout_below="@+id/tv_rdn_name"
                        android:layout_marginStart="@dimen/item_gap_16"
                        style="@style/TypeStyles.HeadingRegular"/>
                    <TextView
                        android:textColor="?attr/themeColorSemanticActive"
                        android:id="@+id/tv_copy_rdn_number"
                        android:background="@drawable/bg_card_green_light"
                        android:paddingTop="@dimen/item_gap_8"
                        android:paddingBottom="@dimen/item_gap_8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_btn_copy"
                        android:textAlignment="gravity"
                        android:paddingStart="@dimen/item_gap_10"
                        android:paddingEnd="@dimen/item_gap_10"
                        android:layout_alignParentEnd="true"
                        style="@style/TypeStyles.HeadingRegular"/>
                </RelativeLayout>
                <RelativeLayout
                    android:tag="binding_5"
                    android:background="@drawable/border_gray_rounded_white_bg"
                    android:padding="@dimen/item_gap_16"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/item_gap_20">
                    <ImageView
                        android:id="@+id/iv_icon_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_info"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:id="@+id/tv_title_instruction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/deposit_rdn_instruction_title"
                        android:layout_toRightOf="@+id/iv_icon_info"
                        android:layout_marginStart="@dimen/item_gap_18"
                        style="@style/TypeStyles.HeadingRegular"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="center"
                        android:layout_alignParentRight="true"
                        android:layout_centerInParent="true"
                        app:srcCompat="@drawable/ic_chevron_right_small"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_swift_code"
                    android:tag="binding_6"
                    android:background="@drawable/border_gray_rounded_white_bg"
                    android:padding="@dimen/item_gap_16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/item_gap_20">
                    <ImageView
                        android:id="@+id/iv_icon_info_swift"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_info"
                        android:layout_centerVertical="true"/>
                    <TextView
                        android:id="@+id/tv_title_swift"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SWIFT Code :"
                        android:layout_toRightOf="@+id/iv_icon_info_swift"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/item_gap_18"
                        style="@style/TypeStyles.BodyRegular"/>
                    <TextView
                        android:id="@+id/tv_content_swift"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CENAIDJA"
                        android:layout_toRightOf="@+id/tv_title_swift"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/item_gap_12"
                        style="@style/TypeStyles.HeadingRegular"/>
                    <TextView
                        android:textColor="?attr/themeColorSemanticActive"
                        android:id="@+id/tv_copy_swift_code"
                        android:background="@drawable/bg_card_green_light"
                        android:paddingTop="@dimen/item_gap_5"
                        android:paddingBottom="@dimen/item_gap_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/setting_btn_copy"
                        android:textAlignment="gravity"
                        android:paddingStart="@dimen/item_gap_10"
                        android:paddingEnd="@dimen/item_gap_10"
                        android:layout_alignParentEnd="true"
                        style="@style/TypeStyles.HeadingXSmall"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_wv_deposit"
                    android:tag="binding_7"
                    android:background="@drawable/border_gray_rounded_white_bg"
                    android:padding="@dimen/item_gap_16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/item_gap_20">
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:id="@+id/tv_title_deposit_funds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How to Deposit Funds"
                        style="@style/TypeStyles.HeadingRegular"/>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="center"
                        android:layout_alignParentRight="true"
                        android:layout_centerInParent="true"
                        app:srcCompat="@drawable/ic_chevron_right_small"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_rdn_info_foreign"
                    android:tag="binding_8"
                    android:background="@drawable/border_gray_rounded_white_bg"
                    android:padding="@dimen/item_gap_16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_20"
                    android:layout_marginStart="@dimen/item_gap_20"
                    android:layout_marginEnd="@dimen/item_gap_20">
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:id="@+id/tv_title_rdn_info_foreign"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How to Deposit Funds"
                        style="@style/TypeStyles.HeadingRegular"/>
                    <TextView
                        android:textColor="?attr/themeColorTextSecondary"
                        android:layout_gravity="start"
                        android:id="@+id/tv_desc_rdn_info_foreign"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_4"
                        android:text="@string/deposit_rdn_info_foreign_desc"
                        android:layout_below="@+id/tv_title_rdn_info_foreign"
                        style="@style/TypeStyles.BodyRegular"/>
                    <TableLayout
                        android:layout_gravity="start"
                        android:id="@+id/tl_instruction_detail_foreign"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/item_gap_16"
                        android:layout_below="@+id/tv_desc_rdn_info_foreign">
                        <TableRow>
                            <TextView
                                android:textSize="@dimen/text_size_16"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/indicator_dot"
                                android:layout_marginStart="@dimen/item_gap_8"
                                style="@style/TypeStyles.BodyRegular"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/deposit_rdn_instruction_1_foreign"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/item_gap_8"
                                style="@style/TypeStyles.BodyRegular"/>
                        </TableRow>
                        <TableRow android:layout_marginTop="@dimen/item_gap_24">
                            <TextView
                                android:textSize="@dimen/text_size_16"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/indicator_dot"
                                android:layout_marginStart="@dimen/item_gap_8"
                                style="@style/TypeStyles.BodyRegular"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/deposit_rdn_instruction_2_foreign"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/item_gap_8"
                                style="@style/TypeStyles.BodyRegular"/>
                        </TableRow>
                        <TableRow android:layout_marginTop="@dimen/item_gap_24">
                            <TextView
                                android:textSize="@dimen/text_size_16"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/indicator_dot"
                                android:layout_marginStart="@dimen/item_gap_8"
                                style="@style/SbTextView.BodyDefault.Bold"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/deposit_rdn_instruction_3_foreign"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/item_gap_8"
                                style="@style/TypeStyles.BodyRegular"/>
                        </TableRow>
                        <TableRow android:layout_marginTop="@dimen/item_gap_24">
                            <TextView
                                android:textSize="@dimen/text_size_16"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/indicator_dot"
                                android:layout_marginStart="@dimen/item_gap_8"
                                style="@style/SbTextView.BodyDefault.Bold"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/deposit_rdn_instruction_4_foreign"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/item_gap_8"
                                style="@style/TypeStyles.BodyRegular"/>
                        </TableRow>
                    </TableLayout>
                </RelativeLayout>
                <View
                    android:tag="binding_9"
                    android:background="?attr/themeColorDividerThick"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_gap_m"/>
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:layout_gravity="start"
                    android:tag="binding_10"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_20"
                    android:text="@string/setting_stockbit_deposit_bank_transfer"
                    android:layout_marginStart="@dimen/item_gap_20"
                    style="@style/TypeStyles.HeadingLarge"/>
                <TextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:layout_gravity="start"
                    android:tag="binding_11"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_4"
                    android:text="@string/setting_stockbit_deposit_subtitle_bank_transfer"
                    android:layout_marginStart="@dimen/item_gap_20"
                    style="@style/TypeStyles.BodyRegular"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_payment_bank"
                    android:tag="binding_12"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/item_gap_20"
                    android:layout_marginStart="@dimen/item_gap_20"
                    android:layout_marginEnd="@dimen/item_gap_20"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <View
                    android:tag="binding_13"
                    android:background="?attr/themeColorDividerThick"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_gap_m"/>
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:layout_gravity="start"
                    android:tag="binding_14"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_20"
                    android:text="@string/setting_stockbit_deposit_digital_transfer"
                    android:layout_marginStart="@dimen/item_gap_20"
                    style="@style/TypeStyles.HeadingLarge"/>
                <TextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:layout_gravity="start"
                    android:tag="binding_15"
                    android:visibility="visible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_4"
                    android:text="@string/setting_stockbit_deposit_subtitle_digital_transfer"
                    android:layout_marginStart="@dimen/item_gap_20"
                    style="@style/TypeStyles.BodyRegular"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_payment_digital"
                    android:tag="binding_16"
                    android:visibility="visible"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/item_gap_20"
                    android:layout_marginStart="@dimen/item_gap_20"
                    android:layout_marginEnd="@dimen/item_gap_20"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </ViewFlipper>
</LinearLayout>
