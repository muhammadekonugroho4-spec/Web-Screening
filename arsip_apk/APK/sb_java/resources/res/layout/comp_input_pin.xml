<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_input_pin_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.poovam.pinedittextfield.CirclePinField
        android:id="@+id/cpf_pin"
        android:focusable="false"
        android:focusableInTouchMode="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:cursorVisible="false"
        android:inputType="number"
        app:circleRadius="15dp"
        app:distanceInBetween="16dp"
        app:fieldBgColor="?attr/themeColorExtendedGreen15"
        app:fieldColor="@color/green_text_transparent_chip_light"
        app:fillerColor="@color/green_text"
        app:fillerRadius="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:noOfFields="6"/>
    <TextView
        android:id="@+id/tv_error_message"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cpf_pin"
        style="@style/SbTextView.Helper.Error"/>
    <TextView
        android:id="@+id/tv_helper"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cpf_pin"
        style="@style/SbTextView.Helper.Default"/>
    <TextView
        android:textColor="@color/green_text"
        android:id="@+id/tv_forget_pin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cpf_pin"
        style="@style/TypeStyles.HeadingRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
