<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:tag="layout/comp_dialog_share_amount_content_footer_0"
    android:background="@drawable/share_trade_bg_card_footer_bottom_rounded_14"
    android:padding="@dimen/spacing_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorTextPrimary"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_footer_share_amount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/text_share_trade_share_with_value"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/spacing_4"
        style="@style/TypeStyles.BodyRegular"/>
    <com.stockbit.uikit.control.ControlToggleSwitch
        android:layout_gravity="center_vertical"
        android:id="@+id/cts_share_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:switchType="Large"/>
</androidx.appcompat.widget.LinearLayoutCompat>
