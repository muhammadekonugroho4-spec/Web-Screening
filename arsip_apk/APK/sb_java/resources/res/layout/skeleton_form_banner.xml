<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_intro"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <View
        android:id="@+id/aciv_icon"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/clickable_size_56"
        android:layout_height="@dimen/clickable_size_56"
        android:layout_marginTop="@dimen/item_gap_20"
        android:layout_marginStart="@dimen/item_gap_20"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/actv_title"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="0dp"
        android:layout_height="@dimen/clickable_size_16"
        android:layout_marginTop="@dimen/item_gap_20"
        android:layout_marginStart="@dimen/clickable_size_16"
        android:layout_marginEnd="@dimen/item_gap_20"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/aciv_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/actv_desc"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_32"
        android:layout_marginTop="8dp"
        android:layout_marginStart="@dimen/clickable_size_16"
        android:layout_marginEnd="@dimen/item_gap_20"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/aciv_icon"
        app:layout_constraintTop_toBottomOf="@+id/actv_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
