<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme"
    android:tag="layout/fragment_withdraw_confirmation_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_parent_dialog"
        android:background="@drawable/bg_top_rounded"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/indicator"
            android:background="@drawable/bg_gray_collapse"
            android:layout_width="@dimen/clickable_size_38"
            android:layout_height="@dimen/item_gap_5"
            android:layout_marginTop="@dimen/item_gap_12"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <ScrollView
        android:id="@+id/sv_withdraw_confirmation"
        android:background="?attr/themeDialogBackgroundColor"
        android:paddingTop="@dimen/item_gap_20"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/footer_submit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_parent_dialog">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/vf_dialog_confirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_detail_wd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_withdrawal_amount"
                    style="@style/TypeStyles.BodyRegular"/>
                <TextView
                    android:textColor="?attr/themeColorTextGreen"
                    android:gravity="center"
                    android:id="@+id/tv_withdrawal_nominal"
                    android:tag="binding_1"
                    android:paddingTop="@dimen/item_gap_8"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    style="@style/TypeStyles.Nominal"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_20"
                    android:text="@string/setting_withdrawal_transfer_to"
                    android:layout_marginStart="@dimen/item_gap_20"
                    style="@style/SbTextView.BodyDefault.Bold"/>
                <RelativeLayout
                    android:background="@drawable/bg_rounded_4_transparent_colormodal"
                    android:padding="@dimen/item_gap_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_12"
                    android:layout_marginStart="@dimen/item_gap_20"
                    android:layout_marginEnd="@dimen/item_gap_20">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_wd_bank"
                        android:tag="binding_2"
                        android:layout_width="@dimen/width_40"
                        android:layout_height="@dimen/height_40"/>
                    <TextView
                        android:id="@+id/tv_wd_bank_name"
                        android:tag="binding_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toRightOf="@+id/iv_wd_bank"
                        android:layout_marginStart="@dimen/item_gap_16"
                        style="@style/TypeStyles.BodyXSmall"/>
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:id="@+id/tv_wd_number"
                        android:tag="binding_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_2"
                        android:layout_below="@+id/tv_wd_bank_name"
                        android:layout_alignStart="@+id/tv_wd_bank_name"
                        style="@style/TypeStyles.HeadingRegular"/>
                    <TextView
                        android:textSize="@dimen/text_size_11"
                        android:textColor="?attr/themeColorTextSecondary"
                        android:id="@+id/tv_wd_name"
                        android:tag="binding_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_2"
                        android:layout_below="@+id/tv_wd_number"
                        android:layout_marginEnd="@dimen/item_gap_16"
                        android:layout_alignStart="@+id/tv_wd_bank_name"
                        style="@style/TypeStyles.BodyXSmall.Secondary"/>
                </RelativeLayout>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:id="@+id/tv_withdraw_detail_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_20"
                    android:text="@string/withdrawal_detail_request"
                    android:layout_marginStart="@dimen/item_gap_20"
                    style="@style/SbTextView.BodyDefault.Bold"/>
                <RelativeLayout
                    android:id="@+id/tv_withdraw_detail_section"
                    android:background="@drawable/bg_rounded_4_transparent_colormodal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_12"
                    android:layout_marginHorizontal="@dimen/item_gap_20">
                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:shrinkColumns="5">
                        <TableRow
                            android:id="@+id/tr_wd_method"
                            android:padding="@dimen/item_gap_16">
                            <TextView
                                android:id="@+id/tv_transfer_method_label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/withdrawal_method_header"
                                android:layout_weight="1"
                                style="@style/TypeStyles.BodyRegular"/>
                            <TextView
                                android:gravity="end"
                                android:id="@+id/tv_transfer_method_name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                style="@style/TypeStyles.Bold"/>
                        </TableRow>
                        <View
                            android:background="?attr/themeColorModalsDividerThin"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/item_gap_xxxs"/>
                        <TableRow
                            android:id="@+id/tr_wd_amount"
                            android:paddingTop="@dimen/item_gap_13"
                            android:visibility="visible"
                            android:paddingHorizontal="@dimen/item_gap_16">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/setting_withdrawal_amount"
                                android:layout_weight="1"
                                style="@style/TypeStyles.BodyRegular"/>
                            <TextView
                                android:gravity="end"
                                android:id="@+id/tv_wd_amount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                style="@style/TypeStyles.BodyRegular"/>
                        </TableRow>
                        <TableRow
                            android:id="@+id/tr_wd_instant_amount"
                            android:paddingTop="@dimen/item_gap_13"
                            android:visibility="gone"
                            android:paddingHorizontal="@dimen/item_gap_16">
                            <ImageView
                                android:id="@+id/iv_withdrawal_instant_amount"
                                android:layout_width="@dimen/clickable_size_16"
                                android:layout_height="@dimen/clickable_size_16"
                                android:layout_marginEnd="@dimen/spacing_4"
                                app:srcCompat="@drawable/ic_instant"/>
                            <TextView
                                android:textColor="?attr/themeColorGreenDefault"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/setting_withdrawal_instant"
                                android:layout_weight="1"
                                style="@style/TypeStyles.BodyRegular"/>
                            <TextView
                                android:gravity="end"
                                android:id="@+id/tv_withdrawal_instant_amount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                style="@style/TypeStyles.BodyRegular"/>
                        </TableRow>
                        <TableRow
                            android:id="@+id/tr_wd_2_days_amount"
                            android:paddingTop="@dimen/item_gap_13"
                            android:visibility="gone"
                            android:paddingHorizontal="@dimen/item_gap_16">
                            <ImageView
                                android:id="@+id/iv_withdrawal_2_days_amount"
                                android:layout_width="@dimen/clickable_size_16"
                                android:layout_height="@dimen/clickable_size_16"
                                android:layout_marginEnd="@dimen/spacing_4"
                                app:srcCompat="@drawable/ic_timer"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/setting_withdrawal_2_days_title"
                                android:layout_weight="1"
                                style="@style/TypeStyles.BodyRegular"/>
                            <TextView
                                android:gravity="end"
                                android:id="@+id/tv_withdrawal_2_days_amount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                style="@style/TypeStyles.BodyRegular"/>
                        </TableRow>
                        <TableRow
                            android:paddingTop="@dimen/item_gap_13"
                            android:paddingBottom="@dimen/item_gap_16"
                            android:paddingHorizontal="@dimen/item_gap_16">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:text="@string/withdrawal_method_fee_label"
                                android:layout_weight="1"
                                style="@style/TypeStyles.BodyRegular"/>
                            <TextView
                                android:gravity="end"
                                android:id="@+id/tv_wd_fee"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                style="@style/TypeStyles.BodyRegular"/>
                        </TableRow>
                        <View
                            android:background="?attr/themeColorModalsDividerThin"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/item_gap_xxxs"/>
                        <TableRow android:padding="@dimen/item_gap_16">
                            <TextView
                                android:id="@+id/tv_title_wd_amout_after_fee"
                                android:tag="binding_6"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                style="@style/TypeStyles.BodyRegular"/>
                            <TextView
                                android:gravity="end"
                                android:id="@+id/tv_wd_amout_after_fee"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                style="@style/TypeStyles.Bold"/>
                        </TableRow>
                    </TableLayout>
                </RelativeLayout>
                <TextView
                    android:id="@+id/tv_withdrawal_information"
                    android:background="?attr/themeColorPeriwinkleLowMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_20"
                    android:text="@string/setting_transfer_dana"
                    android:drawablePadding="@dimen/item_gap_16"
                    android:layout_marginStart="@dimen/item_gap_20"
                    android:layout_marginEnd="@dimen/item_gap_20"
                    android:paddingHorizontal="@dimen/item_gap_16"
                    android:paddingVertical="@dimen/item_gap_12"
                    app:drawableStartCompat="@drawable/ic_info"
                    app:drawableTint="?attr/themeColorFeaturePeriwinkle"
                    style="@style/TypeStyles.BodyXSmall"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_operational_warning"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/item_gap_20">
                <ImageView
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="?attr/themeIconWithdrawOperation"/>
                <TextView
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_20"
                    android:text="@string/withdrawal_method_outside_operational_title"
                    style="@style/TypeStyles.HeadlineRegular"/>
                <TextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_12"
                    android:text="@string/withdrawal_method_outside_operational_label"
                    style="@style/TypeStyles.BodyRegular"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_32"
                    android:layout_marginBottom="@dimen/item_gap_20">
                    <com.stockbit.uikit.button.SecondaryNeutralButton
                        android:id="@+id/btn_cancel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/button_cancel"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:layout_marginEnd="@dimen/spacing_8"/>
                    <com.stockbit.uikit.button.PrimaryButton
                        android:id="@+id/btn_continue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/lbl_btn_continue"
                        android:layout_weight="1"
                        android:textAllCaps="false"
                        android:layout_marginStart="@dimen/spacing_8"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/footer_submit"
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sv_withdraw_confirmation">
        <Button
            android:textColor="@color/white"
            android:id="@+id/btn_withdrawal_dialogal_submit"
            android:background="@drawable/btn_green_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_40"
            android:layout_marginBottom="@dimen/item_gap_20"
            android:foreground="?attr/selectableItemBackground"
            android:text="@string/setting_withdraw"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/item_gap_20"
            style="@style/TypeStyles.HeadingRegular"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
