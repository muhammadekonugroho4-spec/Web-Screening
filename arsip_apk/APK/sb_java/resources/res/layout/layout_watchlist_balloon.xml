<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/layout_watchlist_balloon_0"
    android:background="?attr/themeColorSurfaceVariant"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/group_delete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/menu_delete"
            android:background="?attr/selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_20"
            android:paddingVertical="@dimen/spacing_12">
            <TextView
                android:textColor="?attr/themeColorTextRed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/watchlist_menu_delete"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                style="@style/TypeStyles.BodyLarge"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_watchlist_menu_delete"
                android:layout_centerVertical="true"
                android:contentDescription="@string/watchlist_menu_delete"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:background="?attr/themeColorDividerGreyBorder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_1"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/menu_pin"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_12">
        <TextView
            android:textColor="?attr/themeColorTextPrimary"
            android:id="@+id/tv_pin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watchlist_menu_pin"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            style="@style/TypeStyles.BodyLarge"/>
        <ImageView
            android:id="@+id/img_pin"
            android:padding="1.5dp"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_watchlist_pin"
            android:layout_centerVertical="true"
            android:contentDescription="@string/watchlist_menu_sort"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="?attr/themeColorDividerGreyBorder"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_1"/>
    <RelativeLayout
        android:id="@+id/menu_sort"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_12">
        <TextView
            android:textColor="?attr/themeColorTextPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watchlist_menu_sort"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            style="@style/TypeStyles.BodyLarge"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_watchlist_menu_sort"
            android:layout_centerVertical="true"
            android:contentDescription="@string/watchlist_menu_sort"
            android:layout_alignParentEnd="true"
            app:tint="?attr/themeColorIconDefault"/>
    </RelativeLayout>
    <View
        android:background="?attr/themeColorDividerGreyBorder"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_1"/>
    <RelativeLayout
        android:id="@+id/menu_edit"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_12">
        <TextView
            android:textColor="?attr/themeColorTextPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watchlist_menu_edit_and_sort"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            style="@style/TypeStyles.BodyLarge"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_watchlist_menu_edit"
            android:layout_centerVertical="true"
            android:contentDescription="@string/watchlist_menu_edit_and_sort"
            android:layout_alignParentEnd="true"
            app:tint="?attr/themeColorIconDefault"/>
    </RelativeLayout>
    <View
        android:background="#1f000000"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_6"/>
    <RelativeLayout
        android:id="@+id/menu_notes"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_12">
        <TextView
            android:textColor="?attr/themeColorTextPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watchlist_menu_notes"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            style="@style/TypeStyles.BodyLarge"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_watchlist_menu_notes"
            android:layout_centerVertical="true"
            android:contentDescription="@string/watchlist_menu_notes"
            android:layout_alignParentEnd="true"
            app:tint="?attr/themeColorIconDefault"/>
    </RelativeLayout>
    <View
        android:background="?attr/themeColorDividerGreyBorder"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_1"/>
    <RelativeLayout
        android:id="@+id/menu_price_alert"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_12">
        <TextView
            android:textColor="?attr/themeColorTextPrimary"
            android:id="@+id/tv_alert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watchlist_menu_alert"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            style="@style/TypeStyles.BodyLarge"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_watchlist_menu_price_alert"
            android:layout_centerVertical="true"
            android:contentDescription="@string/watchlist_menu_price_alert"
            android:layout_alignParentEnd="true"
            app:tint="?attr/themeColorIconDefault"/>
    </RelativeLayout>
    <View
        android:background="#1f000000"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_6"/>
    <RelativeLayout
        android:id="@+id/menu_favorite"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_12">
        <TextView
            android:textColor="?attr/themeColorTextPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/watchlist_menu_price_favorite"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            style="@style/TypeStyles.BodyLarge"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_watchlist_menu_favorite"
            android:layout_centerVertical="true"
            android:contentDescription="@string/watchlist_menu_price_favorite"
            android:layout_alignParentEnd="true"
            app:tint="?attr/themeColorIconDefault"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/group_buy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="#1f000000"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_6"/>
        <RelativeLayout
            android:id="@+id/menu_buy"
            android:background="?attr/themeColorBorderGreen"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            android:paddingHorizontal="@dimen/spacing_20"
            android:paddingVertical="@dimen/spacing_12">
            <TextView
                android:textColor="@color/light_type_textwhite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/watchlist_menu_price_buy"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                style="@style/TypeStyles.BodyLarge"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_watchlist_menu_buy"
                android:layout_centerVertical="true"
                android:contentDescription="@string/watchlist_menu_price_buy"
                android:layout_alignParentEnd="true"
                app:tint="@color/light_type_textwhite"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
