<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_parent_company_address"
    android:tag="layout/comp_company_profile_address_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_company_profile_address_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        android:text="@string/company_profile_address"
        android:layout_marginStart="@dimen/item_gap_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:id="@+id/tv_company_profile_address"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:layout_marginEnd="@dimen/item_gap_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_company_profile_address_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_company_profile_address_title"
        style="@style/TypeStyles.BodyRegular"/>
    <View
        android:background="?attr/themeSeparatorGapColor"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/item_gap_16"
        app:layout_constraintTop_toBottomOf="@+id/tv_company_profile_address"/>
</androidx.constraintlayout.widget.ConstraintLayout>
