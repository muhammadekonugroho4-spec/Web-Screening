<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:tag="layout/dialog_create_watchlist_0"
    android:background="?attr/themeDialogBackgroundColor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/clickable_size_72">
    <EditText
        android:id="@+id/etGroupName"
        android:paddingLeft="@dimen/item_gap_m"
        android:paddingTop="@dimen/item_gap_l"
        android:paddingRight="@dimen/item_gap_m"
        android:paddingBottom="@dimen/item_gap_l"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_l"
        android:layout_marginRight="@dimen/item_gap_l"
        android:hint="@string/placeholder_watchlist_insert"
        android:maxLines="1"
        android:minLines="2"
        android:maxLength="50"
        android:inputType="textCapWords"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        style="@style/SbEditTextStyle.Medium"/>
</LinearLayout>
