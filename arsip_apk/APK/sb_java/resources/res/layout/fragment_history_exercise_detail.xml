<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_history_exercise_detail_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_trading_history_exercise_stockbit_detail"
        android:paddingLeft="@dimen/spacing_0"
        android:paddingRight="@dimen/spacing_0"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:contentInsetLeft="@dimen/spacing_0"
        app:contentInsetStart="@dimen/spacing_0"
        app:contentInsetStartWithNavigation="@dimen/spacing_0"
        app:elevation="@dimen/spacing_0">
        <RelativeLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minHeight="?attr/actionBarSize">
            <TextView
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/tv_toolbar_title_trading_history_exercise_stockbit_detail"
                android:tag="binding_1"
                android:paddingLeft="@dimen/spacing_16"
                android:paddingRight="@dimen/spacing_16"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:singleLine="true"
                android:layout_centerHorizontal="true"
                android:textAlignment="gravity"
                style="@style/TopBar.Title"/>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <ViewFlipper
        android:id="@+id/vf_fragment_trading_history_exercise_stockbit_detail"
        android:tag="binding_2"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/sfl_trading_history_exercise_stockbit_detail_loading"
            android:paddingTop="@dimen/item_gap_m"
            android:paddingBottom="@dimen/spacing_16"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <include layout="@layout/skeleton_item_history_stockbit_detail"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <RelativeLayout
                android:id="@+id/ll_trading_history_exercise_stockbit_detail_company_layout"
                android:tag="binding_4"
                android:background="@drawable/border_gray_rounded_white_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:layout_marginBottom="@dimen/spacing_6"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginStart="@dimen/spacing_16"
                android:layout_marginEnd="@dimen/spacing_16"
                android:paddingHorizontal="@dimen/spacing_16"
                android:paddingVertical="@dimen/spacing_12">
                <ImageView
                    android:id="@+id/iv_company_logo"
                    android:tag="binding_5"
                    android:layout_width="@dimen/spacing_40"
                    android:layout_height="@dimen/spacing_40"/>
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/item_gap_10"
                    android:layout_toEndOf="@+id/iv_company_logo">
                    <TextView
                        android:textColor="?attr/themeColorTextPrimary"
                        android:id="@+id/tv_trading_history_exercise_stockbit_detail_symbol_title"
                        android:tag="binding_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TypeStyles.HeadingRegular"/>
                    <TextView
                        android:ellipsize="end"
                        android:id="@+id/tv_trading_history_exercise_stockbit_detail_desc_title"
                        android:tag="binding_7"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_2"
                        android:maxLines="1"
                        android:layout_below="@+id/tv_trading_history_exercise_stockbit_detail_symbol_title"
                        style="@style/TypeStyles.BodyXSmall.Secondary"/>
                    <RelativeLayout
                        android:id="@+id/rl_history_detail_exercise_acceleration"
                        android:tag="binding_8"
                        android:background="@drawable/border_green_button"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/clickable_size_18"
                        android:layout_above="@+id/tv_trading_history_exercise_stockbit_detail_desc_title"
                        android:layout_marginStart="@dimen/spacing_6"
                        android:layout_toEndOf="@+id/tv_trading_history_exercise_stockbit_detail_symbol_title">
                        <TextView
                            android:textSize="@dimen/text_size_12"
                            android:textColor="@color/light_type_textgreen"
                            android:id="@+id/badgeText"
                            android:tag="binding_9"
                            android:paddingLeft="@dimen/spacing_8"
                            android:paddingTop="@dimen/spacing_2"
                            android:paddingRight="@dimen/spacing_8"
                            android:paddingBottom="@dimen/spacing_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            style="@style/SbTextView.BodyDefault.Green.Bold"/>
                    </RelativeLayout>
                    <RelativeLayout
                        android:id="@+id/rl_trading_history_exercise_stockbit_detail_desc_indexes"
                        android:tag="binding_10"
                        android:background="@drawable/border_green_button"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/clickable_size_18"
                        android:layout_above="@+id/tv_trading_history_exercise_stockbit_detail_desc_title"
                        android:layout_marginStart="@dimen/spacing_6"
                        android:layout_toEndOf="@+id/rl_history_detail_exercise_acceleration">
                        <TextView
                            android:textSize="@dimen/text_size_12"
                            android:textColor="@color/light_type_textgreen"
                            android:paddingLeft="@dimen/spacing_8"
                            android:paddingTop="@dimen/spacing_2"
                            android:paddingRight="@dimen/spacing_8"
                            android:paddingBottom="@dimen/spacing_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/buy_title_syariah_title"
                            android:layout_centerInParent="true"
                            style="@style/SbTextView.BodyDefault.Green.Bold"/>
                    </RelativeLayout>
                </RelativeLayout>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/border_gray_rounded_white_bg"
                android:paddingTop="@dimen/spacing_6"
                android:paddingBottom="@dimen/spacing_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_6"
                android:layout_marginBottom="@dimen/spacing_16"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginStart="@dimen/spacing_16"
                android:layout_marginEnd="@dimen/spacing_16">
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/spacing_16"
                    android:paddingRight="@dimen/spacing_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:paddingTop="@dimen/item_gap_m"
                        android:paddingBottom="@dimen/item_gap_m"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/trading_history_date_title"
                        android:layout_weight="1"
                        style="@style/TypeStyles.BodyRegular"/>
                    <TextView
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_trading_history_exercise_stockbit_detail_history_date"
                        android:tag="binding_11"
                        android:paddingTop="@dimen/item_gap_m"
                        android:paddingBottom="@dimen/item_gap_m"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAlignment="gravity"
                        style="@style/TypeStyles.BodyRegular"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/spacing_16"
                    android:paddingRight="@dimen/spacing_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/title_price"
                        android:paddingTop="@dimen/item_gap_m"
                        android:paddingBottom="@dimen/item_gap_m"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/trading_history_exercise_price_title"
                        android:layout_weight="1"
                        style="@style/TypeStyles.BodyRegular"/>
                    <TextView
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_trading_history_exercise_stockbit_detail_price"
                        android:tag="binding_12"
                        android:paddingTop="@dimen/item_gap_m"
                        android:paddingBottom="@dimen/item_gap_m"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAlignment="gravity"
                        style="@style/TypeStyles.BodyRegular"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:paddingLeft="@dimen/spacing_16"
                    android:paddingRight="@dimen/spacing_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/title_shares"
                        android:paddingTop="@dimen/item_gap_m"
                        android:paddingBottom="@dimen/item_gap_m"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/trading_history_exercise_shares_title"
                        android:layout_weight="1"
                        style="@style/TypeStyles.BodyRegular"/>
                    <TextView
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_trading_history_exercise_stockbit_detail_lot_done"
                        android:tag="binding_13"
                        android:paddingTop="@dimen/item_gap_m"
                        android:paddingBottom="@dimen/item_gap_m"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAlignment="gravity"
                        style="@style/TypeStyles.BodyRegular"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/parent_tax_amount"
                    android:paddingLeft="@dimen/spacing_16"
                    android:paddingRight="@dimen/spacing_16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:paddingTop="@dimen/item_gap_m"
                        android:paddingBottom="@dimen/item_gap_m"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/trading_history_tax_amount_percent_title"
                        android:layout_weight="1"
                        style="@style/TypeStyles.BodyRegular"/>
                    <TextView
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_tax_amount"
                        android:tag="binding_14"
                        android:paddingTop="@dimen/item_gap_m"
                        android:paddingBottom="@dimen/item_gap_m"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAlignment="gravity"
                        style="@style/TypeStyles.BodyRegular"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/ll_layout_trading_history_exercise_stockbit_detail_exercise_amount"
                    android:paddingLeft="@dimen/spacing_16"
                    android:paddingRight="@dimen/spacing_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/title_amount"
                        android:paddingTop="@dimen/item_gap_m"
                        android:paddingBottom="@dimen/item_gap_m"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/trading_history_exercise_amount_title"
                        android:layout_weight="1"
                        style="@style/TypeStyles.HeadingRegular"/>
                    <TextView
                        android:textStyle="bold"
                        android:gravity="end|center_vertical"
                        android:id="@+id/tv_trading_history_exercise_stockbit_detail_exercise_amount"
                        android:tag="binding_15"
                        android:paddingTop="@dimen/item_gap_m"
                        android:paddingBottom="@dimen/item_gap_m"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAlignment="gravity"
                        style="@style/TypeStyles.BodyRegular"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <include
            android:layout_gravity="center"
            android:id="@+id/parent_error_trading_history_exercise_stockbit_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/comp_icon_error_view"/>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsv_fragment_trading_history_exercise_stockbit_detail"
            android:tag="binding_16"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <include layout="@layout/comp_empty_data_trading_stockbit_history"/>
        </androidx.core.widget.NestedScrollView>
    </ViewFlipper>
</androidx.appcompat.widget.LinearLayoutCompat>
