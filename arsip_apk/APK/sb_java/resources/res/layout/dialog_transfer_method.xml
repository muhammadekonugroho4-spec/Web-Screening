<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_transfer_method_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/bg_white_rounded"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
        <View
            android:id="@+id/indicator"
            android:background="@drawable/bg_gray_collapse"
            android:layout_width="@dimen/clickable_size_38"
            android:layout_height="@dimen/item_gap_5"
            android:layout_marginTop="@dimen/item_gap_12"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:id="@+id/tv_title_select_method"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/withdrawal_method_header"
            android:layout_marginVertical="@dimen/item_gap_20"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/TypeStyles.HeadlineRegular"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/list_method"
            android:paddingTop="@dimen/item_gap_16"
            android:paddingBottom="@dimen/item_gap_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/item_gap_20"/>
    </LinearLayout>
</ScrollView>
