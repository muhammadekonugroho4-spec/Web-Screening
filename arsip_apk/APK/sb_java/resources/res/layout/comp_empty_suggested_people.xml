<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/comp_empty_suggested_people_0"
    android:background="?attr/themeContentBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/height_19">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ivEmptyImg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_l"
        android:layout_marginBottom="@dimen/item_gap_l"
        android:layout_above="@+id/tvTitleEmpty"
        android:layout_centerHorizontal="true"
        app:srcCompat="@drawable/ic_empty_suggested"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="center"
        android:id="@+id/tvTitleEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_24"
        android:text="@string/lbl_title_suggested_empty"
        android:layout_centerInParent="true"
        android:textAlignment="gravity"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:textColor="?attr/themeColorTextGreen"
        android:gravity="center"
        android:id="@+id/btnDiscoverMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_14"
        android:text="@string/lbl_action_suggested_empty"
        android:layout_below="@+id/tvTitleEmpty"
        android:layout_centerInParent="true"
        android:textAlignment="gravity"
        android:paddingHorizontal="@dimen/item_gap_20"
        android:paddingVertical="12.5dp"
        style="@style/TypeStyles.HeadingRegular"/>
</RelativeLayout>
