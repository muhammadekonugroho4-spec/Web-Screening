<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_parent_shareholder_percentage"
    android:tag="layout/comp_company_profile_shareholder_percentage_0"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_shareholder_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:text="@string/title_company_profile_shareholder"
        android:layout_marginStart="@dimen/item_gap_20"
        android:layout_marginEnd="@dimen/item_gap_4"
        app:layout_constraintEnd_toStartOf="@+id/tv_shareholder_last_updated"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingLarge"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:id="@+id/tv_shareholder_last_updated"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_shareholder_title"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/TypeStyles.BodyXSmall"/>
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_shareholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:layout_marginStart="@dimen/item_gap_16"
        app:chipSpacingHorizontal="@dimen/item_gap_s"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_shareholder_title"
        app:selectionRequired="true"
        app:singleLine="true"
        app:singleSelection="true">
        <com.google.android.material.chip.Chip
            android:textAppearance="@style/SdChipText"
            android:id="@+id/chip_above_one_percent"
            android:padding="@dimen/item_gap_s"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/chip_company_profile_shareholder_above_one_percent"
            style="@style/SbChipGreenBackground"/>
        <com.google.android.material.chip.Chip
            android:textAppearance="@style/SdChipText"
            android:id="@+id/chip_hundred_percent"
            android:padding="@dimen/item_gap_s"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chip_company_profile_shareholder_hundred_percent"
            style="@style/SbChipGreenBackground"/>
    </com.google.android.material.chip.ChipGroup>
    <TextView
        android:id="@+id/tv_column_header_shareholders"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:text="@string/title_company_profile_shareholder_name"
        android:layout_marginStart="@dimen/item_gap_20"
        android:layout_marginEnd="@dimen/item_gap_4"
        app:layout_constraintEnd_toStartOf="@+id/tv_shareholder_title_percentage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chip_group_shareholder"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_shareholder_title_percentage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        android:text="@string/title_company_profile_shareholder_shares"
        android:layout_marginStart="@dimen/item_gap_4"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_column_header_shareholders"
        app:layout_constraintTop_toBottomOf="@+id/chip_group_shareholder"
        style="@style/TypeStyles.HeadingRegular"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_shareholder_percentage"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="@+id/tv_shareholder_title_percentage"
        app:layout_constraintStart_toStartOf="@+id/tv_column_header_shareholders"
        app:layout_constraintTop_toBottomOf="@+id/tv_shareholder_title_percentage"/>
    <ImageView
        android:id="@+id/iv_badge_controller"
        android:layout_width="@dimen/width_14"
        android:layout_height="@dimen/height_14"
        android:layout_marginTop="@dimen/item_gap_12"
        app:layout_constraintStart_toStartOf="@+id/rv_shareholder_percentage"
        app:layout_constraintTop_toBottomOf="@+id/rv_shareholder_percentage"
        app:srcCompat="?attr/themeIconBadgeController"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:id="@+id/tv_badge_controller"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_company_profile_shareholder_controlling"
        android:layout_marginStart="@dimen/item_gap_7"
        app:layout_constraintStart_toEndOf="@+id/iv_badge_controller"
        app:layout_constraintTop_toBottomOf="@+id/rv_shareholder_percentage"
        app:layout_constraintTop_toTopOf="@+id/iv_badge_controller"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:textColor="?attr/themeColorTextGreen"
        android:gravity="center"
        android:id="@+id/tv_read_more_and_less"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_8"
        android:text="@string/button_show_more"
        app:layout_constraintEnd_toEndOf="@+id/rv_shareholder_percentage"
        app:layout_constraintStart_toStartOf="@+id/rv_shareholder_percentage"
        app:layout_constraintTop_toBottomOf="@+id/tv_badge_controller"
        style="@style/SbTextView.BodyDefault"/>
    <View
        android:id="@+id/v_shareholder_percentage_separator"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/item_gap_22"
        android:layout_marginHorizontal="@dimen/item_gap_16"
        app:layout_constraintTop_toBottomOf="@+id/tv_read_more_and_less"
        app:layout_goneMarginTop="@dimen/item_gap_16"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_badges_legend"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:constraint_referenced_ids="tv_badge_controller, iv_badge_controller"/>
</androidx.constraintlayout.widget.ConstraintLayout>
