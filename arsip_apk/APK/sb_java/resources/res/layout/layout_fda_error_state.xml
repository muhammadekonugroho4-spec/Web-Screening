<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:id="@+id/ll_error"
    android:tag="layout/layout_fda_error_state_0"
    android:background="?attr/themeContentBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/item_gap_16">
    <ImageView
        android:id="@+id/iv_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_30"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/themeIconNetworkErrorInternalServer"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="?attr/themeColorTextPrimary"
        android:id="@+id/tv_error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_8"
        android:text="@string/uikit_generic_network_error_title_internal_server"
        android:fontFamily="@font/bitsans_bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_error"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="center"
        android:id="@+id/tv_error_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_20"
        android:text="@string/uikit_generic_network_error_desc_internal_server"
        android:fontFamily="@font/bitsans_regular"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_error_title"
        style="@style/TypeStyles.BodyXSmall"/>
    <ProgressBar
        android:id="@+id/pb_try_again"
        android:visibility="invisible"
        android:layout_width="@dimen/item_gap_24"
        android:layout_height="@dimen/item_gap_24"
        app:layout_constraintBottom_toBottomOf="@+id/btn_try_again"
        app:layout_constraintEnd_toEndOf="@+id/btn_try_again"
        app:layout_constraintStart_toStartOf="@+id/btn_try_again"
        app:layout_constraintTop_toTopOf="@+id/btn_try_again"/>
    <com.stockbit.uikit.buttons.EllipseButton
        android:textSize="@dimen/text_button_dialog"
        android:textColor="@color/white"
        android:id="@+id/btn_try_again"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_40"
        android:layout_marginTop="@dimen/item_gap_20"
        android:text="@string/common_try_again_en"
        android:textAllCaps="false"
        android:fontFamily="@font/bitsans_bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_error_desc"/>
</androidx.constraintlayout.widget.ConstraintLayout>
