<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?android:attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/payment_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/img_payment_method_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="@dimen/sixteen_dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="@dimen/sixteen_dp"
                android:layout_marginBottom="10dp"
                android:layout_centerVertical="true"
                android:contentDescription="@string/description_payment_method_icon"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/payment_text_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/badge_promo"
                android:layout_toRightOf="@+id/img_payment_method_icon"
                android:layout_centerVertical="true">
                <com.midtrans.sdk.uikit.widgets.SemiBoldTextView
                    android:textColor="@color/black"
                    android:id="@+id/text_payment_method_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:textSize="12sp"
                    android:textColor="@color/black"
                    android:ellipsize="end"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/text_payment_method_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="2"/>
            </LinearLayout>
            <View
                android:id="@+id/divider"
                android:background="@color/gray_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_alignLeft="@+id/payment_text_container"
                android:layout_alignParentBottom="true"/>
            <ImageView
                android:id="@+id/image_arrow_right"
                android:layout_width="@dimen/twenty_four_dp"
                android:layout_height="@dimen/twenty_four_dp"
                android:layout_marginRight="@dimen/eight_dp"
                android:src="0x7f0804cf"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:alpha="0.3"
                android:layout_marginEnd="@dimen/eight_dp"
                android:layout_alignParentEnd="true"/>
            <com.midtrans.sdk.uikit.widgets.FancyButton
                android:layout_gravity="center_vertical"
                android:id="@+id/badge_promo"
                android:paddingLeft="@dimen/eight_dp"
                android:paddingTop="@dimen/four_dp"
                android:paddingRight="@dimen/eight_dp"
                android:paddingBottom="@dimen/four_dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toLeftOf="@+id/image_arrow_right"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/image_arrow_right"
                app:fb_defaultColor="@color/promoBadge"
                app:fb_radius="10sp"
                app:fb_text="promo"
                app:fb_textColor="@color/gray.primary_dark"
                app:fb_textSize="10dp"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/layout_payment_unavailable"
            android:background="@color/disable"
            android:visibility="invisible"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.5"/>
    </FrameLayout>
    <com.midtrans.sdk.uikit.widgets.DefaultTextView
        android:textSize="12sp"
        android:textColor="@color/black"
        android:id="@+id/text_option_unavailable"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/four_dp"
        android:layout_marginBottom="@dimen/four_dp"
        android:text="@string/payment_method_unavailable"
        android:lines="1"
        android:layout_below="@+id/payment_info"
        android:layout_centerHorizontal="true"/>
</RelativeLayout>
