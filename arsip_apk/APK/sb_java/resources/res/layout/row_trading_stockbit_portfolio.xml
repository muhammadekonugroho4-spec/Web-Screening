<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_trading_stockbit_portfolio_0"
    android:layout_width="match_parent"
    android:layout_height="@dimen/clickable_size_75">
    <RelativeLayout
        android:id="@+id/rl_trading_portfolio_row_buy_sell"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_trading_portfolio_row_buy"
            android:background="@color/green_text"
            android:padding="@dimen/item_gap_m"
            android:layout_width="@dimen/swipe_size_80"
            android:layout_height="@dimen/clickable_size_75"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:text="@string/btn_buy_watchlist"
            android:layout_alignParentLeft="true"
            android:fontFamily="@font/bitsans_bold"
            style="@style/TypeStyles.HeadingLarge"/>
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="start"
            android:id="@+id/tv_trading_portfolio_row_sell"
            android:background="@color/google_red"
            android:paddingLeft="@dimen/spacing_16"
            android:paddingRight="@dimen/spacing_16"
            android:layout_width="@dimen/swipe_size_80"
            android:layout_height="@dimen/clickable_size_75"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:minWidth="@dimen/clickable_size_75"
            android:text="@string/btn_sell"
            android:layout_toRightOf="@+id/tv_trading_portfolio_row_buy"
            android:fontFamily="@font/bitsans_bold"
            style="@style/TypeStyles.HeadingLarge"/>
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_trading_portfolio_row_exercise"
            android:background="?attr/themeColorFeatureViolet"
            android:padding="@dimen/spacing_4"
            android:visibility="gone"
            android:layout_width="@dimen/swipe_size_80"
            android:layout_height="@dimen/clickable_size_75"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:text="@string/btn_exercise_portfolio"
            android:layout_toRightOf="@+id/tv_trading_portfolio_row_sell"
            style="@style/TypeStyles.HeadingLarge"/>
    </RelativeLayout>
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/ll_parent_portfolio"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="?attr/selectableItemBackground"
        android:layout_marginHorizontal="@dimen/spacing_20">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_trading_portfolio_row_symbol_container"
            android:layout_width="wrap_content"
            android:layout_height="18dp">
            <TextView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_trading_portfolio_row_symbol"
                android:layout_width="wrap_content"
                android:layout_height="18dp"
                android:layout_marginEnd="@dimen/item_gap_xs"
                style="@style/TypeStyles.HeadingSmall"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_trading_portfolio_row_notation_company"
                android:visibility="gone"
                android:layout_width="@dimen/width_12"
                android:layout_height="@dimen/height_12"
                android:scaleType="fitXY"
                android:layout_marginStart="@dimen/item_gap_xs"
                android:layout_marginEnd="@dimen/item_gap_xs"
                app:srcCompat="@drawable/ic_notasi_khusus"/>
            <androidx.recyclerview.widget.RecyclerView
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/rv_horizontal_notation"
                android:visibility="gone"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/width_12"
                android:minHeight="@dimen/height_16"
                android:layout_marginStart="@dimen/spacing_2"
                android:layout_marginEnd="@dimen/spacing_2"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:spanCount="1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_trading_portfolio_row_corporate_action"
                android:visibility="gone"
                android:layout_width="@dimen/width_12"
                android:layout_height="@dimen/width_12"
                android:layout_marginStart="@dimen/item_gap_xs"
                android:layout_marginEnd="@dimen/item_gap_xs"
                app:srcCompat="@drawable/ic_corporate_action"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_non_sharia"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_4"
                app:srcCompat="?attr/themeIconNonSharia"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/rl_trading_portfolio_row_balance"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_33"
                android:layout_weight="1">
                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_trading_portfolio_row_invested"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_alignParentLeft="true"
                    style="@style/TypeStyles.BodySmall"/>
                <TextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="15dp"
                    android:text="@string/lbl_portfolio_invested"
                    android:layout_below="@+id/tv_trading_portfolio_row_invested"
                    android:layout_alignParentLeft="true"
                    style="@style/TypeStyles.BodyXXSmall"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_trading_portfolio_row_inves"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_trading_portfolio_row_pnl"
                    android:paddingTop="@dimen/spacing_2"
                    android:paddingBottom="@dimen/spacing_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/n_dash"
                    android:layout_centerHorizontal="true"
                    style="@style/TypeStyles.BodySmall"/>
                <TextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_title_pl"
                    android:layout_below="@+id/tv_trading_portfolio_row_pnl"
                    android:layout_centerHorizontal="true"
                    style="@style/TypeStyles.BodyXXSmall"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_trading_portfolio_row_profit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:layout_marginEnd="@dimen/spacing_16">
                <TextView
                    android:gravity="end"
                    android:id="@+id/tv_trading_portfolio_row_ghain"
                    android:paddingTop="@dimen/spacing_2"
                    android:paddingBottom="@dimen/spacing_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/n_dash"
                    android:layout_alignLeft="@+id/tv_trading_portfolio_row_ghain_title"
                    android:layout_alignRight="@+id/tv_trading_portfolio_row_ghain_title"
                    style="@style/TypeStyles.BodySmall"/>
                <TextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:gravity="end"
                    android:id="@+id/tv_trading_portfolio_row_ghain_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/clickable_size_75"
                    android:text="@string/lbl_portfolio_gain"
                    android:layout_below="@+id/tv_trading_portfolio_row_ghain"
                    style="@style/TypeStyles.BodyXXSmall"/>
            </RelativeLayout>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_trading_portfolio_row_chevron_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_chevron_right_grey"
                app:tint="?attr/themeIconTintColorLow"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
