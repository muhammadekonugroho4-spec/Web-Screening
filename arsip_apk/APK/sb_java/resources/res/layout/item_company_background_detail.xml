<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_company_background_detail_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:id="@+id/tv_title_company_name"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_13"
        android:text="@string/company_profile_company_name"
        android:layout_marginEnd="@dimen/item_gap_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_company_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/item_gap_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_title_company_name"
        app:layout_constraintTop_toTopOf="@+id/tv_title_company_name"
        style="@style/TypeStyles.BodyRegular"/>
    <View
        android:id="@+id/v_company_name_separator"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/item_gap_13"
        app:layout_constraintTop_toBottomOf="@+id/tv_company_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
