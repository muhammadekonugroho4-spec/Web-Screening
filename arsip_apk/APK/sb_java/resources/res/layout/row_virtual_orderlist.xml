<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/row_virtual_orderlist_0"
    android:background="?attr/themeContentBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center"
        android:layout_gravity="start"
        android:id="@+id/tvNoSwipe"
        android:background="@color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/clickable_size_48"/>
    <LinearLayout
        android:id="@+id/llSwipeMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true">
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/tvDelete"
            android:background="@color/google_red"
            android:padding="@dimen/item_gap_s"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/clickable_size_48"
            android:text="@string/btn_cancel_order"
            style="@style/SbTextView.BodyDefault"/>
    </LinearLayout>
    <RelativeLayout
        android:id="@+id/rlContentLayout"
        android:background="@drawable/bg_list_selector"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_48"
            android:layout_marginStart="@dimen/item_gap_l"
            android:layout_marginEnd="@dimen/item_gap_l">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_size_12"
                android:textColor="@color/green_text"
                android:gravity="center"
                android:id="@+id/symbol"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="2"
                android:layout_weight="1.13"
                style="@style/SbTextView.BodyDefault"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_size_12"
                android:gravity="center"
                android:id="@+id/amount"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="2"
                android:layout_weight="1"
                android:textAlignment="gravity"
                style="@style/SbTextView.BodyDefault"/>
            <TextView
                android:textSize="@dimen/text_size_12"
                android:gravity="center"
                android:id="@+id/price"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_weight="1.2"
                android:textAlignment="gravity"
                style="@style/SbTextView.BodyDefault"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_size_12"
                android:gravity="center"
                android:id="@+id/tvExpiryOrder"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_weight="1.2"
                android:textAlignment="gravity"
                style="@style/SbTextView.BodyDefault"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_size_11"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tvStatusOrder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_weight="1.1"
                android:textAlignment="gravity"/>
        </LinearLayout>
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</RelativeLayout>
