<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/header_item_subscription_history_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_header_subscription_history"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="?attr/themeIconHeaderSubscriptionHistory"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_date_subscription_history"
        android:background="@drawable/bg_border_gray_rounded_outline"
        android:padding="@dimen/item_gap_16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_header_subscription_history">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_date_subscription_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="?attr/themeIconSubscriptionPaywall"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_date_desc_subscription_history"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/item_gap_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_date_subscription_history"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.ParagraphRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorTextPrimary"
        android:id="@+id/tv_title_subscription_history"
        android:background="?attr/themeColorSurfaceVariant"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:text="@string/text_title_history"
        android:paddingStart="@dimen/item_gap_20"
        android:paddingVertical="@dimen/item_gap_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_date_subscription_history"
        app:layout_goneMarginTop="@dimen/spacing_0"
        style="@style/TypeStyles.HeadingLarge"/>
</androidx.constraintlayout.widget.ConstraintLayout>
