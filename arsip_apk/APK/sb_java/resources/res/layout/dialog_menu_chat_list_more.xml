<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_menu_chat_list_more_0"
    android:background="@drawable/bg_top_rounded_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <View
        android:id="@+id/v_devider_top"
        android:background="@drawable/bg_rounded_gray_gray_bg"
        android:layout_width="@dimen/width_40"
        android:layout_height="@dimen/item_gap_5"
        android:layout_marginTop="@dimen/item_gap_12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_barrier"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/height_28"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_devider_top"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_item_group_chat_setting"
        android:tag="binding_1"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="@dimen/item_gap_20"
        android:paddingTop="@dimen/height_8"
        android:paddingRight="@dimen/item_gap_20"
        android:paddingBottom="@dimen/height_8"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_barrier">
        <ImageView
            android:id="@+id/iv_icon_group_chat_setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_chat_option_lock"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/highgray_light"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chay_menu_option_privacy"
            android:layout_marginStart="@dimen/item_gap_12"
            app:layout_constraintBottom_toBottomOf="@+id/iv_icon_group_chat_setting"
            app:layout_constraintLeft_toRightOf="@+id/iv_icon_group_chat_setting"
            app:layout_constraintTop_toTopOf="@+id/iv_icon_group_chat_setting"
            style="@style/TypeStyles.BodyRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
