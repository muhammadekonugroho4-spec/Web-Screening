<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_company_corporate_stock_dividen_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/themeColorTextGreen"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:text="@string/title_corp_action_stock_dividend"
        android:layout_marginStart="@dimen/spacing_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingRegular"/>
    <ImageView
        android:id="@+id/iv_ongoing"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_ongoing"
        android:layout_marginStart="@dimen/spacing_8"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintStart_toEndOf="@+id/tv_title"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <TextView
        android:id="@+id/tv_ratio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="@string/text_corp_action_item_ratio"
        app:layout_constraintStart_toStartOf="@+id/tv_title"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:id="@+id/tv_value_ratio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_20"
        app:layout_constraintBottom_toBottomOf="@+id/tv_ratio"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_ratio"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_factor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="@string/text_corp_action_item_factor"
        app:layout_constraintStart_toStartOf="@+id/tv_ratio"
        app:layout_constraintTop_toBottomOf="@+id/tv_ratio"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:id="@+id/tv_value_factor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tv_factor"
        app:layout_constraintEnd_toEndOf="@+id/tv_value_ratio"
        app:layout_constraintTop_toTopOf="@+id/tv_factor"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_cum_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="@string/text_corp_action_item_cum_date"
        app:layout_constraintStart_toStartOf="@+id/tv_factor"
        app:layout_constraintTop_toBottomOf="@+id/tv_factor"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:id="@+id/tv_value_cum_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tv_cum_date"
        app:layout_constraintEnd_toEndOf="@+id/tv_value_factor"
        app:layout_constraintTop_toTopOf="@+id/tv_cum_date"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_ex_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="@string/text_corp_action_item_ex_date"
        app:layout_constraintStart_toStartOf="@+id/tv_cum_date"
        app:layout_constraintTop_toBottomOf="@+id/tv_cum_date"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:id="@+id/tv_value_ex_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tv_ex_date"
        app:layout_constraintEnd_toEndOf="@+id/tv_value_cum_date"
        app:layout_constraintTop_toTopOf="@+id/tv_ex_date"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_rec_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="@string/text_corp_action_item_recording_date"
        app:layout_constraintStart_toStartOf="@+id/tv_ex_date"
        app:layout_constraintTop_toBottomOf="@+id/tv_ex_date"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:id="@+id/tv_value_rec_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tv_rec_date"
        app:layout_constraintEnd_toEndOf="@+id/tv_value_ex_date"
        app:layout_constraintTop_toTopOf="@+id/tv_rec_date"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_pay_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="@string/text_corp_action_item_payment_date"
        app:layout_constraintStart_toStartOf="@+id/tv_rec_date"
        app:layout_constraintTop_toBottomOf="@+id/tv_rec_date"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:id="@+id/tv_value_pay_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tv_pay_date"
        app:layout_constraintEnd_toEndOf="@+id/tv_value_rec_date"
        app:layout_constraintTop_toTopOf="@+id/tv_pay_date"
        style="@style/TypeStyles.BodyRegular"/>
    <View
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/spacing_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_pay_date"/>
</androidx.constraintlayout.widget.ConstraintLayout>
