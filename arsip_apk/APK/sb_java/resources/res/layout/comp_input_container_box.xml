<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <EditText
        android:textColorHint="?attr/themeColorTextTetriary"
        android:id="@+id/et_container_box_input"
        android:tag="layout/comp_input_container_box_0"
        android:background="@android:color/transparent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_container_box_counter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:textColor="?attr/themeColorTextTetriary"
        android:id="@+id/tv_container_box_counter"
        android:tag="layout/comp_input_container_box_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_container_delete_all_icon"
        app:layout_constraintStart_toEndOf="@+id/et_container_box_input"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyRegular"/>
    <ImageView
        android:id="@+id/iv_container_delete_all_icon"
        android:tag="layout/comp_input_container_box_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/uikit_ic_stockbit_search_bar_close_fill"
        android:layout_marginEnd="@dimen/spacing_14"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_container_box_placeholder"
        app:layout_constraintStart_toEndOf="@+id/tv_container_box_counter"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_container_box_placeholder"
        android:tag="layout/comp_input_container_box_3"
        android:visibility="gone"
        android:layout_width="@dimen/icon_placeholder_16"
        android:layout_height="@dimen/icon_placeholder_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_container_delete_all_icon"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>
