<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screener_screen_bottom_bar"
    android:tag="layout/comp_screener_screen_bottombar_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/spacing_20"
    app:behavior_hideable="true"
    app:behavior_peekHeight="@dimen/item_gap_null"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_screener_default_bottom_menu"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_screener_favorite"
            android:tag="binding_1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/spacing_8"
            android:layout_weight="1"
            style="@style/SbTextView.CaptionSecondary"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_screener_save"
            android:tag="binding_2"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/spacing_8"
            android:layout_weight="1"
            app:drawableTopCompat="@drawable/ic_save_new"
            style="@style/SbTextView.CaptionSecondary"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_screener_edit"
            android:tag="binding_3"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:text="@string/screener_screen_bottombar_edit"
            android:drawablePadding="@dimen/spacing_8"
            android:layout_weight="1"
            app:drawableTopCompat="@drawable/ic_edit_new"
            style="@style/SbTextView.CaptionSecondary"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_screener_add_metric"
            android:tag="binding_4"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:text="@string/screener_screen_bottombar_add_column"
            android:drawablePadding="@dimen/spacing_8"
            android:layout_weight="1"
            app:drawableTopCompat="@drawable/ic_add_metric"
            style="@style/SbTextView.CaptionSecondary"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_screener_add_to_watchlist"
            android:tag="binding_5"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:text="@string/screener_screen_bottombar_add_watchlist"
            android:drawablePadding="@dimen/spacing_8"
            android:layout_weight="1"
            app:drawableTopCompat="@drawable/ic_add_to_watchlist_screener"
            style="@style/SbTextView.CaptionSecondary"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_screener_add_watchlist_mode"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.stockbit.uikit.button.PrimaryButton
            android:id="@+id/btn_add_to_watchlist"
            android:tag="binding_6"
            android:layout_width="0dp"
            android:layout_height="@dimen/height_44"
            android:text="@string/screener_screen_bottombar_add_to_watchlist"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/spacing_20"/>
    </LinearLayout>
</RelativeLayout>
