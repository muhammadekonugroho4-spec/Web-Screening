<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_otp_expiration_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:src="?attr/themeIconLimitRetryOtp"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:textColor="?attr/themeColorTextPrimary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_expiration_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:textAlignment="gravity"
            android:layout_marginStart="@dimen/item_gap_32"
            android:layout_marginEnd="@dimen/item_gap_32"
            style="@style/TypeStyles.HeadingLarge"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_expiration_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginBottom="@dimen/spacing_12"
            android:textAlignment="gravity"
            android:layout_marginStart="@dimen/spacing_20"
            android:layout_marginEnd="@dimen/spacing_20"
            style="@style/TypeStyles.BodyRegular"/>
        <com.stockbit.uikit.button.PrimaryButton
            android:textColor="@color/white"
            android:id="@+id/btn_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_16"
            android:layout_marginBottom="@dimen/spacing_20"
            android:text="@string/button_return"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/spacing_20"
            android:layout_marginEnd="@dimen/spacing_20"
            style="@style/TypeStyles.HeadingRegular"/>
    </LinearLayout>
</RelativeLayout>
