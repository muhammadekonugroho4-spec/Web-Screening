<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/llRoot"
    android:tag="layout/item_company_corpaction_conversion_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/item_gap_18">
    <TextView
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/tvRecDate"
        android:layout_width="@dimen/conversion_rec_date_width"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:contentDescription="@string/CORP_ACT_19"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:ellipsize="end"
        android:gravity="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/tvConvNumber"
        android:layout_width="@dimen/width_80"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:contentDescription="@string/CORP_ACT_20"
        android:layout_marginStart="@dimen/conversion_conv_number_margin_start"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:ellipsize="end"
        android:gravity="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/tvRemainingConv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        android:contentDescription="@string/CORP_ACT_21"
        android:layout_marginStart="@dimen/conversion_gap"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:ellipsize="end"
        android:gravity="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/tvStockSumAfterConv"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        android:contentDescription="@string/CORP_ACT_22"
        android:layout_marginStart="@dimen/conversion_gap"
        style="@style/TypeStyles.BodyRegular"/>
</LinearLayout>
