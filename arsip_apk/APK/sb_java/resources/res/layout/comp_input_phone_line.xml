<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_phone_line_layout"
    android:tag="layout/comp_input_phone_line_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_phone_label"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingXSmall"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_phone_input_layout"
        android:background="@drawable/bg_default_bottom_line_edit_text"
        android:paddingBottom="@dimen/spacing_8"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_phone_label"
        app:layout_goneMarginTop="@dimen/spacing_0">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/tv_phone_country_selection"
            android:background="?attr/selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/spacing_8"
            android:textAlignment="gravity"
            app:drawableEndCompat="@drawable/ic_arrow_down"
            app:layout_constraintBottom_toBottomOf="@+id/tiet_phone_input"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tiet_phone_input"
            style="@style/TypeStyles.BodyRegular"/>
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/tiet_phone_input"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:layout_marginStart="@dimen/spacing_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_phone_clear_text"
            app:layout_constraintStart_toEndOf="@+id/tv_phone_country_selection"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Sb.Widget.TextInputEditText"/>
        <ImageView
            android:id="@+id/iv_phone_clear_text"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/uikit_ic_stockbit_search_bar_close_fill"
            app:layout_constraintBottom_toBottomOf="@+id/tiet_phone_input"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tiet_phone_input"
            app:layout_constraintTop_toTopOf="@+id/tiet_phone_input"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/iv_phone_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_input_error"
        app:layout_constraintBottom_toBottomOf="@+id/tv_phone_helper"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_phone_helper"/>
    <TextView
        android:id="@+id/tv_phone_helper"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:layout_marginStart="@dimen/spacing_8"
        android:layout_marginEnd="@dimen/spacing_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_phone_button"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_phone_error"
        app:layout_constraintTop_toBottomOf="@+id/cl_phone_input_layout"
        app:layout_goneMarginEnd="@dimen/spacing_0"
        app:layout_goneMarginStart="@dimen/spacing_0"
        app:layout_goneMarginTop="@dimen/spacing_8"
        style="@style/SbTextView.Helper.Default"/>
    <TextView
        android:textColor="?attr/themeColorTextGreen"
        android:id="@+id/tv_phone_button"
        android:background="?attr/selectableItemBackground"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_phone_input_layout"
        style="@style/TypeStyles.HeadingSmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
