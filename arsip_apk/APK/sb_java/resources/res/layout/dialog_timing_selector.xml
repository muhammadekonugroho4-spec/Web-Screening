<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/dialog_timing_selector_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_select_duration"
        android:layout_marginVertical="@dimen/spacing_8"
        style="@style/TypeStyles.HeadingLarge"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_period_selector"
        android:tag="binding_1"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_marginBottom="@dimen/icon_placeholder_32"
        android:layout_marginHorizontal="@dimen/spacing_20"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
</LinearLayout>
