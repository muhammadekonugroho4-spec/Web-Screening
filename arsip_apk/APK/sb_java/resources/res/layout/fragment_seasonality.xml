<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_seasonality_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ViewFlipper
        android:id="@+id/vf_seasonality"
        android:tag="binding_1"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/sfl_seasonality"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/skeleton_company_profile_item"/>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsv_main_layout"
            android:paddingBottom="@dimen/item_gap_40"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:background="?attr/themeColorSurfaceDefault"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <RelativeLayout
                    android:id="@+id/rl_selected_latest_year"
                    android:background="?attr/themeColorSurfaceDefault"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/clickable_size_48"
                    android:layout_marginTop="@dimen/item_gap_16"
                    android:foreground="?attr/selectableItemBackground">
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:gravity="start|center_vertical"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tv_selected_years"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/item_gap_20"
                        android:layout_marginEnd="@dimen/item_gap_16"
                        android:layout_toStartOf="@+id/iv_selected_years_arrow"
                        android:layout_alignParentStart="true"
                        style="@style/SbTextView.Title.Green"/>
                    <ImageView
                        android:id="@+id/iv_selected_years_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:rotation="90"
                        android:layout_marginEnd="@dimen/item_gap_20"
                        android:layout_alignParentEnd="true"
                        app:srcCompat="@drawable/ic_chevron_right_green"
                        app:tint="?attr/themeIconTintColor"/>
                </RelativeLayout>
                <View
                    android:id="@+id/view_divider"
                    android:background="?attr/themeSeparatorGapColorNew"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_gap_1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rl_selected_latest_year"/>
                <com.evrencoskun.tableview.TableView
                    android:id="@+id/table_view_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:row_header_width="@dimen/item_gap_95"
                    app:selected_color="@color/transparent"
                    app:show_horizontal_separator="false"
                    app:show_vertical_separator="false"
                    app:unselected_color="@color/transparent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_seasonality_chart"
                    android:paddingBottom="@dimen/item_gap_20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_30"
                    android:paddingHorizontal="@dimen/item_gap_20">
                    <ImageView
                        android:id="@+id/iv_seasonality_chart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="?attr/themeIconSeasonalityChart"/>
                    <TextView
                        android:textSize="@dimen/text_size_14"
                        android:textColor="?attr/titleTextColorHighempasis"
                        android:id="@+id/tv_seasonality_chart_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/title_seasonality_chart"
                        android:layout_marginStart="@dimen/item_gap_10"
                        android:lineHeight="17dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/iv_seasonality_chart"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/SbTextView.PageTitle"/>
                    <TextView
                        android:textSize="@dimen/text_size_12"
                        android:textColor="?attr/titleTextColorHighempasis"
                        android:id="@+id/tv_seasonality_chart_subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_6"
                        android:text="@string/text_seasonality_chart"
                        android:lineHeight="17dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/tv_seasonality_chart_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_seasonality_chart_title"
                        style="@style/SbTextView"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <RelativeLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="@dimen/item_gap_40">
            <TextView
                android:id="@+id/tv_seasonality_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/msg_loading_alert_company_info_error"
                android:layout_centerHorizontal="true"
                style="@style/SbTextView.BodyDefault"/>
            <Button
                android:id="@+id/btn_seasonality_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_10"
                android:text="@string/btn_click_to_refresh"
                android:layout_below="@+id/tv_seasonality_error"
                android:layout_centerHorizontal="true"
                style="@style/SbBtnBorderless.Small"/>
        </RelativeLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsv_empty_state"
            android:tag="binding_3"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include layout="@layout/comp_company_seasonality_empty"/>
        </androidx.core.widget.NestedScrollView>
    </ViewFlipper>
    <include
        android:id="@+id/lyt_paywall_seasonality"
        android:visibility="gone"
        layout="@layout/comp_seasonality_paywall"/>
</LinearLayout>
