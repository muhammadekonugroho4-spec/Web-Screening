<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_academy_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewFlipper
        android:id="@+id/vf_fragment_setting_academy"
        android:background="?attr/themeContentBackground"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/pb_fragment_setting_academy"
            android:layout_width="@dimen/clickable_size_32"
            android:layout_height="@dimen/clickable_size_32"
            android:indeterminate="true"
            android:indeterminateTint="@color/green_text"
            style="@style/Widget.AppCompat.ProgressBar"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.stockbit.academy.ui.academy.connection.AcademyWebView
                android:id="@+id/wv_stockbit_academy"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageButton
                android:layout_gravity="end"
                android:id="@+id/ib_fragment_chart_full_screen"
                android:background="@drawable/bg_circle_gray"
                android:visibility="gone"
                android:layout_width="@dimen/clickable_size_32"
                android:layout_height="@dimen/clickable_size_32"
                android:layout_marginTop="@dimen/item_gap_s"
                android:layout_marginRight="@dimen/item_gap_l"
                android:contentDescription="@string/hint_open_full_screen"
                app:srcCompat="@drawable/ic_fullscreen_black_24dp"
                app:tint="@color/highgray_light"/>
        </FrameLayout>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:id="@+id/parent_clickable_reload_academy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_reload_academy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/btn_tap_to_refresh"
                app:srcCompat="?attr/themeIconErrorAcademy"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:id="@+id/tv_error_cause_academy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_4"
                android:text="@string/desc_error_cause_academy_web_view"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:id="@+id/tv_error_try_again"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:text="@string/button_try_again"
                android:drawablePadding="@dimen/spacing_4"
                app:drawableStartCompat="@drawable/ic_try_again_two_arrows"
                style="@style/TypeStyles.HeadingSmall.Green"/>
        </LinearLayout>
    </ViewFlipper>
</androidx.constraintlayout.widget.ConstraintLayout>
