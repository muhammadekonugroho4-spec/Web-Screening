<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_dropdown_box_layout"
    android:tag="layout/comp_input_dropdown_box_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gl_dropdown_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="12dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_dropdown_input_layout"
        android:background="@drawable/bg_box_default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/tiet_dropdown_input"
            android:background="@null"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_dropdown_chevron"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Sb.Widget.TextInputEditText"/>
        <ImageView
            android:id="@+id/iv_dropdown_chevron"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_chevron_down_secondary"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/v_dropdown_label_background"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_dropdown_label"
        app:layout_constraintEnd_toEndOf="@+id/tv_dropdown_label"
        app:layout_constraintStart_toStartOf="@+id/tv_dropdown_label"
        app:layout_constraintTop_toTopOf="@+id/tv_dropdown_label"/>
    <TextView
        android:id="@+id/tv_dropdown_label"
        android:background="?attr/themeContentBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:paddingHorizontal="4dp"
        app:layout_constraintBottom_toTopOf="@+id/cl_dropdown_input_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cl_dropdown_input_layout"
        style="@style/TypeStyles.BodyXSmall"/>
    <ImageView
        android:id="@+id/iv_dropdown_error"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_input_error"
        app:layout_constraintStart_toStartOf="@+id/gl_dropdown_start"
        app:layout_constraintTop_toBottomOf="@+id/cl_dropdown_input_layout"/>
    <TextView
        android:id="@+id/tv_dropdown_error_text"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_dropdown_error"
        app:layout_constraintTop_toTopOf="@+id/iv_dropdown_error"
        app:layout_goneMarginStart="0dp"
        app:layout_goneMarginTop="8dp"
        style="@style/TypeStyles.BodyXSmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
