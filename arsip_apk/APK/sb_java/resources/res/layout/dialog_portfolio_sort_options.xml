<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_portfolio_sort_options_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="@dimen/spacing_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_20">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center_vertical"
            android:id="@+id/tv_header_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sort_portfolio_header"
            android:drawablePadding="@dimen/spacing_12"
            android:paddingVertical="@dimen/spacing_12"
            app:drawableLeftCompat="@drawable/portfolio_ic_sort_stock_16dp"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingRegular"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_sort_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/tv_header_title"/>
        <View
            android:id="@+id/sbd_odd_lot"
            android:background="?attr/themeColorModalsDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_1"
            android:layout_marginTop="@dimen/spacing_12"
            app:layout_constraintTop_toBottomOf="@+id/rv_sort_options"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_title_odd_lot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_10"
            android:text="@string/text_hide_odd_lot"
            android:drawablePadding="@dimen/spacing_12"
            android:paddingVertical="@dimen/spacing_8"
            app:drawableLeftCompat="@drawable/ic_odd_lot"
            app:layout_constraintEnd_toStartOf="@+id/ctw_odd_lot"
            app:layout_constraintStart_toStartOf="@+id/sbd_odd_lot"
            app:layout_constraintTop_toBottomOf="@+id/sbd_odd_lot"
            style="@style/TypeStyles.HeadingRegular"/>
        <com.stockbit.uikit.control.ControlToggleSwitch
            android:id="@+id/ctw_odd_lot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title_odd_lot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title_odd_lot"/>
        <View
            android:id="@+id/sbd_hide_balance_view"
            android:background="?attr/themeColorModalsDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_1"
            android:layout_marginTop="@dimen/spacing_12"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_odd_lot"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_title_hide_balance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_10"
            android:text="@string/portfolio_hide_balance"
            android:drawablePadding="@dimen/spacing_12"
            android:paddingVertical="@dimen/spacing_8"
            app:drawableLeftCompat="@drawable/ic_investment_hidden_semantic"
            app:layout_constraintEnd_toStartOf="@+id/ctw_hide_balance"
            app:layout_constraintStart_toStartOf="@+id/sbd_hide_balance_view"
            app:layout_constraintTop_toBottomOf="@+id/sbd_hide_balance_view"
            style="@style/TypeStyles.HeadingRegular"/>
        <com.stockbit.uikit.control.ControlToggleSwitch
            android:id="@+id/ctw_hide_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title_hide_balance"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title_hide_balance"/>
        <View
            android:id="@+id/sbd_complete_view"
            android:background="?attr/themeColorModalsDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_1"
            android:layout_marginTop="@dimen/spacing_12"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_hide_balance"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_title_complete_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_10"
            android:text="@string/text_complete_view"
            android:drawablePadding="@dimen/spacing_12"
            android:paddingVertical="@dimen/spacing_8"
            app:drawableLeftCompat="@drawable/ic_complete_view"
            app:layout_constraintEnd_toStartOf="@+id/ctw_complete_view"
            app:layout_constraintStart_toStartOf="@+id/sbd_complete_view"
            app:layout_constraintTop_toBottomOf="@+id/sbd_complete_view"
            style="@style/TypeStyles.HeadingRegular"/>
        <com.stockbit.uikit.control.ControlToggleSwitch
            android:id="@+id/ctw_complete_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title_complete_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title_complete_view"/>
        <com.stockbit.uikit.button.PrimaryButton
            android:id="@+id/btn_apply_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:text="@string/button_apply"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_complete_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
