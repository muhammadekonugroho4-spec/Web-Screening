<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/parent_header_clickable_reload"
    android:tag="layout/comp_stream_reload_0"
    android:visibility="gone"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_8"
    android:paddingHorizontal="@dimen/item_gap_l">
    <ImageView
        android:id="@+id/iv_header_refresh_icon"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_8"
        android:contentDescription="@string/btn_tap_to_refresh"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_8"
        style="@style/TypeStyles.BodySmall"/>
    <TextView
        android:textColor="@color/white"
        android:id="@+id/tv_header_error_cause"
        android:tag="binding_3"
        android:background="@drawable/btn_empty_green_bg_rounded"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:layout_marginBottom="@dimen/item_gap_80"
        android:foreground="?attr/selectableItemBackground"
        android:text="@string/btn_tap_to_retry"
        android:paddingHorizontal="@dimen/spacing_16"
        android:paddingVertical="@dimen/item_gap_s"
        style="@style/TypeStyles.HeadingRegular"/>
</LinearLayout>
