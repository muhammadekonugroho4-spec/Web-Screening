<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent_stream_general_image"
    android:tag="layout/comp_stream_content_image_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="@dimen/item_gap_null"
    app:cardElevation="@dimen/item_gap_null">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/parent_stream_general_image_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/rv_stream_images"
            android:tag="binding_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.stockbit.common.uikit.TextIndicator
            android:id="@+id/ti_stream"
            android:background="@drawable/bg_text_indicator"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:alpha="0.8"
            android:layout_marginEnd="@dimen/spacing_8"
            android:paddingHorizontal="@dimen/spacing_8"
            android:paddingVertical="@dimen/spacing_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/rv_stream_images"
            style="@style/TypeStyles.BodyXSmall"/>
        <ru.tinkoff.scrollingpagerindicator.ScrollingPagerIndicator
            android:layout_gravity="center_horizontal"
            android:id="@+id/dot_indicator_stream"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rv_stream_images"
            app:spi_dotColor="?attr/themeColorModalsBorder"
            app:spi_dotSelectedColor="@color/green_text"
            app:spi_dotSelectedSize="@dimen/clickable_size_4"
            app:spi_dotSize="@dimen/clickable_size_4"
            app:spi_dotSpacing="@dimen/item_gap_6"
            app:spi_visibleDotCount="5"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
