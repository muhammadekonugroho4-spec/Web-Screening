<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_submit_question_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:tag="binding_1"
        android:background="@drawable/bg_top_rounded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/v_header"
            android:background="@drawable/bg_rounded_gray"
            android:layout_width="@dimen/clickable_size_64"
            android:layout_height="@dimen/item_gap_4"
            android:layout_marginTop="@dimen/item_gap_16"
            android:alpha="0.6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_dialog_question_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_16"
            android:text="@string/livestream_title_question"
            android:layout_marginHorizontal="@dimen/clickable_size_48"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_header"
            style="@style/SbTextView.ListTitle"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/il_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_24"
            android:layout_marginHorizontal="@dimen/item_gap_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_dialog_question_title"
            style="@style/Sb.Widget.InputText.Outlined">
            <com.google.android.material.textfield.TextInputEditText
                android:textColor="?attr/themeContentTextColor"
                android:gravity="top"
                android:id="@+id/et_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="142dp"
                android:hint="@string/placeholder_live_question"/>
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:textColor="@color/highgray_light"
            android:layout_gravity="end"
            android:id="@+id/tv_limitation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_4"
            android:layout_marginBottom="@dimen/item_gap_12"
            android:text="@string/livestream_default_text_remaining"
            android:layout_marginEnd="@dimen/item_gap_20"
            app:layout_constraintBottom_toTopOf="@+id/btn_submit_question"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/il_question"
            style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
        <Button
            android:id="@+id/btn_submit_question"
            android:tag="binding_2"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/item_gap_32"
            android:text="@string/button_submit_question"
            android:layout_marginHorizontal="@dimen/item_gap_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/SbBtn.PrimaryFullWidthFloating"/>
        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/pb_question"
            android:tag="binding_3"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:indeterminate="true"
            android:layout_marginVertical="@dimen/width_92"
            app:indicatorColor="@color/green_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_header"
            app:trackColor="?attr/themeSeparatorGapColorSecondary"/>
        <include
            android:id="@+id/layout_question_error"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:layout_marginBottom="@dimen/item_gap_32"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_header"
            layout="@layout/comp_livestream_question_error"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_main_question"
            android:tag="binding_4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="btn_submit_question, tv_limitation, il_question, tv_dialog_question_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
