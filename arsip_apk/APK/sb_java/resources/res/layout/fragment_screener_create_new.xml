<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_screener_create_new_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="@dimen/item_gap_null"
        style="@style/Sb.Widget.AppBar">
        <include
            android:id="@+id/generic_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="snap"
            layout="@layout/comment_toolbar"/>
        <com.stockbit.uikit.divider.SBDivider
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_1"
            app:dividerVariant="thin_grey"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <RelativeLayout
            android:id="@+id/rl_main_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:gravity="center"
                android:id="@+id/rl_loading_layout"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ProgressBar
                    android:id="@+id/pb_screener"
                    android:layout_width="@dimen/clickable_size_32"
                    android:layout_height="@dimen/clickable_size_32"
                    android:layout_centerHorizontal="true"
                    style="@style/Widget.AppCompat.ProgressBar"/>
                <TextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_m"
                    android:text="@string/lbl_loading_chat_list"
                    android:layout_below="@+id/pb_screener"
                    android:layout_centerHorizontal="true"
                    style="@style/TypeStyles.BodyRegular"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_content"
                android:tag="binding_3"
                android:paddingTop="@dimen/spacing_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_loading_layout"
                android:paddingHorizontal="@dimen/item_gap_20">
                <TextView
                    android:id="@+id/tv_screener_name_title"
                    android:paddingBottom="@dimen/item_gap_xs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/title_screener_name"
                    style="@style/TypeStyles.HeadingSmall"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_screener_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_screener_name_title"
                    app:errorEnabled="false"
                    app:hintEnabled="false">
                    <com.google.android.material.textfield.TextInputEditText
                        android:theme="@style/Sb.Widget.InputText"
                        android:ellipsize="end"
                        android:id="@+id/et_screener_name"
                        android:paddingBottom="@dimen/item_gap_20"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/clickable_size_40"
                        android:hint="@string/hint_screener_enter_screener_name"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:maxLength="@integer/screener_name_length_limit"
                        android:digits="!&quot;#$%&amp;&apos;()*+,-./0123456789:;&lt;=&gt;?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~ "
                        android:imeOptions="actionDone"
                        android:nextFocusForward="@+id/rl_stock_universe"
                        style="@style/SbEditTextStyle"/>
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:id="@+id/tv_stock_universe_title"
                    android:paddingBottom="@dimen/item_gap_m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_40"
                    android:text="@string/title_screener_create_new_stock_universe_title"
                    android:layout_below="@+id/til_screener_name"
                    style="@style/TypeStyles.HeadingSmall"/>
                <RelativeLayout
                    android:id="@+id/rl_stock_universe"
                    android:background="@drawable/bg_selector_border_gray_rounded_outline"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/clickable_size_40"
                    android:layout_below="@+id/tv_stock_universe_title">
                    <TextView
                        android:gravity="center_vertical"
                        android:id="@+id/tv_stock_universe"
                        android:tag="binding_4"
                        android:paddingLeft="@dimen/item_gap_l"
                        android:paddingRight="@dimen/item_gap_l"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        style="@style/TypeStyles.HeadingLarge"/>
                    <ImageView
                        android:id="@+id/iv_stock_universe"
                        android:layout_width="@dimen/clickable_size_24"
                        android:layout_height="@dimen/clickable_size_24"
                        android:layout_marginRight="@dimen/item_gap_m"
                        android:scaleType="centerInside"
                        android:layout_alignParentRight="true"
                        android:layout_centerVertical="true"
                        android:rotation="180"
                        app:srcCompat="@drawable/back_toolbar"
                        app:tint="@color/highgray_light"/>
                </RelativeLayout>
                <TextView
                    android:id="@+id/tv_screener_rules_title"
                    android:paddingBottom="@dimen/item_gap_m"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_40"
                    android:text="@string/title_screener_create_new_rules_title"
                    android:layout_below="@+id/rl_stock_universe"
                    style="@style/TypeStyles.HeadingSmall"/>
                <RelativeLayout
                    android:id="@+id/rl_screener_rules"
                    android:background="@drawable/bg_selector_border_gray_rounded_outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tv_screener_rules_title">
                    <ImageView
                        android:id="@+id/iv_create_new_rules"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toLeftOf="@+id/tv_screener_rules"
                        android:layout_centerVertical="true"
                        app:srcCompat="@drawable/ic_android_plus_bold"
                        app:tint="?attr/themeIconTintColor"/>
                    <TextView
                        android:gravity="center"
                        android:id="@+id/tv_screener_rules"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/title_screener_create_new_add_rules_title"
                        android:layout_centerInParent="true"
                        android:textAlignment="gravity"
                        android:layout_marginStart="@dimen/item_gap_5"
                        android:paddingVertical="@dimen/item_gap_14"
                        style="@style/TypeStyles.HeadingLarge"/>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/rl_rules_container"
                    android:tag="binding_5"
                    android:background="@drawable/bg_selector_border_gray_rounded_outline"
                    android:paddingTop="@dimen/item_gap_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_l"
                    android:layout_marginBottom="@dimen/item_gap_m"
                    android:layout_below="@+id/rl_screener_rules"
                    android:paddingHorizontal="@dimen/item_gap_1">
                    <androidx.recyclerview.widget.RecyclerView
                        android:orientation="vertical"
                        android:id="@+id/rv_rules_screener"
                        android:tag="binding_6"
                        android:clipToPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                </RelativeLayout>
                <Button
                    android:id="@+id/btn_done"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/height_46"
                    android:layout_marginTop="@dimen/item_gap_20"
                    android:text="@string/title_screener_create_new_btn_title"
                    android:layout_below="@+id/rl_rules_container"
                    style="@style/SbBtn.PrimaryFullWidthFloating"/>
            </RelativeLayout>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
