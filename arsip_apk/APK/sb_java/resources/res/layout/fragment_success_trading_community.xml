<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_success_trading_community_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/sv_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/btn_share_trading_community"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="binding_1"
            android:paddingTop="@dimen/item_gap_72"
            android:paddingBottom="@dimen/item_gap_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_20">
            <TextView
                android:gravity="center"
                android:id="@+id/tv_trading_community_success_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_success_community"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                style="@style/TypeStyles.NominalLarge"/>
            <ImageView
                android:id="@+id/iv_success_input_code"
                android:layout_width="@dimen/community_input_code_image_width"
                android:layout_height="@dimen/community_input_code_image_height"
                android:layout_marginTop="@dimen/spacing_40"
                android:src="?attr/themeIconTradingCommunityInputCodeSuccess"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_trading_community_success_title"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_success_trading_community_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_40"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_success_input_code"
                style="@style/TypeStyles.BodyRegular"/>
            <include
                android:id="@+id/comp_community_success_info"
                android:layout_width="@dimen/spacing_0"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_40"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_success_trading_community_desc"
                layout="@layout/comp_community_success_info"/>
            <TextView
                android:id="@+id/tv_community_success_share"
                android:background="@drawable/bg_info_periwinkle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                android:text="@string/desc_community_success_share"
                android:drawablePadding="@dimen/spacing_8"
                android:paddingHorizontal="@dimen/spacing_16"
                android:paddingVertical="@dimen/spacing_12"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="?attr/themeColorPeriwinkleDefault"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/comp_community_success_info"
                style="@style/TypeStyles.BodyXSmall"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <com.stockbit.uikit.button.SecondaryButton
        android:id="@+id/btn_share_trading_community"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_20"
        android:text="@string/btn_share_activation"
        android:layout_marginStart="@dimen/item_gap_20"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:layout_constraintBottom_toTopOf="@+id/btn_done_trading_community"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/btn_done_trading_community"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_40"
        android:text="@string/button_done"
        android:layout_marginStart="@dimen/item_gap_20"
        android:layout_marginEnd="@dimen/item_gap_20"
        android:layout_toEndOf="@+id/btn_share_trading_community"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
