<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_bar"
    android:tag="layout/toolbar_register_trading_0"
    android:background="?attr/themeContentBackground"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    app:elevation="@dimen/item_gap_null">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_register_trading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:elevation="@dimen/item_gap_null">
        <TextView
            android:ellipsize="middle"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_open_trading_account"
            android:singleLine="true"
            android:layout_centerHorizontal="true"
            style="@style/SbTextView.PageTitle"/>
    </androidx.appcompat.widget.Toolbar>
</com.google.android.material.appbar.AppBarLayout>
