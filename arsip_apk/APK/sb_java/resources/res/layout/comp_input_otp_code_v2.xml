<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_input_otp_code_v2_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.poovam.pinedittextfield.LinePinField
        android:textStyle="bold"
        android:textColor="?attr/themeColorTextPrimary"
        android:id="@+id/lpf_otp"
        android:background="?attr/themeContentBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3sp"
        android:lineSpacingMultiplier="1.25"
        android:inputType="number"
        android:translationY="-1.38sp"
        app:bottomTextPaddingDp="6dp"
        app:distanceInBetween="@dimen/spacing_12"
        app:fieldColor="?attr/themeColorBorder"
        app:highlightColor="?attr/themeColorBorderGreen"
        app:highlightType="completedFields"
        app:isCursorEnabled="true"
        app:isCustomBackground="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lineThickness="@dimen/uikit_divider_thin"
        app:noOfFields="6"
        style="@style/TypeStyles.NominalLarge"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?attr/themeColorTextRed"
        android:gravity="center"
        android:id="@+id/tv_message_error"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_24"
        android:lineSpacingExtra="2sp"
        android:lineHeight="18sp"
        app:layout_constraintEnd_toEndOf="@+id/lpf_otp"
        app:layout_constraintStart_toStartOf="@+id/lpf_otp"
        app:layout_constraintTop_toBottomOf="@+id/lpf_otp"
        style="@style/TypeStyles.BodyXSmall"/>
    <TextView
        android:id="@+id/tv_resend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:lineSpacingExtra="2sp"
        android:translationY="-0.97sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_message_error"
        app:layout_goneMarginTop="44dp"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:textColor="#00ab6b"
        android:id="@+id/tv_try_another_way"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:text="@string/try_another_way"
        android:lineSpacingExtra="2sp"
        android:translationY="-0.97sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_resend"
        style="@style/TypeStyles.HeadingRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
