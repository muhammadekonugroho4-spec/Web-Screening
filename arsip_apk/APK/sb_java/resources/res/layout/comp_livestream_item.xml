<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_youtube_preview"
    android:tag="layout/comp_livestream_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_livestream_detail_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_16"
        app:cardCornerRadius="@dimen/shape_radius_6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_banner_live"
            android:tag="binding_1"
            android:background="@drawable/bg_purple_blue_gradient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/tv_event_title"
                android:tag="binding_2"
                android:padding="@dimen/spacing_16"
                android:layout_width="@dimen/spacing_0"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toStartOf="@+id/iv_play_livestream_banner"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/SbTextView.ListTitle"/>
            <ImageView
                android:id="@+id/iv_play_livestream_banner"
                android:tag="binding_3"
                android:paddingTop="@dimen/spacing_16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/livestream_banner_event"
                android:paddingEnd="@dimen/spacing_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_menu_livestream"
        android:background="@drawable/border_gray_rounded_transparent_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cv_livestream_detail_banner">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_68">
            <ImageView
                android:id="@+id/iv_date_livestream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="?attr/themeIconDate"
                android:contentDescription="@string/livestream_date"
                android:layout_marginStart="@dimen/spacing_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_date_livestream"
                android:tag="binding_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_18"
                android:layout_marginStart="@dimen/spacing_12"
                app:layout_constraintStart_toEndOf="@+id/iv_date_livestream"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.HeadingSmall"/>
            <TextView
                android:textSize="@dimen/text_size_11"
                android:id="@+id/tv_time_livestream"
                android:tag="binding_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_12"
                app:layout_constraintStart_toEndOf="@+id/iv_date_livestream"
                app:layout_constraintTop_toBottomOf="@+id/tv_date_livestream"
                style="@style/TypeStyles.BodyXSmall.Secondary"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.stockbit.uikit.divider.SBDivider
            android:tag="binding_6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_marginEnd="@dimen/spacing_16"
            app:dividerVariant="thin_grey"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="binding_7"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_68">
            <ImageView
                android:id="@+id/iv_reminder_livestream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="?attr/themeIconReminder"
                android:contentDescription="@string/livestream_date"
                android:layout_marginStart="@dimen/spacing_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_reminder_livestream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_18"
                android:text="@string/button_live_reminder"
                android:layout_marginStart="@dimen/spacing_12"
                app:layout_constraintStart_toEndOf="@+id/iv_reminder_livestream"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.HeadingSmall"/>
            <TextView
                android:textSize="@dimen/text_size_11"
                android:id="@+id/tv_notif_livestream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_live_reminder"
                android:layout_marginStart="@dimen/spacing_12"
                app:layout_constraintStart_toEndOf="@+id/iv_reminder_livestream"
                app:layout_constraintTop_toBottomOf="@+id/tv_reminder_livestream"
                style="@style/TypeStyles.BodyXSmall.Secondary"/>
            <Switch
                android:id="@+id/sm_reminder"
                android:tag="binding_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/ic_thumb_switch"
                android:track="?attr/themeIconTrackSwitch"
                android:layout_marginEnd="@dimen/spacing_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.stockbit.uikit.divider.SBDivider
            android:tag="binding_9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_marginEnd="@dimen/spacing_16"
            app:dividerVariant="thin_grey"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="binding_10"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_68"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/iv_livestream_question"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="?attr/themeIconQuestion"
                android:contentDescription="@string/livestream_date"
                android:layout_marginStart="@dimen/spacing_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_livestream_question"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_18"
                android:text="@string/button_live_question"
                android:layout_marginStart="@dimen/spacing_12"
                app:layout_constraintStart_toEndOf="@+id/iv_livestream_question"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.HeadingSmall"/>
            <TextView
                android:textSize="@dimen/text_size_11"
                android:id="@+id/tv_desc_question"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/text_live_question"
                android:layout_marginStart="@dimen/spacing_12"
                app:layout_constraintStart_toEndOf="@+id/iv_livestream_question"
                app:layout_constraintTop_toBottomOf="@+id/tv_livestream_question"
                style="@style/TypeStyles.BodyXSmall.Secondary"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_arrow_gray"
                android:contentDescription="@string/livestream_arrow"
                android:layout_marginEnd="@dimen/spacing_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.stockbit.uikit.divider.SBDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_marginEnd="@dimen/spacing_16"
            app:dividerVariant="thin_grey"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="binding_11"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_68"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:id="@+id/iv_livestream_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="?attr/themeIconShare"
                android:contentDescription="@string/livestream_date"
                android:layout_marginStart="@dimen/spacing_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:id="@+id/tv_livestream_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/buton_live_share"
                android:layout_marginStart="@dimen/spacing_12"
                android:layout_marginVertical="@dimen/spacing_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_livestream_share"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.HeadingSmall"/>
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_arrow_gray"
                android:contentDescription="@string/livestream_arrow"
                android:layout_marginEnd="@dimen/spacing_20"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/border_gray_rounded_transparent_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_menu_livestream">
        <ImageView
            android:id="@+id/iv_host_icon"
            android:tag="binding_12"
            android:layout_width="@dimen/avatar_size_s"
            android:layout_height="@dimen/avatar_size_s"
            android:contentDescription="@string/livestream_avatar"
            android:layout_marginStart="@dimen/spacing_16"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tv_host_name"
            android:tag="binding_13"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_16"
            android:layout_marginEnd="@dimen/spacing_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@+id/iv_host_icon"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingSmall"/>
        <TextView
            android:textSize="@dimen/text_size_11"
            android:id="@+id/tv_host_badge"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:text="@string/livestream_host"
            app:layout_constraintStart_toStartOf="@+id/tv_host_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_host_name"
            style="@style/TypeStyles.BodyXSmall.Secondary"/>
        <TextView
            android:id="@+id/tv_livestream_description"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginStart="@dimen/item_gap_64"
            android:layout_marginEnd="@dimen/spacing_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_host_badge"
            style="@style/TypeStyles.BodySmall"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
