<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ml_contrainer"
    android:tag="layout/fragment_choose_admin_0"
    android:background="?attr/themeContentBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_title"
        android:background="?attr/themeContentBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/gl_toolbar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_icon_toolbar_search"
            android:tag="binding_1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/item_gap_8"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/back_toolbar"
            android:layout_marginStart="@dimen/item_gap_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_choose_new_admin"
            app:layout_constraintBottom_toBottomOf="@+id/iv_icon_toolbar_search"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_icon_toolbar_search"
            style="@style/TypeStyles.HeadingLarge"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/gl_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="50dp"/>
    <com.stockbit.common.uikit.StockbitSearchBar
        android:id="@+id/ssb_search"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="67dp"
        android:layout_marginStart="@dimen/item_gap_16"
        android:layout_marginEnd="@dimen/item_gap_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gl_toolbar"
        app:stockbitSearchBarHint="@string/hint_search"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_group_member"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/item_gap_8"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/fl_button_choose"
        app:layout_constraintTop_toBottomOf="@+id/ssb_search"/>
    <FrameLayout
        android:id="@+id/fl_button_choose"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_group_member">
        <Button
            android:textColor="@color/color_text_button"
            android:layout_gravity="center"
            android:id="@+id/sb_choose_admin"
            android:tag="binding_3"
            android:background="@drawable/bg_semantic_error_4"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/btn_setadmin_and_leavegroup"
            android:textAllCaps="false"
            android:fontFamily="@font/bitsans_bold"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
