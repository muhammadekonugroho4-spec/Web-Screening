<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_setting_privacy_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/settingPrivacyToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:layout_scrollFlags="enterAlways|scroll">
        <TextView
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_privacy"
            style="@style/TypeStyles.HeadingLarge"/>
    </androidx.appcompat.widget.Toolbar>
    <RelativeLayout
        android:tag="binding_1"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_50">
        <TextView
            android:id="@+id/tvPrivacyBlockedUsersSett"
            android:paddingLeft="@dimen/item_gap_s"
            android:paddingRight="@dimen/item_gap_m"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_privacy_blocked_user"
            android:layout_toLeftOf="@+id/ivSettingPrivacyBlockedUsersNextIcon"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/item_gap_20"
            style="@style/TypeStyles.BodyLarge"/>
        <ImageView
            android:id="@+id/ivSettingPrivacyBlockedUsersNextIcon"
            android:padding="@dimen/item_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_panah_set"/>
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:tag="binding_2"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_50">
        <TextView
            android:paddingLeft="@dimen/item_gap_s"
            android:paddingRight="@dimen/item_gap_m"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_privacy_access_contact"
            android:layout_toLeftOf="@+id/ivSettingPrivacyDiscoverableByContactIcon"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/item_gap_20"
            style="@style/TypeStyles.BodyLarge"/>
        <ImageView
            android:id="@+id/ivSettingPrivacyDiscoverableByContactIcon"
            android:padding="@dimen/item_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_panah_set"/>
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:tag="binding_3"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_50">
        <TextView
            android:paddingLeft="@dimen/item_gap_s"
            android:paddingRight="@dimen/item_gap_m"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_privacy_chat_privacy"
            android:layout_toLeftOf="@+id/iv_setting_privacy_groupsIcon"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/item_gap_20"
            style="@style/TypeStyles.BodyLarge"/>
        <ImageView
            android:id="@+id/iv_setting_privacy_groupsIcon"
            android:padding="@dimen/item_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_panah_set"/>
        <View
            android:background="?attr/themeSeparatorGapColor"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_share_trade"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_50">
        <TextView
            android:id="@+id/tv_share_trade_title"
            android:paddingLeft="@dimen/item_gap_s"
            android:paddingRight="@dimen/spacing_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_privacy_share_trade"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/item_gap_20"
            style="@style/TypeStyles.BodyLarge"/>
        <ImageView
            android:id="@+id/iv_setting_privacy_share_trade"
            android:padding="@dimen/item_gap_m"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            app:srcCompat="@drawable/ic_panah_set"/>
        <View
            android:background="?attr/themeSeparatorGapColor"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</LinearLayout>
