<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/viewStreamItemSkeletonAvatar"
        android:background="@drawable/ic_circle_grey"
        android:layout_width="@dimen/avatar_size_default"
        android:layout_height="@dimen/avatar_size_default"
        android:layout_marginTop="@dimen/item_gap_m"
        android:layout_marginBottom="@dimen/item_gap_m"
        android:scaleType="centerCrop"
        android:layout_marginStart="@dimen/item_gap_l"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/viewStreamItemSkeletonUsername"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="120dp"
        android:layout_height="@dimen/item_gap_l"
        android:layout_below="@+id/viewStreamItemSkeletonAvatar"
        android:layout_marginStart="@dimen/item_gap_l"
        android:layout_toEndOf="@+id/viewStreamItemSkeletonAvatar"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintBottom_toBottomOf="@+id/viewStreamItemSkeletonAvatar"
        app:layout_constraintLeft_toRightOf="@+id/viewStreamItemSkeletonAvatar"
        app:layout_constraintTop_toTopOf="@+id/viewStreamItemSkeletonAvatar"/>
    <View
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="68dp"
        android:layout_height="32dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
