<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_item_news"
    android:tag="layout/comp_stream_content_news_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_news_title"
        android:tag="binding_1"
        android:paddingBottom="@dimen/spacing_6"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:maxLines="3"
        android:layout_marginEnd="@dimen/spacing_16"
        app:layout_constraintEnd_toStartOf="@+id/mcv_news"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingLarge"/>
    <ImageView
        android:id="@+id/iv_news_icon"
        android:tag="binding_2"
        android:layout_width="@dimen/spacing_12"
        android:layout_height="@dimen/spacing_12"
        android:layout_marginTop="@dimen/spacing_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_news_title"
        app:layout_constraintVertical_bias="0"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:ellipsize="end"
        android:id="@+id/tv_news_label"
        android:tag="binding_3"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/spacing_4"
        android:layout_marginEnd="@dimen/spacing_16"
        app:layout_constraintEnd_toStartOf="@+id/mcv_news"
        app:layout_constraintStart_toEndOf="@+id/iv_news_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_news_title"
        style="@style/TypeStyles.BodyXSmall"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mcv_news"
        android:tag="binding_4"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="@dimen/clickable_size_75"
        app:cardCornerRadius="@dimen/radius_4"
        app:cardElevation="@dimen/spacing_0"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="w,4:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_news_image"
            android:tag="binding_5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
