<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/item_stream_company_note_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="?attr/themeColorSurfaceDefault"
        android:paddingBottom="@dimen/spacing_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_company_logo"
            android:layout_width="@dimen/avatar_size_default"
            android:layout_height="@dimen/avatar_size_default"
            android:layout_marginTop="@dimen/spacing_20"
            android:layout_marginStart="@dimen/spacing_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tv_company_symbol"
            android:background="?android:attr/selectableItemBackground"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_8"
            app:layout_constraintBottom_toTopOf="@+id/tv_edited_date_time"
            app:layout_constraintEnd_toStartOf="@+id/ib_more"
            app:layout_constraintStart_toEndOf="@+id/iv_company_logo"
            app:layout_constraintTop_toTopOf="@+id/iv_company_logo"
            app:layout_constraintVertical_chainStyle="spread"
            style="@style/TypeStyles.HeadingLarge"/>
        <TextView
            android:id="@+id/tv_edited_date_time"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_company_logo"
            app:layout_constraintEnd_toStartOf="@+id/ib_more"
            app:layout_constraintStart_toEndOf="@+id/iv_company_logo"
            app:layout_constraintStart_toStartOf="@+id/tv_company_symbol"
            app:layout_constraintTop_toBottomOf="@+id/tv_company_symbol"
            style="@style/TypeStyles.BodyXXSmall"/>
        <ImageButton
            android:id="@+id/ib_more"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/width_48"
            android:layout_height="@dimen/height_24"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintBottom_toBottomOf="@+id/iv_company_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_company_logo"
            app:srcCompat="@drawable/ic_more_horizontal"
            app:tint="?attr/themeColorIconDefault"/>
        <TextView
            android:id="@+id/tv_note_content"
            android:paddingTop="@dimen/spacing_8"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            app:layout_constraintEnd_toEndOf="@+id/ib_more"
            app:layout_constraintStart_toStartOf="@+id/iv_company_logo"
            app:layout_constraintTop_toBottomOf="@+id/tv_edited_date_time"
            style="@style/TypeStyles.ParagraphRegular"/>
        <TextView
            android:textColor="?attr/themeColorTextGreen"
            android:id="@+id/tv_note_read_more"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/button_read_more"
            app:layout_constraintEnd_toEndOf="@+id/ib_more"
            app:layout_constraintStart_toStartOf="@+id/iv_company_logo"
            app:layout_constraintTop_toBottomOf="@+id/tv_note_content"
            style="@style/TypeStyles.HeadingRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/separator"
        android:background="?attr/themeColorDividerThick"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_8"/>
</LinearLayout>
