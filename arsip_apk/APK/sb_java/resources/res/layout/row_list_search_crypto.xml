<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentRowHotlistRoot"
    android:tag="layout/row_list_search_crypto_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/height_65"
    android:foreground="?attr/selectableItemBackground">
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="@color/gray_text"
        android:id="@+id/tvRowHotlistItemPosition"
        android:visibility="gone"
        android:layout_width="@dimen/item_gap_m"
        android:layout_height="@dimen/item_gap_l"
        android:layout_marginLeft="@dimen/item_gap_l"
        app:autoSizeMaxTextSize="@dimen/text_body"
        app:autoSizeMinTextSize="@dimen/text_badge"
        app:autoSizeTextType="uniform"
        app:layout_constraintBaseline_toBaselineOf="@+id/rlCompanySymbol"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SbTextView.BodyDefault.Bold"/>
    <ImageView
        android:id="@+id/iv_crypto_company_logo"
        android:layout_width="@dimen/icon_placeholder_32"
        android:layout_height="@dimen/icon_placeholder_32"
        android:layout_marginStart="@dimen/spacing_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/rlCompanySymbol"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/item_gap_8"
        app:layout_constraintBottom_toBottomOf="@+id/iv_crypto_company_logo"
        app:layout_constraintLeft_toRightOf="@+id/iv_crypto_company_logo"
        app:layout_constraintRight_toLeftOf="@+id/cvRowWatchlistPrice"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_crypto_company_logo"
        app:layout_goneMarginLeft="@dimen/item_gap_l">
        <RelativeLayout
            android:id="@+id/rlCompanySymbolData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="left"
                android:id="@+id/symbolCompany"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_centerVertical="true"
                style="@style/TypeStyles.HeadingLarge"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/ivNotationCompanyImage"
                android:visibility="gone"
                android:layout_width="@dimen/avatar_size_11.5"
                android:layout_height="wrap_content"
                android:scaleType="fitXY"
                android:layout_toRightOf="@+id/symbolCompany"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/item_gap_s"
                app:srcCompat="@drawable/ic_notasi_khusus"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_corporate_action"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/ivNotationCompanyImage"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/item_gap_s"
                android:layout_marginEnd="@dimen/item_gap_s"
                app:srcCompat="@drawable/ic_corporate_action"/>
        </RelativeLayout>
        <TextView
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/nameCompany"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_1"
            android:singleLine="true"
            android:layout_below="@+id/rlCompanySymbolData"
            android:layout_marginEnd="@dimen/spacing_4"
            style="@style/TypeStyles.BodyXSmall.Tertiary"/>
    </RelativeLayout>
    <androidx.cardview.widget.CardView
        android:gravity="end"
        android:id="@+id/cvRowWatchlistPrice"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/item_gap_m"
        android:minWidth="@dimen/width_104"
        android:minHeight="@dimen/clickable_size_48"
        app:cardBackgroundColor="?attr/themeColorSurfaceDefault"
        app:cardCornerRadius="@dimen/shape_radius_s"
        app:cardElevation="@dimen/item_gap_null"
        app:layout_constraintBottom_toBottomOf="@+id/rlCompanySymbol"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rlCompanySymbol">
        <LinearLayout
            android:gravity="end"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/ll_watchListBackgound"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="@dimen/width_104"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true">
            <TextView
                android:gravity="end"
                android:id="@+id/last_value"
                android:paddingLeft="@dimen/item_gap_s"
                android:paddingRight="@dimen/item_gap_s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="gravity"
                style="@style/TypeStyles.HeadingLarge"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:gravity="end"
                android:id="@+id/percentage"
                android:paddingLeft="@dimen/item_gap_s"
                android:paddingRight="@dimen/item_gap_s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="gravity"
                style="@style/TypeStyles.BodyRegular"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <View
        android:id="@+id/viewRowHotlistBorder"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_m"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupRowHotlistContent"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="rlCompanySymbol,cvRowWatchlistPrice"/>
</androidx.constraintlayout.widget.ConstraintLayout>
