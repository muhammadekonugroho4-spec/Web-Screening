<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_group_member_remaining_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/item_gap_10">
    <ImageView
        android:id="@+id/iv_remaining_members"
        android:background="@drawable/bg_circle_border_modal"
        android:layout_width="@dimen/item_gap_50"
        android:layout_height="@dimen/item_gap_50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_remaining_members"
        app:layout_constraintEnd_toEndOf="@+id/iv_remaining_members"
        app:layout_constraintStart_toStartOf="@+id/iv_remaining_members"
        app:layout_constraintTop_toTopOf="@+id/iv_remaining_members"
        style="@style/TypeStyles.BodyRegular.Tertiary"/>
    <TextView
        android:ellipsize="end"
        android:gravity="center"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_6"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/iv_remaining_members"
        app:layout_constraintStart_toStartOf="@+id/iv_remaining_members"
        app:layout_constraintTop_toBottomOf="@+id/iv_remaining_members"
        style="@style/TypeStyles.BodyXSmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
