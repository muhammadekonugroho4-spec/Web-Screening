<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_parent"
    android:tag="layout/item_stream_notification_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:minHeight="@dimen/clickable_size_64">
    <View
        android:id="@+id/v_unread_indicator"
        android:background="?attr/themeColorDividerThin"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/item_gap_xxxs"
        app:layout_constraintBottom_toBottomOf="@+id/v_separator"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/fl_avatar_container"
        android:layout_width="@dimen/avatar_size_36"
        android:layout_height="@dimen/avatar_size_36"
        android:layout_marginTop="@dimen/item_gap_12"
        android:layout_marginStart="@dimen/item_gap_20"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/aciv_avatar"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/bg_circle_gray"
            android:contentDescription="@string/user_profile_photo"/>
    </FrameLayout>
    <TextView
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/fl_avatar_container"
        app:layout_constraintTop_toTopOf="@+id/fl_avatar_container"
        app:layout_constraintVertical_chainStyle="spread"
        app:layout_goneMarginTop="@dimen/item_gap_12"
        style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:id="@+id/tv_time"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_4"
        android:layout_marginBottom="@dimen/item_gap_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/tv_content"
        app:layout_constraintStart_toStartOf="@+id/tv_content"
        app:layout_constraintTop_toBottomOf="@+id/tv_content"
        app:layout_constraintVertical_bias="0"
        style="@style/TypeStyles.BodyXXSmall"/>
    <View
        android:id="@+id/v_separator"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_xxxs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
