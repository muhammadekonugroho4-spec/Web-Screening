<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Sb.BottomSheetDialog"
    android:tag="layout/dialog_screener_rules_0"
    android:background="@drawable/bg_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/rl_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/clickable_size_48">
        <ImageView
            android:id="@+id/view_handler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/spacing_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="?attr/rectangle_dialog"/>
        <TextView
            android:id="@+id/tv_rules_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            android:text="@string/title_screener_create_new_add_rules_title"
            android:layout_below="@+id/view_handler"
            android:layout_centerHorizontal="true"
            style="@style/TypeStyles.HeadlineRegular"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_header">
        <RelativeLayout
            android:id="@+id/rl_rules_layout"
            android:background="@drawable/bg_screener_rules"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/item_gap_16"
            android:layout_marginVertical="@dimen/item_gap_20">
            <View
                android:background="?attr/themeColorModalsDividerThin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_1"
                android:layout_below="@+id/rl_basic_ratio_layout"/>
            <RelativeLayout
                android:id="@+id/rl_basic_ratio_layout"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/item_gap_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tv_basic_ratio_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/item_gap_s"
                    android:text="@string/title_screener_rules_basic_ratio_title"
                    style="@style/TypeStyles.HeadlineRegular"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_screener_rules_basic_ratio_desc_title"
                    android:layout_below="@+id/tv_basic_ratio_title"
                    android:layout_centerInParent="true"
                    style="@style/TypeStyles.ParagraphRegular"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/rl_ratio_vs_ratio_layout"
                android:background="?attr/selectableItemBackground"
                android:padding="@dimen/item_gap_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rl_basic_ratio_layout">
                <TextView
                    android:id="@+id/tv_ratio_vs_ratio_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/item_gap_s"
                    android:text="@string/title_screener_rules_ratio_vs_ratio_title"
                    style="@style/TypeStyles.HeadlineRegular"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_screener_rules_ratio_vs_ratio_desc_title"
                    android:layout_below="@+id/tv_ratio_vs_ratio_title"
                    android:layout_centerInParent="true"
                    style="@style/TypeStyles.ParagraphRegular"/>
            </RelativeLayout>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
