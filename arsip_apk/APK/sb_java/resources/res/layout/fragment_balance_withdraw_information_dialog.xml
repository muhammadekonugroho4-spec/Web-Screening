<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_balance_withdraw_information_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_white_rounded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/indicator"
            android:background="@drawable/bg_gray_collapse"
            android:layout_width="@dimen/clickable_size_38"
            android:layout_height="@dimen/item_gap_5"
            android:layout_marginTop="@dimen/item_gap_11"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tv_title_balance_information"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_32"
            android:text="@string/withdraw_title_information_balance"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/indicator"
            style="@style/TypeStyles.HeadingLarge"/>
        <TextView
            android:id="@+id/tv_balance_withdraw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_balance_information"
            style="@style/TypeStyles.Nominal"/>
        <RelativeLayout
            android:id="@+id/rl_information_balance"
            android:background="@drawable/bg_rounded_4_transparent_colormodal"
            android:paddingTop="@dimen/item_gap_16"
            android:paddingBottom="@dimen/item_gap_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_40"
            android:paddingStart="@dimen/item_gap_20"
            android:paddingEnd="@dimen/item_gap_20"
            android:layout_marginStart="@dimen/item_gap_10"
            android:layout_marginEnd="@dimen/item_gap_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_balance_withdraw">
            <TextView
                android:id="@+id/tv_title_balance_transaction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/withdraw_text_balance_transaction"
                android:layout_alignParentLeft="true"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_balance_transaction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_toEndOf="@+id/tv_title_balance_transaction"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:id="@+id/tv_title_balance_cash_sweep_pending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/withdraw_text_balance_cash_sweep_pending"
                android:layout_below="@+id/tv_title_balance_transaction"
                android:layout_alignParentLeft="true"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:textColor="?attr/themeColorTextRed"
                android:gravity="end"
                android:id="@+id/tv_balance_cash_sweep_pending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_below="@+id/tv_title_balance_transaction"
                android:layout_alignParentRight="true"
                android:layout_toEndOf="@+id/tv_title_balance_cash_sweep_pending"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:id="@+id/tv_title_balance_cash_sweep_pending_redemption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/withdraw_text_balance_cash_sweep_pending_redemption"
                android:layout_below="@+id/tv_title_balance_cash_sweep_pending"
                android:layout_alignParentLeft="true"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:textColor="?attr/themeColorTextRed"
                android:gravity="end"
                android:id="@+id/tv_balance_cash_sweep_pending_redemption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_below="@+id/tv_title_balance_cash_sweep_pending"
                android:layout_alignParentRight="true"
                android:layout_toEndOf="@+id/tv_title_balance_cash_sweep_pending_redemption"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:id="@+id/tv_title_balance_delayed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/withdraw_text_balance_delayed"
                android:layout_below="@+id/tv_title_balance_cash_sweep_pending_redemption"
                android:layout_alignParentLeft="true"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:textColor="?attr/themeColorTextRed"
                android:gravity="end"
                android:id="@+id/tv_balance_delayed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_below="@+id/tv_title_balance_cash_sweep_pending_redemption"
                android:layout_alignParentRight="true"
                android:layout_toEndOf="@+id/tv_title_balance_delayed"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:id="@+id/tv_title_leverage_liability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/withdraw_text_leverage_liability"
                android:layout_below="@+id/tv_title_balance_delayed"
                android:layout_alignParentLeft="true"
                style="@style/TypeStyles.BodyRegular"/>
            <TextView
                android:textColor="?attr/themeColorTextRed"
                android:gravity="end"
                android:id="@+id/tv_leverage_liability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_below="@+id/tv_title_balance_delayed"
                android:layout_alignParentRight="true"
                android:layout_toEndOf="@+id/tv_title_leverage_liability"
                style="@style/TypeStyles.BodyRegular"/>
            <View
                android:id="@+id/divider"
                android:background="?attr/themeColorModalsDividerThin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_1"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_below="@+id/tv_title_leverage_liability"/>
            <TextView
                android:id="@+id/tv_title_withdraw_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_below="@+id/divider"
                android:layout_alignParentLeft="true"
                style="@style/TypeStyles.HeadingRegular"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_withdraw_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_below="@+id/divider"
                android:layout_alignParentRight="true"
                android:layout_toEndOf="@+id/tv_title_withdraw_balance"
                style="@style/TypeStyles.HeadingRegular"/>
        </RelativeLayout>
        <View
            android:id="@+id/divider2"
            android:background="?attr/themeColorModalsDividerThick"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_xxxs"
            android:layout_marginTop="@dimen/item_gap_20"
            app:layout_constraintTop_toBottomOf="@+id/rl_information_balance"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.25"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.5"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.75"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_title_t0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_36"
            app:layout_constraintEnd_toStartOf="@+id/guideline2"
            app:layout_constraintStart_toEndOf="@+id/guideline"
            app:layout_constraintTop_toBottomOf="@+id/divider2"
            style="@style/TypeStyles.HeadingSmall"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_date_t0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/guideline2"
            app:layout_constraintStart_toEndOf="@+id/guideline"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_t0"
            style="@style/TypeStyles.BodyXSmall.Secondary"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_title_t1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_36"
            app:layout_constraintEnd_toStartOf="@+id/guideline3"
            app:layout_constraintStart_toEndOf="@+id/guideline2"
            app:layout_constraintTop_toBottomOf="@+id/divider2"
            style="@style/TypeStyles.HeadingSmall"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_date_t1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/guideline3"
            app:layout_constraintStart_toEndOf="@+id/guideline2"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_t1"
            style="@style/TypeStyles.BodyXSmall.Secondary"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_title_t2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_36"
            android:layout_marginEnd="@dimen/item_gap_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline3"
            app:layout_constraintTop_toBottomOf="@+id/divider2"
            style="@style/TypeStyles.HeadingSmall"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_date_t2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/item_gap_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline3"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_t2"
            style="@style/TypeStyles.BodyXSmall.Secondary"/>
        <View
            android:id="@+id/divider3"
            android:background="?attr/themeColorModalsDividerThick"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_2"
            android:layout_marginTop="@dimen/item_gap_16"
            app:layout_constraintTop_toBottomOf="@+id/tv_date_t0"/>
        <TextView
            android:id="@+id/tv_title_balance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_16"
            android:text="@string/withdraw_title_information_balance"
            android:layout_marginStart="@dimen/item_gap_10"
            app:layout_constraintEnd_toStartOf="@+id/guideline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider3"
            style="@style/TypeStyles.HeadingXSmall"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_t0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title_balance"
            app:layout_constraintEnd_toStartOf="@+id/guideline2"
            app:layout_constraintStart_toEndOf="@+id/guideline"
            app:layout_constraintTop_toTopOf="@+id/tv_title_balance"
            style="@style/TypeStyles.BodyXSmall"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_t1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title_balance"
            app:layout_constraintEnd_toStartOf="@+id/guideline3"
            app:layout_constraintStart_toEndOf="@+id/guideline2"
            app:layout_constraintTop_toTopOf="@+id/tv_title_balance"
            style="@style/TypeStyles.BodyXSmall"/>
        <TextView
            android:gravity="end"
            android:id="@+id/tv_t2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/item_gap_10"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title_balance"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/guideline3"
            app:layout_constraintTop_toTopOf="@+id/tv_title_balance"
            style="@style/TypeStyles.BodyXSmall"/>
        <View
            android:id="@+id/divider4"
            android:background="?attr/themeColorModalsDividerThick"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_xxxs"
            android:layout_marginTop="@dimen/item_gap_36"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_balance"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_4"
            android:layout_marginBottom="@dimen/item_gap_20"
            android:paddingHorizontal="@dimen/item_gap_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/divider4"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
