<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_securities_forgot_pass_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarSecuritiesForgotPassword"
        android:background="?attr/themeContentBackground"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:elevation="@dimen/item_gap_null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/genericToolbarSecuritiesForgotPassword"
            android:paddingLeft="@dimen/item_gap_null"
            android:paddingRight="@dimen/item_gap_null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:contentInsetLeft="@dimen/item_gap_null"
            app:contentInsetStart="@dimen/item_gap_null"
            app:contentInsetStartWithNavigation="@dimen/item_gap_null"
            app:elevation="@dimen/item_gap_null">
            <RelativeLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/parentToolbarSecuritiesForgotPasswordContentContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize">
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:id="@+id/tvToolbarSecuritiesForgotPasswordTitleName"
                    android:paddingLeft="@dimen/item_gap_l"
                    android:paddingRight="@dimen/item_gap_l"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/page_title_forgot_password"
                    android:singleLine="true"
                    android:layout_centerHorizontal="true"
                    android:textAlignment="gravity"
                    style="@style/SbTextView.BodyDefault.Bold"/>
            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <ViewFlipper
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBar">
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/llSSecuritiesForgotPassword"
            android:background="?attr/themeContentBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/acivSecuritiesForgotPasswordSend"
                android:layout_width="@dimen/clickable_size_72"
                android:layout_height="@dimen/clickable_size_72"
                android:layout_marginTop="@dimen/item_gap_20"
                android:src="@drawable/ic_email_verification"
                android:layout_marginStart="@dimen/item_gap_20"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_size_18"
                android:id="@+id/tvSecuritiesForgotPasswordSendTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/forgot_pin_email_send_title"
                android:layout_below="@+id/acivSecuritiesForgotPasswordSend"
                android:textAlignment="gravity"
                android:layout_marginStart="@dimen/item_gap_20"
                style="@style/SbTextView.BodyDefault.Bold"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_size_14"
                android:id="@+id/tvSecuritiesForgotPasswordSendSubtitle"
                android:tag="binding_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_m"
                android:layout_below="@+id/tvSecuritiesForgotPasswordSendTitle"
                android:textAlignment="gravity"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20"
                style="@style/SbTextView.BodySecondary"/>
            <com.stockbit.common.uikit.StockbitLoadingButton
                android:id="@+id/rlSecuritiesForgotPasswordSend"
                android:tag="binding_3"
                android:background="@drawable/bg_selector_btn_green"
                android:layout_width="match_parent"
                android:layout_height="@dimen/clickable_size_48"
                android:layout_alignParentBottom="true"
                app:buttonText="@string/forgot_pin_kirim_button"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/llSettingSecuritiesForgotPasswordSuccessStockbit"
            android:background="?attr/themeContentBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/acivSecuritiesForgotPasswordSuccessIcon"
                android:layout_width="@dimen/clickable_size_72"
                android:layout_height="@dimen/clickable_size_72"
                android:layout_marginTop="@dimen/item_gap_20"
                android:src="@drawable/ic_email_verification"
                android:layout_marginStart="@dimen/item_gap_20"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_size_18"
                android:id="@+id/tvTitleSecuritiesForgotPasswordTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/forgot_pin_email_send_success_title"
                android:layout_below="@+id/acivSecuritiesForgotPasswordSuccessIcon"
                android:textAlignment="gravity"
                android:layout_marginStart="@dimen/item_gap_20"
                style="@style/SbTextView.BodyDefault.Bold"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_size_14"
                android:id="@+id/tvSecuritiesForgotPasswordSubtitle"
                android:tag="binding_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_m"
                android:layout_below="@+id/tvTitleSecuritiesForgotPasswordTitle"
                android:textAlignment="gravity"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20"
                style="@style/SbTextView.BodySecondary"/>
        </RelativeLayout>
        <include
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/comp_icon_error_view"/>
    </ViewFlipper>
</LinearLayout>
