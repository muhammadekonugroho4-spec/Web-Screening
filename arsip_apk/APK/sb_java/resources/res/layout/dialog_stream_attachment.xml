<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/dialog_stream_attachment_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/layout_indicator"
        layout="@layout/comp_dialog_header_indicator"/>
    <RelativeLayout
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/clickable_size_72">
        <TextView
            android:id="@+id/tv_title"
            android:paddingLeft="@dimen/item_gap_l"
            android:paddingTop="@dimen/item_gap_l"
            android:paddingRight="@dimen/item_gap_l"
            android:paddingBottom="@dimen/item_gap_s"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/SbTextView.PageTitle"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="vertical"
            android:id="@+id/rv_attachment"
            android:paddingBottom="@dimen/item_gap_l"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/tv_title"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </RelativeLayout>
</LinearLayout>
