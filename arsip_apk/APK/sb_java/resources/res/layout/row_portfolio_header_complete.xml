<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:tag="layout/row_portfolio_header_complete_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:paddingTop="@dimen/spacing_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:minHeight="@dimen/portfolio_row_item_complete_height"
    android:paddingHorizontal="@dimen/spacing_20"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <RelativeLayout
        android:id="@+id/rl_symbol"
        android:layout_width="@dimen/width_83"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/width_54">
        <RelativeLayout
            android:id="@+id/rl_code_sort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true">
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="start|center_vertical"
                android:id="@+id/tv_trading_portfolio_row_code"
                android:paddingTop="@dimen/spacing_2"
                android:paddingBottom="@dimen/spacing_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="16dp"
                android:text="@string/text_portfolio_header_complete_code"
                style="@style/TypeStyles.BodyXSmall"/>
            <ImageView
                android:id="@+id/iv_sort_code"
                android:visibility="gone"
                android:layout_width="@dimen/spacing_6"
                android:layout_height="@dimen/height_12"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/spacing_4"
                android:layout_toEndOf="@+id/tv_trading_portfolio_row_code"
                app:srcCompat="@drawable/ic_portfolio_sort_desc"/>
        </RelativeLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_trading_portfolio_row_lot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:minHeight="15dp"
            android:text="@string/text_portfolio_header_complete_lot"
            android:layout_below="@+id/rl_code_sort"
            android:layout_centerHorizontal="true"
            style="@style/TypeStyles.BodyXXSmall"/>
    </RelativeLayout>
    <Space
        android:layout_width="@dimen/spacing_4"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:id="@+id/rl_invested"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rl_invested_sort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_trading_portfolio_row_invested"
                android:paddingTop="@dimen/spacing_2"
                android:paddingBottom="@dimen/spacing_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="16dp"
                android:text="@string/text_portfolio_header_complete_invested"
                android:layout_marginEnd="@dimen/spacing_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/iv_sort_invested"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginEnd="@dimen/spacing_0"
                style="@style/TypeStyles.BodyXSmall"/>
            <ImageView
                android:id="@+id/iv_sort_invested"
                android:visibility="gone"
                android:layout_width="@dimen/spacing_6"
                android:layout_height="@dimen/height_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_portfolio_sort_desc"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="end"
            android:id="@+id/tv_trading_portfolio_row_price_avg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:minHeight="15dp"
            android:text="@string/text_portfolio_header_complete_avg_price"
            android:layout_below="@+id/rl_invested_sort"
            android:layout_centerHorizontal="true"
            style="@style/TypeStyles.BodyXXSmall"/>
    </RelativeLayout>
    <Space
        android:layout_width="@dimen/spacing_4"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:id="@+id/rl_market"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rl_market_sort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_trading_portfolio_row_market"
                android:paddingTop="@dimen/spacing_2"
                android:paddingBottom="@dimen/spacing_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="16dp"
                android:text="@string/text_portfolio_header_complete_market"
                android:layout_marginEnd="@dimen/spacing_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/iv_sort_market"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginEnd="@dimen/spacing_0"
                style="@style/TypeStyles.BodyXSmall"/>
            <ImageView
                android:id="@+id/iv_sort_market"
                android:visibility="gone"
                android:layout_width="@dimen/spacing_6"
                android:layout_height="@dimen/height_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_portfolio_sort_desc"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="end"
            android:id="@+id/tv_trading_portfolio_row_current_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:minHeight="15dp"
            android:layout_below="@+id/rl_market_sort"
            android:layout_centerHorizontal="true"
            style="@style/TypeStyles.BodyXXSmall"/>
    </RelativeLayout>
    <Space
        android:layout_width="@dimen/spacing_4"
        android:layout_height="wrap_content"/>
    <RelativeLayout
        android:id="@+id/rl_pnl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/rl_pnl_sort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_trading_portfolio_row_pnl"
                android:paddingTop="@dimen/spacing_2"
                android:paddingBottom="@dimen/spacing_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="16dp"
                android:text="@string/text_portfolio_header_complete_pnl"
                android:layout_marginEnd="@dimen/spacing_4"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/iv_sort_pnl"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginEnd="@dimen/spacing_0"
                style="@style/TypeStyles.BodyXSmall"/>
            <ImageView
                android:id="@+id/iv_sort_pnl"
                android:visibility="gone"
                android:layout_width="@dimen/spacing_6"
                android:layout_height="@dimen/height_12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_portfolio_sort_desc"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="end"
            android:id="@+id/tv_trading_portfolio_row_gain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:minHeight="15dp"
            android:text="@string/text_portfolio_header_complete_gain"
            android:layout_below="@+id/rl_pnl_sort"
            style="@style/TypeStyles.BodyXSmall"/>
    </RelativeLayout>
</LinearLayout>
