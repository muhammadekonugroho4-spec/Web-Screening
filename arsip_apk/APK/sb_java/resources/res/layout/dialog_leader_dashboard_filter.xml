<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_leader_dashboard_filter_0"
    android:background="@drawable/bg_top_rounded_16"
    android:paddingBottom="@dimen/item_gap_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/v_handle"
        android:background="?attr/themeSeparatorGapColorNewSecondary"
        android:layout_width="@dimen/width_38"
        android:layout_height="@dimen/item_gap_5"
        android:layout_marginVertical="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:gravity="center_vertical"
        android:id="@+id/tv_filter_by"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_56"
        android:layout_marginTop="@dimen/item_gap_17"
        android:text="@string/title_filter_by"
        android:layout_marginStart="@dimen/item_gap_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_handle"
        style="@style/TypeStyles.HeadingLarge"/>
    <com.stockbit.uikit.button.FloatingButton
        android:gravity="center_vertical"
        android:id="@+id/btn_reset"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/button_reset"
        app:floatingButtonColor="red"
        app:floatingButtonSize="defaultSize"
        app:layout_constraintBottom_toBottomOf="@+id/tv_filter_by"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_filter_by"/>
    <include
        android:id="@+id/comp_start_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:layout_marginStart="@dimen/item_gap_20"
        app:layout_constraintEnd_toStartOf="@+id/tv_date_divider"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_filter_by"
        layout="@layout/comp_input_date"/>
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:gravity="center"
        android:id="@+id/tv_date_divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-"
        android:layout_marginHorizontal="@dimen/item_gap_16"
        android:paddingVertical="@dimen/item_gap_12"
        app:layout_constraintBottom_toBottomOf="@+id/comp_start_date"
        app:layout_constraintEnd_toStartOf="@+id/comp_end_date"
        app:layout_constraintStart_toEndOf="@+id/comp_start_date"
        style="@style/TypeStyles.BodyRegular"/>
    <include
        android:id="@+id/comp_end_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_date_divider"
        app:layout_constraintTop_toBottomOf="@+id/tv_filter_by"
        layout="@layout/comp_input_date"/>
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:layout_marginBottom="@dimen/item_gap_12"
        android:text="@string/title_status"
        android:layout_marginStart="@dimen/item_gap_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/comp_start_date"
        style="@style/TypeStyles.HeadingXSmall"/>
    <com.stockbit.uikit.chips.SBChipsGroup
        android:id="@+id/cg_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:chipsActionMode="single_pick"
        app:chipsGroupItemSpacing="@dimen/item_gap_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_status">
        <com.stockbit.uikit.chips.SBChips
            android:id="@+id/c_all"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipsText="@string/text_chip_all"/>
        <com.stockbit.uikit.chips.SBChips
            android:id="@+id/c_active"
            android:tag="binding_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipsText="@string/text_chip_active"/>
        <com.stockbit.uikit.chips.SBChips
            android:id="@+id/c_inactive"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipsText="@string/text_chip_inactive"/>
    </com.stockbit.uikit.chips.SBChipsGroup>
    <View
        android:id="@+id/v_divider"
        android:background="?attr/themeSeparatorGapColorNewSecondary"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="@dimen/item_gap_1"
        android:layout_marginTop="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cg_status"/>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/btn_apply_filter"
        android:tag="binding_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_21"
        android:text="@string/btn_apply"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_divider"/>
</androidx.constraintlayout.widget.ConstraintLayout>
