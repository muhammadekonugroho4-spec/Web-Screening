<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_tipping_tip_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:paddingLeft="@dimen/item_gap_null"
        android:paddingRight="@dimen/item_gap_null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:contentInsetLeft="@dimen/item_gap_null"
        app:contentInsetStart="@dimen/item_gap_null"
        app:contentInsetStartWithNavigation="@dimen/item_gap_null"
        app:elevation="@dimen/item_gap_null">
        <RelativeLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/parentToolbarContentContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize">
            <TextView
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/tvToolbarTitleName"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_tipping_title"
                android:singleLine="true"
                android:layout_centerHorizontal="true"
                android:textAlignment="gravity"
                style="@style/SbTextView.PageTitle"/>
            <TextView
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/tvToolbarSubtitle"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/n_dash"
                android:singleLine="true"
                android:layout_below="@+id/tvToolbarTitleName"
                android:layout_centerHorizontal="true"
                android:textAlignment="gravity"
                style="@style/SbTextView.CaptionSecondary"/>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <View
        android:background="?attr/themeSeparatorGapColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"/>
    <ViewFlipper
        android:id="@+id/vfTippingTipActivity"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <RelativeLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ProgressBar
                android:id="@+id/progressbarTippingTip"
                android:layout_width="@dimen/clickable_size_32"
                android:layout_height="@dimen/clickable_size_32"
                android:layout_centerInParent="true"
                android:indeterminateTint="@color/green_text"/>
        </RelativeLayout>
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivActivitySendTippingAmountTargetUserAvatar"
                    android:tag="binding_2"
                    android:background="?attr/selectableItemBackground"
                    android:layout_width="@dimen/avatar_size_xl"
                    android:layout_height="@dimen/avatar_size_xl"
                    android:layout_marginTop="@dimen/clickable_size_48"
                    android:src="@drawable/ic_avatar"
                    android:layout_centerHorizontal="true"/>
                <TextView
                    android:id="@+id/tvActivitySendTippingAmountLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/clickable_size_24"
                    android:text="@string/title_tipping_amount_title"
                    android:layout_below="@+id/ivActivitySendTippingAmountTargetUserAvatar"
                    android:layout_marginStart="@dimen/item_gap_l"
                    style="@style/SbTextView.BodyDefault"/>
                <RadioGroup
                    android:orientation="horizontal"
                    android:id="@+id/radioGroupActivitySendTipping"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/item_gap_l"
                    android:layout_marginTop="@dimen/item_gap_m"
                    android:layout_marginRight="@dimen/item_gap_l"
                    android:layout_below="@+id/tvActivitySendTippingAmountLabel">
                    <RadioButton
                        android:gravity="center"
                        android:id="@+id/radioButtonActivitySendTippingSmall"
                        android:background="@drawable/bg_radiobutton_gray_outline"
                        android:paddingTop="@dimen/item_gap_xs"
                        android:paddingBottom="@dimen/item_gap_xs"
                        android:layout_width="@dimen/fixed_min_width"
                        android:layout_height="@dimen/clickable_size_32"
                        android:button="@null"
                        android:text="@string/title_tipping_amount_5000_title"
                        android:layout_weight="1"
                        style="@style/SbTextView.BodyDefault"/>
                    <RadioButton
                        android:gravity="center"
                        android:id="@+id/radioButtonActivitySendTippingMedium"
                        android:background="@drawable/bg_radiobutton_gray_outline"
                        android:paddingTop="@dimen/item_gap_xs"
                        android:paddingBottom="@dimen/item_gap_xs"
                        android:layout_width="@dimen/fixed_min_width"
                        android:layout_height="@dimen/clickable_size_32"
                        android:button="@null"
                        android:text="@string/title_tipping_amount_10000_title"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/item_gap_m"
                        style="@style/SbTextView.BodyDefault"/>
                    <RadioButton
                        android:gravity="center"
                        android:id="@+id/radioButtonActivitySendTippingLarge"
                        android:background="@drawable/bg_radiobutton_gray_outline"
                        android:paddingTop="@dimen/item_gap_xs"
                        android:paddingBottom="@dimen/item_gap_xs"
                        android:layout_width="@dimen/fixed_min_width"
                        android:layout_height="@dimen/clickable_size_32"
                        android:button="@null"
                        android:text="@string/title_tipping_amount_20000_title"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/item_gap_m"
                        style="@style/SbTextView.BodyDefault"/>
                </RadioGroup>
                <EditText
                    android:gravity="center_vertical"
                    android:id="@+id/etActivitySendTippingCustomAmount"
                    android:background="@drawable/bg_input_selector_rounded_m"
                    android:paddingLeft="@dimen/item_gap_l"
                    android:paddingRight="@dimen/item_gap_l"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/clickable_size_40"
                    android:layout_marginLeft="@dimen/item_gap_l"
                    android:layout_marginTop="@dimen/item_gap_m"
                    android:layout_marginRight="@dimen/item_gap_l"
                    android:hint="@string/title_tipping_amount_other_title"
                    android:layout_below="@+id/radioGroupActivitySendTipping"
                    android:inputType="number"
                    android:imeOptions="actionDone"
                    style="@style/SbEditTextStyle"/>
                <TextView
                    android:id="@+id/tvActivitySendTippingMessageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_l"
                    android:text="@string/title_tipping_message_title"
                    android:layout_below="@+id/etActivitySendTippingCustomAmount"
                    android:layout_marginStart="@dimen/item_gap_l"
                    style="@style/SbTextView.BodyDefault"/>
                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etActivitySendTippingCustomMessage"
                    android:background="@drawable/bg_input_selector_rounded_m"
                    android:paddingLeft="@dimen/item_gap_l"
                    android:paddingTop="@dimen/item_gap_s"
                    android:paddingRight="@dimen/item_gap_l"
                    android:paddingBottom="@dimen/item_gap_s"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/item_gap_l"
                    android:layout_marginTop="@dimen/item_gap_m"
                    android:layout_marginRight="@dimen/item_gap_l"
                    android:minHeight="@dimen/clickable_size_40"
                    android:hint="@string/title_tipping_message_hint_title"
                    android:layout_below="@+id/tvActivitySendTippingMessageLabel"
                    android:inputType="textMultiLine"
                    android:imeOptions="actionDone"
                    style="@style/SbEditTextStyle"/>
                <RelativeLayout
                    android:enabled="false"
                    android:gravity="center_horizontal"
                    android:id="@+id/parentActivitySendTippingSubmit"
                    android:background="@drawable/btn_following"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/item_gap_l"
                    android:layout_marginTop="@dimen/item_gap_l"
                    android:layout_marginRight="@dimen/item_gap_l"
                    android:layout_marginBottom="@dimen/item_gap_l"
                    android:minHeight="@dimen/clickable_size_48"
                    android:layout_below="@+id/etActivitySendTippingCustomMessage">
                    <ProgressBar
                        android:id="@+id/progressbarSendTipping"
                        android:visibility="gone"
                        android:layout_width="@dimen/clickable_size_24"
                        android:layout_height="@dimen/clickable_size_24"
                        android:layout_centerVertical="true"
                        android:indeterminateTint="@color/highgray_light"
                        style="@style/Widget.AppCompat.ProgressBar"/>
                    <TextView
                        android:enabled="false"
                        android:textColor="@color/white"
                        android:id="@+id/tvActivitySendTippingSubmit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_send_tip_submit"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/item_gap_m"
                        android:layout_marginEnd="@dimen/item_gap_l"
                        android:layout_toEndOf="@+id/progressbarSendTipping"
                        style="@style/SbTextView.Button.Regular"/>
                </RelativeLayout>
                <View
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/item_gap_l"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/parentActivitySendTippingSubmit"/>
            </RelativeLayout>
        </androidx.core.widget.NestedScrollView>
    </ViewFlipper>
</androidx.appcompat.widget.LinearLayoutCompat>
