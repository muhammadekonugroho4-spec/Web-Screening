<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_watchlist_new_group_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <EditText
        android:textColorHint="?attr/themeColorTextTetriary"
        android:id="@+id/et_watchlist_group_name"
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/placeholder_watchlist_insert"
        android:maxLines="1"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:layout_marginStart="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_16"
        android:importantForAutofill="no"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyLarge"/>
    <View
        android:id="@+id/v_border"
        android:background="?attr/themeColorModalsBorder"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_1"
        android:layout_marginHorizontal="@dimen/spacing_16"
        app:layout_constraintTop_toBottomOf="@+id/et_watchlist_group_name"/>
</androidx.constraintlayout.widget.ConstraintLayout>
