<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:tag="layout/row_banner_redeem_0"
    android:background="@color/background_green_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:gravity="start"
        android:layout_gravity="start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_banner_coupon"
        android:layout_alignParentStart="true"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="@dimen/item_gap_20">
        <ProgressBar
            android:id="@+id/progressbar"
            android:visibility="gone"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:layout_centerVertical="true"
            android:indeterminateTint="@color/green_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.AppCompat.ProgressBar"/>
        <Button
            android:textSize="@dimen/text_size_13"
            android:textColor="@color/color_enabled_disable_green"
            android:id="@+id/btnRedeemAll"
            android:background="@drawable/btn_redeem_all"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/item_gap_35"
            android:minWidth="@dimen/clickable_size_130"
            android:textAllCaps="false"
            android:paddingHorizontal="@dimen/item_gap_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SbBtnBorderless.Default"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
