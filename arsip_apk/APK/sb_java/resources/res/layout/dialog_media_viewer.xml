<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_media_viewer_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/parentMediaViewerImageContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.github.piasy.biv.view.BigImageView
            android:id="@+id/ivMediaViewerBigImage"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:failureImage="@drawable/ic_chat_error_img"
            app:failureImageInitScaleType="center"
            app:initScaleType="fitCenter"
            app:optimizeDisplay="true"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivMediaViewerImage"
            android:tag="binding_2"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:failureImage="@drawable/ic_chat_error_img"
            app:failureImageInitScaleType="center"
            app:initScaleType="fitCenter"
            app:optimizeDisplay="true"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/parentMediaViewerCloseButtonContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_l"
        android:alpha="0"
        android:translationY="-48dp"
        android:layout_marginStart="@dimen/item_gap_l"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:layout_gravity="center"
            android:id="@+id/ibMediaViewerCloseMediaViewer"
            android:tag="binding_3"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/hint_close"
            app:srcCompat="@drawable/ic_circle_close"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
