<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_container"
    android:tag="layout/dialog_livestream_share_0"
    android:background="@drawable/bg_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_share_post_header"
        android:paddingBottom="@dimen/spacing_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/view_share_post"
            android:background="@drawable/bg_rounded_gray_gray_bg"
            android:layout_width="@dimen/clickable_size_64"
            android:layout_height="@dimen/item_gap_xs"
            android:layout_marginTop="@dimen/spacing_6"
            android:layout_centerHorizontal="true"
            android:alpha="0.5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tv_share_post_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:text="@string/lbl_share"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            app:layout_constraintEnd_toEndOf="@+id/view_share_post"
            app:layout_constraintStart_toStartOf="@+id/view_share_post"
            app:layout_constraintTop_toBottomOf="@+id/view_share_post"
            style="@style/SbTextView.TitleSmall"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/tv_send_to"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/livestream_share_send_to"
            android:layout_marginStart="@dimen/item_gap_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SbTextView.ListTitle.Highempasis.Bold"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_share_friends"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_send_to">
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/rv_share_post_people"
            android:tag="binding_1"
            android:paddingBottom="@dimen/spacing_20"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/item_gap_10"
            android:layout_marginBottom="@dimen/spacing_20"
            android:paddingStart="@dimen/spacing_4"
            android:paddingEnd="@dimen/spacing_20"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:tag="binding_2"
            android:paddingBottom="@dimen/spacing_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_10"
            android:layout_marginBottom="@dimen/spacing_20"
            android:paddingStart="@dimen/spacing_4"
            android:paddingEnd="@dimen/spacing_0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:orientation="horizontal"
                android:tag="binding_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <include layout="@layout/skeleton_user_to_share"/>
                <include layout="@layout/skeleton_user_to_share"/>
                <include layout="@layout/skeleton_user_to_share"/>
                <include layout="@layout/skeleton_user_to_share"/>
                <include layout="@layout/skeleton_user_to_share"/>
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <View
            android:id="@+id/view_sep_share_post"
            android:tag="binding_4"
            android:background="?attr/themeContentButtonBorder"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="@dimen/item_gap_xxxs"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rv_share_post_people"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="-112dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_end="453dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="-76dp"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/guideline_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_begin="-86dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_share_other"
        android:tag="binding_5"
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:id="@+id/tv_share_to"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_20"
            android:text="@string/livestream_share_share_to"
            android:layout_marginStart="@dimen/spacing_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SbTextView.ListTitle.Highempasis.Bold"/>
        <HorizontalScrollView
            android:id="@+id/hsv_share_to"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_10"
            android:paddingHorizontal="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_share_to">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_container_share_to"
                    android:tag="binding_6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground">
                    <ImageView
                        android:id="@+id/iv_share_via"
                        android:background="@drawable/bg_circle_border"
                        android:layout_width="@dimen/width_50"
                        android:layout_height="@dimen/height_50"
                        android:foreground="?attr/selectableItemBackground"
                        android:src="@drawable/ic_share_light_stroke_black_24dp"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/livestream_share_share_to"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/green_text"/>
                    <TextView
                        android:textSize="10sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/livestream_share_share_via"
                        app:layout_constraintEnd_toEndOf="@+id/iv_share_via"
                        app:layout_constraintStart_toStartOf="@+id/iv_share_via"
                        app:layout_constraintTop_toBottomOf="@+id/iv_share_via"
                        style="@style/SbTextView.Caption.Highempasis"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_container_whatsapp"
                    android:tag="binding_7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginStart="@dimen/item_gap_20">
                    <ImageView
                        android:id="@+id/iv_share_whatsapp"
                        android:background="@drawable/bg_circle_border"
                        android:layout_width="@dimen/width_50"
                        android:layout_height="@dimen/height_50"
                        android:foreground="?attr/selectableItemBackground"
                        android:src="@drawable/ic_whatsapp"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/livestream_share_share_to"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="10sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_5"
                        android:text="@string/livestream_share_whatsapp"
                        app:layout_constraintEnd_toEndOf="@+id/iv_share_whatsapp"
                        app:layout_constraintStart_toStartOf="@+id/iv_share_whatsapp"
                        app:layout_constraintTop_toBottomOf="@+id/iv_share_whatsapp"
                        style="@style/SbTextView.Caption.Highempasis"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_container_telegram"
                    android:tag="binding_8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginStart="@dimen/item_gap_20">
                    <ImageView
                        android:id="@+id/iv_share_telegram"
                        android:background="@drawable/bg_circle_border"
                        android:layout_width="@dimen/width_50"
                        android:layout_height="@dimen/height_50"
                        android:foreground="?attr/selectableItemBackground"
                        android:src="@drawable/ic_telegram"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/livestream_share_telegram"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="10sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_5"
                        android:text="@string/livestream_share_telegram"
                        app:layout_constraintEnd_toEndOf="@+id/iv_share_telegram"
                        app:layout_constraintStart_toStartOf="@+id/iv_share_telegram"
                        app:layout_constraintTop_toBottomOf="@+id/iv_share_telegram"
                        style="@style/SbTextView.Caption.Highempasis"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_container_twitter"
                    android:tag="binding_9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground">
                    <ImageView
                        android:id="@+id/iv_share_twitter"
                        android:background="@drawable/bg_circle_border"
                        android:layout_width="@dimen/width_50"
                        android:layout_height="@dimen/height_50"
                        android:foreground="?attr/selectableItemBackground"
                        android:src="@drawable/ic_twitter"
                        android:scaleType="centerInside"
                        android:layout_marginStart="@dimen/item_gap_20"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="10sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_5"
                        android:text="@string/livestream_share_twitter"
                        app:layout_constraintEnd_toEndOf="@+id/iv_share_twitter"
                        app:layout_constraintStart_toStartOf="@+id/iv_share_twitter"
                        app:layout_constraintTop_toBottomOf="@+id/iv_share_twitter"
                        style="@style/SbTextView.Caption.Highempasis"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_container_message"
                    android:tag="binding_10"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginHorizontal="@dimen/spacing_20">
                    <ImageView
                        android:id="@+id/iv_share_messages"
                        android:background="@drawable/bg_circle_border"
                        android:layout_width="@dimen/width_50"
                        android:layout_height="@dimen/height_50"
                        android:foreground="?attr/selectableItemBackground"
                        android:src="@drawable/ic_messages"
                        android:scaleType="centerInside"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="10sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_5"
                        android:text="@string/livestream_share_messages"
                        app:layout_constraintEnd_toEndOf="@+id/iv_share_messages"
                        app:layout_constraintStart_toStartOf="@+id/iv_share_messages"
                        app:layout_constraintTop_toBottomOf="@+id/iv_share_messages"
                        style="@style/SbTextView.Caption.Highempasis"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </HorizontalScrollView>
        <View
            android:id="@+id/v_separator_share_to"
            android:background="?attr/themeContentButtonBorder"
            android:layout_width="0dp"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_marginTop="@dimen/item_gap_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hsv_share_to"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_copy_link"
            android:tag="binding_11"
            android:background="@drawable/bg_share_button_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_24"
            android:layout_marginBottom="@dimen/item_gap_24"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginStart="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/item_gap_15"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/cl_repost"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_separator_share_to">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/iv_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_8"
                    android:layout_marginBottom="@dimen/item_gap_8"
                    android:contentDescription="@string/livestream_share_copy_link"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_copy"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_link"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:id="@+id/tv_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/livestream_share_copy_link"
                    android:layout_marginStart="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_copy"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/SbTextView.ListTitle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_repost"
            android:tag="binding_12"
            android:background="@drawable/bg_share_button_box"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginStart="@dimen/item_gap_15"
            android:layout_marginEnd="@dimen/spacing_20"
            android:layout_marginVertical="@dimen/spacing_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cl_copy_link"
            app:layout_constraintTop_toBottomOf="@+id/v_separator_share_to">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/iv_repost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_8"
                    android:layout_marginBottom="@dimen/item_gap_8"
                    android:contentDescription="@string/livestream_share_repost"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/tv_repost"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_repost"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:id="@+id/tv_repost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/livestream_share_repost"
                    android:layout_marginStart="@dimen/item_gap_8"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_repost"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/SbTextView.ListTitle"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_compose"
        android:tag="binding_13"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:id="@+id/view_separate_share_post"
            android:background="?attr/themeContentButtonBorder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_marginBottom="@dimen/clickable_size_16"
            app:layout_constraintBottom_toTopOf="@+id/et_share_post_write_comment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <EditText
            android:gravity="center_vertical"
            android:id="@+id/et_share_post_write_comment"
            android:tag="binding_14"
            android:background="@drawable/bg_rounded_edit_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/clickable_size_16"
            android:layout_marginBottom="@dimen/clickable_size_16"
            android:minHeight="@dimen/avatar_size_default"
            android:hint="@string/hint_share_stream_post_message"
            android:maxLines="7"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionDone"
            android:paddingStart="@dimen/item_gap_15"
            android:paddingEnd="@dimen/item_gap_15"
            android:layout_marginStart="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/clickable_size_16"
            android:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_send"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/SbEditTextStyle.Medium"/>
        <ImageView
            android:id="@+id/iv_send"
            android:tag="binding_15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/livestream_share_send_to"
            android:layout_marginEnd="@dimen/item_gap_20"
            app:layout_constraintBottom_toBottomOf="@+id/et_share_post_write_comment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/et_share_post_write_comment"
            app:srcCompat="@drawable/ic_send_plane"/>
        <ProgressBar
            android:id="@+id/pb_send_loading"
            android:visibility="gone"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:layout_marginEnd="@dimen/item_gap_24"
            app:layout_constraintBottom_toBottomOf="@+id/et_share_post_write_comment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/et_share_post_write_comment"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
