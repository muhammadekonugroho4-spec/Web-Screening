<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_view"
    android:tag="layout/row_payment_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/item_gap_20">
    <ImageView
        android:id="@+id/iv_payment_icon"
        android:layout_width="@dimen/width_40"
        android:layout_height="@dimen/height_40"
        android:layout_centerVertical="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:id="@+id/tv_payment_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_4"
        android:layout_marginStart="@dimen/item_gap_16"
        app:layout_constraintStart_toEndOf="@+id/iv_payment_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_payment_icon"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:id="@+id/tv_payment_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_4"
        android:layout_marginStart="@dimen/item_gap_16"
        app:layout_constraintStart_toEndOf="@+id/iv_payment_icon"
        app:layout_constraintTop_toBottomOf="@+id/tv_payment_name"
        style="@style/SbTextView.Helper.Default"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/item_gap_4"
        app:layout_constraintBottom_toBottomOf="@+id/iv_payment_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_payment_icon"
        app:srcCompat="@drawable/ic_chevron_right_small"/>
    <View
        android:id="@+id/viewSeparator"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_payment_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
