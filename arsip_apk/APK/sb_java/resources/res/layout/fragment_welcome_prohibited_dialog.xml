<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_welcome_prohibited_dialog_0"
    android:background="@drawable/bg_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/rlWelcomeProhibitedIconHeader"
        android:paddingTop="@dimen/item_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/viewFragmentTippingGopayActivateDialogHandler"
            android:background="@drawable/bg_rounded_gray_gray_bg"
            android:layout_width="@dimen/clickable_size_64"
            android:layout_height="@dimen/item_gap_xs"
            android:layout_marginBottom="@dimen/item_gap_s"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rlTippingGopayActivateDialogDialogSuccessMainLayout"
        android:background="?attr/themeDialogBackgroundColor"
        android:paddingBottom="@dimen/item_gap_l"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rlWelcomeProhibitedIconHeader">
        <ImageView
            android:id="@+id/ivWelcomeProhibitedIcon"
            android:layout_width="@dimen/avatar_size_l"
            android:layout_height="@dimen/avatar_size_l"
            android:layout_margin="@dimen/item_gap_l"
            android:layout_centerHorizontal="true"
            app:srcCompat="@drawable/ic_emulator_warning_icon"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:gravity="center"
            android:id="@+id/tvWelcomeProhibitedDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/ivWelcomeProhibitedIcon"
            android:textAlignment="gravity"
            android:layout_marginStart="@dimen/item_gap_l"
            android:layout_marginEnd="@dimen/item_gap_l"
            style="@style/SbTextView.PageTitle"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tvWelcomeProhibitedDialogSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            android:layout_marginBottom="@dimen/item_gap_l"
            android:layout_below="@+id/tvWelcomeProhibitedDialogTitle"
            android:textAlignment="gravity"
            android:layout_marginStart="@dimen/item_gap_l"
            android:layout_marginEnd="@dimen/item_gap_l"
            style="@style/SbTextView.ListSubtitle"/>
        <Button
            android:textStyle="bold"
            android:textColor="@color/green_text"
            android:id="@+id/btnCloseWelcomeProhibitedDialog"
            android:background="@drawable/border_green_squared_white_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_height_m"
            android:layout_margin="@dimen/item_gap_l"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:text="@string/hint_close"
            android:layout_below="@+id/tvWelcomeProhibitedDialogSubtitle"
            android:layout_centerHorizontal="true"
            style="?android:attr/borderlessButtonStyle"/>
    </RelativeLayout>
</RelativeLayout>
