<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_history_trading_0"
    android:background="@drawable/bg_list_selector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/clickable_size_48">
    <View
        android:id="@+id/gap_date"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/clickable_size_48"
        android:paddingStart="@dimen/spacing_20"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingVertical="@dimen/spacing_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gap_date">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_history_action"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_weight="36.5">
            <TextView
                android:ellipsize="end"
                android:id="@+id/tv_history_symbol"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                style="@style/TypeStyles.BodyXXSmall"/>
            <ImageView
                android:id="@+id/iv_history_forced_sell"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_day_trade_forced_sell"/>
        </LinearLayout>
        <View
            android:id="@+id/gap_history_action"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:minWidth="@dimen/spacing_16"
            android:layout_weight="4.4"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:id="@+id/tv_history_amount"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_weight="32.8"
            style="@style/TypeStyles.BodyXXSmall"/>
        <View
            android:id="@+id/gap_history_amount"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:minWidth="@dimen/spacing_16"
            android:layout_weight="4.4"/>
        <TextView
            android:textSize="@dimen/text_size_12"
            android:id="@+id/tv_history_price"
            android:layout_width="@dimen/item_gap_null"
            android:layout_height="wrap_content"
            android:layout_weight="17.5"
            style="@style/TypeStyles.BodyXXSmall"/>
        <View
            android:id="@+id/gap_history_price"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:minWidth="@dimen/spacing_16"
            android:layout_weight="4.4"/>
        <TextView
            android:id="@+id/tv_history_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="65dp"
            android:text="@string/n_dash"
            android:textAlignment="gravity"
            style="@style/TypeStyles.BodyXXSmall"/>
    </LinearLayout>
    <View
        android:id="@+id/last_gap"
        android:background="?attr/themeColorDividerThin"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
