<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_company_financial_0"
    android:background="?attr/themeContentBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_company_financial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_financial_chart"
            android:paddingBottom="@dimen/bottom_navigation_view_height"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <HorizontalScrollView
                android:id="@+id/hsv_financial"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_11"
                android:fillViewport="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.stockbit.uikit.chips.SBChipsGroup
                    android:id="@+id/scg_financial_data"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/spacing_20"
                    app:chipsActionMode="single_pick">
                    <com.stockbit.uikit.chips.SBChips
                        android:id="@+id/sbc_income_statement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipsSelected="true"
                        app:chipsText="@string/tabs_financials_income_statement"/>
                    <com.stockbit.uikit.chips.SBChips
                        android:id="@+id/sbc_balance_sheet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipsText="@string/tabs_financials_balance_sheet"/>
                    <com.stockbit.uikit.chips.SBChips
                        android:id="@+id/sbc_cash_flow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipsText="@string/tabs_financials_cash_flow"/>
                </com.stockbit.uikit.chips.SBChipsGroup>
            </HorizontalScrollView>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_statement_type"
                android:tag="binding_1"
                android:background="@drawable/bg_transparent_with_artboard_border_and_radius_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_20"
                android:drawablePadding="@dimen/spacing_8"
                android:layout_marginStart="@dimen/spacing_20"
                android:paddingHorizontal="@dimen/item_gap_10"
                android:paddingVertical="@dimen/spacing_6"
                app:drawableEndCompat="@drawable/uikit_ic_stockbit_text_field_chevron_down"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/hsv_financial"
                style="@style/TypeStyles.HeadingXSmall"/>
            <com.stockbit.company.ui.financial.toggle.NumericalPercentageToggleView
                android:id="@+id/toggle_numerical_percentage"
                android:tag="binding_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_12"
                app:layout_constraintBottom_toBottomOf="@+id/tv_statement_type"
                app:layout_constraintEnd_toStartOf="@+id/ll_switch_financial_content"
                app:layout_constraintTop_toTopOf="@+id/tv_statement_type"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/ll_switch_financial_content"
                android:tag="binding_3"
                android:background="@drawable/bg_rounded_4_transparent_colorborder"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginEnd="@dimen/item_gap_20"
                android:paddingHorizontal="@dimen/item_gap_10"
                app:layout_constraintBottom_toBottomOf="@+id/tv_statement_type"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_statement_type">
                <ImageView
                    android:id="@+id/iv_switch_financial_content"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_stockbit_financial"/>
            </LinearLayout>
            <ViewFlipper
                android:id="@+id/vf_financial"
                android:tag="binding_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:measureAllChildren="false"
                app:layout_behavior="@string/appbar_scrolling_view_behavior"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_switch_financial_content">
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/sfl_financial_loading"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_14"
                    app:layout_constraintEnd_toEndOf="parent">
                    <LinearLayout
                        android:orientation="vertical"
                        android:tag="binding_5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <include layout="@layout/skeleton_financial_item"/>
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_financial_chart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_report_type">
                    <TextView
                        android:gravity="center_vertical"
                        android:id="@+id/tv_financial_type"
                        android:tag="binding_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_20"
                        android:textAlignment="gravity"
                        android:layout_marginStart="@dimen/spacing_20"
                        style="@style/SbTextView.ListTitle"/>
                    <com.stockbit.company.ui.financial.chart.CompanyFinancialChartView
                        android:id="@+id/chart_financial"
                        android:tag="binding_7"
                        android:paddingBottom="@dimen/spacing_20"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/fixed_max_rv_height_explore_rating"
                        android:layout_marginTop="@dimen/spacing_20"
                        android:layout_marginHorizontal="@dimen/item_gap_15"
                        style="@style/SbTextView.ListTitle"/>
                </LinearLayout>
                <com.stockbit.company.utils.tableview.TableView
                    android:id="@+id/table_view_financial"
                    android:paddingBottom="@dimen/height_38"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/spacing_20"
                    app:column_header_height="@dimen/height_42"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_report_type"
                    app:row_header_width="@dimen/width_160"
                    app:selected_color="@color/transparent"
                    app:unselected_color="@color/transparent"/>
                <include
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/ll_error_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_report_type"
                    layout="@layout/comp_company_error_state"/>
                <include
                    android:id="@+id/layout_empty_chart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    layout="@layout/comp_empty_charty"/>
            </ViewFlipper>
            <ImageView
                android:id="@+id/iv_blurry_financials"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="?attr/themeBackgroundBlurryFinancial"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_switch_financial_content"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <ViewStub
        android:id="@+id/vs_blurry_financial"
        android:visibility="gone"
        android:layout="@layout/comp_blurry_company_financial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
