<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:tag="layout/comp_empty_data_trading_portfolio_main_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_empty_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32"
        android:layout_marginBottom="@dimen/item_gap_32"
        android:src="?attr/themeIconEmptyPortfolio"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_title_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_s"
        android:text="@string/lbl_portfolio_empty"
        android:textAlignment="gravity"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="center"
        android:id="@+id/tv_subtitle_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/empty_portfolio_desc"
        android:textAlignment="gravity"
        style="@style/TypeStyles.BodySmall"/>
    <com.stockbit.uikit.buttons.EllipseButton
        android:textSize="@dimen/default_text_size"
        android:layout_gravity="center"
        android:id="@+id/add_empty_btn"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32"
        android:text="@string/empty_button_portfolio_topup"/>
</LinearLayout>
