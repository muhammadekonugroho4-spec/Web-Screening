<?xml version="1.0" encoding="utf-8"?>
<merge>
    <com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
        android:paddingBottom="@dimen/item_gap_l"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/vRatingTitle"
                android:background="@drawable/bg_rounded_gray"
                android:layout_width="@dimen/width_162"
                android:layout_height="@dimen/item_gap_10"
                android:layout_marginTop="@dimen/item_gap_34"
                android:layout_marginStart="@dimen/item_gap_20"
                android:backgroundTint="?attr/themeSeparatorGapColor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/vAction"
                android:background="@drawable/ic_circle_grey"
                android:layout_width="@dimen/clickable_size_72"
                android:layout_height="@dimen/clickable_size_72"
                android:layout_marginTop="@dimen/item_gap_29"
                android:layout_marginStart="@dimen/item_gap_32"
                android:backgroundTint="?attr/themeSeparatorGapColor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vRatingTitle"/>
            <View
                android:id="@+id/vBarBuy"
                android:background="@drawable/bg_rounded_gray"
                android:layout_width="@dimen/width_162"
                android:layout_height="@dimen/item_gap_10"
                android:layout_marginTop="@dimen/item_gap_5"
                android:layout_marginStart="@dimen/item_gap_24"
                android:backgroundTint="?attr/themeSeparatorGapColor"
                app:layout_constraintBottom_toTopOf="@+id/vBarHold"
                app:layout_constraintStart_toEndOf="@+id/vAction"
                app:layout_constraintTop_toTopOf="@+id/vAction"
                app:layout_constraintVertical_chainStyle="spread_inside"/>
            <View
                android:id="@+id/vBarHold"
                android:background="@drawable/bg_rounded_gray"
                android:layout_width="@dimen/width_162"
                android:layout_height="@dimen/item_gap_10"
                android:layout_marginStart="@dimen/item_gap_24"
                android:backgroundTint="?attr/themeSeparatorGapColor"
                app:layout_constraintBottom_toTopOf="@+id/vBarSell"
                app:layout_constraintStart_toEndOf="@+id/vAction"
                app:layout_constraintTop_toBottomOf="@+id/vBarBuy"/>
            <View
                android:id="@+id/vBarSell"
                android:background="@drawable/bg_rounded_gray"
                android:layout_width="@dimen/width_162"
                android:layout_height="@dimen/item_gap_10"
                android:layout_marginBottom="@dimen/item_gap_5"
                android:layout_marginStart="@dimen/item_gap_24"
                android:backgroundTint="?attr/themeSeparatorGapColor"
                app:layout_constraintBottom_toBottomOf="@+id/vAction"
                app:layout_constraintStart_toEndOf="@+id/vAction"
                app:layout_constraintTop_toBottomOf="@+id/vBarHold"/>
            <View
                android:id="@+id/vDivider"
                android:background="@drawable/bg_rounded_gray"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_4"
                android:layout_marginTop="@dimen/item_gap_32"
                android:backgroundTint="?attr/themeSeparatorGapColor"
                app:layout_constraintTop_toBottomOf="@+id/vAction"/>
            <View
                android:id="@+id/vPriceTargetTitle"
                android:background="@drawable/bg_rounded_gray"
                android:layout_width="@dimen/width_162"
                android:layout_height="@dimen/text_size_10"
                android:layout_marginTop="@dimen/item_gap_34"
                android:layout_marginStart="@dimen/item_gap_20"
                android:backgroundTint="?attr/themeSeparatorGapColor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vDivider"/>
            <View
                android:id="@+id/vPriceTargetSubtitle0"
                android:background="@drawable/bg_rounded_gray"
                android:layout_width="290dp"
                android:layout_height="@dimen/text_size_10"
                android:layout_marginTop="@dimen/item_gap_24"
                android:layout_marginStart="@dimen/item_gap_20"
                android:backgroundTint="?attr/themeSeparatorGapColor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vPriceTargetTitle"/>
            <View
                android:id="@+id/vPriceTargetSubtitle1"
                android:background="@drawable/bg_rounded_gray"
                android:layout_width="179dp"
                android:layout_height="@dimen/text_size_10"
                android:layout_marginTop="@dimen/item_gap_8"
                android:layout_marginStart="@dimen/item_gap_20"
                android:backgroundTint="?attr/themeSeparatorGapColor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/vPriceTargetSubtitle0"/>
            <View
                android:id="@+id/vPriceTarget"
                android:background="@drawable/bg_rounded_gray"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_50"
                android:layout_marginTop="@dimen/clickable_size_48"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20"
                android:backgroundTint="?attr/themeSeparatorGapColor"
                app:layout_constraintTop_toBottomOf="@+id/vPriceTargetSubtitle1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
</merge>
