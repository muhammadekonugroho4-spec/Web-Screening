<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_container"
    android:tag="layout/item_file_upload_0"
    android:background="?attr/themePrimaryDark"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/aciv_content"
        android:tag="binding_1"
        android:layout_width="@dimen/item_gap_40"
        android:layout_height="@dimen/item_gap_40"
        android:layout_marginBottom="@dimen/item_gap_8"
        android:scaleType="centerCrop"
        android:adjustViewBounds="true"
        app:cardCornerRadius="@dimen/item_gap_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/actv_desc"
        android:tag="binding_2"
        android:background="@drawable/bg_rounded_component"
        android:paddingTop="@dimen/item_gap_xxs"
        android:paddingBottom="@dimen/item_gap_xxs"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:paddingStart="@dimen/item_gap_15"
        android:paddingEnd="@dimen/item_gap_15"
        android:layout_marginStart="@dimen/item_gap_16"
        android:layout_marginEnd="@dimen/item_gap_16"
        app:layout_constraintBottom_toBottomOf="@+id/aciv_content"
        app:layout_constraintEnd_toStartOf="@+id/ib_close"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/aciv_content"
        app:layout_constraintTop_toTopOf="@+id/aciv_content"
        style="@style/SbTextView.Caption.Highempasis"/>
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/ib_close"
        android:tag="binding_3"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="@dimen/item_gap_15"
        android:layout_height="@dimen/item_gap_15"
        android:scaleType="fitXY"
        android:contentDescription="@string/hint_close"
        app:layout_constraintBottom_toBottomOf="@+id/actv_desc"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/actv_desc"
        app:srcCompat="?attr/themeCloseCircle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
