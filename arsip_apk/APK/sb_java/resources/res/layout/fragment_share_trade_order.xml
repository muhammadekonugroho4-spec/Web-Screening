<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_share_trade_order_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stockbit.uikit.topbar.TopbarStockbitTitle
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:topBarTitleTitle="@string/text_share_trade_order_toolbar_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_target_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topbar">
        <ViewFlipper
            android:id="@+id/vf_target_list_initial"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:id="@+id/banner_share_trade_order"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    layout="@layout/comp_banner_share_trade_order"/>
                <include
                    android:id="@+id/search_share_trade_order"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_16"
                    android:layout_marginHorizontal="@dimen/spacing_20"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/banner_share_trade_order"
                    layout="@layout/comp_search_share_trade_order"/>
                <TextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:id="@+id/tv_title_share_to"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:text="@string/text_share_trade_order_target_list_title"
                    android:layout_marginHorizontal="@dimen/spacing_20"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/search_share_trade_order"
                    style="@style/TypeStyles.HeadingRegular"/>
                <ViewFlipper
                    android:id="@+id/vf_target_list_searching"
                    android:tag="binding_3"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/item_gap_20"
                    app:layout_constraintBottom_toTopOf="@+id/cl_share_now"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title_share_to">
                    <androidx.recyclerview.widget.RecyclerView
                        android:orientation="vertical"
                        android:id="@+id/rv_auto_share"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:tag="binding_4"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <include
                            android:id="@+id/error_target_list_searching"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            layout="@layout/comp_error_state_target_list_searching"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:tag="binding_5"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <include
                            android:id="@+id/empty_target_list_searching"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            layout="@layout/comp_empty_state_target_list_searching"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </ViewFlipper>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_share_now"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                    <com.stockbit.uikit.divider.SBDivider
                        android:id="@+id/divider_share_now"
                        android:background="?attr/themeColorDividerThin"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/height_1"
                        android:layout_marginBottom="@dimen/spacing_20"
                        app:dividerVariant="thin_grey"
                        app:layout_constraintBottom_toTopOf="@+id/cl_add_to_auto_share"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_add_to_auto_share"
                        android:visibility="visible"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_20"
                        app:layout_constraintBottom_toTopOf="@+id/btn_share_trade_order"
                        app:layout_constraintEnd_toEndOf="@+id/btn_share_trade_order"
                        app:layout_constraintStart_toStartOf="@+id/btn_share_trade_order">
                        <TextView
                            android:textColor="?attr/themeColorTextPrimary"
                            android:ellipsize="end"
                            android:id="@+id/tv_also_add_to_auto_share_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/text_share_trade_order_add_to_auto_share_title"
                            android:layout_marginEnd="@dimen/spacing_12"
                            app:layout_constraintEnd_toStartOf="@+id/cts_add_to_auto_share"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/TypeStyles.BodyRegular"/>
                        <TextView
                            android:textColor="?attr/themeColorTextSecondary"
                            android:ellipsize="end"
                            android:id="@+id/tv_also_add_to_auto_share_subtitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_2"
                            android:text="@string/text_share_trade_order_add_to_auto_share_subtitle"
                            android:layout_marginEnd="@dimen/spacing_12"
                            app:layout_constraintEnd_toStartOf="@+id/cts_add_to_auto_share"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_also_add_to_auto_share_title"
                            style="@style/TypeStyles.BodySmall"/>
                        <com.stockbit.uikit.control.ControlToggleSwitch
                            android:id="@+id/cts_add_to_auto_share"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:switchType="Large"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <com.stockbit.uikit.button.PrimaryButton
                        android:id="@+id/btn_share_trade_order"
                        android:tag="binding_6"
                        android:background="@drawable/bg_selector_btn_green"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_20"
                        android:text="@string/text_share_trade_order_button_share_now"
                        android:layout_marginHorizontal="@dimen/spacing_20"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ProgressBar
                    android:id="@+id/pb_loading_target_list_initial"
                    android:layout_width="@dimen/width_48"
                    android:layout_height="@dimen/height_48"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:tag="binding_7"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:id="@+id/error_target_list_initial"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    layout="@layout/comp_error_state_target_list_initial"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:tag="binding_8"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:id="@+id/empty_target_list_initial"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    layout="@layout/comp_empty_state_target_list_initial"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ViewFlipper>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
