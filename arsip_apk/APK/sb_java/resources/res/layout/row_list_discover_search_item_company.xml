<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/row_list_discover_search_item_company_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv_search_all_company_layout_title"
        android:paddingTop="@dimen/item_gap_m"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        android:text="@string/company_title"
        android:textAlignment="gravity"
        android:paddingStart="@dimen/item_gap_l"
        android:paddingEnd="@dimen/item_gap_l"
        style="@style/TypeStyles.HeadlineRegular"/>
    <RelativeLayout
        android:id="@+id/rl_discover_item_company"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48">
        <ImageView
            android:id="@+id/iv_company_logo"
            android:layout_width="@dimen/icon_placeholder_24"
            android:layout_height="@dimen/icon_placeholder_24"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/item_gap_l"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_discover_search_item_company_name_company"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/iv_company_logo"
            android:textAlignment="gravity"
            android:paddingEnd="@dimen/item_gap_s"
            android:layout_marginStart="@dimen/spacing_8"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_discover_search_item_company_name_desc_company"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:maxLines="1"
            android:layout_toRightOf="@+id/tv_discover_search_item_company_name_company"
            android:textAlignment="gravity"
            android:paddingStart="@dimen/item_gap_s"
            android:paddingEnd="@dimen/item_gap_l"
            style="@style/TypeStyles.BodyRegular"/>
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</LinearLayout>
