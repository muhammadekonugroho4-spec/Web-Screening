<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_camera_masking_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:scaleType="fitCenter"/>
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_background_ktp"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_header_bg">
        <View
            android:id="@+id/view_top"
            android:background="@color/background_grey_45"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/iv_mask_ktp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_mask_ktp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:src="@drawable/ic_mask_ktp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="856:539"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_bottom"
            android:background="@color/background_grey_45"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_mask_ktp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/v_background_selfie"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ic_exclude_selfie"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_header_bg"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/v_background_selfie_2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_0"
        android:src="@drawable/ic_exclude_2"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@+id/ll_camera_controller"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_header_bg"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/view_short"
        android:background="#99000000"
        android:visibility="gone"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_ktp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/ic_ktp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/preview_view"
        app:layout_constraintDimensionRatio="856:539"
        app:layout_constraintEnd_toEndOf="@+id/preview_view"
        app:layout_constraintStart_toStartOf="@+id/preview_view"
        app:layout_constraintTop_toTopOf="@+id/preview_view"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_camera_controller"
        android:background="#99000000"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_ktp_warning"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:layout_marginBottom="@dimen/item_gap_10"
            android:text="@string/text_ktp_photo_instruction_two"
            android:layout_marginHorizontal="@dimen/item_gap_20"
            app:layout_constraintBottom_toTopOf="@+id/llActionCamera"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/SbTextView.BodyDefault.Bold"/>
        <TextView
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_ktp_selfie_warning"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:layout_marginBottom="@dimen/item_gap_10"
            android:text="@string/oa_ktp_selfie_warning"
            android:layout_marginHorizontal="@dimen/item_gap_20"
            app:layout_constraintBottom_toTopOf="@+id/llActionCamera"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/SbTextView.BodyDefault.Bold"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llActionCamera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:id="@+id/ll_gallery"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/aciv_gallery"
                    android:tag="binding_1"
                    android:layout_width="37dp"
                    android:layout_height="37dp"
                    app:civ_border_color="#ffffff"
                    app:civ_border_width="2dp"/>
                <ImageButton
                    android:id="@+id/camera_torch_button_bottom"
                    android:tag="binding_2"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_width="@dimen/clickable_size_32"
                    android:layout_height="@dimen/clickable_size_32"
                    android:src="@drawable/ic_flash_off"
                    android:scaleType="centerCrop"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/aciv_take"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/clickable_size_64"
                    android:src="@drawable/ic_btn_camera"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/aciv_flip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/clickable_size_64"
                    android:src="@drawable/ic_camera_flip"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/pb_loading"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/preview_view"
        app:layout_constraintEnd_toEndOf="@+id/preview_view"
        app:layout_constraintStart_toStartOf="@+id/preview_view"
        app:layout_constraintTop_toTopOf="@+id/preview_view"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_header_bg"
        android:background="@color/background_grey_45"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/aciv_back"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/clickable_size_18"
            android:layout_marginTop="@dimen/item_gap_18"
            android:layout_marginBottom="@dimen/item_gap_18"
            android:src="@drawable/back_toolbar"
            android:tint="@color/white"
            android:layout_marginStart="@dimen/item_gap_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageButton
            android:id="@+id/camera_torch_button"
            android:tag="binding_3"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_16"
            android:layout_marginBottom="@dimen/item_gap_16"
            android:src="@drawable/ic_flash_off"
            android:layout_marginEnd="@dimen/item_gap_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/white"
            android:id="@+id/tv_msg_camera"
            android:tag="binding_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/aciv_back"
            app:layout_constraintTop_toBottomOf="@+id/aciv_back"
            style="@style/SbTextView.ListTitle.Normal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
