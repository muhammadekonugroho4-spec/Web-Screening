<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/cl_container"
    android:tag="layout/dialog_portfolio_share_chat_0"
    android:background="@drawable/bg_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vgSharePostHeader"
        android:paddingBottom="@dimen/item_gap_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/viewSharePost"
            android:background="@drawable/bg_rounded_gray_gray_bg"
            android:layout_width="@dimen/clickable_size_56"
            android:layout_height="@dimen/item_gap_5"
            android:layout_marginTop="@dimen/item_gap_l"
            android:layout_centerHorizontal="true"
            android:alpha="0.5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.stockbit.common.uikit.StockbitSearchBar
        android:id="@+id/ssb_friend_search"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:stockbitSearchBarHint="@string/placeholder_search"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_5">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/actv_send_to"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_send_to"
            android:layout_marginStart="@dimen/item_gap_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SbTextView.ListTitle.Highempasis.Bold"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/titleTextColorHighgray"
            android:id="@+id/actv_user_count"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/item_gap_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SbTextView.ListSubtitle.Highempasis"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_user_to_share"
        android:tag="binding_3"
        android:paddingBottom="@dimen/item_gap_8"
        android:focusableInTouchMode="true"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/item_gap_5"
        android:layout_weight="1"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_compose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <View
            android:id="@+id/viewSepSharePostMainButton2"
            android:background="?attr/themeContentButtonBorder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_marginBottom="@dimen/clickable_size_16"
            app:layout_constraintBottom_toTopOf="@+id/etSharePostWriteComment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <androidx.appcompat.widget.AppCompatEditText
            android:gravity="center_vertical"
            android:id="@+id/etSharePostWriteComment"
            android:background="@drawable/bg_rounded_edit_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/clickable_size_16"
            android:layout_marginBottom="@dimen/clickable_size_16"
            android:minHeight="@dimen/avatar_size_default"
            android:hint="@string/hint_share_stream_post_message"
            android:maxLines="7"
            android:inputType="textNoSuggestions"
            android:imeOptions="actionDone"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:layout_marginStart="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/clickable_size_16"
            android:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/aciv_send"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/SbEditTextStyle.Medium"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/aciv_send"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/item_gap_20"
            app:layout_constraintBottom_toBottomOf="@+id/etSharePostWriteComment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/etSharePostWriteComment"
            app:srcCompat="@drawable/ic_send_plane"/>
        <ProgressBar
            android:id="@+id/pb_send_loading"
            android:visibility="gone"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:layout_marginEnd="@dimen/item_gap_24"
            app:layout_constraintBottom_toBottomOf="@+id/etSharePostWriteComment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/etSharePostWriteComment"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.LinearLayoutCompat>
