<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_yes_no_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/parent_base_bottom_sheet_dialog_header"
        android:background="@drawable/bg_top_rounded_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dialog_header_min_height"/>
    <RelativeLayout
        android:id="@+id/parent_base_bottom_sheet_dialog_body"
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/dialog_body_min_height"
        android:layout_below="@+id/parent_base_bottom_sheet_dialog_header">
        <View
            android:id="@+id/header_body"
            android:background="@drawable/bg_rounded_gray"
            android:layout_width="@dimen/header_body_width"
            android:layout_height="@dimen/header_body_height"
            android:layout_marginBottom="@dimen/header_body_margin_bottom"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="false"
            android:layout_marginStart="@dimen/header_body_margin_start"
            android:layout_marginEnd="@dimen/header_body_margin_end"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="center"
            android:id="@+id/tv_title"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tv_title_margin_top"
            android:layout_below="@+id/header_body"
            android:layout_marginStart="@dimen/tv_title_margin_start"
            android:layout_marginEnd="@dimen/tv_title_margin_end"
            style="@style/SbTextView.PageTitle.HighEmphasis.Bold"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/themeSemiMediumEmphasis"
            android:gravity="center"
            android:id="@+id/tv_message"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tv_message_margin_top"
            android:layout_below="@+id/tv_title"
            android:layout_marginStart="@dimen/tv_message_margin_start"
            android:layout_marginEnd="@dimen/tv_message_margin_end"
            style="@style/SbTextView.BodyDefault"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/btn_positive"
            android:tag="binding_3"
            android:background="@drawable/border_green_rounded"
            android:paddingTop="@dimen/btn_positive_padding_top"
            android:paddingBottom="@dimen/btn_positive_padding_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/btn_positive_margin_top"
            android:layout_below="@+id/tv_message"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/btn_positive_margin_start"
            android:layout_marginEnd="@dimen/btn_positive_margin_end"
            style="@style/SbTextView.Button.Regular"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textColor="@color/green_text"
            android:id="@+id/btn_negative"
            android:tag="binding_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/btn_negative_margin_top"
            android:layout_below="@+id/btn_positive"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:layout_marginStart="@dimen/btn_negative_margin_start"
            android:layout_marginEnd="@dimen/btn_negative_margin_end"
            style="@style/SbTextView.Button.Regular"/>
    </RelativeLayout>
</RelativeLayout>
