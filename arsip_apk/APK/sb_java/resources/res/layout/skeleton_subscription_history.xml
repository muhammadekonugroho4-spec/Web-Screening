<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sfl_subscription_history_list"
    android:tag="layout/skeleton_subscription_history_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/item_gap_51">
    <LinearLayout
        android:orientation="vertical"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:id="@+id/ll_shimmer_chip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/v_header_image"
                android:background="@drawable/bg_rounded_gray"
                android:layout_width="@dimen/width_200"
                android:layout_height="@dimen/height_200"
                app:layout_constraintDimensionRatio="w,4:3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/SBShimmerItem"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_date_subscription_history_skeleton"
                android:background="@drawable/bg_border_gray_rounded_outline"
                android:padding="@dimen/item_gap_16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_12"
                android:layout_marginHorizontal="@dimen/item_gap_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/v_header_image">
                <View
                    android:id="@+id/v_image_date"
                    android:background="@drawable/bg_rounded_gray"
                    android:layout_width="@dimen/height_50"
                    android:layout_height="@dimen/height_50"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="w,4:3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/SBShimmerItem"/>
                <View
                    android:id="@+id/v_text_date"
                    android:background="@drawable/bg_rounded_gray_radius_16"
                    android:layout_width="@dimen/spacing_0"
                    android:layout_height="@dimen/clickable_size_18"
                    android:layout_marginStart="@dimen/item_gap_16"
                    android:layout_marginEnd="@dimen/item_gap_36"
                    android:backgroundTint="?attr/themeShimmer"
                    android:layout_marginVertical="@dimen/spacing_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/v_image_date"
                    app:layout_constraintTop_toTopOf="parent"
                    style="@style/SBShimmerItem"/>
                <View
                    android:id="@+id/v_text_date_two"
                    android:background="@drawable/bg_rounded_gray_radius_16"
                    android:layout_width="@dimen/spacing_0"
                    android:layout_height="@dimen/clickable_size_18"
                    android:layout_marginStart="@dimen/item_gap_16"
                    android:layout_marginEnd="@dimen/item_gap_46"
                    android:backgroundTint="?attr/themeShimmer"
                    android:layout_marginVertical="@dimen/spacing_8"
                    app:layout_constraintEnd_toEndOf="@+id/v_text_date"
                    app:layout_constraintStart_toEndOf="@+id/v_image_date"
                    app:layout_constraintTop_toBottomOf="@+id/v_text_date"
                    style="@style/SBShimmerItem"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:background="@drawable/bg_rounded_gray_radius_16"
                android:layout_width="@dimen/width_150"
                android:layout_height="@dimen/clickable_size_18"
                android:layout_marginTop="@dimen/item_gap_46"
                android:layout_marginStart="@dimen/spacing_20"
                android:backgroundTint="?attr/themeShimmer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cl_date_subscription_history_skeleton"
                style="@style/SBShimmerItem"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include layout="@layout/item_skeleton_subscription_history"/>
        <include layout="@layout/item_skeleton_subscription_history"/>
        <include layout="@layout/item_skeleton_subscription_history"/>
        <include layout="@layout/item_skeleton_subscription_history"/>
        <include layout="@layout/item_skeleton_subscription_history"/>
        <include layout="@layout/item_skeleton_subscription_history"/>
    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
