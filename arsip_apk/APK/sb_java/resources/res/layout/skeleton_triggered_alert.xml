<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/clickable_size_68">
    <View
        android:id="@+id/view_symbol"
        android:layout_width="@dimen/spacing_40"
        android:layout_height="@dimen/spacing_20"
        android:layout_marginLeft="@dimen/spacing_16"
        android:layout_marginBottom="@dimen/spacing_2"
        app:layout_constraintBottom_toTopOf="@+id/view_company_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/FBShimmerItem"/>
    <View
        android:id="@+id/view_company_name"
        android:layout_width="140dp"
        android:layout_height="@dimen/spacing_12"
        android:layout_marginTop="@dimen/spacing_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/view_symbol"
        app:layout_constraintTop_toBottomOf="@+id/view_symbol"
        style="@style/FBShimmerItem"/>
    <View
        android:id="@+id/view_alert_price"
        android:layout_width="60dp"
        android:layout_height="@dimen/spacing_20"
        android:layout_marginBottom="@dimen/spacing_2"
        android:layout_marginEnd="@dimen/spacing_20"
        app:layout_constraintBottom_toTopOf="@+id/view_alert_date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/FBShimmerItem"/>
    <View
        android:id="@+id/view_alert_date"
        android:layout_width="100dp"
        android:layout_height="@dimen/spacing_12"
        android:layout_marginTop="@dimen/spacing_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/view_alert_price"
        app:layout_constraintTop_toBottomOf="@+id/view_alert_price"
        style="@style/FBShimmerItem"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/uikit_divider_thin"
        app:layout_constraintBottom_toBottomOf="parent"
        style="@style/FBShimmerItem"/>
</androidx.constraintlayout.widget.ConstraintLayout>
