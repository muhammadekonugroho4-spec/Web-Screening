<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:tag="layout/row_keystats_filter_option_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/item_gap_5">
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/rv_keyStats_filter"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:nestedScrollingEnabled="false"
        android:paddingHorizontal="@dimen/item_gap_20"
        android:paddingVertical="@dimen/item_gap_8"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:paddingEnd="@dimen/item_gap_20">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_arrow_prev"
            android:layout_width="@dimen/width_20"
            android:layout_height="@dimen/height_20"
            android:rotation="180"
            android:layout_marginEnd="@dimen/item_gap_14"
            app:srcCompat="@drawable/ic_keystats_arrow"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_arrow_next"
            android:layout_width="@dimen/width_20"
            android:layout_height="@dimen/height_20"
            app:srcCompat="@drawable/ic_keystats_arrow"/>
    </LinearLayout>
</LinearLayout>
