<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/width_64"
    android:layout_height="@dimen/height_48">
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/ib_menu_view_notification_badge_icon"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="?attr/themeIconTintColor"
        android:contentDescription="@string/lbl_notification"
        android:layout_marginStart="@dimen/item_gap_16"
        app:srcCompat="@drawable/ic_android_notification"/>
    <ImageView
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/iv_menu_view_notification_badge_dot"
        android:visibility="gone"
        android:layout_width="@dimen/item_gap_s"
        android:layout_height="@dimen/item_gap_s"
        android:layout_marginBottom="@dimen/item_gap_xs"
        android:src="@drawable/bg_circle"
        android:tint="@color/red_item"/>
    <TextView
        android:textSize="@dimen/text_size_9"
        android:textStyle="normal"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_gravity="start"
        android:id="@+id/tv_menu_view_notification_badge_counter"
        android:background="@drawable/action_item_badge"
        android:paddingLeft="@dimen/item_gap_xs"
        android:paddingRight="@dimen/item_gap_xs"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_28"
        android:layout_marginTop="@dimen/item_gap_7"
        android:minWidth="@dimen/item_gap_l"
        android:minHeight="@dimen/item_gap_l"
        android:maxLines="1"
        style="@style/SbTextView.BadgeText"/>
</FrameLayout>
