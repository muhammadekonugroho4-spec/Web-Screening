<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/comp_liveness_success_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/spacing_20">
        <ImageView
            android:layout_width="@dimen/width_160"
            android:layout_height="@dimen/height_120"
            android:layout_marginBottom="@dimen/spacing_20"
            android:src="?attr/themeIconSuccessAmendBank"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_12"
            android:text="@string/title_liveness_test_success"
            style="@style/TypeStyles.HeadlineRegular"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_liveness_success_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/TypeStyles.BodyRegular"/>
    </LinearLayout>
    <com.stockbit.uikit.button.PrimaryButton
        android:id="@+id/btnBackToHompegae"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        android:layout_margin="@dimen/spacing_20"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:text="@string/button_back_homepage"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
