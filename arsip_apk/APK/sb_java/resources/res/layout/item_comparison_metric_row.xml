<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_comparison_metric_row_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:id="@+id/tv_metric_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_26"
        android:layout_marginStart="@dimen/item_gap_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodySmall"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_metric_values"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        android:layout_marginHorizontal="@dimen/item_gap_14"
        app:layout_constraintTop_toBottomOf="@+id/tv_metric_name">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_metric_value_1"
            android:layout_width="0dp"
            android:layout_height="@dimen/text_size_30"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/item_gap_6">
            <TextView
                android:textColor="?attr/themeColorTextPrimary"
                android:gravity="center"
                android:id="@+id/tv_metric_value_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.BodySmall"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_metric_value_2"
            android:layout_width="0dp"
            android:layout_height="@dimen/text_size_30"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/item_gap_6">
            <TextView
                android:textColor="?attr/themeColorTextPrimary"
                android:gravity="center"
                android:id="@+id/tv_metric_value_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.BodySmall"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_metric_value_3"
            android:layout_width="0dp"
            android:layout_height="@dimen/text_size_30"
            android:layout_weight="1"
            android:layout_marginHorizontal="@dimen/item_gap_6">
            <TextView
                android:textColor="?attr/themeColorTextPrimary"
                android:gravity="center"
                android:id="@+id/tv_metric_value_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.BodySmall"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <View
        android:id="@+id/v_separator_metric_group"
        android:background="?attr/themeSeparatorGapColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_26"
        app:layout_constraintTop_toBottomOf="@+id/ll_metric_values"/>
</androidx.constraintlayout.widget.ConstraintLayout>
