<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/srl_search_company"
    android:tag="layout/fragment_search_company_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:tag="binding_1"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.stockbit.uikit.topbar.TopBarStockbitSearch
            android:id="@+id/top_bar_stockbit_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:topBarSearchQueryHint="@string/search_stock"
            app:topBarSearchSuffixIcon="?attr/themeCloseCircle"
            app:topBarSearchVariant="container_fill"/>
        <FrameLayout
            android:id="@+id/fl_recent_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_bar_stockbit_search"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_company_search"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_bar_stockbit_search"/>
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="@dimen/clickable_size_32"
            android:layout_height="@dimen/clickable_size_32"
            android:indeterminate="true"
            android:layout_centerInParent="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.AppCompat.ProgressBar"/>
        <include
            android:layout_gravity="center"
            android:id="@+id/error_search_company"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/comp_icon_error_view"/>
        <include
            android:id="@+id/empty_search_company"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_bar_stockbit_search"
            layout="@layout/comp_empty_search"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_success_state"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="rv_company_search"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_loading_state"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="progress_bar"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_error_state"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="error_search_company"/>
        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_empty_state"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:constraint_referenced_ids="empty_search_company"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
