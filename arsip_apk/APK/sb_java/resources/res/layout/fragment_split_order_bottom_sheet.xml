<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/fragment_split_order_bottom_sheet_0"
    android:paddingBottom="@dimen/item_gap_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_12"
    android:layout_marginHorizontal="@dimen/spacing_20">
    <TextView
        android:id="@+id/tv_split_order_tooltip_desc"
        android:paddingBottom="@dimen/spacing_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tv_split_order_tooltip_desc"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_split_order_tooltip_quantity_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_split_order_tooltip_quantity_title"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:id="@+id/tv_split_order_tooltip_quantity_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:text="@string/tv_split_order_tooltip_quantity_desc"
        style="@style/TypeStyles.ParagraphRegular"/>
    <TextView
        android:id="@+id/tv_split_order_tooltip_range_lot_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_16"
        android:text="@string/tv_split_order_tooltip_range_lot_title"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:id="@+id/tv_split_order_tooltip_range_lot_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tv_split_order_tooltip_range_lot_desc"
        style="@style/TypeStyles.ParagraphRegular"/>
</LinearLayout>
