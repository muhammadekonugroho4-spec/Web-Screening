<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ml_contrainer"
    android:tag="layout/fragment_search_group_members_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_icon_toolbar"
        android:tag="binding_1"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/item_gap_8"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/back_toolbar"
        android:layout_marginStart="@dimen/item_gap_16"
        app:layout_constraintBottom_toBottomOf="@+id/gl_toolbar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.stockbit.common.uikit.StockbitSearchBar
        android:id="@+id/ssb_search"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/item_gap_16"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon_toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_icon_toolbar"
        app:layout_constraintTop_toTopOf="@+id/iv_icon_toolbar"
        app:stockbitSearchBarHint="@string/hint_search"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/gl_toolbar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="56dp"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_group_member"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/item_gap_8"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gl_toolbar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
