<?xml version="1.0" encoding="utf-8"?>
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vf_root"
    android:tag="layout/item_company_corpaction_stock_conversion_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:measureAllChildren="false">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        android:layout_marginVertical="@dimen/item_gap_20">
        <TextView
            android:textColor="?attr/themeColorTextGreen"
            android:gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_corp_action_warrant_conversion"
            android:contentDescription="@string/CORP_ACT_14"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingRegular"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16">
            <TextView
                android:layout_gravity="center_vertical"
                android:layout_width="@dimen/conversion_rec_date_width"
                android:layout_height="wrap_content"
                android:text="@string/title_stock_conversion_rec_date"
                android:contentDescription="@string/CORP_ACT_15"
                style="@style/TypeStyles.HeadingRegular"/>
            <TextView
                android:gravity="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_header_conv_number"
                android:layout_width="@dimen/width_80"
                android:layout_height="wrap_content"
                android:text="@string/title_stock_conversion_conv_number"
                android:contentDescription="@string/CORP_ACT_16"
                android:layout_marginStart="@dimen/conversion_conv_number_margin_start"
                style="@style/TypeStyles.HeadingRegular"/>
            <TextView
                android:gravity="end"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_header_remaining_conv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/title_stock_conversion_remaining_conv"
                android:layout_weight="1"
                android:contentDescription="@string/CORP_ACT_17"
                android:layout_marginStart="@dimen/conversion_gap"
                style="@style/TypeStyles.HeadingRegular"/>
            <TextView
                android:gravity="end"
                android:layout_gravity="center_vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/title_stock_conversion_stock_sum_after_conv"
                android:layout_weight="1"
                android:contentDescription="@string/CORP_ACT_18"
                android:layout_marginStart="@dimen/conversion_gap"
                style="@style/TypeStyles.HeadingRegular"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llItemRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/ivExpandCollapse"
            android:padding="@dimen/item_gap_3"
            android:layout_width="@dimen/width_20"
            android:layout_height="@dimen/height_20"
            android:layout_marginTop="@dimen/item_gap_35"
            android:src="0x7f080612"
            android:contentDescription="@string/CORP_ACT_23"
            app:tint="?attr/themeColorTextGreen"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        android:layout_marginVertical="@dimen/item_gap_20">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="@dimen/width_160"
            android:layout_height="@dimen/height_120"
            android:src="?attr/themeIconEmptyTable"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_load_error"
            style="@style/TypeStyles.BodyRegular"/>
        <com.stockbit.uikit.buttons.EllipseButton
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_reload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_41"
            android:text="@string/text_reload"
            android:paddingHorizontal="@dimen/item_gap_32"/>
    </LinearLayout>
</ViewFlipper>
