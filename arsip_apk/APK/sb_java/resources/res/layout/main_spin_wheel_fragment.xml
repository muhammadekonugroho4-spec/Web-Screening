<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/containerParent"
    android:tag="layout/main_spin_wheel_fragment_0"
    android:background="?attr/themeContentBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/imageViewCursor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/height_220"
        android:elevation="@dimen/item_gap_xxs"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_cursor_spinner"/>
    <com.stockbit.referral.ui.spinningwheel.SpinningWheelConstructorView
        android:id="@+id/luckyWheel"
        android:layout_width="@dimen/height_767"
        android:layout_height="@dimen/height_767"
        android:layout_marginBottom="@dimen/item_gap_20"
        app:layout_constraintBottom_toTopOf="@+id/scrollContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.501"
        app:layout_constraintStart_toStartOf="parent"
        app:lkwBackgroundColor="@color/background_green_dark"
        app:lkwSecondaryTextSize="@dimen/text_size_35"
        app:lkwTopTextPadding="@dimen/item_gap_null"/>
    <ScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_null"
        app:layout_constraintBottom_toTopOf="@+id/gap"
        app:layout_constraintTop_toBottomOf="@+id/imageViewCursor">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/imageViewGift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_24"
                android:layout_marginBottom="@dimen/item_gap_16"
                app:srcCompat="@drawable/ic_gift_referral"/>
            <TextView
                android:textSize="@dimen/text_size_19"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/textViewSpinnerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/item_gap_30"
                android:text="@string/kode_referral_spinner_title"
                android:textAlignment="gravity"
                style="@style/SbTextView.ListTitle"/>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/linearLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/item_gap_16">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_coupon"/>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:id="@+id/textViewCouponDetail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/item_gap_4"
                    style="@style/SbTextView.BodyDefault"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/containerSelectCoupon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/item_gap_22">
                <TextView
                    android:textSize="@dimen/text_size_18"
                    android:textColor="@color/green_text"
                    android:gravity="center"
                    android:id="@+id/buttonDecreaseCoupon"
                    android:background="@drawable/border_gray_rounded_outline"
                    android:layout_width="@dimen/height_40"
                    android:layout_height="@dimen/height_36"
                    android:text="@string/kode_referral_button_decrease_coupon"
                    style="@style/SbTextView.ListTitle"/>
                <TextView
                    android:textStyle="normal"
                    android:gravity="center"
                    android:id="@+id/textViewCoupon"
                    android:background="@drawable/border_gray_rounded_outline"
                    android:layout_width="@dimen/height_84"
                    android:layout_height="@dimen/item_gap_36"
                    android:text="0"
                    android:layout_marginStart="@dimen/item_gap_14"
                    android:layout_marginEnd="@dimen/item_gap_14"
                    style="@style/SbTextView.ListTitle"/>
                <TextView
                    android:textSize="@dimen/text_size_18"
                    android:textColor="@color/color_enabled_disable_green"
                    android:gravity="center"
                    android:id="@+id/buttonIncreaseCoupon"
                    android:background="@drawable/btn_gray_rounded_outline"
                    android:layout_width="@dimen/height_40"
                    android:layout_height="@dimen/height_36"
                    android:text="@string/kode_referral_button_increase_coupon"
                    style="@style/SbTextView.ListTitle"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:id="@+id/containerTakeAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/item_gap_36">
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:layout_gravity="center"
                    android:id="@+id/checkTakeAll"
                    android:layout_width="@dimen/clickable_size_16"
                    android:layout_height="@dimen/clickable_size_16"
                    android:checked="true"
                    android:button="@drawable/bg_checkbox_square"/>
                <TextView
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kode_referral_check_take_all_coupon"
                    android:layout_marginStart="@dimen/item_gap_4"
                    style="@style/SbTextView.BodyDefault"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:id="@+id/containerAgreement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/item_gap_24">
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:layout_gravity="center"
                    android:id="@+id/checkAgreement"
                    android:layout_width="@dimen/clickable_size_16"
                    android:layout_height="@dimen/clickable_size_16"
                    android:checked="false"
                    android:button="@drawable/bg_checkbox_square"/>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:id="@+id/buttonAgreement"
                    android:paddingBottom="@dimen/item_gap_8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kode_referral_perjanjian"
                    android:layout_marginStart="@dimen/item_gap_12"
                    style="@style/SbTextView.BodyDefault"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <View
        android:id="@+id/gap"
        android:background="?attr/separatorColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxs"
        android:layout_marginBottom="@dimen/item_gap_15"
        app:layout_constraintBottom_toTopOf="@+id/buttonMain"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/editTextTextReferralCode"/>
    <Button
        android:enabled="false"
        android:id="@+id/buttonMain"
        android:background="@drawable/btn_green_enabled"
        android:layout_marginBottom="@dimen/item_gap_20"
        android:text="@string/kode_referral_button_main_spinner"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="@dimen/height_24"
        android:layout_marginEnd="@dimen/height_24"
        app:layout_constraintBottom_toTopOf="@+id/buttonCancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/SbBtn.PrimaryFullWidthFloating"/>
    <TextView
        android:textColor="@color/green_text"
        android:id="@+id/buttonCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_24"
        android:text="@string/kode_referral_button_cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/buttonMain"
        app:layout_constraintStart_toStartOf="@+id/buttonMain"
        style="@style/SbTextView.ListTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
