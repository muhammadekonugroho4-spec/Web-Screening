<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_container"
    android:tag="layout/item_share_trade_order_group_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_16"
    android:paddingVertical="@dimen/spacing_6">
    <ImageView
        android:id="@+id/iv_group_avatar"
        android:tag="binding_1"
        android:layout_width="@dimen/avatar_size_default"
        android:layout_height="@dimen/avatar_size_default"
        android:contentDescription="@string/hint_user_avatar_image"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/s_center"
        android:layout_width="0dp"
        android:layout_height="@dimen/spacing_2"
        app:layout_constraintBottom_toBottomOf="@+id/iv_group_avatar"
        app:layout_constraintEnd_toStartOf="@+id/cb_auto_share"
        app:layout_constraintStart_toEndOf="@+id/iv_group_avatar"
        app:layout_constraintTop_toTopOf="@+id/iv_group_avatar"/>
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:ellipsize="end"
        android:id="@+id/tv_group_name"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/spacing_12"
        android:layout_marginEnd="@dimen/spacing_8"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/s_center"
        app:layout_constraintEnd_toStartOf="@+id/cb_auto_share"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/iv_group_avatar"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:ellipsize="end"
        android:id="@+id/tv_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/spacing_8"
        app:layout_constrainedWidth="true"
        app:layout_constraintEnd_toStartOf="@+id/cb_auto_share"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tv_group_name"
        app:layout_constraintTop_toBottomOf="@+id/s_center"
        style="@style/TypeStyles.BodyXSmall"/>
    <View
        android:id="@+id/v_clickable_share_value"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/share_trade_margin_bottom_click_area_share_value"
        app:layout_constraintBottom_toBottomOf="@+id/tv_share_value"
        app:layout_constraintEnd_toEndOf="@+id/tv_share_value"
        app:layout_constraintStart_toStartOf="@+id/tv_share_value"
        app:layout_constraintTop_toBottomOf="@+id/tv_group_name"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorTextSecondary"
        android:id="@+id/tv_share_value"
        android:tag="binding_3"
        android:background="@drawable/share_trade_bg_rounded_4_surface_variant"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/spacing_4"
        android:layout_marginEnd="@dimen/spacing_8"
        android:paddingHorizontal="@dimen/spacing_4"
        android:paddingVertical="@dimen/spacing_2"
        app:layout_constraintEnd_toStartOf="@+id/cb_auto_share"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/tv_group_name"
        app:layout_constraintTop_toBottomOf="@+id/s_center"
        style="@style/TypeStyles.BodyXSmall"/>
    <com.stockbit.uikit.control.ControlCheckbox
        android:id="@+id/cb_auto_share"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="@dimen/clickable_size_24"
        android:layout_height="@dimen/clickable_size_24"
        app:checkBoxType="round"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
