<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/fragment_error_otp_dialog_0"
    android:padding="@dimen/spacing_20"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_20"
        android:src="?attr/themeIconLimitRetryOtp"/>
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:gravity="center"
        android:id="@+id/tv_content_title"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_12"
        android:lineSpacingExtra="2sp"
        android:translationY="-1.19sp"
        android:lineHeight="24sp"
        style="@style/TypeStyles.HeadlineRegular"/>
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:gravity="center"
        android:id="@+id/tv_content_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_12"
        android:text="@string/msg_try_again_otp_limit"
        android:lineSpacingExtra="2sp"
        android:translationY="-0.97sp"
        style="@style/TypeStyles.BodyRegular"/>
</LinearLayout>
