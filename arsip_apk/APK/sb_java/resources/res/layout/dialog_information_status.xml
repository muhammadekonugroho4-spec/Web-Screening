<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_information_status_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_top_rounded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/v_handle"
            android:background="@drawable/bg_rounded_gray"
            android:layout_width="@dimen/clickable_size_64"
            android:layout_height="@dimen/item_gap_4"
            android:alpha="0.6"
            android:layout_marginVertical="@dimen/item_gap_16"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_status_logo"
            android:tag="binding_1"
            android:layout_width="@dimen/width_180"
            android:layout_height="135dp"
            android:layout_marginBottom="@dimen/item_gap_20"/>
        <TextView
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/item_gap_8"
            android:layout_marginHorizontal="@dimen/clickable_size_48"
            style="@style/SbTextView.ListTitle"/>
        <TextView
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_dialog_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/item_gap_20"
            android:textAlignment="center"
            android:layout_marginHorizontal="@dimen/item_gap_20"
            style="@style/SbTextView.ListTitle.Highempasis.Normal"/>
        <Button
            android:textColor="?attr/themeContentTextColor"
            android:id="@+id/btn_information_status"
            android:background="@drawable/border_green_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/item_gap_32"
            android:foreground="?attr/selectableItemBackground"
            android:backgroundTint="?attr/titleTextColorDowngray"
            android:layout_marginHorizontal="@dimen/item_gap_20"
            style="@style/SbBtnBorderless"/>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
