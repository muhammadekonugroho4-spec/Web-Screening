<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_company_profile_0"
    android:background="?attr/themeContentBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ViewFlipper
        android:id="@+id/vf_company_profile"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/sfl_company_profile_loading"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/skeleton_company_profile_item"/>
        </com.facebook.shimmer.ShimmerFrameLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsv_main_layout"
            android:paddingBottom="@dimen/item_gap_40"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <include
                    android:id="@+id/comp_company_overview"
                    layout="@layout/comp_company_profile_overview"/>
                <include
                    android:id="@+id/comp_company_shareholder_percentage"
                    layout="@layout/comp_company_profile_shareholder_percentage"/>
                <include
                    android:id="@+id/comp_company_directors_commissioners"
                    layout="@layout/comp_company_profile_directors_and_commissioners"/>
                <include
                    android:id="@+id/comp_company_ultimate_benneficiary_owner"
                    layout="@layout/comp_company_profile_beneficiary"/>
                <include
                    android:id="@+id/comp_company_shareholder_number"
                    layout="@layout/comp_company_profile_shareholder_number"/>
                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/cv_shareholder_composition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <View
                    android:id="@+id/v_shareholder_number_separator"
                    android:background="?attr/themeColorDividerThick"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/item_gap_8"
                    app:layout_constraintTop_toBottomOf="@+id/vf_shareholder_composition_chart"
                    app:layout_goneMarginTop="@dimen/item_gap_16"/>
                <include
                    android:id="@+id/comp_company_holding_composition"
                    layout="@layout/comp_company_profile_holding_composition"/>
                <include
                    android:id="@+id/comp_company_board_directors"
                    layout="@layout/comp_company_profile_board_directors"/>
                <include
                    android:id="@+id/comp_company_board_commissioner"
                    layout="@layout/comp_company_profile_board_commissioner"/>
                <include
                    android:id="@+id/comp_company_subsidiary_companies"
                    layout="@layout/comp_company_profile_subsidiary"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <RelativeLayout
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/item_gap_40">
            <TextView
                android:id="@+id/tv_company_profile_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/msg_loading_alert_company_info_error"
                android:layout_centerHorizontal="true"
                style="@style/SbTextView.BodyDefault"/>
            <Button
                android:id="@+id/btn_company_profile_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_10"
                android:text="@string/btn_click_to_refresh"
                android:layout_below="@+id/tv_company_profile_error"
                android:layout_centerHorizontal="true"
                style="@style/SbBtnBorderless.Small"/>
        </RelativeLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsc_company_profile_empty"
            android:tag="binding_4"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include layout="@layout/comp_company_profile_empty"/>
        </androidx.core.widget.NestedScrollView>
    </ViewFlipper>
    <ViewStub
        android:id="@+id/vs_company_profile_blur"
        android:layout="@layout/comp_blur_company_profile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
