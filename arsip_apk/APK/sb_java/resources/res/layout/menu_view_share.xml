<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/clickable_size_48"
    android:layout_height="@dimen/clickable_size_48">
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/ib_share"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:layout_width="@dimen/clickable_size_32"
        android:layout_height="@dimen/clickable_size_32"
        android:contentDescription="@string/action_share_portfolio"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_share_portfolio"
        app:tint="?attr/themeIconTintColor"/>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lav_share"
        android:visibility="gone"
        android:layout_width="@dimen/clickable_size_48"
        android:layout_height="@dimen/clickable_size_48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_fileName="lottie_share_button_animation.json"
        app:lottie_loop="true"/>
</androidx.constraintlayout.widget.ConstraintLayout>
