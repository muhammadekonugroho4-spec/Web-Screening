<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_parent_attachment"
    android:tag="layout/item_attachment_with_icon_0"
    android:background="@drawable/bg_list_selector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_file_type_icon"
        android:padding="@dimen/item_gap_xs"
        android:layout_width="@dimen/clickable_size_32"
        android:layout_height="@dimen/clickable_size_32"
        android:layout_marginLeft="@dimen/item_gap_m"
        android:layout_marginTop="@dimen/item_gap_s"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        android:contentDescription="@null"/>
    <TextView
        android:ellipsize="middle"
        android:id="@+id/tv_icon_title"
        android:paddingLeft="@dimen/item_gap_s"
        android:paddingTop="@dimen/item_gap_l"
        android:paddingRight="@dimen/item_gap_l"
        android:paddingBottom="@dimen/item_gap_l"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_toRightOf="@+id/iv_file_type_icon"
        style="@style/SbTextView.StreamListContent"/>
    <View
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_below="@+id/tv_icon_title"/>
</RelativeLayout>
