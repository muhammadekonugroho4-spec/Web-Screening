<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parentDiscoverMarketDetailRoot"
    android:tag="layout/fragment_wellcome_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/ivWellcomeImageHeader"
        android:padding="@dimen/item_gap_l"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:layout_above="@+id/tvWellcomeTitle"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tvWellcomeTitle"
        android:padding="@dimen/item_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/tvWellcomeSubtitle"
        android:textAlignment="gravity"
        style="@style/TypeStyles.Nominal"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="top|center_horizontal"
        android:id="@+id/tvWellcomeSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_8"
        android:layout_marginBottom="@dimen/item_gap_l"
        android:minLines="2"
        android:layout_alignParentBottom="true"
        android:textAlignment="gravity"
        android:paddingHorizontal="@dimen/item_gap_26"
        style="@style/TypeStyles.BodyRegular"/>
</RelativeLayout>
