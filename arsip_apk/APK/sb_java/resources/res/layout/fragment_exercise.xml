<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_exercise_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_stockbit_exercise"
        android:paddingLeft="@dimen/spacing_0"
        android:paddingRight="@dimen/spacing_0"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:minHeight="?attr/actionBarSize"
        app:contentInsetLeft="@dimen/spacing_0"
        app:contentInsetStart="@dimen/spacing_0"
        app:contentInsetStartWithNavigation="@dimen/spacing_0"
        app:elevation="@dimen/spacing_0">
        <RelativeLayout
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minHeight="?attr/actionBarSize">
            <TextView
                android:textSize="@dimen/text_size_16"
                android:textStyle="bold"
                android:ellipsize="middle"
                android:gravity="center"
                android:id="@+id/tv_toolbar_title_stockbit_exercise"
                android:tag="binding_1"
                android:paddingLeft="@dimen/spacing_16"
                android:paddingRight="@dimen/spacing_16"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:singleLine="true"
                android:layout_centerHorizontal="true"
                android:textAlignment="gravity"
                style="@style/TypeStyles.BodyRegular"/>
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>
    <ViewFlipper
        android:id="@+id/vf_fragment_stockbit_exercise"
        android:tag="binding_2"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ViewStub
            android:layout="@layout/comp_exercise_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ViewStub
            android:id="@+id/viewstub_exercise_content"
            android:layout="@layout/comp_exercise_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ViewStub
            android:layout_gravity="center"
            android:id="@+id/parent_error_stockbit_exercise"
            android:layout="@layout/comp_icon_error_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </ViewFlipper>
</androidx.appcompat.widget.LinearLayoutCompat>
