<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingBottom="@dimen/twenty_dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="@dimen/sixteen_dp">
    <com.midtrans.sdk.uikit.widgets.DefaultTextView
        android:textSize="@dimen/secondary_text_size"
        android:textColor="@color/black"
        android:paddingLeft="@dimen/sixteen_dp"
        android:paddingRight="@dimen/sixteen_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/danamon_online_description_1"/>
    <com.midtrans.sdk.uikit.widgets.DefaultTextView
        android:textSize="@dimen/secondary_text_size"
        android:textColor="@color/black"
        android:paddingLeft="@dimen/sixteen_dp"
        android:paddingRight="@dimen/sixteen_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sixteen_dp"
        android:text="@string/danamon_online_description_2"/>
    <androidx.appcompat.widget.AppCompatButton
        android:gravity="center_vertical"
        android:id="@+id/instruction_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/eight_dp"
        android:layout_marginTop="@dimen/sixteen_dp"
        android:layout_marginRight="@dimen/sixteen_dp"
        android:text="@string/show_instruction"
        style="@style/ButtonSecondaryExpandable"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/container_instruction"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:background="@color/light_gray"
            android:paddingLeft="@dimen/sixteen_dp"
            android:paddingTop="@dimen/five_dp"
            android:paddingRight="@dimen/sixteen_dp"
            android:paddingBottom="@dimen/five_dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.midtrans.sdk.uikit.widgets.DefaultTextView
                android:layout_width="@dimen/twenty_four_dp"
                android:layout_height="wrap_content"
                android:text="@string/number_instruction1"/>
            <com.midtrans.sdk.uikit.widgets.DefaultTextView
                android:textSize="@dimen/secondary_text_size"
                android:textColor="@color/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/danamon_online_instruction_step1"/>
        </LinearLayout>
        <LinearLayout
            android:paddingLeft="@dimen/sixteen_dp"
            android:paddingTop="@dimen/five_dp"
            android:paddingRight="@dimen/sixteen_dp"
            android:paddingBottom="@dimen/five_dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sixteen_dp">
            <com.midtrans.sdk.uikit.widgets.DefaultTextView
                android:layout_width="@dimen/twenty_four_dp"
                android:layout_height="wrap_content"
                android:text="@string/number_instruction2"/>
            <com.midtrans.sdk.uikit.widgets.DefaultTextView
                android:textSize="@dimen/secondary_text_size"
                android:textColor="@color/black"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/danamon_online_instruction_step2"/>
        </LinearLayout>
        <LinearLayout
            android:background="@color/light_gray"
            android:paddingLeft="@dimen/sixteen_dp"
            android:paddingTop="@dimen/five_dp"
            android:paddingRight="@dimen/sixteen_dp"
            android:paddingBottom="@dimen/five_dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sixteen_dp">
            <com.midtrans.sdk.uikit.widgets.DefaultTextView
                android:layout_width="@dimen/twenty_four_dp"
                android:layout_height="wrap_content"
                android:text="@string/number_instruction3"/>
            <com.midtrans.sdk.uikit.widgets.DefaultTextViewWithLink
                android:textSize="@dimen/secondary_text_size"
                android:textColor="@color/black"
                android:background="@color/light_gray"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/danamon_online_instruction_step3"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
