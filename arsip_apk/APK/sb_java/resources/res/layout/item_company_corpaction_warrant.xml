<?xml version="1.0" encoding="utf-8"?>
<ViewFlipper xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vf_root"
    android:tag="layout/item_company_corpaction_warrant_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:measureAllChildren="false">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_success_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textColor="?attr/themeColorTextGreen"
            android:gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:text="@string/title_corp_action_warrant"
            android:contentDescription="@string/CORP_ACT_2"
            android:layout_marginHorizontal="@dimen/item_gap_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingRegular"/>
        <ImageView
            android:id="@+id/iv_ongoing"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_ongoing"
            android:contentDescription="@string/CORP_ACT_3"
            android:layout_marginStart="@dimen/item_gap_8"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintStart_toEndOf="@+id/tv_title"
            app:layout_constraintTop_toTopOf="@+id/tv_title"/>
        <ImageView
            android:id="@+id/iv_arrow"
            android:layout_width="@dimen/width_18"
            android:layout_height="@dimen/height_18"
            android:src="0x7f0804cf"
            android:layout_marginEnd="@dimen/item_gap_20"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title"
            app:layout_constraintVertical_bias="0"
            app:tint="?attr/themeColorIconDefault"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_exercise_price_title"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_8"
            android:text="@string/text_corp_action_item_exercise_price"
            android:contentDescription="@string/CORP_ACT_4"
            android:layout_marginHorizontal="@dimen/item_gap_20"
            app:layout_constraintEnd_toStartOf="@+id/tv_exercise_price_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_exercise_price_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/CORP_ACT_9"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_exercise_price_title"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_trading_start_title"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            android:text="@string/text_corp_action_item_trading_start"
            android:contentDescription="@string/CORP_ACT_5"
            android:layout_marginHorizontal="@dimen/item_gap_20"
            app:layout_constraintEnd_toStartOf="@+id/tv_trading_start_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_exercise_price_title"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_trading_start_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/CORP_ACT_10"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_trading_start_title"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_trading_end_title"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            android:text="@string/text_corp_action_item_trading_end"
            android:contentDescription="@string/CORP_ACT_6"
            android:layout_marginHorizontal="@dimen/item_gap_20"
            app:layout_constraintEnd_toStartOf="@+id/tv_trading_end_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_trading_start_value"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_trading_end_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/CORP_ACT_11"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_trading_end_title"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_exercise_start_title"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            android:text="@string/text_corp_action_item_exercise_start"
            android:contentDescription="@string/CORP_ACT_7"
            android:layout_marginHorizontal="@dimen/item_gap_20"
            app:layout_constraintEnd_toStartOf="@+id/tv_exercise_start_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_trading_end_title"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_exercise_start_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/CORP_ACT_12"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_exercise_start_title"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_exercise_end_title"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            android:text="@string/text_corp_action_item_exercise_end"
            android:contentDescription="@string/CORP_ACT_8"
            android:layout_marginHorizontal="@dimen/item_gap_20"
            app:layout_constraintEnd_toStartOf="@+id/tv_exercise_end_value"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_exercise_start_title"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:gravity="center_vertical"
            android:id="@+id/tv_exercise_end_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/CORP_ACT_13"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_exercise_end_title"
            style="@style/TypeStyles.BodyRegular"/>
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_marginTop="@dimen/item_gap_20"
            app:layout_constraintTop_toBottomOf="@+id/tv_exercise_end_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        android:layout_marginVertical="@dimen/item_gap_20">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="@dimen/width_160"
            android:layout_height="@dimen/height_120"
            android:src="?attr/themeIconEmptyTable"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_load_error"
            android:contentDescription="@string/CORP_ACT_26"
            style="@style/TypeStyles.BodyRegular"/>
        <com.stockbit.uikit.buttons.EllipseButton
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_reload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_41"
            android:text="@string/text_reload"
            android:contentDescription="@string/CORP_ACT_27"
            android:paddingHorizontal="@dimen/item_gap_32"/>
    </LinearLayout>
</ViewFlipper>
