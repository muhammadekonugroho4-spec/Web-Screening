<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/clickable_size_48"
    android:layout_height="@dimen/clickable_size_48">
    <ImageButton
        android:layout_gravity="center"
        android:id="@+id/ibWebviewControlReloadButton"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:layout_width="@dimen/clickable_size_32"
        android:layout_height="@dimen/clickable_size_32"
        android:contentDescription="@string/btn_reload_webview"
        app:srcCompat="@drawable/ic_loading"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progressBarWebviewControlLoadingIndicator"
        android:visibility="visible"
        android:layout_width="@dimen/clickable_size_32"
        android:layout_height="@dimen/clickable_size_32"
        android:indeterminate="true"
        android:indeterminateTint="@color/green_text"
        style="@style/Widget.AppCompat.ProgressBar"/>
</FrameLayout>
