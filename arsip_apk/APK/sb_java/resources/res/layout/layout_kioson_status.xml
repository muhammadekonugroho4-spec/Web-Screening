<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.midtrans.sdk.uikit.widgets.DefaultTextView
        android:textSize="@dimen/secondary_text_size"
        android:textColor="@color/dark_gray"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/twenty_four_dp"
        android:layout_marginTop="@dimen/sixteen_dp"
        android:layout_marginRight="@dimen/sixteen_dp"
        android:text="@string/payment_code"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/sixteen_dp"
        android:layout_marginRight="@dimen/sixteen_dp">
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            android:textSize="@dimen/header_text_size"
            android:textColor="@color/black"
            android:id="@+id/text_payment_code"
            android:background="@color/light_gray"
            android:padding="@dimen/eight_dp"
            android:paddingRight="@dimen/four_dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/four_dp"
            android:text="@string/payment_code"
            android:layout_weight="1"/>
        <com.midtrans.sdk.uikit.widgets.FancyButton
            android:layout_gravity="center_vertical"
            android:id="@+id/btn_copy_va"
            android:paddingLeft="@dimen/sixteen_dp"
            android:paddingRight="@dimen/sixteen_dp"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:fb_borderColor="?attr/colorPrimary"
            app:fb_borderWidth="1dp"
            app:fb_defaultColor="@android:color/white"
            app:fb_focusColor="@color/colorAccentLight"
            app:fb_iconColor="?attr/colorPrimary"
            app:fb_radius="5dp"
            app:fb_text="@string/copy"
            app:fb_textColor="?attr/colorPrimary"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@color/faint_yellow"
        android:padding="@dimen/sixteen_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/sixteen_dp"
        android:layout_marginTop="@dimen/sixteen_dp"
        android:layout_marginRight="@dimen/sixteen_dp">
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            android:textSize="@dimen/secondary_text_size"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/eight_dp"
            android:text="@string/valid_until"/>
        <com.midtrans.sdk.uikit.widgets.SemiBoldTextView
            android:textSize="@dimen/secondary_text_size"
            android:textColor="@color/black"
            android:id="@+id/text_validity"
            android:background="@color/faint_yellow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/valid_date"/>
    </LinearLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:gravity="center_vertical"
        android:id="@+id/instruction_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/sixteen_dp"
        android:layout_marginTop="@dimen/sixteen_dp"
        android:layout_marginRight="@dimen/sixteen_dp"
        android:text="@string/show_instruction"
        style="@style/ButtonSecondaryExpandable"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/instruction_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:background="@color/light_gray"
                android:paddingLeft="@dimen/sixteen_dp"
                android:paddingTop="@dimen/five_dp"
                android:paddingRight="@dimen/sixteen_dp"
                android:paddingBottom="@dimen/five_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="@dimen/twenty_four_dp"
                    android:layout_height="wrap_content"
                    android:text="@string/number_instruction1"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:textSize="@dimen/secondary_text_size"
                    android:textColor="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kioson_instruction_step1"/>
            </LinearLayout>
            <LinearLayout
                android:paddingLeft="@dimen/sixteen_dp"
                android:paddingRight="@dimen/sixteen_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eight_dp"
                android:lineSpacingExtra="2dp">
                <TextView
                    android:layout_width="@dimen/twenty_four_dp"
                    android:layout_height="wrap_content"
                    android:text="@string/number_instruction2"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:textSize="@dimen/secondary_text_size"
                    android:textColor="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kioson_instruction_step2"/>
            </LinearLayout>
            <LinearLayout
                android:background="@color/light_gray"
                android:paddingLeft="@dimen/sixteen_dp"
                android:paddingTop="@dimen/five_dp"
                android:paddingRight="@dimen/sixteen_dp"
                android:paddingBottom="@dimen/five_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eight_dp"
                android:lineSpacingExtra="2dp">
                <TextView
                    android:layout_width="@dimen/twenty_four_dp"
                    android:layout_height="wrap_content"
                    android:text="@string/number_instruction3"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:textSize="@dimen/secondary_text_size"
                    android:textColor="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kioson_instruction_step3"/>
            </LinearLayout>
            <LinearLayout
                android:paddingLeft="@dimen/sixteen_dp"
                android:paddingTop="@dimen/five_dp"
                android:paddingRight="@dimen/sixteen_dp"
                android:paddingBottom="@dimen/five_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eight_dp"
                android:lineSpacingExtra="2dp">
                <TextView
                    android:layout_width="@dimen/twenty_four_dp"
                    android:layout_height="wrap_content"
                    android:text="@string/number_instruction4"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:textSize="@dimen/secondary_text_size"
                    android:textColor="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kioson_instruction_step4"/>
            </LinearLayout>
            <LinearLayout
                android:background="@color/light_gray"
                android:paddingLeft="@dimen/sixteen_dp"
                android:paddingTop="@dimen/five_dp"
                android:paddingRight="@dimen/sixteen_dp"
                android:paddingBottom="@dimen/five_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eight_dp"
                android:lineSpacingExtra="2dp">
                <TextView
                    android:layout_width="@dimen/twenty_four_dp"
                    android:layout_height="wrap_content"
                    android:text="@string/number_instruction5"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:textSize="@dimen/secondary_text_size"
                    android:textColor="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kioson_instruction_step5"/>
            </LinearLayout>
            <LinearLayout
                android:paddingLeft="@dimen/sixteen_dp"
                android:paddingTop="@dimen/five_dp"
                android:paddingRight="@dimen/sixteen_dp"
                android:paddingBottom="@dimen/five_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eight_dp"
                android:lineSpacingExtra="2dp">
                <TextView
                    android:layout_width="@dimen/twenty_four_dp"
                    android:layout_height="wrap_content"
                    android:text="@string/number_instruction6"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:textSize="@dimen/secondary_text_size"
                    android:textColor="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kioson_instruction_step6"/>
            </LinearLayout>
            <LinearLayout
                android:background="@color/light_gray"
                android:paddingLeft="@dimen/sixteen_dp"
                android:paddingTop="@dimen/five_dp"
                android:paddingRight="@dimen/sixteen_dp"
                android:paddingBottom="@dimen/five_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eight_dp"
                android:lineSpacingExtra="2dp">
                <TextView
                    android:layout_width="@dimen/twenty_four_dp"
                    android:layout_height="wrap_content"
                    android:text="@string/number_instruction7"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:textSize="@dimen/secondary_text_size"
                    android:textColor="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kioson_instruction_step7"/>
            </LinearLayout>
            <LinearLayout
                android:paddingLeft="@dimen/sixteen_dp"
                android:paddingTop="@dimen/five_dp"
                android:paddingRight="@dimen/sixteen_dp"
                android:paddingBottom="@dimen/five_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eight_dp"
                android:lineSpacingExtra="2dp">
                <TextView
                    android:layout_width="@dimen/twenty_four_dp"
                    android:layout_height="wrap_content"
                    android:text="@string/number_instruction8"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:textSize="@dimen/secondary_text_size"
                    android:textColor="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kioson_instruction_step8"/>
            </LinearLayout>
            <LinearLayout
                android:background="@color/light_gray"
                android:paddingLeft="@dimen/sixteen_dp"
                android:paddingTop="@dimen/five_dp"
                android:paddingRight="@dimen/sixteen_dp"
                android:paddingBottom="@dimen/five_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eight_dp"
                android:layout_marginBottom="@dimen/eight_dp"
                android:lineSpacingExtra="2dp">
                <TextView
                    android:layout_width="@dimen/twenty_four_dp"
                    android:layout_height="wrap_content"
                    android:text="@string/number_instruction9"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:textSize="@dimen/secondary_text_size"
                    android:textColor="@color/black"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/kioson_instruction_step9"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
