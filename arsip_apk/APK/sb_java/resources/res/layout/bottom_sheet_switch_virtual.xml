<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nsvTradingSecurityListLayout"
    android:tag="layout/bottom_sheet_switch_virtual_0"
    android:background="?attr/themeColorModalsBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/rlTradingSecurityListMainLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/rlStockbitSecuritiesLayout"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="@dimen/item_gap_m"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            android:paddingStart="@dimen/item_gap_l"
            android:paddingEnd="@dimen/item_gap_l">
            <ImageView
                android:id="@+id/ivStockbitSecuritiesCheck"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                app:srcCompat="@drawable/ic_check_circle_green_24dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llStockbitSecuritiesLayout"
                android:paddingBottom="@dimen/item_gap_10"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/item_gap_s"
                android:layout_toLeftOf="@+id/ivStockbitSecuritiesCheck"
                android:layout_centerVertical="true">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="@dimen/height_44"
                    android:layout_height="@dimen/height_44"
                    android:layout_margin="@dimen/item_gap_m"
                    app:srcCompat="?attr/themeIconSSBottomsheetLogo"/>
                <TextView
                    android:textSize="@dimen/text_size_18"
                    android:textColor="?attr/themeContentTextColor"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lbl_stockbit_sekuritas"
                    style="@style/SbTextView.BodyDefault"/>
            </LinearLayout>
            <View
                android:background="?attr/themeSeparatorGapColorNewSecondary"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_alignParentBottom="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:orientation="vertical"
            android:id="@+id/rlVirtualLayout"
            android:background="?attr/selectableItemBackground"
            android:paddingTop="@dimen/item_gap_m"
            android:paddingBottom="@dimen/item_gap_m"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/item_gap_l"
            android:paddingEnd="@dimen/item_gap_l">
            <ImageView
                android:id="@+id/ivVirtualCheck"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                app:srcCompat="@drawable/ic_check_circle_green_24dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llVirtualLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toLeftOf="@+id/ivVirtualCheck"
                android:layout_centerVertical="true">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="@dimen/height_44"
                    android:layout_height="@dimen/height_44"
                    android:layout_margin="@dimen/item_gap_m"
                    app:srcCompat="@drawable/ic_virtual"/>
                <TextView
                    android:textSize="@dimen/text_size_18"
                    android:textColor="?attr/themeContentTextColor"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Virtual Trading"
                    style="@style/SbTextView.BodyDefault"/>
            </LinearLayout>
        </RelativeLayout>
        <Button
            android:textColor="@color/white"
            android:id="@+id/btn_submit"
            android:background="@drawable/btn_empty_green_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/clickable_size_48"
            android:layout_marginTop="@dimen/item_gap_m"
            android:text="@string/btn_login_next"
            style="@style/SbBtn"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
