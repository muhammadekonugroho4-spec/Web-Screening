<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="@dimen/item_gap_l"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/viewCompanyItemSkeletonSearch"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_32"
        android:layout_marginEnd="@dimen/item_gap_8"
        android:backgroundTint="?attr/themeShimmer"/>
    <View
        android:id="@+id/viewCompanyItemSkeletonAvatar"
        android:background="@drawable/ic_circle_grey"
        android:layout_width="@dimen/avatar_size_default"
        android:layout_height="@dimen/avatar_size_default"
        android:layout_marginTop="@dimen/item_gap_8"
        android:layout_below="@+id/viewCompanyItemSkeletonSearch"
        android:backgroundTint="?attr/themeShimmer"/>
    <View
        android:id="@+id/viewCompanyItemSkeletonUsername"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_220"
        android:layout_height="@dimen/item_gap_12"
        android:layout_marginTop="@dimen/item_gap_8"
        android:layout_toRightOf="@+id/viewCompanyItemSkeletonAvatar"
        android:layout_below="@+id/viewCompanyItemSkeletonSearch"
        android:layout_marginStart="@dimen/item_gap_13"
        android:backgroundTint="?attr/themeShimmer"/>
    <View
        android:id="@+id/viewCompanyItemSkeletonDate"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_80"
        android:layout_height="@dimen/item_gap_12"
        android:layout_marginTop="@dimen/item_gap_12"
        android:layout_toRightOf="@+id/viewCompanyItemSkeletonAvatar"
        android:layout_below="@+id/viewCompanyItemSkeletonUsername"
        android:layout_marginStart="@dimen/item_gap_13"
        android:backgroundTint="?attr/themeShimmer"/>
    <View
        android:id="@+id/viewCompanyItemSkeletonContent"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_96"
        android:layout_marginTop="@dimen/item_gap_12"
        android:layout_below="@+id/viewCompanyItemSkeletonDate"
        android:backgroundTint="?attr/themeShimmer"/>
    <View
        android:id="@+id/viewCompanyItemSkeletonAvatar2"
        android:background="@drawable/ic_circle_grey"
        android:layout_width="@dimen/avatar_size_default"
        android:layout_height="@dimen/avatar_size_default"
        android:layout_marginTop="@dimen/item_gap_8"
        android:layout_below="@+id/viewCompanyItemSkeletonContent"
        android:backgroundTint="?attr/themeShimmer"/>
    <View
        android:id="@+id/viewCompanyItemSkeletonUsername2"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_220"
        android:layout_height="@dimen/item_gap_12"
        android:layout_marginTop="@dimen/item_gap_8"
        android:layout_toRightOf="@+id/viewCompanyItemSkeletonAvatar"
        android:layout_below="@+id/viewCompanyItemSkeletonContent"
        android:layout_marginStart="@dimen/item_gap_13"
        android:backgroundTint="?attr/themeShimmer"/>
    <View
        android:id="@+id/viewCompanyItemSkeletonDate2"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_80"
        android:layout_height="@dimen/item_gap_12"
        android:layout_marginTop="@dimen/item_gap_12"
        android:layout_toRightOf="@+id/viewCompanyItemSkeletonAvatar2"
        android:layout_below="@+id/viewCompanyItemSkeletonUsername2"
        android:layout_marginStart="@dimen/item_gap_13"
        android:backgroundTint="?attr/themeShimmer"/>
    <View
        android:id="@+id/viewCompanyItemSkeletonContent2"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_96"
        android:layout_marginTop="@dimen/item_gap_12"
        android:layout_below="@+id/viewCompanyItemSkeletonDate2"
        android:backgroundTint="?attr/themeShimmer"/>
</RelativeLayout>
