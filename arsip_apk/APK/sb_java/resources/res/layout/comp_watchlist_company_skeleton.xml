<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/clickable_size_64">
    <View
        android:id="@+id/v_symbol_image"
        android:layout_width="@dimen/width_32"
        android:layout_height="@dimen/width_32"
        android:layout_marginStart="@dimen/spacing_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FBShimmerItem.Circular"/>
    <View
        android:id="@+id/v_symbol"
        android:layout_width="37dp"
        android:layout_height="19dp"
        android:layout_marginStart="@dimen/spacing_8"
        app:layout_constraintBottom_toTopOf="@+id/v_name"
        app:layout_constraintStart_toEndOf="@+id/v_symbol_image"
        app:layout_constraintTop_toTopOf="@+id/v_symbol_image"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/FBShimmerItem"/>
    <View
        android:id="@+id/v_name"
        android:layout_width="134dp"
        android:layout_height="@dimen/spacing_16"
        android:layout_marginTop="@dimen/spacing_4"
        app:layout_constraintBottom_toBottomOf="@+id/v_symbol_image"
        app:layout_constraintStart_toStartOf="@+id/v_symbol"
        app:layout_constraintTop_toBottomOf="@+id/v_symbol"
        style="@style/FBShimmerItem"/>
    <View
        android:id="@+id/v_value"
        android:layout_width="90dp"
        android:layout_height="@dimen/height_40"
        android:layout_marginEnd="@dimen/spacing_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FBShimmerItem"/>
    <View
        android:id="@+id/v_bottom_border"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:backgroundTint="?attr/themeColorDividerThin"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
