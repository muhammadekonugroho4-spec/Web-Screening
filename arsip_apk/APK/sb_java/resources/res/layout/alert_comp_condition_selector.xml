<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/ll_parent"
    android:tag="layout/alert_comp_condition_selector_0"
    android:background="@drawable/alert_bg_condition_selector"
    android:padding="@dimen/spacing_6"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false">
    <RelativeLayout
        android:id="@+id/rl_lower_than"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_36"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/uikit_divider_thin">
        <ImageView
            android:id="@+id/iv_lower_than"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:srcCompat="@drawable/alert_ic_lower_than"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_lower_than_equals"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_36"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/uikit_divider_thin">
        <ImageView
            android:id="@+id/iv_lower_than_equals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:srcCompat="@drawable/alert_ic_lower_than_equals"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_equals"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_36"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/uikit_divider_thin">
        <ImageView
            android:id="@+id/iv_equals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:srcCompat="@drawable/alert_ic_equals"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_greater_than_equals"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_36"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/uikit_divider_thin">
        <ImageView
            android:id="@+id/iv_greater_than_equals"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:srcCompat="@drawable/alert_ic_greater_than_equals"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_greater_than"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacing_36"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/uikit_divider_thin">
        <ImageView
            android:id="@+id/iv_greater_than"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            app:srcCompat="@drawable/alert_ic_bigger_than"/>
    </RelativeLayout>
</LinearLayout>
