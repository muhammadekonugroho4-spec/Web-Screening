<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/item_gap_20">
    <View
        android:layout_gravity="center"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/item_gap_108"
        android:layout_height="@dimen/item_gap_16"/>
    <View
        android:layout_gravity="center"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/item_gap_80"
        android:layout_height="@dimen/item_gap_16"
        android:layout_marginTop="@dimen/item_gap_12"/>
    <View
        android:layout_gravity="center"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/item_gap_108"
        android:layout_height="@dimen/item_gap_30"
        android:layout_marginTop="@dimen/item_gap_12"/>
    <View
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/item_gap_108"
        android:layout_height="@dimen/item_gap_16"
        android:layout_marginTop="@dimen/item_gap_36"/>
    <View
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_50"
        android:layout_marginTop="@dimen/item_gap_10"/>
    <View
        android:layout_gravity="end"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/item_gap_108"
        android:layout_height="@dimen/item_gap_16"
        android:layout_marginTop="@dimen/item_gap_20"/>
    <View
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/item_gap_72"
        android:layout_height="@dimen/item_gap_16"
        android:layout_marginTop="@dimen/item_gap_20"/>
    <LinearLayout
        android:background="@drawable/border_gray_rounded_white_bg"
        android:padding="@dimen/item_gap_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_10">
        <View
            android:background="@drawable/bg_rounded_gray"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_16"
            android:layout_marginStart="@dimen/item_gap_16"/>
    </LinearLayout>
    <View
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/item_gap_72"
        android:layout_height="@dimen/item_gap_16"
        android:layout_marginTop="@dimen/item_gap_20"/>
    <RelativeLayout
        android:background="@drawable/border_gray_rounded_white_bg"
        android:padding="@dimen/item_gap_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_10">
        <View
            android:id="@+id/view_rdn_bank"
            android:background="@drawable/bg_circle_gray"
            android:layout_width="@dimen/width_50"
            android:layout_height="@dimen/height_50"
            android:layout_centerVertical="true"/>
        <View
            android:id="@+id/view_rdn_name"
            android:background="@drawable/bg_rounded_gray"
            android:layout_width="@dimen/width_140"
            android:layout_height="@dimen/height_16"
            android:layout_toRightOf="@+id/view_rdn_bank"
            android:layout_marginStart="@dimen/item_gap_16"/>
        <View
            android:id="@+id/view_rdn_number"
            android:background="@drawable/bg_rounded_gray"
            android:layout_width="@dimen/width_92"
            android:layout_height="@dimen/height_16"
            android:layout_marginTop="@dimen/item_gap_4"
            android:layout_toRightOf="@+id/view_rdn_bank"
            android:layout_below="@+id/view_rdn_name"
            android:layout_marginStart="@dimen/item_gap_16"/>
    </RelativeLayout>
    <View
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_50"
        android:layout_marginTop="@dimen/item_gap_105"/>
</LinearLayout>
