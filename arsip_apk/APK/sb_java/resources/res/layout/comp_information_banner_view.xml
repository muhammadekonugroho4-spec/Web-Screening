<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_information_banner_view_0"
    android:background="@drawable/bg_rounded_orange_outline"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/ORDER_26"
    android:layout_marginHorizontal="@dimen/item_gap_16"
    android:layout_marginVertical="@dimen/item_gap_16"
    android:paddingHorizontal="@dimen/spacing_16"
    android:paddingVertical="@dimen/item_gap_12">
    <TextView
        android:id="@+id/tv_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_6"
        android:text="@string/title_banner_notation_x"
        android:layout_marginEnd="@dimen/spacing_8"
        app:layout_constraintBottom_toTopOf="@+id/tv_body"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingSmall"/>
    <TextView
        android:id="@+id/tv_connector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="•"
        android:layout_marginHorizontal="@dimen/item_gap_6"
        app:layout_constraintStart_toEndOf="@+id/tv_header"
        style="@style/TypeStyles.BodySmall"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:ellipsize="end"
        android:id="@+id/tv_session"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/item_gap_6"
        android:layout_marginEnd="@dimen/spacing_8"
        app:layout_constraintEnd_toStartOf="@+id/iv_chevron_right"
        app:layout_constraintStart_toEndOf="@+id/tv_connector"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodySmall"/>
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:id="@+id/tv_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_chevron_right"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_header"
        style="@style/TypeStyles.BodyXSmall"/>
    <ImageView
        android:id="@+id/iv_chevron_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_chevron_right_orange"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
