<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_register_password_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="800dp">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_register_password_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_36"
                android:layout_marginStart="@dimen/item_gap_l"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/imgRegisterPassword"/>
            <TextView
                android:id="@+id/tv_register_password_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:text="@string/title_create_new_password"
                app:layout_constraintStart_toStartOf="@+id/iv_register_password_icon"
                app:layout_constraintTop_toBottomOf="@+id/iv_register_password_icon"
                style="@style/TypeStyles.HeadlineRegular"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:id="@+id/tv_register_password_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_10"
                android:text="@string/text_create_new_password_confirmation"
                app:layout_constraintStart_toStartOf="@+id/tv_register_password_title"
                app:layout_constraintTop_toBottomOf="@+id/tv_register_password_title"
                style="@style/TypeStyles.BodyRegular"/>
            <com.stockbit.uikit.input.InputTextFieldLine
                android:id="@+id/input_text_password"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_24"
                android:layout_marginStart="@dimen/item_gap_13"
                android:layout_marginEnd="@dimen/item_gap_l"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_register_password_subtitle"
                app:textFieldHint="@string/placeholder_new_password_create"
                app:textFieldInputType="textPassword"
                app:textFieldLabel="@string/title_new_password_create"/>
            <com.stockbit.uikit.input.InputTextFieldLine
                android:id="@+id/input_text_password_confirmation"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/item_gap_13"
                android:layout_marginTop="@dimen/item_gap_24"
                android:layout_below="@+id/input_text_password"
                android:layout_marginStart="@dimen/item_gap_13"
                android:layout_marginEnd="@dimen/item_gap_l"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/input_text_password"
                app:textFieldHint="@string/placeholder_new_password_confirmation"
                app:textFieldInputType="textPassword"
                app:textFieldLabel="@string/title_new_password_confirmation"/>
            <com.stockbit.uikit.buttons.StickyButton
                android:id="@+id/btn_register_password"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_8"
                android:text="@string/button_next"
                android:layout_alignParentBottom="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/input_text_password_confirmation"
                app:layout_constraintVertical_bias="1"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
