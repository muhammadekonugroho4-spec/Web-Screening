<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/item_watchlist_group_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="@dimen/height_48"
    android:layout_marginTop="@dimen/item_gap_12">
    <LinearLayout
        android:id="@+id/ll_watchlist_delete"
        android:background="@color/google_red"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/item_gap_16"
        android:layout_alignParentEnd="true"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:layout_gravity="end|top"
            android:id="@+id/tvRemove"
            android:background="@color/google_red"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/btn_delete_watchlist"
            android:paddingHorizontal="@dimen/spacing_16"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_parent"
        android:background="@drawable/bg_active_watchlist"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/item_gap_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:gravity="start"
            android:id="@+id/tv_watchlist_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/item_gap_4"
            android:textAlignment="gravity"
            android:layout_marginStart="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/item_gap_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/barrier_watchlist_action"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.BodyRegular"/>
        <EditText
            android:textColorHint="?attr/themeColorTextTetriary"
            android:id="@+id/et_new_watchlist"
            android:background="@android:color/transparent"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/title_hint_add_new_watchlist"
            android:maxLines="1"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:layout_marginStart="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/spacing_12"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/barrier_watchlist_action"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.BodyRegular"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_watchlist_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="start"
            app:constraint_referenced_ids="iv_watchlist_favorite,pbLoading"/>
        <View
            android:id="@+id/v_click_favorite"
            android:layout_width="@dimen/clickable_size_50"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_watchlist_favorite"
            android:layout_width="@dimen/width_16"
            android:layout_height="@dimen/height_16"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:contentDescription="@string/btn_following"
            android:layout_marginEnd="@dimen/item_gap_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_star_unfavorite"/>
        <androidx.core.widget.ContentLoadingProgressBar
            android:id="@+id/pbLoading"
            android:visibility="gone"
            android:layout_width="@dimen/width_16"
            android:layout_height="@dimen/height_16"
            android:layout_marginEnd="@dimen/item_gap_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Base.Widget.AppCompat.ProgressBar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
