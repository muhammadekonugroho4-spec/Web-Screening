<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ctl_content_bubble"
    android:tag="layout/comp_dialog_share_amount_content_bubble_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_bg_bubble_content"
        android:background="@drawable/share_trade_bg_content_teal_low_rounded_14"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/s_bubble_content_bottom_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorOliveDefault"
        android:id="@+id/tv_bubble_content_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_marginHorizontal="@dimen/spacing_12"
        app:layout_constraintStart_toStartOf="@+id/v_bg_bubble_content"
        app:layout_constraintTop_toTopOf="@+id/v_bg_bubble_content"
        style="@style/TypeStyles.HeadingXSmall"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorTealDefault"
        android:id="@+id/tv_bubble_content_order_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_6"
        app:layout_constraintStart_toStartOf="@+id/tv_bubble_content_username"
        app:layout_constraintTop_toBottomOf="@+id/tv_bubble_content_username"
        style="@style/TypeStyles.BodyLarge"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorTealDefault"
        android:id="@+id/tv_bubble_content_symbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_bubble_content_order_type"
        app:layout_constraintStart_toEndOf="@+id/tv_bubble_content_order_type"
        style="@style/TypeStyles.HeadingLarge"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorTealDefault"
        android:id="@+id/tv_bubble_content_current_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@+id/tv_bubble_content_order_type"
        app:layout_constraintTop_toBottomOf="@+id/tv_bubble_content_order_type"
        style="@style/TypeStyles.BodyXSmall"/>
    <View
        android:id="@+id/v_bubble_content_dot"
        android:background="@drawable/share_trade_dot_icon_default_2"
        android:layout_width="@dimen/spacing_2"
        android:layout_height="@dimen/spacing_2"
        android:layout_marginStart="@dimen/spacing_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_bubble_content_current_price"
        app:layout_constraintStart_toEndOf="@+id/tv_bubble_content_current_price"
        app:layout_constraintTop_toTopOf="@+id/tv_bubble_content_current_price"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorTextPrimary"
        android:id="@+id/tv_bubble_content_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.5"
        android:layout_marginStart="@dimen/spacing_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_bubble_content_current_price"
        app:layout_constraintStart_toEndOf="@+id/v_bubble_content_dot"
        style="@style/TypeStyles.BodyXSmall"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textColor="?attr/themeColorTextSecondary"
        android:id="@+id/tv_bubble_content_time_stamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        app:layout_constraintStart_toStartOf="@+id/tv_bubble_content_current_price"
        app:layout_constraintTop_toBottomOf="@+id/tv_bubble_content_current_price"
        style="@style/TypeStyles.BodyXSmall"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_bubble_content_right_arrow"
        android:layout_width="@dimen/icon_placeholder_16"
        android:layout_height="@dimen/icon_placeholder_16"
        android:layout_marginEnd="@dimen/spacing_12"
        app:layout_constraintBottom_toBottomOf="@+id/tv_bubble_content_time_stamp"
        app:layout_constraintEnd_toEndOf="@+id/v_bg_bubble_content"
        app:layout_constraintTop_toTopOf="@+id/tv_bubble_content_order_type"
        app:srcCompat="@drawable/uikit_ic_stockbit_row_chevron_right_green"/>
    <Space
        android:id="@+id/s_bubble_content_bottom_space"
        android:layout_width="0dp"
        android:layout_height="@dimen/spacing_12"
        app:layout_constraintStart_toStartOf="@+id/tv_bubble_content_time_stamp"
        app:layout_constraintTop_toBottomOf="@+id/tv_bubble_content_time_stamp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
