<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/skeleton_row_symbol_list_0"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/view_separator"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_8"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_stock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_10"
            android:layout_marginStart="@dimen/item_gap_18"
            android:layout_marginEnd="@dimen/item_gap_18">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:tag="binding_1"
                android:layout_width="@dimen/clickable_size_60"
                android:layout_height="wrap_content"
                android:layout_weight="0.33">
                <include
                    android:layout_width="@dimen/clickable_size_60"
                    android:layout_height="wrap_content"
                    layout="@layout/skeleton_horizontal"/>
                <TextView
                    android:textColor="?attr/titleTextColorHighgray"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/code"
                    style="@style/SbTextView.Caption.Highgray"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:tag="binding_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.33">
                <include
                    android:layout_width="@dimen/clickable_size_60"
                    android:layout_height="wrap_content"
                    layout="@layout/skeleton_horizontal"/>
                <TextView
                    android:textColor="?attr/titleTextColorHighgray"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/total_shares"
                    style="@style/SbTextView.Caption.Highgray"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:tag="binding_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0.33">
                <include
                    android:layout_gravity="right"
                    android:layout_width="@dimen/clickable_size_60"
                    android:layout_height="wrap_content"
                    layout="@layout/skeleton_horizontal"/>
                <TextView
                    android:textColor="?attr/titleTextColorHighgray"
                    android:gravity="end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/price"
                    style="@style/SbTextView.Caption.Highgray"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/view_border"
        android:background="?attr/themeSeparatorGapColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_18"
        android:layout_marginBottom="@dimen/item_gap_xxxs"
        android:layout_below="@+id/ll_top"/>
</RelativeLayout>
