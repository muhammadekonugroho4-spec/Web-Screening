<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/user_profile_fragment_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/genericToolbar"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:titleTextAppearance="@style/SbTextView.PageTitle">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:tag="binding_1"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/text_title"
                android:tag="binding_2"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:drawablePadding="@dimen/item_gap_s"
                app:autoSizeTextType="none"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/fl_verified_badge"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/TypeStyles.HeadingLarge"/>
            <FrameLayout
                android:id="@+id/fl_verified_badge"
                android:layout_width="@dimen/width_16"
                android:layout_height="@dimen/height_16"
                android:layout_marginStart="@dimen/item_gap_2"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/text_title"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/iv_verified_badge"
                    android:tag="binding_3"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="@dimen/clickable_size_12"
                    android:layout_height="@dimen/clickable_size_12"
                    android:scaleType="fitXY"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.Toolbar>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/clayout"
        android:tag="binding_4"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:background="?attr/themeColorSurfaceDefault"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="@dimen/item_gap_null">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:contentScrim="?attr/themeContentBackground"
                app:layout_scrollFlags="exitUntilCollapsed|scroll"
                app:titleEnabled="false">
                <ViewStub
                    android:id="@+id/vs_profile_layout"
                    android:tag="binding_5"
                    android:layout="@layout/comp_profile_layout"
                    android:inflatedId="@+id/inflateid_profile_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"/>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <FrameLayout
            android:id="@+id/inflateid_container_stream_profle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        <ViewStub
            android:id="@+id/vs_comp_blocked"
            android:tag="binding_6"
            android:layout="@layout/comp_blocked_view"
            android:inflatedId="@+id/inflateid_vs_comp_blocked"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
        <include
            android:id="@+id/shimmer_profile_info"
            layout="@layout/skeleton_profile_info"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
