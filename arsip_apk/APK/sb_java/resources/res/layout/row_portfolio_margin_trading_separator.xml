<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_portfolio_margin_trading_separator_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/item_gap_20">
    <TextView
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_title_margin_trading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_margin"
        app:layout_constraintBottom_toBottomOf="@+id/debt_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/debt_margin"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
    <TextView
        android:id="@+id/tv_title_margin_separator"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_margin_separator"
        android:layout_marginStart="@dimen/item_gap_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title_margin_trading"
        app:layout_constraintStart_toEndOf="@+id/tv_title_margin_trading"
        app:layout_constraintTop_toTopOf="@+id/tv_title_margin_trading"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
    <TextView
        android:textColor="?attr/themeColorTextRed"
        android:id="@+id/tv_title_margin_trading_call"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/item_gap_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title_margin_separator"
        app:layout_constraintStart_toEndOf="@+id/tv_title_margin_separator"
        app:layout_constraintTop_toTopOf="@+id/tv_title_margin_trading"
        style="@style/TypeStyles.BodyXSmall"/>
    <com.stockbit.feature.portfolio.component.MarginDebtRatioProgressView
        android:gravity="center_vertical"
        android:id="@+id/debt_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/item_gap_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
