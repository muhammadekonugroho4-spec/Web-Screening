<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_attachment_search_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/cl_container"
        android:tag="binding_1"
        android:background="?attr/themeColorModalsBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_toolbar"
            android:padding="@dimen/spacing_6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/iv_navigation"
                android:layout_width="@dimen/spacing_24"
                android:layout_height="@dimen/spacing_24"
                android:src="@drawable/ic_chevron_left"
                android:layout_marginStart="@dimen/item_gap_10"
                android:layout_marginEnd="@dimen/spacing_2"/>
            <com.stockbit.common.uikit.StockbitSearchBar
                android:id="@+id/ssb_search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:stockbitSearchBarHint="@string/hint_search_contacts_or_username"/>
        </LinearLayout>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vp_attachment"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="@dimen/spacing_0"
            app:layout_constraintBottom_toTopOf="@+id/layout_chat_attachment"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_toolbar"/>
        <include
            android:id="@+id/layout_chat_attachment"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            layout="@layout/comp_chat_attachment"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
