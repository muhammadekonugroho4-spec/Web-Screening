<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_order"
    android:tag="layout/row_trading_stockbit_orderlist_complete_0"
    android:paddingTop="@dimen/spacing_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/ORDER_18">
    <com.stockbit.uikit.control.ControlCheckbox
        android:layout_gravity="center"
        android:id="@+id/ccb_select_order"
        android:visibility="gone"
        android:layout_width="@dimen/width_24"
        android:layout_height="@dimen/height_24"
        android:contentDescription="@string/ORDER_20"
        android:layout_marginStart="@dimen/spacing_20"
        app:checkBoxType="box"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol"/>
    <TextView
        android:id="@+id/tv_symbol"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ORDER_6"
        android:layout_marginStart="@dimen/spacing_8"
        android:layout_marginEnd="@dimen/spacing_8"
        android:paddingVertical="@dimen/spacing_2"
        app:layout_constraintEnd_toStartOf="@+id/tv_amount"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/ccb_select_order"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginStart="@dimen/spacing_20"
        style="@style/TypeStyles.BodyXSmall"/>
    <ImageView
        android:id="@+id/iv_non_syariah"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/SHARED_6"
        app:layout_constraintStart_toStartOf="@+id/tv_symbol"
        app:layout_constraintTop_toBottomOf="@+id/tv_symbol"
        app:srcCompat="?attr/themeIconNonSharia"/>
    <TextView
        android:id="@+id/tv_lot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ORDER_7"
        app:layout_constraintEnd_toEndOf="@+id/tv_symbol"
        app:layout_constraintStart_toStartOf="@+id/tv_symbol"
        app:layout_constraintTop_toBottomOf="@+id/iv_non_syariah"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_amount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ORDER_8"
        android:textAlignment="textEnd"
        android:layout_marginEnd="@dimen/spacing_8"
        android:paddingVertical="@dimen/spacing_2"
        app:layout_constraintEnd_toStartOf="@+id/rl_status"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/tv_symbol"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol"
        style="@style/TypeStyles.BodyXSmall"/>
    <TextView
        android:gravity="end"
        android:id="@+id/tv_price"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ORDER_9"
        app:layout_constraintEnd_toEndOf="@+id/tv_amount"
        app:layout_constraintStart_toStartOf="@+id/tv_amount"
        app:layout_constraintTop_toBottomOf="@+id/tv_amount"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
    <RelativeLayout
        android:id="@+id/rl_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_20"
        android:paddingVertical="@dimen/spacing_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/tv_amount"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol">
        <TextView
            android:gravity="end"
            android:id="@+id/tv_order_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/ORDER_10"
            android:layout_alignParentEnd="true"
            android:paddingHorizontal="@dimen/spacing_4"
            android:paddingVertical="0.5dp"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.BodyXXSmall"/>
    </RelativeLayout>
    <TextView
        android:textSize="@dimen/text_size_10"
        android:textColor="?attr/themeColorTextSecondary"
        android:gravity="end"
        android:layout_gravity="end"
        android:id="@+id/tv_expiry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ORDER_11"
        android:textAlignment="textEnd"
        app:layout_constraintEnd_toEndOf="@+id/rl_status"
        app:layout_constraintStart_toStartOf="@+id/rl_status"
        app:layout_constraintTop_toBottomOf="@+id/rl_status"
        style="@style/TypeStyles.BodyXXSmall"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tv_expiry,tv_lot"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_negotiation_reqeust"
        android:background="@drawable/bg_order_nego_requested"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_31"
        android:layout_marginTop="@dimen/spacing_8"
        android:paddingStart="@dimen/spacing_12"
        android:paddingEnd="@dimen/spacing_8"
        android:layout_marginStart="@dimen/spacing_20"
        android:layout_marginEnd="@dimen/spacing_20"
        app:layout_constraintTop_toBottomOf="@+id/barrier_content">
        <ImageView
            android:id="@+id/ivHandShake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_handshake"/>
        <TextView
            android:id="@+id/tv_nego_request_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_4"
            style="@style/TypeStyles.BodyXSmall"/>
        <ImageView
            android:id="@+id/iv_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_arrow_gray"
            app:tint="?attr/themeIconTintColorLow"/>
    </LinearLayout>
    <View
        android:id="@+id/spacer_content"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/spacing_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_negotiation_reqeust"/>
</androidx.constraintlayout.widget.ConstraintLayout>
