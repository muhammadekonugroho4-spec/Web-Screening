<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_leader_dashboard_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stockbit.uikit.topbar.TopbarStockbitTitle
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:topBarTitleFourthIcon="?attr/themeIconFilterScreener"
        app:topBarTitleTitle="@string/button_setting_affiliate_group"
        app:topBarType="CenterTitle"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/clLeaderDashboard"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:tag="binding_1"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:layout_scrollFlags="snap|exitUntilCollapsed|scroll">
                <com.stockbit.common.uikit.StockbitSearchBar
                    android:id="@+id/ssb_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_collapseMode="parallax"
                    app:stockbitSearchBarHint="@string/text_search"
                    app:stockbitSearchBarIsLoading="false"/>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
            <include
                android:id="@+id/comp_leader_dashboard_list_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/comp_leader_dashboard_list_header"/>
        </com.google.android.material.appbar.AppBarLayout>
        <com.stockbit.component.pulltorefresh.PullToRefreshLayout
            android:id="@+id/ptr_dashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
            <FrameLayout
                android:layout_gravity="center"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_members"
                    android:background="?attr/themeContentBackground"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <include
                    android:id="@+id/comp_empty_result"
                    android:background="?attr/themeContentBackground"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    layout="@layout/comp_empty_result"/>
            </FrameLayout>
        </com.stockbit.component.pulltorefresh.PullToRefreshLayout>
        <FrameLayout
            android:id="@+id/fl_shimmer_container"
            android:background="?attr/themeContentBackground"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/sfl_dashboard"
                android:tag="binding_3"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@style/FBShimmerFrameLayout">
                <include
                    android:id="@+id/comp_leader_dashboard_shimmer"
                    layout="@layout/comp_leader_dashboard_shimmer"/>
            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
