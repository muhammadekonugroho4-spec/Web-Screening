<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_privacy_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/settingMainLayoutToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:layout_scrollFlags="enterAlways|scroll">
        <TextView
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_privacy"
            style="@style/SbTextView.PageTitle"/>
    </androidx.appcompat.widget.Toolbar>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/layout_scroll_settings"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_discover_people"
                android:background="?attr/themeSeparatorGapColor"
                android:paddingTop="@dimen/item_gap_12"
                android:paddingBottom="@dimen/item_gap_12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/title_privacy_phone_dicoverable"
                android:paddingStart="@dimen/item_gap_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/SbTextView.BodyDefault.Mediumempasis.Medium"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_discover_by_contact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/item_gap_24"
                app:layout_constraintBottom_toBottomOf="@+id/tv_title_discover_by_contact"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_title_discover_by_contact"
                app:srcCompat="@drawable/ic_hat_lense"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_title_discover_by_contact"
                android:background="?attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/text_privacy_phone_discoverable_contact"
                android:layout_marginStart="@dimen/item_gap_20"
                app:layout_constraintBottom_toBottomOf="@+id/switch_discoverable"
                app:layout_constraintStart_toEndOf="@+id/iv_discover_by_contact"
                app:layout_constraintTop_toTopOf="@+id/switch_discoverable"
                style="@style/SbTextView.BodyDefault.Mediumempasis.Medium"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_msg_discover_by_contact"
                android:background="?attr/selectableItemBackground"
                android:paddingBottom="@dimen/item_gap_12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_m"
                android:text="@string/text_privacy_phone_discoverable_contact_instruction"
                app:layout_constraintEnd_toStartOf="@+id/switch_discoverable"
                app:layout_constraintStart_toStartOf="@+id/tv_title_discover_by_contact"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_discover_by_contact"
                style="@style/SbTextView.Caption.Mediumempasis"/>
            <androidx.appcompat.widget.SwitchCompat
                android:theme="@style/SbSwitch.Regular"
                android:id="@+id/switch_discoverable"
                android:tag="binding_1"
                android:padding="@dimen/item_gap_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_12"
                android:layout_alignParentRight="true"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_discover_people"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_phone_access"
                android:background="?attr/themeSeparatorGapColor"
                android:paddingTop="@dimen/item_gap_12"
                android:paddingBottom="@dimen/item_gap_12"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/text_privacy_phone_access"
                android:paddingStart="@dimen/item_gap_20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_msg_discover_by_contact"
                style="@style/SbTextView.BodyDefault.Mediumempasis.Medium"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_contact_sync"
                android:tag="binding_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_20"
                android:layout_marginStart="@dimen/item_gap_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_phone_access"
                app:srcCompat="@drawable/ic_sync"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_sync_contact_data"
                android:tag="binding_3"
                android:background="?attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/title_privacy_phone_access_sync"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_24"
                app:layout_constraintBottom_toBottomOf="@+id/iv_contact_sync"
                app:layout_constraintEnd_toStartOf="@+id/switch_contact_sync"
                app:layout_constraintStart_toEndOf="@+id/iv_contact_sync"
                app:layout_constraintTop_toTopOf="@+id/iv_contact_sync"
                style="@style/SbTextView.BodyDefault.Mediumempasis.Medium"/>
            <androidx.appcompat.widget.SwitchCompat
                android:theme="@style/SbSwitch.Regular"
                android:id="@+id/switch_contact_sync"
                android:tag="binding_4"
                android:padding="@dimen/item_gap_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                app:layout_constraintBottom_toBottomOf="@+id/tv_sync_contact_data"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_sync_contact_data"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_sync_contact_data_msg"
                android:tag="binding_5"
                android:background="?attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_m"
                android:text="@string/text_privacy_phone_access_sync_instruction"
                app:layout_constraintEnd_toStartOf="@+id/switch_contact_sync"
                app:layout_constraintStart_toStartOf="@+id/tv_sync_contact_data"
                app:layout_constraintTop_toBottomOf="@+id/tv_sync_contact_data"
                style="@style/SbTextView.Caption.Mediumempasis"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btn_learn_more"
                android:tag="binding_6"
                android:background="@null"
                android:padding="@dimen/item_gap_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_12"
                android:text="@string/button_learn_more"
                android:textAllCaps="false"
                app:layout_constraintStart_toStartOf="@+id/tv_sync_contact_data_msg"
                app:layout_constraintTop_toBottomOf="@+id/tv_sync_contact_data_msg"
                style="@style/SbTextView.Caption.Green"/>
            <View
                android:id="@+id/separatedDarkModeMenu"
                android:tag="binding_7"
                android:background="?attr/themeSeparatorGapColor"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_4"
                android:layout_marginTop="@dimen/item_gap_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_learn_more"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_remove_all_contact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_m"
                android:layout_marginStart="@dimen/item_gap_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/separatedDarkModeMenu"
                app:srcCompat="@drawable/ic__cloud_not_connect"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textColor="@color/background_red_delete"
                android:id="@+id/tv_remove_all_contact"
                android:tag="binding_8"
                android:background="?attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/button_privacy_phone_remove_contact"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_24"
                app:layout_constraintBottom_toBottomOf="@+id/iv_remove_all_contact"
                app:layout_constraintEnd_toStartOf="@+id/switch_contact_sync"
                app:layout_constraintStart_toEndOf="@+id/iv_remove_all_contact"
                app:layout_constraintTop_toTopOf="@+id/iv_remove_all_contact"
                style="@style/SbTextView.BodyDefault.Mediumempasis.Medium"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_remove_all_contact_msg"
                android:background="?attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_12"
                android:text="@string/text_privacy_phone_remove_contact"
                app:layout_constraintEnd_toStartOf="@+id/switch_contact_sync"
                app:layout_constraintStart_toStartOf="@+id/tv_remove_all_contact"
                app:layout_constraintTop_toBottomOf="@+id/tv_remove_all_contact"
                style="@style/SbTextView.Caption.Mediumempasis"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>
