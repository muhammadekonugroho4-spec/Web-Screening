<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_detail_shipping_address_0"
    android:background="@drawable/bg_theme_content_gray_border_4"
    android:paddingTop="@dimen/item_gap_22"
    android:paddingBottom="@dimen/item_gap_18"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/item_gap_18"
    android:paddingEnd="@dimen/item_gap_18">
    <TextView
        android:id="@+id/tv_securities_name"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_securities_address"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        app:layout_constraintEnd_toEndOf="@+id/tv_securities_name"
        app:layout_constraintStart_toStartOf="@+id/tv_securities_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_securities_name"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:id="@+id/tv_securities_phone"
        android:tag="binding_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        app:layout_constraintEnd_toEndOf="@+id/tv_securities_name"
        app:layout_constraintStart_toStartOf="@+id/tv_securities_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_securities_address"
        style="@style/TypeStyles.BodyRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
