<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_register_trading_jago_activation_0"
    android:background="?attr/colorPrimary"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:background="?attr/themeContentBackground"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:elevation="@dimen/item_gap_null"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/genericToolbar"
            android:paddingLeft="@dimen/item_gap_null"
            android:paddingRight="@dimen/item_gap_null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:contentInsetLeft="@dimen/item_gap_null"
            app:contentInsetStart="@dimen/item_gap_null"
            app:contentInsetStartWithNavigation="@dimen/item_gap_null"
            app:elevation="@dimen/item_gap_null"/>
    </com.google.android.material.appbar.AppBarLayout>
    <ScrollView
        android:id="@+id/sv_jago_activation"
        android:paddingBottom="@dimen/height_22"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintTop_toBottomOf="@+id/appBar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/item_gap_20">
            <ImageView
                android:id="@+id/iv_jago_activation_banner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_40"
                app:layout_constraintEnd_toStartOf="@+id/iv_jago_logo_activation_banner"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="?attr/themeIconStockbitJagoActivationBanner"/>
            <ImageView
                android:id="@+id/iv_jago_logo_activation_banner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_2"
                android:layout_marginStart="@dimen/spacing_24"
                app:layout_constraintBottom_toBottomOf="@+id/iv_jago_activation_banner"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_jago_activation_banner"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_jago_activation_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_32"
                android:text="@string/lbl_jago_activation_title"
                app:layout_constraintTop_toBottomOf="@+id/iv_jago_activation_banner"
                style="@style/TypeStyles.HeadlineRegular"/>
            <TableLayout
                android:id="@+id/tl_jago_activation"
                android:background="@drawable/bg_jago_link_information"
                android:padding="@dimen/item_gap_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_24"
                app:layout_constraintTop_toBottomOf="@+id/tv_jago_activation_title">
                <TableRow>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nama: "
                        android:layout_weight="1"
                        style="@style/TypeStyles.BodyRegular"/>
                    <TextView
                        android:gravity="end"
                        android:id="@+id/tv_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:layout_marginStart="@dimen/item_gap_8"
                        style="@style/TypeStyles.HeadingLarge"/>
                </TableRow>
                <TableRow android:layout_marginTop="@dimen/item_gap_24">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email: "
                        android:layout_weight="1"
                        style="@style/TypeStyles.BodyRegular"/>
                    <TextView
                        android:gravity="end"
                        android:id="@+id/tv_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:layout_marginStart="@dimen/item_gap_8"
                        style="@style/TypeStyles.HeadingLarge"/>
                </TableRow>
                <TableRow android:layout_marginTop="@dimen/item_gap_24">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NIK: "
                        android:layout_weight="2"
                        style="@style/TypeStyles.BodyRegular"/>
                    <TextView
                        android:gravity="end"
                        android:id="@+id/tv_identity_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:layout_marginStart="@dimen/item_gap_8"
                        style="@style/TypeStyles.HeadingLarge"/>
                </TableRow>
                <TableRow android:layout_marginTop="@dimen/item_gap_24">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nomor Telepon: "
                        style="@style/TypeStyles.BodyRegular"/>
                    <TextView
                        android:gravity="end"
                        android:id="@+id/tv_phone_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/item_gap_8"
                        style="@style/TypeStyles.HeadingLarge"/>
                </TableRow>
            </TableLayout>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_jago_activation_disclaimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_24"
                android:text="@string/lbl_jago_activation_disclaimer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tl_jago_activation"
                style="@style/TypeStyles.ParagraphXSmall"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <com.stockbit.uikit.divider.SBDivider
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="@dimen/item_gap_16"
        app:dividerVariant="thin_grey"
        app:layout_constraintTop_toBottomOf="@+id/sv_jago_activation"/>
    <TextView
        android:id="@+id/tv_term_and_condition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider"
        style="@style/TypeStyles.BodyXSmall"/>
    <com.stockbit.uikit.buttons.StickyButton
        android:id="@+id/btn_next"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        android:layout_marginTop="@dimen/item_gap_16"
        android:layout_marginBottom="@dimen/item_gap_20"
        android:text="@string/button_continue"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_term_and_condition"/>
</androidx.constraintlayout.widget.ConstraintLayout>
