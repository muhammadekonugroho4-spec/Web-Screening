<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_row_likers"
    android:tag="layout/item_liker_0"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/clickable_size_64">
    <ImageView
        android:id="@+id/iv_avatar"
        android:tag="binding_1"
        android:layout_width="@dimen/avatar_size_default"
        android:layout_height="@dimen/avatar_size_default"
        android:scaleType="fitXY"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/item_gap_10"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toLeftOf="@+id/vf_follow_unfollow"
        android:layout_toRightOf="@+id/iv_avatar"
        android:layout_centerVertical="true">
        <TextView
            android:id="@+id/name_user"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            style="@style/SbTextView.ListTitle"/>
        <ImageView
            android:id="@+id/iv_verified_badge"
            android:tag="binding_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_xs"
            android:layout_toRightOf="@+id/name_user"
            android:layout_marginStart="@dimen/item_gap_4"
            app:srcCompat="@drawable/ic_verified_green_white_12dp"/>
        <TextView
            android:id="@+id/tv_full_name"
            android:tag="binding_4"
            android:paddingTop="@dimen/item_gap_xxs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_below="@+id/name_user"
            style="@style/SbTextView.ListSubtitle"/>
    </RelativeLayout>
    <ViewFlipper
        android:gravity="right"
        android:orientation="vertical"
        android:id="@+id/vf_follow_unfollow"
        android:tag="binding_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/item_gap_l"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true">
        <Button
            android:textSize="@dimen/text_size_12"
            android:textColor="@color/green_text"
            android:id="@+id/img_item_unfollowed"
            android:tag="binding_6"
            android:background="@drawable/btn_follow_bordered"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/clickable_size_32"
            android:layout_marginTop="@dimen/item_gap_xxs"
            android:text="@string/button_follow"
            style="@style/SbBtnBorderless.Small"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="@dimen/text_size_12"
            android:textColor="?attr/themeButtonFollowing"
            android:id="@+id/img_item_followed"
            android:tag="binding_7"
            android:background="@drawable/btn_following_bordered"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/clickable_size_32"
            android:layout_marginTop="@dimen/item_gap_xxs"
            android:text="@string/button_following"
            style="@style/SbBtnBorderless.Small"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/pb_loading"
            android:layout_width="@dimen/clickable_size_32"
            android:layout_height="@dimen/clickable_size_32"
            style="@style/Base.Widget.AppCompat.ProgressBar"/>
    </ViewFlipper>
    <View
        android:id="@+id/border"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
