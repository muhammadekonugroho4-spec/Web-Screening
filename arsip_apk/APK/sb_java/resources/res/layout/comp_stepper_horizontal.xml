<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="horizontal"
    android:tag="layout/comp_stepper_horizontal_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tv_stepper_first_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_stepper_second_layout"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_stepper_first"
            android:background="@drawable/bg_stepper_inactive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1"
            app:layout_constraintEnd_toEndOf="@+id/tv_stepper_first_desc"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/tv_stepper_first_desc"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/StepperText"/>
        <TextView
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tv_stepper_first_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_stepper_first"
            style="@style/TypeStyles.BodyXSmall"/>
        <View
            android:id="@+id/tv_stepper_first_bridge_last"
            android:background="?attr/themeColorBorder"
            android:layout_width="18dp"
            android:layout_height="1dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_stepper_first"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_stepper_first"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tv_stepper_second_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_stepper_third_layout"
        app:layout_constraintStart_toEndOf="@+id/tv_stepper_first_layout"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_stepper_second"
            android:background="@drawable/bg_stepper_inactive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2"
            app:layout_constraintEnd_toEndOf="@+id/tv_stepper_second_desc"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/tv_stepper_second_desc"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/StepperText"/>
        <TextView
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tv_stepper_second_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_stepper_second"
            style="@style/TypeStyles.BodyXSmall"/>
        <View
            android:id="@+id/tv_stepper_second_bridge_last"
            android:background="?attr/themeColorBorder"
            android:layout_width="18dp"
            android:layout_height="1dp"
            android:layout_marginStart="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_stepper_second"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_stepper_second"/>
        <View
            android:id="@+id/tv_stepper_second_bridge_start"
            android:background="?attr/themeColorBorder"
            android:layout_width="18dp"
            android:layout_height="1dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_stepper_second"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_stepper_second"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tv_stepper_third_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_stepper_fourth_layout"
        app:layout_constraintStart_toEndOf="@+id/tv_stepper_second_layout"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_stepper_third"
            android:background="@drawable/bg_stepper_inactive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3"
            app:layout_constraintEnd_toEndOf="@+id/tv_stepper_third_desc"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/tv_stepper_third_desc"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/StepperText"/>
        <TextView
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tv_stepper_third_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_stepper_third"
            style="@style/TypeStyles.BodyXSmall"/>
        <View
            android:id="@+id/tv_stepper_third_bridge_last"
            android:background="?attr/themeColorBorder"
            android:layout_width="18dp"
            android:layout_height="1dp"
            android:layout_marginStart="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_stepper_third"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_stepper_third"/>
        <View
            android:id="@+id/tv_stepper_third_bridge_start"
            android:background="?attr/themeColorBorder"
            android:layout_width="18dp"
            android:layout_height="1dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_stepper_third"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_stepper_third"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tv_stepper_fourth_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_stepper_last_layout"
        app:layout_constraintStart_toEndOf="@+id/tv_stepper_third_layout"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_stepper_fourth"
            android:background="@drawable/bg_stepper_inactive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4"
            app:layout_constraintEnd_toEndOf="@+id/tv_stepper_fourth_desc"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/tv_stepper_fourth_desc"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/StepperText"/>
        <TextView
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tv_stepper_fourth_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_stepper_fourth"
            style="@style/TypeStyles.BodyXSmall"/>
        <View
            android:id="@+id/tv_stepper_fourth_bridge_last"
            android:background="?attr/themeColorBorder"
            android:layout_width="18dp"
            android:layout_height="1dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_stepper_fourth"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_stepper_fourth"/>
        <View
            android:id="@+id/tv_stepper_fourth_bridge_start"
            android:background="?attr/themeColorBorder"
            android:layout_width="18dp"
            android:layout_height="1dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_stepper_fourth"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_stepper_fourth"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tv_stepper_last_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_stepper_fourth_layout"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_stepper_last"
            android:background="@drawable/ic_stepper_finish_inactive_lightmode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/tv_stepper_last_desc"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="@+id/tv_stepper_last_desc"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/tv_stepper_last_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_stepper_last"
            style="@style/TypeStyles.BodyXSmall"/>
        <View
            android:id="@+id/tv_stepper_last_bridge_start"
            android:background="?attr/themeColorBorder"
            android:layout_width="18dp"
            android:layout_height="1dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_stepper_last"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_stepper_last"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
