<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_parent_bandar_detector"
    android:tag="layout/row_orderbook_bandar_detector_head_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_bandar_detector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/item_gap_20">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/row_height_gradient_bandar"
            android:layout_marginTop="@dimen/item_gap_l"
            android:weightSum="6"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/iv_bandar_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/item_gap_xxxs"
                app:srcCompat="?attr/themeIconBandarDetector1"/>
            <ImageView
                android:id="@+id/iv_bandar_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/item_gap_xxxs"
                app:srcCompat="?attr/themeIconBandarDetector2"/>
            <ImageView
                android:id="@+id/iv_bandar_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/item_gap_xxxs"
                app:srcCompat="?attr/themeIconBandarDetector3"/>
            <ImageView
                android:id="@+id/iv_bandar_4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/item_gap_xxxs"
                app:srcCompat="?attr/themeIconBandarDetector4"/>
            <ImageView
                android:id="@+id/iv_bandar_5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/item_gap_xxxs"
                app:srcCompat="?attr/themeIconBandarDetector5"/>
            <ImageView
                android:id="@+id/iv_bandar_6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:layout_weight="1"
                app:srcCompat="?attr/themeIconBandarDetector6"/>
        </LinearLayout>
        <View
            android:id="@+id/v_separate"
            android:tag="binding_1"
            android:background="@drawable/bg_vertical_stockbit_violet"
            android:layout_width="@dimen/item_gap_xs"
            android:layout_height="@dimen/row_height_indicator_bandar"
            android:layout_marginTop="@dimen/item_gap_s"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <Space
        android:id="@+id/space_row_sub_title_bandar_detector_chart"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_s"
        android:layout_below="@+id/rl_bandar_detector"/>
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:id="@+id/tv_big_dist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_orderbook_summary_big_dist"
        android:layout_below="@+id/space_row_sub_title_bandar_detector_chart"
        android:layout_marginStart="@dimen/item_gap_20"
        style="@style/TypeStyles.BodyXSmall"/>
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:id="@+id/tv_neutral_dist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_orderbook_summary_neutral"
        android:layout_below="@+id/space_row_sub_title_bandar_detector_chart"
        android:layout_centerHorizontal="true"
        style="@style/TypeStyles.BodyXSmall"/>
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:id="@+id/tv_big_acc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_orderbook_broker_summary_big_acc"
        android:layout_below="@+id/space_row_sub_title_bandar_detector_chart"
        android:layout_marginEnd="@dimen/item_gap_20"
        android:layout_alignParentEnd="true"
        style="@style/TypeStyles.BodyXSmall"/>
    <Space
        android:id="@+id/spaceRowSubTitlebandarDetector"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_below="@+id/tv_big_dist"/>
</RelativeLayout>
