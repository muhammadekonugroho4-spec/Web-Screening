<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_orderbook_running_trade_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/v_border3"
        android:background="?attr/themeSeparatorGapColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_8"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/rl_running_trade"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_border3">
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_title_running_Trade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/running_trade_title"
            android:layout_marginStart="@dimen/item_gap_l"
            android:layout_alignParentStart="true"
            style="@style/TypeStyles.HeadingLarge"/>
        <androidx.compose.ui.platform.ComposeView
            android:layout_gravity="center"
            android:id="@+id/compose_running_trade_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@+id/tv_title_running_Trade"
            android:layout_alignBottom="@+id/tv_title_running_Trade"
            android:layout_marginEnd="@dimen/item_gap_16"
            android:layout_alignParentEnd="true"/>
        <com.stockbit.component.runningtrade.main.StockbitRunningTrade
            android:id="@+id/comp_running_trade"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:layout_below="@+id/tv_title_running_Trade"/>
        <ImageView
            android:id="@+id/iv_running_trade_blur"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:layout_marginBottom="@dimen/spacing_20"
            android:src="?attr/themeBackgroundBlurryTable"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:layout_below="@+id/tv_title_running_Trade"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
