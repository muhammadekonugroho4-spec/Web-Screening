<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_small_rounded_gray_outline"
    android:padding="@dimen/item_gap_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_below="@+id/tvSVerificationContent"
    android:layout_marginStart="@dimen/item_gap_20"
    android:layout_marginEnd="@dimen/item_gap_20"
    android:layout_alignParentStart="true"
    android:backgroundTint="?attr/themeColorBorder">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/ivLivenessPreparationIconFirst"
        android:layout_width="@dimen/avatar_size_xs"
        android:layout_height="@dimen/avatar_size_xs"
        android:layout_alignParentStart="true"
        app:srcCompat="@drawable/ic_liveness_sun"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:gravity="center_vertical"
        android:id="@+id/tvLivenessPreparationFirst"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/avatar_size_xs"
        android:text="@string/text_liveness_test_instruction_one"
        android:layout_marginStart="@dimen/item_gap_16"
        android:layout_toEndOf="@+id/ivLivenessPreparationIconFirst"
        style="@style/SbTextView.BodyDefault"/>
    <ImageView
        android:id="@+id/ivLivenessPreparationIconSecond"
        android:layout_width="@dimen/avatar_size_xs"
        android:layout_height="@dimen/avatar_size_xs"
        android:layout_marginTop="@dimen/item_gap_20"
        android:layout_below="@+id/ivLivenessPreparationIconFirst"
        app:srcCompat="@drawable/ic_liveness_phone"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:gravity="center_vertical"
        android:id="@+id/tvLivenessPreparationSecond"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:minHeight="@dimen/avatar_size_xs"
        android:text="@string/text_liveness_test_instruction_two"
        android:layout_below="@+id/ivLivenessPreparationIconFirst"
        android:layout_marginStart="@dimen/item_gap_16"
        android:layout_toEndOf="@+id/ivLivenessPreparationIconSecond"
        style="@style/SbTextView.BodyDefault"/>
    <ImageView
        android:id="@+id/ivLivenessPreparationIconThird"
        android:layout_width="@dimen/avatar_size_xs"
        android:layout_height="@dimen/avatar_size_xs"
        android:layout_marginTop="@dimen/item_gap_20"
        android:layout_below="@+id/ivLivenessPreparationIconSecond"
        app:srcCompat="@drawable/ic_liveness_account"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:gravity="center_vertical"
        android:id="@+id/tvLivenessPreparationThird"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:minHeight="@dimen/avatar_size_xs"
        android:text="@string/text_liveness_test_instruction_three"
        android:layout_below="@+id/ivLivenessPreparationIconSecond"
        android:layout_marginStart="@dimen/item_gap_16"
        android:layout_toEndOf="@+id/ivLivenessPreparationIconThird"
        style="@style/SbTextView.BodyDefault"/>
    <ImageView
        android:id="@+id/ivLivenessPreparationIconFourth"
        android:layout_width="@dimen/avatar_size_xs"
        android:layout_height="@dimen/avatar_size_xs"
        android:layout_marginTop="@dimen/item_gap_20"
        android:layout_below="@+id/ivLivenessPreparationIconThird"
        app:srcCompat="@drawable/ic_liveness_sunglass"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:gravity="center_vertical"
        android:id="@+id/tvLivenessPreparationFourth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:minHeight="@dimen/avatar_size_xs"
        android:text="@string/text_liveness_test_instruction_four"
        android:layout_below="@+id/ivLivenessPreparationIconThird"
        android:layout_marginStart="@dimen/item_gap_16"
        android:layout_toEndOf="@+id/ivLivenessPreparationIconFourth"
        style="@style/SbTextView.BodyDefault"/>
    <ImageView
        android:id="@+id/ivLivenessPreparationIconFifth"
        android:layout_width="@dimen/avatar_size_xs"
        android:layout_height="@dimen/avatar_size_xs"
        android:layout_marginTop="@dimen/item_gap_20"
        android:layout_below="@+id/ivLivenessPreparationIconFourth"
        app:srcCompat="@drawable/ic_liveness_arrow"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:gravity="center_vertical"
        android:id="@+id/tvLivenessPreparationFifth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:minHeight="@dimen/avatar_size_xs"
        android:text="@string/text_liveness_test_instruction_five"
        android:layout_below="@+id/ivLivenessPreparationIconFourth"
        android:layout_marginStart="@dimen/item_gap_16"
        android:layout_toEndOf="@+id/ivLivenessPreparationIconFifth"
        style="@style/SbTextView.BodyDefault"/>
</RelativeLayout>
