<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_main_wellcome_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivFragmentStreamCompanyLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_20"
        android:layout_marginTop="@dimen/clickable_size_16"
        android:layout_marginBottom="@dimen/clickable_size_16"
        android:scaleType="centerInside"
        android:contentDescription="@string/app_name"
        app:layout_constraintDimensionRatio="w,566:221"
        app:layout_constraintLeft_toLeftOf="@+id/vpWellcome"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/themeStockbitLogo"/>
    <com.stockbit.uikit.control.ControlToggleLanguage
        android:id="@+id/ctl_language"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_20"
        app:controlToggleLanguageType="Large"
        app:layout_constraintBottom_toTopOf="@+id/vpWellcome"
        app:layout_constraintEnd_toEndOf="@+id/vpWellcome"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vpWellcome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/item_gap_l"
        android:layout_marginBottom="@dimen/item_gap_l"
        app:layout_constraintBottom_toTopOf="@+id/rlDotIndicator"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivFragmentStreamCompanyLogo"
        app:layout_constraintWidth_max="800dp"/>
    <RelativeLayout
        android:layout_gravity="bottom"
        android:id="@+id/rlDotIndicator"
        android:paddingLeft="@dimen/item_gap_l"
        android:paddingRight="@dimen/item_gap_l"
        android:paddingBottom="@dimen/item_gap_32"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="800dp">
        <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
            android:id="@+id/parentDotsRoot"
            android:layout_width="wrap_content"
            android:layout_height="4dp"
            android:layout_marginBottom="@dimen/item_gap_20"
            android:layout_centerHorizontal="true"
            app:dotsColor="?attr/titleTextColorDowngray"
            app:dotsCornerRadius="8dp"
            app:dotsSize="6dp"
            app:dotsSpacing="4dp"
            app:dotsWidthFactor="3.3"
            app:selectedDotColor="@color/green_text"/>
        <com.stockbit.uikit.buttons.PrimaryButton
            android:id="@+id/btnWellcomeSignIn"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_m"
            android:layout_marginTop="@dimen/item_gap_41"
            android:layout_marginRight="@dimen/item_gap_m"
            android:layout_marginBottom="@dimen/item_gap_s"
            android:text="@string/button_signup"
            android:layout_below="@+id/parentDotsRoot"
            android:textAllCaps="false"/>
        <com.stockbit.uikit.buttons.FloatingButton
            android:textStyle="bold"
            android:id="@+id/btnWellcomeLogIn"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_m"
            android:layout_marginTop="@dimen/item_gap_8"
            android:layout_marginRight="@dimen/item_gap_m"
            android:layout_marginBottom="@dimen/item_gap_s"
            android:text="@string/button_login"
            android:layout_below="@+id/btnWellcomeSignIn"
            android:textAllCaps="false"
            style="@style/SbBtnBorderless"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
