<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_symbol_list_0"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/view_separator"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_8"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_status"
            android:background="@drawable/bg_green_approved"
            android:paddingTop="@dimen/item_gap_xxs"
            android:paddingBottom="@dimen/item_gap_xxs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:paddingStart="@dimen/item_gap_8"
            android:paddingEnd="@dimen/item_gap_8"
            android:layout_marginStart="@dimen/item_gap_18">
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/text_size_12"
                android:id="@+id/tv_status"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/SbTextView.BodyDefault"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_status"
                android:layout_width="@dimen/item_gap_11"
                android:layout_height="@dimen/item_gap_11"
                android:layout_marginStart="@dimen/item_gap_xs"
                app:srcCompat="@drawable/ic_info_fee"
                app:tint="@color/red_item"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_stock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_10"
            android:layout_marginStart="@dimen/item_gap_18"
            android:layout_marginEnd="@dimen/item_gap_18">
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:tag="binding_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/item_gap_xxs"
                    style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
                <TextView
                    android:textColor="?attr/titleTextColorHighgray"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/code"
                    style="@style/SbTextView.Caption.Highgray"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="center"
                    android:tag="binding_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/item_gap_xxs"
                    style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
                <TextView
                    android:textColor="?attr/titleTextColorHighgray"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/total_shares"
                    style="@style/SbTextView.Caption.Highgray"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <androidx.appcompat.widget.AppCompatTextView
                    android:gravity="end"
                    android:tag="binding_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/item_gap_xxs"
                    style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
                <TextView
                    android:textColor="?attr/titleTextColorHighgray"
                    android:gravity="end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/price"
                    style="@style/SbTextView.Caption.Highgray"/>
            </LinearLayout>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_arrow"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/item_gap_10"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_4"
                app:srcCompat="@drawable/ic_chevron_right"
                app:tint="?attr/titleTextColorHighgray"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/view_border"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_18"
        android:layout_marginBottom="@dimen/item_gap_xxxs"
        android:layout_below="@+id/ll_top"/>
</RelativeLayout>
