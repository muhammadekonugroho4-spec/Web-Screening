<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_avatar_preview_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_20"
        android:layout_marginStart="@dimen/spacing_20"
        app:srcCompat="@drawable/photo_view_ic_close"/>
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_preview"
        android:layout_width="@dimen/photoview_profile_preview_size"
        android:layout_height="@dimen/photoview_profile_preview_size"
        android:layout_centerInParent="true"
        app:shapeAppearanceOverlay="@style/UikitCircleImageView"/>
</RelativeLayout>
