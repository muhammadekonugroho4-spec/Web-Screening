<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_mutual_fund_manager"
    android:tag="layout/comp_mutual_fund_manager_0"
    android:background="@drawable/border_black_square"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/item_gap_l"
    android:layout_marginRight="@dimen/item_gap_l"
    android:layout_marginBottom="@dimen/item_gap_l">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide_divider_centre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <Space
        android:id="@+id/space_top"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_24"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_fund_manager_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/lbl_mutual_fund_investing_manager"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/guide_divider_centre"
        app:layout_constraintTop_toBottomOf="@+id/space_top"
        style="@style/SbTextView.CaptionSecondary"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_custodian_bank_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/lbl_mutual_fund_custudian_bank"
        app:layout_constraintLeft_toRightOf="@+id/guide_divider_centre"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/space_top"
        style="@style/SbTextView.CaptionSecondary"/>
    <ImageView
        android:id="@+id/iv_fund_manager"
        android:padding="@dimen/item_gap_m"
        android:layout_width="0dp"
        android:layout_height="@dimen/clickable_size_48"
        android:scaleType="fitCenter"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/guide_divider_centre"
        app:layout_constraintTop_toBottomOf="@+id/tv_fund_manager_label"/>
    <ImageView
        android:id="@+id/iv_custodian_bank_image"
        android:padding="@dimen/item_gap_m"
        android:layout_width="0dp"
        android:layout_height="@dimen/clickable_size_48"
        app:layout_constraintLeft_toRightOf="@+id/guide_divider_centre"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_custodian_bank_label"/>
    <Space
        android:id="@+id/spaceMutualFundManagerImageSpace"
        android:layout_width="0dp"
        android:layout_height="@dimen/clickable_size_48"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_custodian_bank_label"/>
    <View
        android:id="@+id/view_divider_centre"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_24"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spaceMutualFundManagerImageSpace"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="vertical"
        android:id="@+id/rv_fund_manager_more_info"
        android:paddingTop="@dimen/item_gap_s"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_divider_centre"/>
    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_24"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_fund_manager_more_info"/>
</androidx.constraintlayout.widget.ConstraintLayout>
