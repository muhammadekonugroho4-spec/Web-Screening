<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentScreenerFinancialMetricRowRoot"
    android:tag="layout/row_financial_metric_0"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/clickable_size_48">
    <TextView
        android:id="@+id/tvFinancialMetricName"
        android:paddingLeft="@dimen/item_gap_l"
        android:paddingTop="@dimen/item_gap_s"
        android:paddingRight="@dimen/item_gap_l"
        android:paddingBottom="@dimen/item_gap_s"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/tvFinancialMetricParent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SbTextView.BodyDefault"/>
    <TextView
        android:id="@+id/tvFinancialMetricParent"
        android:paddingLeft="@dimen/item_gap_l"
        android:paddingRight="@dimen/item_gap_l"
        android:paddingBottom="@dimen/item_gap_s"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/viewScreenerFinancialMetricRowLine"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/ivRowArrow"
        app:layout_constraintTop_toBottomOf="@+id/tvFinancialMetricName"
        style="@style/SbTextView.CaptionSecondary"/>
    <ImageView
        android:id="@+id/ivRowArrow"
        android:padding="@dimen/item_gap_xxs"
        android:layout_width="@dimen/clickable_size_24"
        android:layout_height="@dimen/clickable_size_24"
        android:layout_marginRight="@dimen/item_gap_m"
        android:scaleType="centerInside"
        android:rotation="180"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/back_toolbar"/>
    <View
        android:id="@+id/viewScreenerFinancialMetricRowLine"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
