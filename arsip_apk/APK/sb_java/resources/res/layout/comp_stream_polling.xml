<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parent_comp_stream_polling_root"
    android:tag="layout/comp_stream_polling_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/themeColorSurfaceDefault"
    app:cardCornerRadius="@dimen/shape_radius_m"
    app:cardElevation="@dimen/item_gap_null"
    app:strokeColor="?attr/themeColorBorder"
    app:strokeWidth="@dimen/item_gap_xxxs">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_comp_stream_polling_logo"
            android:background="@drawable/bg_circle_accent_shade"
            android:padding="@dimen/item_gap_s"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:layout_marginTop="@dimen/item_gap_l"
            android:scaleType="fitCenter"
            android:layout_marginStart="@dimen/item_gap_l"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_polling_icon_black_24dp"
            app:tint="?attr/themeAccent"/>
        <TextView
            android:textColor="?attr/themeColorTextGreen"
            android:id="@+id/tv_comp_stream_polling_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_poll"
            android:layout_marginStart="@dimen/item_gap_s"
            app:layout_constraintBottom_toBottomOf="@+id/iv_comp_stream_polling_logo"
            app:layout_constraintLeft_toRightOf="@+id/iv_comp_stream_polling_logo"
            app:layout_constraintTop_toTopOf="@+id/iv_comp_stream_polling_logo"
            style="@style/TypeStyles.BodyRegular"/>
        <TextView
            android:textColorLink="@color/color_spanned_link"
            android:ellipsize="end"
            android:id="@+id/tv_comp_stream_polling_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_s"
            android:maxLines="5"
            android:paddingEnd="@dimen/item_gap_m"
            android:layout_marginHorizontal="@dimen/item_gap_l"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_comp_stream_polling_logo"
            style="@style/TypeStyles.HeadlineRegular"/>
        <TextView
            android:textColor="?attr/themeColorTextGreen"
            android:id="@+id/tv_comp_stream_polling_show_more_question"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_s"
            android:text="@string/button_read_more"
            android:layout_marginStart="@dimen/item_gap_s"
            android:layout_marginEnd="@dimen/item_gap_l"
            android:paddingHorizontal="@dimen/item_gap_m"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_comp_stream_polling_question"
            style="@style/TypeStyles.BodyRegular"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_polling_options"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_comp_stream_polling_show_more_question"
            app:layout_goneMarginTop="@dimen/item_gap_l"/>
        <TextView
            android:id="@+id/tv_comp_stream_polling_status"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            android:layout_marginStart="@dimen/item_gap_l"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rv_polling_options"
            style="@style/TypeStyles.BodyXSmall.Secondary"/>
        <Space
            android:id="@+id/space_comp_stream_polling_bottom_gap"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/item_gap_l"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_comp_stream_polling_status"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
