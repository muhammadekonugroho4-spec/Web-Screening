<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_agreement"
    android:paddingTop="@dimen/item_gap_30"
    android:paddingBottom="@dimen/item_gap_10"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">
    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/accb"
        android:duplicateParentState="true"
        android:layout_width="@dimen/clickable_size_16"
        android:layout_height="@dimen/clickable_size_16"
        android:button="@drawable/bg_checkbox_square"
        android:layout_marginEnd="@dimen/item_gap_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/actv_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/actv_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/accb"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SbTextView.ListTitle.Highempasis.Normal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
