<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_trading_community_existing_member_tnc_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:contentInsetStartWithNavigation="@dimen/spacing_0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:gravity="center_horizontal"
                android:layout_gravity="center"
                android:id="@+id/tv_toolbar_term_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_community_term_condition"
                style="@style/TypeStyles.HeadingLarge"/>
        </androidx.appcompat.widget.Toolbar>
        <ViewFlipper
            android:id="@+id/vf_tnc_trading_community"
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_0"
            android:layout_weight="1">
            <com.stockbit.uikit.control.ControlProgressLoading
                android:layout_gravity="center"
                android:id="@+id/pb_disclaimer_smart_order"
                android:layout_width="@dimen/clickable_size_48"
                android:layout_height="@dimen/clickable_size_48"
                app:progressLoadingSize="large"
                style="@style/Widget.AppCompat.ProgressBar"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_tnc_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.stockbit.tradingcommunity.ui.tnc.TradingCommunityTnCWebView
                    android:id="@+id/wv_community_tnc"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <View
                    android:background="?attr/themeColorDividerThin"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/spacing_16"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/spacing_20">
                    <com.stockbit.uikit.control.ControlCheckbox
                        android:id="@+id/ccb_community_tnc_agreement"
                        android:layout_width="@dimen/width_24"
                        android:layout_height="@dimen/height_24"
                        app:checkBoxType="box"/>
                    <TextView
                        android:id="@+id/tv_community_tnc_agreement"
                        android:layout_width="@dimen/spacing_0"
                        android:layout_height="wrap_content"
                        android:text="@string/desc_trading_community_existing_member_term_condition"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/spacing_12"
                        style="@style/TypeStyles.BodySmall"/>
                </LinearLayout>
                <com.stockbit.uikit.button.PrimaryButton
                    android:id="@+id/btn_community_tnc_continue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_12"
                    android:layout_marginBottom="@dimen/item_gap_20"
                    android:text="@string/action_community_tnc_continue"
                    android:layout_marginHorizontal="@dimen/item_gap_20"
                    android:paddingHorizontal="@dimen/spacing_20"
                    android:paddingVertical="@dimen/spacing_12"
                    app:primaryButtonActive="false"
                    app:primaryButtonSize="defaultSize"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:id="@+id/parent_clickable_reload_existing_member_tnc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/iv_reload_existing_member_tnc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/btn_tap_to_refresh"
                    app:srcCompat="?attr/themeIconErrorAcademy"/>
                <TextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:id="@+id/tv_error_cause_existing_member_tnc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_4"
                    style="@style/TypeStyles.BodyRegular"/>
                <TextView
                    android:id="@+id/tv_error_try_again"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_12"
                    android:text="@string/button_try_again"
                    android:drawablePadding="@dimen/spacing_4"
                    app:drawableStartCompat="@drawable/ic_try_again_two_arrows"
                    style="@style/TypeStyles.HeadingSmall.Green"/>
            </LinearLayout>
        </ViewFlipper>
    </LinearLayout>
    <View
        android:id="@+id/v_loading_overlay"
        android:background="@color/tc_loading_overlay_background"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.stockbit.uikit.control.ControlProgressLoading
        android:layout_gravity="center"
        android:id="@+id/pb_activation_loading"
        android:visibility="gone"
        android:layout_width="@dimen/clickable_size_48"
        android:layout_height="@dimen/clickable_size_48"
        app:progressLoadingSize="large"
        style="@style/Widget.AppCompat.ProgressBar"/>
</FrameLayout>
