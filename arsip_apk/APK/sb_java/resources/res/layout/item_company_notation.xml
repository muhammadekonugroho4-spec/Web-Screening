<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_company_notation_0"
    android:background="?attr/themeDialogBackgroundColor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/clickable_size_48">
    <RelativeLayout
        android:id="@+id/rl_notation_image"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_notation_icon"
            android:layout_width="@dimen/clickable_size_20"
            android:layout_height="@dimen/clickable_size_20"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:contentDescription="@null"/>
    </RelativeLayout>
    <RelativeLayout
        android:orientation="vertical"
        android:paddingTop="@dimen/item_gap_xxs"
        android:paddingBottom="@dimen/item_gap_s"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/clickable_size_48"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/rl_notation_image"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:id="@+id/view_divider"
            android:background="?attr/titleTextColorDowngray"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_marginBottom="@dimen/item_gap_m"
            android:layout_alignParentTop="true"
            android:layout_marginStart="@dimen/item_gap_l"/>
        <TextView
            android:textSize="@dimen/text_size_14"
            android:ellipsize="end"
            android:gravity="top"
            android:id="@+id/tv_notation_title"
            android:paddingLeft="@dimen/item_gap_l"
            android:paddingRight="@dimen/item_gap_null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/view_divider"
            android:layout_centerVertical="true"
            android:textAlignment="gravity"
            style="@style/SbTextView.BodyDefault"/>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
