<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/user_profile_more_option_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/parentBaseBottomSheetDialogHeader"
        android:background="@drawable/bg_top_rounded_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/item_gap_l"/>
    <RelativeLayout
        android:id="@+id/parentBaseBottomSheetDialogBody"
        android:background="?attr/themeDialogBackgroundColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/clickable_size_72"
        android:layout_below="@+id/parentBaseBottomSheetDialogHeader">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ln_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/ivUserProfileMoreMenuAvatar"
                    android:tag="binding_1"
                    android:layout_width="@dimen/avatar_size_default"
                    android:layout_height="@dimen/avatar_size_default"
                    android:layout_marginStart="@dimen/item_gap_20"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/item_gap_8">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tvUserProfileMoreMenuUsername"
                            android:tag="binding_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/item_gap_xxs"
                            style="@style/SbTextView.ListTitle"/>
                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_gravity="start|center_vertical"
                            android:id="@+id/iv_verified_badge"
                            android:tag="binding_3"
                            android:layout_width="@dimen/item_gap_13"
                            android:layout_height="@dimen/item_gap_13"
                            android:scaleType="center"
                            android:foregroundGravity="bottom"
                            android:layout_marginStart="@dimen/item_gap_s"
                            app:srcCompat="@drawable/ic_verified_green_white_12dp"/>
                    </LinearLayout>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:textColor="?attr/themeSemiMediumEmphasis"
                        android:id="@+id/tvUserProfileMoreMenuFullName"
                        android:tag="binding_4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/item_gap_xxs"
                        style="@style/SbTextView.BodyDefault.Mediumempasis.Medium"/>
                </LinearLayout>
                <RelativeLayout
                    android:id="@+id/rl_close"
                    android:tag="binding_5"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/clickable_size_48">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_close"
                        android:focusable="false"
                        android:clickable="false"
                        android:layout_width="@dimen/clickable_size_12"
                        android:layout_height="@dimen/clickable_size_12"
                        android:layout_marginTop="@dimen/item_gap_4"
                        android:scaleType="fitXY"
                        android:layout_centerInParent="false"
                        android:layout_marginEnd="@dimen/item_gap_20"
                        app:srcCompat="0x7f080644"/>
                </RelativeLayout>
            </LinearLayout>
            <View
                android:id="@+id/viewUserProfileMoreMenuSeparator"
                android:background="?attr/titleTextColorDowngray"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_xxxs"
                android:layout_marginTop="@dimen/item_gap_l"
                android:layout_below="@+id/ln_header"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvUserProfileMoreMenu"
                android:tag="binding_6"
                android:paddingTop="@dimen/item_gap_m"
                android:paddingBottom="@dimen/item_gap_l"
                android:clipToPadding="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/viewUserProfileMoreMenuSeparator"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
