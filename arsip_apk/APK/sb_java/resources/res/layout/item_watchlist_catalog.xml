<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_watchlist_catalog_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tvItemCatalogSectionTitle"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_l"
        android:layout_marginTop="@dimen/clickable_size_24"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyRegular"/>
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupItemCatalogSection"
        android:paddingLeft="@dimen/item_gap_l"
        android:paddingTop="@dimen/item_gap_m"
        android:paddingRight="@dimen/item_gap_l"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/clickable_size_72"
        app:chipSpacingHorizontal="@dimen/item_gap_m"
        app:chipSpacingVertical="@dimen/item_gap_m"
        app:layout_constraintTop_toBottomOf="@+id/tvItemCatalogSectionTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
