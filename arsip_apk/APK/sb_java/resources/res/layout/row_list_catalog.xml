<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_catalog_parent"
    android:tag="layout/row_list_catalog_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/height_65"
    android:foreground="?attr/selectableItemBackground">
    <ImageView
        android:id="@+id/iv_catalog_company_logo"
        android:layout_width="@dimen/icon_placeholder_32"
        android:layout_height="@dimen/icon_placeholder_32"
        android:layout_marginStart="@dimen/spacing_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_catalog_company_symbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="@dimen/item_gap_8"
        app:layout_constraintBottom_toTopOf="@+id/tv_catalog_company_name"
        app:layout_constraintStart_toEndOf="@+id/iv_catalog_company_logo"
        app:layout_constraintTop_toTopOf="@+id/iv_catalog_company_logo"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/TypeStyles.HeadingLarge"/>
    <TextView
        android:id="@+id/tv_notation_list"
        android:background="@drawable/bg_special_notation_list"
        android:paddingTop="@dimen/item_gap_2"
        android:paddingBottom="@dimen/item_gap_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/item_gap_12"
        android:layout_marginBottom="1dp"
        android:minWidth="@dimen/item_gap_12"
        android:includeFontPadding="false"
        android:textAlignment="center"
        android:layout_marginStart="@dimen/item_gap_s"
        android:paddingHorizontal="@dimen/item_gap_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_catalog_company_symbol"
        app:layout_constraintStart_toEndOf="@+id/tv_catalog_company_symbol"
        app:layout_constraintTop_toTopOf="@+id/tv_catalog_company_symbol"/>
    <TextView
        android:textSize="@dimen/text_size_8"
        android:textColor="?attr/themeColorPeachDefault"
        android:id="@+id/tv_notation_uma"
        android:background="@drawable/bg_border_peach"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_s"
        android:layout_marginBottom="1dp"
        android:text="@string/uma"
        android:singleLine="true"
        android:paddingHorizontal="@dimen/item_gap_s"
        android:paddingVertical="@dimen/item_gap_xxs"
        app:layout_constraintBottom_toBottomOf="@+id/tv_catalog_company_symbol"
        app:layout_constraintStart_toEndOf="@+id/tv_notation_list"
        app:layout_constraintTop_toTopOf="@+id/tv_catalog_company_symbol"
        style="@style/SbTextView.CaptionSecondary.Bold"/>
    <TextView
        android:textSize="@dimen/text_size_8"
        android:textColor="@color/google_red"
        android:id="@+id/tv_catalog_company_status"
        android:background="@drawable/border_red"
        android:paddingTop="@dimen/item_gap_xxs"
        android:paddingBottom="@dimen/item_gap_xs"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_s"
        android:layout_marginBottom="1dp"
        android:singleLine="true"
        android:paddingHorizontal="@dimen/item_gap_s"
        app:layout_constraintBottom_toBottomOf="@+id/tv_catalog_company_symbol"
        app:layout_constraintStart_toEndOf="@+id/tv_notation_uma"
        app:layout_constraintTop_toTopOf="@+id/tv_catalog_company_symbol"
        style="@style/SbTextView.CaptionSecondary.Bold"/>
    <include
        android:id="@+id/layout_day_trade_multiplier"
        android:visibility="gone"
        android:layout_width="@dimen/width_35"
        android:layout_height="@dimen/spacing_16"
        android:layout_marginStart="@dimen/spacing_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_catalog_company_symbol"
        app:layout_constraintStart_toEndOf="@+id/tv_catalog_company_status"
        app:layout_constraintTop_toTopOf="@+id/tv_catalog_company_symbol"
        layout="@layout/securities_comp_day_trade_multiplier_square"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_size_12"
        android:textColor="?attr/themeColorOliveDefault"
        android:gravity="center"
        android:id="@+id/tv_trading_limit"
        android:background="@drawable/bg_trading_limit"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_20"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/spacing_4"
        android:paddingHorizontal="@dimen/spacing_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_catalog_company_symbol"
        app:layout_constraintStart_toEndOf="@+id/layout_day_trade_multiplier"
        app:layout_constraintTop_toTopOf="@+id/tv_catalog_company_symbol"
        style="@style/TypeStyles.HeadingXSmall"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_size_12"
        android:textColor="?attr/themeColorPinkDefault"
        android:gravity="center"
        android:id="@+id/tv_margin_trading"
        android:background="@drawable/bg_margin_trading"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_16"
        android:includeFontPadding="false"
        android:layout_marginStart="@dimen/spacing_4"
        android:paddingHorizontal="@dimen/spacing_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_catalog_company_symbol"
        app:layout_constraintStart_toEndOf="@+id/tv_trading_limit"
        app:layout_constraintTop_toTopOf="@+id/tv_catalog_company_symbol"
        style="@style/TypeStyles.HeadingXSmall"/>
    <TextView
        android:textSize="@dimen/text_size_8"
        android:textColor="@color/green_text"
        android:id="@+id/tv_catalog_new"
        android:background="@drawable/border_green_rounded_4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_4"
        android:layout_marginBottom="1dp"
        android:text="@string/label_new"
        android:contentDescription="@string/CATALOG_2"
        android:paddingHorizontal="@dimen/item_gap_5"
        android:paddingVertical="@dimen/item_gap_xxs"
        app:layout_constraintBottom_toBottomOf="@+id/tv_catalog_company_symbol"
        app:layout_constraintStart_toEndOf="@+id/tv_margin_trading"
        app:layout_constraintTop_toTopOf="@+id/tv_catalog_company_symbol"
        style="@style/SbTextView.CaptionSecondary.Bold"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_catalog_company_name"
        android:layout_width="@dimen/item_gap_null"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_1"
        android:singleLine="true"
        android:layout_marginEnd="@dimen/spacing_48"
        app:layout_constraintBottom_toBottomOf="@+id/iv_catalog_company_logo"
        app:layout_constraintEnd_toStartOf="@+id/percentage"
        app:layout_constraintStart_toStartOf="@+id/tv_catalog_company_symbol"
        app:layout_constraintTop_toBottomOf="@+id/tv_catalog_company_symbol"
        style="@style/TypeStyles.BodyXSmall"/>
    <TextView
        android:gravity="end"
        android:id="@+id/last_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/width_104"
        android:maxLines="1"
        android:textAlignment="gravity"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_catalog_company_symbol"
        style="@style/TypeStyles.HeadingLarge"/>
    <TextView
        android:gravity="end"
        android:id="@+id/percentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/width_104"
        android:maxLines="1"
        android:textAlignment="gravity"
        app:layout_constraintBottom_toBottomOf="@+id/tv_catalog_company_name"
        app:layout_constraintEnd_toEndOf="@+id/last_value"
        app:layout_constraintTop_toBottomOf="@+id/last_value"
        style="@style/TypeStyles.BodyRegular"/>
    <View
        android:id="@+id/border"
        android:background="?attr/themeColorDividerThin"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
