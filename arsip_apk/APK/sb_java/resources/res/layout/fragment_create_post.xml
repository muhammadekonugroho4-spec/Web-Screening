<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_stream_create_post"
    android:tag="layout/fragment_create_post_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/ab_stream_create_post"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        app:contentInsetStart="@dimen/item_gap_null"
        style="@style/Sb.Widget.AppBar">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:paddingLeft="@dimen/item_gap_null"
            android:paddingRight="@dimen/item_gap_null"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:contentInsetLeft="@dimen/item_gap_null"
            app:contentInsetStart="@dimen/item_gap_null"
            app:contentInsetStartWithNavigation="@dimen/item_gap_null"
            app:elevation="@dimen/item_gap_null">
            <RelativeLayout
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="?attr/actionBarSize">
                <TextView
                    android:gravity="center"
                    android:id="@+id/tv_compose_post_title"
                    android:tag="binding_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerHorizontal="true"
                    android:layout_centerVertical="true"
                    android:textAlignment="gravity"
                    style="@style/TypeStyles.HeadingLarge"/>
            </RelativeLayout>
            <com.stockbit.uikit.button.FloatingButton
                android:layout_gravity="end"
                android:id="@+id/btn_compose_post_submit"
                android:tag="binding_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/spacing_0"
                android:includeFontPadding="false"
                android:textAllCaps="false"
                android:paddingHorizontal="@dimen/spacing_0"
                app:floatingButtonSize="defaultSize"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@+id/view_compose_separator"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <RelativeLayout
                android:id="@+id/parent_compose_post_content_creator_container"
                android:tag="binding_3"
                android:paddingBottom="@dimen/item_gap_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/iv_avatar"
                        android:tag="binding_4"
                        android:layout_width="@dimen/width_48"
                        android:layout_height="@dimen/height_48"
                        android:layout_marginTop="@dimen/item_gap_20"
                        android:contentDescription="@string/user_profile_photo"
                        android:layout_marginHorizontal="@dimen/item_gap_20"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:id="@+id/tv_username"
                        android:tag="binding_5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/item_gap_12"
                        app:layout_constraintStart_toEndOf="@+id/iv_avatar"
                        app:layout_constraintTop_toTopOf="@+id/iv_avatar"
                        style="@style/TypeStyles.HeadingLarge"/>
                    <TextView
                        android:textColor="?attr/themeColorTextSecondary"
                        android:id="@+id/tv_setting_comment"
                        android:tag="binding_6"
                        android:background="@drawable/bg_rounded_20_transparent_downgray"
                        android:paddingTop="@dimen/item_gap_4"
                        android:paddingBottom="@dimen/item_gap_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/button_comment_setting"
                        android:drawablePadding="@dimen/item_gap_s"
                        android:layout_marginStart="@dimen/item_gap_12"
                        android:paddingHorizontal="@dimen/item_gap_8"
                        app:drawableLeftCompat="@drawable/ic_post_global"
                        app:drawableRightCompat="@drawable/ic_arrow_profile"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_avatar"
                        app:layout_constraintStart_toEndOf="@+id/iv_avatar"
                        app:layout_constraintTop_toBottomOf="@+id/tv_username"
                        style="@style/TypeStyles.BodyXXSmall"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.stockbit.common.uikit.StockbitStreamEditText
                    android:textSize="@dimen/text_size_16"
                    android:textColor="?attr/themeColorTextPrimary"
                    android:textColorHint="?attr/themeContentTextColorSecondary"
                    android:layout_gravity="bottom"
                    android:id="@+id/et_compose_post_content"
                    android:tag="binding_7"
                    android:background="@color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_m"
                    android:layout_marginBottom="@dimen/item_gap_32"
                    android:minHeight="@dimen/clickable_size_32"
                    android:hint="@string/placeholder_compose"
                    android:layout_below="@+id/cl_profile"
                    android:inputType="textMultiLine"
                    android:dropDownWidth="match_parent"
                    android:paddingHorizontal="@dimen/item_gap_l"
                    android:paddingVertical="@dimen/item_gap_6"
                    style="@style/SbEditTextStyle"/>
                <androidx.cardview.widget.CardView
                    android:id="@+id/parent_youtube_preview"
                    android:tag="binding_8"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/item_gap_l"
                    android:layout_marginTop="@dimen/item_gap_m"
                    android:layout_marginRight="@dimen/item_gap_l"
                    android:layout_below="@+id/et_compose_post_content"
                    app:cardCornerRadius="4dp"
                    app:cardElevation="@dimen/item_gap_null">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/parent_stream_item_youtube_preview_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/iv_youtube_thumb"
                            android:background="@drawable/bg_image_placeholder"
                            android:focusable="true"
                            android:visibility="visible"
                            android:clickable="true"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:scaleType="centerCrop"
                            app:layout_constraintDimensionRatio="v,16:9"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <ImageView
                            android:id="@+id/iv_play_youtube"
                            android:tag="binding_9"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_play_video"
                            app:layout_constraintBottom_toBottomOf="@+id/iv_youtube_thumb"
                            app:layout_constraintEnd_toEndOf="@+id/iv_youtube_thumb"
                            app:layout_constraintStart_toStartOf="@+id/iv_youtube_thumb"
                            app:layout_constraintTop_toTopOf="@+id/iv_youtube_thumb"/>
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:orientation="vertical"
                            android:background="?attr/themeSeparatorGapColor"
                            android:paddingTop="@dimen/item_gap_8"
                            android:paddingBottom="@dimen/item_gap_8"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="@dimen/item_gap_12"
                            android:paddingEnd="@dimen/item_gap_12"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/iv_youtube_thumb">
                            <TextView
                                android:id="@+id/tv_youtube_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/item_gap_8"
                                style="@style/SbTextView.ListTitle.Highempasis.Bold"/>
                            <TextView
                                android:id="@+id/tv_youtube_provider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                style="@style/SbTextView.ListTitle.Highempasis.Normal"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
                <androidx.recyclerview.widget.RecyclerView
                    android:orientation="horizontal"
                    android:id="@+id/rv_compose_post_attached_media"
                    android:tag="binding_10"
                    android:clipToPadding="false"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_m"
                    android:layout_below="@+id/parent_youtube_preview"
                    android:paddingHorizontal="8dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_publish_attached_files"
                    android:tag="binding_11"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/item_gap_l"
                    android:layout_marginTop="@dimen/item_gap_m"
                    android:layout_marginRight="@dimen/item_gap_l"
                    android:layout_below="@+id/rv_compose_post_attached_media"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/shape_radius_m"
                    app:cardElevation="@dimen/item_gap_null"
                    app:strokeColor="?attr/themeSeparatorGapColor"
                    app:strokeWidth="@dimen/item_gap_1">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/parent_document_layout"
                        android:visibility="visible"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/avatar_size_52">
                        <ImageView
                            android:id="@+id/iv_document_img"
                            android:tag="binding_12"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/item_gap_16"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <TextView
                            android:ellipsize="middle"
                            android:gravity="center_vertical"
                            android:id="@+id/tv_publish_attached_files"
                            android:tag="binding_13"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/btn_new_update_upload_docs"
                            android:maxLines="1"
                            android:textAlignment="gravity"
                            android:layout_marginStart="@dimen/item_gap_12"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/btn_delete_attached_files"
                            app:layout_constraintStart_toEndOf="@+id/iv_document_img"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/SbTextView.BodyDefault"/>
                        <ImageButton
                            android:id="@+id/btn_delete_attached_files"
                            android:tag="binding_14"
                            android:layout_width="@dimen/clickable_size_48"
                            android:layout_height="0dp"
                            android:scaleType="fitEnd"
                            android:paddingEnd="@dimen/item_gap_16"
                            android:paddingVertical="@dimen/item_gap_18"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="0x7f08063f"
                            app:tint="@color/highgray_light"
                            style="@style/Base.Widget.AppCompat.Button.Borderless"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.stockbit.stream.component.targetprice.StockBitTargetPriceComposer
                    android:id="@+id/card_publish_target_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_m"
                    android:layout_marginBottom="@dimen/item_gap_m"
                    android:layout_below="@+id/card_publish_attached_files"/>
                <include
                    android:id="@+id/layoutSharePostReposted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/item_gap_l"
                    android:layout_marginTop="@dimen/item_gap_m"
                    android:layout_marginRight="@dimen/item_gap_l"
                    android:layout_below="@+id/card_publish_target_price"
                    layout="@layout/repost_post_layout"/>
                <include
                    android:id="@+id/layout_updated_stream"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_m"
                    android:layout_below="@+id/card_publish_target_price"
                    android:layout_marginHorizontal="@dimen/item_gap_l"
                    layout="@layout/repost_post_layout"/>
                <com.stockbit.stream.component.polling.StockbitPollingStubs
                    android:id="@+id/vs_publish_create_polling"
                    android:tag="binding_15"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/item_gap_l"
                    android:layout_marginTop="@dimen/item_gap_m"
                    android:layout_marginRight="@dimen/item_gap_l"
                    android:layout_marginBottom="@dimen/item_gap_l"
                    android:layout_below="@+id/et_compose_post_content"/>
            </RelativeLayout>
        </androidx.core.widget.NestedScrollView>
        <View
            android:id="@+id/view_compose_separator"
            android:background="?attr/themeColorDividerThin"
            android:layout_width="0dp"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_marginBottom="@dimen/stream_spacing_10"
            app:layout_constraintBottom_toTopOf="@+id/vf_compose_post_add_image_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <ViewFlipper
            android:id="@+id/vf_compose_post_add_image_container"
            android:tag="binding_16"
            android:layout_width="@dimen/spacing_24"
            android:layout_height="@dimen/spacing_24"
            android:layout_marginBottom="@dimen/stream_spacing_10"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/item_gap_l"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/pb_compose_post_loading_upload_feature"
                android:layout_width="@dimen/clickable_size_24"
                android:layout_height="@dimen/clickable_size_24"
                android:indeterminateTint="?attr/themeIconTintColor"/>
            <ImageButton
                android:layout_gravity="center"
                android:id="@+id/ib_compose_post_add_image"
                android:tag="binding_17"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="@dimen/spacing_24"
                android:layout_height="@dimen/spacing_24"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_stream_gallery"/>
            <ImageButton
                android:layout_gravity="center"
                android:id="@+id/ib_compose_post_retry_upload_feature"
                android:tag="binding_18"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="@dimen/spacing_24"
                android:layout_height="@dimen/spacing_24"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_refresh"
                app:tint="?attr/themeIconTintColor"/>
        </ViewFlipper>
        <ViewFlipper
            android:id="@+id/vf_compose_post_add_docs_container"
            android:tag="binding_19"
            android:layout_width="@dimen/spacing_24"
            android:layout_height="@dimen/spacing_24"
            android:layout_marginBottom="@dimen/stream_spacing_10"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/vf_compose_post_add_image_container">
            <ProgressBar
                android:layout_gravity="center"
                android:layout_width="@dimen/clickable_size_24"
                android:layout_height="match_parent"
                android:indeterminate="true"
                android:indeterminateTint="?attr/themeIconTintColor"
                style="@style/Widget.AppCompat.ProgressBar"/>
            <ImageButton
                android:layout_gravity="center"
                android:id="@+id/ib_compose_post_add_docs"
                android:tag="binding_20"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="@dimen/spacing_24"
                android:layout_height="@dimen/spacing_24"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_compose_file_attachment"/>
            <ImageButton
                android:layout_gravity="center"
                android:id="@+id/ib_compose_post_retry_upload_docs_feature"
                android:tag="binding_21"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_width="@dimen/spacing_24"
                android:layout_height="@dimen/spacing_24"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/ic_refresh"
                app:tint="?attr/themeIconTintColor"/>
        </ViewFlipper>
        <androidx.appcompat.widget.AppCompatImageButton
            android:layout_gravity="center"
            android:id="@+id/ib_compose_post_add_gif"
            android:tag="binding_22"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/spacing_24"
            android:layout_height="@dimen/spacing_24"
            android:layout_marginBottom="@dimen/stream_spacing_10"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/vf_compose_post_add_docs_container"
            app:srcCompat="@drawable/ic_compose_gif"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/ib_compose_post_add_polling"
            android:tag="binding_23"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/spacing_24"
            android:layout_height="@dimen/spacing_24"
            android:layout_marginBottom="@dimen/stream_spacing_10"
            android:scaleType="fitCenter"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ib_compose_post_add_gif"
            app:srcCompat="@drawable/ic_compose_polling"/>
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/ib_compose_post_add_target_price"
            android:tag="binding_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/spacing_24"
            android:layout_height="@dimen/spacing_24"
            android:layout_marginBottom="@dimen/stream_spacing_10"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:contentDescription="@string/btn_set_target_price"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/ib_compose_post_add_polling"
            app:srcCompat="@drawable/ic_compose_target_price"
            style="@style/SbBtnBorderless.Small"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
