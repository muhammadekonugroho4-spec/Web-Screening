<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/dialog_watchlist_sort_0"
    android:background="@drawable/bg_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/aciv_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        app:srcCompat="?attr/rectangle_dialog"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/themeTextChatInputColor"
        android:id="@+id/actv_sort_by_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:text="@string/button_sort_by"
        android:layout_below="@+id/aciv_line"
        android:layout_marginStart="@dimen/item_gap_16"
        style="@style/SbTextView.StreamListContent"/>
    <View
        android:id="@+id/v_divider"
        android:background="?attr/themeColorModalsDividerThin"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/item_gap_16"
        android:layout_below="@+id/actv_sort_by_label"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/v_divider">
        <RelativeLayout
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_watchlist_sort_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"
                android:layout_marginHorizontal="@dimen/item_gap_20"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
            <include
                android:id="@+id/error_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_above="@+id/btn_done"
                android:layout_alignParentTop="true"
                layout="@layout/comp_icon_error_view"/>
            <Button
                android:textColor="@color/white"
                android:id="@+id/btn_done"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/button_save"
                android:layout_below="@+id/rv_watchlist_sort_options"
                style="@style/SbBtn.FullWidth"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>
