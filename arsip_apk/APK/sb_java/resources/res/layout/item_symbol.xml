<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/rl_company"
    android:tag="layout/item_symbol_0"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:weightSum="4">
    <TextView
        android:textSize="@dimen/list_item_text_size"
        android:textColor="?attr/themeContentTextColor"
        android:id="@+id/txt_symbol"
        android:tag="binding_1"
        android:layout_width="@dimen/clickable_size_60"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/img_grid_xl"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/item_gap_20"
        style="@style/SbTextView.BodyDefault.Highempasis.Bold"/>
    <TextView
        android:textSize="@dimen/list_item_text_size"
        android:textColor="?attr/titleTextColorHighgray"
        android:id="@+id/txt_company_name"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_s"
        android:layout_toRightOf="@+id/txt_symbol"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/item_gap_s"
        style="@style/SbTextView.BodyDefault"/>
    <View
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_24"
        android:layout_below="@+id/txt_symbol"/>
</RelativeLayout>
