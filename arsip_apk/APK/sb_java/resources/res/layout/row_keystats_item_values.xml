<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_keystats_item_values_0"
    android:paddingTop="@dimen/item_gap_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/item_gap_20">
    <ImageView
        android:id="@+id/iv_green_dot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="@dimen/item_gap_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_green_dot"/>
    <TextView
        android:gravity="start|center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/item_gap_8"
        app:layout_constraintStart_toEndOf="@+id/iv_green_dot"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:gravity="end|center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_value1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/keystat_velue_min_width"
        android:text="@string/n_dash"
        android:layout_marginEnd="@dimen/item_gap_8"
        app:layout_constraintEnd_toStartOf="@+id/tv_value2"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:gravity="end|center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_value2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/keystat_velue_min_width"
        android:text="@string/n_dash"
        android:layout_marginEnd="@dimen/item_gap_8"
        app:layout_constraintEnd_toStartOf="@+id/tv_value3"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:gravity="end|center_vertical"
        android:id="@+id/tv_value3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/keystat_velue_min_width"
        android:text="@string/n_dash"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyRegular"/>
</androidx.constraintlayout.widget.ConstraintLayout>
