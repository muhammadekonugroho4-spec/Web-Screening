        <View
            android:id="@+id/v_broker_name"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="@dimen/height_20"
            android:layout_margin="@dimen/spacing_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FBShimmerItem"/>
        <View
            android:id="@+id/v_divider_broker_name"
            android:background="?attr/themeColorBorder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_1"
            android:layout_margin="@dimen/spacing_16"
            app:layout_constraintTop_toBottomOf="@+id/v_broker_name"/>
        <View
            android:id="@+id/v_investor_type"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="@dimen/height_20"
            android:layout_margin="@dimen/spacing_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/v_divider_investor_and_market_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_divider_broker_name"
            style="@style/FBShimmerItem"/>
