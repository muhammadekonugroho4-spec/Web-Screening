<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_securities_landing_pending_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/flTradngLandingPinHeader"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Sb.Widget.AppBar">
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/landingTradingToolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"/>
            <View
                android:background="?attr/themeColorDividerThin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_xxxs"/>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center"
            android:id="@+id/parentMainLoginTradingSelectedBroker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/iv_stockbit_securities"
                android:padding="@dimen/item_gap_xs"
                android:layout_width="@dimen/item_gap_80"
                android:layout_height="@dimen/item_gap_46"
                android:src="?attr/themeSplashScreenDrawable"
                android:scaleType="centerInside"
                android:layout_centerVertical="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nsv_incomplete"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flTradngLandingPinHeader">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_incomplete"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/item_gap_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.45">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/aciv_illustration"
                android:layout_width="214dp"
                android:layout_height="214dp"
                android:src="@drawable/il_register_1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tvWellcomeTitle"
                android:padding="@dimen/item_gap_s"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_24"
                android:text="Registrasi Kamu Dalam Proses"
                android:textAlignment="gravity"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/aciv_illustration"
                style="@style/SbTextView.PageTitle"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tvWellcomeSubtitle"
                android:paddingLeft="@dimen/item_gap_l"
                android:paddingRight="@dimen/item_gap_l"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/item_gap_l"
                android:text="Mohon ditunggu sebentar lagi. Registrasi kamu masih dalam tahap verifikasi."
                android:layout_alignParentBottom="true"
                android:textAlignment="gravity"
                app:layout_constraintTop_toBottomOf="@+id/tvWellcomeTitle"
                style="@style/SbTextView.ListSubtitle.Secondary"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.stockbit.uikit.buttons.SecondaryButton
            android:id="@+id/btn_virtual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/width_100"
            android:layout_marginBottom="@dimen/item_gap_50"
            android:text="@string/btn_try_virtual_trading"
            android:layout_marginStart="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/item_gap_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
