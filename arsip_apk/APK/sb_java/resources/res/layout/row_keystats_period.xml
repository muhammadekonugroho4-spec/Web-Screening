<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_keystats_period_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/item_gap_20"
        android:paddingEnd="@dimen/item_gap_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_period"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/period_row_height"
            android:text="@string/keystats_period_header"
            android:drawablePadding="@dimen/item_gap_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_q1"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/period_row_height"
            android:text="@string/keystats_q1_header"
            android:drawablePadding="@dimen/item_gap_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_q2"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/period_row_height"
            android:text="@string/keystats_q2_header"
            android:drawablePadding="@dimen/item_gap_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_q3"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/period_row_height"
            android:text="@string/keystats_q3_header"
            android:drawablePadding="@dimen/item_gap_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_q4"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/period_row_height"
            android:text="@string/keystats_q4_header"
            android:drawablePadding="@dimen/item_gap_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_annualised"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/period_row_height"
            android:text="@string/keystats_annualised_header"
            android:drawablePadding="@dimen/item_gap_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_ttm"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/period_row_height"
            android:drawablePadding="@dimen/item_gap_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingRegular"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/rv_period"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingEnd="@dimen/item_gap_20"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="@+id/ll_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/barrier"
        app:layout_constraintTop_toTopOf="@+id/ll_header"/>
    <View
        android:id="@+id/divider"
        android:background="?attr/themeColorDividerGreyBorder"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/item_gap_10"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_period"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_14"
        android:paddingStart="@dimen/item_gap_20"
        android:paddingEnd="@dimen/item_gap_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/divider">
        <TextView
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_dividend"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/period_row_height"
            android:text="@string/keystats_dividend_header"
            android:drawablePadding="@dimen/spacing_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_payout_ratio"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/period_row_height"
            android:text="@string/keystats_payout_ratio_header"
            android:drawablePadding="@dimen/spacing_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingRegular"/>
        <TextView
            android:gravity="start|center_vertical"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_dividend_yield"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/period_row_height"
            android:text="@string/keystats_dividend_yield_header"
            android:drawablePadding="@dimen/spacing_4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingRegular"/>
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/rv_period_dividend"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingEnd="@dimen/item_gap_20"
        android:nestedScrollingEnabled="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="@+id/ll_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/barrier"
        app:layout_constraintTop_toTopOf="@+id/ll_content"/>
    <View
        android:id="@+id/divider_2"
        android:background="?attr/themeColorDividerGreyBorder"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/item_gap_10"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_period_dividend"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="ll_header,ll_content"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/group_dividend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="divider,ll_content,rv_period_dividend"/>
</androidx.constraintlayout.widget.ConstraintLayout>
