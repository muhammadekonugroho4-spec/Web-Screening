<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentRowAttachmentWithIconRoot"
    android:tag="layout/item_attachment_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_20">
    <View
        android:id="@+id/v_header"
        android:background="?attr/themeColorModalsDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_row_attachment_with_icon_file_type_icon"
        android:layout_width="@dimen/spacing_24"
        android:layout_height="@dimen/spacing_24"
        android:scaleType="fitCenter"
        android:layout_centerVertical="true"
        app:srcCompat="@drawable/ic_file_type_other_report_24dp"
        app:tint="?attr/themeColorFeatureGreen"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_row_attachment_with_icon_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_toRightOf="@+id/iv_row_attachment_with_icon_file_type_icon"
        android:layout_below="@+id/v_header"
        android:layout_marginStart="@dimen/spacing_12"
        android:paddingVertical="@dimen/spacing_20"
        style="@style/TypeStyles.BodyRegular"/>
    <View
        android:tag="binding_1"
        android:background="?attr/themeColorModalsDividerThin"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_1"
        android:layout_below="@+id/tv_row_attachment_with_icon_title"/>
</RelativeLayout>
