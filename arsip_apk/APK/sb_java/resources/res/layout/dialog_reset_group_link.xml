<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_reset_group_link_0"
    android:background="@drawable/bg_top_rounded_16"
    android:paddingBottom="@dimen/item_gap_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/item_gap_20"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/v_devider"
        android:background="@drawable/bg_rounded_gray_gray_bg"
        android:layout_width="@dimen/clickable_size_38"
        android:layout_height="@dimen/item_gap_4"
        android:layout_marginVertical="@dimen/item_gap_12"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_title_reset_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_22"
        android:text="@string/chat_group_share_reset_link"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_devider"
        style="@style/TypeStyles.HeadingLarge"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_description_reset_link"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_22"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_reset_link"
        style="@style/TypeStyles.BodyRegular"/>
    <com.stockbit.uikit.buttons.SecondaryButton
        android:id="@+id/btn_cancel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_44"
        android:text="@string/button_cancel"
        android:textAllCaps="false"
        app:defaultColor="Neutral"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/btn_reset"
        app:layout_constraintTop_toBottomOf="@+id/tv_description_reset_link"/>
    <com.stockbit.uikit.buttons.SecondaryButton
        android:id="@+id/btn_reset"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/chat_group_share_reset_link"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/item_gap_16"
        app:defaultColor="Neutral"
        app:layout_constraintBottom_toBottomOf="@+id/btn_cancel"
        app:layout_constraintLeft_toRightOf="@+id/btn_cancel"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_cancel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
