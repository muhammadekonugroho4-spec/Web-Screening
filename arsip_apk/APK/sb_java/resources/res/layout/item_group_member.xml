<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_group_member_0"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/item_gap_20"
    android:paddingVertical="@dimen/item_gap_12">
    <com.stockbit.uikit.layout.BitRoundedLayout
        android:id="@+id/brl_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:isFullRounded="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_user_avatar"
            android:tag="binding_1"
            android:layout_width="@dimen/avatar_size_default"
            android:layout_height="@dimen/avatar_size_default"
            android:contentDescription="@string/hint_user_avatar_image"/>
    </com.stockbit.uikit.layout.BitRoundedLayout>
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:ellipsize="end"
        android:id="@+id/tv_username"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:drawablePadding="@dimen/item_gap_6"
        android:layout_marginHorizontal="@dimen/item_gap_16"
        app:drawableEndCompat="@drawable/ic_verified_green_white_12dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_full_name"
        app:layout_constraintEnd_toStartOf="@+id/tv_admin"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/brl_container"
        app:layout_constraintTop_toTopOf="@+id/brl_container"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:ellipsize="end"
        android:id="@+id/tv_full_name"
        android:tag="binding_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_4"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/item_gap_2"
        app:layout_constraintBottom_toBottomOf="@+id/brl_container"
        app:layout_constraintEnd_toStartOf="@+id/tv_admin"
        app:layout_constraintStart_toStartOf="@+id/tv_username"
        app:layout_constraintTop_toBottomOf="@+id/tv_username"
        style="@style/TypeStyles.BodyXSmall"/>
    <TextView
        android:textColor="@color/green_text"
        android:id="@+id/tv_admin"
        android:tag="binding_4"
        android:background="@drawable/bg_transparent_with_green_border_and_radius_4"
        android:paddingLeft="@dimen/item_gap_4"
        android:paddingTop="@dimen/item_gap_2"
        android:paddingRight="@dimen/item_gap_4"
        android:paddingBottom="@dimen/item_gap_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_admin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyXSmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
