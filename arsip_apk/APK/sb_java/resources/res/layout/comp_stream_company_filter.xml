<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_stream_company_filter_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.stockbit.stream.utils.FadingRecyclerView
        android:orientation="horizontal"
        android:id="@+id/rv_stream_company_filter"
        android:clipToPadding="false"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        app:extraMarginEnd="@dimen/spacing_8"
        app:extraMarginStart="@dimen/spacing_20"
        app:frv_fadingLength="@dimen/item_gap_64"
        app:frv_fadingSide="end"
        app:itemSpacingBetween="@dimen/spacing_8"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_stream_filter_more"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_stream_filter_more"
        android:background="@drawable/bg_border_inactive_chip"
        android:layout_width="@dimen/item_gap_34"
        android:layout_height="@dimen/clickable_size_28"
        android:contentDescription="@string/SHARED_8"
        android:layout_marginEnd="@dimen/spacing_16"
        android:paddingHorizontal="@dimen/item_gap_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="?attr/themeIconFilterMore"/>
</androidx.constraintlayout.widget.ConstraintLayout>
