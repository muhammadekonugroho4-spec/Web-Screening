<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/item_gap_32"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/item_gap_20">
    <View
        android:id="@+id/viewChatMeSkeleton"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_244"
        android:layout_height="@dimen/height_300"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/viewChatMeSkeletonSub"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_150"
        android:layout_height="@dimen/height_24"
        android:layout_marginTop="@dimen/item_gap_8"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewChatMeSkeleton"/>
    <View
        android:id="@+id/viewChatOtherSkeleton"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_244"
        android:layout_height="@dimen/height_150"
        android:layout_marginTop="@dimen/item_gap_20"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewChatMeSkeletonSub"/>
    <View
        android:id="@+id/viewChatOtherSkeletonSub"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="@dimen/width_150"
        android:layout_height="@dimen/height_24"
        android:layout_marginTop="@dimen/item_gap_8"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintStart_toStartOf="@+id/viewChatOtherSkeleton"
        app:layout_constraintTop_toBottomOf="@+id/viewChatOtherSkeleton"/>
</androidx.constraintlayout.widget.ConstraintLayout>
