<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/bottom_sheet_error_0"
    android:background="@drawable/bg_top_rounded_16"
    android:paddingBottom="@dimen/item_gap_34"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_scroll_indicator"
        android:layout_width="55dp"
        android:layout_height="4dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/bg_bottom_sheet_drag_indicator"
        app:layout_constraintBottom_toTopOf="@+id/iv_error_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_error_logo"
        android:tag="binding_1"
        android:visibility="gone"
        android:layout_width="@dimen/width_180"
        android:layout_height="135dp"
        android:layout_marginTop="@dimen/item_gap_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_scroll_indicator"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:layout_marginHorizontal="@dimen/item_gap_48"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_error_logo"
        style="@style/SbTextView.ListTitle"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_8"
        android:layout_marginHorizontal="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/SbTextView.BodyDefault"/>
    <Button
        android:textColor="#00ab6b"
        android:id="@+id/btn_secondary"
        android:background="@drawable/bg_transparent_with_green_border_and_radius_4"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/item_gap_20"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/item_gap_20"
        android:layout_marginEnd="5dp"
        app:layout_constraintEnd_toStartOf="@+id/btn_primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_description"
        style="SbTextView.ListTitle.Normal"/>
    <Button
        android:textColor="@color/white"
        android:id="@+id/btn_primary"
        android:background="@drawable/border_green_rounded"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="@dimen/item_gap_20"
        android:textAllCaps="false"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btn_secondary"
        app:layout_constraintTop_toBottomOf="@+id/tv_description"
        style="SbTextView.ListTitle.Normal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
