<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/sixteen_dp"
        android:paddingRight="@dimen/sixteen_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sixteen_dp">
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            android:textSize="@dimen/primary_text_size"
            android:textStyle="bold"
            android:textColor="@color/dark_gray"
            android:paddingRight="@dimen/sixteen_dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/instruction"
            android:textAllCaps="true"/>
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/twenty_four_dp"
            android:layout_marginRight="@dimen/ten_dp"
            android:src="0x7f08011e"
            android:scaleType="fitCenter"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/twenty_four_dp"
            android:layout_marginRight="@dimen/eight_dp"
            android:src="0x7f08011f"
            android:scaleType="fitCenter"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/twenty_four_dp"
            android:src="0x7f0803ad"
            android:scaleType="fitCenter"/>
    </LinearLayout>
    <com.midtrans.sdk.uikit.widgets.DefaultTextView
        android:textSize="@dimen/secondary_text_size"
        android:textColor="@color/black"
        android:paddingLeft="@dimen/sixteen_dp"
        android:paddingTop="@dimen/four_dp"
        android:paddingRight="@dimen/sixteen_dp"
        android:paddingBottom="@dimen/four_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sixteen_dp"
        android:text="@string/alfamart_instruction_step0"/>
    <LinearLayout
        android:background="@color/light_gray"
        android:paddingLeft="@dimen/sixteen_dp"
        android:paddingTop="@dimen/four_dp"
        android:paddingRight="@dimen/sixteen_dp"
        android:paddingBottom="@dimen/four_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sixteen_dp">
        <TextView
            android:layout_width="@dimen/twenty_four_dp"
            android:layout_height="wrap_content"
            android:text="@string/number_instruction1"/>
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            android:textSize="@dimen/secondary_text_size"
            android:textColor="@color/black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alfamart_instruction_step1"/>
    </LinearLayout>
    <LinearLayout
        android:paddingLeft="@dimen/sixteen_dp"
        android:paddingTop="@dimen/four_dp"
        android:paddingRight="@dimen/sixteen_dp"
        android:paddingBottom="@dimen/four_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp">
        <TextView
            android:layout_width="@dimen/twenty_four_dp"
            android:layout_height="wrap_content"
            android:text="@string/number_instruction2"/>
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            android:textSize="@dimen/secondary_text_size"
            android:textColor="@color/black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alfamart_instruction_step2"/>
    </LinearLayout>
    <LinearLayout
        android:background="@color/light_gray"
        android:paddingLeft="@dimen/sixteen_dp"
        android:paddingTop="@dimen/four_dp"
        android:paddingRight="@dimen/sixteen_dp"
        android:paddingBottom="@dimen/four_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp">
        <TextView
            android:layout_width="@dimen/twenty_four_dp"
            android:layout_height="wrap_content"
            android:text="@string/number_instruction3"/>
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            android:textSize="@dimen/secondary_text_size"
            android:textColor="@color/black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alfamart_instruction_step3"/>
    </LinearLayout>
    <LinearLayout
        android:paddingLeft="@dimen/sixteen_dp"
        android:paddingTop="@dimen/four_dp"
        android:paddingRight="@dimen/sixteen_dp"
        android:paddingBottom="@dimen/four_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp">
        <TextView
            android:layout_width="@dimen/twenty_four_dp"
            android:layout_height="wrap_content"
            android:text="@string/number_instruction4"/>
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            android:textSize="@dimen/secondary_text_size"
            android:textColor="@color/black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alfamart_instruction_step4"/>
    </LinearLayout>
    <LinearLayout
        android:background="@color/light_gray"
        android:paddingLeft="@dimen/sixteen_dp"
        android:paddingTop="@dimen/four_dp"
        android:paddingRight="@dimen/sixteen_dp"
        android:paddingBottom="@dimen/four_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp">
        <TextView
            android:layout_width="@dimen/twenty_four_dp"
            android:layout_height="wrap_content"
            android:text="@string/number_instruction5"/>
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            android:textSize="@dimen/secondary_text_size"
            android:textColor="@color/black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alfamart_instruction_step5"/>
    </LinearLayout>
    <LinearLayout
        android:paddingLeft="@dimen/sixteen_dp"
        android:paddingTop="@dimen/four_dp"
        android:paddingRight="@dimen/sixteen_dp"
        android:paddingBottom="@dimen/four_dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="2dp">
        <TextView
            android:layout_width="@dimen/twenty_four_dp"
            android:layout_height="wrap_content"
            android:text="@string/number_instruction6"/>
        <com.midtrans.sdk.uikit.widgets.DefaultTextView
            android:textSize="@dimen/secondary_text_size"
            android:textColor="@color/black"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/alfamart_instruction_step6"/>
    </LinearLayout>
</LinearLayout>
