<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_parent"
    android:paddingBottom="@dimen/spacing_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_container"
        android:background="@drawable/bg_rounded_gray_outline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_10"
        android:layout_marginBottom="@dimen/item_gap_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/aciv_image"
            android:background="@drawable/bg_gray_icon"
            android:padding="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_12"
            android:layout_marginBottom="@dimen/item_gap_12"
            android:src="@drawable/ic_image_placeholder"
            android:layout_marginStart="@dimen/item_gap_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/aciv_photo"
            android:visibility="gone"
            android:layout_width="@dimen/item_gap_58"
            android:layout_height="@dimen/item_gap_58"
            android:layout_marginTop="@dimen/item_gap_12"
            android:layout_marginBottom="@dimen/item_gap_12"
            android:scaleType="centerCrop"
            android:layout_marginStart="@dimen/item_gap_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="?attr/themeColorTextSecondary"
            android:id="@+id/actv_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/item_gap_20"
            android:layout_marginEnd="@dimen/item_gap_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/aciv_arrow"
            app:layout_constraintStart_toEndOf="@+id/aciv_image"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.BodyRegular"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/aciv_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_chevron_right"
            android:scaleType="center"
            android:tint="?attr/themeIconTintColor"
            android:layout_marginEnd="@dimen/clickable_size_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center_horizontal"
        android:id="@+id/actv_label"
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_12"
        android:paddingHorizontal="@dimen/spacing_4"
        app:layout_constraintBottom_toTopOf="@+id/cl_container"
        app:layout_constraintStart_toStartOf="@+id/cl_container"
        app:layout_constraintTop_toTopOf="@+id/cl_container"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:gravity="center_horizontal"
        android:id="@+id/actv_optional"
        android:background="?attr/themeColorSurfaceDefault"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_securities_oa_optional"
        android:paddingEnd="@dimen/spacing_4"
        app:layout_constraintBottom_toBottomOf="@+id/actv_label"
        app:layout_constraintStart_toEndOf="@+id/actv_label"
        app:layout_constraintTop_toTopOf="@+id/actv_label"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv_oa_upload_tooltip"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:drawablePadding="@dimen/spacing_6"
        android:layout_marginHorizontal="@dimen/spacing_12"
        app:drawableStartCompat="@drawable/ic_info"
        app:drawableTint="?attr/themeColorSemanticActive"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_container"
        style="@style/TypeStyles.BodyXSmall.Secondary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
