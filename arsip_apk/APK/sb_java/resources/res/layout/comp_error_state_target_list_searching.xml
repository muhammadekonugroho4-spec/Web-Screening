<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/ll_error"
    android:tag="layout/comp_error_state_target_list_searching_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="@dimen/item_gap_20">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_4"
        app:srcCompat="@drawable/ic_error_share_trade_setting"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_8"
        android:text="@string/text_share_trade_setting_on_error_message"
        style="@style/TypeStyles.BodyRegular"/>
    <TextView
        android:textColor="@color/dark_type_textgreen"
        android:id="@+id/btn_try_again"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_4"
        android:text="@string/text_share_trade_setting_try_again"
        android:drawablePadding="@dimen/item_gap_4"
        app:drawableStartCompat="@drawable/ic_error_refresh"
        style="@style/TypeStyles.HeadingSmall"/>
</LinearLayout>
