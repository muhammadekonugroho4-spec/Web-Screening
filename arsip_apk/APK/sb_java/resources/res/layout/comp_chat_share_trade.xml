<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_chat_share_trade_0"
    android:layout_width="@dimen/img_max_width"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/layout_previous_order"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/comp_previous_order_bubble_chat"/>
    <include
        android:id="@+id/layout_chat_username"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_previous_order"
        layout="@layout/comp_message_username_share_trade"/>
    <TextView
        android:id="@+id/tv_share_trade_emiten"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_2"
        android:layout_marginStart="@dimen/spacing_12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_chat_username"
        app:layout_goneMarginTop="@dimen/spacing_12"
        style="@style/TypeStyles.BodyLarge"/>
    <TextView
        android:id="@+id/tv_share_trade_price"
        android:tag="binding_2"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:layout_marginBottom="@dimen/spacing_12"
        app:layout_constraintStart_toStartOf="@+id/tv_share_trade_emiten"
        app:layout_constraintTop_toBottomOf="@+id/tv_share_trade_emiten"
        style="@style/TypeStyles.BodyXSmall"/>
    <TextView
        android:id="@+id/tv_share_trade_updated_price"
        android:tag="binding_3"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:layout_marginStart="@dimen/spacing_8"
        app:layout_constraintStart_toEndOf="@+id/tv_share_trade_price"
        app:layout_constraintTop_toBottomOf="@+id/tv_share_trade_emiten"
        app:layout_goneMarginStart="0dp"
        style="@style/TypeStyles.BodyXSmall"/>
    <View
        android:id="@+id/v_dot_amount"
        android:tag="binding_4"
        android:background="@drawable/chat_ic_dot_default_2"
        android:visibility="gone"
        android:layout_width="@dimen/spacing_2"
        android:layout_height="@dimen/spacing_2"
        android:layout_marginStart="@dimen/spacing_4"
        app:layout_constraintBottom_toBottomOf="@+id/tv_total_amount"
        app:layout_constraintStart_toEndOf="@+id/tv_share_trade_updated_price"
        app:layout_constraintTop_toTopOf="@+id/tv_total_amount"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:id="@+id/tv_total_amount"
        android:tag="binding_5"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:layout_marginStart="@dimen/spacing_4"
        app:layout_constraintStart_toEndOf="@+id/v_dot_amount"
        app:layout_constraintTop_toBottomOf="@+id/tv_share_trade_emiten"
        app:layout_goneMarginStart="0dp"
        style="@style/TypeStyles.BodyXSmall"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_amount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tv_share_trade_price, tv_share_trade_updated_price, v_dot_amount, tv_total_amount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textColor="?attr/themeColorTextSecondary"
        android:id="@+id/tv_share_trade_order_time"
        android:tag="binding_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:layout_marginBottom="@dimen/spacing_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_share_trade_emiten"
        app:layout_constraintTop_toBottomOf="@+id/barrier_amount"
        style="@style/TypeStyles.BodyXSmall"/>
    <ImageView
        android:id="@+id/iv_chevron_right"
        android:tag="binding_7"
        android:layout_width="@dimen/spacing_16"
        android:layout_height="@dimen/spacing_16"
        android:layout_marginEnd="@dimen/spacing_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_previous_order"
        app:srcCompat="@drawable/ic_share_trade_arrow"/>
</androidx.constraintlayout.widget.ConstraintLayout>
