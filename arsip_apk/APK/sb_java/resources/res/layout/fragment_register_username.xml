<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_register_username_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="800dp">
        <androidx.core.widget.NestedScrollView
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:layout_weight="1">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/ivRegisterUsernameSocialMediaIcon"
                    android:tag="binding_1"
                    android:layout_width="@dimen/item_gap_70"
                    android:layout_height="@dimen/item_gap_70"
                    android:layout_marginLeft="@dimen/item_gap_l"
                    android:layout_marginTop="@dimen/item_gap_36"
                    android:layout_marginRight="@dimen/item_gap_l"
                    android:src="@drawable/ic_avatar"/>
                <ImageView
                    android:id="@+id/ivRegisterUsernameIcon"
                    android:tag="binding_2"
                    android:layout_width="@dimen/item_gap_70"
                    android:layout_height="@dimen/item_gap_70"
                    android:layout_marginLeft="@dimen/item_gap_l"
                    android:layout_marginTop="@dimen/item_gap_36"
                    android:layout_marginRight="@dimen/item_gap_l"
                    app:srcCompat="?attr/imgRegisterUsername"/>
                <TextView
                    android:textColor="?attr/themeColorTextPrimary"
                    android:id="@+id/tvRegisterUsernameTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/item_gap_l"
                    android:layout_marginTop="@dimen/item_gap_20"
                    android:layout_marginRight="@dimen/item_gap_l"
                    android:layout_marginBottom="@dimen/item_gap_s"
                    android:text="@string/title_registration_username"
                    android:layout_below="@+id/ivRegisterUsernameIcon"
                    style="@style/TypeStyles.HeadlineRegular"/>
                <TextView
                    android:textColor="?attr/themeColorTextSecondary"
                    android:id="@+id/tvRegisterUsernameSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/item_gap_l"
                    android:layout_marginTop="@dimen/item_gap_10"
                    android:layout_marginRight="@dimen/item_gap_l"
                    android:layout_marginBottom="@dimen/item_gap_s"
                    android:text="@string/text_registration_username"
                    android:layout_below="@+id/tvRegisterUsernameTitle"
                    style="@style/TypeStyles.BodyRegular"/>
                <com.stockbit.uikit.input.InputTextFieldLine
                    android:id="@+id/itfl_register_username"
                    android:tag="binding_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/item_gap_l"
                    android:layout_marginTop="@dimen/item_gap_l"
                    android:layout_marginRight="@dimen/item_gap_l"
                    android:layout_marginBottom="@dimen/item_gap_46"
                    android:layout_below="@+id/tvRegisterUsernameSubtitle"
                    app:textFieldHint="@string/placeholder_registration_username"/>
            </RelativeLayout>
        </androidx.core.widget.NestedScrollView>
        <com.stockbit.uikit.buttons.StickyButton
            android:id="@+id/rlRegisterUsername"
            android:tag="binding_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_next"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
