<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_parent_report_unboxing"
    android:tag="layout/item_report_unboxing_0"
    android:layout_width="@dimen/width_150"
    android:layout_height="@dimen/height_200"
    android:layout_marginEnd="@dimen/item_gap_16"
    app:cardCornerRadius="@dimen/shape_radius_4"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_unboxing_thumbnail"
            android:tag="binding_1"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="@dimen/spacing_0"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@drawable/bg_overlay_unboxing_banner"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/tv_unboxing_category"
            android:tag="binding_2"
            android:background="@drawable/bg_unboxing_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginStart="@dimen/spacing_12"
            android:paddingHorizontal="@dimen/padding_horizontal_category_label"
            android:paddingVertical="@dimen/spacing_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingXSmall"/>
        <TextView
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/tv_unboxing_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_4"
            android:maxLines="3"
            android:layout_marginHorizontal="@dimen/spacing_12"
            app:layout_constraintBottom_toTopOf="@+id/tv_unboxing_release_volume"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/TypeStyles.HeadingLarge"/>
        <TextView
            android:textColor="@color/white"
            android:id="@+id/tv_unboxing_release_volume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_16"
            android:maxLines="1"
            android:layout_marginHorizontal="@dimen/spacing_12"
            android:paddingHorizontal="@dimen/spacing_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/TypeStyles.BodyXSmall"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
