<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_set_new_password_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/settingCreateNewPassToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:layout_scrollFlags="enterAlways|scroll">
        <TextView
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_set_pass_app_title"
            style="@style/TypeStyles.HeadlineRegular"/>
    </androidx.appcompat.widget.Toolbar>
    <View
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"/>
    <ProgressBar
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-7dp"
        android:layout_marginBottom="-7dp"
        android:indeterminate="true"
        style="?android:attr/progressBarStyleHorizontal"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rlChangePassApp"
                android:background="@color/fifty_percent_transparency_grey_400"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ProgressBar
                    android:id="@+id/progressChangePassApp"
                    android:visibility="visible"
                    android:layout_width="@dimen/clickable_size_32"
                    android:layout_height="@dimen/clickable_size_32"
                    android:indeterminate="true"
                    android:layout_centerInParent="true"
                    style="@style/Widget.AppCompat.ProgressBar"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_m"
                    android:text="@string/loading"
                    android:layout_below="@+id/progressChangePassApp"
                    android:layout_centerInParent="true"
                    style="@style/SbTextView.BodyDefault"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:padding="@dimen/item_gap_l"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textColor="?attr/themeContentTextColor"
                    android:gravity="center_horizontal"
                    android:id="@+id/tvNewPassTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_l"
                    android:text="@string/setting_change_password_app_new_pass"
                    style="@style/SbTextView.BodyDefault"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/parentNewPassword"
                    android:tag="binding_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:errorEnabled="true"
                    app:errorTextAppearance="@style/SbTextView.InputError"
                    app:hintEnabled="false"
                    app:passwordToggleEnabled="true"
                    style="@style/Sb.Widget.InputText">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textColor="?attr/themeContentTextColor"
                        android:id="@+id/etNewAppPass"
                        android:tag="binding_3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/setting_change_password_app_enter_new_pass"
                        android:inputType="textPassword"
                        style="@style/SbEditTextStyle"/>
                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:gravity="center_horizontal"
                    android:id="@+id/tvConfirmationPassTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_l"
                    android:text="@string/setting_change_password_app_confirmation_pass"
                    style="@style/SbTextView.BodyDefault"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:textColor="?attr/themeContentTextColor"
                    android:id="@+id/parentConfirmationPassword"
                    android:tag="binding_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:errorEnabled="true"
                    app:errorTextAppearance="@style/SbTextView.InputError"
                    app:hintEnabled="false"
                    app:passwordToggleEnabled="true"
                    style="@style/Sb.Widget.InputText">
                    <com.google.android.material.textfield.TextInputEditText
                        android:textColor="?attr/themeContentTextColor"
                        android:id="@+id/etConfirmAppPass"
                        android:tag="binding_5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/setting_change_password_app_enter_confirmation_pass"
                        android:inputType="textPassword"
                        style="@style/SbEditTextStyle"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.stockbit.common.uikit.StockbitLoadingButton
                    android:id="@+id/btnChangePassApp"
                    android:tag="binding_6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/clickable_size_24"
                    app:buttonText="@string/button_save"
                    style="@style/SbBtn.PrimaryFullWidthFloating"/>
            </LinearLayout>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
