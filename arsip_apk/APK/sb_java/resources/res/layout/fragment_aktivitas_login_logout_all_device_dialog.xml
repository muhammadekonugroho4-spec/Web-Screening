<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme"
    android:tag="layout/fragment_aktivitas_login_logout_all_device_dialog_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/vgAktivitasLoginLogoutAllDeviceDialogHeader"
        android:background="@drawable/bg_top_rounded"
        android:paddingTop="@dimen/item_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/viewFragmentAktivitasLoginLogoutAllDeviceHandler"
            android:background="@drawable/bg_rounded_gray_gray_bg"
            android:layout_width="@dimen/clickable_size_38"
            android:layout_height="@dimen/item_gap_s"
            android:layout_marginBottom="@dimen/item_gap_s"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/themeDialogBackgroundColor"
        android:paddingTop="@dimen/item_gap_s"
        android:paddingBottom="@dimen/item_gap_s"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/vgAktivitasLoginLogoutAllDeviceDialogHeader">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:layout_width="@dimen/width_84"
            android:layout_height="@dimen/height_84"
            android:layout_margin="@dimen/item_gap_20"
            app:srcCompat="@drawable/ic_logout_all_device"/>
        <TextView
            android:textSize="@dimen/text_size_18"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_s"
            android:layout_marginBottom="@dimen/item_gap_20"
            android:text="@string/setting_aktivitas_login_logout_all_title_dialog"
            android:textAlignment="gravity"
            style="@style/SbTextView.BodyDefault.Bold"/>
        <LinearLayout
            android:orientation="horizontal"
            android:padding="@dimen/item_gap_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:textSize="@dimen/text_size_16"
                android:textColor="@color/green_text"
                android:id="@+id/btnAktivitasLoginLogoutAllDeviceNo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:foreground="?attr/selectableItemBackground"
                android:text="@string/setting_aktivitas_login_logout_all_tidak_dialog"
                android:layout_weight="1"
                android:textAllCaps="false"
                style="@style/SbTextView.BodyDefault.Bold"/>
            <Button
                android:textSize="@dimen/text_size_16"
                android:textColor="@color/white"
                android:id="@+id/btnAktivitasLoginLogoutAllDeviceYes"
                android:background="@drawable/border_green_rounded"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:foreground="?attr/selectableItemBackground"
                android:text="@string/setting_aktivitas_login_logout_all_ya_dialog"
                android:layout_weight="1"
                android:textAllCaps="false"
                style="@style/SbTextView.BodyDefault.Bold"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
