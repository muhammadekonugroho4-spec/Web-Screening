<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_choose_group_member_0"
    android:background="@drawable/bg_top_rounded_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <View
        android:id="@+id/v_devider_top"
        android:background="@drawable/bg_rounded_gray_gray_bg"
        android:layout_width="@dimen/width_40"
        android:layout_height="@dimen/item_gap_5"
        android:layout_marginTop="@dimen/item_gap_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.stockbit.uikit.layout.BitRoundedLayout
        android:id="@+id/brl_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32"
        android:layout_marginStart="@dimen/item_gap_20"
        app:isFullRounded="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_devider_top">
        <ImageView
            android:id="@+id/iv_user_avatar"
            android:tag="binding_1"
            android:layout_width="@dimen/avatar_size_default"
            android:layout_height="@dimen/avatar_size_default"
            android:contentDescription="@string/hint_user_avatar_image"/>
    </com.stockbit.uikit.layout.BitRoundedLayout>
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:id="@+id/tv_username"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/item_gap_6"
        android:layout_marginStart="@dimen/item_gap_16"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:drawableEndCompat="@drawable/ic_verified_green_white_12dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_fullname"
        app:layout_constraintStart_toEndOf="@+id/brl_container"
        app:layout_constraintTop_toTopOf="@+id/brl_container"
        app:layout_constraintVertical_chainStyle="spread_inside"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:textColor="@color/highgray_light"
        android:gravity="start"
        android:id="@+id/tv_fullname"
        android:tag="binding_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/item_gap_20"
        app:layout_constraintBottom_toBottomOf="@+id/brl_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_username"
        app:layout_constraintTop_toBottomOf="@+id/tv_username"
        style="@style/TypeStyles.BodyRegular"/>
    <View
        android:id="@+id/v_devider_account"
        android:background="@drawable/bg_rounded_gray_gray_bg"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/item_gap_20"
        app:layout_constraintTop_toBottomOf="@+id/brl_container"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_item_view_account"
        android:tag="binding_4"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="@dimen/item_gap_20"
        android:paddingTop="@dimen/item_gap_14"
        android:paddingRight="@dimen/item_gap_20"
        android:paddingBottom="@dimen/item_gap_14"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/v_devider_account">
        <ImageView
            android:id="@+id/iv_icon_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_chat_profile_grey_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:tag="binding_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/item_gap_12"
            app:layout_constraintBottom_toBottomOf="@+id/iv_icon_profile"
            app:layout_constraintStart_toEndOf="@+id/iv_icon_profile"
            app:layout_constraintTop_toTopOf="@+id/iv_icon_profile"
            style="@style/TypeStyles.BodyRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_item_chat_account"
        android:tag="binding_6"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="@dimen/item_gap_20"
        android:paddingTop="@dimen/item_gap_14"
        android:paddingRight="@dimen/item_gap_20"
        android:paddingBottom="@dimen/item_gap_14"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/cl_item_view_account">
        <ImageView
            android:id="@+id/iv_icon_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_message_square_grey_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:tag="binding_7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/item_gap_12"
            app:layout_constraintBottom_toBottomOf="@+id/iv_icon_chat"
            app:layout_constraintStart_toEndOf="@+id/iv_icon_chat"
            app:layout_constraintTop_toTopOf="@+id/iv_icon_chat"
            style="@style/TypeStyles.BodyRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_item_tip_jar"
        android:tag="binding_8"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="@dimen/item_gap_20"
        android:paddingTop="@dimen/item_gap_14"
        android:paddingRight="@dimen/item_gap_20"
        android:paddingBottom="@dimen/item_gap_14"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/cl_item_chat_account">
        <ImageView
            android:id="@+id/iv_icon_tipjar"
            android:layout_width="@dimen/height_16"
            android:layout_height="@dimen/height_16"
            android:src="@drawable/ic_chat_group_tip_jar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_group_give_a_tip"
            android:layout_marginStart="@dimen/item_gap_12"
            app:layout_constraintBottom_toBottomOf="@+id/iv_icon_tipjar"
            app:layout_constraintStart_toEndOf="@+id/iv_icon_tipjar"
            app:layout_constraintTop_toTopOf="@+id/iv_icon_tipjar"
            style="@style/TypeStyles.BodyRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_item_assign_admin"
        android:tag="binding_9"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="@dimen/item_gap_20"
        android:paddingTop="@dimen/item_gap_14"
        android:paddingRight="@dimen/item_gap_20"
        android:paddingBottom="@dimen/item_gap_14"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/cl_item_tip_jar">
        <ImageView
            android:id="@+id/iv_icon_assign_admin"
            android:tag="binding_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:tag="binding_11"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/item_gap_12"
            app:layout_constraintBottom_toBottomOf="@+id/iv_icon_assign_admin"
            app:layout_constraintStart_toEndOf="@+id/iv_icon_assign_admin"
            app:layout_constraintTop_toTopOf="@+id/iv_icon_assign_admin"
            style="@style/TypeStyles.BodyRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_item_remove_account"
        android:tag="binding_12"
        android:background="?attr/selectableItemBackground"
        android:paddingLeft="@dimen/item_gap_20"
        android:paddingTop="@dimen/item_gap_14"
        android:paddingRight="@dimen/item_gap_20"
        android:paddingBottom="@dimen/item_gap_14"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_item_assign_admin">
        <ImageView
            android:id="@+id/iv_icon_remove_account"
            android:layout_width="@dimen/height_16"
            android:layout_height="@dimen/width_16"
            android:src="@drawable/ic_remove_user"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="@color/red_item"
            android:tag="binding_13"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/item_gap_12"
            app:layout_constraintBottom_toBottomOf="@+id/iv_icon_remove_account"
            app:layout_constraintStart_toEndOf="@+id/iv_icon_remove_account"
            app:layout_constraintTop_toTopOf="@+id/iv_icon_remove_account"
            style="@style/TypeStyles.BodyRegular"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
