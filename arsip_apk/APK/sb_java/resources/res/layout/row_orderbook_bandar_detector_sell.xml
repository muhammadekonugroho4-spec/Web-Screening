<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/ll_header_bandar_item_sell"
    android:tag="layout/row_orderbook_bandar_detector_sell_0"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="@dimen/row_height_bandar">
    <TextView
        android:gravity="center"
        android:id="@+id/tv_sl"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/lbl_orderbook_bandar_empty"
        android:layout_weight="1"
        style="@style/TypeStyles.BodySmall"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_sval"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/lbl_orderbook_bandar_empty"
        android:layout_weight="1"
        style="@style/TypeStyles.BodySmall"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_slot"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/lbl_orderbook_bandar_empty"
        android:layout_weight="1"
        style="@style/TypeStyles.BodySmall"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_savg"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text="@string/lbl_orderbook_bandar_empty"
        android:layout_weight="1"
        style="@style/TypeStyles.BodySmall"/>
</LinearLayout>
