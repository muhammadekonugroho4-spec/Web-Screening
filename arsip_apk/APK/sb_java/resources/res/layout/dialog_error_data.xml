<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_error_data_0"
    android:background="@drawable/bg_top_rounded_16"
    android:paddingBottom="@dimen/height_32"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_20">
    <ImageView
        android:id="@+id/iv_scroll_indicator"
        android:layout_width="@dimen/width_55"
        android:layout_height="@dimen/spacing_4"
        android:layout_marginTop="@dimen/spacing_16"
        android:src="@drawable/bg_bottom_sheet_drag_indicator"
        app:layout_constraintBottom_toTopOf="@+id/iv_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_info"
        android:tag="binding_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_24"
        android:paddingHorizontal="@dimen/spacing_8"
        android:paddingVertical="@dimen/item_gap_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_scroll_indicator"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="@dimen/spacing_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_32"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_info"
        style="@style/TypeStyles.HeadingLarge"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/TypeStyles.BodyRegular"/>
    <com.stockbit.uikit.buttons.PrimaryButton
        android:textColor="@color/white"
        android:id="@+id/btn_action"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_44"
        android:layout_marginTop="@dimen/item_gap_32"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc"/>
</androidx.constraintlayout.widget.ConstraintLayout>
