<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sfl_plan_list"
    android:tag="layout/comp_shimmer_plan_list_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="@dimen/spacing_20"
    android:layout_marginHorizontal="@dimen/spacing_20"
    app:shimmer_auto_start="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/v_title"
            android:background="@drawable/bg_rounded_gray"
            android:layout_width="@dimen/width_200"
            android:layout_height="@dimen/spacing_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_sub_title"
            android:background="@drawable/bg_rounded_gray"
            android:layout_width="@dimen/item_gap_304"
            android:layout_height="@dimen/spacing_24"
            android:layout_marginTop="@dimen/spacing_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_title"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_sub_title2"
            android:background="@drawable/bg_rounded_gray"
            android:layout_width="@dimen/width_256"
            android:layout_height="@dimen/spacing_24"
            android:layout_marginTop="@dimen/spacing_8"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_sub_title"
            style="@style/SBShimmerItem"/>
        <include
            android:id="@+id/i_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_76"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_sub_title2"
            layout="@layout/skeleton_plan_recommend"/>
        <include
            android:id="@+id/i_plan_item"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/i_plan"
            layout="@layout/skeleton_plan_item"/>
        <include
            android:id="@+id/i_plan_item_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/i_plan_item"
            layout="@layout/skeleton_plan_item"/>
        <include
            android:id="@+id/i_plan_item_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/i_plan_item_2"
            layout="@layout/skeleton_plan_item"/>
        <View
            android:background="@drawable/bg_rounded_gray"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_44"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/SBShimmerItem"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
