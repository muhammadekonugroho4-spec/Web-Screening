<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/ivEmptyImg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:layout_centerHorizontal="true"
        app:srcCompat="?attr/themeIconEmptySearch"/>
    <TextView
        android:textSize="@dimen/text_size_13"
        android:gravity="center"
        android:id="@+id/tvtitleEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_l"
        android:text="@string/lbl_no_result_found"
        android:layout_below="@+id/ivEmptyImg"
        android:layout_centerHorizontal="true"
        android:textAlignment="gravity"
        style="@style/SbTextView.ListTitle.Highgray.Normal"/>
</RelativeLayout>
