<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_parent_company_layout"
    android:tag="layout/item_e_ipo_company_0"
    android:background="@drawable/bg_border_gray_rounded_outline"
    android:paddingBottom="@dimen/item_gap_12"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/item_gap_20"
    android:foreground="?attr/selectableItemBackground"
    android:layout_marginStart="@dimen/item_gap_20"
    android:layout_marginEnd="@dimen/item_gap_20">
    <RelativeLayout
        android:id="@+id/rl_company_logo"
        android:background="@drawable/bg_border_circle_gray"
        android:layout_width="@dimen/item_gap_36"
        android:layout_height="@dimen/item_gap_36"
        android:layout_marginTop="@dimen/item_gap_12"
        android:layout_marginStart="@dimen/item_gap_l"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.mikhaellopez.circularimageview.CircularImageView
            android:id="@+id/civ_company_logo"
            android:tag="binding_1"
            android:layout_width="@dimen/item_gap_36"
            android:layout_height="@dimen/item_gap_36"
            android:scaleType="fitCenter"
            android:layout_centerInParent="true"
            app:civ_border_color="?attr/titleTextColorDowngray"
            app:civ_border_width="@dimen/item_gap_xxxs"/>
    </RelativeLayout>
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/iv_badge"
        android:visibility="gone"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:translationX="-8dp"
        android:translationY="4dp"
        app:layout_constraintBottom_toTopOf="@+id/rl_company_logo"
        app:layout_constraintEnd_toEndOf="@+id/rl_company_logo"
        app:layout_constraintStart_toEndOf="@+id/rl_company_logo"
        app:layout_constraintTop_toTopOf="@+id/rl_company_logo"
        app:layout_constraintVertical_bias="0.3"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/eipo_new_badge"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_symbol_company"
        android:tag="binding_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAllCaps="true"
        android:layout_marginStart="@dimen/item_gap_l"
        android:layout_marginEnd="@dimen/item_gap_s"
        app:layout_constraintStart_toEndOf="@+id/rl_company_logo"
        app:layout_constraintTop_toTopOf="@+id/rl_company_logo"
        style="@style/SbTextView.TitleContent"/>
    <ImageView
        android:id="@+id/iv_e_ipo_label_warrant_single"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="?attr/themeLabelEIpoWarrant"
        android:layout_marginStart="@dimen/item_gap_6"
        app:layout_constraintBottom_toBottomOf="@+id/tv_symbol_company"
        app:layout_constraintStart_toEndOf="@+id/tv_symbol_company"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol_company"/>
    <ImageView
        android:id="@+id/iv_e_ipo_label_sharia_single"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="?attr/themeLabelEIpoSharia"
        android:layout_marginStart="@dimen/item_gap_6"
        app:layout_constraintBottom_toBottomOf="@+id/tv_symbol_company"
        app:layout_constraintStart_toEndOf="@+id/tv_symbol_company"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol_company"/>
    <ImageView
        android:id="@+id/iv_e_ipo_label_sharia_double"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:src="?attr/themeLabelEIpoSharia"
        app:layout_constraintStart_toStartOf="@+id/tv_symbol_company"
        app:layout_constraintTop_toBottomOf="@+id/tv_symbol_company"/>
    <ImageView
        android:id="@+id/iv_e_ipo_label_warrant_double"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:src="?attr/themeLabelEIpoWarrant"
        android:layout_marginStart="@dimen/spacing_4"
        app:layout_constraintStart_toEndOf="@+id/iv_e_ipo_label_sharia_double"
        app:layout_constraintTop_toBottomOf="@+id/tv_symbol_company"
        app:layout_goneMarginStart="@dimen/spacing_0"/>
    <TextView
        android:textSize="@dimen/text_size_11"
        android:textColor="@color/neutral_light"
        android:ellipsize="end"
        android:id="@+id/tv_name_company"
        android:tag="binding_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_4"
        android:maxLines="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/iv_e_ipo_label_sharia_double"
        app:layout_constraintTop_toBottomOf="@+id/iv_e_ipo_label_sharia_double"/>
    <TextView
        android:textSize="@dimen/text_size_12"
        android:ellipsize="end"
        android:id="@+id/tv_company_price"
        android:tag="binding_4"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="@dimen/item_gap_l"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_symbol_company"
        style="@style/SbTextView.TitleContent"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/tv_not_available"
        android:tag="binding_5"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SbTextView.EmptyContent"/>
    <View
        android:id="@+id/v_separator"
        android:background="?attr/themeColorBorder"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/shape_radius_xxs"
        android:layout_marginTop="@dimen/spacing_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_name_company"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_company_stage_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/barrier_stage_bottom"
        app:layout_constraintTop_toBottomOf="@+id/v_separator">
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:id="@+id/tv_company_stage_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="textEnd"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintBottom_toBottomOf="@+id/iv_first_stage_green_dot"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_first_stage_green_dot"
            style="@style/TypeStyles.BodyXXSmall"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:ellipsize="end"
            android:id="@+id/tv_company_ipo_date"
            android:tag="binding_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="textEnd"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintBottom_toBottomOf="@+id/iv_second_stage_inactive"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/iv_second_stage_inactive"
            style="@style/TypeStyles.BodyXXSmall"/>
        <ImageView
            android:id="@+id/iv_first_stage_green_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginStart="@dimen/spacing_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_green_dot_live"/>
        <View
            android:id="@+id/v_line_status"
            android:background="?attr/themeColorBorderGreen"
            android:layout_width="@dimen/item_gap_1"
            android:layout_height="@dimen/item_gap_10"
            android:layout_marginTop="@dimen/spacing_2"
            app:layout_constraintEnd_toEndOf="@+id/iv_first_stage_green_dot"
            app:layout_constraintStart_toStartOf="@+id/iv_first_stage_green_dot"
            app:layout_constraintTop_toBottomOf="@+id/iv_first_stage_green_dot"/>
        <androidx.constraintlayout.widget.Barrier
            android:orientation="vertical"
            android:id="@+id/barrier_stage_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="iv_first_stage_green_dot, iv_second_stage_inactive"/>
        <ImageView
            android:id="@+id/iv_second_stage_inactive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_2"
            app:layout_constraintEnd_toEndOf="@+id/iv_first_stage_green_dot"
            app:layout_constraintStart_toStartOf="@+id/iv_first_stage_green_dot"
            app:layout_constraintTop_toBottomOf="@+id/v_line_status"
            app:srcCompat="@drawable/ic_round_inactive"/>
        <TextView
            android:textColor="?attr/themeColorTextGreen"
            android:id="@+id/tv_company_stage"
            android:tag="binding_7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/spacing_4"
            app:layout_constraintBottom_toBottomOf="@+id/iv_first_stage_green_dot"
            app:layout_constraintStart_toEndOf="@+id/barrier_stage_icon"
            app:layout_constraintTop_toTopOf="@+id/iv_first_stage_green_dot"
            style="@style/TypeStyles.HeadingXSmall"/>
        <TextView
            android:textColor="?attr/themeColorTextTetriary"
            android:id="@+id/tv_company_ipo_stage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IPO"
            android:maxLines="1"
            android:layout_marginStart="@dimen/spacing_4"
            app:layout_constraintBottom_toBottomOf="@+id/iv_second_stage_inactive"
            app:layout_constraintStart_toEndOf="@+id/barrier_stage_icon"
            app:layout_constraintTop_toTopOf="@+id/iv_second_stage_inactive"
            style="@style/TypeStyles.HeadingXSmall"/>
        <TextView
            android:id="@+id/tv_order_state"
            android:tag="binding_8"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/spacing_4"
            android:paddingHorizontal="@dimen/spacing_6"
            app:layout_constraintBottom_toBottomOf="@+id/tv_company_stage"
            app:layout_constraintStart_toEndOf="@+id/tv_company_stage"
            app:layout_constraintTop_toTopOf="@+id/tv_company_stage"
            style="@style/TypeStyles.BodyXSmall"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_eipo_past_stage"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_8"
        android:layout_marginStart="@dimen/spacing_16"
        app:layout_constraintBottom_toTopOf="@+id/barrier_stage_bottom"
        app:layout_constraintTop_toBottomOf="@+id/v_separator">
        <TextView
            android:id="@+id/tv_company_ipo_stage_past"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IPO"
            android:maxLines="1"
            android:layout_marginStart="@dimen/spacing_4"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingXSmall"/>
        <TextView
            android:id="@+id/tv_order_state_past"
            android:tag="binding_9"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_marginStart="@dimen/spacing_4"
            android:paddingHorizontal="@dimen/spacing_6"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_company_ipo_stage_past"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.BodyXSmall"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:ellipsize="end"
            android:id="@+id/tv_company_ipo_date_past"
            android:tag="binding_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textAlignment="textEnd"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.BodyXXSmall"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.Barrier
        android:orientation="horizontal"
        android:id="@+id/barrier_stage_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="cl_company_stage_layout, cl_eipo_past_stage"/>
    <com.stockbit.common.uikit.BitRoundedLayout
        android:id="@+id/brl_detail"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="@dimen/item_gap_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/barrier_stage_bottom"
        app:roundedColor="?attr/selectableSurfacePositiveColor">
        <TextView
            android:textSize="@dimen/text_size_13"
            android:textColor="@color/green_text"
            android:id="@+id/tv_detail_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/item_gap_l"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SbTextView.TitleContent"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/avatar_size_xxxs"
            android:src="@drawable/ic_chevron_right"
            android:layout_marginEnd="@dimen/item_gap_l"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.stockbit.common.uikit.BitRoundedLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
