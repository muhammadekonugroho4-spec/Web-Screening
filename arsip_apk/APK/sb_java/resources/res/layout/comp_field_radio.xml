<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_field_radio_0"
    android:paddingBottom="@dimen/spacing_24"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/actv_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/actv_optional"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.HeadingXSmall"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/actv_optional"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/lbl_securities_oa_optional"
        android:layout_marginStart="2dp"
        app:layout_constraintBottom_toBottomOf="@+id/actv_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/actv_label"
        app:layout_constraintTop_toTopOf="@+id/actv_label"
        style="@style/SbTextView.FieldTitle"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_8"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/actv_label"
        app:spanCount="2"/>
</androidx.constraintlayout.widget.ConstraintLayout>
