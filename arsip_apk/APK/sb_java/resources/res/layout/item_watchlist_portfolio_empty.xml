<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:orientation="vertical"
    android:tag="layout/item_watchlist_portfolio_empty_0"
    android:paddingTop="@dimen/item_gap_l"
    android:paddingBottom="@dimen/clickable_size_24"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/iv_empty"
        android:paddingBottom="@dimen/item_gap_l"
        android:layout_width="@dimen/width_160"
        android:layout_height="wrap_content"
        app:srcCompat="@drawable/ic_empty_state_portfolio_dark"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/item_gap_16"
        android:text="@string/portfolio_empty_title"
        android:textAlignment="gravity"
        style="@style/SbTextView.PageTitle"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/portfolio_empty_subtitle"
        style="@style/TypeStyles.BodyLarge"/>
    <com.stockbit.uikit.button.EllipseButton
        android:id="@+id/btn_discover"
        android:paddingLeft="@dimen/item_gap_30"
        android:paddingRight="@dimen/item_gap_30"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/default_button_height"
        android:layout_marginLeft="@dimen/item_gap_50"
        android:layout_marginTop="@dimen/item_gap_24"
        android:layout_marginRight="@dimen/item_gap_50"
        android:text="@string/portfolio_empty_discover"/>
</LinearLayout>
