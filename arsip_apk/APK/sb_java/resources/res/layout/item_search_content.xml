<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/add"
    android:tag="layout/item_search_content_0"
    android:background="@drawable/bg_list_selector"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/clickable_size_64">
    <ImageView
        android:id="@+id/iv_company_logo"
        android:layout_width="@dimen/item_gap_32"
        android:layout_height="@dimen/item_gap_32"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/spacing_20"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:gravity="left"
        android:orientation="vertical"
        android:paddingRight="@dimen/item_gap_48"
        android:layout_width="0dp"
        android:layout_height="@dimen/clickable_size_64"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/spacing_8"
        android:layout_toStartOf="@+id/vf_follow_action"
        android:layout_toEndOf="@+id/iv_company_logo">
        <androidx.appcompat.widget.AppCompatTextView
            android:gravity="bottom"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            style="@style/SbTextView.ListTitle"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:ellipsize="end"
            android:gravity="top"
            android:id="@+id/nameCompany"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/item_gap_2"
            android:singleLine="true"
            android:layout_weight="1"
            style="@style/SbTextView.CaptionSecondary"/>
    </LinearLayout>
    <ViewFlipper
        android:id="@+id/vf_follow_action"
        android:layout_width="@dimen/clickable_size_24"
        android:layout_height="@dimen/clickable_size_24"
        android:layout_marginRight="@dimen/item_gap_l"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_item_unfollowed"
            android:tag="binding_3"
            android:padding="@dimen/spacing_2"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:scaleType="centerInside"
            android:tint="?attr/themeIconTintColor"
            app:srcCompat="@drawable/ic_add_circle_outline"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_item_followed"
            android:tag="binding_4"
            android:focusable="true"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_check_circle_green_18dp"/>
        <ProgressBar
            android:id="@+id/progress_follow_status"
            android:focusable="false"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="@dimen/clickable_size_24"
            android:layout_height="@dimen/clickable_size_24"
            android:indeterminate="true"
            android:indeterminateTint="@color/green_text"/>
    </ViewFlipper>
</RelativeLayout>
