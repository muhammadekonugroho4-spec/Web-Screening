<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sfl_profile_info"
    android:tag="layout/skeleton_profile_info_0"
    android:paddingTop="@dimen/item_gap_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/SBShimmerLayout">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/v_avatar"
            android:background="@drawable/uikit_bg_fb_shimmer_circular"
            android:layout_width="@dimen/width_60"
            android:layout_height="@dimen/height_60"
            android:layout_marginStart="@dimen/spacing_20"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_full_name"
            android:background="@drawable/uikit_bg_fb_shimmer_normal"
            android:layout_width="@dimen/width_130"
            android:layout_height="@dimen/height_19"
            android:layout_marginStart="@dimen/spacing_12"
            app:layout_constraintStart_toEndOf="@+id/v_avatar"
            app:layout_constraintTop_toTopOf="@+id/v_avatar"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_total_post"
            android:background="@drawable/uikit_bg_fb_shimmer_normal"
            android:layout_width="@dimen/width_51"
            android:layout_height="@dimen/height_19"
            android:layout_marginTop="@dimen/spacing_6"
            app:layout_constraintStart_toStartOf="@+id/v_full_name"
            app:layout_constraintTop_toBottomOf="@+id/v_full_name"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_total_followers"
            android:background="@drawable/uikit_bg_fb_shimmer_normal"
            android:layout_width="@dimen/width_51"
            android:layout_height="@dimen/height_19"
            android:layout_marginStart="@dimen/item_gap_30"
            app:layout_constraintBottom_toBottomOf="@+id/v_total_post"
            app:layout_constraintStart_toEndOf="@+id/v_total_post"
            app:layout_constraintTop_toTopOf="@+id/v_total_post"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_total_following"
            android:background="@drawable/uikit_bg_fb_shimmer_normal"
            android:layout_width="@dimen/width_51"
            android:layout_height="@dimen/height_19"
            android:layout_marginStart="@dimen/item_gap_30"
            app:layout_constraintBottom_toBottomOf="@+id/v_total_post"
            app:layout_constraintStart_toEndOf="@+id/v_total_followers"
            app:layout_constraintTop_toTopOf="@+id/v_total_post"
            style="@style/SBShimmerItem"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/light_type_textsecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_user_post"
            app:layout_constraintStart_toStartOf="@+id/v_total_post"
            app:layout_constraintTop_toBottomOf="@+id/v_total_post"
            style="@style/TypeStyles.BodyXSmall"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/light_type_textsecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_user_followers"
            app:layout_constraintStart_toStartOf="@+id/v_total_followers"
            app:layout_constraintTop_toBottomOf="@+id/v_total_followers"
            style="@style/TypeStyles.BodyXSmall"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textColor="@color/light_type_textsecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_user_following"
            app:layout_constraintStart_toStartOf="@+id/v_total_following"
            app:layout_constraintTop_toBottomOf="@+id/v_total_following"
            style="@style/TypeStyles.BodyXSmall"/>
        <View
            android:id="@+id/v_description"
            android:background="@drawable/uikit_bg_fb_shimmer_normal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_16"
            android:layout_marginTop="@dimen/spacing_16"
            android:layout_marginStart="@dimen/spacing_20"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_avatar"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_website"
            android:background="@drawable/uikit_bg_fb_shimmer_normal"
            android:layout_width="@dimen/width_67"
            android:layout_height="@dimen/height_16"
            android:layout_marginTop="@dimen/spacing_4"
            app:layout_constraintStart_toStartOf="@+id/v_description"
            app:layout_constraintTop_toBottomOf="@+id/v_description"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_join_date"
            android:background="@drawable/uikit_bg_fb_shimmer_normal"
            android:layout_width="@dimen/width_142"
            android:layout_height="@dimen/height_16"
            android:layout_marginTop="@dimen/spacing_4"
            app:layout_constraintStart_toStartOf="@+id/v_website"
            app:layout_constraintTop_toBottomOf="@+id/v_website"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_btn_follow"
            android:background="@drawable/uikit_bg_fb_shimmer_normal"
            android:layout_width="0dp"
            android:layout_height="@dimen/height_40"
            android:layout_marginTop="@dimen/spacing_16"
            android:layout_marginStart="@dimen/spacing_20"
            android:layout_marginEnd="@dimen/item_gap_3_point_5"
            app:layout_constraintEnd_toStartOf="@+id/v_btn_chat"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_join_date"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_btn_chat"
            android:background="@drawable/uikit_bg_fb_shimmer_normal"
            android:layout_width="0dp"
            android:layout_height="@dimen/height_40"
            android:layout_marginTop="@dimen/spacing_16"
            android:layout_marginStart="@dimen/item_gap_3_point_5"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/v_btn_follow"
            app:layout_constraintTop_toBottomOf="@+id/v_join_date"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_separator_profile_info"
            android:background="?attr/themeColorDividerThick"
            android:layout_width="0dp"
            android:layout_height="@dimen/item_gap_8"
            android:layout_marginTop="@dimen/item_gap_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_btn_follow"/>
        <View
            android:id="@+id/v_avatar_post"
            android:background="@drawable/uikit_bg_fb_shimmer_circular"
            android:layout_width="@dimen/width_40"
            android:layout_height="@dimen/height_40"
            android:layout_marginTop="@dimen/spacing_16"
            android:layout_marginStart="@dimen/spacing_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_separator_profile_info"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_area_post"
            android:background="@drawable/uikit_bg_fb_shimmer_normal"
            android:layout_width="0dp"
            android:layout_height="@dimen/height_40"
            android:layout_marginStart="@dimen/spacing_8"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintBottom_toBottomOf="@+id/v_avatar_post"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/v_avatar_post"
            app:layout_constraintTop_toTopOf="@+id/v_avatar_post"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_separator_line"
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_marginTop="@dimen/spacing_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_avatar_post"/>
        <View
            android:id="@+id/v_area_chip"
            android:background="@drawable/uikit_bg_fb_shimmer_normal"
            android:layout_width="0dp"
            android:layout_height="@dimen/height_28"
            android:layout_marginTop="@dimen/spacing_14"
            android:layout_marginStart="@dimen/spacing_20"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_separator_line"
            style="@style/SBShimmerItem"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:scaleType="fitCenter"
            android:layout_centerVertical="true"
            android:contentDescription="@string/hint_search_content"
            android:layout_marginStart="@dimen/spacing_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_area_chip"
            app:srcCompat="@drawable/ic_search_stream"
            app:tint="@color/highgray_light"/>
        <TextView
            android:textColor="?attr/themeColorTextTetriary"
            android:id="@+id/tv_search_placeholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tv_search_stream_shimmer"
            android:layout_marginStart="@dimen/item_gap_10"
            app:layout_constraintBottom_toBottomOf="@+id/iv_search"
            app:layout_constraintStart_toEndOf="@+id/iv_search"
            app:layout_constraintTop_toTopOf="@+id/iv_search"
            style="@style/TypeStyles.BodyRegular"/>
        <View
            android:id="@+id/v_separator_line_stream"
            android:background="?attr/themeColorBorder"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_marginTop="@dimen/spacing_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_search_placeholder"/>
        <View
            android:id="@+id/v_avatar_post_comment"
            android:background="@drawable/uikit_bg_fb_shimmer_circular"
            android:layout_width="@dimen/width_40"
            android:layout_height="@dimen/height_40"
            android:layout_marginTop="@dimen/spacing_20"
            android:layout_marginStart="@dimen/spacing_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_separator_line_stream"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_area_username_post"
            android:background="@drawable/uikit_bg_fb_shimmer_normal"
            android:layout_width="@dimen/width_214"
            android:layout_height="@dimen/height_16"
            android:layout_marginStart="@dimen/spacing_8"
            app:layout_constraintStart_toEndOf="@+id/v_avatar_post_comment"
            app:layout_constraintTop_toTopOf="@+id/v_avatar_post_comment"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_area_date_post"
            android:background="@drawable/uikit_bg_fb_shimmer_normal"
            android:layout_width="@dimen/width_79"
            android:layout_height="@dimen/height_16"
            android:layout_marginTop="@dimen/spacing_6"
            app:layout_constraintStart_toStartOf="@+id/v_area_username_post"
            app:layout_constraintTop_toBottomOf="@+id/v_area_username_post"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_area_comment_post"
            android:background="@drawable/uikit_bg_fb_shimmer_normal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_80"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginStart="@dimen/spacing_20"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_avatar_post_comment"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_separator_stream_item"
            android:background="?attr/themeColorDividerThick"
            android:layout_width="0dp"
            android:layout_height="@dimen/item_gap_8"
            android:layout_marginTop="@dimen/item_gap_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_area_comment_post"/>
        <View
            android:id="@+id/v_avatar_post_comment_2"
            android:background="@drawable/uikit_bg_fb_shimmer_circular"
            android:layout_width="@dimen/width_40"
            android:layout_height="@dimen/height_40"
            android:layout_marginTop="@dimen/spacing_20"
            android:layout_marginStart="@dimen/spacing_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_separator_stream_item"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_area_username_post_2"
            android:background="@drawable/uikit_bg_fb_shimmer_normal"
            android:layout_width="@dimen/width_214"
            android:layout_height="@dimen/height_16"
            android:layout_marginStart="@dimen/spacing_8"
            app:layout_constraintStart_toEndOf="@+id/v_avatar_post_comment_2"
            app:layout_constraintTop_toTopOf="@+id/v_avatar_post_comment_2"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_area_date_post_2"
            android:background="@drawable/uikit_bg_fb_shimmer_normal"
            android:layout_width="@dimen/width_79"
            android:layout_height="@dimen/height_16"
            android:layout_marginTop="@dimen/spacing_6"
            app:layout_constraintStart_toStartOf="@+id/v_area_username_post_2"
            app:layout_constraintTop_toBottomOf="@+id/v_area_username_post_2"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_area_comment_post_2"
            android:background="@drawable/uikit_bg_fb_shimmer_normal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_80"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginStart="@dimen/spacing_20"
            android:layout_marginEnd="@dimen/spacing_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_avatar_post_comment_2"
            style="@style/SBShimmerItem"/>
        <View
            android:id="@+id/v_separator_stream_item_2"
            android:background="?attr/themeColorDividerThick"
            android:layout_width="0dp"
            android:layout_height="@dimen/item_gap_8"
            android:layout_marginTop="@dimen/item_gap_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_area_comment_post_2"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
