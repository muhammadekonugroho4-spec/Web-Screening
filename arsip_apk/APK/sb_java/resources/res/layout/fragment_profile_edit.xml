<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_profile_edit_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_setting_profile"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_scrollFlags="enterAlways|scroll">
        <TextView
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_personal_detail"
            android:contentDescription="@string/SOCIAL_PROFILE_1"
            style="@style/SbTextView.PageTitle"/>
    </androidx.appcompat.widget.Toolbar>
    <View
        android:id="@+id/view_setting_toolbar_line"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        app:layout_constraintTop_toBottomOf="@+id/toolbar_setting_profile"/>
    <ProgressBar
        android:id="@+id/pb_setting_profile"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-7dp"
        android:layout_marginBottom="-7dp"
        android:indeterminate="true"
        app:layout_constraintTop_toBottomOf="@+id/view_setting_toolbar_line"
        style="?android:attr/progressBarStyleHorizontal"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/ll_setting_profile_save_container"
        app:layout_constraintTop_toBottomOf="@+id/pb_setting_profile">
        <RelativeLayout
            android:id="@+id/rl_profile_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rl_edit_profile_container"
                android:tag="binding_2"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="@dimen/activity_vertical_margin"
                android:paddingBottom="@dimen/activity_vertical_margin"
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_edit_profile_avatar"
                    android:tag="binding_3"
                    android:layout_width="@dimen/avatar_size_m"
                    android:layout_height="@dimen/avatar_size_m"
                    android:layout_centerHorizontal="true"
                    app:srcCompat="@drawable/ic_avatar"/>
                <TextView
                    android:textSize="@dimen/text_size_13"
                    android:id="@+id/change_profile_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_l"
                    android:text="@string/button_personal_detail_change_picture"
                    android:layout_below="@+id/iv_edit_profile_avatar"
                    android:layout_centerHorizontal="true"
                    android:fontFamily="sans-serif"
                    style="@style/SbTextView.BodyDefault.Green"/>
            </RelativeLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_edit_profile_fullname_icon"
                android:background="@color/transparent"
                android:layout_width="@dimen/avatar_size_xs"
                android:layout_height="@dimen/avatar_size_xs"
                android:layout_marginTop="@dimen/item_gap_l"
                android:layout_marginBottom="@dimen/item_gap_l"
                android:layout_below="@+id/rl_edit_profile_container"
                android:layout_marginStart="@dimen/item_gap_l"
                android:layout_marginEnd="@dimen/item_gap_l"
                app:srcCompat="@drawable/ic_user"
                app:tint="?attr/titleTextColorSemiMediumHighempasis"/>
            <EditText
                android:id="@+id/et_edit_profile_fullname"
                android:tag="binding_4"
                android:layout_width="match_parent"
                android:layout_height="@dimen/clickable_size_48"
                android:hint="@string/placeholder_personal_detail_fullname"
                android:maxLines="1"
                android:layout_below="@+id/rl_edit_profile_container"
                android:inputType="textNoSuggestions"
                android:layout_marginEnd="@dimen/item_gap_l"
                android:layout_toEndOf="@+id/iv_edit_profile_fullname_icon"
                style="@style/SbEditTextStyle.GreenAccent"/>
            <TextView
                android:id="@+id/tv_error_full_name"
                android:tag="binding_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="0dp"
                android:text="@string/toast_personal_detail_fullname_empty"
                android:layout_below="@+id/et_edit_profile_fullname"
                android:layout_toEndOf="@+id/iv_edit_profile_fullname_icon"
                style="@style/SbTextView.InputError"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_edit_profile_username_icon"
                android:background="@color/transparent"
                android:layout_width="@dimen/avatar_size_xs"
                android:layout_height="@dimen/avatar_size_xs"
                android:layout_marginTop="@dimen/item_gap_22"
                android:layout_marginBottom="@dimen/item_gap_l"
                android:layout_below="@+id/tv_error_full_name"
                android:layout_marginStart="@dimen/item_gap_l"
                android:layout_marginEnd="@dimen/item_gap_l"
                app:srcCompat="@drawable/ic_at"
                app:tint="?attr/titleTextColorSemiMediumHighempasis"/>
            <EditText
                android:enabled="false"
                android:id="@+id/et_edit_profile_username"
                android:tag="binding_6"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="@dimen/clickable_size_48"
                android:layout_marginTop="@dimen/item_gap_s"
                android:layout_marginBottom="@dimen/item_gap_s"
                android:hint="@string/setting_edit_profile_username_subtitle"
                android:maxLines="1"
                android:layout_below="@+id/tv_error_full_name"
                android:inputType="textNoSuggestions"
                android:layout_marginEnd="@dimen/item_gap_l"
                android:layout_toEndOf="@+id/iv_edit_profile_username_icon"
                style="@style/SbEditTextStyle.GreenAccent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_edit_profile_website_link_icon"
                android:background="@color/transparent"
                android:layout_width="@dimen/avatar_size_xs"
                android:layout_height="@dimen/avatar_size_xs"
                android:layout_margin="@dimen/item_gap_l"
                android:layout_below="@+id/et_edit_profile_username"
                app:srcCompat="@drawable/ic_link"
                app:tint="?attr/titleTextColorSemiMediumHighempasis"/>
            <EditText
                android:id="@+id/et_edit_profile_website_link"
                android:tag="binding_7"
                android:layout_width="match_parent"
                android:layout_height="@dimen/clickable_size_48"
                android:layout_marginBottom="@dimen/item_gap_s"
                android:hint="@string/placeholder_personal_detail_website"
                android:maxLines="1"
                android:layout_below="@+id/et_edit_profile_username"
                android:inputType="textNoSuggestions"
                android:layout_marginEnd="@dimen/item_gap_l"
                android:layout_toEndOf="@+id/iv_edit_profile_username_icon"
                style="@style/SbEditTextStyle.GreenAccent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_edit_profile_bio_icon"
                android:background="@color/transparent"
                android:layout_width="@dimen/avatar_size_xs"
                android:layout_height="@dimen/avatar_size_xs"
                android:layout_margin="@dimen/item_gap_l"
                android:layout_below="@+id/et_edit_profile_website_link"
                app:srcCompat="@drawable/ic_menu_chat_black_24dp"
                app:tint="?attr/titleTextColorSemiMediumHighempasis"/>
            <EditText
                android:id="@+id/et_edit_profile_bio"
                android:tag="binding_8"
                android:layout_width="match_parent"
                android:layout_height="@dimen/clickable_size_48"
                android:layout_marginBottom="@dimen/item_gap_s"
                android:hint="@string/placeholder_personal_detail_biography"
                android:maxLines="1"
                android:layout_below="@+id/et_edit_profile_website_link"
                android:inputType="textNoSuggestions"
                android:layout_marginEnd="@dimen/item_gap_l"
                android:layout_toEndOf="@+id/iv_edit_profile_bio_icon"
                style="@style/SbEditTextStyle.GreenAccent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_edit_profile_gender_icon"
                android:background="@color/transparent"
                android:layout_width="@dimen/avatar_size_xs"
                android:layout_height="@dimen/avatar_size_xs"
                android:layout_margin="@dimen/item_gap_l"
                android:layout_below="@+id/et_edit_profile_bio"
                app:srcCompat="@drawable/ic_gender"
                app:tint="?attr/titleTextColorSemiMediumHighempasis"/>
            <EditText
                android:textColor="?attr/titleTextColorSemiMediumHighempasis"
                android:id="@+id/et_edit_profile_gender"
                android:tag="binding_9"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:layout_width="match_parent"
                android:layout_height="@dimen/clickable_size_48"
                android:foreground="?attr/selectableItemBackground"
                android:hint="@string/dropdown_personal_detail_gender"
                android:cursorVisible="false"
                android:maxLines="1"
                android:layout_below="@+id/et_edit_profile_bio"
                android:inputType="textNoSuggestions"
                android:drawableEnd="0x7f0804bc"
                android:layout_marginEnd="@dimen/item_gap_l"
                android:layout_toEndOf="@+id/iv_edit_profile_gender_icon"
                android:drawableTint="?attr/titleTextColorSemiMediumHighempasis"
                style="@style/SbEditTextStyle"/>
        </RelativeLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_setting_profile_save_container"
        android:background="?attr/themeContentBackground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toBottomOf="parent">
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_1"/>
        <com.stockbit.common.uikit.StockbitLoadingButton
            android:id="@+id/btn_save_edit_profile"
            android:tag="binding_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/item_gap_l"
            android:contentDescription="@string/SOCIAL_PROFILE_2"
            app:buttonText="@string/button_change_data"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
