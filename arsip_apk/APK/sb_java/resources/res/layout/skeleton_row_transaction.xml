<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/skeleton_row_transaction_0"
    android:background="@drawable/bg_gray_icon_primary_dark"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/item_gap_8"
    android:layout_marginBottom="@dimen/item_gap_8"
    android:paddingStart="@dimen/item_gap_16"
    android:paddingVertical="@dimen/item_gap_16">
    <View
        android:id="@+id/view_logo"
        android:background="@drawable/ic_circle_grey"
        android:layout_width="@dimen/item_gap_36"
        android:layout_height="@dimen/item_gap_36"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_securities"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_16"
        android:layout_weight="0.4"
        android:layout_marginStart="@dimen/item_gap_16"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/view_logo"
        app:layout_constraintTop_toTopOf="@+id/view_logo"
        app:layout_constraintWidth_percent="0.5"/>
    <View
        android:id="@+id/view_date"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_16"
        android:layout_marginTop="@dimen/item_gap_4"
        android:layout_weight="0.4"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/view_securities"
        app:layout_constraintTop_toBottomOf="@+id/view_securities"
        app:layout_constraintWidth_percent="0.2"/>
    <View
        android:id="@+id/view_separator"
        android:background="?attr/themeSeparatorGapColor"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_16"
        android:layout_marginEnd="@dimen/item_gap_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/view_date"
        app:layout_constraintTop_toBottomOf="@+id/view_date"/>
    <View
        android:id="@+id/view_stepper_one"
        android:background="@drawable/ic_circle_grey"
        android:layout_width="@dimen/item_gap_10"
        android:layout_height="@dimen/item_gap_10"
        android:layout_marginTop="16dp"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintStart_toStartOf="@+id/view_separator"
        app:layout_constraintTop_toBottomOf="@+id/view_separator"/>
    <View
        android:id="@+id/separator_first_to_second"
        android:background="?attr/themeSeparatorGapColor"
        android:layout_width="@dimen/item_gap_xxxs"
        android:layout_height="@dimen/item_gap_29"
        app:layout_constraintEnd_toEndOf="@+id/view_stepper_one"
        app:layout_constraintStart_toStartOf="@+id/view_stepper_one"
        app:layout_constraintTop_toBottomOf="@+id/view_stepper_one"/>
    <View
        android:id="@+id/view_stepper_two"
        android:background="@drawable/ic_circle_grey"
        android:layout_width="@dimen/item_gap_10"
        android:layout_height="@dimen/item_gap_10"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintStart_toStartOf="@+id/view_stepper_one"
        app:layout_constraintTop_toBottomOf="@+id/separator_first_to_second"/>
    <View
        android:id="@+id/separator_second_to_third"
        android:background="?attr/themeSeparatorGapColor"
        android:layout_width="@dimen/item_gap_xxxs"
        android:layout_height="@dimen/item_gap_29"
        app:layout_constraintEnd_toEndOf="@+id/view_stepper_two"
        app:layout_constraintStart_toStartOf="@+id/view_stepper_two"
        app:layout_constraintTop_toBottomOf="@+id/view_stepper_two"/>
    <View
        android:id="@+id/view_stepper_three"
        android:background="@drawable/ic_circle_grey"
        android:layout_width="@dimen/item_gap_10"
        android:layout_height="@dimen/item_gap_10"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintStart_toStartOf="@+id/view_stepper_one"
        app:layout_constraintTop_toBottomOf="@+id/separator_second_to_third"/>
    <View
        android:id="@+id/view_first_item"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_16"
        android:layout_weight="0.4"
        android:layout_marginStart="@dimen/item_gap_16"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintStart_toEndOf="@+id/view_stepper_one"
        app:layout_constraintTop_toTopOf="@+id/view_stepper_one"
        app:layout_constraintWidth_percent="0.5"/>
    <View
        android:id="@+id/view_second_item"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_16"
        android:layout_weight="0.4"
        android:layout_marginStart="@dimen/item_gap_16"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintStart_toEndOf="@+id/view_stepper_one"
        app:layout_constraintTop_toTopOf="@+id/view_stepper_two"
        app:layout_constraintWidth_percent="0.3"/>
    <View
        android:id="@+id/view_third_item"
        android:background="@drawable/bg_rounded_gray"
        android:layout_width="0dp"
        android:layout_height="@dimen/item_gap_16"
        android:layout_weight="0.4"
        android:layout_marginStart="@dimen/item_gap_16"
        android:backgroundTint="?attr/themeSeparatorGapColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/view_stepper_one"
        app:layout_constraintTop_toTopOf="@+id/view_stepper_three"
        app:layout_constraintWidth_percent="0.4"/>
</androidx.constraintlayout.widget.ConstraintLayout>
