<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.Toolbar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/genericToolbar"
    android:tag="layout/toolbar_with_subtitle_small_font_0"
    android:paddingLeft="@dimen/item_gap_null"
    android:paddingRight="@dimen/item_gap_null"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/actionBarSize"
    app:contentInsetLeft="@dimen/item_gap_null"
    app:contentInsetStart="@dimen/item_gap_null"
    app:contentInsetStartWithNavigation="@dimen/item_gap_null"
    app:elevation="@dimen/item_gap_null">
    <RelativeLayout
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/rl_parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize">
        <TextView
            android:ellipsize="middle"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:paddingLeft="@dimen/item_gap_l"
            android:paddingRight="@dimen/item_gap_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_centerHorizontal="true"
            android:textAlignment="gravity"
            style="@style/TypeStyles.HeadingSmall"/>
        <TextView
            android:ellipsize="middle"
            android:gravity="center"
            android:id="@+id/tv_subtitle"
            android:paddingLeft="@dimen/item_gap_l"
            android:paddingRight="@dimen/item_gap_l"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_below="@+id/tv_title"
            android:layout_centerHorizontal="true"
            android:textAlignment="gravity"
            style="@style/TypeStyles.BodyXXSmall"/>
    </RelativeLayout>
</androidx.appcompat.widget.Toolbar>
