<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_securities_term_condition_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:layout_scrollFlags="enterAlways|scroll">
        <TextView
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/tv_toolbar_term_condition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trading_limit_term_condition_header"
            style="@style/TypeStyles.HeadingLarge"/>
    </androidx.appcompat.widget.Toolbar>
    <ViewFlipper
        android:id="@+id/vf"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/pb_disclaimer_smart_order"
            android:layout_width="@dimen/clickable_size_32"
            android:layout_height="@dimen/clickable_size_32"
            android:indeterminate="true"
            android:indeterminateTint="@color/green_text"
            style="@style/Widget.AppCompat.ProgressBar"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <WebView
                android:id="@+id/webview"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginHorizontal="@dimen/item_gap_20"
                app:layout_constraintBottom_toTopOf="@+id/v_divier"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/v_divier"
                android:background="?attr/themeSeparatorGapColorButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/item_gap_xxxs"
                android:layout_marginBottom="@dimen/item_gap_20"
                app:layout_constraintBottom_toTopOf="@+id/ll_agreement_container"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <LinearLayout
                android:layout_gravity="center"
                android:id="@+id/ll_agreement_container"
                android:layout_width="@dimen/item_gap_null"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/item_gap_16"
                android:layout_marginStart="@dimen/spacing_20"
                android:layout_marginEnd="@dimen/spacing_20"
                app:layout_constraintBottom_toTopOf="@+id/pb_next"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">
                <androidx.appcompat.widget.AppCompatCheckBox
                    android:layout_gravity="center_vertical"
                    android:id="@+id/check_agreement"
                    android:padding="@dimen/spacing_4"
                    android:layout_width="@dimen/clickable_size_20"
                    android:layout_height="@dimen/clickable_size_20"
                    android:checked="false"
                    android:button="@drawable/bg_checkbox_box"/>
                <TextView
                    android:textSize="@dimen/text_size_12"
                    android:textColor="?attr/themeColorTextPrimary"
                    android:layout_gravity="center"
                    android:id="@+id/tv_agreement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/item_gap_12"
                    style="@style/SbTextView.BodyDefault"/>
            </LinearLayout>
            <com.stockbit.uikit.buttons.PrimaryButton
                android:id="@+id/pb_next"
                android:layout_width="match_parent"
                android:layout_height="@dimen/clickable_size_48"
                android:layout_marginBottom="@dimen/item_gap_40"
                android:text="@string/lbl_btn_continue"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="@dimen/item_gap_20"
                android:layout_marginEnd="@dimen/item_gap_20"
                app:isActive="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ViewFlipper>
</androidx.appcompat.widget.LinearLayoutCompat>
