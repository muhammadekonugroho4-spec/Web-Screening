<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mcv_news"
    android:tag="layout/comp_content_news_0"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackgroundBorderless"
    app:cardBackgroundColor="@color/transparent"
    app:cardCornerRadius="@dimen/shape_radius_m"
    app:cardElevation="@dimen/item_gap_null"
    app:strokeColor="?attr/themeColorBorder"
    app:strokeWidth="@dimen/item_gap_xxxs">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_news_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_width="wrap_content"
            android:layout_height="@dimen/stream_comp_post_height_96"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_news_image"
            android:tag="binding_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="?attr/themeSeparatorGapColor"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_report_stock"
            android:tag="binding_2"
            android:background="?attr/themeColorSurfaceVariant"
            android:layout_width="@dimen/item_gap_96"
            android:layout_height="0dp"
            android:minHeight="@dimen/item_gap_96"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadlineRegular"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_feed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:barrierDirection="right"
            app:constraint_referenced_ids="tv_report_stock"/>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_image"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="iv_news_image"/>
        <TextView
            android:id="@+id/tv_news_content"
            android:tag="binding_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_m"
            android:paddingHorizontal="@dimen/item_gap_l"
            app:layout_constraintBottom_toTopOf="@+id/tv_news_url"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/barrier_feed"
            app:layout_constraintTop_toTopOf="@+id/barrier_image"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_goneMarginBottom="@dimen/item_gap_m"
            style="@style/TypeStyles.BodyRegular"/>
        <ImageView
            android:id="@+id/iv_news_icon"
            android:tag="binding_4"
            android:layout_width="@dimen/spacing_12"
            android:layout_height="@dimen/spacing_12"
            android:layout_marginStart="@dimen/spacing_16"
            app:layout_constraintBottom_toBottomOf="@+id/tv_news_url"
            app:layout_constraintStart_toEndOf="@+id/barrier_feed"
            app:layout_constraintTop_toTopOf="@+id/tv_news_url"/>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:id="@+id/tv_news_url"
            android:tag="binding_5"
            android:layout_width="@dimen/spacing_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_6"
            android:layout_marginBottom="@dimen/item_gap_m"
            android:singleLine="true"
            android:layout_marginStart="@dimen/spacing_4"
            android:layout_marginEnd="@dimen/spacing_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_news_icon"
            app:layout_constraintTop_toBottomOf="@+id/tv_news_content"
            app:layout_goneMarginStart="@dimen/spacing_16"
            style="@style/TypeStyles.BodyXSmall"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
