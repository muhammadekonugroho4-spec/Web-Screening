<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_detail_transaction_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="@dimen/item_gap_null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Sb.Widget.AppBar">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize">
            <RelativeLayout
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/rl_toolbar_item"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minHeight="?attr/actionBarSize">
                <TextView
                    android:ellipsize="middle"
                    android:gravity="center"
                    android:id="@+id/tv_toolbar_title"
                    android:paddingLeft="@dimen/item_gap_l"
                    android:paddingRight="@dimen/item_gap_l"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/detail_transfer_stock"
                    android:singleLine="true"
                    android:layout_centerHorizontal="true"
                    android:textAlignment="gravity"
                    style="@style/SbTextView.ListTitle"/>
            </RelativeLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView
        android:background="?attr/themeColorSurfaceDefault"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:tag="binding_1"
            android:paddingBottom="@dimen/item_gap_20"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:minHeight="@dimen/height_500"
            android:paddingStart="@dimen/item_gap_20"
            android:paddingEnd="@dimen/item_gap_20">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ll_note"
                android:tag="binding_2"
                android:background="@drawable/bg_red_light_with_border"
                android:paddingTop="@dimen/item_gap_12"
                android:paddingBottom="@dimen/item_gap_12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/item_gap_15"
                android:paddingEnd="@dimen/item_gap_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_width="@dimen/item_gap_10"
                    android:layout_height="@dimen/item_gap_10"
                    android:layout_marginTop="@dimen/item_gap_xxxs"
                    app:srcCompat="@drawable/ic_info_fee"
                    app:tint="@color/red_item"/>
                <androidx.appcompat.widget.AppCompatTextView
                    android:tag="binding_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/item_gap_8"
                    style="@style/SbTextView.BodyDefault.Highempasis.Normal"/>
            </LinearLayout>
            <include
                android:id="@+id/layout_transfer_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_26"
                app:layout_constraintTop_toBottomOf="@+id/ll_note"
                layout="@layout/layout_detail_transfer_info"/>
            <TextView
                android:id="@+id/tv_detail_transfer"
                android:background="?attr/themeColorSurfaceDefault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_transfer"
                android:paddingStart="@dimen/item_gap_s"
                android:paddingEnd="@dimen/item_gap_s"
                android:layout_marginStart="10dp"
                app:layout_constraintBottom_toTopOf="@+id/layout_transfer_info"
                app:layout_constraintStart_toStartOf="@+id/layout_transfer_info"
                app:layout_constraintTop_toTopOf="@+id/layout_transfer_info"
                style="@style/SbTextView.BodyDefault.Highempasis.Bold"/>
            <include
                android:id="@+id/layout_detail_investor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_24"
                app:layout_constraintStart_toStartOf="@+id/layout_transfer_info"
                app:layout_constraintTop_toBottomOf="@+id/layout_transfer_info"
                layout="@layout/layout_detail_transfer_investor"/>
            <TextView
                android:id="@+id/tv_title_investor_data"
                android:background="?attr/themeColorSurfaceDefault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/investor_data"
                android:paddingStart="@dimen/item_gap_s"
                android:paddingEnd="@dimen/item_gap_s"
                android:layout_marginStart="@dimen/item_gap_14"
                app:layout_constraintBottom_toTopOf="@+id/layout_detail_investor"
                app:layout_constraintStart_toStartOf="@+id/layout_detail_investor"
                app:layout_constraintTop_toTopOf="@+id/layout_detail_investor"
                style="@style/SbTextView.BodyDefault.Highempasis.Bold"/>
            <include
                android:id="@+id/layout_stock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_24"
                app:layout_constraintEnd_toEndOf="@+id/layout_detail_investor"
                app:layout_constraintStart_toStartOf="@+id/layout_detail_investor"
                app:layout_constraintTop_toBottomOf="@+id/layout_detail_investor"
                layout="@layout/layout_detail_stock"/>
            <TextView
                android:id="@+id/tv_title_symbol"
                android:background="?attr/themeColorSurfaceDefault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/stock_code"
                android:paddingStart="@dimen/item_gap_s"
                android:paddingEnd="@dimen/item_gap_s"
                android:layout_marginStart="10dp"
                app:layout_constraintBottom_toTopOf="@+id/layout_stock"
                app:layout_constraintStart_toStartOf="@+id/layout_stock"
                app:layout_constraintTop_toTopOf="@+id/layout_stock"
                style="@style/SbTextView.BodyDefault.Highempasis.Bold"/>
            <include
                android:id="@+id/doc_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_16"
                app:layout_constraintEnd_toEndOf="@+id/layout_stock"
                app:layout_constraintStart_toStartOf="@+id/layout_stock"
                app:layout_constraintTop_toBottomOf="@+id/layout_stock"
                layout="@layout/layout_doc_list"/>
            <include
                android:id="@+id/layout_shipping_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_26"
                app:layout_constraintTop_toBottomOf="@+id/doc_list"
                layout="@layout/layout_detail_shipping_address"/>
            <TextView
                android:id="@+id/tv_shipping_address"
                android:tag="binding_4"
                android:background="?attr/themeColorSurfaceDefault"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shipping_address"
                android:paddingStart="@dimen/item_gap_s"
                android:paddingEnd="@dimen/item_gap_s"
                android:layout_marginStart="10dp"
                app:layout_constraintBottom_toTopOf="@+id/layout_shipping_address"
                app:layout_constraintStart_toStartOf="@+id/layout_shipping_address"
                app:layout_constraintTop_toTopOf="@+id/layout_shipping_address"
                style="@style/TypeStyles.HeadingRegular"/>
            <androidx.appcompat.widget.AppCompatButton
                android:textSize="@dimen/text_size_16"
                android:textColor="@color/white"
                android:id="@+id/btn_move_stock"
                android:tag="binding_5"
                android:background="@drawable/border_green_rounded"
                android:paddingTop="@dimen/item_gap_14"
                android:paddingBottom="@dimen/item_gap_14"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textAllCaps="false"
                android:paddingStart="@dimen/item_gap_36"
                android:paddingEnd="@dimen/item_gap_36"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_shipping_address"
                style="@style/SbTextView.Button.Regular"/>
            <RelativeLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/btn_cs"
                android:tag="binding_6"
                android:background="@drawable/bg_theme_content_gray_border_4"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_12"
                android:foregroundGravity="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_move_stock"
                style="@style/SbBtnBorderless">
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/green_text"
                    android:padding="0dp"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_11"
                    android:layout_marginBottom="@dimen/item_gap_11"
                    android:text="@string/chat_live_support"
                    android:drawablePadding="@dimen/item_gap_4"
                    android:drawableStart="@drawable/ic_live_support"
                    app:drawableTint="@color/green_text"
                    style="@style/SbTextView.BodyDefault.Highempasis.Bold"/>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/rl_cancel"
                android:tag="binding_7"
                android:background="@drawable/bg_theme_content_gray_border_4"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_gap_12"
                android:foregroundGravity="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_cs"
                app:layout_constraintVertical_bias="0"
                style="@style/SbBtnBorderless">
                <TextView
                    android:textSize="@dimen/text_size_16"
                    android:textColor="@color/red_item"
                    android:padding="0dp"
                    android:focusable="false"
                    android:clickable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/item_gap_11"
                    android:layout_marginBottom="@dimen/item_gap_11"
                    android:text="@string/cancel_request"
                    android:drawablePadding="@dimen/item_gap_4"
                    style="@style/SbTextView.BodyDefault.Highempasis.Bold"/>
            </RelativeLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
