<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_setting_language_layout"
    android:tag="layout/fragment_setting_language_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.stockbit.uikit.topbar.TopbarStockbitTitle
        android:id="@+id/tst_setting_language"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:topBarTitleTitle="@string/title_language"
        app:topBarType="CenterTitle"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_setting_indonesia_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_62"
        android:foreground="?android:attr/selectableItemBackground"
        android:paddingHorizontal="@dimen/spacing_20"
        app:layout_constraintTop_toBottomOf="@+id/tst_setting_language">
        <ImageView
            android:id="@+id/iv_flag_indonesia"
            android:layout_width="@dimen/width_30"
            android:layout_height="@dimen/height_30"
            android:src="?attr/themeIconFlagIndonesia30px"
            android:contentDescription="@string/text_content_description_flag_indonesia"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tv_setting_indonesia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/radio_language_indonesia"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/crb_setting_indonesia"
            app:layout_constraintStart_toEndOf="@+id/iv_flag_indonesia"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingLarge"/>
        <com.stockbit.uikit.control.ControlRadioButton
            android:id="@+id/crb_setting_indonesia"
            android:tag="binding_1"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_setting_indonesia"
            app:layout_constraintTop_toTopOf="parent"
            app:radioType="tick"/>
        <com.stockbit.uikit.divider.SBDivider
            android:layout_width="0dp"
            android:layout_height="@dimen/height_1"
            app:dividerVariant="thin_grey"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_setting_indonesia"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_setting_english_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_62"
        android:foreground="?android:attr/selectableItemBackground"
        android:paddingHorizontal="@dimen/spacing_20"
        app:layout_constraintTop_toBottomOf="@+id/cl_setting_indonesia_layout">
        <ImageView
            android:id="@+id/iv_flag_english"
            android:layout_width="@dimen/width_30"
            android:layout_height="@dimen/height_30"
            android:src="?attr/themeIconFlagUS30px"
            android:contentDescription="@string/text_content_description_flag_indonesia"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:id="@+id/tv_setting_english"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/radio_language_english"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/crb_setting_english"
            app:layout_constraintStart_toEndOf="@+id/iv_flag_english"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingLarge"/>
        <com.stockbit.uikit.control.ControlRadioButton
            android:id="@+id/crb_setting_english"
            android:tag="binding_2"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_setting_english"
            app:layout_constraintTop_toTopOf="parent"
            app:radioType="tick"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
