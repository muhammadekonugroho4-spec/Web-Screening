<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/ll_button_container"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon_left"
            android:focusable="false"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:layout_marginEnd="?attr/digital_identity_spacing_2x"/>
        <com.iab.digitalidentity.ui.text.KycPlusTextView
            android:ellipsize="end"
            android:id="@+id/tv_text"
            android:paddingTop="0.5dp"
            android:paddingBottom="0.5dp"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            android:textAlignment="center"
            app:kycPlusTypographyStyle="kyc_plus_title_small_bold_static_white"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon_right"
            android:focusable="false"
            android:visibility="gone"
            android:clickable="false"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:layout_marginStart="?attr/digital_identity_spacing_2x"/>
    </LinearLayout>
</merge>
