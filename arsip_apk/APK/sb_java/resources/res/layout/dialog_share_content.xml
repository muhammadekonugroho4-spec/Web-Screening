<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/ll_parent_share_content"
    android:tag="layout/dialog_share_content_0"
    android:background="?attr/themeColorSurfaceDefault"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <ScrollView
        android:id="@+id/sv_image_preview"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:tag="binding_1"
            android:padding="@dimen/spacing_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:id="@+id/comp_image_preview_share_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/comp_image_preview_share_content"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="bottom"
        android:orientation="vertical"
        android:tag="binding_2"
        android:background="@drawable/uikit_bg_bottom_sheet_collapsed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="center"
            android:id="@+id/v_handle"
            android:background="@drawable/bg_bottomsheetdialog_handle"
            android:layout_width="@dimen/uikit_bottomsheet_handle_width"
            android:layout_height="@dimen/uikit_bottomsheet_handle_height"
            android:layout_marginVertical="@dimen/spacing_12"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_title"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:layout_marginBottom="@dimen/item_gap_16"
            android:text="@string/send_section"
            android:layout_marginHorizontal="@dimen/spacing_20"
            style="@style/TopBar.Title"/>
        <ScrollView
            android:id="@+id/sv_image_generator"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <TextView
            android:id="@+id/tv_send_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="@string/send_section"
            android:layout_marginHorizontal="@dimen/spacing_20"
            style="@style/TypeStyles.HeadingRegular"/>
        <include
            android:id="@+id/comp_send_to_chat"
            layout="@layout/comp_send_to_chat"/>
        <View
            android:id="@+id/divider"
            android:background="?attr/themeSeparatorGapColorNewSecondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_1"/>
        <TextView
            android:id="@+id/tv_share_section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_16"
            android:text="@string/share_section"
            android:layout_marginHorizontal="@dimen/spacing_20"
            style="@style/TypeStyles.HeadingRegular"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/rv_share_to_app"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginBottom="@dimen/spacing_16"
            android:paddingHorizontal="@dimen/spacing_20"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <View
            android:id="@+id/divider_share_text_message"
            android:background="?attr/themeSeparatorGapColorNewSecondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_1"/>
        <LinearLayout
            android:orientation="horizontal"
            android:paddingTop="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_20">
            <com.google.android.material.button.MaterialButton
                android:textAppearance="@style/TypeStyles.BodyRegular"
                android:textStyle="bold"
                android:textColor="?attr/themeColorTextPrimary"
                android:id="@+id/btn_copy_link"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/copy_button"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginEnd="10dp"
                android:backgroundTint="?attr/themeColorModalsEmphasis"
                app:cornerRadius="6dp"
                app:icon="@drawable/ic_link"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="24dp"
                app:iconTint="?attr/themeColorTextGreen"
                app:strokeColor="?attr/themeColorBorderButtonSecondaryNeutralActive"
                app:strokeWidth="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton
                android:textAppearance="@style/TypeStyles.BodyRegular"
                android:textStyle="bold"
                android:textColor="?attr/themeColorTextPrimary"
                android:id="@+id/btn_repost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/repost_button"
                android:layout_weight="1"
                android:textAllCaps="false"
                android:layout_marginStart="10dp"
                android:backgroundTint="?attr/themeColorModalsEmphasis"
                app:cornerRadius="6dp"
                app:icon="@drawable/ic_repost"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="24dp"
                app:iconTint="?attr/themeColorTextGreen"
                app:strokeColor="?attr/themeColorBorderButtonSecondaryNeutralActive"
                app:strokeWidth="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
        </LinearLayout>
        <include
            android:id="@+id/comp_share_text_message"
            android:visibility="gone"
            layout="@layout/comp_share_text_message"/>
        <com.google.android.material.button.MaterialButton
            android:textAppearance="@style/TypeStyles.BodyRegular"
            android:textColor="?attr/themeColorTextPrimary"
            android:id="@+id/btn_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/button_cancel"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:backgroundTint="?attr/themeColorModalsEmphasis"
            android:paddingHorizontal="@dimen/item_gap_20"
            android:paddingVertical="@dimen/item_gap_12"
            app:cornerRadius="0dp"
            app:elevation="0dp"/>
    </LinearLayout>
</LinearLayout>
