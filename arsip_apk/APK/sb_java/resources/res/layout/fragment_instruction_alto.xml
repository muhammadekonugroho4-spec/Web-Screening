<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@android:color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatButton
            android:gravity="center_vertical"
            android:id="@+id/instruction_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/sixteen_dp"
            android:layout_marginTop="@dimen/sixteen_dp"
            android:layout_marginRight="@dimen/sixteen_dp"
            android:text="@string/show_instruction"
            style="@style/ButtonSecondaryExpandable"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/instruction_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/light_gray"
                android:paddingTop="@dimen/eight_dp"
                android:paddingBottom="@dimen/eight_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_1"
                    style="@style/BankTransferInstruction.Number"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/instruction_alto_1"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_alto1"
                    style="@style/BankTransferInstruction"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:paddingTop="@dimen/eight_dp"
                android:paddingBottom="@dimen/eight_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_2"
                    style="@style/BankTransferInstruction.Number"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/instruction_alto_2"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_alto2"
                    style="@style/BankTransferInstruction"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/light_gray"
                android:paddingTop="@dimen/eight_dp"
                android:paddingBottom="@dimen/eight_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_3"
                    style="@style/BankTransferInstruction.Number"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/instruction_alto_3"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_alto3"
                    style="@style/BankTransferInstruction"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:paddingTop="@dimen/eight_dp"
                android:paddingBottom="@dimen/eight_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_4"
                    style="@style/BankTransferInstruction.Number"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/instruction_alto_4"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_alto4"
                    style="@style/BankTransferInstruction"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/light_gray"
                android:paddingTop="@dimen/eight_dp"
                android:paddingBottom="@dimen/eight_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_5"
                    style="@style/BankTransferInstruction.Number"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/instruction_alto_5"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_alto5"
                    style="@style/BankTransferInstruction"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:paddingTop="@dimen/eight_dp"
                android:paddingBottom="@dimen/eight_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_6"
                    style="@style/BankTransferInstruction.Number"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/instruction_alto_6"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_alto6"
                    style="@style/BankTransferInstruction"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/light_gray"
                android:paddingTop="@dimen/eight_dp"
                android:paddingBottom="@dimen/eight_dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_7"
                    style="@style/BankTransferInstruction.Number"/>
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/instruction_alto_7"/>
                <com.midtrans.sdk.uikit.widgets.DefaultTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/instruction_alto7"
                    style="@style/BankTransferInstruction"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
