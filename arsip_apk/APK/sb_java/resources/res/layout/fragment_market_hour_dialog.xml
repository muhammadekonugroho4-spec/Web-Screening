<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme"
    android:orientation="vertical"
    android:tag="layout/fragment_market_hour_dialog_0"
    android:background="@drawable/bg_top_rounded"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/v_handle"
        android:background="@drawable/bg_rounded_gray_gray_bg"
        android:layout_width="@dimen/clickable_size_38"
        android:layout_height="@dimen/item_gap_s"
        android:layout_marginTop="@dimen/item_gap_14"
        android:layout_marginBottom="@dimen/item_gap_s"
        android:layout_centerHorizontal="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_gravity="center_horizontal"
        android:id="@+id/vg_market_hour_icon"
        android:background="@drawable/bg_rounded_50_light"
        android:padding="@dimen/item_gap_16"
        android:layout_width="@dimen/height_68"
        android:layout_height="@dimen/height_68"
        android:layout_marginTop="@dimen/item_gap_26">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_market_hour_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_size_16"
        android:textColor="?attr/themeContentTextColor"
        android:gravity="center_horizontal"
        android:id="@+id/tv_market_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_16"
        android:fontFamily="@font/bitsans_bold"
        app:layout_constraintTop_toBottomOf="@+id/vg_market_hour_icon"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/highgray_light"
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_8"
        android:text="@string/market_will_be_opened_in"
        android:fontFamily="@font/bitsans_regular"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="@dimen/text_size_14"
        android:textColor="@color/green_text"
        android:gravity="center_horizontal"
        android:id="@+id/tv_market_count_down"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/height_53"
        android:fontFamily="@font/bitsans_bold"/>
</androidx.appcompat.widget.LinearLayoutCompat>
