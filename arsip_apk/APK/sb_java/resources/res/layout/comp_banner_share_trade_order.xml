<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_banner_share_trade"
    android:tag="layout/comp_banner_share_trade_order_0"
    android:background="?attr/themeColorPeriwinkleLow"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="@dimen/height_40"
    android:paddingHorizontal="@dimen/spacing_20"
    android:paddingVertical="@dimen/spacing_12">
    <TextView
        android:textColor="?attr/themeColorPeriwinkleDefault"
        android:id="@+id/tv_banner_share_trade_order"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_share_trade_order_banner"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TypeStyles.BodyXSmall"/>
    <ImageButton
        android:id="@+id/ib_close_banner"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/tv_banner_share_trade_order"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_banner_share_trade_order"
        app:srcCompat="@drawable/ic_close_banner_share_trade"/>
</androidx.constraintlayout.widget.ConstraintLayout>
