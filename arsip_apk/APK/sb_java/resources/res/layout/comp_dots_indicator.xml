<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/parentDotsRoot"
    android:tag="layout/comp_dots_indicator_0"
    android:layout_width="match_parent"
    android:layout_height="@dimen/comp_dots_height">
    <ImageView
        android:id="@+id/ivFirstDotImageView"
        android:background="@drawable/indicator_selected"
        android:layout_width="@dimen/avatar_size_xxxs"
        android:layout_height="@dimen/avatar_size_xxxs"
        android:layout_marginLeft="@dimen/item_gap_s"
        android:layout_toLeftOf="@+id/ivSecondDotImageView"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/item_gap_s"
        android:layout_toStartOf="@+id/ivSecondDotImageView"/>
    <ImageView
        android:id="@+id/ivSecondDotImageView"
        android:background="@drawable/indicator_unselected"
        android:layout_width="@dimen/avatar_size_xxxs"
        android:layout_height="@dimen/avatar_size_xxxs"
        android:layout_marginLeft="@dimen/item_gap_s"
        android:layout_toLeftOf="@+id/spaceMiddleDotsSeparator"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/item_gap_s"
        android:layout_toStartOf="@+id/spaceMiddleDotsSeparator"/>
    <Space
        android:id="@+id/spaceMiddleDotsSeparator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"/>
    <ImageView
        android:id="@+id/ivThirdDotImageView"
        android:background="@drawable/indicator_unselected"
        android:layout_width="@dimen/avatar_size_xxxs"
        android:layout_height="@dimen/avatar_size_xxxs"
        android:layout_marginLeft="@dimen/item_gap_s"
        android:layout_toRightOf="@+id/spaceMiddleDotsSeparator"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/item_gap_s"
        android:layout_toEndOf="@+id/spaceMiddleDotsSeparator"/>
    <ImageView
        android:id="@+id/ivFourthDotImageView"
        android:background="@drawable/indicator_unselected"
        android:layout_width="@dimen/avatar_size_xxxs"
        android:layout_height="@dimen/avatar_size_xxxs"
        android:layout_marginLeft="@dimen/item_gap_s"
        android:layout_toRightOf="@+id/ivThirdDotImageView"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/item_gap_s"
        android:layout_toEndOf="@+id/ivThirdDotImageView"/>
    <ImageView
        android:id="@+id/ivFifthDotImageView"
        android:background="@drawable/indicator_unselected"
        android:layout_width="@dimen/avatar_size_xxxs"
        android:layout_height="@dimen/avatar_size_xxxs"
        android:layout_marginLeft="@dimen/item_gap_s"
        android:layout_toRightOf="@+id/ivFourthDotImageView"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/item_gap_s"
        android:layout_toEndOf="@+id/ivFourthDotImageView"/>
</RelativeLayout>
