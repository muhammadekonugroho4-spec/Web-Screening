<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_reward_item_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size_18"
        android:textColor="?attr/themeColorTextPrimary"
        android:id="@+id/textViewStock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SbTextView.PageHeadline"/>
    <TextView
        android:textSize="@dimen/text_size_11"
        android:textColor="?attr/themeColorTextPrimary"
        android:id="@+id/textViewStockName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_xxs"
        android:layout_marginBottom="@dimen/item_gap_10"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewStock"
        style="@style/SbTextView.BodyDefault"/>
    <TextView
        android:textSize="@dimen/text_size_14"
        android:textColor="?attr/themeColorTextSecondary"
        android:id="@+id/textViewLot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/item_gap_16"
        app:layout_constraintBottom_toBottomOf="@+id/textViewStockName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textViewStock"
        style="@style/SbTextView.BodyDefault"/>
    <View
        android:id="@+id/gap"
        android:background="?attr/separatorColor"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_zero_point_three"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
