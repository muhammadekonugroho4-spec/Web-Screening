<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_rdn_deposit_description_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/bg_top_rounded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/indicator"
            android:background="@drawable/bg_gray_collapse"
            android:layout_width="@dimen/clickable_size_38"
            android:layout_height="@dimen/item_gap_5"
            android:layout_marginTop="@dimen/item_gap_11"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/text_size_16"
            android:id="@+id/tv_title_instruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_20"
            android:text="@string/deposit_rdn_instruction_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/indicator"
            style="@style/TypeStyles.HeadingLarge"/>
        <TableLayout
            android:id="@+id/tl_instruction_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/item_gap_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_instruction">
            <TableRow android:gravity="center">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="?attr/themeIconRdnDesc"
                    android:layout_marginEnd="@dimen/item_gap_18"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/deposit_rdn_instruction_1"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/item_gap_8"
                    style="@style/TypeStyles.BodyRegular"/>
            </TableRow>
            <TableRow
                android:gravity="center"
                android:layout_marginTop="@dimen/item_gap_24">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="?attr/themeIconRdnDesc2"
                    android:layout_marginEnd="@dimen/item_gap_18"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/deposit_rdn_instruction_2"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/item_gap_8"
                    style="@style/TypeStyles.BodyRegular"/>
            </TableRow>
            <TableRow
                android:gravity="center"
                android:layout_marginTop="@dimen/item_gap_24">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="?attr/themeIconRdnDesc3"
                    android:layout_marginEnd="@dimen/item_gap_18"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/deposit_rdn_instruction_3"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/item_gap_8"
                    style="@style/TypeStyles.BodyRegular"/>
            </TableRow>
            <TableRow
                android:gravity="center"
                android:layout_marginTop="@dimen/item_gap_24">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="?attr/themeIconRdnDesc4"
                    android:layout_marginEnd="@dimen/item_gap_18"/>
                <TextView
                    android:textSize="@dimen/text_size_14"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/deposit_rdn_instruction_4"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/item_gap_8"
                    style="@style/TypeStyles.BodyRegular"/>
            </TableRow>
        </TableLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
