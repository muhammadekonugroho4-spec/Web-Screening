<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/AppTheme"
    android:gravity="bottom"
    android:orientation="vertical"
    android:tag="layout/dialog_camera_denied_0"
    android:background="@color/transparent"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <RelativeLayout
        android:id="@+id/rv_header"
        android:background="@drawable/bg_top_rounded"
        android:paddingBottom="@dimen/item_gap_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/themeDialogBackgroundColor"
        android:paddingBottom="@dimen/item_gap_20"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/item_gap_20"
        android:paddingEnd="@dimen/item_gap_20">
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_activation_camera_and_storage"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/item_gap_12"
                android:layout_marginEnd="@dimen/item_gap_4"
                style="@style/TypeStyles.HeadingLarge"/>
            <ImageButton
                android:id="@+id/iv_close_dialog"
                android:background="@null"
                android:layout_width="@dimen/clickable_size_12"
                android:layout_height="@dimen/clickable_size_12"
                android:scaleType="fitXY"
                android:layout_weight="0"
                android:layout_marginStart="@dimen/item_gap_8"
                app:srcCompat="0x7f080644"/>
        </LinearLayout>
        <TextView
            android:textColor="?attr/themeColorTextSecondary"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_16"
            android:layout_marginBottom="@dimen/item_gap_44"
            android:text="@string/message_permission_camera_storage"
            style="@style/TypeStyles.BodyRegular"/>
        <com.stockbit.uikit.buttons.PrimaryButton
            android:textSize="@dimen/text_size_16"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_open_permission_setting"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_44"
            android:text="@string/message_turn_on"
            android:textAllCaps="false"/>
    </LinearLayout>
</LinearLayout>
