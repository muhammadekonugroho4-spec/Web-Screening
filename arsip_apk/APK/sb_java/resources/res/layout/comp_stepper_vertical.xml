<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/comp_stepper_vertical_0"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingHorizontal="2dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_stepper_first_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:gravity="center"
            android:id="@+id/tv_stepper_first"
            android:background="@drawable/bg_stepper_inactive"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/StepperText"/>
        <TextView
            android:id="@+id/tv_stepper_first_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_stepper_first"
            app:layout_constraintStart_toEndOf="@+id/tv_stepper_first"
            app:layout_constraintTop_toTopOf="@+id/tv_stepper_first"
            style="@style/StepperTextDesc.Inactive"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/green_text"
            android:id="@+id/tv_stepper_first_approved"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Approved"
            app:layout_constraintStart_toStartOf="@+id/tv_stepper_first_desc"
            app:layout_constraintTop_toBottomOf="@+id/tv_stepper_first_desc"
            style="@style/TypeStyles.HeadingXSmall"/>
        <View
            android:id="@+id/v_stepper_first_bridge_last"
            android:background="?attr/themeColorBorder"
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/tv_stepper_first"
            app:layout_constraintStart_toStartOf="@+id/tv_stepper_first"
            app:layout_constraintTop_toBottomOf="@+id/tv_stepper_first"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_stepper_second_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
