            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_stepper_second"
            app:layout_constraintStart_toEndOf="@+id/tv_stepper_second"
            app:layout_constraintTop_toTopOf="@+id/tv_stepper_second"
            style="@style/StepperTextDesc.Inactive"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/green_text"
            android:id="@+id/tv_stepper_second_approved"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Approved"
            app:layout_constraintStart_toStartOf="@+id/tv_stepper_second_desc"
            app:layout_constraintTop_toBottomOf="@+id/tv_stepper_second_desc"
