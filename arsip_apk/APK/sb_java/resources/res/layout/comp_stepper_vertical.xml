        <View
            android:id="@+id/v_stepper_second_bridge_last"
            android:background="?attr/themeColorBorder"
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/tv_stepper_second"
            app:layout_constraintStart_toStartOf="@+id/tv_stepper_second"
            app:layout_constraintTop_toBottomOf="@+id/tv_stepper_second"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_stepper_third_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_stepper_second_layout">
        <View
            android:id="@+id/v_stepper_third_bridge_start"
            android:background="?attr/themeColorBorder"
