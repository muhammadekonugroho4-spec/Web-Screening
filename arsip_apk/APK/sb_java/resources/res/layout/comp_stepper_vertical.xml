            android:layout_width="1dp"
            android:layout_height="12dp"
            app:layout_constraintEnd_toEndOf="@+id/tv_stepper_third"
            app:layout_constraintStart_toStartOf="@+id/tv_stepper_third"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_stepper_third"
            android:background="@drawable/bg_stepper_inactive"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:text="3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_stepper_third_bridge_start"
            style="@style/StepperText"/>
        <TextView
            android:id="@+id/tv_stepper_third_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_stepper_third"
            app:layout_constraintStart_toEndOf="@+id/tv_stepper_third"
            app:layout_constraintTop_toTopOf="@+id/tv_stepper_third"
            style="@style/StepperTextDesc.Inactive"/>
        <TextView
            android:textStyle="bold"
            android:textColor="@color/green_text"
            android:id="@+id/tv_stepper_third_approved"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Approved"
            app:layout_constraintStart_toStartOf="@+id/tv_stepper_third_desc"
            app:layout_constraintTop_toBottomOf="@+id/tv_stepper_third_desc"
            style="@style/TypeStyles.HeadingXSmall"/>
        <View
            android:id="@+id/v_stepper_third_bridge_last"
            android:background="?attr/themeColorBorder"
            android:layout_width="1dp"
            android:layout_height="12dp"
            android:layout_marginTop="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/tv_stepper_third"
            app:layout_constraintStart_toStartOf="@+id/tv_stepper_third"
            app:layout_constraintTop_toBottomOf="@+id/tv_stepper_third"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_stepper_fourth_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_stepper_third_layout">
        <View
            android:id="@+id/v_stepper_fourth_bridge_start"
            android:background="?attr/themeColorBorder"
