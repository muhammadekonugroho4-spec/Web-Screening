    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_stepper_last_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_stepper_fourth_layout">
        <View
            android:id="@+id/v_stepper_last_bridge_start"
            android:background="?attr/themeColorBorder"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="12dp"
            app:layout_constraintEnd_toEndOf="@+id/tv_stepper_last"
            app:layout_constraintStart_toStartOf="@+id/tv_stepper_last"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_stepper_last"
            android:background="@drawable/bg_stepper_inactive"
            android:visibility="invisible"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:text="4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_stepper_last_bridge_start"
            style="@style/StepperText"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/iv_stepper_last"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="?attr/themeIconStepperFinishInactive"
            app:layout_constraintBottom_toBottomOf="@+id/tv_stepper_last"
            app:layout_constraintEnd_toEndOf="@+id/tv_stepper_last"
            app:layout_constraintStart_toStartOf="@+id/tv_stepper_last"
            app:layout_constraintTop_toTopOf="@+id/tv_stepper_last"
            style="@style/StepperText"/>
