<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlScreenerScreenRowHeaderContainer"
    android:tag="layout/layout_screener_screen_row_header_0"
    android:background="?attr/selectableItemBackground"
    android:paddingRight="@dimen/item_gap_4"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/height_65">
    <com.stockbit.uikit.control.ControlCheckbox
        android:id="@+id/cb_screener_company"
        android:background="@color/transparent"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false"
        android:layout_marginStart="@dimen/spacing_20"
        app:checkBoxType="round"
        app:layout_constraintBottom_toBottomOf="@+id/iv_company_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_company_logo"/>
    <ImageView
        android:id="@+id/iv_company_logo"
        android:layout_width="@dimen/width_32"
        android:layout_height="@dimen/height_32"
        android:layout_marginStart="@dimen/item_gap_22"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cb_screener_company"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:ellipsize="end"
        android:id="@+id/tv_title_data"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/item_gap_8"
        app:layout_constraintBottom_toTopOf="@+id/tv_sub_title_data"
        app:layout_constraintStart_toEndOf="@+id/iv_company_logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/TypeStyles.HeadingRegular"/>
    <TextView
        android:textColor="?attr/themeColorTextPrimary"
        android:ellipsize="end"
        android:id="@+id/tv_sub_title_data"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_xs"
        android:text="@string/n_dash"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_title_data"
        app:layout_constraintTop_toBottomOf="@+id/tv_title_data"
        style="@style/TypeStyles.BodyXXSmall"/>
    <TextView
        android:textColor="@color/green_text"
        android:gravity="center_vertical"
        android:id="@+id/tv_new_badge"
        android:background="@drawable/border_green_button_with_radius_2"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_bar_new_title"
        android:lines="1"
        android:layout_marginStart="@dimen/item_gap_6"
        android:paddingHorizontal="@dimen/item_gap_4"
        android:paddingVertical="@dimen/item_gap_2"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title_data"
        app:layout_constraintStart_toEndOf="@+id/tv_title_data"
        app:layout_constraintTop_toTopOf="@+id/tv_title_data"
        style="@style/TypeStyles.BodyXXSmall"/>
</androidx.constraintlayout.widget.ConstraintLayout>
