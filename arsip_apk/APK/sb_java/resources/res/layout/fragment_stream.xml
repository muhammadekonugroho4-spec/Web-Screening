<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_fragment_stream"
    android:tag="layout/fragment_stream_0"
    android:background="?attr/themeContentBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/abl_stream"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        style="@style/Sb.Widget.AppBar">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_stream"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:contentInsetEnd="0dp"
            app:contentInsetLeft="0dp"
            app:contentInsetRight="0dp"
            app:contentInsetStart="0dp"
            app:navigationContentDescription="@string/SHARED_1">
            <ImageView
                android:layout_gravity="center_horizontal"
                android:id="@+id/iv_stream_company_logo"
                android:padding="@dimen/item_gap_xxs"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/clickable_size_32"
                android:scaleType="centerInside"
                android:contentDescription="@string/app_name"
                app:srcCompat="?attr/themeStockbitLogoWithText"/>
        </androidx.appcompat.widget.Toolbar>
        <com.stockbit.stream.utils.StreamTabsLayout
            android:id="@+id/stl_stream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabGravity="fill"
            app:tabMaxWidth="@dimen/stream_tab_max_width"
            app:tabMode="fixed"
            app:tabsType="Regular"/>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.viewpager.widget.ViewPager
        android:id="@+id/vp_stream"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="bottom"
        android:id="@+id/rl_tipping_animated"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/tipping_stream_icon_height"
        android:layout_marginBottom="@dimen/clickable_size_64"
        android:layout_alignParentBottom="true"
        android:paddingEnd="@dimen/item_gap_s">
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lav_tipping_animated"
            android:layout_width="@dimen/tipping_stream_icon_width"
            android:layout_height="@dimen/tipping_stream_icon_width"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_autoPlay="true"
            app:lottie_fileName="ic_lottie_tipping_notification.json"
            app:lottie_loop="true"/>
        <TextView
            android:textSize="@dimen/text_size_9"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/tv_tipping_animated"
            android:background="@drawable/action_item_badge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/item_gap_l"
            android:minHeight="@dimen/item_gap_l"
            android:text="@string/n_dash"
            android:maxLines="1"
            android:layout_centerInParent="true"
            android:layout_marginEnd="@dimen/item_gap_s"
            android:paddingHorizontal="@dimen/item_gap_xs"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/lav_tipping_animated"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/SbTextView.BadgeText"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
