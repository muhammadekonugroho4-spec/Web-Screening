<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentRowIndexRoot"
    android:tag="layout/row_market_index_0"
    android:layout_width="@dimen/width_100"
    android:layout_height="wrap_content"
    android:layout_marginRight="@dimen/item_gap_12"
    app:cardBackgroundColor="?attr/themeColorSurfaceDefault"
    app:cardCornerRadius="@dimen/shape_radius_4"
    app:cardElevation="@dimen/item_gap_null"
    app:strokeColor="?attr/themeColorBorder"
    app:strokeWidth="@dimen/height_1">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:padding="@dimen/item_gap_16"
        android:paddingTop="@dimen/item_gap_8"
        android:paddingBottom="@dimen/item_gap_6"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="?attr/selectableItemBackgroundBorderless">
        <TextView
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_index_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/TypeStyles.HeadingSmall"/>
        <TextView
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/tv_index_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_4"
            android:maxLines="1"
            app:layout_constraintTop_toBottomOf="@+id/tv_index_name"
            style="@style/TypeStyles.BodySmall"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
