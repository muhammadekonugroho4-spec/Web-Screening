<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_stream_research_0"
    android:background="?attr/themeContentBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/sfl_shimmer_research"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:shimmer_colored="false"
        style="@style/FBShimmerFrameLayout">
        <LinearLayout
            android:orientation="vertical"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <include
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12"
                android:layout_marginBottom="@dimen/spacing_4"
                layout="@layout/skeleton_research_menu_entries"/>
            <include layout="@layout/skeleton_stream_research"/>
            <include layout="@layout/skeleton_stream_research"/>
            <include layout="@layout/skeleton_stream_research"/>
            <include layout="@layout/skeleton_stream_research"/>
            <include layout="@layout/skeleton_stream_research"/>
            <include layout="@layout/skeleton_stream_research"/>
            <include layout="@layout/skeleton_stream_research"/>
        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>
    <com.stockbit.stream.utils.pulltorefresh.PullRefreshLayout
        android:id="@+id/prl_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:progressSize="23"
        app:pullThreshold="60"
        app:topMargin="22">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_stream_research"
            android:tag="binding_2"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_no_connection_internet"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_icon_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/tv_title_error"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:srcCompat="?attr/themeIconNoConnectionInternet"/>
            <TextView
                android:gravity="center"
                android:id="@+id/tv_title_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:text="@string/error_message_no_connection"
                android:paddingHorizontal="@dimen/spacing_16"
                app:layout_constraintBottom_toTopOf="@+id/tv_description_error"
                app:layout_constraintTop_toBottomOf="@+id/iv_icon_error"
                style="@style/TypeStyles.HeadlineRegular"/>
            <TextView
                android:textColor="?attr/themeColorTextSecondary"
                android:gravity="center"
                android:id="@+id/tv_description_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:text="@string/error_description_no_connection_internet"
                android:paddingHorizontal="@dimen/spacing_16"
                app:layout_constraintBottom_toTopOf="@+id/pb_button_reload"
                app:layout_constraintTop_toBottomOf="@+id/tv_title_error"
                style="@style/TypeStyles.BodyRegular"/>
            <com.stockbit.uikit.button.PrimaryButton
                android:id="@+id/pb_button_reload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:text="@string/button_reload"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_description_error"
                app:primaryButtonColor="green"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.stockbit.stream.utils.pulltorefresh.PullRefreshLayout>
</FrameLayout>
