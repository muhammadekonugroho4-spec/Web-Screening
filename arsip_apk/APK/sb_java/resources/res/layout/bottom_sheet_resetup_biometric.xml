<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/bottom_sheet_resetup_biometric_0"
    android:background="@drawable/bg_top_rounded_16"
    android:paddingBottom="@dimen/item_gap_34"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/item_gap_20"
    android:paddingEnd="@dimen/item_gap_20">
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_set_biometric"
        android:layout_width="@dimen/width_335"
        android:layout_height="@dimen/height_240"
        android:layout_marginTop="@dimen/item_gap_24"
        android:scaleType="fitCenter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="?attr/themeIconAnimationSetupBiometric"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_20"
        android:text="@string/title_resetup_biometric"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lottie_set_biometric"
        style="@style/TypeStyles.HeadlineRegular"/>
    <TextView
        android:textColorLink="?attr/themeColorTextGreen"
        android:gravity="center"
        android:id="@+id/tv_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_12"
        android:text="@string/msg_resetup_biometric"
        android:paddingStart="@dimen/item_gap_20"
        android:paddingEnd="@dimen/item_gap_20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"
        style="@style/TypeStyles.BodyRegular"/>
    <com.stockbit.uikit.buttons.PrimaryButton
        android:textColor="@color/white"
        android:id="@+id/btn_activate_smart_login"
        android:layout_width="0dp"
        android:layout_height="@dimen/height_44"
        android:layout_marginTop="@dimen/item_gap_40"
        android:text="@string/btn_smart_login"
        android:textAllCaps="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc"/>
</androidx.constraintlayout.widget.ConstraintLayout>
