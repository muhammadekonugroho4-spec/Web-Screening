<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_option_symbol_0"
    android:background="@drawable/bg_top_rounded_20_theme_nav_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/iv_edit"
        android:tag="binding_1"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/item_gap_24"
        android:layout_marginStart="@dimen/item_gap_21"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_android_compose_black_24dp"
        app:tint="?attr/titleTextColorHighgray"/>
    <TextView
        android:gravity="center_vertical"
        android:id="@+id/tv_edit"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/edit_symbol"
        android:layout_marginStart="@dimen/item_gap_15"
        app:layout_constraintBottom_toTopOf="@+id/border"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_edit"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/SbTextView.ListTitle.Highempasis.Normal"/>
    <View
        android:id="@+id/border"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        android:layout_marginTop="@dimen/item_gap_24"
        app:layout_constraintTop_toBottomOf="@+id/iv_edit"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/iv_delete"
        android:tag="binding_3"
        android:background="@null"
        android:layout_width="@dimen/clickable_size_20"
        android:layout_height="@dimen/clickable_size_20"
        android:layout_marginTop="@dimen/item_gap_24"
        android:layout_marginBottom="@dimen/item_gap_24"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/iv_edit"
        app:layout_constraintTop_toBottomOf="@+id/border"
        app:srcCompat="@drawable/ic_trash"
        app:tint="@color/red_item"/>
    <TextView
        android:textColor="@color/red_item"
        android:gravity="center_vertical"
        android:id="@+id/tv_delete"
        android:tag="binding_4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/btn_remove_target_price"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_edit"
        app:layout_constraintTop_toBottomOf="@+id/border"
        style="@style/SbTextView.ListTitle.Normal"/>
</androidx.constraintlayout.widget.ConstraintLayout>
