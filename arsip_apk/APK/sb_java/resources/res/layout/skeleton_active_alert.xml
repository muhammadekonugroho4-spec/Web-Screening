<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingBottom="@dimen/spacing_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_16"
    android:layout_marginHorizontal="@dimen/spacing_20">
    <View
        android:id="@+id/view_symbol"
        android:layout_width="40dp"
        android:layout_height="20dp"
        android:layout_marginTop="@dimen/spacing_12"
        android:layout_marginStart="@dimen/spacing_20"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FBShimmerItem"/>
    <View
        android:id="@+id/view_total_alert"
        android:layout_width="80dp"
        android:layout_height="12dp"
        android:layout_marginTop="@dimen/spacing_4"
        app:layout_constraintStart_toStartOf="@+id/view_symbol"
        app:layout_constraintTop_toBottomOf="@+id/view_symbol"
        style="@style/FBShimmerItem"/>
    <View
        android:id="@+id/view_arrow"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="@dimen/spacing_20"
        app:layout_constraintBottom_toTopOf="@+id/cl_alert_child"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/FBShimmerItem"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_alert_child"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_12"
        app:layout_constraintTop_toBottomOf="@+id/view_total_alert">
        <View
            android:id="@+id/view_separator"
            android:layout_width="match_parent"
            android:layout_height="@dimen/uikit_divider_thin"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/FBShimmerItem"/>
        <View
            android:id="@+id/view_operator"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginStart="@dimen/spacing_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_separator"
            style="@style/FBShimmerItem"/>
        <View
            android:id="@+id/view_operator_description"
            android:layout_width="136dp"
            android:layout_height="18dp"
            android:layout_marginLeft="@dimen/spacing_8"
            app:layout_constraintStart_toEndOf="@+id/view_operator"
            app:layout_constraintTop_toTopOf="@+id/view_operator"
            style="@style/FBShimmerItem"/>
        <View
            android:id="@+id/view_separator1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/uikit_divider_thin"
            android:layout_marginTop="@dimen/spacing_12"
            app:layout_constraintTop_toBottomOf="@+id/view_operator"
            style="@style/FBShimmerItem"/>
        <View
            android:id="@+id/view_operator1"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="@dimen/spacing_12"
            android:layout_marginStart="@dimen/spacing_20"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_separator1"
            style="@style/FBShimmerItem"/>
        <View
            android:id="@+id/view_operator_description1"
            android:layout_width="136dp"
            android:layout_height="18dp"
            android:layout_marginLeft="@dimen/spacing_8"
            app:layout_constraintStart_toEndOf="@+id/view_operator1"
            app:layout_constraintTop_toTopOf="@+id/view_operator1"
            style="@style/FBShimmerItem"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
