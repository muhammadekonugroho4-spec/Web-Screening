<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/parentRowHotlistRoot"
    android:tag="layout/row_market_hotlist_0"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/height_65"
    android:foreground="?attr/selectableItemBackground">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_company_symbol"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_16"
        android:layout_marginRight="@dimen/item_gap_12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/barrier_hotlist"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginLeft="@dimen/item_gap_20">
        <ImageView
            android:id="@+id/iv_company_logo"
            android:layout_width="@dimen/width_32"
            android:layout_height="@dimen/height_32"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textColor="?attr/themeColorTextPrimary"
            android:gravity="left"
            android:id="@+id/symbol_company"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/item_gap_8"
            android:singleLine="true"
            android:paddingEnd="@dimen/item_gap_3"
            app:layout_constraintBottom_toTopOf="@+id/tv_name_company"
            app:layout_constraintStart_toEndOf="@+id/iv_company_logo"
            app:layout_constraintTop_toTopOf="@+id/iv_company_logo"
            app:layout_constraintVertical_chainStyle="spread"
            style="@style/TypeStyles.HeadingLarge"/>
        <ImageView
            android:id="@+id/iv_notation_company_image"
            android:paddingTop="0.5dp"
            android:visibility="gone"
            android:layout_width="@dimen/item_gap_12"
            android:layout_height="@dimen/item_gap_12"
            android:scaleType="fitXY"
            android:baselineAlignBottom="true"
            android:layout_marginStart="@dimen/item_gap_3"
            app:layout_constraintBaseline_toBaselineOf="@+id/symbol_company"
            app:layout_constraintStart_toEndOf="@+id/symbol_company"
            app:srcCompat="@drawable/ic_notasi_khusus"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/rv_horizontal_notation"
            android:visibility="gone"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/item_gap_s"
            android:nestedScrollingEnabled="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="@+id/iv_notation_company_image"
            app:layout_constraintStart_toEndOf="@+id/iv_notation_company_image"
            app:layout_constraintTop_toTopOf="@+id/iv_notation_company_image"
            app:spanCount="1"/>
        <ImageView
            android:id="@+id/iv_corporate_action"
            android:paddingTop="0.5dp"
            android:visibility="gone"
            android:layout_width="@dimen/item_gap_12"
            android:layout_height="@dimen/item_gap_12"
            android:scaleType="fitXY"
            android:baselineAlignBottom="true"
            android:layout_marginStart="@dimen/item_gap_3"
            android:layout_marginEnd="@dimen/item_gap_s"
            app:layout_constraintBaseline_toBaselineOf="@+id/symbol_company"
            app:layout_constraintStart_toEndOf="@+id/rv_horizontal_notation"
            app:srcCompat="@drawable/ic_corporate_action"/>
        <ImageView
            android:id="@+id/iv_uma"
            android:visibility="gone"
            android:layout_width="@dimen/item_gap_23"
            android:layout_height="@dimen/height_12"
            android:scaleType="fitXY"
            android:baselineAlignBottom="true"
            android:layout_marginStart="@dimen/item_gap_3"
            app:layout_constraintBaseline_toBaselineOf="@+id/symbol_company"
            app:layout_constraintStart_toEndOf="@+id/iv_corporate_action"
            app:srcCompat="?attr/themeIconNotationUma"/>
        <TextView
            android:ellipsize="end"
            android:gravity="left"
            android:id="@+id/tv_name_company"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap_1"
            android:singleLine="true"
            app:layout_constraintBottom_toBottomOf="@+id/iv_company_logo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/symbol_company"
            app:layout_constraintTop_toBottomOf="@+id/symbol_company"
            style="@style/TypeStyles.BodyXSmall.Tertiary"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/view_row_hotlist_border"
        android:background="?attr/themeColorDividerThin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/item_gap_xxxs"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_hotlist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="start"
        app:constraint_referenced_ids="cv_row_watchlist_price"/>
    <androidx.cardview.widget.CardView
        android:gravity="end"
        android:id="@+id/cv_row_watchlist_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="@dimen/item_gap_10"
        android:minWidth="@dimen/width_104"
        android:minHeight="@dimen/clickable_size_48"
        app:cardBackgroundColor="?attr/themeColorSurfaceDefault"
        app:cardCornerRadius="@dimen/shape_radius_s"
        app:cardElevation="@dimen/item_gap_null"
        app:layout_constraintBottom_toBottomOf="@+id/cl_company_symbol"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cl_company_symbol">
        <LinearLayout
            android:gravity="end"
            android:layout_gravity="end|center_vertical"
            android:orientation="vertical"
            android:id="@+id/ll_watchList_backgound"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:minWidth="@dimen/width_104">
            <TextView
                android:gravity="end"
                android:id="@+id/tv_last_value"
                android:paddingRight="@dimen/item_gap_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="gravity"
                style="@style/TypeStyles.HeadingLarge"/>
            <TextView
                android:gravity="end"
                android:id="@+id/tv_percentage"
                android:paddingLeft="@dimen/item_gap_s"
                android:paddingRight="@dimen/item_gap_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAlignment="gravity"
                style="@style/TypeStyles.BodyRegular"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
