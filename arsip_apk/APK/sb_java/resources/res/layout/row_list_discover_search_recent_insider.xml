<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/row_list_discover_search_recent_insider_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_gravity="end"
        android:id="@+id/fl_delete_container"
        android:background="@color/google_red"
        android:layout_width="@dimen/clickable_size_80"
        android:layout_height="@dimen/height_48">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/pb_delete"
            android:visibility="gone"
            android:layout_width="@dimen/clickable_size_32"
            android:layout_height="@dimen/clickable_size_32"
            android:indeterminateTint="@color/white"
            style="@style/Widget.AppCompat.ProgressBar"/>
        <TextView
            android:textSize="@dimen/list_item_text_size"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/item_gap_m"
            android:layout_width="@dimen/clickable_size_80"
            android:layout_height="@dimen/height_48"
            android:text="@string/button_delete"
            style="@style/SbTextView.BodyDefault"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/parent_row_discover_recent_search_insider"
        android:background="?attr/themeColorSurfaceDefault"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/clickable_size_48"
        android:foreground="?attr/selectableItemBackground">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_discover_recent_search_avatar_insider"
            android:layout_width="@dimen/icon_placeholder_24"
            android:layout_height="@dimen/icon_placeholder_24"
            android:layout_marginLeft="@dimen/item_gap_l"
            android:layout_centerVertical="true"
            android:contentDescription="@string/user_profile_photo"
            app:srcCompat="@drawable/ic_whale"/>
        <TextView
            android:id="@+id/tv_discover_search_recent_name_insider"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="@dimen/item_gap_m"
            android:maxLines="2"
            android:layout_toRightOf="@+id/iv_discover_recent_search_avatar_insider"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/item_gap_m"
            style="@style/TypeStyles.HeadingRegular"/>
        <View
            android:background="?attr/themeColorDividerThin"
            android:layout_width="match_parent"
            android:layout_height="@dimen/item_gap_xxxs"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
</FrameLayout>
