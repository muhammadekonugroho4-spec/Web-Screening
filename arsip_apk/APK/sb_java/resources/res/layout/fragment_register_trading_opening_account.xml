<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_register_trading_opening_account_0"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/cl_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/openTradingAccount"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="@dimen/item_gap_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toTopOf="@+id/title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_weight="1"
                app:layout_constraintWidth_max="wrap"
                app:srcCompat="?attr/imgRegisterTradingOpeningAccount"/>
            <TextView
                android:gravity="center"
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/title_create_trading_acc"
                android:textAlignment="center"
                app:layout_constraintBottom_toTopOf="@+id/subtitle"
                app:layout_constraintTop_toBottomOf="@+id/image"
                style="@style/TypeStyles.HeadlineLarge"/>
            <TextView
                android:gravity="center"
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/text_create_trading_acc"
                android:textAlignment="center"
                android:layout_marginHorizontal="@dimen/spacing_20"
                app:layout_constraintTop_toBottomOf="@+id/title"
                style="@style/TypeStyles.BodyRegular"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <com.stockbit.uikit.buttons.PrimaryButton
        android:id="@+id/openTradingAccount"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_m"
        android:layout_marginTop="41dp"
        android:layout_marginRight="@dimen/item_gap_m"
        android:layout_marginBottom="@dimen/item_gap_s"
        android:text="@string/button_get_started"
        app:layout_constraintBottom_toTopOf="@+id/skip"/>
    <com.stockbit.uikit.buttons.FloatingButton
        android:id="@+id/skip"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/item_gap_m"
        android:layout_marginRight="@dimen/item_gap_m"
        android:layout_marginBottom="@dimen/item_gap_40"
        android:text="@string/button_skip"
        android:textAllCaps="false"
        android:paddingVertical="0dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
